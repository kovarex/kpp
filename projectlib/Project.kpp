// The types a project's build.kpp uses (docs/build.md, "build.kpp"). kpp compiles build.kpp with this
// library, the standard library and a generated file (kppSetting and kppProjectName: the command
// line's settings and the project directory's name), and the compile-time interpreter runs it
// (kppc --run-build, GlobalScope::runBuild): a Project default-constructed, build(project) once,
// then describe(project), which runs configure(cell) for every cell and whose text kpp reads
// (project.cpp). So build.kpp can compute but cannot read files, start processes or call C.

// config:: constants (docs/build.md, "Targets and configurations"), NAME=VALUE in the order set: kppc's
// --config, where a later one overrides an earlier one.
void kppConfig(Vector<String>& to, StringView name, StringView value)
{
  String item = name;
  item << "=";
  item << value;
  to.push_back(item);
}

// A named configuration, the matrix's second axis (docs/build.md, "Targets and configurations"):
// debug and release are built in, Project::configuration makes more. Unset options are its base's;
// with no base, false.
struct Configuration
{
  String name;
  String base;               // the configuration it is based on; "": none
  Optional<bool> optimize;   // clang -O2, ThinLTO and a whole link (kppc --optimize); else -O0, an incremental link
  Optional<bool> debugInfo;  // line tables and a PDB (kppc --debug-info)
  Vector<String> configs;    // config:: constants, NAME=VALUE (kppConfig)
  Vector<String> clangFlags; // kppc's --clang-flags, joined by blanks
  Vector<String> cFlags;     // the C libraries' compiles, after kpp's own flags (clang-cl's, or clang's for windows-gnu)
  Vector<String> arguments;  // more kppc options, one per entry

  void config(StringView name, bool value) { kppConfig(configs, name, value ? "true" : "false"); }
  void config(StringView name, i32 value) { kppConfig(configs, name, toString(value)); }
  void config(StringView name, const char* value) { kppConfig(configs, name, value); }
  void config(StringView name, StringView value) { kppConfig(configs, name, value); }
  void clangFlag(StringView flag) { clangFlags.push_back(flag); }
  void cFlag(StringView flag) { cFlags.push_back(flag); }
  void argument(StringView option) { arguments.push_back(option); }
};

// Where a used library is (Project::use): a directory with its build.kpp, relative to the project's
// directory or absolute. Without one, use() finds NAME in the project's libraries/NAME (later: the
// registry, which libraries/NAME overrides).
struct LibrarySource
{
  String path;
};
LibrarySource local(StringView path)
{
  LibrarySource source;
  source.path = path;
  return source;
}

// A kpp library a project, an executable or another library uses: its name, the lowest version it
// needs ("" for any), where it is ("" for libraries/NAME) and the values of its options given here:
// `project.use("zlib").config("debug", true)` sets an option the library declares (Library::option).
struct Dependency
{
  String name;
  String minimum;
  String path;
  Vector<String> configs; // its options, NAME=VALUE (kppConfig), without the library's name

  Dependency& config(StringView name, bool value) { kppConfig(configs, name, value ? "true" : "false"); return *this; }
  Dependency& config(StringView name, i32 value) { kppConfig(configs, name, toString(value)); return *this; }
  Dependency& config(StringView name, const char* value) { kppConfig(configs, name, value); return *this; }
  Dependency& config(StringView name, StringView value) { kppConfig(configs, name, value); return *this; }
};

void kppUse(Dependency& d, StringView name, StringView minimum, StringView path)
{
  d.name = name;
  d.minimum = minimum;
  d.path = path;
}

// One program the project builds: a target, the matrix's first axis.
struct Executable
{
  String name;
  Vector<String> roots;     // directories or files, relative to the project's directory or absolute
  Vector<String> excluded;  // files under the roots left out (a second program's Main.kpp)
  Vector<String> arguments; // more kppc options, one per entry (`--keep-going`)
  Vector<String> libraries; // what the link takes: a .lib, -lname, a .res (kppc's --lib)
  Vector<String> cIncludes; // directories the C headers are found in (kppc's --cinclude)
  Vector<String> links;     // the project's C libraries it links (Project::cLibrary), by name
  Deque<Dependency> uses;  // the kpp libraries it uses besides the project's (use())
  Vector<String> configs;   // config:: constants of this target, NAME=VALUE (kppConfig)
  String beforeBuildCommand;
  String afterBuildCommand;
  String debugCommand;
  String debugArguments;
  String debugDirectory;

  void root(StringView path) { roots.push_back(path); }
  void exclude(StringView path) { excluded.push_back(path); }
  void argument(StringView option) { arguments.push_back(option); }
  void linkFile(StringView path) { libraries.push_back(path); }
  // linkFile's older name, until factorio-in-kpp's build.kpp says linkFile.
  void library(StringView path) { libraries.push_back(path); }
  void cInclude(StringView path) { cIncludes.push_back(path); }
  // A kpp library (Project::use), for this executable only.
  Dependency& use(StringView name, StringView minimum = "")
  {
    Dependency& d = uses.emplace_back();
    kppUse(d, name, minimum, "");
    return d;
  }
  Dependency& use(StringView name, LibrarySource source)
  {
    Dependency& d = uses.emplace_back();
    kppUse(d, name, "", source.path);
    return d;
  }
  // A C library of the project (Project::cLibrary) by its name.
  void link(StringView name) { links.push_back(name); }
  // A Windows library by its name (`gdi32`): kppc's --lib -lgdi32.
  void systemLibrary(StringView name) { libraries.push_back(String("-l") + name); }
  // A config:: constant in every configuration of this target, over the project's and the
  // configuration's.
  void config(StringView name, bool value) { kppConfig(configs, name, value ? "true" : "false"); }
  void config(StringView name, i32 value) { kppConfig(configs, name, toString(value)); }
  void config(StringView name, const char* value) { kppConfig(configs, name, value); }
  void config(StringView name, StringView value) { kppConfig(configs, name, value); }
  // A command run before the build, and one after it, in the project's directory; {exe} is the
  // executable, {configuration} the configuration.
  void beforeBuild(StringView command) { beforeBuildCommand = command; }
  void afterBuild(StringView command) { afterBuildCommand = command; }
  // What Run and the debugger start, when not the executable itself: the command, its arguments and
  // the directory it starts in; {exe} and {configuration} are expanded in each, as in the build steps.
  // A name per configuration that is not the configuration's own (Factorio's bin\Releasex64) is
  // configure(Cell&)'s: `cell.target.debug(...)` with a name made from cell.configuration.name.
  void debug(StringView command, StringView arguments = "", StringView directory = "")
  {
    debugCommand = command;
    debugArguments = arguments;
    debugDirectory = directory;
  }
};

// One cell of the matrix, a target in a configuration, as build.kpp's optional configure(Cell&)
// sees it: copies of both, the configuration with its base's settings in, so that a change is this
// cell's alone (`cell.target.afterBuild(...)`, `cell.configuration.clangFlag(...)`).
struct Cell
{
  Configuration configuration;
  Executable target;
  Vector<String> configs; // this cell's config:: constants (config()), NAME=VALUE

  // A config:: constant of this cell, over the target's.
  void config(StringView name, bool value) { kppConfig(configs, name, value ? "true" : "false"); }
  void config(StringView name, i32 value) { kppConfig(configs, name, toString(value)); }
  void config(StringView name, const char* value) { kppConfig(configs, name, value); }
  void config(StringView name, StringView value) { kppConfig(configs, name, value); }
};

// What runs when build.kpp has no configure(Cell&): its own, a function, is chosen over a template.
template <typename C> void configure(C& cell) {}

// A C or C++ library the executables link (docs/build.md, "C and C++ libraries"): kpp compiles its
// sources with Visual Studio's clang-cl (/O2 /MT in every configuration, as Factorio's prebuilt
// libraries are) into build\clib\NAME.lib, or takes prebuilt .lib files as given.
struct CLibrary
{
  String name;
  Vector<String> sources;   // files, or directories: every .c, .cc and .cpp under them
  Vector<String> excluded;  // files under those directories left out
  Vector<String> includes;  // its include directories
  Vector<String> defines;   // NAME or NAME=VALUE
  Vector<String> prebuilt;  // .lib files used as they are, instead of sources
  Vector<String> resources; // .rc files, compiled into .res files the executables link
  String cppStandard;       // a C++ file's standard: c++17 (unset) or c++20

  void source(StringView path) { sources.push_back(path); }
  void exclude(StringView path) { excluded.push_back(path); }
  void include(StringView path) { includes.push_back(path); }
  void define(StringView definition) { defines.push_back(definition); }
  void prebuiltLibrary(StringView path) { prebuilt.push_back(path); }
  void resource(StringView path) { resources.push_back(path); }
  void standard(StringView name) { cppStandard = name; }
};

// An option a kpp library declares (Library::option): what its code reads as config::LIB::NAME,
// whose value whatever uses the library gives (use(...).config, or config("LIB::NAME", ...) of the
// project, a configuration, a target or a cell, or kpp --config LIB::NAME=VALUE); without one, its
// default; a required option has none, and leaving it unset is an error.
struct LibraryOption
{
  String name;
  String type;           // bool, int or string
  String defaultValue;
  String description;
  bool required = false;
  Vector<String> allowed; // a string option's values; none: any
};

void kppOption(LibraryOption& o, StringView name, StringView type, StringView value, StringView description, bool required)
{
  o.name = name;
  o.type = type;
  o.defaultValue = value;
  o.description = description;
  o.required = required;
}

// A kpp library (docs/build.md, "kpp libraries"): a project without an executable, whose source
// roots join the program of every executable that uses it. Its build.kpp declares it with
// project.library(NAME); its tests are `test` blocks under its roots and its test roots, which
// `kpp --test` builds and runs.
struct Library
{
  String name;
  String version;           // major.minor.patch
  String license;           // an SPDX expression: Apache-2.0 WITH LLVM-exception, MIT, MIT OR Apache-2.0
  String minimumKpp;        // the lowest kpp version it compiles with, major.minor.patch; "": any
  Vector<String> roots;     // its sources, relative to its directory; none: src
  Vector<String> testRoots; // sources only its own tests build (tests next to the code need none)
  Deque<Dependency> uses;  // the libraries it uses
  Deque<LibraryOption> options; // what its users set (a Deque: option() returns a reference)
  // Its names are qualified by its name for its users (zlib::compress), bare inside it; unscoped:
  // bare everywhere, sharing the one global scope (the stdlib is). design.md 16.
  bool unscoped = false;

  void root(StringView path) { roots.push_back(path); }
  void test(StringView path) { testRoots.push_back(path); }
  // An option with its default: `option("debug", false, "Extra consistency checks")`; a string option
  // may list the values it can have: `option("mode", "fast", "Its speed", {"fast", "small"})`. Each
  // returns its LibraryOption. (Each emplaces itself: tests/spec/language/
  // consteval_returned_deque_reference_chained.)
  LibraryOption& option(StringView name, bool value, StringView description)
  {
    LibraryOption& o = options.emplace_back();
    kppOption(o, name, "bool", value ? "true" : "false", description, false);
    return o;
  }
  LibraryOption& option(StringView name, i32 value, StringView description)
  {
    LibraryOption& o = options.emplace_back();
    kppOption(o, name, "int", toString(value), description, false);
    return o;
  }
  LibraryOption& option(StringView name, const char* value, StringView description)
  {
    LibraryOption& o = options.emplace_back();
    kppOption(o, name, "string", value, description, false);
    return o;
  }
  LibraryOption& option(StringView name, const char* value, StringView description, InitializerList<StringView> values)
  {
    LibraryOption& o = options.emplace_back();
    kppOption(o, name, "string", value, description, false);
    for (StringView v : values)
      o.allowed.push_back(v);
    return o;
  }
  // An option without a default, of type bool, int or string, which every user must set.
  LibraryOption& requiredOption(StringView name, StringView type, StringView description)
  {
    LibraryOption& o = options.emplace_back();
    kppOption(o, name, type, "", description, true);
    return o;
  }
  Dependency& use(StringView name, StringView minimum = "")
  {
    Dependency& d = uses.emplace_back();
    kppUse(d, name, minimum, "");
    return d;
  }
  Dependency& use(StringView name, LibrarySource source)
  {
    Dependency& d = uses.emplace_back();
    kppUse(d, name, "", source.path);
    return d;
  }
};

// What `kpp measure` times (docs/build.md, "kpp measure"): build.kpp's edits, each a row of its
// table, made and undone in the cell measured, and per row, optionally, another build's command to
// compare with (`kpp measure --compare DIR` runs it in DIR).
struct MeasureEdit
{
  String row;  // the table's row: "Edit of one function"
  String file; // relative to the project's directory
  String from; // what the file holds exactly once, replaced by `to` and back
  String to;
};

struct MeasureCompare
{
  String row;     // an edit's row, "clean" (the clean build), or "whole TARGET" (a whole build)
  String command; // run by cmd in the directory --compare names
  String touch;   // a file there, relative to it, whose time is set first (an edit for a build that
                  // rebuilds what includes it): "" none
};

struct Measure
{
  String target;        // the cell the edits and the clean build build: "" the first executable
  String configuration; // "" debug
  Deque<MeasureEdit> edits;
  Deque<MeasureCompare> compares;

  // A row: the file's text `from` (there exactly once) replaced by `to`, built, then put back, built.
  void edit(StringView row, StringView file, StringView from, StringView to)
  {
    MeasureEdit& e = edits.emplace_back();
    e.row = row;
    e.file = file;
    e.from = from;
    e.to = to;
  }
  // The other build of a row, run in --compare's directory after `touch` is touched.
  void compare(StringView row, StringView command, StringView touch = "")
  {
    MeasureCompare& c = compares.emplace_back();
    c.row = row;
    c.command = command;
    c.touch = touch;
  }
};

struct Project
{
  // For every executable, before its own.
  Vector<String> arguments;
  Vector<String> libraries;
  Vector<String> cIncludes;
  Deque<Dependency> uses;
  Vector<String> configs; // config:: constants of every cell, under the configuration's and the target's
  // Deques: adding one leaves the references earlier calls returned valid.
  Deque<Executable> executables;
  Deque<CLibrary> cLibraries;
  Deque<Library> kppLibraries;
  Deque<Configuration> configurations; // the ones build() named; debug and release are there either way
  Measure measurement;                 // kpp measure's (measure())

  Executable& executable(StringView name, InitializerList<StringView> roots)
  {
    Executable& e = executables.emplace_back();
    e.name = name;
    for (StringView root : roots)
      e.roots.push_back(root);
    return e;
  }
  CLibrary& cLibrary(StringView name)
  {
    CLibrary& c = cLibraries.emplace_back();
    c.name = name;
    return c;
  }
  // This project is a kpp library (struct Library).
  Library& library(StringView name)
  {
    Library& l = kppLibraries.emplace_back();
    l.name = name;
    return l;
  }
  // The configuration NAME (debug, release, or one of the project's), made when new.
  Configuration& configuration(StringView name)
  {
    for (Configuration& c : configurations)
      if (c.name == name)
        return c;
    Configuration& c = configurations.emplace_back();
    c.name = name;
    return c;
  }
  // The configuration NAME based on BASE: BASE's settings, then its own.
  Configuration& configuration(StringView name, StringView base)
  {
    Configuration& c = this->configuration(name);
    c.base = base;
    return c;
  }
  void argument(StringView option) { arguments.push_back(option); }
  // What `kpp measure` times, in the cell TARGET CONFIGURATION ("": the first executable; debug):
  // `project.measure("factorio").edit("Edit of one function", "src/A.kpp", "old", "new")`.
  Measure& measure(StringView target = "", StringView configuration = "debug")
  {
    measurement.target = target;
    measurement.configuration = configuration;
    return measurement;
  }
  // A file the link takes for every executable: a .lib, -lname, a .res (kppc's --lib).
  void linkFile(StringView path) { libraries.push_back(path); }
  void cInclude(StringView path) { cIncludes.push_back(path); }
  // A kpp library every executable uses (docs/build.md, "kpp libraries"): use("json") finds it in
  // libraries/json, use("json", "1.4") also states the lowest version that will do, and
  // use("json", local("../json")) gives its directory.
  Dependency& use(StringView name, StringView minimum = "")
  {
    Dependency& d = uses.emplace_back();
    kppUse(d, name, minimum, "");
    return d;
  }
  Dependency& use(StringView name, LibrarySource source)
  {
    Dependency& d = uses.emplace_back();
    kppUse(d, name, "", source.path);
    return d;
  }
  // A config:: constant of every cell.
  void config(StringView name, bool value) { kppConfig(configs, name, value ? "true" : "false"); }
  void config(StringView name, i32 value) { kppConfig(configs, name, toString(value)); }
  void config(StringView name, const char* value) { kppConfig(configs, name, value); }
  void config(StringView name, StringView value) { kppConfig(configs, name, value); }

  // A value given on kpp's command line (`kpp --set GAME=D:\game`), or otherwise.
  String setting(StringView name, StringView otherwise) const { return kppSetting(name, otherwise); }
};

void kppLine(String& out, StringView key, StringView value)
{
  if (value.size() == 0)
    return;
  out << key;
  out << ' ';
  out << value;
  out << '\n';
}

void kppLines(String& out, StringView key, const Vector<String>& values)
{
  for (const String& value : values)
    kppLine(out, key, value);
}

void kppUses(String& out, const Deque<Dependency>& uses)
{
  for (const Dependency& d : uses)
  {
    kppLine(out, "use", d.name);
    kppLine(out, "use-minimum", d.minimum);
    kppLine(out, "use-path", d.path);
    kppLines(out, "use-config", d.configs);
  }
}

// config:: constants with where they were set: `config SOURCE NAME=VALUE`.
void kppConfigs(String& out, StringView source, const Vector<String>& configs)
{
  for (const String& c : configs)
  {
    out << "config ";
    out << source;
    out << ' ';
    out << c;
    out << '\n';
  }
}

void kppAppend(Vector<String>& to, const Vector<String>& from)
{
  for (const String& s : from)
    to.push_back(s);
}

// configuration with its bases' settings in, the first base's first: into resolved, whose name is
// the configuration's and base empty. debug and release start from their built-in settings. An error
// (a base that is not there, a cycle) is an `error` line in out.
void kppResolve(const Project& project, const Configuration& configuration, Configuration& resolved, String& out)
{
  // The chain from configuration to the base that has none.
  Vector<const Configuration*> chain;
  chain.push_back(&configuration);
  String builtIn; // the chain ends at debug or release that build.kpp did not name
  while (chain.back()->base.size() != 0 && builtIn.size() == 0)
  {
    const Configuration* base = nullptr;
    for (const Configuration& c : project.configurations)
      if (c.name == chain.back()->base)
        base = &c;
    if (!base && (chain.back()->base == "debug" || chain.back()->base == "release"))
      builtIn = StringView(chain.back()->base);
    else if (!base)
    {
      kppLine(out, "error", String("the configuration ") + chain.back()->name + " is based on " + chain.back()->base +
                              ", which build.kpp does not declare (project.configuration)");
      return;
    }
    else if (chain.size() > project.configurations.size())
    {
      kppLine(out, "error", String("the configuration ") + configuration.name + " is based on itself");
      return;
    }
    else
      chain.push_back(base);
  }
  StringView root = builtIn.size() != 0 ? StringView(builtIn) : StringView(chain.back()->name);
  if (root == "debug")
  {
    resolved.optimize = false;
    resolved.debugInfo = true;
    resolved.config("debug", true);
  }
  else if (root == "release")
  {
    resolved.optimize = true;
    resolved.debugInfo = false;
    resolved.config("debug", false);
  }
  // (through a StringView: tests/spec/language/consteval_string_assigned_through_reference)
  resolved.name = StringView(configuration.name);
  for (u64 i = chain.size(); i > 0; --i)
  {
    const Configuration& c = *chain[i - 1];
    if (c.optimize.has_value())
      resolved.optimize = c.optimize;
    if (c.debugInfo.has_value())
      resolved.debugInfo = c.debugInfo;
    kppAppend(resolved.configs, c.configs);
    kppAppend(resolved.clangFlags, c.clangFlags);
    kppAppend(resolved.cFlags, c.cFlags);
    kppAppend(resolved.arguments, c.arguments);
  }
}

// A configuration's own lines: its options and constants, the project's constants first.
void kppConfigurationLines(String& out, const Project& project, const Configuration& c)
{
  kppLine(out, "optimize", c.optimize.value_or(false) ? "1" : "0");
  kppLine(out, "debug-info", c.debugInfo.value_or(false) ? "1" : "0");
  kppConfigs(out, "project", project.configs);
  kppConfigs(out, "configuration", c.configs);
  kppLines(out, "clang-flag", c.clangFlags);
  kppLines(out, "c-flag", c.cFlags);
}

// One cell: configure(cell) on copies of the target and the resolved configuration, then its lines.
void kppCell(String& out, const Project& project, const Executable& target, const Configuration& resolved)
{
  Cell cell{resolved, target}; // (not assigned: tests/spec/language/consteval_struct_copy_assignment)
  configure(cell);
  const Executable& e = cell.target;
  out << "cell ";
  out << e.name;
  out << ' ';
  out << resolved.name;
  out << '\n';
  kppConfigurationLines(out, project, cell.configuration);
  kppConfigs(out, "target", e.configs);
  kppConfigs(out, "cell", cell.configs);
  kppLines(out, "root", e.roots);
  kppLines(out, "exclude", e.excluded);
  kppLines(out, "argument", project.arguments);
  kppLines(out, "argument", cell.configuration.arguments);
  kppLines(out, "argument", e.arguments);
  kppLines(out, "library", project.libraries);
  kppLines(out, "library", e.libraries);
  kppLines(out, "cinclude", project.cIncludes);
  kppLines(out, "cinclude", e.cIncludes);
  kppLine(out, "before-build", e.beforeBuildCommand);
  kppLine(out, "after-build", e.afterBuildCommand);
  kppLine(out, "debug-command", e.debugCommand);
  kppLine(out, "debug-arguments", e.debugArguments);
  kppLine(out, "debug-directory", e.debugDirectory);
  kppLines(out, "link", e.links);
  kppUses(out, project.uses);
  kppUses(out, e.uses);
  out << "end\n";
}

// One line per fact, which kpp reads (project.cpp): per configuration (debug, release, then the
// project's) `configuration NAME`, its resolved lines, `end`; per cell, target by target,
// `cell TARGET CONFIGURATION`, its lines, `end`; per C library `clibrary NAME`, its lines, `end`;
// per kpp library `kpp-library NAME`, its lines, `end`; `error TEXT` for what build.kpp got wrong.
// A project that describes neither an executable nor a library has one executable: its directory's
// name, from src.
String describe(const Project& project)
{
  String out;
  Vector<Configuration> resolved;
  for (StringView builtIn : {"debug", "release"})
  {
    bool named = false;
    for (const Configuration& c : project.configurations)
      named = named || c.name == builtIn;
    if (!named)
    {
      Configuration c;
      c.name = builtIn;
      Configuration& r = resolved.emplace_back();
      kppResolve(project, c, r, out);
    }
  }
  for (const Configuration& c : project.configurations)
  {
    Configuration& r = resolved.emplace_back(); // (bound first: tests/spec/language/consteval_emplace_back_result_as_reference_argument)
    kppResolve(project, c, r, out);
  }
  for (const Configuration& c : resolved)
  {
    kppLine(out, "configuration", c.name);
    kppConfigurationLines(out, project, c);
    kppLines(out, "argument", project.arguments);
    kppLines(out, "argument", c.arguments);
    out << "end\n";
  }
  if (project.executables.empty() && project.kppLibraries.empty())
  {
    Executable e;
    e.name = kppProjectName();
    e.root("src");
    for (const Configuration& c : resolved)
      kppCell(out, project, e, c);
  }
  for (const Executable& e : project.executables)
    for (const Configuration& c : resolved)
      kppCell(out, project, e, c);
  for (const CLibrary& c : project.cLibraries)
  {
    kppLine(out, "clibrary", c.name);
    kppLines(out, "source", c.sources);
    kppLines(out, "exclude", c.excluded);
    kppLines(out, "include", c.includes);
    kppLines(out, "define", c.defines);
    kppLines(out, "prebuilt", c.prebuilt);
    kppLines(out, "resource", c.resources);
    kppLine(out, "language", c.cppStandard);
    out << "end\n";
  }
  for (const Library& l : project.kppLibraries)
  {
    kppLine(out, "kpp-library", l.name);
    kppLine(out, "version", l.version);
    kppLine(out, "license", l.license);
    kppLine(out, "minimum-kpp", l.minimumKpp);
    if (l.unscoped)
      kppLine(out, "unscoped", "1");
    if (l.roots.empty())
      kppLine(out, "root", "src");
    kppLines(out, "root", l.roots);
    kppLines(out, "test-root", l.testRoots);
    // Per option: `option NAME`, its type, its default (none when required: `option-required`), its
    // values and its description.
    for (const LibraryOption& o : l.options)
    {
      kppLine(out, "option", o.name);
      kppLine(out, "option-type", o.type);
      if (o.required)
        out << "option-required 1\n";
      else
      {
        out << "option-default ";
        out << o.defaultValue;
        out << '\n';
      }
      kppLines(out, "option-value", o.allowed);
      kppLine(out, "option-description", o.description);
    }
    kppUses(out, project.uses);
    kppUses(out, l.uses);
    out << "end\n";
  }
  // `measure`, its cell, per edit `edit ROW` and its file and texts, per comparison `compare ROW`
  // and its command and file, `end`.
  const Measure& m = project.measurement;
  if (m.edits.size() != 0 || m.compares.size() != 0 || m.target.size() != 0)
  {
    out << "measure\n";
    kppLine(out, "measure-target", m.target);
    kppLine(out, "measure-configuration", m.configuration);
    for (const MeasureEdit& e : m.edits)
    {
      kppLine(out, "edit", e.row);
      kppLine(out, "edit-file", e.file);
      kppLine(out, "edit-from", e.from);
      kppLine(out, "edit-to", e.to);
    }
    for (const MeasureCompare& c : m.compares)
    {
      kppLine(out, "compare", c.row);
      kppLine(out, "compare-command", c.command);
      kppLine(out, "compare-touch", c.touch);
    }
    out << "end\n";
  }
  return out;
}
