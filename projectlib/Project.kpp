// The types a project's build.kpp uses (docs/build.md, "build.kpp"). kpp compiles build.kpp with this
// library, the standard library and a generated file (kppSetting and kppProjectName: the command
// line's settings and the project directory's name), and the compile-time interpreter runs it
// (kpp --run-build, GlobalScope::runBuild): a Project default-constructed, build(project) once,
// then describe(project), which runs configure(cell) for every cell and whose text kpp reads
// (compiler/src/Project/). So build.kpp can compute but cannot read files, start processes or call C.

// config:: constants (docs/build.md, "Targets and configurations"), NAME=VALUE in the order set: kpp's
// --config, where a later one overrides an earlier one.
void kppConfig(std::Vector<std::String>& to, std::StringView name, std::StringView value)
{
  std::String item = name;
  item << "=";
  item << value;
  to.push_back(item);
}

// A named configuration, the matrix's second axis (docs/build.md, "Targets and configurations"):
// debug and release are built in, Project::configuration makes more. Unset options are its base's;
// with no base, false.
struct Configuration
{
  std::String name;
  std::String base;               // the configuration it is based on; "": none
  std::Optional<bool> optimize;   // clang -O2, ThinLTO and a whole link (kpp --optimize); else -O0, an incremental link
  std::Optional<bool> debugInfo;  // line tables, in a PDB (Linux, FreeBSD: DWARF, a release build's in NAME.debug) (kpp --debug-info)
  std::Vector<std::String> configs;    // config:: constants, NAME=VALUE (kppConfig)
  std::Vector<std::String> clangFlags; // kpp's --clang-flags, joined by blanks
  std::Vector<std::String> cFlags;     // the C libraries' compiles, after kpp's own flags (clang-cl's, or clang's for windows-gnu)
  std::Vector<std::String> arguments;  // more kpp options, one per entry

  void config(std::StringView name, bool value) { kppConfig(this.configs, name, value ? "true" : "false"); }
  void config(std::StringView name, i32 value) { kppConfig(this.configs, name, std::toString(value)); }
  void config(std::StringView name, const char* value) { kppConfig(this.configs, name, value); }
  void config(std::StringView name, std::StringView value) { kppConfig(this.configs, name, value); }
  void clangFlag(std::StringView flag) { this.clangFlags.push_back(flag); }
  void cFlag(std::StringView flag) { this.cFlags.push_back(flag); }
  void argument(std::StringView option) { this.arguments.push_back(option); }
};

// Where a used library is (Project::use): a directory with its build.kpp, relative to the project's
// directory or absolute. Without one, use() finds NAME in the project's libraries/NAME (later: the
// registry, which libraries/NAME overrides).
struct LibrarySource
{
  std::String path;
};

LibrarySource local(std::StringView path)
{
  LibrarySource source;
  source.path = path;
  return source;
}

// A kpp library a project, an executable or another library uses: its name, the lowest version it
// needs ("" for any), where it is ("" for libraries/NAME) and the values of its options given here:
// `project.use("zlib").config("debug", true)` sets an option the library declares (Library::option).
struct Dependency
{
  std::String name;
  std::String minimum;
  std::String path;
  std::Vector<std::String> configs; // its options, NAME=VALUE (kppConfig), without the library's name

  Dependency& config(std::StringView name, bool value) { kppConfig(this.configs, name, value ? "true" : "false"); return this; }
  Dependency& config(std::StringView name, i32 value) { kppConfig(this.configs, name, std::toString(value)); return this; }
  Dependency& config(std::StringView name, const char* value) { kppConfig(this.configs, name, value); return this; }
  Dependency& config(std::StringView name, std::StringView value) { kppConfig(this.configs, name, value); return this; }
};

// A system library for one platform as kpp reads it (systemLibrary(NAME, PLATFORM)): "PLATFORM NAME",
// the platform's short name (freebsd) as kpp's one table of them gives it (target.hpp, platformNames,
// which <config> writes as config::platformName).
std::String kppPlatformLibrary(std::StringView name, Platform platform) { return std::String(config::platformName(platform)) + " " + name; }

void kppUse(Dependency& d, std::StringView name, std::StringView minimum, std::StringView path)
{
  d.name = name;
  d.minimum = minimum;
  d.path = path;
}

// One program the project builds: a target, the matrix's first axis.
struct Executable
{
  std::String name;
  std::Vector<std::String> roots;     // directories or files, relative to the project's directory or absolute
  std::Vector<std::String> excluded;  // files under the roots left out (a second program's Main.kpp)
  std::Vector<std::String> arguments; // more kpp options, one per entry (`--keep-going`)
  std::Vector<std::String> libraries; // what the link takes: a .lib, -lname, a .res (kpp's --lib)
  std::Vector<std::String> cIncludes; // directories the C headers are found in (kpp's --cinclude)
  std::Vector<std::String> links;     // the project's C libraries it links (Project::cLibrary), by name
  std::Vector<std::String> systemLibraries; // systemLibrary()'s: NAME, or PLATFORM NAME (windows, linux, freebsd)
  std::Vector<std::String> natvisFiles; // natvis()'s: Visual Studio's rules for the program's own types
  std::Deque<Dependency> uses;  // the kpp libraries it uses besides the project's (use())
  std::Vector<std::String> configs;   // config:: constants of this target, NAME=VALUE (kppConfig)
  std::String beforeBuildCommand;
  std::String afterBuildCommand;
  std::String debugCommand;
  std::String debugArguments;
  std::String debugDirectory;

  void root(std::StringView path) { this.roots.push_back(path); }
  void exclude(std::StringView path) { this.excluded.push_back(path); }
  void argument(std::StringView option) { this.arguments.push_back(option); }
  void linkFile(std::StringView path) { this.libraries.push_back(path); }
  // linkFile's older name, until factorio-in-kpp's build.kpp says linkFile.
  void library(std::StringView path) { this.libraries.push_back(path); }
  void cInclude(std::StringView path) { this.cIncludes.push_back(path); }
  // An include directory of the C import for one platform's build only (`cInclude("libraries/libbacktrace",
  // Platform::Linux)`), as systemLibrary(NAME, PLATFORM).
  void cInclude(std::StringView path, Platform platform) { this.cIncludes.push_back(kppPlatformLibrary(path, platform)); }

  // A kpp library (Project::use), for this executable only.
  Dependency& use(std::StringView name, std::StringView minimum = "")
  {
    Dependency& d = this.uses.emplace_back();
    kppUse(d, name, minimum, "");
    return d;
  }

  Dependency& use(std::StringView name, LibrarySource source)
  {
    Dependency& d = this.uses.emplace_back();
    kppUse(d, name, "", source.path);
    return d;
  }

  // A C library of the project (Project::cLibrary) by its name.
  void link(std::StringView name) { this.links.push_back(name); }
  // A system library by its name (`gdi32`): kpp's --lib -lgdi32; with a platform, only a build for it
  // (`systemLibrary("ssl", Platform::FreeBSD)`, its --target), as Library::systemLibrary. Each name is
  // linked once with its libraries' (compiler/src/Project/Build.cpp).
  void systemLibrary(std::StringView name) { this.systemLibraries.push_back(name); }
  void systemLibrary(std::StringView name, Platform platform) { this.systemLibraries.push_back(kppPlatformLibrary(name, platform)); }
  // A .natvis file of the program's own (Visual Studio's display rules for its types), relative to the
  // project's directory: linked into the PDB of a --debug-info build for Windows with the rules kpp
  // writes for the standard library (kpp's --natvis; docs/debugging.md, "Values in Visual Studio").
  void natvis(std::StringView path) { this.natvisFiles.push_back(path); }
  // A config:: constant in every configuration of this target, over the project's and the
  // configuration's.
  void config(std::StringView name, bool value) { kppConfig(this.configs, name, value ? "true" : "false"); }
  void config(std::StringView name, i32 value) { kppConfig(this.configs, name, std::toString(value)); }
  void config(std::StringView name, const char* value) { kppConfig(this.configs, name, value); }
  void config(std::StringView name, std::StringView value) { kppConfig(this.configs, name, value); }
  // A command run before the build, and one after it, in the project's directory; {exe} is the
  // executable, {configuration} the configuration.
  void beforeBuild(std::StringView command) { this.beforeBuildCommand = command; }
  void afterBuild(std::StringView command) { this.afterBuildCommand = command; }

  // What Run and the debugger start, when not the executable itself: the command, its arguments and
  // the directory it starts in; {exe} and {configuration} are expanded in each, as in the build steps.
  // A name per configuration that is not the configuration's own (Factorio's bin\Releasex64) is
  // configure(Cell&)'s: `cell.target.debug(...)` with a name made from cell.configuration.name.
  void debug(std::StringView command, std::StringView arguments = "", std::StringView directory = "")
  {
    this.debugCommand = command;
    this.debugArguments = arguments;
    this.debugDirectory = directory;
  }
};

// One cell of the matrix, a target in a configuration, as build.kpp's optional configure(Cell&)
// sees it: copies of both, the configuration with its base's settings in, so that a change is this
// cell's alone (`cell.target.afterBuild(...)`, `cell.configuration.clangFlag(...)`).
struct Cell
{
  Configuration configuration;
  Executable target;
  std::Vector<std::String> configs; // this cell's config:: constants (config()), NAME=VALUE
  // The platform the cell is built for (kppCellPlatform): the last --target of the project's, the
  // configuration's and the target's arguments and the command line's, the host's without one; so that
  // configure(cell) gives a Linux build its own steps (`if (cell.platform == Platform::Windows)`
  // around a cmd command). A --target that configure(cell) adds is not in it, and kpp stops the build
  // when the platform it builds for is not this one.
  Platform platform = Platform::Windows;

  // A config:: constant of this cell, over the target's.
  void config(std::StringView name, bool value) { kppConfig(this.configs, name, value ? "true" : "false"); }
  void config(std::StringView name, i32 value) { kppConfig(this.configs, name, std::toString(value)); }
  void config(std::StringView name, const char* value) { kppConfig(this.configs, name, value); }
  void config(std::StringView name, std::StringView value) { kppConfig(this.configs, name, value); }
};

// What runs when build.kpp has no configure(Cell&): its own, a function, is chosen over a template.
template <typename C> void configure(C& cell) {}

// A C or C++ library the executables link (docs/build.md, "C and C++ libraries"): kpp compiles its
// sources with Visual Studio's clang-cl (/O2 /MT in every configuration, as Factorio's prebuilt
// libraries are) into build\clib\NAME.lib, or takes prebuilt .lib files as given.
struct CLibrary
{
  std::String name;
  std::Vector<std::String> sources;   // files, or directories: every .c, .cc and .cpp under them
  std::Vector<std::String> excluded;  // files under those directories left out
  std::Vector<std::String> includes;  // its include directories
  std::Vector<std::String> defines;   // NAME or NAME=VALUE
  std::Vector<std::String> prebuilt;  // .lib files used as they are, instead of sources
  std::Vector<std::String> resources; // .rc files, compiled into .res files the executables link
  std::String cppStandard;       // a C++ file's standard: c++17 (unset) or c++20
  std::String precompiled;       // its precompiled header, as its sources #include it (precompiledHeader)

  void source(std::StringView path) { this.sources.push_back(path); }
  void exclude(std::StringView path) { this.excluded.push_back(path); }
  void include(std::StringView path) { this.includes.push_back(path); }
  void define(std::StringView definition) { this.defines.push_back(definition); }
  void prebuiltLibrary(std::StringView path) { this.prebuilt.push_back(path); }
  void resource(std::StringView path) { this.resources.push_back(path); }
  void standard(std::StringView name) { this.cppStandard = name; }
  // A header built once and used by every source whose first directive includes it as written here
  // (`precompiledHeader("SDL_internal.h")`): its declarations are compiled once, not in each file.
  // The objects are the same as without it; a source that includes something else first, or has a
  // file of that name of its own beside it, is compiled as it is.
  void precompiledHeader(std::StringView header) { this.precompiled = header; }
  // With a platform, only a build for it (`define("_GNU_SOURCE", Platform::Linux)`, its --target), as
  // systemLibrary's: kept as "PLATFORM ENTRY" (compiler/src/Project/CLibraryBuild.cpp, forPlatform).
  void source(std::StringView path, Platform platform) { this.sources.push_back(kppPlatformLibrary(path, platform)); }
  void exclude(std::StringView path, Platform platform) { this.excluded.push_back(kppPlatformLibrary(path, platform)); }
  void include(std::StringView path, Platform platform) { this.includes.push_back(kppPlatformLibrary(path, platform)); }
  void define(std::StringView definition, Platform platform) { this.defines.push_back(kppPlatformLibrary(definition, platform)); }
  void prebuiltLibrary(std::StringView path, Platform platform) { this.prebuilt.push_back(kppPlatformLibrary(path, platform)); }
  void resource(std::StringView path, Platform platform) { this.resources.push_back(kppPlatformLibrary(path, platform)); }
};

// An option a kpp library declares (Library::option): what its code reads as config::LIB::NAME,
// whose value whatever uses the library gives (use(...).config, or config("LIB::NAME", ...) of the
// project, a configuration, a target or a cell, or kpp --config LIB::NAME=VALUE); without one, its
// default; a required option has none, and leaving it unset is an error.
struct LibraryOption
{
  std::String name;
  std::String type;           // bool, int or string
  std::String defaultValue;
  std::String description;
  bool required = false;
  std::Vector<std::String> allowed; // a string option's values; none: any
};

void kppOption(LibraryOption& o, std::StringView name, std::StringView type, std::StringView value, std::StringView description, bool required)
{
  o.name = name;
  o.type = type;
  o.defaultValue = value;
  o.description = description;
  o.required = required;
}

// A kpp library (docs/build.md, "kpp libraries"): a project without an executable, whose source
// roots join the program of every executable that uses it. Its build.kpp declares it with
// project.library(NAME); its tests are `test` blocks under its roots and its test roots, which
// `kpp --test` builds and runs.
struct Library
{
  std::String name;
  std::String version;           // major.minor.patch
  std::String license;           // an SPDX expression: Apache-2.0 WITH LLVM-exception, MIT, MIT OR Apache-2.0
  std::String minimumKpp;        // the lowest kpp version it compiles with, major.minor.patch; "": any
  std::Vector<std::String> roots;     // its sources, relative to its directory; none: src
  std::Vector<std::String> testRoots; // sources only its own tests build (tests next to the code need none)
  std::Deque<Dependency> uses;  // the libraries it uses
  std::Deque<LibraryOption> options; // what its users set (a Deque: option() returns a reference)
  // Its names are qualified by its name for its users (zlib::compress), bare inside it; unscoped:
  // bare everywhere, sharing the one global scope (the stdlib is). design.md 16.
  bool unscoped = false;
  // Its sources (and tests) are written with `this` the object (design.md 23d), whoever uses it: until that is the default.
  bool thisReference = false;
  std::Vector<std::String> systemLibraries; // systemLibrary()'s: NAME, or PLATFORM NAME (windows, linux, freebsd)

  void root(std::StringView path) { this.roots.push_back(path); }
  void test(std::StringView path) { this.testRoots.push_back(path); }
  // A system library every program using this one links, its own tests too: kpp's --lib -lNAME
  // (`systemLibrary("ssl")`), as Executable::systemLibrary; with a platform, only a build for it
  // (`systemLibrary("ssl", Platform::FreeBSD)`).
  void systemLibrary(std::StringView name) { this.systemLibraries.push_back(name); }
  void systemLibrary(std::StringView name, Platform platform) { this.systemLibraries.push_back(kppPlatformLibrary(name, platform)); }

  // An option with its default: `option("debug", false, "Extra consistency checks")`; a string option
  // may list the values it can have: `option("mode", "fast", "Its speed", {"fast", "small"})`. Each
  // returns its LibraryOption. (Each emplaces itself: tests/spec/language/
  // consteval_returned_deque_reference_chained.)
  LibraryOption& option(std::StringView name, bool value, std::StringView description)
  {
    LibraryOption& o = this.options.emplace_back();
    kppOption(o, name, "bool", value ? "true" : "false", description, false);
    return o;
  }

  LibraryOption& option(std::StringView name, i32 value, std::StringView description)
  {
    LibraryOption& o = this.options.emplace_back();
    kppOption(o, name, "int", std::toString(value), description, false);
    return o;
  }

  LibraryOption& option(std::StringView name, const char* value, std::StringView description)
  {
    LibraryOption& o = this.options.emplace_back();
    kppOption(o, name, "string", value, description, false);
    return o;
  }

  LibraryOption& option(std::StringView name, const char* value, std::StringView description, std::InitializerList<std::StringView> values)
  {
    LibraryOption& o = this.options.emplace_back();
    kppOption(o, name, "string", value, description, false);
    for (std::StringView v : values)
      o.allowed.push_back(v);
    return o;
  }

  // An option without a default, of type bool, int or string, which every user must set.
  LibraryOption& requiredOption(std::StringView name, std::StringView type, std::StringView description)
  {
    LibraryOption& o = this.options.emplace_back();
    kppOption(o, name, type, "", description, true);
    return o;
  }

  Dependency& use(std::StringView name, std::StringView minimum = "")
  {
    Dependency& d = this.uses.emplace_back();
    kppUse(d, name, minimum, "");
    return d;
  }

  Dependency& use(std::StringView name, LibrarySource source)
  {
    Dependency& d = this.uses.emplace_back();
    kppUse(d, name, "", source.path);
    return d;
  }
};

// What `kpp measure` times (docs/build.md, "kpp measure"): build.kpp's edits, each a row of its
// table, made and undone in the cell measured, and per row, optionally, another build's command to
// compare with (`kpp measure --compare DIR` runs it in DIR).
struct MeasureEdit
{
  std::String row;  // the table's row: "Edit of one function"
  std::String file; // relative to the project's directory
  std::String from; // what the file holds exactly once, replaced by `to` and back
  std::String to;
};

struct MeasureCompare
{
  std::String row;     // an edit's row, "clean" (the clean build), or "whole TARGET" (a whole build)
  std::String command; // run by cmd in the directory --compare names
  std::String touch;   // a file there, relative to it, whose time is set first (an edit for a build that
                  // rebuilds what includes it): "" none
};

struct Measure
{
  std::String target;        // the cell the edits and the clean build build: "" the first executable
  std::String configuration; // "" debug
  std::Deque<MeasureEdit> edits;
  std::Deque<MeasureCompare> compares;

  // A row: the file's text `from` (there exactly once) replaced by `to`, built, then put back, built.
  void edit(std::StringView row, std::StringView file, std::StringView from, std::StringView to)
  {
    MeasureEdit& e = this.edits.emplace_back();
    e.row = row;
    e.file = file;
    e.from = from;
    e.to = to;
  }

  // The other build of a row, run in --compare's directory after `touch` is touched.
  void compare(std::StringView row, std::StringView command, std::StringView touch = "")
  {
    MeasureCompare& c = this.compares.emplace_back();
    c.row = row;
    c.command = command;
    c.touch = touch;
  }
};

struct Project
{
  // For every executable, before its own.
  std::Vector<std::String> arguments;
  std::Vector<std::String> libraries;
  std::Vector<std::String> cIncludes;
  std::Deque<Dependency> uses;
  std::Vector<std::String> configs; // config:: constants of every cell, under the configuration's and the target's
  // Deques: adding one leaves the references earlier calls returned valid.
  std::Deque<Executable> executables;
  std::Deque<CLibrary> cLibraries;
  std::Deque<Library> kppLibraries;
  std::Deque<Configuration> configurations; // the ones build() named; debug and release are there either way
  Measure measurement;                 // kpp measure's (measure())

  Executable& executable(std::StringView name, std::InitializerList<std::StringView> roots)
  {
    Executable& e = this.executables.emplace_back();
    e.name = name;
    for (std::StringView root : roots)
      e.roots.push_back(root);
    return e;
  }

  CLibrary& cLibrary(std::StringView name)
  {
    CLibrary& c = this.cLibraries.emplace_back();
    c.name = name;
    return c;
  }

  // This project is a kpp library (struct Library).
  Library& library(std::StringView name)
  {
    Library& l = this.kppLibraries.emplace_back();
    l.name = name;
    return l;
  }

  // The configuration NAME (debug, release, or one of the project's), made when new.
  Configuration& configuration(std::StringView name)
  {
    for (Configuration& c : this.configurations)
      if (c.name == name)
        return c;
    Configuration& c = this.configurations.emplace_back();
    c.name = name;
    return c;
  }

  // The configuration NAME based on BASE: BASE's settings, then its own.
  Configuration& configuration(std::StringView name, std::StringView base)
  {
    Configuration& c = this.configuration(name);
    c.base = base;
    return c;
  }

  void argument(std::StringView option) { this.arguments.push_back(option); }

  // What `kpp measure` times, in the cell TARGET CONFIGURATION ("": the first executable; debug):
  // `project.measure("factorio").edit("Edit of one function", "src/A.kpp", "old", "new")`.
  Measure& measure(std::StringView target = "", std::StringView configuration = "debug")
  {
    this.measurement.target = target;
    this.measurement.configuration = configuration;
    return this.measurement;
  }

  // A file the link takes for every executable: a .lib, -lname, a .res (kpp's --lib).
  void linkFile(std::StringView path) { this.libraries.push_back(path); }
  void cInclude(std::StringView path) { this.cIncludes.push_back(path); }
  void cInclude(std::StringView path, Platform platform) { this.cIncludes.push_back(kppPlatformLibrary(path, platform)); }

  // A kpp library every executable uses (docs/build.md, "kpp libraries"): use("json") finds it in
  // libraries/json, use("json", "1.4") also states the lowest version that will do, and
  // use("json", local("../json")) gives its directory.
  Dependency& use(std::StringView name, std::StringView minimum = "")
  {
    Dependency& d = this.uses.emplace_back();
    kppUse(d, name, minimum, "");
    return d;
  }

  Dependency& use(std::StringView name, LibrarySource source)
  {
    Dependency& d = this.uses.emplace_back();
    kppUse(d, name, "", source.path);
    return d;
  }

  // A config:: constant of every cell.
  void config(std::StringView name, bool value) { kppConfig(this.configs, name, value ? "true" : "false"); }
  void config(std::StringView name, i32 value) { kppConfig(this.configs, name, std::toString(value)); }
  void config(std::StringView name, const char* value) { kppConfig(this.configs, name, value); }
  void config(std::StringView name, std::StringView value) { kppConfig(this.configs, name, value); }

  // A value given on kpp's command line (`kpp --set GAME=D:\game`), or otherwise.
  std::String setting(std::StringView name, std::StringView otherwise) const { return kppSetting(name, otherwise); }
};

void kppLine(std::String& out, std::StringView key, std::StringView value)
{
  if (value.size() == 0)
    return;
  out << key;
  out << ' ';
  out << value;
  out << '\n';
}

void kppLines(std::String& out, std::StringView key, const std::Vector<std::String>& values)
{
  for (const std::String& value : values)
    kppLine(out, key, value);
}

void kppUses(std::String& out, const std::Deque<Dependency>& uses)
{
  for (const Dependency& d : uses)
  {
    kppLine(out, "use", d.name);
    kppLine(out, "use-minimum", d.minimum);
    kppLine(out, "use-path", d.path);
    kppLines(out, "use-config", d.configs);
  }
}

// config:: constants with where they were set: `config SOURCE NAME=VALUE`.
void kppConfigs(std::String& out, std::StringView source, const std::Vector<std::String>& configs)
{
  for (const std::String& c : configs)
  {
    out << "config ";
    out << source;
    out << ' ';
    out << c;
    out << '\n';
  }
}

void kppAppend(std::Vector<std::String>& to, const std::Vector<std::String>& from)
{
  for (const std::String& s : from)
    to.push_back(s);
}

// configuration with its bases' settings in, the first base's first: into resolved, whose name is
// the configuration's and base empty. debug and release start from their built-in settings. An error
// (a base that is not there, a cycle) is an `error` line in out.
void kppResolve(const Project& project, const Configuration& configuration, Configuration& resolved, std::String& out)
{
  // The chain from configuration to the base that has none.
  std::Vector<const Configuration*> chain;
  chain.push_back(&configuration);
  std::String builtIn; // the chain ends at debug or release that build.kpp did not name
  while (chain.back()->base.size() != 0 && builtIn.size() == 0)
  {
    const Configuration* base = nullptr;
    for (const Configuration& c : project.configurations)
      if (c.name == chain.back()->base)
        base = &c;
    if (!base && (chain.back()->base == "debug" || chain.back()->base == "release"))
      builtIn = std::StringView(chain.back()->base);
    else if (!base)
    {
      kppLine(out, "error", std::String("the configuration ") + chain.back()->name + " is based on " + chain.back()->base +
                              ", which build.kpp does not declare (project.configuration)");
      return;
    }
    else if (chain.size() > project.configurations.size())
    {
      kppLine(out, "error", std::String("the configuration ") + configuration.name + " is based on itself");
      return;
    }
    else
      chain.push_back(base);
  }
  std::StringView root = builtIn.size() != 0 ? std::StringView(builtIn) : std::StringView(chain.back()->name);
  if (root == "debug")
  {
    resolved.optimize = false;
    resolved.debugInfo = true;
    resolved.config("debug", true);
  }
  else if (root == "release")
  {
    // (debug information in a file of its own beside the executable, its code unchanged, for crash
    // reports as Factorio's release builds have it: kovarex 2026-11-07, docs/build.md question 1)
    resolved.optimize = true;
    resolved.debugInfo = true;
    resolved.config("debug", false);
  }
  // (through a StringView: tests/spec/language/consteval_string_assigned_through_reference)
  resolved.name = std::StringView(configuration.name);
  for (u64 i = chain.size(); i > 0; --i)
  {
    const Configuration& c = *chain[i - 1];
    if (c.optimize.has_value())
      resolved.optimize = c.optimize;
    if (c.debugInfo.has_value())
      resolved.debugInfo = c.debugInfo;
    kppAppend(resolved.configs, c.configs);
    kppAppend(resolved.clangFlags, c.clangFlags);
    kppAppend(resolved.cFlags, c.cFlags);
    kppAppend(resolved.arguments, c.arguments);
  }
}

// A configuration's own lines: its options and constants, the project's constants first.
void kppConfigurationLines(std::String& out, const Project& project, const Configuration& c)
{
  kppLine(out, "optimize", c.optimize.value_or(false) ? "1" : "0");
  kppLine(out, "debug-info", c.debugInfo.value_or(false) ? "1" : "0");
  kppConfigs(out, "project", project.configs);
  kppConfigs(out, "configuration", c.configs);
  kppLines(out, "clang-flag", c.clangFlags);
  kppLines(out, "c-flag", c.cFlags);
}

// The platform a --target names, as kpp's targetNamed reads it (compiler/src/target.hpp): its names
// and triples for Linux (x86-64 and AArch64), FreeBSD and macOS, Windows for the rest (windows,
// windows-gnu; a name kpp does not know fails kpp's build). kpp checks the cell's against its own
// (Project/Build.cpp), so that this copy cannot go wrong silently.
Platform kppTargetPlatform(std::StringView name)
{
  if (name == "linux" || name == "x86_64-unknown-linux-gnu" || name == "x86_64-linux-gnu" || name == "x86_64-pc-linux-gnu")
    return Platform::Linux;
  if (name == "linux-arm64" || name == "aarch64-unknown-linux-gnu" || name == "aarch64-linux-gnu" || name == "arm64-unknown-linux-gnu")
    return Platform::Linux;
  if (name == "freebsd" || name.startsWith("x86_64-unknown-freebsd"))
    return Platform::FreeBSD;
  bool apple = name.find("-apple-macos") != std::StringView::npos || name.find("-apple-darwin") != std::StringView::npos;
  if (name == "macos" || name == "macos-x64" ||
      (apple && (name.startsWith("arm64-") || name.startsWith("aarch64-") || name.startsWith("x86_64-"))))
    return Platform::Mac;
  return Platform::Windows;
}

// The last --target of arguments, into name.
void kppLastTarget(std::String& name, const std::Vector<std::String>& arguments)
{
  for (u64 i = 0; i + 1 < arguments.size(); ++i)
    if (arguments[i] == "--target")
      name = std::StringView(arguments[i + 1]); // (tests/spec/language/consteval_string_assigned_through_reference)
}

// A cell's platform (Cell::platform): the last --target of its arguments in kpp's order (the
// project's, the configuration's, the target's) and the command line's (kppCommandLineTarget, the
// generated settings').
Platform kppCellPlatform(const Project& project, const Configuration& resolved, const Executable& target)
{
  std::String name = kppHostTarget(); // (none given: the host's, kpp's default target)
  kppLastTarget(name, project.arguments);
  kppLastTarget(name, resolved.arguments);
  kppLastTarget(name, target.arguments);
  if (kppCommandLineTarget().size() != 0)
    name = kppCommandLineTarget();
  return kppTargetPlatform(name);
}

// One cell: configure(cell) on copies of the target and the resolved configuration, then its lines.
void kppCell(std::String& out, const Project& project, const Executable& target, const Configuration& resolved)
{
  Cell cell{resolved, target}; // (not assigned: tests/spec/language/consteval_struct_copy_assignment)
  cell.platform = kppCellPlatform(project, resolved, target);
  configure(cell);
  const Executable& e = cell.target;
  out << "cell ";
  out << e.name;
  out << ' ';
  out << resolved.name;
  out << '\n';
  kppLine(out, "platform", config::platformName(cell.platform));
  kppConfigurationLines(out, project, cell.configuration);
  kppConfigs(out, "target", e.configs);
  kppConfigs(out, "cell", cell.configs);
  kppLines(out, "root", e.roots);
  kppLines(out, "exclude", e.excluded);
  kppLines(out, "argument", project.arguments);
  kppLines(out, "argument", cell.configuration.arguments);
  kppLines(out, "argument", e.arguments);
  kppLines(out, "library", project.libraries);
  kppLines(out, "library", e.libraries);
  kppLines(out, "system-library", e.systemLibraries);
  kppLines(out, "natvis", e.natvisFiles);
  kppLines(out, "cinclude", project.cIncludes);
  kppLines(out, "cinclude", e.cIncludes);
  kppLine(out, "before-build", e.beforeBuildCommand);
  kppLine(out, "after-build", e.afterBuildCommand);
  kppLine(out, "debug-command", e.debugCommand);
  kppLine(out, "debug-arguments", e.debugArguments);
  kppLine(out, "debug-directory", e.debugDirectory);
  kppLines(out, "link", e.links);
  kppUses(out, project.uses);
  kppUses(out, e.uses);
  out << "end\n";
}

// One line per fact, which kpp reads (compiler/src/Project/DescribeFile.cpp): per configuration (debug, release, then the
// project's) `configuration NAME`, its resolved lines, `end`; per cell, target by target,
// `cell TARGET CONFIGURATION`, its lines, `end`; per C library `clibrary NAME`, its lines, `end`;
// per kpp library `kpp-library NAME`, its lines, `end`; `error TEXT` for what build.kpp got wrong.
// A project that describes neither an executable nor a library has one executable: its directory's
// name, from src.
std::String describe(const Project& project)
{
  std::String out;
  std::Vector<Configuration> resolved;
  for (std::StringView builtIn : {"debug", "release"})
  {
    bool named = false;
    for (const Configuration& c : project.configurations)
      named = named || c.name == builtIn;
    if (!named)
    {
      Configuration c;
      c.name = builtIn;
      Configuration& r = resolved.emplace_back();
      kppResolve(project, c, r, out);
    }
  }
  for (const Configuration& c : project.configurations)
  {
    Configuration& r = resolved.emplace_back(); // (bound first: tests/spec/language/consteval_emplace_back_result_as_reference_argument)
    kppResolve(project, c, r, out);
  }
  for (const Configuration& c : resolved)
  {
    kppLine(out, "configuration", c.name);
    kppConfigurationLines(out, project, c);
    kppLines(out, "argument", project.arguments);
    kppLines(out, "argument", c.arguments);
    out << "end\n";
  }
  if (project.executables.empty() && project.kppLibraries.empty())
  {
    Executable e;
    e.name = kppProjectName();
    e.root("src");
    for (const Configuration& c : resolved)
      kppCell(out, project, e, c);
  }
  for (const Executable& e : project.executables)
    for (const Configuration& c : resolved)
      kppCell(out, project, e, c);
  for (const CLibrary& c : project.cLibraries)
  {
    kppLine(out, "clibrary", c.name);
    kppLines(out, "source", c.sources);
    kppLines(out, "exclude", c.excluded);
    kppLines(out, "include", c.includes);
    kppLines(out, "define", c.defines);
    kppLines(out, "prebuilt", c.prebuilt);
    kppLines(out, "resource", c.resources);
    kppLine(out, "language", c.cppStandard);
    kppLine(out, "precompiled-header", c.precompiled);
    out << "end\n";
  }
  for (const Library& l : project.kppLibraries)
  {
    kppLine(out, "kpp-library", l.name);
    kppLine(out, "version", l.version);
    kppLine(out, "license", l.license);
    kppLine(out, "minimum-kpp", l.minimumKpp);
    if (l.unscoped)
      kppLine(out, "unscoped", "1");
    if (l.thisReference)
      kppLine(out, "this-reference", "1");
    if (l.roots.empty())
      kppLine(out, "root", "src");
    kppLines(out, "root", l.roots);
    kppLines(out, "test-root", l.testRoots);
    kppLines(out, "system-library", l.systemLibraries);
    // Per option: `option NAME`, its type, its default (none when required: `option-required`), its
    // values and its description.
    for (const LibraryOption& o : l.options)
    {
      kppLine(out, "option", o.name);
      kppLine(out, "option-type", o.type);
      if (o.required)
        out << "option-required 1\n";
      else
      {
        out << "option-default ";
        out << o.defaultValue;
        out << '\n';
      }
      kppLines(out, "option-value", o.allowed);
      kppLine(out, "option-description", o.description);
    }
    kppUses(out, project.uses);
    kppUses(out, l.uses);
    out << "end\n";
  }
  // `measure`, its cell, per edit `edit ROW` and its file and texts, per comparison `compare ROW`
  // and its command and file, `end`.
  const Measure& m = project.measurement;
  if (m.edits.size() != 0 || m.compares.size() != 0 || m.target.size() != 0)
  {
    out << "measure\n";
    kppLine(out, "measure-target", m.target);
    kppLine(out, "measure-configuration", m.configuration);
    for (const MeasureEdit& e : m.edits)
    {
      kppLine(out, "edit", e.row);
      kppLine(out, "edit-file", e.file);
      kppLine(out, "edit-from", e.from);
      kppLine(out, "edit-to", e.to);
    }
    for (const MeasureCompare& c : m.compares)
    {
      kppLine(out, "compare", c.row);
      kppLine(out, "compare-command", c.command);
      kppLine(out, "compare-touch", c.touch);
    }
    out << "end\n";
  }
  return out;
}
