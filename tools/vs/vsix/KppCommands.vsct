<?xml version="1.0" encoding="utf-8"?>
<!-- kpp's commands (KppPackage.cs): Tools > kpp > Show Coverage, Load Coverage File... -->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Commands package="guidKppPackage">
    <Menus>
      <Menu guid="guidKppCommands" id="KppMenu" priority="0x0700" type="Menu">
        <Parent guid="guidKppCommands" id="ToolsGroup" />
        <Strings>
          <ButtonText>kpp</ButtonText>
        </Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidKppCommands" id="ToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidKppCommands" id="KppMenuGroup" priority="0x0100">
        <Parent guid="guidKppCommands" id="KppMenu" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidKppCommands" id="ShowCoverage" priority="0x0100" type="Button">
        <Parent guid="guidKppCommands" id="KppMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Show Coverage</ButtonText>
          <CanonicalName>.Tools.kppShowCoverage</CanonicalName>
          <LocCanonicalName>.Tools.kppShowCoverage</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidKppCommands" id="LoadCoverage" priority="0x0101" type="Button">
        <Parent guid="guidKppCommands" id="KppMenuGroup" />
        <Strings>
          <ButtonText>Load Coverage File...</ButtonText>
          <CanonicalName>.Tools.kppLoadCoverageFile</CanonicalName>
          <LocCanonicalName>.Tools.kppLoadCoverageFile</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>
  <Symbols>
    <GuidSymbol name="guidKppPackage" value="{845d7c14-d316-4b0c-9ef2-efb3bf028d7b}" />
    <GuidSymbol name="guidKppCommands" value="{ff9d7826-43e3-4c47-816c-1baa99d5c2e8}">
      <IDSymbol name="ToolsGroup" value="0x1000" />
      <IDSymbol name="KppMenu" value="0x1001" />
      <IDSymbol name="KppMenuGroup" value="0x1002" />
      <IDSymbol name="ShowCoverage" value="0x0100" />
      <IDSymbol name="LoadCoverage" value="0x0101" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
