namespace shapes
{
  enum class Side
  {
    leftSide,
    rightSide
  };
  i32 globalCount = 7;
  class Box
  {
  public:
    implicit Box(f64 size) : width(size) {}
    f64 width = 1.5;
    static i32 total;
    i32 grow(i32 extra)
    {
      i32 result = extra;
      if (result)
        return result + 1;
      return this->size();
    }
    i32 size() { return Box::total; }
  };
  i32 Box::total = 8;
}
