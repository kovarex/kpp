// debugger-check.ps1 stops at area's first statement (line 8).
struct Square
{
  i32 side = 3;

  i32 area() const
  {
    i32 result = this.side * this.side;
    return result;
  }
};

struct Corner
{
  i32 x = 1;
  i32 y = 2;
};

// (members with rules: shown by them when the value is expanded)
struct Held
{
  Corner corner;
  std::String label = "held";
};

// (a set of flags: the names of the flags set, design.md 27)
flags Marks : u8 { Red, Green, Blue = 5 };
flags Wide { F0, F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16, F17, F18, F19 };

// (a handle shows the name in a template's static list, the game's ID<T>: a global read by the view)
struct Part
{
  std::String name;
};

template<class T>
struct Registry
{
  static std::Vector<T*> all;
};

template<class T>
struct Handle
{
  std::String debugValue() const
  {
    if (this.index == 0)
      return "{0}";
    return Registry<T>::all[this.index]->name;
  }
  u16 index = 0;
};

i32 main()
{
  Square square;
  square.side = 7;
  std::Vector<i32> numbers = {1, 2, 3};
  std::String name = "kpp";
  std::Deque<i32> queue;
  queue.push_back(5);
  Corner corner;
  Held held;
  Marks none;
  Marks one = Marks::Green;
  Marks many = Marks::Red | Marks::Blue | Marks::fromBits(64);
  Wide wide = Wide::fromBits(0xfffff);
  Part gear;
  gear.name = "gear";
  Registry<Part>::all.push_back(nullptr);
  Registry<Part>::all.push_back(&gear);
  Handle<Part> none0;
  Handle<Part> handle;
  handle.index = 1;
  std::println(square.area(), " ", numbers.size(), " ", name, " ", queue.size(), " ", corner.x, " ", held.label, " ", none, " ", one, " ", many, " ", wide, " ", handle.index, " ", none0.index);
  return 0;
}
