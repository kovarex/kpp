// debugger-check.ps1 stops at area's first statement (line 8).
struct Square
{
  i32 side = 3;

  i32 area() const
  {
    i32 result = this->side * this->side;
    return result;
  }
};

struct Corner
{
  i32 x = 1;
  i32 y = 2;
};

i32 main()
{
  Square square;
  square.side = 7;
  Vector<i32> numbers = {1, 2, 3};
  String name = "kpp";
  Deque<i32> queue;
  queue.push_back(5);
  Corner corner;
  println(square.area(), " ", numbers.size(), " ", name, " ", queue.size(), " ", corner.x);
  return 0;
}
