// debugger-check.ps1 stops at area's first statement (line 8).
struct Square
{
  i32 side = 3;

  i32 area() const
  {
    i32 result = this.side * this.side;
    return result;
  }
};

struct Corner
{
  i32 x = 1;
  i32 y = 2;
};

// (members with rules: shown by them when the value is expanded)
struct Held
{
  Corner corner;
  std::String label = "held";
};

i32 main()
{
  Square square;
  square.side = 7;
  std::Vector<i32> numbers = {1, 2, 3};
  std::String name = "kpp";
  std::Deque<i32> queue;
  queue.push_back(5);
  Corner corner;
  Held held;
  std::println(square.area(), " ", numbers.size(), " ", name, " ", queue.size(), " ", corner.x, " ", held.label);
  return 0;
}
