// debugger-check.ps1 stops at area's first statement (line 8).
struct Square
{
  i32 side = 3;

  i32 area() const
  {
    i32 result = this.side * this.side;
    return result;
  }
};

struct Corner
{
  i32 x = 1;
  i32 y = 2;
};

// (members with rules: shown by them when the value is expanded)
struct Held
{
  Corner corner;
  std::String label = "held";
};

// (a set of flags: the names of the flags set, design.md 27)
flags Marks : u8 { Red, Green, Blue = 5 };
flags Wide { F0, F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12, F13, F14, F15, F16, F17, F18, F19 };

// (a handle shows the name in a template's static list, the game's ID<T>: a global read by the view)
struct Prototype
{
  std::String name;
};

struct Part : public Prototype
{
};

struct Fluid : public Prototype
{
};

template<class T>
struct Handle;

template<class T>
struct Registry
{
  static std::Vector<T*> all;

  static const T* getPointer(const Handle<T>& handle)
  {
    assert(handle.index < Registry<T>::all.size());
    return Registry<T>::all[handle.index];
  }
};

template<class T>
struct Handle
{
  const T* getPrototype() const
  {
    if constexpr (sizeof(T) == 0)
      return nullptr;
    else
      return Registry<T>::getPointer(this);
  }
  std::String getName() const
  {
    if (this.index == 0)
      return "";
    return this.getPrototype()->name;
  }
  std::String debugValue() const
  {
    if (this.index == 0)
      return "{0}";
    return std::toString("{", this.index, ", ", this.getName(), "}");
  }
  Handle() = default;
  Handle(u16 index) : index(index) {}
  static Handle fromIndex(u16 index) { return Handle(index); }
  u16 index = 0;
};

// (the game's SignalIDBase: a type and an index, its view through its typeToStr and getName, which dispatches
// through a generic lambda per type and makes the type's Handle from the index)
struct Signal
{
  enum class Type : u8 { Part = 0, Fluid = 1 };

  static const char* typeToStr(Type type)
  {
    switch (type)
    {
      case Type::Part: return "part";
      case Type::Fluid: return "fluid";
    }
    abort();
  }

  template<class T>
  static auto applyOrAbort(Type type, T op)
  {
    switch (type)
    {
      case Type::Part: return op(Handle<Part>());
      case Type::Fluid: return op(Handle<Fluid>());
    }
    abort();
  }

  Type getType() const { return Type(u8(this.value >> 16)); }
  u16 getValueIndex() const { return u16(this.value); }
  template<class T>
  T getRaw() const { return T::fromIndex(this.getValueIndex()); }
  const Prototype* getPrototype() const
  {
    return Signal::applyOrAbort(this.getType(), [&]<class T>(T) -> const Prototype* { return this.getRaw<T>().getPrototype(); });
  }
  std::String getName() const
  {
    if (this.value == 0)
      return "";
    return this.getPrototype()->name;
  }
  std::String debugValue() const { return std::toString("{", std::StringView(Signal::typeToStr(this.getType())), " ", this.getName(), "}"); }

  u32 value = 0;
};

// (containers: their elements by their own begin() and end(), CustomListItems)
template<class T>
struct Ring
{
  template<class Type, class RingType>
  struct IteratorBase
  {
    IteratorBase(RingType* ring, u32 index) : ring(ring), index(index) {}
    bool operator==(const IteratorBase& other) const
    {
      assert(this.ring == other.ring);
      return this.index == other.index;
    }
    IteratorBase& operator++()
    {
      ++this.index;
      return this;
    }
    IteratorBase operator++(i32)
    {
      IteratorBase copy(this);
      ++this;
      return copy;
    }
    Type& operator*() const { return (*this.ring)[this.index]; }

    RingType* ring = nullptr;
    u32 index = 0;
  };

  using iterator = IteratorBase<T, Ring>;
  using const_iterator = IteratorBase<const T, const Ring>;

  iterator begin() { return iterator(&this, 0); }
  iterator end() { return iterator(&this, this.size()); }
  const_iterator begin() const { return this.cbegin(); }
  const_iterator end() const { return this.cend(); }
  const_iterator cbegin() const { return const_iterator(&this, 0); }
  const_iterator cend() const { return const_iterator(&this, this.size()); }
  u32 size() const { return this.count; }
  T& operator[](u32 index)
  {
    assert(index < this.count);
    return this.items[this.wrap(this.head + index)];
  }
  const T& operator[](u32 index) const
  {
    assert(index < this.count);
    return this.items[this.wrap(this.head + index)];
  }
  u32 wrap(u32 index) const
  {
    assert(index < this.capacity * 2);
    if (index >= this.capacity)
      index -= this.capacity;
    return index;
  }

  T* items = nullptr;
  u32 capacity = 0;
  u32 head = 0;
  u32 count = 0;
};

struct Shelf
{
  const i32* begin() const { return this.data; }
  const i32* end() const { return this.data + this.size; }

  i32* data = nullptr;
  u32 size = 0;
};

struct Link
{
  Link* next = nullptr;
  i32 value = 0;
};

struct Chain
{
  struct Iterator
  {
    Iterator(const Link* at) : at(at) {}
    bool operator==(const Iterator& other) const { return this.at == other.at; }
    Iterator& operator++()
    {
      this.at = this.at->next;
      return this;
    }
    const Link& operator*() const { return *this.at; }

    const Link* at = nullptr;
  };

  Iterator begin() const { return Iterator(this.head.next); }
  Iterator end() const { return Iterator(&this.head); }

  Link head;
};

i32 main()
{
  Square square;
  square.side = 7;
  std::Vector<i32> numbers = {1, 2, 3};
  std::String name = "kpp";
  std::Deque<i32> queue;
  queue.push_back(5);
  Corner corner;
  Held held;
  Marks none;
  Marks one = Marks::Green;
  Marks many = Marks::Red | Marks::Blue | Marks::fromBits(64);
  Wide wide = Wide::fromBits(0xfffff);
  Part gear;
  gear.name = "gear";
  Registry<Part>::all.push_back(nullptr);
  Registry<Part>::all.push_back(&gear);
  Handle<Part> none0;
  Handle<Part> handle;
  handle.index = 1;
  Handle<Part> outside;
  outside.index = 5;
  Fluid water;
  water.name = "water";
  Registry<Fluid>::all.push_back(nullptr);
  Registry<Fluid>::all.push_back(&water);
  Signal emptySignal;
  Signal gearSignal;
  gearSignal.value = 1;
  Signal waterSignal;
  waterSignal.value = (1u << 16) | 1u;
  Signal badSignal;
  badSignal.value = (7u << 16) | 1u;
  i32 ringItems[4] = {30, 40, 10, 20};
  Ring<i32> ring;
  ring.items = ringItems;
  ring.capacity = 4;
  ring.head = 2;
  ring.count = 3;
  i32 shelved[3] = {7, 8, 9};
  Shelf shelf;
  shelf.data = shelved;
  shelf.size = 3;
  Chain chain;
  Link first, second;
  first.value = 1;
  second.value = 2;
  chain.head.next = &first;
  first.next = &second;
  second.next = &chain.head;
  std::println(square.area(), " ", numbers.size(), " ", name, " ", queue.size(), " ", corner.x, " ", held.label, " ", none, " ", one, " ", many, " ", wide, " ", handle.index, " ", none0.index, " ", outside.index, " ", emptySignal.value, " ", gearSignal.value, " ", waterSignal.value, " ", badSignal.value, " ", ring.count, " ", shelf.size, " ", chain.head.next->value);
  return 0;
}
