// The page: static; its script reads ?json every 5 seconds and draws the job running now, the queue
// and the finished jobs, with the running times counted in the browser (the times PRACOVNA posts carry
// their UTC offset).
constexpr std::StringView boardPage = R"(<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>heavy slot</title>
<style>
:root { --bg: #fff; --fg: #1a1a1a; --muted: #666; --line: #ddd; --head: #f3f3f3; --ok: #1a7f37; --bad: #c62828; --ex: #8250df; --hv: #0969da; }
@media (prefers-color-scheme: dark) { :root { --bg: #161616; --fg: #e6e6e6; --muted: #999; --line: #333; --head: #222; --ok: #4ac26b; --bad: #ff6b6b; --ex: #b392f0; --hv: #58a6ff; } }
body { background: var(--bg); color: var(--fg); font: 14px/1.4 system-ui, sans-serif; margin: 16px; }
h1 { font-size: 18px; margin: 0 0 4px; } h2 { font-size: 15px; margin: 20px 0 6px; }
.muted, .none { color: var(--muted); } .wrap { overflow-x: auto; } table { border-collapse: collapse; width: 100%; }
th, td { border-bottom: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
th { background: var(--head); font-weight: 600; } td.cmd { font-family: Consolas, monospace; font-size: 12px; word-break: break-all; }
.exclusive { color: var(--ex); font-weight: 600; } .heavy { color: var(--hv); } .ok { color: var(--ok); } .bad { color: var(--bad); font-weight: 600; }
</style></head><body>
<h1>PRACOVNA heavy slot</h1>
<div class="muted" id="written">loading...</div>
<h2>Running</h2>
<div class="wrap"><table><thead><tr><th>kind</th><th>folder</th><th>command</th><th>started</th><th>running</th></tr></thead><tbody id="running"></tbody></table></div>
<h2>Waiting</h2>
<div class="wrap"><table><thead><tr><th>#</th><th>kind</th><th>folder</th><th>command</th><th>queued</th><th>waiting</th></tr></thead><tbody id="queue"></tbody></table></div>
<h2>Finished</h2>
<div class="wrap"><table><thead><tr><th>kind</th><th>folder</th><th>command</th><th>started</th><th>waited</th><th>took</th><th>exit</th></tr></thead><tbody id="finished"></tbody></table></div>
<script>
function d(s) { s = Math.max(0, Math.floor(s)); var h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60;
  return h ? h + 'h ' + String(m).padStart(2, '0') + 'm' : m ? m + 'm ' + String(x).padStart(2, '0') + 's' : x + 's'; }
function t(iso, withDay) { var v = new Date(iso); if (isNaN(v)) return ''; var two = function (n) { return String(n).padStart(2, '0'); };
  return (withDay ? two(v.getMonth() + 1) + '-' + two(v.getDate()) + ' ' : '') + two(v.getHours()) + ':' + two(v.getMinutes()) + ':' + two(v.getSeconds()); }
function cell(row, text, cls) { var c = row.insertCell(); c.textContent = text == null ? '' : String(text); if (cls) c.className = cls; return c; }
function none(body, columns, text) { var r = body.insertRow(); var c = cell(r, text, 'none'); c.colSpan = columns; }
function draw(s) {
  document.getElementById('written').textContent = s.written ? 'Posted by PRACOVNA ' + t(s.written, true) + ' (your local time). Reloads every 5 s.' : 'Nothing posted yet.';
  var running = document.getElementById('running'); running.innerHTML = '';
  if (s.running) { var r = running.insertRow(); cell(r, s.running.kind, s.running.kind); cell(r, s.running.folder); cell(r, s.running.label, 'cmd'); cell(r, t(s.running.since));
    cell(r, '').dataset.since = s.running.since; } else none(running, 5, 'free');
  var queue = document.getElementById('queue'); queue.innerHTML = '';
  (s.queue || []).forEach(function (q, i) { var r = queue.insertRow(); cell(r, i + 1); cell(r, q.kind, q.kind); cell(r, q.folder); cell(r, q.label, 'cmd'); cell(r, t(q.since));
    cell(r, '').dataset.since = q.since; });
  if (!(s.queue || []).length) none(queue, 6, 'nobody waiting');
  var finished = document.getElementById('finished'); finished.innerHTML = '';
  (s.finished || []).forEach(function (f) { var r = finished.insertRow(); cell(r, f.kind, f.kind); cell(r, f.folder); cell(r, f.label, 'cmd'); cell(r, t(f.started, true));
    cell(r, d((new Date(f.started) - new Date(f.queued)) / 1000)); cell(r, d((new Date(f.ended) - new Date(f.started)) / 1000)); cell(r, f.exit, f.exit === 0 ? 'ok' : 'bad'); });
  if (!(s.finished || []).length) none(finished, 7, 'none yet');
  tick(); }
function tick() { document.querySelectorAll('[data-since]').forEach(function (e) { e.textContent = d((Date.now() - new Date(e.dataset.since)) / 1000); }); }
function load() { fetch('?json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(draw)
  .catch(function () { document.getElementById('written').textContent = 'Could not read the status.'; }); }
load(); setInterval(load, 5000); setInterval(tick, 1000);
</script>
</body></html>
)";
