// heavyboard's handler on a data directory of its own: the page, an update with no, a wrong and the
// right password, what ?json gives back, and an update that is not JSON.
std::String boardTestDirectoryName() { return std::filesystem::temp_directory_path().string() + "/heavyboard-test"; }

std::String boardTestDirectory()
{
  std::String directory = boardTestDirectoryName();
  std::filesystem::remove_all(std::filesystem::path(directory));
  std::filesystem::create_directories(std::filesystem::path(directory));
  return directory;
}

http::HttpResponse boardTestCall(std::StringView method, std::StringView query, std::StringView password, std::StringView body)
{
  http::HttpRequest request;
  request.method = std::String(method);
  request.path = "/index.cgi";
  if (!query.empty())
    request.parameters.push_back(url::UrlQueryParameter{std::String(query), std::String()});
  if (!password.empty())
    request.headers.push_back(http::HttpHeader{"x-heavy-password", std::String(password)});
  request.body = std::String(body);
  http::HttpResponse response;
  boardHandleIn(request, response, boardTestDirectoryName());
  return response;
}

test BoardUpdates
{
  std::String directory = boardTestDirectory();
  check(boardTestCall("GET", "", "", "").body.find("PRACOVNA heavy slot") != std::String::npos);
  check(boardTestCall("GET", "json", "", "").body == "{}");
  check(boardTestCall("POST", "update", "secret", "{}").status == 503); // no password set yet
  boardWriteFile(directory + "/password", "secret  \n");
  check(boardTestCall("POST", "update", "", "{}").status == 403);
  check(boardTestCall("POST", "update", "secreT", "{}").status == 403);
  check(boardTestCall("GET", "update", "secret", "{}").status == 405);
  check(boardTestCall("POST", "update", "secret", "{\"written\": 1,}").status == 400);
  check(boardTestCall("POST", "update", "secret", "[1]").status == 400);
  check(boardTestCall("POST", "update", "secret", "{\"running\": null, \"queue\": []}").status == 204);
  check(boardTestCall("GET", "json", "", "").body == "{\"running\":null,\"queue\":[]}");
}
