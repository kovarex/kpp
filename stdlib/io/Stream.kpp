// File streams: a thin wrapper over C stdio that gives the interface std::ifstream/ofstream
// convert to. FILE and stderr are declared in clib/CStdio.kpp and its platforms' files.
//
// A stream's state is its own, as std's is: what its operations met, not whether a file is open or
// what the file's own flags say. good(), eof() and the truth value are std's ([iostate.flags]): the
// truth value is "nothing failed", so a stream that only reached the end, or was closed, is true.

class InFileStream
{
public:
  InFileStream() {}
  InFileStream(const char* filename) { this.open(filename); }
  InFileStream(const String& filename) { this.open(filename.c_str()); }
  InFileStream(const InFileStream&) = delete;
  InFileStream(InFileStream&& other) : handle(other.handle), atEnd(other.atEnd), failed(other.failed) { other.handle = nullptr; }

  ~InFileStream()
  {
    if (this.handle)
      fclose(this.handle);
  }

  // A stream with a file open stays as it is and fails, as std::filebuf's open; a file that opens
  // clears the state.
  void open(const char* filename)
  {
    FILE* opened = this.handle ? nullptr : fopen(filename, "rb");
    if (!opened)
    {
      this.failed = true;
      return;
    }
    this.handle = opened;
    this.atEnd = false;
    this.failed = false;
  }

  void open(const String& filename) { this.open(filename.c_str()); }
  bool is_open() const { return this.handle != nullptr; }
  bool isOpen() const { return this.handle != nullptr; }

  // Closing keeps the state, and fails for a stream with no file (std::ifstream::close).
  void close()
  {
    if (!this.handle || fclose(this.handle) != 0)
      this.failed = true;
    this.handle = nullptr;
  }

  bool good() const { return !this.atEnd && !this.failed; }
  bool eof() const { return this.atEnd; }
  bool fail() const { return this.failed; }
  operator bool() const { return !this.failed; }
  bool operator!() const { return this.failed; }

  // Forgets the state; the file stays where it is. The next read asks the file again, so a file that
  // grew since its end was reached goes on (std::basic_ios::clear; clearerr as C's stdio would
  // otherwise keep answering from its own end flag).
  void clear()
  {
    this.atEnd = false;
    this.failed = false;
    if (this.handle)
      clearerr(this.handle);
  }

  // The next byte. -1 past the end, which fails and sets the end, and of a stream that is not good,
  // which fails.
  i32 get()
  {
    if (!this.ready())
      return -1;
    i32 c = this.rawGet();
    if (c == -1)
    {
      this.atEnd = true;
      this.failed = true;
    }
    return c;
  }

  // The next byte or -1, touching no state: what std::istreambuf_iterator reads, the stream's buffer
  // past its state.
  i32 rawGet() { return this.handle ? fgetc(this.handle) : -1; }

  // Skips up to count bytes, through the first delimiter met (std::istream::ignore; the tests'
  // ForkLogic skips an XML declaration with `in.ignore(Limits<StreamSize>::max(), '>')`). Reaching
  // the end sets the end and is no failure.
  InFileStream& ignore(i64 count = 1, i32 delimiter = -1)
  {
    if (!this.ready())
      return this;
    for (i64 i = 0; i < count; ++i)
    {
      i32 c = this.rawGet();
      if (c == -1)
      {
        this.atEnd = true;
        break;
      }
      if (c == delimiter)
        break;
    }
    return this;
  }

  // The end coming before count bytes fails and sets the end.
  InFileStream& read(char* buffer, ContainerSize count)
  {
    if (!this.ready())
      return this;
    usize got = this.handle ? fread(buffer, 1, count, this.handle) : (usize)0;
    if ((ContainerSize)got < count)
    {
      this.atEnd = true;
      this.failed = true;
    }
    return this;
  }

  // Clears the end first; a stream that failed stays where it is, failed (std::istream::seekg).
  InFileStream& seekg(long pos)
  {
    this.atEnd = false;
    if (!this.failed && (!this.handle || fseek(this.handle, pos, 0) != 0))
      this.failed = true;
    return this;
  }

  // -1 of a stream that is not good, which fails (std::istream::tellg, through its sentry).
  long tellg()
  {
    if (!this.ready() || !this.handle)
      return -1;
    return ftell(this.handle);
  }

  // What getline reads (std::getline): a stream that is not good fails and leaves line as it was; the
  // end before any byte fails and sets the end, the end after a last line with no delimiter only sets it.
  bool readLine(String& line, char delimiter)
  {
    if (!this.ready())
      return false;
    line = String();
    bool extracted = false;
    i32 c;
    while ((c = this.rawGet()) != -1)
    {
      extracted = true;
      if ((char)c == delimiter)
      {
        if (delimiter == '\n' && !line.empty() && line.back() == '\r')
          line.pop_back();
        return true;
      }
      line.append((char)c);
    }
    this.atEnd = true;
    this.failed = !extracted;
    return extracted;
  }

private:
  // std's istream::sentry for these unformatted input functions: a stream that is not good fails.
  bool ready()
  {
    if (!this.good())
      this.failed = true;
    return this.good();
  }

  FILE* handle = nullptr;
  bool atEnd = false;
  bool failed = false;
};

// The output streams' base (what std::ostream is to code that writes to any stream: UnitTest++'s
// XmlTestReporter writes its report to the stream it is given, the tests' an OutFileStream). A
// stream writes the bytes (writeBytes); `<<` writes text (a String whole, NUL bytes too), a char,
// a u8 and an i8 as the character each holds (C++'s unsigned char and signed char, which
// std::ostream writes as characters), the other numbers as std::ostream's defaults do (%d, %u,
// %lld, %llu, %g), and endl a newline.
class OutStream
{
public:
  virtual ~OutStream() {}
  virtual void writeBytes(const char* data, ContainerSize count) = 0;

  // count bytes from data, as they are (std::ostream::write; TestBitmapUtil dumps a pointer's bytes).
  OutStream& write(const char* data, ContainerSize count)
  {
    this.writeBytes(data, count);
    return this;
  }
};

// In pieces of at most maxContainerSize bytes, writeBytes' count being a size (core/Sizes.kpp).
OutStream& operator<<(OutStream& s, const char* text)
{
  usize remaining = strlen(text);
  while (remaining > 0)
  {
    ContainerSize piece = remaining > (usize)maxContainerSize ? maxContainerSize : (ContainerSize)remaining;
    s.writeBytes(text, piece);
    text += piece;
    remaining -= piece;
  }
  return s;
}

OutStream& operator<<(OutStream& s, const String& text)
{
  s.writeBytes(text.data(), text.size());
  return s;
}

OutStream& operator<<(OutStream& s, char c)
{
  s.writeBytes(&c, 1);
  return s;
}

// A u8 or an i8 as the character it holds, as std::ostream's inserters for unsigned char and signed
// char ([ostream.inserters.character]; until 2026-11-09 a u8 promoted to the i32 overload, and
// `out << (u8)65` wrote "65" for std's "A").
OutStream& operator<<(OutStream& s, u8 c)
{
  char byte = (char)c;
  s.writeBytes(&byte, 1);
  return s;
}

OutStream& operator<<(OutStream& s, i8 c)
{
  char byte = (char)c;
  s.writeBytes(&byte, 1);
  return s;
}

OutStream& operator<<(OutStream& s, i32 value)
{
  char text[16];
  s.writeBytes(text, snprintf(text, sizeof(text), "%d", value));
  return s;
}

OutStream& operator<<(OutStream& s, u32 value)
{
  char text[16];
  s.writeBytes(text, snprintf(text, sizeof(text), "%u", value));
  return s;
}

OutStream& operator<<(OutStream& s, i64 value)
{
  char text[24];
  s.writeBytes(text, snprintf(text, sizeof(text), "%lld", value));
  return s;
}

OutStream& operator<<(OutStream& s, u64 value)
{
  char text[24];
  s.writeBytes(text, snprintf(text, sizeof(text), "%llu", value));
  return s;
}

OutStream& operator<<(OutStream& s, double value)
{
  char text[32];
  s.writeBytes(text, snprintf(text, sizeof(text), "%g", value));
  return s;
}

OutStream& operator<<(OutStream& s, EndlTag)
{
  s.writeBytes("\n", 1);
  return s;
}

class OutFileStream : public OutStream
{
public:
  FILE* handle = nullptr;

  void writeBytes(const char* data, ContainerSize count) override { this.write(data, count); }

  OutFileStream() {}
  OutFileStream(const char* filename) { this.open(filename); }
  OutFileStream(const String& filename) { this.open(filename.c_str()); }
  OutFileStream(const OutFileStream&) = delete;
  OutFileStream(OutFileStream&& other) : handle(other.handle), failed(other.failed) { other.handle = nullptr; }

  ~OutFileStream()
  {
    if (this.handle)
      fclose(this.handle);
  }

  // As InFileStream's: a stream with a file open stays as it is and fails; a file that opens clears
  // the state.
  void open(const char* filename)
  {
    FILE* opened = this.handle ? nullptr : fopen(filename, "wb");
    if (!opened)
    {
      this.failed = true;
      return;
    }
    this.handle = opened;
    this.failed = false;
  }

  void open(const String& filename) { this.open(filename.c_str()); }
  bool is_open() const { return this.handle != nullptr; }
  bool isOpen() const { return this.handle != nullptr; }

  // Closing keeps the state: `out.close(); if (!out)` asks whether the writes worked. It fails for a
  // stream with no file, and for a file that did not take what was written.
  void close()
  {
    bool worked = this.handle && ferror(this.handle) == 0;
    if (this.handle && fclose(this.handle) != 0)
      worked = false;
    this.handle = nullptr;
    if (!worked)
      this.failed = true;
  }

  bool good() const { return !this.failed && (!this.handle || ferror(this.handle) == 0); }
  operator bool() const { return this.good(); }

  // A stream that failed writes nothing, and one with no file fails, as std's ostream.
  OutFileStream& write(const char* data, ContainerSize count)
  {
    if (!this.good() || count == 0)
      return this;
    if (!this.handle || (ContainerSize)fwrite(data, 1, count, this.handle) != count)
      this.failed = true;
    return this;
  }

  void flush()
  {
    if (this.handle)
      fflush(this.handle);
  }

private:
  bool failed = false;
};

// The << operator for streams, so `cerr << "text" << value << endl;` works.
struct StderrStream
{
  FILE* handle()
  {
    return stderr;
  }
};

StderrStream& operator<<(StderrStream& s, const char* text)
{
  fputs(text, s.handle());
  return s;
}

// The String whole, NUL bytes too, as std::string's inserter writes size() characters (fputs stopped
// at the first NUL until 2026-11-09).
StderrStream& operator<<(StderrStream& s, const String& text)
{
  fwrite(text.data(), 1, text.size(), s.handle());
  return s;
}

StderrStream& operator<<(StderrStream& s, i32 value)
{
  fprintf(s.handle(), "%d", value);
  return s;
}

StderrStream& operator<<(StderrStream& s, i64 value)
{
  fprintf(s.handle(), "%lld", value);
  return s;
}

StderrStream& operator<<(StderrStream& s, u32 value)
{
  fprintf(s.handle(), "%u", value);
  return s;
}

StderrStream& operator<<(StderrStream& s, double value)
{
  fprintf(s.handle(), "%g", value);
  return s;
}

StderrStream& operator<<(StderrStream& s, char c)
{
  fputc(c, s.handle());
  return s;
}

// A u8 or an i8 as the character it holds, as OutStream's.
StderrStream& operator<<(StderrStream& s, u8 c)
{
  fputc(c, s.handle());
  return s;
}

StderrStream& operator<<(StderrStream& s, i8 c)
{
  fputc((u8)c, s.handle());
  return s;
}

StderrStream& operator<<(StderrStream& s, const void* ptr)
{
  fprintf(s.handle(), "%p", ptr);
  return s;
}

// endl: writes a newline and flushes.
struct EndlTag {};
const EndlTag endl;

StderrStream& operator<<(StderrStream& s, EndlTag)
{
  fputc('\n', s.handle());
  fflush(s.handle());
  return s;
}

OutFileStream& operator<<(OutFileStream& s, const char* text)
{
  return s.write(text, (ContainerSize)strlen(text));
}

// The String whole, NUL bytes too, as OutStream's (fputs stopped at the first NUL until 2026-11-09).
OutFileStream& operator<<(OutFileStream& s, const String& text)
{
  return s.write(text.data(), text.size());
}

OutFileStream& operator<<(OutFileStream& s, EndlTag)
{
  s.write("\n", 1);
  s.flush();
  return s;
}

StderrStream cerr;

// getline: reads from an InFileStream until a delimiter. Files are bytes on every platform (no
// text mode, kovarex 2026-11-06), so a line that ends with "\r\n" would keep its '\r': with the
// newline as delimiter, a '\r' right before it is dropped (kovarex 2026-11-06), on every platform.
bool getline(InFileStream& stream, String& line, char delimiter = '\n')
{
  return stream.readLine(line, delimiter);
}
