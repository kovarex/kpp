// File streams: a thin wrapper over C stdio that gives the interface std::ifstream/ofstream
// convert to. FILE* is declared in clib/CStdio.kpp.
extern "C" void* __acrt_iob_func(unsigned index);

struct InFileStream
{
  void* handle = nullptr;

  InFileStream() {}
  explicit InFileStream(const char* filename) { this->open(filename); }
  explicit InFileStream(const String& filename) { this->open(filename.c_str()); }
  InFileStream(const InFileStream&) = delete;
  InFileStream(InFileStream&& other) : handle(other.handle) { other.handle = nullptr; }
  ~InFileStream()
  {
    if (this->handle)
      fclose(this->handle);
  }

  void open(const char* filename) { this->handle = fopen(filename, "rb"); }
  void open(const String& filename) { this->open(filename.c_str()); }
  bool is_open() const { return this->handle != nullptr; }
  bool isOpen() const { return this->handle != nullptr; }
  void close()
  {
    if (this->handle)
    {
      fclose(this->handle);
      this->handle = nullptr;
    }
  }

  bool good() const { return this->handle != nullptr && feof(this->handle) == 0 && ferror(this->handle) == 0; }
  bool eof() const { return this->handle != nullptr && feof(this->handle) != 0; }
  operator bool() const { return this->good(); }
  bool operator!() const { return !this->good(); }

  int get() { return this->handle ? fgetc(this->handle) : -1; }
  // Skips up to count bytes, through the first delimiter met (std::istream::ignore; the tests'
  // ForkLogic skips an XML declaration with `in.ignore(Limits<StreamSize>::max(), '>')`).
  InFileStream& ignore(long long count = 1, int delimiter = -1)
  {
    for (long long i = 0; i < count && this->handle; ++i)
    {
      int c = fgetc(this->handle);
      if (c == -1 || c == delimiter)
        break;
    }
    return *this;
  }
  InFileStream& read(char* buffer, int count)
  {
    if (this->handle)
      fread(buffer, 1, count, this->handle);
    return *this;
  }
  InFileStream& seekg(long pos)
  {
    if (this->handle)
      fseek(this->handle, pos, 0);
    return *this;
  }
  long tellg()
  {
    return this->handle ? ftell(this->handle) : -1;
  }
};

// The output streams' base (what std::ostream is to code that writes to any stream: UnitTest++'s
// XmlTestReporter writes its report to the stream it is given, the tests' an OutFileStream). A
// stream writes the bytes (writeBytes); `<<` writes text, a char as itself and numbers as
// std::ostream's defaults do (%d, %u, %lld, %llu, %g), and endl a newline.
struct OutStream
{
  virtual ~OutStream() {}
  virtual void writeBytes(const char* data, int count) = 0;
  // count bytes from data, as they are (std::ostream::write; TestBitmapUtil dumps a pointer's bytes).
  OutStream& write(const char* data, int count)
  {
    this->writeBytes(data, count);
    return *this;
  }
};

OutStream& operator<<(OutStream& s, const char* text)
{
  s.writeBytes(text, (int)strlen(text));
  return s;
}
OutStream& operator<<(OutStream& s, const String& text)
{
  s.writeBytes(text.data(), text.size());
  return s;
}
OutStream& operator<<(OutStream& s, char c)
{
  s.writeBytes(&c, 1);
  return s;
}
OutStream& operator<<(OutStream& s, int value)
{
  char text[16];
  s.writeBytes(text, snprintf(text, sizeof(text), "%d", value));
  return s;
}
OutStream& operator<<(OutStream& s, unsigned int value)
{
  char text[16];
  s.writeBytes(text, snprintf(text, sizeof(text), "%u", value));
  return s;
}
OutStream& operator<<(OutStream& s, long long value)
{
  char text[24];
  s.writeBytes(text, snprintf(text, sizeof(text), "%lld", value));
  return s;
}
OutStream& operator<<(OutStream& s, unsigned long long value)
{
  char text[24];
  s.writeBytes(text, snprintf(text, sizeof(text), "%llu", value));
  return s;
}
OutStream& operator<<(OutStream& s, double value)
{
  char text[32];
  s.writeBytes(text, snprintf(text, sizeof(text), "%g", value));
  return s;
}
OutStream& operator<<(OutStream& s, EndlTag)
{
  s.writeBytes("\n", 1);
  return s;
}

struct OutFileStream : OutStream
{
  void* handle = nullptr;

  void writeBytes(const char* data, int count) override { this->write(data, count); }

  OutFileStream() {}
  explicit OutFileStream(const char* filename) { this->open(filename); }
  explicit OutFileStream(const String& filename) { this->open(filename.c_str()); }
  OutFileStream(const OutFileStream&) = delete;
  OutFileStream(OutFileStream&& other) : handle(other.handle) { other.handle = nullptr; }
  ~OutFileStream()
  {
    if (this->handle)
      fclose(this->handle);
  }

  void open(const char* filename) { this->handle = fopen(filename, "wb"); }
  void open(const String& filename) { this->open(filename.c_str()); }
  bool is_open() const { return this->handle != nullptr; }
  bool isOpen() const { return this->handle != nullptr; }
  void close()
  {
    if (this->handle)
    {
      fclose(this->handle);
      this->handle = nullptr;
    }
  }

  bool good() const { return this->handle != nullptr && ferror(this->handle) == 0; }
  operator bool() const { return this->good(); }

  OutFileStream& write(const char* data, int count)
  {
    if (this->handle)
      fwrite(data, 1, count, this->handle);
    return *this;
  }
  void flush()
  {
    if (this->handle)
      fflush(this->handle);
  }
};

// The << operator for streams, so `cerr << "text" << value << endl;` works.
struct StderrStream
{
  void* handle()
  {
    return __acrt_iob_func(2);
  }
};

StderrStream& operator<<(StderrStream& s, const char* text)
{
  fputs(text, s.handle());
  return s;
}
StderrStream& operator<<(StderrStream& s, const String& text)
{
  fputs(text.c_str(), s.handle());
  return s;
}
StderrStream& operator<<(StderrStream& s, int value)
{
  fprintf(s.handle(), "%d", value);
  return s;
}
StderrStream& operator<<(StderrStream& s, long long value)
{
  fprintf(s.handle(), "%lld", value);
  return s;
}
StderrStream& operator<<(StderrStream& s, unsigned int value)
{
  fprintf(s.handle(), "%u", value);
  return s;
}
StderrStream& operator<<(StderrStream& s, double value)
{
  fprintf(s.handle(), "%g", value);
  return s;
}
StderrStream& operator<<(StderrStream& s, char c)
{
  fputc(c, s.handle());
  return s;
}
StderrStream& operator<<(StderrStream& s, const void* ptr)
{
  fprintf(s.handle(), "%p", ptr);
  return s;
}

// endl: writes a newline and flushes.
struct EndlTag {};
const EndlTag endl;

StderrStream& operator<<(StderrStream& s, EndlTag)
{
  fputc('\n', s.handle());
  fflush(s.handle());
  return s;
}

OutFileStream& operator<<(OutFileStream& s, const char* text)
{
  if (s.handle)
    fputs(text, s.handle);
  return s;
}
OutFileStream& operator<<(OutFileStream& s, const String& text)
{
  if (s.handle)
    fputs(text.c_str(), s.handle);
  return s;
}
OutFileStream& operator<<(OutFileStream& s, EndlTag)
{
  if (s.handle)
  {
    fputc('\n', s.handle);
    fflush(s.handle);
  }
  return s;
}

StderrStream cerr;

// getline: reads from an InFileStream until a delimiter.
bool getline(InFileStream& stream, String& line, char delimiter = '\n')
{
  line = String();
  if (!stream.good())
    return false;
  int c;
  bool read = false;
  while ((c = stream.get()) != -1)
  {
    read = true;
    if ((char)c == delimiter)
      break;
    line.append((char)c);
  }
  return read;
}
