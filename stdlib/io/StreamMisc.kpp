// Miscellaneous stream types: IstreambufIterator and StreamSize, rarely used but mapped from
// std::istreambuf_iterator and std::streamsize.

using StreamSize = i64;

// IstreambufIterator<Char> (std::istreambuf_iterator<char>): an input iterator over the characters
// of an InFileStream, one get() at a time. A default-constructed one is the end, which an iterator
// equals once its stream has no more characters (`copy(IstreambufIterator<char>(in), {}, out)`).
// Char is char: the library's streams are of chars.
template<typename Char = char>
class IstreambufIterator
{
public:
  static_assert(isSame<Char, char>, "IstreambufIterator reads the chars of an InFileStream");
  using value_type = Char;
  using difference_type = i64;
  using pointer = const Char*;
  using reference = Char;
  using iterator_category = InputIteratorTag;

  IstreambufIterator() {}

  IstreambufIterator(InFileStream& s) : stream(&s)
  {
    this->current = s.get();
  }

  Char operator*() const { return (Char)this->current; }

  IstreambufIterator& operator++()
  {
    if (this->stream)
      this->current = this->stream->get();
    return *this;
  }

  bool operator==(const IstreambufIterator& other) const
  {
    bool thisEnd = this->current == -1;
    bool otherEnd = other.current == -1;
    return thisEnd == otherEnd;
  }

private:
  InFileStream* stream = nullptr;
  i32 current = -1;
};
