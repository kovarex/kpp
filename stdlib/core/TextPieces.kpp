// kpp standard library: the formatting pieces of design.md 14, small objects whose appendTo writes a
// value in a chosen form. Each is a piece of a text (`out << hex(x)`, `print(...)`), and each is what a
// converted printf specifier becomes:
//   hex(x), hex(x, digits)            %x, %08x        hexUpper(x), hexUpper(x, digits)   %X, %08X
//   octal(x)                          %o
//   fixed(x, decimals)                %.2f            significant(x, digits)            %g, %.4g
//   scientific(x, digits)             %e, %.5e        withSign(piece)                   %+.1f, %+g
//   alignRight(x, width[, fill])      %5d, %8s        alignLeft(x, width[, fill])       %-8s
//   zeroPadded(x, width)              %05d            address(p)                        %p
extern "C" int snprintf(char* buffer, size_t size, const char* format, ...);
extern "C" void* malloc(size_t size);
extern "C" void free(void* pointer);

// The text of any piece: its appendTo, or the number's or the C string's toString.
template<typename T>
void appendPieceText(const T& value, String& out)
{
  if constexpr (requires { value.appendTo(out); })
    value.appendTo(out);
  else
    out.append(toString(value));
}

// An unsigned value in base 16 or 8, zero-padded to `digits`.
struct DigitsText
{
  u64 value;
  i32 digits;
  i32 base;
  bool upper;

  void appendTo(String& out) const
  {
    char buffer[24];
    i32 n = 0;
    u64 rest = this.value;
    do
    {
      i32 digit = i32(rest % (u64)this.base);
      buffer[n] = char(digit < 10 ? '0' + digit : (this.upper ? 'A' : 'a') + digit - 10);
      ++n;
      rest /= (u64)this.base;
    } while (rest != 0);
    for (i32 i = n; i < this.digits; ++i)
      out.append('0');
    while (n > 0)
    {
      --n;
      out.append(buffer[n]);
    }
  }
};

// The bits of a value's own type, as C's %x and %o read it: hex(-1) of an int is ffffffff, of a long
// long ffffffffffffffff.
u64 unsignedBits(i32 value) { return (u32)value; }
u64 unsignedBits(u32 value) { return value; }
u64 unsignedBits(long value) { return (unsigned long)value; }
u64 unsignedBits(unsigned long value) { return value; }
u64 unsignedBits(i64 value) { return (u64)value; }
u64 unsignedBits(u64 value) { return value; }
u64 unsignedBits(i16 value) { return (u16)value; }
u64 unsignedBits(u16 value) { return value; }
u64 unsignedBits(i8 value) { return (u8)value; }
u64 unsignedBits(u8 value) { return value; }

template<typename T>
DigitsText hex(T value, i32 digits = 0) { return DigitsText{unsignedBits(value), digits, 16, false}; }
template<typename T>
DigitsText hexUpper(T value, i32 digits = 0) { return DigitsText{unsignedBits(value), digits, 16, true}; }
template<typename T>
DigitsText octal(T value, i32 digits = 0) { return DigitsText{unsignedBits(value), digits, 8, false}; }

// A floating value through one of C's conversions (f, g, e) at a precision; infinities and NaN as
// toString writes them ("inf", "-inf", "nan").
struct FloatingText
{
  double value;
  i32 precision;
  char conversion;

  void appendTo(String& out) const
  {
    if (this.value != this.value)
    {
      out.append("nan");
      return;
    }
    if (this.value != 0 && this.value * 0.5 == this.value)
    {
      out.append(this.value > 0 ? "inf" : "-inf");
      return;
    }
    const char* format = this.conversion == 'f' ? "%.*f" : this.conversion == 'g' ? "%.*g" : "%.*e";
    char buffer[64];
    i32 n = snprintf(buffer, 64, format, this.precision, this.value);
    if (n < 64)
    {
      out.append(buffer, n);
      return;
    }
    // (1e308 has 309 digits before the point)
    char* large = (char*)malloc(usize(n) + 1);
    snprintf(large, usize(n) + 1, format, this.precision, this.value);
    out.append(large, n);
    free(large);
  }
};

// `decimals` digits after the point, rounded to the nearest and a tie to even, as %.Nf: fixed(2.5, 0)
// is "2".
FloatingText fixed(double value, i32 decimals) { return FloatingText{value, decimals, 'f'}; }
// `digits` significant digits, trailing zeros removed, an exponent below 1e-4 and from 1e(digits), as
// %.Ng: significant(1234567.0, 6) is "1.23457e+06".
FloatingText significant(double value, i32 digits) { return FloatingText{value, digits, 'g'}; }
// One digit, the point, `digits` more and the exponent of at least two digits, as %.Ne:
// scientific(1234.5, 2) is "1.23e+03".
FloatingText scientific(double value, i32 digits) { return FloatingText{value, digits, 'e'}; }

// A piece's text with a '+' before it unless it starts with '-', as C's '+' flag.
template<typename T>
struct SignedText
{
  T value;

  void appendTo(String& out) const
  {
    String text;
    appendPieceText(this.value, text);
    if (text.size() == 0 || text[0] != '-')
      out.append('+');
    out.append(text);
  }
};

template<typename T>
SignedText<T> withSign(T value) { return SignedText<T>{value}; }

// A piece's text aligned in `width` characters: `fill` before it (right) or after it (left); a longer
// text is not cut. A negative width is that many characters aligned left, as printf's `*` width
// taken from an argument (`%*c`).
template<typename T>
struct AlignedText
{
  T value;
  i32 width;
  char fill;
  bool left;

  void appendTo(String& out) const
  {
    String text;
    appendPieceText(this.value, text);
    bool left = this.left || this.width < 0;
    i32 count = (this.width < 0 ? -this.width : this.width) - i32(text.size());
    if (!left)
      for (i32 i = 0; i < count; ++i)
        out.append(this.fill);
    out.append(text);
    if (left)
      for (i32 i = 0; i < count; ++i)
        out.append(this.fill);
  }
};

template<typename T>
AlignedText<T> alignRight(T value, i32 width, char fill = ' ') { return AlignedText<T>{value, width, fill, false}; }
template<typename T>
AlignedText<T> alignLeft(T value, i32 width, char fill = ' ') { return AlignedText<T>{value, width, fill, true}; }

// A piece's text zero-padded to `width` characters after its sign, as C's '0' flag: zeroPadded(-5, 4)
// is "-005". An infinity or a NaN is padded with spaces before it, as the flag does (C17 7.21.6.1).
template<typename T>
struct ZeroPaddedText
{
  T value;
  i32 width;

  void appendTo(String& out) const
  {
    String text;
    appendPieceText(this.value, text);
    i32 count = this.width - i32(text.size());
    usize from = 0;
    bool sign = text.size() > 0 && (text[0] == '-' || text[0] == '+' || text[0] == ' ');
    char first = text.size() > usize(sign) ? text[usize(sign)] : '0';
    if (first == 'i' || first == 'I' || first == 'n' || first == 'N')
    {
      for (i32 i = 0; i < count; ++i)
        out.append(' ');
      out.append(text);
      return;
    }
    if (sign)
    {
      out.append(text[0]);
      from = 1;
    }
    for (i32 i = 0; i < count; ++i)
      out.append('0');
    out.append(text.data() + from, text.size() - from);
  }
};

template<typename T>
ZeroPaddedText<T> zeroPadded(T value, i32 width) { return ZeroPaddedText<T>{value, width}; }

// A pointer as MSVC's %p writes it: 16 uppercase hexadecimal digits, no prefix. The one way to print a
// pointer (design.md 14: a pointer is no piece of a text by itself).
struct AddressText
{
  const void* pointer;

  void appendTo(String& out) const { DigitsText{(u64)this.pointer, 16, 16, true}.appendTo(out); }
};

AddressText address(const void* pointer) { return AddressText{pointer}; }
