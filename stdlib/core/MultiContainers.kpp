// MultiMap and MultiSet: sorted containers that allow duplicate keys.
// Built on a sorted Vector, like Map and Set.

template<typename K, typename V>
struct MultiMap
{
  Vector<Pair<K, V>> entries;

  using iterator = Pair<K, V>*;
  using const_iterator = const Pair<K, V>*;
  using value_type = Pair<K, V>;

  int size() const { return this->entries.size(); }
  bool empty() const { return this->entries.empty(); }
  Pair<K, V>* begin() { return this->entries.begin(); }
  Pair<K, V>* end() { return this->entries.end(); }
  const Pair<K, V>* begin() const { return this->entries.begin(); }
  const Pair<K, V>* end() const { return this->entries.end(); }

  int lowerBoundIndex(const K& key) const
  {
    int low = 0;
    int high = this->entries.size();
    while (low < high)
    {
      int mid = (low + high) / 2;
      if (this->entries.items[mid].first < key)
        low = mid + 1;
      else
        high = mid;
    }
    return low;
  }

  int upperBoundIndex(const K& key) const
  {
    int low = 0;
    int high = this->entries.size();
    while (low < high)
    {
      int mid = (low + high) / 2;
      if (key < this->entries.items[mid].first)
        high = mid;
      else
        low = mid + 1;
    }
    return low;
  }

  Pair<K, V>* lower_bound(const K& key) { return this->entries.begin() + this->lowerBoundIndex(key); }
  Pair<K, V>* upper_bound(const K& key) { return this->entries.begin() + this->upperBoundIndex(key); }

  Pair<K, V>* find(const K& key)
  {
    int i = this->lowerBoundIndex(key);
    if (i < this->entries.size() && !(key < this->entries.items[i].first))
      return this->entries.begin() + i;
    return this->entries.end();
  }

  int count(const K& key) const
  {
    return this->upperBoundIndex(key) - this->lowerBoundIndex(key);
  }

  bool contains(const K& key) const { return this->count(key) > 0; }

  Pair<K, V>* insert(const Pair<K, V>& entry)
  {
    int i = this->upperBoundIndex(entry.first);
    this->entries.insert(i, entry);
    return this->entries.begin() + i;
  }

  Pair<K, V>* insert(const K& key, const V& value)
  {
    return this->insert(Pair<K, V>(key, value));
  }

  int erase(const K& key)
  {
    int lo = this->lowerBoundIndex(key);
    int hi = this->upperBoundIndex(key);
    int removed = hi - lo;
    for (int i = 0; i < removed; ++i)
      this->entries.erase(lo);
    return removed;
  }

  Pair<K, V>* erase(Pair<K, V>* at) { return this->entries.erase(at); }

  void clear() { this->entries.clear(); }
};

template<typename T>
struct MultiSet
{
  Vector<T> values;

  using iterator = T*;
  using const_iterator = const T*;
  using value_type = T;

  int size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T* begin() { return this->values.begin(); }
  T* end() { return this->values.end(); }
  const T* begin() const { return this->values.begin(); }
  const T* end() const { return this->values.end(); }

  int lowerBoundIndex(const T& value) const
  {
    int low = 0;
    int high = this->values.size();
    while (low < high)
    {
      int mid = (low + high) / 2;
      if (this->values.items[mid] < value)
        low = mid + 1;
      else
        high = mid;
    }
    return low;
  }

  int upperBoundIndex(const T& value) const
  {
    int low = 0;
    int high = this->values.size();
    while (low < high)
    {
      int mid = (low + high) / 2;
      if (value < this->values.items[mid])
        high = mid;
      else
        low = mid + 1;
    }
    return low;
  }

  T* lower_bound(const T& value) { return this->values.begin() + this->lowerBoundIndex(value); }
  T* upper_bound(const T& value) { return this->values.begin() + this->upperBoundIndex(value); }

  bool contains(const T& value) const
  {
    int i = this->lowerBoundIndex(value);
    return i < this->values.size() && !(value < this->values.items[i]);
  }

  int count(const T& value) const
  {
    return this->upperBoundIndex(value) - this->lowerBoundIndex(value);
  }

  T* insert(const T& value)
  {
    int i = this->upperBoundIndex(value);
    this->values.insert(i, value);
    return this->values.begin() + i;
  }

  int erase(const T& value)
  {
    int lo = this->lowerBoundIndex(value);
    int hi = this->upperBoundIndex(value);
    int removed = hi - lo;
    for (int i = 0; i < removed; ++i)
      this->values.erase(lo);
    return removed;
  }

  T* erase(T* at) { return this->values.erase(at); }

  void clear() { this->values.clear(); }
};
