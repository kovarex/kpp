// Error types beyond the base set in Utility.kpp (Exception, RuntimeError, LogicError,
// OutOfRange, InvalidArgument are already there).

class BadAlloc : public Exception
{
public:
  BadAlloc() : Exception(String("bad allocation")) {}
};

// What a dynamic_cast to a reference and `typeid(*p)` of a null p throw, as std::bad_cast and
// std::bad_typeid. The compiler calls these two functions.
class BadCast : public Exception
{
public:
  BadCast() : Exception(String("bad dynamic_cast")) {}
};

class BadTypeid : public Exception
{
public:
  BadTypeid() : Exception(String("typeid of a null pointer")) {}
};

[[noreturn]] [[noinline]] void throwBadCast() { throw BadCast(); }
[[noreturn]] [[noinline]] void throwBadTypeid() { throw BadTypeid(); }

class LengthError : public LogicError
{
public:
  LengthError() {}
  LengthError(const String& message) : LogicError(message) {}
};

// An arithmetic result too large for its type (std::overflow_error): Bitset::to_ullong of bits
// that do not fit.
class OverflowError : public RuntimeError
{
public:
  OverflowError() {}
  OverflowError(const String& message) : RuntimeError(message) {}
};

// --- Error codes (std::error_code, std::errc, std::system_error); specified in docs/stdlib/filesystem.md ---

// What an error code's value means (std::error_category): an errno value (generic) or the system's
// error code (system): what GetLastError returns on Windows, errno elsewhere.
struct ErrorCategory
{
  bool system = false;

  bool operator==(const ErrorCategory& other) const = default;
  const char* name() const { return this->system ? "system" : "generic"; }
};

ErrorCategory genericCategory() { return ErrorCategory{false}; }
ErrorCategory systemCategory() { return ErrorCategory{true}; }

// Portable error conditions (std::errc), with the C library's errno values: the same on every target
// but those platform:: gives (the UCRT's, glibc's and FreeBSD's differ).
enum class Errc
{
  operation_not_permitted = 1,
  no_such_file_or_directory = 2,
  no_such_process = 3,
  interrupted = 4,
  io_error = 5,
  resource_unavailable_try_again = platform::errnoAgain,
  illegal_byte_sequence = platform::errnoIllegalSequence,
  permission_denied = 13,
  device_or_resource_busy = 16,
  file_exists = 17,
  cross_device_link = 18,
  no_such_device = 19,
  not_a_directory = 20,
  is_a_directory = 21,
  invalid_argument = 22,
  too_many_files_open = 24,
  file_too_large = 27,
  no_space_on_device = 28,
  read_only_file_system = 30,
  resource_deadlock_would_occur = platform::errnoDeadlock,
  filename_too_long = platform::errnoNameTooLong,
  function_not_supported = platform::errnoNoSys,
  directory_not_empty = platform::errnoNotEmpty,
  not_supported = platform::errnoNotSupported,
  operation_not_supported = platform::errnoOpNotSupported,
  timed_out = platform::errnoTimedOut,
};

// The condition a Windows error means, or 0 for none: MSVC's std::system_category's table for the
// conditions Errc names (every error from 1 to 19999, spec
// library/error_code_windows_errors_mean_what_msvc_maps_them_to), but for 15, 161 and 267, which
// MSVC's maps to no_such_device, none and invalid_argument (docs/stdlib/filesystem.md gives 267).
i32 errcOfWindowsError(i32 error)
{
  switch (error)
  {
    // file and path not found, bad drive, network path and name, invalid name, bad path name
    case 2, 3, 15, 53, 67, 123, 161: return i32(Errc::no_such_file_or_directory);
    // access denied, invalid access, current directory, write protected, sharing violation, cannot
    // make, no access, Winsock's access denied
    case 5, 12, 16, 19, 32, 82, 998, 10013: return i32(Errc::permission_denied);
    case 17: return i32(Errc::cross_device_link);
    case 80, 183: return i32(Errc::file_exists);
    case 145: return i32(Errc::directory_not_empty);
    case 267: return i32(Errc::not_a_directory);
    // invalid handle, invalid parameter, negative seek, invalid reparse tag, Winsock's invalid argument
    case 6, 87, 131, 4393, 10022: return i32(Errc::invalid_argument);
    case 39, 112: return i32(Errc::no_space_on_device);
    // busy drive, busy, open files, device in use
    case 142, 170, 2401, 2404: return i32(Errc::device_or_resource_busy);
    // buffer overflow, filename too long, Winsock's too long
    case 111, 206, 10063: return i32(Errc::filename_too_long);
    case 50: return i32(Errc::not_supported);
    case 4, 10024: return i32(Errc::too_many_files_open);
    // seek, write fault, read fault, open failed, cannot open, read and write the registry
    case 25, 29, 30, 110, 1011, 1012, 1013: return i32(Errc::io_error);
    case 20, 55: return i32(Errc::no_such_device); // bad unit, device gone
    case 21, 1237: return i32(Errc::resource_unavailable_try_again); // not ready, retry
    case 1: return i32(Errc::function_not_supported);
    case 10004: return i32(Errc::interrupted);
    case 10045: return i32(Errc::operation_not_supported);
    case 121, 258, 1460, 10060: return i32(Errc::timed_out);
    default: return 0;
  }
}

// An error value with its category (std::error_code); 0 is no error. Compared with an Errc, a system
// error equals the condition it means (Windows' ERROR_FILE_NOT_FOUND is no_such_file_or_directory;
// elsewhere a system error is an errno value: platform::errcOfSystemError).
class ErrorCode
{
public:
  ErrorCode() {}
  ErrorCode(i32 value, ErrorCategory category) : value_(value), category_(category) {}

  i32 value() const { return this->value_; }
  ErrorCategory category() const { return this->category_; }
  operator bool() const { return this->value_ != 0; }

  void clear()
  {
    this->value_ = 0;
    this->category_ = systemCategory();
  }

  void assign(i32 value, ErrorCategory category)
  {
    this->value_ = value;
    this->category_ = category;
  }

  // The text the system has for the value: platform::systemErrorMessage's for a system error (Windows'
  // FormatMessage), strerror's for errno.
  String message() const
  {
    if (!this->category_.system)
      return String(strerror(this->value_));
    return platform::systemErrorMessage(this->value_);
  }

  bool operator==(const ErrorCode& other) const = default;

  bool operator==(Errc condition) const
  {
    if (this->value_ == 0)
      return false;
    if (!this->category_.system)
      return this->value_ == i32(condition);
    // (errcOfSystemError's 0 is no condition, which equals no Errc, not even the one of value 0)
    i32 meant = platform::errcOfSystemError(this->value_);
    return meant != 0 && meant == i32(condition);
  }

private:
  i32 value_ = 0;
  ErrorCategory category_ = ErrorCategory{true};
};

// An Errc as an error code of the generic category (std::make_error_code).
ErrorCode make_error_code(Errc condition) { return ErrorCode(i32(condition), genericCategory()); }

// An exception for an ErrorCode (std::system_error): what() is the message given, then the code's.
class SystemError : public RuntimeError
{
public:
  ErrorCode code_;

  SystemError() {}
  SystemError(ErrorCode code) : RuntimeError(code.message()), code_(code) {}
  SystemError(ErrorCode code, const String& what) : RuntimeError(what + ": " + code.message()), code_(code) {}
  const ErrorCode& code() const { return this->code_; }
};

// Exception pointers (std::exception_ptr): a shared handle to a copy of an exception, thrown again
// where it is needed (Promise::setException, then Future::get on another thread). Copies of an
// ExceptionPtr refer to the same exception object; an empty one refers to none.
class ExceptionHolderBase
{
public:
  virtual ~ExceptionHolderBase() {}
  virtual void rethrow() const = 0;
};

template<typename E>
class ExceptionHolder : public ExceptionHolderBase
{
public:
  E exception;
  ExceptionHolder(const E& exception) : exception(exception) {}
  void rethrow() const override { throw this->exception; }
};

class ExceptionPtr
{
public:
  ExceptionPtr() {}
  implicit ExceptionPtr(nullptr_t) {}
  operator bool() const { return (bool)this->holder; }
  bool operator==(const ExceptionPtr& other) const = default;

private:
  template<typename E> friend ExceptionPtr makeExceptionPtr(const E& exception);
  friend void rethrowException(const ExceptionPtr& pointer);
  friend ExceptionPtr currentException();

  SharedPtr<ExceptionHolderBase> holder;
};

// An ExceptionPtr to a copy of exception (std::make_exception_ptr); rethrowing it throws an E.
template<typename E>
ExceptionPtr makeExceptionPtr(const E& exception)
{
  ExceptionPtr result;
  result.holder = SharedPtr<ExceptionHolderBase>(new ExceptionHolder<E>(exception));
  return result;
}

// --- std::current_exception (2026-11-06) ---
// The exception a handler has caught is captured as it is, of whatever type: the runtime
// (kpp_current_exception, codegen's exception runtime) hands the object over to these captured
// exceptions, which count its references (the handler's record, each ExceptionPtr to it, each
// rethrow of it in flight) and destroy and free it when the last goes. A captured object is thrown
// again as itself (rethrowException), its record's destructor slot naming kpp_captured_release so
// that the runtime drops that reference at the handler's end instead of destroying the object.
extern "C" void kpp_current_exception(void** into);
extern "C" void kpp_throw(void* object, const void* typeinfo, void (*dtor)(void*));
extern "C" void free(void* p);

struct CapturedException
{
  void* object = nullptr;
  void* typeinfo = nullptr;
  void (*dtor)(void*) = nullptr;
  i64 references = 0;
};

private Mutex capturedLock;
private Vector<CapturedException> capturedExceptions;

// The runtime's: object, caught, passes to the captured ones with two references (the handler's
// record and the capture's), or, captured already (rethrown from an ExceptionPtr), takes one more.
extern "C" void kpp_captured_take(void* object, void* typeinfo, void (*dtor)(void*))
{
  capturedLock.lock();
  for (CapturedException& c : capturedExceptions)
    if (c.object == object)
    {
      ++c.references;
      capturedLock.unlock();
      return;
    }
  capturedExceptions.push_back(CapturedException{object, typeinfo, dtor, 2});
  capturedLock.unlock();
}

// One reference to a captured object goes; the last destroys and frees it.
extern "C" void kpp_captured_release(void* object)
{
  void (*dtor)(void*) = nullptr;
  bool last = false;
  capturedLock.lock();
  for (u64 i = 0; i < capturedExceptions.size(); ++i)
    if (capturedExceptions[i].object == object)
    {
      if (--capturedExceptions[i].references == 0)
      {
        last = true;
        dtor = capturedExceptions[i].dtor;
        capturedExceptions[i] = capturedExceptions.back();
        capturedExceptions.pop_back();
      }
      break;
    }
  capturedLock.unlock();
  if (!last)
    return;
  if (dtor)
    dtor(object);
  free(object);
}

void retainCapturedException(void* object)
{
  capturedLock.lock();
  for (CapturedException& c : capturedExceptions)
    if (c.object == object)
      ++c.references;
  capturedLock.unlock();
}

class CapturedExceptionHolder : public ExceptionHolderBase
{
public:
  void* object;
  void* typeinfo;
  CapturedExceptionHolder(void* object, void* typeinfo) : object(object), typeinfo(typeinfo) {}
  ~CapturedExceptionHolder() override { kpp_captured_release(this->object); }

  void rethrow() const override
  {
    retainCapturedException(this->object); // (the throw's own reference, which its handler's end drops)
    kpp_throw(this->object, this->typeinfo, kpp_captured_release);
  }
};

// The exception the innermost handler running on this thread has caught (std::current_exception),
// shared with it: rethrowException throws that very object again. Empty outside a handler.
ExceptionPtr currentException()
{
  void* parts[3] = {nullptr, nullptr, nullptr};
  kpp_current_exception(parts);
  ExceptionPtr result;
  if (parts[0])
    result.holder = SharedPtr<ExceptionHolderBase>(new CapturedExceptionHolder(parts[0], parts[1]));
  return result;
}

// Throws the exception an ExceptionPtr refers to (std::rethrow_exception); it must not be empty.
[[noreturn]] void rethrowException(const ExceptionPtr& pointer)
{
  release_assert(pointer.holder);
  pointer.holder->rethrow();
}

// The uncaught exception count (C++17): the exceptions thrown on this thread and not yet caught,
// which the exception runtime counts through kpp_uncaught_change, by a C name as it reads
// kpp_terminate_handler (codegen: a throw and a rethrow add one, the start of a handler takes one
// away). Not the UCRT's __uncaught_exceptions, which counts MSVC's own exceptions only: kpp raises
// its own, and a destructor that unwinding ran read 0 (until 2026-11-05).
private thread_local i32 uncaughtExceptionCount = 0;
extern "C" void kpp_uncaught_change(int delta) { uncaughtExceptionCount += delta; }
i32 uncaught_exceptions() { return uncaughtExceptionCount; }

// std::throw_with_nested: throws value. C++ also attaches the exception being handled when it is
// called (a std::nested_exception base); kpp has no nested_exception yet, so nothing is attached
// (stdlib-conformance.md). UnitTest++'s Test::HandleDesync throws a RuntimeError this way.
template<typename T>
[[noreturn]] void throw_with_nested(T&& value)
{
  throw value;
}

// std::set_terminate: installs the terminate handler and returns the one before. It is kpp's own on
// every target, one for the whole program, as the standard's is (the UCRT's set_terminate keeps one
// per thread, and other targets link no C++ runtime). An exception that ends the program calls it
// after kpp's report (stdlib-conformance.md). The tests' Main.cpp installs one that logs the stack
// before it aborts.
using TerminateHandlerFunction = void (*)();
Atomic<TerminateHandlerFunction> installedTerminateHandler;
TerminateHandlerFunction setTerminate(TerminateHandlerFunction handler) { return installedTerminateHandler.exchange(handler); }

// The terminate handler as the exception runtime reads it (codegen's kpp_eh_terminate and
// kpp_eh_unhandled), by a C name: the runtime is written as IR and names no kpp function.
extern "C" TerminateHandlerFunction kpp_terminate_handler() { return installedTerminateHandler.load(); }
