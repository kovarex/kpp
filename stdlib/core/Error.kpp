// Error types beyond the base set in Utility.kpp (Exception, RuntimeError, LogicError,
// OutOfRange, InvalidArgument are already there).

class BadAlloc : public Exception
{
public:
  BadAlloc() : Exception(String("bad allocation")) {}
};

class LengthError : public LogicError
{
public:
  LengthError() {}
  explicit LengthError(const String& message) : LogicError(message) {}
};

// An arithmetic result too large for its type (std::overflow_error): Bitset::to_ullong of bits
// that do not fit.
class OverflowError : public RuntimeError
{
public:
  OverflowError() {}
  explicit OverflowError(const String& message) : RuntimeError(message) {}
};

// --- Error codes (std::error_code, std::errc, std::system_error); specified in docs/stdlib/filesystem.md ---

// What an error code's value means (std::error_category): an errno value (generic) or the system's
// error code (system): what GetLastError returns on Windows, errno elsewhere.
struct ErrorCategory
{
  bool system = false;

  bool operator==(const ErrorCategory& other) const = default;
  bool operator!=(const ErrorCategory& other) const { return this->system != other.system; }
  const char* name() const { return this->system ? "system" : "generic"; }
};

ErrorCategory genericCategory() { return ErrorCategory{false}; }
ErrorCategory systemCategory() { return ErrorCategory{true}; }

// Portable error conditions (std::errc), with the C library's errno values: the same on every target
// but those platform:: gives (the UCRT's, glibc's and FreeBSD's differ).
enum class Errc
{
  operation_not_permitted = 1,
  no_such_file_or_directory = 2,
  no_such_process = 3,
  interrupted = 4,
  io_error = 5,
  resource_unavailable_try_again = platform::errnoAgain,
  permission_denied = 13,
  device_or_resource_busy = 16,
  file_exists = 17,
  cross_device_link = 18,
  no_such_device = 19,
  not_a_directory = 20,
  is_a_directory = 21,
  invalid_argument = 22,
  too_many_files_open = 24,
  file_too_large = 27,
  no_space_on_device = 28,
  read_only_file_system = 30,
  resource_deadlock_would_occur = platform::errnoDeadlock,
  filename_too_long = platform::errnoNameTooLong,
  function_not_supported = platform::errnoNoSys,
  directory_not_empty = platform::errnoNotEmpty,
  not_supported = platform::errnoNotSupported,
  operation_not_supported = platform::errnoOpNotSupported,
  timed_out = platform::errnoTimedOut,
};

// The condition a Windows error means, as std::system_category's equivalence maps it, or 0.
i32 errcOfWindowsError(i32 error)
{
  switch (error)
  {
    case 2: case 3: case 15: case 53: case 67: case 123: case 161: return i32(Errc::no_such_file_or_directory); // file, path not found; bad drive, network path, name
    case 5: case 19: case 32: case 82: return i32(Errc::permission_denied); // access denied, write protected, sharing violation, cannot make
    case 17: return i32(Errc::cross_device_link);
    case 80: case 183: return i32(Errc::file_exists);
    case 145: return i32(Errc::directory_not_empty);
    case 267: return i32(Errc::not_a_directory);
    case 87: return i32(Errc::invalid_argument);
    case 39: case 112: return i32(Errc::no_space_on_device);
    case 170: return i32(Errc::device_or_resource_busy);
    case 206: return i32(Errc::filename_too_long);
    case 50: return i32(Errc::not_supported);
    case 4: return i32(Errc::too_many_files_open);
    case 29: case 30: return i32(Errc::io_error); // write fault, read fault
    default: return 0;
  }
}

// An error value with its category (std::error_code); 0 is no error. Compared with an Errc, a system
// error equals the condition it means (Windows' ERROR_FILE_NOT_FOUND is no_such_file_or_directory;
// elsewhere a system error is an errno value: platform::errcOfSystemError).
class ErrorCode
{
public:
  ErrorCode() {}
  ErrorCode(i32 value, ErrorCategory category) : value_(value), category_(category) {}

  i32 value() const { return this->value_; }
  ErrorCategory category() const { return this->category_; }
  explicit operator bool() const { return this->value_ != 0; }

  void clear()
  {
    this->value_ = 0;
    this->category_ = systemCategory();
  }

  void assign(i32 value, ErrorCategory category)
  {
    this->value_ = value;
    this->category_ = category;
  }

  // The text the system has for the value: platform::systemErrorMessage's for a system error (Windows'
  // FormatMessage), strerror's for errno.
  String message() const
  {
    if (!this->category_.system)
      return String(strerror(this->value_));
    return platform::systemErrorMessage(this->value_);
  }

  bool operator==(const ErrorCode& other) const = default;

  bool operator==(Errc condition) const
  {
    if (this->value_ == 0)
      return false;
    return (this->category_.system ? platform::errcOfSystemError(this->value_) : this->value_) == i32(condition);
  }

private:
  i32 value_ = 0;
  ErrorCategory category_ = ErrorCategory{true};
};

// An Errc as an error code of the generic category (std::make_error_code).
ErrorCode make_error_code(Errc condition) { return ErrorCode(i32(condition), genericCategory()); }

// An exception for an ErrorCode (std::system_error): what() is the message given, then the code's.
class SystemError : public RuntimeError
{
public:
  ErrorCode code_;

  SystemError() {}
  explicit SystemError(ErrorCode code) : RuntimeError(code.message()), code_(code) {}
  SystemError(ErrorCode code, const String& what) : RuntimeError(what + ": " + code.message()), code_(code) {}
  const ErrorCode& code() const { return this->code_; }
};

// Exception pointers (std::exception_ptr): a shared handle to a copy of an exception, thrown again
// where it is needed (Promise::setException, then Future::get on another thread). Copies of an
// ExceptionPtr refer to the same exception object; an empty one refers to none.
class ExceptionHolderBase
{
public:
  virtual ~ExceptionHolderBase() {}
  virtual void rethrow() const = 0;
};

template<typename E>
class ExceptionHolder : public ExceptionHolderBase
{
public:
  E exception;
  explicit ExceptionHolder(const E& exception) : exception(exception) {}
  void rethrow() const override { throw this->exception; }
};

class ExceptionPtr
{
public:
  ExceptionPtr() {}
  implicit ExceptionPtr(nullptr_t) {}
  explicit operator bool() const { return (bool)this->holder; }
  bool operator==(const ExceptionPtr& other) const = default;
  bool operator!=(const ExceptionPtr& other) const { return this->holder != other.holder; }

private:
  template<typename E> friend ExceptionPtr makeExceptionPtr(const E& exception);
  friend void rethrowException(const ExceptionPtr& pointer);

  SharedPtr<ExceptionHolderBase> holder;
};

// An ExceptionPtr to a copy of exception (std::make_exception_ptr); rethrowing it throws an E.
template<typename E>
ExceptionPtr makeExceptionPtr(const E& exception)
{
  ExceptionPtr result;
  result.holder = SharedPtr<ExceptionHolderBase>(new ExceptionHolder<E>(exception));
  return result;
}

// Throws the exception an ExceptionPtr refers to (std::rethrow_exception); it must not be empty.
[[noreturn]] void rethrowException(const ExceptionPtr& pointer)
{
  release_assert(pointer.holder);
  pointer.holder->rethrow();
}

// The uncaught exception count (C++17): the exceptions thrown on this thread and not yet caught,
// which the exception runtime counts through kpp_uncaught_change, by a C name as it reads
// kpp_terminate_handler (codegen: a throw and a rethrow add one, the start of a handler takes one
// away). Not the UCRT's __uncaught_exceptions, which counts MSVC's own exceptions only: kpp raises
// its own, and a destructor that unwinding ran read 0 (until 2026-11-05).
private thread_local i32 uncaughtExceptionCount = 0;
extern "C" void kpp_uncaught_change(int delta) { uncaughtExceptionCount += delta; }
i32 uncaught_exceptions() { return uncaughtExceptionCount; }

// std::throw_with_nested: throws value. C++ also attaches the exception being handled when it is
// called (a std::nested_exception base); kpp has no current_exception yet, so nothing is attached
// (stdlib-conformance.md). UnitTest++'s Test::HandleDesync throws a RuntimeError this way.
template<typename T>
[[noreturn]] void throw_with_nested(T&& value)
{
  throw value;
}

// std::set_terminate: installs the terminate handler and returns the one before. It is kpp's own on
// every target, one for the whole program, as the standard's is (the UCRT's set_terminate keeps one
// per thread, and other targets link no C++ runtime). An exception that ends the program calls it
// after kpp's report (stdlib-conformance.md). The tests' Main.cpp installs one that logs the stack
// before it aborts.
using TerminateHandlerFunction = void (*)();
Atomic<TerminateHandlerFunction> installedTerminateHandler;
TerminateHandlerFunction setTerminate(TerminateHandlerFunction handler) { return installedTerminateHandler.exchange(handler); }

// The terminate handler as the exception runtime reads it (codegen's kpp_eh_terminate and
// kpp_eh_unhandled), by a C name: the runtime is written as IR and names no kpp function.
extern "C" TerminateHandlerFunction kpp_terminate_handler() { return installedTerminateHandler.load(); }
