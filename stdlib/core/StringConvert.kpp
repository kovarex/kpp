// String-to-number conversions: std::stoi, std::stod and the rest, with std's parameters and
// errors. Each calls the C runtime's strto* function; idx, when not null, gets the index of the
// first character not converted. No conversion throws InvalidArgument, a value the type cannot hold
// (the C runtime's ERANGE, and for stoi int's range) OutOfRange, with the C++ runtime's messages.

// The checks after a strto* call (errno cleared before it), std's way: name is the function's.
void checkStringConversion(const String& str, const char* end, const char* name, size_t* idx)
{
  if (end == str.c_str())
    throw InvalidArgument(String("invalid ") + name + " argument");
  if (*platform::errnoLocation() == 34) // ERANGE
    throw OutOfRange(String(name) + " argument out of range");
  if (idx)
    *idx = size_t(end - str.c_str());
}

int stoi(const String& str, size_t* idx = nullptr, int base = 10)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  long value = strtol(str.c_str(), &end, base);
  checkStringConversion(str, end, "stoi", idx);
  // (C's long is int's size on Windows alone: elsewhere strtol holds what int cannot)
  if (value < -2147483647 - 1 || value > 2147483647)
    throw OutOfRange(String("stoi argument out of range"));
  return int(value);
}

long stol(const String& str, size_t* idx = nullptr, int base = 10)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  long value = strtol(str.c_str(), &end, base);
  checkStringConversion(str, end, "stol", idx);
  return value;
}

unsigned long stoul(const String& str, size_t* idx = nullptr, int base = 10)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  unsigned long value = strtoul(str.c_str(), &end, base);
  checkStringConversion(str, end, "stoul", idx);
  return value;
}

long long stoll(const String& str, size_t* idx = nullptr, int base = 10)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  long long value = strtoll(str.c_str(), &end, base);
  checkStringConversion(str, end, "stoll", idx);
  return value;
}

unsigned long long stoull(const String& str, size_t* idx = nullptr, int base = 10)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  unsigned long long value = strtoull(str.c_str(), &end, base);
  checkStringConversion(str, end, "stoull", idx);
  return value;
}

float stof(const String& str, size_t* idx = nullptr)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  float value = strtof(str.c_str(), &end);
  checkStringConversion(str, end, "stof", idx);
  return value;
}

double stod(const String& str, size_t* idx = nullptr)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  double value = strtod(str.c_str(), &end);
  checkStringConversion(str, end, "stod", idx);
  return value;
}

// strtod, not strtold: kpp's long double is a double, and off Windows C's is x87's 80 bits, which
// strtold returns in a register a double is not read from (stold gave whatever was there, 0 for
// "0.125" on FreeBSD and Linux). On Windows the UCRT's strtold is strtod.
long double stold(const String& str, size_t* idx = nullptr)
{
  char* end = nullptr;
  *platform::errnoLocation() = 0;
  long double value = strtod(str.c_str(), &end);
  checkStringConversion(str, end, "stold", idx);
  return value;
}
