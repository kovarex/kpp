// Kpp standard library: HashMap<K, V> and HashSet<T> (what std::unordered_map and
// std::unordered_set convert to), and FastHashMap<K, V> and FastHashSet<T>. Keys are hashed with
// the Hasher argument and compared with the KeyEqual one, by default Hash<K> (the hashOf overloads,
// see Hash.kpp) and EqualTo<K> (operator==). Specified in docs/stdlib/hashmap.md.
//
// One open-addressing table with linear probing serves all four: a byte per slot (empty,
// deleted, or seven bits of the key's hash, so most probes that miss never look at an entry) and
// the slots themselves, kept at most 3/4 full. HashMap and HashSet keep each entry in a node of its
// own and only pointers in the slots, so entries never move: pointers and references stay valid
// when the table grows, as the specification requires. FastHashMap and FastHashSet keep the
// entries in the slots themselves: faster, but every growth relocates them, invalidating
// pointers and references. Erasing never moves other entries in either.

const uint8_t hashSlotEmpty = 0;
const uint8_t hashSlotDeleted = 1;

// The tag byte of a used slot: the high bit, and the top seven bits of the hash (the low ones
// already chose the slot).
uint8_t hashTagOf(size_t hash) { return (uint8_t)(0x80 | (hash >> 57)); }

// A position in a table: a used slot, or the slot count for end(). A stable table's iterator also
// holds its entry's node, and reaches the entry through it after the table grew (the slots it was
// made from are gone then): `auto [it, created] = memo.try_emplace(n); it->second = compute();`
// with compute inserting more, as std::unordered_map's iterators, which are its nodes, allow
// (NoiseProgramBuilder::compileExpression).
// HashIterator<const E, stable> is the const_iterator: the same position, its entry const. An
// iterator converts to it implicitly, and back only explicitly (erase(const_iterator)).
template<typename E, bool stable>
struct HashIterator
{
  using value_type = RemoveConst<E>;
  using difference_type = ptrdiff_t;
  using pointer = E*;
  using reference = E&;
  using iterator_category = ForwardIteratorTag;

  uint8_t* tags = nullptr;
  char* slots = nullptr;
  int index = 0;
  int capacity = 0;
  E* node = nullptr; // stable: the entry at index, or null at end()

  HashIterator() {}
  template<typename F> requires (isSame<F, RemoveConst<E>> && !isSame<F, E>)
  implicit HashIterator(const HashIterator<F, stable>& other)
    : tags(other.tags), slots(other.slots), index(other.index), capacity(other.capacity), node(other.node) {}
  template<typename F> requires (isSame<E, RemoveConst<F>> && !isSame<F, E>)
  explicit HashIterator(const HashIterator<F, stable>& other)
    : tags(other.tags), slots(other.slots), index(other.index), capacity(other.capacity), node((E*)other.node) {}
  // (The node is found here and in skipFree, not in a function of its own: a call more per lookup
  // cost 8-13% in the hash lookup benchmarks, as functions of other modules are not inlined.)
  HashIterator(uint8_t* tags, char* slots, int index, int capacity) : tags(tags), slots(slots), index(index), capacity(capacity)
  {
    if constexpr (stable)
      this->node = index < capacity && tags[index] >= 0x80 ? ((E**)slots)[index] : nullptr;
  }

  E* entry() const
  {
    if constexpr (stable)
      return this->node;
    else
      return (E*)this->slots + this->index;
  }
  E& operator*() const { return *this->entry(); }
  E* operator->() const { return this->entry(); }
  bool operator==(const HashIterator<E, stable>& other) const { return this->index == other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<E>> && !isSame<F, E>)
  bool operator==(const HashIterator<F, stable>& other) const { return this->index == other.index; }
  bool operator!=(const HashIterator<E, stable>& other) const { return this->index != other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<E>> && !isSame<F, E>)
  bool operator!=(const HashIterator<F, stable>& other) const { return this->index != other.index; }
  HashIterator<E, stable>& operator++()
  {
    ++this->index;
    this->skipFree();
    return *this;
  }
  HashIterator<E, stable> operator++(int)
  {
    HashIterator<E, stable> before = *this;
    ++*this;
    return before;
  }
  void skipFree()
  {
    while (this->index < this->capacity && this->tags[this->index] < 0x80)
      ++this->index;
    if constexpr (stable)
      this->node = this->index < this->capacity ? ((E**)this->slots)[this->index] : nullptr;
  }
};

// The table behind the four containers: entries E with keys KeyOf::of(entry) of type K, in nodes
// (stable) or in the slots.
template<typename E, typename K, typename KeyOf, typename Hasher, typename KeyEqual, bool stable>
struct HashTable
{
  uint8_t* tags = nullptr;
  char* slots = nullptr; // capacity slots of E* (stable) or E
  int capacity = 0;      // always a power of two
  int count = 0;         // used slots
  int used = 0;          // used + deleted slots: what the load limit counts
  Hasher hasher;
  KeyEqual equal;

  HashTable() {}
  HashTable(const Hasher& hasher, const KeyEqual& equal) : hasher(hasher), equal(equal) {}
  HashTable(const HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& other) : hasher(other.hasher), equal(other.equal) { this->copyFrom(other); }
  HashTable(HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>&& other) : hasher(other.hasher), equal(other.equal) { this->take(other); }
  ~HashTable() { this->clear(); }
  HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& operator=(const HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& other)
  {
    if (this != &other)
    {
      this->clear();
      this->hasher = other.hasher;
      this->equal = other.equal;
      this->copyFrom(other);
    }
    return *this;
  }
  HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& operator=(HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>&& other)
  {
    if (this != &other)
    {
      this->clear();
      this->hasher = other.hasher;
      this->equal = other.equal;
      this->take(other);
    }
    return *this;
  }

  // The hash of a key: the hasher's result, mixed further unless the hasher is the library's
  // Hash<K> (whose hashOf overloads mix already): slots come from the low bits and tags from the
  // high ones, so every bit has to depend on the whole key, which a hasher written for std (often
  // the identity, or a few shifts and xors) does not promise.
  size_t hashKey(const K& key) const
  {
    if constexpr (isSame<Hasher, Hash<K>>)
      return this->hasher(key);
    else
      return hashBits((uint64_t)this->hasher(key));
  }

  static int slotSize()
  {
    if constexpr (stable)
      return (int)sizeof(E*);
    else
      return (int)sizeof(E);
  }
  E* entryAt(int slot) const
  {
    if constexpr (stable)
      return ((E**)this->slots)[slot];
    else
      return (E*)this->slots + slot;
  }

  HashIterator<E, stable> iteratorAt(int slot) const { return HashIterator<E, stable>(this->tags, this->slots, slot, this->capacity); }
  HashIterator<E, stable> begin() const
  {
    HashIterator<E, stable> first = this->iteratorAt(0);
    first.skipFree();
    return first;
  }
  HashIterator<E, stable> end() const { return this->iteratorAt(this->capacity); }

  // The slot holding key, or -1.
  int findSlot(const K& key, size_t hash) const
  {
    if (this->capacity == 0)
      return -1;
    uint8_t tag = hashTagOf(hash);
    size_t mask = this->capacity - 1;
    size_t i = hash & mask;
    while (true)
    {
      uint8_t t = this->tags[i];
      if (t == hashSlotEmpty)
        return -1;
      if (t == tag && this->equal(this->keyAt((int)i), key))
        return (int)i;
      i = (i + 1) & mask;
    }
  }

  // The slot holding key (found), or the free slot where it goes: the first deleted slot on its
  // probe path, else the empty one that ends it. -1 when taking an empty slot would fill the
  // table over 3/4: then it has to grow first.
  int place(const K& key, size_t hash, bool& found)
  {
    found = false;
    if (this->capacity == 0)
      return -1;
    uint8_t tag = hashTagOf(hash);
    size_t mask = this->capacity - 1;
    size_t i = hash & mask;
    int firstDeleted = -1;
    while (true)
    {
      uint8_t t = this->tags[i];
      if (t == hashSlotEmpty)
        break;
      if (t == hashSlotDeleted)
      {
        if (firstDeleted < 0)
          firstDeleted = (int)i;
      }
      else if (t == tag && this->equal(this->keyAt((int)i), key))
      {
        found = true;
        return (int)i;
      }
      i = (i + 1) & mask;
    }
    if (firstDeleted >= 0)
      return firstDeleted;
    if ((this->used + 1) * 4 > this->capacity * 3)
      return -1;
    return (int)i;
  }

  // Builds the entry for hash in the free slot from the arguments.
  template<typename... Args>
  E* emplaceAt(int slot, size_t hash, Args&&... args)
  {
    E* entry;
    if constexpr (stable)
    {
      entry = (E*)malloc(sizeof(E));
      new (entry) E(forward<Args>(args)...);
      ((E**)this->slots)[slot] = entry;
    }
    else
    {
      entry = (E*)this->slots + slot;
      new (entry) E(forward<Args>(args)...);
    }
    if (this->tags[slot] == hashSlotEmpty)
      ++this->used;
    this->tags[slot] = hashTagOf(hash);
    ++this->count;
    return entry;
  }

  void eraseAt(int slot)
  {
    E* entry = this->entryAt(slot);
    entry->~E();
    if constexpr (stable)
      free(entry);
    // No probe path runs through this slot when the next one is empty, so it can be empty too.
    if (this->tags[(slot + 1) & (this->capacity - 1)] == hashSlotEmpty)
    {
      this->tags[slot] = hashSlotEmpty;
      --this->used;
    }
    else
      this->tags[slot] = hashSlotDeleted;
    --this->count;
  }

  // Moves the entries of other whose keys are not here into this table; the rest stay in other.
  // Nodes move as they are (pointers and references to their entries now refer into this table),
  // entries of fast tables are moved.
  void mergeFrom(HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& other)
  {
    for (int i = 0; i < other.capacity; ++i)
    {
      if (other.tags[i] < 0x80)
        continue;
      const K& key = other.keyAt(i);
      size_t hash = this->hashKey(key);
      bool found;
      int slot = this->place(key, hash, found);
      if (found)
        continue;
      if (slot < 0)
      {
        this->grow();
        slot = this->place(key, hash, found);
      }
      if constexpr (stable)
      {
        if (this->tags[slot] == hashSlotEmpty)
          ++this->used;
        ((E**)this->slots)[slot] = other.entryAt(i);
        this->tags[slot] = hashTagOf(hash);
        ++this->count;
        other.releaseAt(i);
      }
      else
      {
        this->emplaceAt(slot, hash, move(*other.entryAt(i)));
        other.eraseAt(i);
      }
    }
  }
  // Empties slot without destroying its entry (its node now belongs elsewhere).
  void releaseAt(int slot)
  {
    if (this->tags[(slot + 1) & (this->capacity - 1)] == hashSlotEmpty)
    {
      this->tags[slot] = hashSlotEmpty;
      --this->used;
    }
    else
      this->tags[slot] = hashSlotDeleted;
    --this->count;
  }
  void swap(HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& other)
  {
    HashTable<E, K, KeyOf, Hasher, KeyEqual, stable> held(move(other));
    other = move(*this);
    *this = move(held);
  }

  // Twice the size, unless deleted slots made up the load: then the same size, cleared.
  void grow()
  {
    if (this->capacity == 0)
      this->rehash(16);
    else
      this->rehash((this->count + 1) * 2 > this->capacity ? this->capacity * 2 : this->capacity);
  }
  // Room for n entries without growing.
  void reserve(int n)
  {
    int needed = 16;
    while (needed * 3 < n * 4)
      needed *= 2;
    if (needed > this->capacity)
      this->rehash(needed);
  }

  void clear()
  {
    for (int i = 0; i < this->capacity; ++i)
      if (this->tags[i] >= 0x80)
      {
        E* entry = this->entryAt(i);
        entry->~E();
        if constexpr (stable)
          free(entry);
      }
    if (this->tags)
    {
      free(this->tags);
      free(this->slots);
    }
    this->tags = nullptr;
    this->slots = nullptr;
    this->capacity = 0;
    this->count = 0;
    this->used = 0;
  }

  // Internals.
  static const K& keyOf(const E& entry) { return KeyOf::of(entry); }
  const K& keyAt(int slot) const { return KeyOf::of(*this->entryAt(slot)); }

  void allocate(int newCapacity)
  {
    this->tags = (uint8_t*)malloc((size_t)newCapacity);
    memset(this->tags, hashSlotEmpty, (size_t)newCapacity);
    this->slots = (char*)malloc((size_t)newCapacity * HashTable::slotSize());
    this->capacity = newCapacity;
  }
  // Moves the used slots into a new table of newCapacity slots, which drops the deleted ones.
  // Entries in nodes stay where they are; only the pointers move.
  void rehash(int newCapacity)
  {
    uint8_t* oldTags = this->tags;
    char* oldSlots = this->slots;
    int oldCapacity = this->capacity;
    this->allocate(newCapacity);
    this->used = this->count;
    size_t mask = newCapacity - 1;
    for (int i = 0; i < oldCapacity; ++i)
      if (oldTags[i] >= 0x80)
      {
        E* entry;
        if constexpr (stable)
          entry = ((E**)oldSlots)[i];
        else
          entry = (E*)oldSlots + i;
        size_t hash = this->hashKey(HashTable::keyOf(*entry));
        size_t j = hash & mask;
        while (this->tags[j] != hashSlotEmpty)
          j = (j + 1) & mask;
        this->tags[j] = oldTags[i];
        if constexpr (stable)
          ((E**)this->slots)[j] = entry;
        else
          relocate((E*)this->slots + j, entry, 1);
      }
    if (oldTags)
    {
      free(oldTags);
      free(oldSlots);
    }
  }
  // Copies other slot by slot: same capacity, same positions, deleted markers kept (the probe
  // paths of later keys run through them).
  void copyFrom(const HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& other)
  {
    if (other.count == 0)
      return;
    this->allocate(other.capacity);
    memcpy(this->tags, other.tags, (size_t)other.capacity);
    for (int i = 0; i < other.capacity; ++i)
      if (other.tags[i] >= 0x80)
      {
        if constexpr (stable)
        {
          E* entry = (E*)malloc(sizeof(E));
          new (entry) E(*other.entryAt(i));
          ((E**)this->slots)[i] = entry;
        }
        else
          new ((E*)this->slots + i) E(*other.entryAt(i));
      }
    this->count = other.count;
    this->used = other.used;
  }
  void take(HashTable<E, K, KeyOf, Hasher, KeyEqual, stable>& other)
  {
    this->tags = other.tags;
    this->slots = other.slots;
    this->capacity = other.capacity;
    this->count = other.count;
    this->used = other.used;
    other.tags = nullptr;
    other.slots = nullptr;
    other.capacity = 0;
    other.count = 0;
    other.used = 0;
  }
};

template<typename K, typename V>
struct HashMapKey
{
  static const K& of(const Pair<K, V>& entry) { return entry.first; }
};

template<typename T>
struct HashSetKey
{
  static const T& of(const T& entry) { return entry; }
};

// An unordered map with unique keys; entries are Pair<K, V>. `stable` false is FastHashMap.
template<typename K, typename V, typename Hasher = Hash<K>, typename KeyEqual = EqualTo<K>, bool stable = true>
struct HashMap
{
  HashTable<Pair<K, V>, K, HashMapKey<K, V>, Hasher, KeyEqual, stable> table;

  using iterator = HashIterator<Pair<K, V>, stable>;
  using const_iterator = HashIterator<const Pair<K, V>, stable>;
  using value_type = Pair<K, V>;
  using size_type = int;
  using difference_type = ptrdiff_t;
  using reference = Pair<K, V>&;
  using const_reference = const Pair<K, V>&;
  using pointer = Pair<K, V>*;
  using const_pointer = const Pair<K, V>*;
  using key_type = K;
  using mapped_type = V;
  using hasher = Hasher;
  using key_equal = KeyEqual;

  HashMap() {}
  // An empty map with room for n entries before it grows.
  explicit HashMap(int n, const Hasher& hasher = Hasher(), const KeyEqual& equal = KeyEqual()) : table(hasher, equal) { this->table.reserve(n); }
  implicit HashMap(InitializerList<Pair<K, V>> items)
  {
    for (const Pair<K, V>& item : items)
      this->insert(item);
  }
  // `= {...}`: the listed entries, replacing the contents.
  HashMap<K, V, Hasher, KeyEqual, stable>& operator=(InitializerList<Pair<K, V>> items)
  {
    this->clear();
    for (const Pair<K, V>& item : items)
      this->insert(item);
    return *this;
  }
  // The entries of [first, last), as insert(entry) one by one.
  template<typename It>
  HashMap(It first, It last) { this->insert(first, last); }

  int size() const { return this->table.count; }
  bool empty() const { return this->table.count == 0; }
  iterator begin() { return this->table.begin(); }
  const_iterator begin() const { return this->table.begin(); }
  iterator end() { return this->table.end(); }
  const_iterator end() const { return this->table.end(); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }

  iterator find(const K& key)
  {
    int slot = this->table.findSlot(key, this->table.hashKey(key));
    return slot < 0 ? this->table.end() : this->table.iteratorAt(slot);
  }
  const_iterator find(const K& key) const
  {
    int slot = this->table.findSlot(key, this->table.hashKey(key));
    return slot < 0 ? this->table.end() : this->table.iteratorAt(slot);
  }
  bool contains(const K& key) const { return this->table.findSlot(key, this->table.hashKey(key)) >= 0; }
  int count(const K& key) const { return this->contains(key) ? 1 : 0; }

  // The value for key, inserted default-constructed when new.
  V& operator[](const K& key)
  {
    size_t hash = this->table.hashKey(key);
    bool found;
    int slot = this->table.place(key, hash, found);
    if (slot < 0)
    {
      K copy(key); // key may be one of this map's, which growing a fast table moves
      this->table.grow();
      return (*this)[copy];
    }
    if (found)
      return this->table.entryAt(slot)->second;
    return this->table.emplaceAt(slot, hash, inPlaceSecond, key)->second;
  }
  // The value of key's entry; throws OutOfRange when there is none.
  V& at(const K& key)
  {
    HashIterator<Pair<K, V>, stable> at = this->find(key);
    if (at == this->end())
      throwOutOfRange("HashMap::at: key not found");
    return at->second;
  }
  const V& at(const K& key) const
  {
    HashIterator<Pair<K, V>, stable> at = this->find(key);
    if (at == this->end())
      throwOutOfRange("HashMap::at: key not found");
    return at->second;
  }

  // The entry with the key and whether it was inserted (an existing value is kept).
  Pair<HashIterator<Pair<K, V>, stable>, bool> insert(const Pair<K, V>& entry)
  {
    size_t hash = this->table.hashKey(entry.first);
    bool found;
    int slot = this->table.place(entry.first, hash, found);
    if (slot < 0)
    {
      Pair<K, V> copy(entry);
      this->table.grow();
      return this->insert(move(copy));
    }
    if (!found)
      this->table.emplaceAt(slot, hash, entry);
    return Pair<HashIterator<Pair<K, V>, stable>, bool>(this->table.iteratorAt(slot), !found);
  }
  Pair<HashIterator<Pair<K, V>, stable>, bool> insert(Pair<K, V>&& entry)
  {
    size_t hash = this->table.hashKey(entry.first);
    bool found;
    int slot = this->table.place(entry.first, hash, found);
    if (slot < 0)
    {
      this->table.grow();
      return this->insert(move(entry));
    }
    if (!found)
      this->table.emplaceAt(slot, hash, move(entry));
    return Pair<HashIterator<Pair<K, V>, stable>, bool>(this->table.iteratorAt(slot), !found);
  }
  template<typename... Args>
  Pair<HashIterator<Pair<K, V>, stable>, bool> emplace(Args&&... args) { return this->insert(Pair<K, V>(forward<Args>(args)...)); }
  // Builds the value from the arguments, in its entry, only when the key is new.
  template<typename... Args>
  Pair<HashIterator<Pair<K, V>, stable>, bool> try_emplace(const K& key, Args&&... args)
  {
    size_t hash = this->table.hashKey(key);
    bool found;
    int slot = this->table.place(key, hash, found);
    if (slot < 0)
    {
      // Grow, then look for the key's place again (key may be one of a fast table's keys, which
      // growing moves: copied first).
      K copy(key);
      this->table.grow();
      slot = this->table.place(copy, hash, found);
      this->table.emplaceAt(slot, hash, inPlaceSecond, move(copy), forward<Args>(args)...);
      return Pair<HashIterator<Pair<K, V>, stable>, bool>(this->table.iteratorAt(slot), true);
    }
    if (!found)
      this->table.emplaceAt(slot, hash, inPlaceSecond, key, forward<Args>(args)...);
    return Pair<HashIterator<Pair<K, V>, stable>, bool>(this->table.iteratorAt(slot), !found);
  }
  // An rvalue key is moved into the new entry, not copied (only a K rvalue itself, as Map's).
  template<typename KK, typename... Args> requires (isSame<KK, K>)
  Pair<HashIterator<Pair<K, V>, stable>, bool> try_emplace(KK&& key, Args&&... args)
  {
    size_t hash = this->table.hashKey(key);
    bool found;
    int slot = this->table.place(key, hash, found);
    if (slot < 0)
    {
      // Grow, then look for the key's place again (an rvalue key is no key of this table).
      this->table.grow();
      slot = this->table.place(key, hash, found);
    }
    if (!found)
      this->table.emplaceAt(slot, hash, inPlaceSecond, move(key), forward<Args>(args)...);
    return Pair<HashIterator<Pair<K, V>, stable>, bool>(this->table.iteratorAt(slot), !found);
  }
  // With a position hint, which a hash table does not need: the entry's position, new or found.
  template<typename... Args>
  iterator try_emplace(const_iterator hint, const K& key, Args&&... args)
  {
    return this->try_emplace(key, forward<Args>(args)...).first;
  }
  template<typename KK, typename... Args> requires (isSame<KK, K>)
  iterator try_emplace(const_iterator hint, KK&& key, Args&&... args)
  {
    return this->try_emplace(move(key), forward<Args>(args)...).first;
  }
  // Inserts, or assigns value to the existing entry.
  Pair<HashIterator<Pair<K, V>, stable>, bool> insert_or_assign(const K& key, const V& value)
  {
    Pair<HashIterator<Pair<K, V>, stable>, bool> result = this->try_emplace(key, value);
    if (!result.second)
      result.first->second = value;
    return result;
  }
  // Kpp's shorthand: true when the key was new (an existing value is kept).
  bool insert(const K& key, const V& value) { return this->try_emplace(key, value).second; }

  // The number of entries removed (0 or 1).
  int erase(const K& key)
  {
    int slot = this->table.findSlot(key, this->table.hashKey(key));
    if (slot < 0)
      return 0;
    this->table.eraseAt(slot);
    return 1;
  }
  // Removes the entry at position; returns the position of the next one.
  iterator erase(const_iterator position)
  {
    this->table.eraseAt(position.index);
    HashIterator<Pair<K, V>, stable> next(position);
    ++next;
    return next;
  }
  // Inserts as insert(entry) does; the hint is accepted for compatibility and not needed.
  iterator insert(const_iterator hint, const Pair<K, V>& entry) { return this->insert(entry).first; }
  iterator insert(const_iterator hint, Pair<K, V>&& entry) { return this->insert(move(entry)).first; }
  template<typename... Args>
  iterator emplace_hint(const_iterator hint, Args&&... args)
  {
    return this->insert(Pair<K, V>(forward<Args>(args)...)).first;
  }
  // Inserts copies of the entries of [first, last).
  template<typename It>
  void insert(It first, It last)
  {
    for (; first != last; ++first)
      this->insert(*first);
  }
  // Moves the entries of other whose keys are not here into this map; the rest stay in other.
  void merge(HashMap<K, V, Hasher, KeyEqual, stable>& other) { this->table.mergeFrom(other.table); }
  // Equal with the same keys, each with an equal value, in any order (common.md).
  bool operator==(const HashMap<K, V, Hasher, KeyEqual, stable>& other) const
  {
    if (this->size() != other.size())
      return false;
    for (const Pair<K, V>& entry : *this)
    {
      HashIterator<Pair<K, V>, stable> found = other.find(entry.first);
      if (found == other.end() || !(found->second == entry.second))
        return false;
    }
    return true;
  }
  void swap(HashMap<K, V, Hasher, KeyEqual, stable>& other) { this->table.swap(other.table); }
  void clear() { this->table.clear(); }
  void reserve(int n) { this->table.reserve(n); }
  Hasher hash_function() const { return this->table.hasher; }
  KeyEqual key_eq() const { return this->table.equal; }

  // Calls f(key, value) for every entry.
  template<typename F>
  void forEach(F f)
  {
    for (int i = 0; i < this->table.capacity; ++i)
      if (this->table.tags[i] >= 0x80)
      {
        Pair<K, V>* entry = this->table.entryAt(i);
        f(entry->first, entry->second);
      }
  }
};

// An unordered set of unique values. `stable` false is FastHashSet.
template<typename T, typename Hasher = Hash<T>, typename KeyEqual = EqualTo<T>, bool stable = true>
struct HashSet
{
  HashTable<T, T, HashSetKey<T>, Hasher, KeyEqual, stable> table;

  using iterator = HashIterator<const T, stable>; // a set's elements are its keys: const through every position
  using const_iterator = HashIterator<const T, stable>;
  using value_type = T;
  using size_type = int;
  using difference_type = ptrdiff_t;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;
  using key_type = T;
  using hasher = Hasher;
  using key_equal = KeyEqual;

  HashSet() {}
  // An empty set with room for n values before it grows.
  explicit HashSet(int n, const Hasher& hasher = Hasher(), const KeyEqual& equal = KeyEqual()) : table(hasher, equal) { this->table.reserve(n); }
  implicit HashSet(InitializerList<T> items)
  {
    for (const T& value : items)
      this->insert(value);
  }
  // `= {...}`: the listed values, replacing the contents.
  HashSet<T, Hasher, KeyEqual, stable>& operator=(InitializerList<T> items)
  {
    this->clear();
    for (const T& item : items)
      this->insert(item);
    return *this;
  }
  // The values of [first, last), as insert(value) one by one.
  template<typename It>
  HashSet(It first, It last) { this->insert(first, last); }

  int size() const { return this->table.count; }
  bool empty() const { return this->table.count == 0; }
  const_iterator begin() const { return this->table.begin(); }
  const_iterator end() const { return this->table.end(); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }

  const_iterator find(const T& value) const
  {
    int slot = this->table.findSlot(value, this->table.hashKey(value));
    return slot < 0 ? this->table.end() : this->table.iteratorAt(slot);
  }
  bool contains(const T& value) const { return this->table.findSlot(value, this->table.hashKey(value)) >= 0; }
  int count(const T& value) const { return this->contains(value) ? 1 : 0; }

  // The entry with the value and whether it was inserted.
  Pair<iterator, bool> insert(const T& value)
  {
    size_t hash = this->table.hashKey(value);
    bool found;
    int slot = this->table.place(value, hash, found);
    if (slot < 0)
    {
      T copy(value);
      this->table.grow();
      return this->insert(move(copy));
    }
    if (!found)
      this->table.emplaceAt(slot, hash, value);
    return Pair<HashIterator<T, stable>, bool>(this->table.iteratorAt(slot), !found);
  }
  Pair<iterator, bool> insert(T&& value)
  {
    size_t hash = this->table.hashKey(value);
    bool found;
    int slot = this->table.place(value, hash, found);
    if (slot < 0)
    {
      this->table.grow();
      return this->insert(move(value));
    }
    if (!found)
      this->table.emplaceAt(slot, hash, move(value));
    return Pair<HashIterator<T, stable>, bool>(this->table.iteratorAt(slot), !found);
  }
  template<typename... Args>
  Pair<iterator, bool> emplace(Args&&... args) { return this->insert(T(forward<Args>(args)...)); }

  // The number of values removed (0 or 1).
  int erase(const T& value)
  {
    int slot = this->table.findSlot(value, this->table.hashKey(value));
    if (slot < 0)
      return 0;
    this->table.eraseAt(slot);
    return 1;
  }
  iterator erase(const_iterator position)
  {
    this->table.eraseAt(position.index);
    HashIterator<T, stable> next(position);
    ++next;
    return next;
  }
  iterator insert(const_iterator hint, const T& value) { return this->insert(value).first; }
  iterator insert(const_iterator hint, T&& value) { return this->insert(move(value)).first; }
  template<typename... Args>
  iterator emplace_hint(const_iterator hint, Args&&... args) { return this->insert(T(forward<Args>(args)...)).first; }
  template<typename It>
  void insert(It first, It last)
  {
    for (; first != last; ++first)
      this->insert(*first);
  }
  void merge(HashSet<T, Hasher, KeyEqual, stable>& other) { this->table.mergeFrom(other.table); }
  // Equal with the same values, in any order (common.md).
  bool operator==(const HashSet<T, Hasher, KeyEqual, stable>& other) const
  {
    if (this->size() != other.size())
      return false;
    for (const T& value : *this)
      if (!other.contains(value))
        return false;
    return true;
  }
  void swap(HashSet<T, Hasher, KeyEqual, stable>& other) { this->table.swap(other.table); }
  void clear() { this->table.clear(); }
  void reserve(int n) { this->table.reserve(n); }
  Hasher hash_function() const { return this->table.hasher; }
  KeyEqual key_eq() const { return this->table.equal; }
};

// The faster tables, whose entries move when the table grows (docs/stdlib/hashmap.md).
template<typename K, typename V, typename Hasher = Hash<K>, typename KeyEqual = EqualTo<K>>
using FastHashMap = HashMap<K, V, Hasher, KeyEqual, false>;
template<typename T, typename Hasher = Hash<T>, typename KeyEqual = EqualTo<T>>
using FastHashSet = HashSet<T, Hasher, KeyEqual, false>;
