// Kpp standard library: HashMap<K, V>, open addressing with linear probing. Keys need hashOf(key)
// (see Hash.kpp) and operator==.
//
// One flat array of entries, kept at most 3/4 full (deleted entries count until the next rehash).
// A rehash relocates the entries bitwise, which every Kpp type allows: no key or value is copied.
template<typename K, typename V>
struct HashEntry
{
  K key;
  V value;
  int state = 0; // 0 empty, 1 used, 2 deleted
};

template<typename K, typename V>
struct HashMap
{
  HashEntry<K, V>* entries = nullptr;
  int capacity = 0; // always a power of two
  int count = 0;    // used entries
  int used = 0;     // used + deleted entries

  HashMap() {}
  HashMap(const HashMap<K, V>& other) { this->copyFrom(other); }
  HashMap(HashMap<K, V>&& other) : entries(other.entries), capacity(other.capacity), count(other.count), used(other.used)
  {
    other.entries = nullptr;
    other.capacity = 0;
    other.count = 0;
    other.used = 0;
  }
  ~HashMap() { this->destroyEntries(); }

  HashMap<K, V>& operator=(const HashMap<K, V>& other)
  {
    if (this == &other)
      return *this;
    this->destroyEntries();
    this->copyFrom(other);
    return *this;
  }
  HashMap<K, V>& operator=(HashMap<K, V>&& other)
  {
    if (this == &other)
      return *this;
    this->destroyEntries();
    this->entries = other.entries;
    this->capacity = other.capacity;
    this->count = other.count;
    this->used = other.used;
    other.entries = nullptr;
    other.capacity = 0;
    other.count = 0;
    other.used = 0;
    return *this;
  }

  int size() const { return this->count; }
  bool empty() const { return this->count == 0; }
  bool contains(const K& key) const { return this->findSlot(key) >= 0; }

  V* find(const K& key)
  {
    int slot = this->findSlot(key);
    if (slot < 0)
      return nullptr;
    return &this->entries[slot].value;
  }

  // The value for key, inserted default-constructed when new.
  V& operator[](const K& key)
  {
    HashEntry<K, V>* retired;
    int slot = this->slotFor(key, retired); // may move the entries
    HashEntry<K, V>& e = this->entries[slot];
    if (e.state != 1)
    {
      new (&e.key) K(key);
      new (&e.value) V();
      this->markUsed(e);
    }
    if (retired)
      free(retired);
    return e.value;
  }

  void insert(const K& key, const V& value)
  {
    HashEntry<K, V>* retired;
    int slot = this->slotFor(key, retired); // may move the entries
    HashEntry<K, V>& e = this->entries[slot];
    if (e.state == 1)
      e.value = value;
    else
    {
      new (&e.key) K(key);
      new (&e.value) V(value);
      this->markUsed(e);
    }
    if (retired)
      free(retired);
  }

  bool erase(const K& key)
  {
    int slot = this->findSlot(key);
    if (slot < 0)
      return false;
    HashEntry<K, V>& e = this->entries[slot];
    e.key.~K();
    e.value.~V();
    // No probe path runs through this slot when the next one is empty, so it can be empty too.
    if (this->entries[(slot + 1) & (this->capacity - 1)].state == 0)
    {
      e.state = 0;
      --this->used;
    }
    else
      e.state = 2;
    --this->count;
    return true;
  }

  template<typename F>
  void forEach(F f)
  {
    for (int i = 0; i < this->capacity; ++i)
      if (this->entries[i].state == 1)
        f(this->entries[i].key, this->entries[i].value);
  }

  void clear() { this->destroyEntries(); }

  // Internals.
  // The slot holding key, or -1.
  int findSlot(const K& key) const
  {
    if (this->capacity == 0)
      return -1;
    size_t mask = this->capacity - 1;
    size_t i = hashOf(key) & mask;
    while (true)
    {
      const HashEntry<K, V>& e = this->entries[i];
      if (e.state == 0)
        return -1;
      if (e.state == 1 && e.key == key)
        return (int)i;
      i = (i + 1) & mask;
    }
  }

  // The slot holding key, else the first deleted slot on its probe path, else the empty slot that
  // ends the path.
  int probe(const K& key, size_t hash) const
  {
    size_t mask = this->capacity - 1;
    size_t i = hash & mask;
    int firstDeleted = -1;
    while (true)
    {
      const HashEntry<K, V>& e = this->entries[i];
      if (e.state == 0)
        return firstDeleted >= 0 ? firstDeleted : (int)i;
      if (e.state == 1)
      {
        if (e.key == key)
          return (int)i;
      }
      else if (firstDeleted < 0)
        firstDeleted = (int)i;
      i = (i + 1) & mask;
    }
  }

  // The slot holding key, or the free slot where it goes, after growing the table when taking an
  // empty slot would fill it over 3/4. When it grew, retired is the old block: the caller's key
  // and value may point into it, so the caller frees it once they are copied.
  int slotFor(const K& key, HashEntry<K, V>*& retired)
  {
    retired = nullptr;
    if (this->capacity == 0)
      retired = this->rehash(8);
    size_t hash = hashOf(key);
    int slot = this->probe(key, hash);
    if (this->entries[slot].state == 0 && (this->used + 1) * 4 > this->capacity * 3)
    {
      // Twice the size, unless deleted entries made up the load: then the same size, cleared.
      retired = this->rehash((this->count + 1) * 2 > this->capacity ? this->capacity * 2 : this->capacity);
      slot = this->probe(key, hash);
    }
    return slot;
  }

  void markUsed(HashEntry<K, V>& e)
  {
    if (e.state == 0)
      ++this->used;
    e.state = 1;
    ++this->count;
  }

  // Moves the used entries, bitwise, into a new table of newCapacity slots, which drops the
  // deleted ones. Returns the old block for the caller to free.
  HashEntry<K, V>* rehash(int newCapacity)
  {
    HashEntry<K, V>* old = this->entries;
    int oldCapacity = this->capacity;
    this->entries = (HashEntry<K, V>*)malloc((size_t)newCapacity * sizeof(HashEntry<K, V>));
    for (int i = 0; i < newCapacity; ++i)
      this->entries[i].state = 0;
    this->capacity = newCapacity;
    this->used = this->count;
    size_t mask = newCapacity - 1;
    for (int i = 0; i < oldCapacity; ++i)
      if (old[i].state == 1)
      {
        size_t j = hashOf(old[i].key) & mask;
        while (this->entries[j].state != 0)
          j = (j + 1) & mask;
        memcpy(&this->entries[j], &old[i], sizeof(HashEntry<K, V>));
      }
    return old;
  }

  // Copies other slot by slot: same capacity, same positions, deleted markers kept (the probe
  // paths of later keys run through them).
  void copyFrom(const HashMap<K, V>& other)
  {
    if (other.count == 0)
      return;
    this->entries = (HashEntry<K, V>*)malloc((size_t)other.capacity * sizeof(HashEntry<K, V>));
    for (int i = 0; i < other.capacity; ++i)
    {
      const HashEntry<K, V>& source = other.entries[i];
      if (source.state == 1)
      {
        new (&this->entries[i].key) K(source.key);
        new (&this->entries[i].value) V(source.value);
      }
      this->entries[i].state = source.state;
    }
    this->capacity = other.capacity;
    this->count = other.count;
    this->used = other.used;
  }

  void destroyEntries()
  {
    for (int i = 0; i < this->capacity; ++i)
      if (this->entries[i].state == 1)
      {
        this->entries[i].key.~K();
        this->entries[i].value.~V();
      }
    if (this->entries)
      free(this->entries);
    this->entries = nullptr;
    this->capacity = 0;
    this->count = 0;
    this->used = 0;
  }
};
