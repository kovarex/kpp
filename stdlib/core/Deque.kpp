// kpp standard library: Deque<T>, Queue<T> and Stack<T> (what std::deque, std::queue and
// std::stack convert to). Specified in docs/stdlib/deque.md.
//
// A Deque keeps its elements in fixed-size blocks and a map of pointers to them. Element i is at
// position start + i of the map's space, which is block (start + i) / blockSize at that offset.
// Adding at either end constructs in place, allocating a block or regrowing the map when needed:
// existing elements never move, so pointers and references to them stay valid. A block is freed
// as soon as removals at the ends empty it, so a long-running queue holds only the blocks its
// current elements need.
template<typename T>
struct DequeIterator;

template<typename T>
struct Deque
{
  T** map = nullptr;   // mapLength block pointers; null where no block is allocated
  ContainerSize mapLength = 0;
  ContainerSize start = 0;       // the position of element 0 in the map's space
  ContainerSize length = 0;

  using iterator = DequeIterator<T>;
  using const_iterator = DequeIterator<const T>;
  using reverse_iterator = ReverseIterator<iterator>;
  using const_reverse_iterator = ReverseIterator<const_iterator>;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = ptrdiff_t;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  Deque() {}
  implicit Deque(InitializerList<T> items)
  {
    for (const T& item : items)
      this->push_back(item);
  }
  // The elements of [first, last), input iterators of any kind, in order.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  Deque(InputIt first, InputIt last)
  {
    for (; first != last; ++first)
      this->push_back(*first);
  }
  Deque(const Deque<T>& other)
  {
    for (ContainerSize i = 0; i < other.length; ++i)
      this->push_back(other[i]);
  }
  Deque(Deque<T>&& other) : map(other.map), mapLength(other.mapLength), start(other.start), length(other.length)
  {
    other.map = nullptr;
    other.mapLength = 0;
    other.start = 0;
    other.length = 0;
  }
  ~Deque() { this->release(); }
  Deque<T>& operator=(const Deque<T>& other)
  {
    if (this != &other)
    {
      this->clear();
      for (ContainerSize i = 0; i < other.length; ++i)
        this->push_back(other[i]);
    }
    return *this;
  }
  Deque<T>& operator=(Deque<T>&& other) noexcept
  {
    if (this != &other)
    {
      this->release();
      this->map = other.map;
      this->mapLength = other.mapLength;
      this->start = other.start;
      this->length = other.length;
      other.map = nullptr;
      other.mapLength = 0;
      other.start = 0;
      other.length = 0;
    }
    return *this;
  }
  // `d = {a, b, c}`: the listed elements, replacing the contents.
  Deque<T>& operator=(InitializerList<T> items)
  {
    this->clear();
    for (const T& item : items)
      this->push_back(item);
    return *this;
  }
  // Replace the contents: with the elements of [first, last) (ResearchQueue's
  // `queue.assign(other.queue.begin(), other.queue.end())`), count copies of value, or the listed
  // elements. The range must not be this deque's.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  void assign(InputIt first, InputIt last)
  {
    this->clear();
    for (; first != last; ++first)
      this->push_back(*first);
  }
  void assign(ContainerSize count, const T& value)
  {
    this->clear();
    for (ContainerSize i = 0; i < count; ++i)
      this->push_back(value);
  }
  void assign(InitializerList<T> items) { *this = items; }

  // Elements per block: about 512 bytes' worth, a power of two, at least 16.
  static int blockSize()
  {
    int size = 16;
    while ((size_t)size * 2 * sizeof(T) <= 512)
      size *= 2;
    return size;
  }
  static int blockShift()
  {
    int shift = 0;
    while ((1 << shift) < Deque::blockSize())
      ++shift;
    return shift;
  }
  T* slotAt(ContainerSize position) const { return this->map[position >> Deque::blockShift()] + (position & (Deque::blockSize() - 1)); }

  ContainerSize size() const { return this->length; }
  bool empty() const { return this->length == 0; }
  // A const Deque's elements are const through every access, as std::deque's.
  T& operator[](ContainerSize index) { return *this->slotAt(this->start + index); }
  const T& operator[](ContainerSize index) const { return *this->slotAt(this->start + index); }
  // Throws OutOfRange for an index outside [0, size()).
  T& at(ContainerSize index)
  {
    if (index >= this->length)
      throwOutOfRange("Deque::at: index out of range");
    return (*this)[index];
  }
  const T& at(ContainerSize index) const
  {
    if (index >= this->length)
      throwOutOfRange("Deque::at: index out of range");
    return (*this)[index];
  }
  T& front() { return *this->slotAt(this->start); }
  T& back() { return *this->slotAt(this->start + this->length - 1); }
  const T& front() const { return *this->slotAt(this->start); }
  const T& back() const { return *this->slotAt(this->start + this->length - 1); }
  iterator begin() { return iterator(this, 0); }
  iterator end() { return iterator(this, this->length); }
  const_iterator begin() const { return const_iterator((Deque<T>*)this, 0); }
  const_iterator end() const { return const_iterator((Deque<T>*)this, this->length); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }
  const_reverse_iterator crbegin() const { return this->rbegin(); }
  const_reverse_iterator crend() const { return this->rend(); }
  reverse_iterator rbegin() { return reverse_iterator(this->end()); }
  reverse_iterator rend() { return reverse_iterator(this->begin()); }
  const_reverse_iterator rbegin() const { return const_reverse_iterator(this->end()); }
  const_reverse_iterator rend() const { return const_reverse_iterator(this->begin()); }
  // Equal with the same elements in the same order, ordered lexicographically (common.md).
  bool operator==(const Deque<T>& other) const { return this->length == other.length && equal(this->begin(), this->end(), other.begin()); }
  strong_ordering operator<=>(const Deque<T>& other) const { return lexicographicalCompareThreeWay(this->begin(), this->end(), other.begin(), other.end()); }
  void swap(Deque<T>& other)
  {
    Deque<T> held(move(other));
    other = move(*this);
    *this = move(held);
  }

  void push_back(const T& value) { this->emplace_back(value); }
  void push_back(T&& value) { this->emplace_back(move(value)); }
  template<typename... Args>
  T& emplace_back(Args&&... args)
  {
    T* slot = this->slotForBack();
    new (slot) T(forward<Args>(args)...);
    ++this->length;
    return *slot;
  }
  void push_front(const T& value) { this->emplace_front(value); }
  void push_front(T&& value) { this->emplace_front(move(value)); }
  template<typename... Args>
  T& emplace_front(Args&&... args)
  {
    T* slot = this->slotForFront();
    new (slot) T(forward<Args>(args)...);
    --this->start;
    ++this->length;
    return *slot;
  }
  void pop_back()
  {
    --this->length;
    ContainerSize position = this->start + this->length;
    this->slotAt(position)->~T();
    if ((position & (Deque::blockSize() - 1)) == 0)
      this->freeBlock(position >> Deque::blockShift()); // that was its block's first slot
  }
  void pop_front()
  {
    ContainerSize position = this->start;
    this->slotAt(position)->~T();
    ++this->start;
    --this->length;
    if ((this->start & (Deque::blockSize() - 1)) == 0)
      this->freeBlock(position >> Deque::blockShift()); // that was its block's last slot
  }

  // Inserts before index, moving the elements on the shorter side by one (with move assignment);
  // returns the position of the new element.
  DequeIterator<T> insert(ContainerSize index, const T& value)
  {
    T copy(value); // value may be an element, which the shifting changes
    return this->insert(index, move(copy));
  }
  DequeIterator<T> insert(ContainerSize index, T&& value)
  {
    if (index == 0)
      this->emplace_front(move(value));
    else if (index < this->length / 2)
    {
      this->emplace_front(move((*this)[0]));
      for (ContainerSize i = 1; i < index; ++i)
        (*this)[i] = move((*this)[i + 1]);
      (*this)[index] = move(value);
    }
    else
    {
      if (index == this->length)
      {
        this->emplace_back(move(value));
        return DequeIterator<T>(this, index);
      }
      this->emplace_back(move((*this)[this->length - 1]));
      for (ContainerSize i = this->length - 2; i > index; --i)
        (*this)[i] = move((*this)[i - 1]);
      (*this)[index] = move(value);
    }
    return DequeIterator<T>(this, index);
  }
  DequeIterator<T> insert(const_iterator position, const T& value) { return this->insert(position.index, value); }
  DequeIterator<T> insert(const_iterator position, T&& value) { return this->insert(position.index, move(value)); }
  // An element made from args, inserted before position as insert does (std::deque::emplace).
  template<typename... Args>
  DequeIterator<T> emplace(const_iterator position, Args&&... args) { return this->insert(position.index, T(forward<Args>(args)...)); }
  // Removes the element at index, moving the shorter side by one; returns the position of the
  // element after it.
  DequeIterator<T> erase(ContainerSize index)
  {
    if (index < this->length / 2)
    {
      for (ContainerSize i = index; i > 0; --i)
        (*this)[i] = move((*this)[i - 1]);
      this->pop_front();
    }
    else
    {
      for (ContainerSize i = index; i + 1 < this->length; ++i)
        (*this)[i] = move((*this)[i + 1]);
      this->pop_back();
    }
    return DequeIterator<T>(this, index);
  }
  DequeIterator<T> erase(const_iterator position) { return this->erase(position.index); }
  // Removes the elements in [first, last), moving the shorter side of the rest by their count;
  // returns the position of the element after them.
  DequeIterator<T> erase(const_iterator first, const_iterator last)
  {
    ContainerSize from = first.index;
    if (last.index <= from) // (before the subtraction, which would wrap)
      return DequeIterator<T>(this, from);
    ContainerSize count = last.index - from;
    if (from < this->length - (from + count))
    {
      for (ContainerSize i = from; i-- > 0;) // from - 1 down to 0
        (*this)[i + count] = move((*this)[i]);
      for (ContainerSize k = 0; k < count; ++k)
        this->pop_front();
    }
    else
    {
      for (ContainerSize i = from + count; i < this->length; ++i)
        (*this)[i - count] = move((*this)[i]);
      for (ContainerSize k = 0; k < count; ++k)
        this->pop_back();
    }
    return DequeIterator<T>(this, from);
  }

  void resize(ContainerSize newLength)
  {
    while (this->length > newLength)
      this->pop_back();
    while (this->length < newLength)
      this->emplace_back();
  }
  void clear()
  {
    while (this->length > 0)
      this->pop_back();
  }

  // Internals.
  // The slot for a new last element; its block is allocated, the map regrown when needed.
  T* slotForBack()
  {
    ContainerSize block = (this->start + this->length) >> Deque::blockShift();
    if (block >= this->mapLength)
      this->remap(this->start >> Deque::blockShift(), block);
    ContainerSize position = this->start + this->length;
    this->ensureBlock(position >> Deque::blockShift());
    return this->slotAt(position);
  }
  T* slotForFront()
  {
    if (this->start == 0)
    {
      long long last = this->length > 0 ? (this->start + this->length - 1) >> Deque::blockShift() : 0;
      this->remap(-1, last);
    }
    this->ensureBlock((this->start - 1) >> Deque::blockShift());
    return this->slotAt(this->start - 1);
  }
  void ensureBlock(ContainerSize block)
  {
    if (!this->map[block])
      this->map[block] = allocateArray<T>(Deque::blockSize());
  }
  void freeBlock(ContainerSize block)
  {
    free(this->map[block]);
    this->map[block] = nullptr;
  }
  // Makes the map cover blocks [first, last] of the current numbering (first may be -1 for a
  // block before the current start) in its middle, with room on both sides, twice as long when
  // they would fill more than half of it. Block pointers move; blocks and elements do not.
  // The positions in the map's space (block * blockSize() + index) are sizes, so it has at most
  // maxContainerSize / blockSize() blocks: past them LengthError (core/Sizes.kpp).
  void remap(long long first, long long last)
  {
    long long most = (long long)(maxContainerSize / Deque::blockSize());
    long long neededBlocks = last - first + 1;
    if (neededBlocks > most)
      throwLengthError("deque too long");
    ContainerSize needed = (ContainerSize)neededBlocks;
    long long doubled = this->mapLength < 8 ? 8 : (long long)this->mapLength;
    while (doubled < neededBlocks * 2)
      doubled *= 2;
    ContainerSize newLength = doubled > most ? (ContainerSize)most : (ContainerSize)doubled;
    T** newMap = allocateArray<T*>(newLength);
    for (ContainerSize i = 0; i < newLength; ++i)
      newMap[i] = nullptr;
    ContainerSize offset = (newLength - needed) / 2; // where block `first` goes
    for (ContainerSize i = 0; i < this->mapLength; ++i)
      if (this->map[i])
      {
        if ((long long)i >= first && (long long)i <= last)
          newMap[(long long)i - first + offset] = this->map[i];
        else
          free(this->map[i]); // unused: no element lives there
      }
    if (this->map)
      free(this->map);
    this->map = newMap;
    this->mapLength = newLength;
    this->start = ContainerSize((long long)this->start + ((long long)offset - first) * Deque::blockSize());
  }
  void release()
  {
    this->clear();
    for (ContainerSize i = 0; i < this->mapLength; ++i)
      if (this->map[i])
        free(this->map[i]);
    if (this->map)
      free(this->map);
    this->map = nullptr;
    this->mapLength = 0;
    this->start = 0;
  }
};

// A position in a Deque: its element index. Random access.
// DequeIterator<const T> is the const_iterator: the same position, its element const. An iterator
// converts to it implicitly, and back only explicitly (erase(const_iterator)).
template<typename T>
struct DequeIterator
{
  using value_type = RemoveConst<T>;
  using difference_type = ptrdiff_t;
  using pointer = T*;
  using reference = T&;
  using iterator_category = RandomAccessIteratorTag;

  Deque<RemoveConst<T>>* deque = nullptr;
  ContainerSize index = 0;

  DequeIterator() {}
  DequeIterator(Deque<RemoveConst<T>>* deque, ContainerSize index) : deque(deque), index(index) {}
  template<typename F> requires (isSame<F, RemoveConst<T>> && !isSame<F, T>)
  implicit DequeIterator(const DequeIterator<F>& other) : deque(other.deque), index(other.index) {}
  template<typename F> requires (isSame<T, RemoveConst<F>> && !isSame<F, T>)
  explicit DequeIterator(const DequeIterator<F>& other) : deque(other.deque), index(other.index) {}

  T& operator*() const { return (*this->deque)[this->index]; }
  T* operator->() const { return &(*this->deque)[this->index]; }
  T& operator[](ptrdiff_t offset) const { return (*this->deque)[ContainerSize(this->index + offset)]; }
  bool operator==(const DequeIterator<T>& other) const { return this->index == other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator==(const DequeIterator<F>& other) const { return this->index == other.index; }
  bool operator!=(const DequeIterator<T>& other) const { return this->index != other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator!=(const DequeIterator<F>& other) const { return this->index != other.index; }
  bool operator<(const DequeIterator<T>& other) const { return this->index < other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator<(const DequeIterator<F>& other) const { return this->index < other.index; }
  bool operator>(const DequeIterator<T>& other) const { return this->index > other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator>(const DequeIterator<F>& other) const { return this->index > other.index; }
  bool operator<=(const DequeIterator<T>& other) const { return this->index <= other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator<=(const DequeIterator<F>& other) const { return this->index <= other.index; }
  bool operator>=(const DequeIterator<T>& other) const { return this->index >= other.index; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator>=(const DequeIterator<F>& other) const { return this->index >= other.index; }
  DequeIterator<T>& operator++()
  {
    ++this->index;
    return *this;
  }
  DequeIterator<T> operator++(int)
  {
    DequeIterator<T> before = *this;
    ++this->index;
    return before;
  }
  DequeIterator<T>& operator--()
  {
    --this->index;
    return *this;
  }
  DequeIterator<T> operator--(int)
  {
    DequeIterator<T> before = *this;
    --this->index;
    return before;
  }
  DequeIterator<T> operator+(ptrdiff_t offset) const { return DequeIterator<T>(this->deque, ContainerSize(this->index + offset)); }
  DequeIterator<T> operator-(ptrdiff_t offset) const { return DequeIterator<T>(this->deque, ContainerSize(this->index - offset)); }
  ptrdiff_t operator-(const DequeIterator<T>& other) const { return ptrdiff_t(this->index) - ptrdiff_t(other.index); }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  ptrdiff_t operator-(const DequeIterator<F>& other) const { return ptrdiff_t(this->index) - ptrdiff_t(other.index); }
  DequeIterator<T>& operator+=(ptrdiff_t offset)
  {
    this->index += offset;
    return *this;
  }
  DequeIterator<T>& operator-=(ptrdiff_t offset)
  {
    this->index -= offset;
    return *this;
  }
};

// First in, first out: push at the back, pop at the front.
template<typename T, typename Container = Deque<T>>
struct Queue
{
  Container values;

  using container_type = Container;
  using value_type = T;
  using size_type = ContainerSize;
  using reference = T&;
  using const_reference = const T&;

  ContainerSize size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T& front() { return this->values.front(); }
  T& back() { return this->values.back(); }
  const T& front() const { return this->values.front(); }
  const T& back() const { return this->values.back(); }
  void push(const T& value) { this->values.push_back(value); }
  void push(T&& value) { this->values.push_back(move(value)); }
  template<typename... Args>
  T& emplace(Args&&... args) { return this->values.emplace_back(forward<Args>(args)...); }
  void pop() { this->values.pop_front(); }
  void clear() { this->values.clear(); }
};

// Last in, first out: push and pop at the top.
template<typename T, typename Container = Deque<T>>
struct Stack
{
  Container values;

  using container_type = Container;
  using value_type = T;
  using size_type = ContainerSize;
  using reference = T&;
  using const_reference = const T&;

  ContainerSize size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T& top() { return this->values.back(); }
  const T& top() const { return this->values.back(); }
  void push(const T& value) { this->values.push_back(value); }
  void push(T&& value) { this->values.push_back(move(value)); }
  template<typename... Args>
  T& emplace(Args&&... args) { return this->values.emplace_back(forward<Args>(args)...); }
  void pop() { this->values.pop_back(); }
  void clear() { this->values.clear(); }
};
