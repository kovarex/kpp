// kpp standard library: Deque<T>, Queue<T> and Stack<T> (what std::deque, std::queue and
// std::stack convert to). Specified in docs/stdlib/deque.md.
//
// A Deque keeps its elements in fixed-size blocks and a map of pointers to them. Element i is at
// position start + i of the map's space, which is block (start + i) / blockSize at that offset.
// Adding at either end constructs in place, allocating a block or regrowing the map when needed:
// existing elements never move, so pointers and references to them stay valid. A block is freed
// as soon as removals at the ends empty it, so a long-running queue holds only the blocks its
// current elements need.
template<typename T>
struct DequeIterator;

template<typename T>
class Deque
{
public:
  using iterator = DequeIterator<T>;
  using const_iterator = DequeIterator<const T>;
  using reverse_iterator = ReverseIterator<iterator>;
  using const_reverse_iterator = ReverseIterator<const_iterator>;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  Deque() {}

  implicit Deque(InitializerList<T> items)
  {
    for (const T& item : items)
      this->push_back(item);
  }

  // count value-initialized elements, or count copies of value.
  explicit Deque(ContainerSize count) { this->resize(count); }
  Deque(ContainerSize count, const T& value) { this->resize(count, value); }

  // The elements of [first, last), input iterators of any kind, in order.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  Deque(InputIt first, InputIt last)
  {
    for (; first != last; ++first)
      this->push_back(*first);
  }

  Deque(const Deque<T>& other)
  {
    for (ContainerSize i = 0; i < other.length; ++i)
      this->push_back(other[i]);
  }

  Deque(Deque<T>&& other) : map(other.map), mapLength(other.mapLength), start(other.start), length(other.length)
  {
    other.map = nullptr;
    other.mapLength = 0;
    other.start = 0;
    other.length = 0;
  }

  ~Deque() { this->release(); }

  Deque<T>& operator=(const Deque<T>& other)
  {
    if (this != &other)
      this->assign(other.begin(), other.end());
    return *this;
  }

  Deque<T>& operator=(Deque<T>&& other) noexcept
  {
    if (this != &other)
    {
      this->release();
      this->map = other.map;
      this->mapLength = other.mapLength;
      this->start = other.start;
      this->length = other.length;
      other.map = nullptr;
      other.mapLength = 0;
      other.start = 0;
      other.length = 0;
    }
    return *this;
  }

  // `d = {a, b, c}`: the listed elements, replacing the contents.
  Deque<T>& operator=(InitializerList<T> items)
  {
    this->assign(items.begin(), items.end());
    return *this;
  }

  // Replace the contents: with the elements of [first, last) (ResearchQueue's
  // `queue.assign(other.queue.begin(), other.queue.end())`), count copies of value, or the listed
  // elements: assigned over the elements there are, as std's, the others added or removed at the
  // back. The range must not be this deque's.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  void assign(InputIt first, InputIt last)
  {
    ContainerSize index = 0;
    if constexpr (requires { (*this)[0] = *first; })
      for (; index < this->length && first != last; ++index, ++first)
        (*this)[index] = *first;
    this->truncate(index);
    for (; first != last; ++first)
      this->push_back(*first);
  }

  void assign(ContainerSize count, const T& value)
  {
    ContainerSize common = count < this->length ? count : this->length;
    for (ContainerSize i = 0; i < common; ++i)
      (*this)[i] = value;
    this->truncate(common);
    for (ContainerSize i = common; i < count; ++i)
      this->push_back(value);
  }

  void assign(InitializerList<T> items) { *this = items; }

  // Elements per block: about 512 bytes' worth, a power of two, at least 16.
  static i32 blockSize()
  {
    i32 size = 16;
    while ((usize)size * 2 * sizeof(T) <= 512)
      size *= 2;
    return size;
  }

  static i32 blockShift()
  {
    i32 shift = 0;
    while ((1 << shift) < Deque::blockSize())
      ++shift;
    return shift;
  }

  // The slot at a position in the map's space.
  static T* slotIn(T** map, ContainerSize position) { return map[position >> Deque::blockShift()] + (position & (Deque::blockSize() - 1)); }
  T* slotAt(ContainerSize position) const { return Deque::slotIn(this->map, position); }

  ContainerSize size() const { return this->length; }
  bool empty() const { return this->length == 0; }
  // A const Deque's elements are const through every access, as std::deque's.
  T& operator[](ContainerSize index) { return *this->slotAt(this->start + index); }
  const T& operator[](ContainerSize index) const { return *this->slotAt(this->start + index); }

  // Throws OutOfRange for an index outside [0, size()).
  T& at(ContainerSize index)
  {
    if (index >= this->length)
      throwOutOfRange("Deque::at: index out of range");
    return (*this)[index];
  }

  const T& at(ContainerSize index) const
  {
    if (index >= this->length)
      throwOutOfRange("Deque::at: index out of range");
    return (*this)[index];
  }

  T& front() { return *this->slotAt(this->start); }
  T& back() { return *this->slotAt(this->start + this->length - 1); }
  const T& front() const { return *this->slotAt(this->start); }
  const T& back() const { return *this->slotAt(this->start + this->length - 1); }
  iterator begin() { return this->iteratorAt(0); }
  iterator end() { return this->iteratorAt(this->length); }
  const_iterator begin() const { return const_iterator(this->map, this->start); }
  const_iterator end() const { return const_iterator(this->map, this->start + this->length); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }
  const_reverse_iterator crbegin() const { return this->rbegin(); }
  const_reverse_iterator crend() const { return this->rend(); }
  reverse_iterator rbegin() { return reverse_iterator(this->end()); }
  reverse_iterator rend() { return reverse_iterator(this->begin()); }
  const_reverse_iterator rbegin() const { return const_reverse_iterator(this->end()); }
  const_reverse_iterator rend() const { return const_reverse_iterator(this->begin()); }
  // Equal with the same elements in the same order, ordered lexicographically (common.md).
  bool operator==(const Deque<T>& other) const { return this->length == other.length && equal(this->begin(), this->end(), other.begin()); }
  strong_ordering operator<=>(const Deque<T>& other) const { return lexicographicalCompareThreeWay(this->begin(), this->end(), other.begin(), other.end()); }

  void swap(Deque<T>& other)
  {
    Deque<T> held(move(other));
    other = move(*this);
    *this = move(held);
  }

  void push_back(const T& value) { this->emplace_back(value); }
  void push_back(T&& value) { this->emplace_back(move(value)); }

  template<typename... Args>
  T& emplace_back(Args&&... args)
  {
    T* slot = this->slotForBack();
    new (slot) T(forward<Args>(args)...);
    ++this->length;
    return *slot;
  }

  void push_front(const T& value) { this->emplace_front(value); }
  void push_front(T&& value) { this->emplace_front(move(value)); }

  template<typename... Args>
  T& emplace_front(Args&&... args)
  {
    T* slot = this->slotForFront();
    new (slot) T(forward<Args>(args)...);
    --this->start;
    ++this->length;
    return *slot;
  }

  void pop_back()
  {
    --this->length;
    ContainerSize position = this->start + this->length;
    this->slotAt(position)->~T();
    if ((position & (Deque::blockSize() - 1)) == 0)
      this->freeBlock(position >> Deque::blockShift()); // that was its block's first slot
  }

  void pop_front()
  {
    ContainerSize position = this->start;
    this->slotAt(position)->~T();
    ++this->start;
    --this->length;
    if ((this->start & (Deque::blockSize() - 1)) == 0)
      this->freeBlock(position >> Deque::blockShift()); // that was its block's last slot
  }

  // Inserts before index, moving the elements on the shorter side by one (with move assignment);
  // returns the position of the new element.
  DequeIterator<T> insert(ContainerSize index, const T& value)
  {
    // At the ends nothing moves, so value may be an element; in the middle it is copied out first.
    if (index == 0)
      this->emplace_front(value);
    else if (index == this->length)
      this->emplace_back(value);
    else
      this->insertBetween(index, T(value));
    return this->iteratorAt(index);
  }

  DequeIterator<T> insert(ContainerSize index, T&& value)
  {
    if (index == 0)
      this->emplace_front(move(value));
    else if (index == this->length)
      this->emplace_back(move(value));
    else
    {
      T held(move(value)); // it may be an element, as std's take it
      this->insertBetween(index, move(held));
    }
    return this->iteratorAt(index);
  }

  // count copies of value before index, the shorter side moved by count; returns the position of
  // the first one.
  DequeIterator<T> insert(ContainerSize index, ContainerSize count, const T& value)
  {
    if (index == 0 || index == this->length)
    {
      // Nothing moves, so value may be an element.
      this->openSlots(index, count);
      for (ContainerSize i = index; i < index + count; ++i)
        new (this->slotAt(this->start + i)) T(value);
      return this->iteratorAt(index);
    }
    T copy(value); // value may be an element
    Pair<ContainerSize, ContainerSize> moved = this->openSlots(index, count);
    for (ContainerSize i = index; i < index + count; ++i)
      if (i >= moved.first && i < moved.second)
        (*this)[i] = copy;
      else
        new (this->slotAt(this->start + i)) T(copy);
    return this->iteratorAt(index);
  }

  DequeIterator<T> insert(const_iterator position, ContainerSize count, const T& value) { return this->insert(this->indexOf(position), count, value); }

  // The elements of [first, last), input iterators of any kind that do not point into this deque,
  // before position, in order; returns the position of the first one, or position for an empty
  // range.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  DequeIterator<T> insert(const_iterator position, InputIt first, InputIt last)
  {
    ContainerSize index = this->indexOf(position);
    if constexpr (isBaseOf<ForwardIteratorTag, typename IteratorTraits<InputIt>::iterator_category>)
    {
      ContainerSize count = checkedSize(distance(first, last), "deque too long");
      Pair<ContainerSize, ContainerSize> moved = this->openSlots(index, count);
      for (ContainerSize i = index; i < index + count; ++i, ++first)
      {
        if (i < moved.first || i >= moved.second)
          new (this->slotAt(this->start + i)) T(*first);
        else if constexpr (requires { (*this)[0] = *first; })
          (*this)[i] = *first;
        else
          (*this)[i] = T(*first); // a conversion that is only explicit
      }
    }
    else
    {
      for (ContainerSize at = index; first != last; ++first)
        this->insert(at++, T(*first));
    }
    return this->iteratorAt(index);
  }

  // The listed elements before position, in order; returns the position of the first one, or
  // position for an empty list.
  DequeIterator<T> insert(const_iterator position, InitializerList<T> items) { return this->insert(position, items.begin(), items.end()); }

  DequeIterator<T> insert(const_iterator position, const T& value) { return this->insert(this->indexOf(position), value); }
  DequeIterator<T> insert(const_iterator position, T&& value) { return this->insert(this->indexOf(position), move(value)); }

  // An element made from args, inserted before position as insert does (std::deque::emplace).
  template<typename... Args>
  DequeIterator<T> emplace(const_iterator position, Args&&... args)
  {
    ContainerSize index = this->indexOf(position);
    if (index == 0)
      this->emplace_front(forward<Args>(args)...);
    else if (index == this->length)
      this->emplace_back(forward<Args>(args)...);
    else
      this->insertBetween(index, T(forward<Args>(args)...));
    return this->iteratorAt(index);
  }

  // Removes the element at index, moving the shorter side by one; returns the position of the
  // element after it.
  DequeIterator<T> erase(ContainerSize index)
  {
    if (index < this->length / 2)
    {
      for (ContainerSize i = index; i > 0; --i)
        (*this)[i] = move((*this)[i - 1]);
      this->pop_front();
    }
    else
    {
      for (ContainerSize i = index; i + 1 < this->length; ++i)
        (*this)[i] = move((*this)[i + 1]);
      this->pop_back();
    }
    return this->iteratorAt(index);
  }

  DequeIterator<T> erase(const_iterator position) { return this->erase(this->indexOf(position)); }

  // Removes the elements in [first, last), moving the shorter side of the rest by their count;
  // returns the position of the element after them.
  DequeIterator<T> erase(const_iterator first, const_iterator last)
  {
    ContainerSize from = this->indexOf(first);
    if (last.position <= first.position) // (before the subtraction, which would wrap)
      return this->iteratorAt(from);
    ContainerSize count = last.position - first.position;
    if (from < this->length - (from + count))
    {
      for (ContainerSize i = from; i-- > 0;) // from - 1 down to 0
        (*this)[i + count] = move((*this)[i]);
      for (ContainerSize k = 0; k < count; ++k)
        this->pop_front();
    }
    else
    {
      for (ContainerSize i = from + count; i < this->length; ++i)
        (*this)[i - count] = move((*this)[i]);
      for (ContainerSize k = 0; k < count; ++k)
        this->pop_back();
    }
    return this->iteratorAt(from);
  }

  // New elements are copies of value.
  void resize(ContainerSize newLength, const T& value)
  {
    this->truncate(newLength);
    while (this->length < newLength)
      this->emplace_back(value);
  }

  void resize(ContainerSize newLength)
  {
    this->truncate(newLength);
    while (this->length < newLength)
      this->emplace_back();
  }

  void clear()
  {
    while (this->length > 0)
      this->pop_back();
  }

  // std::deque::shrink_to_fit, a request the standard lets an implementation decline: a block is
  // freed already when removals empty it (see the top), so there is no unused element storage to
  // give back; the map of block pointers keeps its size. Elements and references stay.
  void shrink_to_fit() {}

private:
  // The slot for a new last element; its block is allocated, the map regrown when needed.
  T* slotForBack()
  {
    ContainerSize block = (this->start + this->length) >> Deque::blockShift();
    if (block >= this->mapLength)
      this->remap(this->start >> Deque::blockShift(), block);
    ContainerSize position = this->start + this->length;
    this->ensureBlock(position >> Deque::blockShift());
    return this->slotAt(position);
  }

  T* slotForFront()
  {
    if (this->start == 0)
    {
      i64 last = this->length > 0 ? (this->start + this->length - 1) >> Deque::blockShift() : 0;
      this->remap(-1, last);
    }
    this->ensureBlock((this->start - 1) >> Deque::blockShift());
    return this->slotAt(this->start - 1);
  }

  // value, which is not an element, before index, neither end: the shorter side moves by one.
  void insertBetween(ContainerSize index, T&& value)
  {
    if (index < this->length / 2)
    {
      this->emplace_front(move((*this)[0]));
      for (ContainerSize i = 1; i < index; ++i)
        (*this)[i] = move((*this)[i + 1]);
    }
    else
    {
      this->emplace_back(move((*this)[this->length - 1]));
      for (ContainerSize i = this->length - 2; i > index; --i)
        (*this)[i] = move((*this)[i - 1]);
    }
    (*this)[index] = move(value);
  }

  // Removes the elements from newLength on.
  void truncate(ContainerSize newLength)
  {
    while (this->length > newLength)
      this->pop_back();
  }

  // Makes room for count elements at index, moving the shorter side by count, as std's: the elements
  // that land outside the old range by move construction, the others by move assignment. Nothing
  // moves at either end, so what refers to the elements stays. Returns the indices [first, second)
  // of the new slots that hold moved-from elements, to be assigned; the others are unconstructed.
  Pair<ContainerSize, ContainerSize> openSlots(ContainerSize index, ContainerSize count)
  {
    if (count == 0)
      return Pair<ContainerSize, ContainerSize>(index, index);
    ContainerSize newLength = sizeSum(this->length, count, "deque too long");
    ContainerSize following = this->length - index;
    if (index < following)
    {
      this->reserveFront(count);
      ContainerSize newStart = this->start - count;
      ContainerSize constructed = index < count ? index : count;
      for (ContainerSize i = 0; i < constructed; ++i)
        new (this->slotAt(newStart + i)) T(move(*this->slotAt(this->start + i)));
      for (ContainerSize i = constructed; i < index; ++i)
        *this->slotAt(newStart + i) = move(*this->slotAt(this->start + i));
      this->start = newStart;
      this->length = newLength;
      return Pair<ContainerSize, ContainerSize>(index > count ? index : count, index + count);
    }
    this->reserveBack(count);
    ContainerSize constructed = following < count ? following : count;
    ContainerSize firstConstructed = this->length - constructed;
    for (ContainerSize i = this->length; i-- > firstConstructed;)
      new (this->slotAt(this->start + i + count)) T(move(*this->slotAt(this->start + i)));
    for (ContainerSize i = firstConstructed; i-- > index;)
      *this->slotAt(this->start + i + count) = move(*this->slotAt(this->start + i));
    ContainerSize oldLength = this->length;
    this->length = newLength;
    return Pair<ContainerSize, ContainerSize>(index, index + count < oldLength ? index + count : oldLength);
  }

  // Blocks for count more elements after the last one (count > 0).
  void reserveBack(ContainerSize count)
  {
    ContainerSize last = (this->start + this->length + count - 1) >> Deque::blockShift();
    if (last >= this->mapLength)
      this->remap(this->start >> Deque::blockShift(), last);
    ContainerSize end = this->start + this->length + count - 1;
    for (ContainerSize block = (this->start + this->length) >> Deque::blockShift(); block <= end >> Deque::blockShift(); ++block)
      this->ensureBlock(block);
  }

  // Blocks for count more elements before the first one (count > 0).
  void reserveFront(ContainerSize count)
  {
    if (this->start < count)
    {
      i64 first = ((i64)this->start - (i64)count) >> Deque::blockShift();
      i64 last = this->length > 0 ? (this->start + this->length - 1) >> Deque::blockShift() : 0;
      this->remap(first, last);
    }
    for (ContainerSize block = (this->start - count) >> Deque::blockShift(); block <= (this->start - 1) >> Deque::blockShift(); ++block)
      this->ensureBlock(block);
  }

  DequeIterator<T> iteratorAt(ContainerSize index) { return DequeIterator<T>(this->map, this->start + index); }
  ContainerSize indexOf(const_iterator position) const { return position.position - this->start; }

  void ensureBlock(ContainerSize block)
  {
    if (!this->map[block])
      this->map[block] = allocateArray<T>(Deque::blockSize());
  }

  void freeBlock(ContainerSize block)
  {
    free(this->map[block]);
    this->map[block] = nullptr;
  }

  // Makes the map cover blocks [first, last] of the current numbering (first may be -1 for a
  // block before the current start) in its middle, with room on both sides, twice as long when
  // they would fill more than half of it. Block pointers move; blocks and elements do not.
  // The positions in the map's space (block * blockSize() + index) are sizes, so it has at most
  // maxContainerSize / blockSize() blocks: past them LengthError (core/Sizes.kpp).
  void remap(i64 first, i64 last)
  {
    i64 most = (i64)(maxContainerSize / Deque::blockSize());
    i64 neededBlocks = last - first + 1;
    if (neededBlocks > most)
      throwLengthError("deque too long");
    ContainerSize needed = (ContainerSize)neededBlocks;
    i64 doubled = this->mapLength < 8 ? 8 : (i64)this->mapLength;
    while (doubled < neededBlocks * 2)
      doubled *= 2;
    ContainerSize newLength = doubled > most ? (ContainerSize)most : (ContainerSize)doubled;
    T** newMap = allocateArray<T*>(newLength);
    for (ContainerSize i = 0; i < newLength; ++i)
      newMap[i] = nullptr;
    ContainerSize offset = (newLength - needed) / 2; // where block `first` goes
    for (ContainerSize i = 0; i < this->mapLength; ++i)
      if (this->map[i])
      {
        if ((i64)i >= first && (i64)i <= last)
          newMap[(i64)i - first + offset] = this->map[i];
        else
          free(this->map[i]); // unused: no element lives there
      }
    if (this->map)
      free(this->map);
    this->map = newMap;
    this->mapLength = newLength;
    this->start = ContainerSize((i64)this->start + ((i64)offset - first) * Deque::blockSize());
  }

  void release()
  {
    this->clear();
    for (ContainerSize i = 0; i < this->mapLength; ++i)
      if (this->map[i])
        free(this->map[i]);
    if (this->map)
      free(this->map);
    this->map = nullptr;
    this->mapLength = 0;
    this->start = 0;
  }

protected: // a derived class may see the blocks (tests/run/deque.kpp)
  T** map = nullptr;   // mapLength block pointers; null where no block is allocated
  ContainerSize mapLength = 0;
  ContainerSize start = 0;       // the position of element 0 in the map's space
  ContainerSize length = 0;
};

// A position in a Deque: the map of its blocks and the position in the map's space, the element's
// own (Deque: start + index), not its index: it stays on its element through removals at the ends,
// which change start, and through swap and moves, which hand the map over; adding to the deque can
// replace the map, and invalidates iterators, as std's. Random access.
// DequeIterator<const T> is the const_iterator: the same position, its element const. An iterator
// converts to it implicitly, and back only explicitly (erase(const_iterator)).
template<typename T>
class DequeIterator
{
public:
  using value_type = RemoveConst<T>;
  using difference_type = i64;
  using pointer = T*;
  using reference = T&;
  using iterator_category = RandomAccessIteratorTag;

  DequeIterator() {}
  DequeIterator(RemoveConst<T>** blocks, ContainerSize position) : blocks(blocks), position(position) {}
  template<typename F> requires (isSame<F, RemoveConst<T>> && !isSame<F, T>)
  implicit DequeIterator(const DequeIterator<F>& other) : blocks(other.blocks), position(other.position) {}
  template<typename F> requires (isSame<T, RemoveConst<F>> && !isSame<F, T>)
  explicit DequeIterator(const DequeIterator<F>& other) : blocks(other.blocks), position(other.position) {}

  T& operator*() const { return *Deque<RemoveConst<T>>::slotIn(this->blocks, this->position); }
  T* operator->() const { return Deque<RemoveConst<T>>::slotIn(this->blocks, this->position); }
  T& operator[](i64 offset) const { return *Deque<RemoveConst<T>>::slotIn(this->blocks, ContainerSize(this->position + offset)); }
  bool operator==(const DequeIterator<T>& other) const { return this->position == other.position; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator==(const DequeIterator<F>& other) const { return this->position == other.position; }
  bool operator!=(const DequeIterator<T>& other) const { return this->position != other.position; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator!=(const DequeIterator<F>& other) const { return this->position != other.position; }
  bool operator<(const DequeIterator<T>& other) const { return this->position < other.position; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator<(const DequeIterator<F>& other) const { return this->position < other.position; }
  bool operator>(const DequeIterator<T>& other) const { return this->position > other.position; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator>(const DequeIterator<F>& other) const { return this->position > other.position; }
  bool operator<=(const DequeIterator<T>& other) const { return this->position <= other.position; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator<=(const DequeIterator<F>& other) const { return this->position <= other.position; }
  bool operator>=(const DequeIterator<T>& other) const { return this->position >= other.position; }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  bool operator>=(const DequeIterator<F>& other) const { return this->position >= other.position; }

  DequeIterator<T>& operator++()
  {
    ++this->position;
    return *this;
  }

  DequeIterator<T> operator++(i32)
  {
    DequeIterator<T> before = *this;
    ++this->position;
    return before;
  }

  DequeIterator<T>& operator--()
  {
    --this->position;
    return *this;
  }

  DequeIterator<T> operator--(i32)
  {
    DequeIterator<T> before = *this;
    --this->position;
    return before;
  }

  DequeIterator<T> operator+(i64 offset) const { return DequeIterator<T>(this->blocks, ContainerSize(this->position + offset)); }
  DequeIterator<T> operator-(i64 offset) const { return DequeIterator<T>(this->blocks, ContainerSize(this->position - offset)); }
  i64 operator-(const DequeIterator<T>& other) const { return i64(this->position) - i64(other.position); }
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<T>> && !isSame<F, T>)
  i64 operator-(const DequeIterator<F>& other) const { return i64(this->position) - i64(other.position); }

  DequeIterator<T>& operator+=(i64 offset)
  {
    this->position += offset;
    return *this;
  }

  DequeIterator<T>& operator-=(i64 offset)
  {
    this->position -= offset;
    return *this;
  }

private:
  template<typename F> friend class DequeIterator;
  template<typename U> friend class Deque;

  RemoveConst<T>** blocks = nullptr;
  ContainerSize position = 0;
};

// First in, first out: push at the back, pop at the front.
template<typename T, typename Container = Deque<T>>
class Queue
{
public:
  using container_type = Container;
  using value_type = T;
  using size_type = ContainerSize;
  using reference = T&;
  using const_reference = const T&;

  ContainerSize size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T& front() { return this->values.front(); }
  T& back() { return this->values.back(); }
  const T& front() const { return this->values.front(); }
  const T& back() const { return this->values.back(); }
  void push(const T& value) { this->values.push_back(value); }
  void push(T&& value) { this->values.push_back(move(value)); }
  template<typename... Args>
  T& emplace(Args&&... args) { return this->values.emplace_back(forward<Args>(args)...); }
  void pop() { this->values.pop_front(); }
  void clear() { this->values.clear(); }

protected: // as C++'s container adaptors' c: a derived class may reach it
  Container values;
};

// Last in, first out: push and pop at the top.
template<typename T, typename Container = Deque<T>>
class Stack
{
public:
  using container_type = Container;
  using value_type = T;
  using size_type = ContainerSize;
  using reference = T&;
  using const_reference = const T&;

  ContainerSize size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T& top() { return this->values.back(); }
  const T& top() const { return this->values.back(); }
  void push(const T& value) { this->values.push_back(value); }
  void push(T&& value) { this->values.push_back(move(value)); }
  template<typename... Args>
  T& emplace(Args&&... args) { return this->values.emplace_back(forward<Args>(args)...); }
  void pop() { this->values.pop_back(); }
  void clear() { this->values.clear(); }

protected: // as C++'s container adaptors' c: a derived class may reach it
  Container values;
};
