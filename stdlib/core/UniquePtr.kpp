// kpp standard library: UniquePtr<T, D>, sole ownership of a heap object: given to the deleter D
// (by default deleted) when the pointer goes away or is reset, moved but never copied; the shape
// of std::unique_ptr. It is one pointer: the deleter is a class without state, constructed for each
// call (`D()(object)`), so there is no constructor taking a deleter object. Specified in
// docs/stdlib/uniqueptr.md.

// The default deleter (std::default_delete): deletes the object. One for a class derived from T
// converts to it, as the pointers do.
template<typename T>
struct DefaultDelete
{
  DefaultDelete() {}
  template<typename U> requires (isConvertible<U*, T*>)
  implicit DefaultDelete(const DefaultDelete<U>& other) {}
  void operator()(T* object) const { delete object; }
};

template<typename T, typename D = DefaultDelete<T>>
class UniquePtr
{
public:
  using element_type = T;
  using deleter_type = D;
  using pointer = T*; // TechnologyGraphGui's `typename GraphT::value_type::pointer`

  UniquePtr() {}
  implicit UniquePtr(nullptr_t) {}
  UniquePtr(T* object) : held(object) {}
  UniquePtr(const UniquePtr<T, D>& other) = delete;
  UniquePtr(UniquePtr<T, D>&& other) noexcept : held(other.held) { other.held = nullptr; }
  // From a UniquePtr to a type whose pointer converts to T* (a derived class, T const), with a
  // deleter that converts to D: takes its object. Deleting it through T* needs T's destructor to
  // be virtual when the types differ.
  template<typename U, typename E> requires (isConvertible<U*, T*> && isConvertible<E, D> && !(isSame<U, T> && isSame<E, D>))
  implicit UniquePtr(UniquePtr<U, E>&& other) noexcept : held(other.release()) {}

  ~UniquePtr()
  {
    if (this.held)
      D()(this.held);
  }

  UniquePtr<T, D>& operator=(const UniquePtr<T, D>& other) = delete;

  UniquePtr<T, D>& operator=(nullptr_t)
  {
    this.reset(nullptr);
    return this;
  }

  UniquePtr<T, D>& operator=(UniquePtr<T, D>&& other) noexcept
  {
    // other may live inside the object this owns (`head = move(head->next)`): taken first, as
    // std's reset(r.release()), so the old object is deleted only after.
    if (&this != &other)
      this.reset(other.release());
    return this;
  }

  template<typename U, typename E> requires (isConvertible<U*, T*> && isConvertible<E, D> && !(isSame<U, T> && isSame<E, D>))
  UniquePtr<T, D>& operator=(UniquePtr<U, E>&& other) noexcept
  {
    this.reset(other.release());
    return this;
  }

  T* get() const { return this.held; }
  // A deleter, by value (std returns a reference to the stored one; this one stores none).
  D get_deleter() const { return D(); }
  T& operator*() const { return *this.held; }
  T* operator->() const { return this.held; }
  operator bool() const { return this.held != nullptr; }
  bool operator!() const { return this.held == nullptr; }
  bool operator==(const UniquePtr<T, D>& other) const { return this.held == other.held; }
  bool operator==(nullptr_t) const { return this.held == nullptr; }
  // Against a plain pointer, of the same class or a base of it.
  template<typename U>
  bool operator==(const U* other) const { return this.held == other; }

  // Owns newPointer, then gives the old object (if any) to the deleter.
  void reset(T* newPointer)
  {
    T* old = this.held;
    this.held = newPointer;
    if (old)
      D()(old);
  }

  void reset() { this.reset(nullptr); }

  // Gives the object up without the deleter seeing it.
  T* release()
  {
    T* result = this.held;
    this.held = nullptr;
    return result;
  }

  void swap(UniquePtr<T, D>& other) noexcept
  {
    T* tmp = this.held;
    this.held = other.held;
    other.held = tmp;
  }

private:
  template<typename U, typename E> friend class UniquePtr;

  T* held = nullptr;
};

template<typename T, typename... Args>
UniquePtr<T> makeUnique(Args&&... args) { return UniquePtr<T>(new T(forward<Args>(args)...)); }
