// Kpp standard library: StringView, a borrowed slice of UTF-8 code units. It does not own the
// bytes and is not zero-terminated; copy it into a String to keep it.
struct StringView
{
  const char* chars = nullptr;
  ContainerSize byteCount = 0;

  using iterator = const char*;
  using const_iterator = const char*;
  using value_type = char;
  using size_type = ContainerSize;
  using difference_type = ptrdiff_t;
  using reference = const char&;
  using const_reference = const char&;
  using pointer = const char*;
  using const_pointer = const char*;

  // Not found, or to the end: the largest size, as C++'s npos is the largest size_t, so that a
  // search result compares with sizes as in C++ (`min(s.find(x), s.size())`).
  static const ContainerSize npos = ContainerSize(-1);

  StringView() {}
  implicit StringView(const char* text) : chars(text), byteCount(text ? checkedSize(strlen(text), "string too long") : 0) {}
  StringView(const char* text, ContainerSize count) : chars(text), byteCount(count) {}
  implicit StringView(const String& text) : chars(text.data()), byteCount(text.size()) {}

  ContainerSize size() const { return this->byteCount; }
  ContainerSize length() const { return this->byteCount; }
  const char* data() const { return this->chars; }
  bool empty() const { return this->byteCount == 0; }
  const char& operator[](ContainerSize index) const { return this->chars[index]; }
  const char* begin() const { return this->chars; }
  const char* end() const { return this->chars + this->byteCount; }
  const char* cbegin() const { return this->begin(); }
  const char* cend() const { return this->end(); }
  ReverseIterator<const char*> rbegin() const { return ReverseIterator<const char*>(this->end()); }
  ReverseIterator<const char*> rend() const { return ReverseIterator<const char*>(this->begin()); }
  ReverseIterator<const char*> crbegin() const { return this->rbegin(); }
  ReverseIterator<const char*> crend() const { return this->rend(); }
  char front() const { return this->chars[0]; }
  char back() const { return this->chars[this->byteCount - 1]; }

  StringView substr(ContainerSize start, ContainerSize count) const
  {
    if (start > this->byteCount)
      start = this->byteCount;
    if (count > this->byteCount - start)
      count = this->byteCount - start;
    return StringView(this->chars + start, count);
  }
  StringView substr(ContainerSize start) const { return this->substr(start, npos); }
  // Up to count bytes from pos into dest; the number copied. OutOfRange when pos > size().
  uint64_t copy(char* dest, uint64_t count, uint64_t pos = 0) const
  {
    if (pos > (uint64_t)this->byteCount)
      throwOutOfRange("StringView::copy: position out of range");
    uint64_t available = (uint64_t)this->byteCount - pos;
    if (count > available)
      count = available;
    memcpy(dest, this->chars + pos, count);
    return count;
  }

  ContainerSize find(char c) const
  {
    for (ContainerSize i = 0; i < this->byteCount; ++i)
      if (this->chars[i] == c)
        return i;
    return npos;
  }
  ContainerSize find(StringView needle) const
  {
    if (needle.byteCount == 0)
      return 0;
    for (ContainerSize i = 0; i + needle.byteCount <= this->byteCount; ++i)
      if (memcmp(this->chars + i, needle.chars, needle.byteCount) == 0)
        return i;
    return npos;
  }
  ContainerSize rfind(char c) const
  {
    for (ContainerSize i = this->byteCount; i-- > 0;)
      if (this->chars[i] == c)
        return i;
    return npos;
  }
  // The last occurrence starting at or before `from` (anywhere when from is npos), or npos, as
  // String's (DebugTools.cpp's `line.rfind("ghostShimmerConfig.tint", 0) == 0`, a prefix test).
  ContainerSize rfind(char c, ContainerSize from) const
  {
    if (this->byteCount == 0)
      return npos;
    for (ContainerSize i = from < this->byteCount - 1 ? from : this->byteCount - 1;; --i) // down to 0, which ends it
    {
      if (this->chars[i] == c)
        return i;
      if (i == 0)
        return npos;
    }
  }
  ContainerSize rfind(StringView needle, ContainerSize from) const
  {
    if (needle.byteCount > this->byteCount)
      return npos;
    for (ContainerSize i = from < this->byteCount - needle.byteCount ? from : this->byteCount - needle.byteCount;; --i)
    {
      if (needle.byteCount == 0 || memcmp(this->chars + i, needle.chars, needle.byteCount) == 0)
        return i;
      if (i == 0)
        return npos;
    }
  }
  ContainerSize rfind(StringView needle) const { return this->rfind(needle, npos); }
  bool startsWith(StringView prefix) const
  {
    return prefix.byteCount <= this->byteCount && memcmp(this->chars, prefix.chars, prefix.byteCount) == 0;
  }
  bool endsWith(StringView suffix) const
  {
    return suffix.byteCount <= this->byteCount && memcmp(this->chars + this->byteCount - suffix.byteCount, suffix.chars, suffix.byteCount) == 0;
  }
  void removePrefix(ContainerSize count) { this->chars += count; this->byteCount -= count; }
  void remove_prefix(ContainerSize count) { this->removePrefix(count); }
  void remove_suffix(ContainerSize count) { this->byteCount -= count; }
  bool starts_with(StringView prefix) const { return this->startsWith(prefix); }
  bool ends_with(StringView suffix) const { return this->endsWith(suffix); }
  // Whether the first (last) character is c (C++20's starts_with(char), TestTranslationCoverage's
  // `view.starts_with('[') && view.ends_with(']')`).
  bool starts_with(char c) const { return this->byteCount > 0 && this->chars[0] == c; }
  bool ends_with(char c) const { return this->byteCount > 0 && this->chars[this->byteCount - 1] == c; }
  ContainerSize find_first_of(char c) const { return this->find(c); }
  ContainerSize find_first_of(char c, ContainerSize from) const { return this->find(c, from); }
  ContainerSize find_first_of(StringView set, ContainerSize from) const
  {
    ContainerSize i = this->substr(from).find_first_of(set);
    return i == npos ? npos : i + from;
  }
  ContainerSize find(char c, ContainerSize from) const
  {
    for (ContainerSize i = from; i < this->byteCount; ++i)
      if (this->chars[i] == c)
        return i;
    return npos;
  }
  ContainerSize find_first_of(StringView set) const
  {
    for (ContainerSize i = 0; i < this->byteCount; ++i)
      for (ContainerSize k = 0; k < set.byteCount; ++k)
        if (this->chars[i] == set.chars[k])
          return i;
    return npos;
  }
  ContainerSize find(StringView needle, ContainerSize from) const
  {
    StringView rest = this->substr(from);
    ContainerSize i = rest.find(needle);
    return i == npos ? npos : i + from;
  }
  ContainerSize find_first_of(const char* set) const
  {
    for (ContainerSize i = 0; i < this->byteCount; ++i)
      for (size_t k = 0; set[k] != 0; ++k)
        if (this->chars[i] == set[k])
          return i;
    return npos;
  }
  ContainerSize find_first_not_of(char c) const
  {
    for (ContainerSize i = 0; i < this->byteCount; ++i)
      if (this->chars[i] != c)
        return i;
    return npos;
  }
  ContainerSize find_first_not_of(const char* set) const
  {
    for (ContainerSize i = 0; i < this->byteCount; ++i)
    {
      bool inSet = false;
      for (size_t k = 0; set[k] != 0; ++k)
        if (this->chars[i] == set[k])
          inSet = true;
      if (!inSet)
        return i;
    }
    return npos;
  }
  void removeSuffix(ContainerSize count) { this->byteCount -= count; }

  bool operator==(StringView other) const
  {
    return this->byteCount == other.byteCount && (this->byteCount == 0 || memcmp(this->chars, other.chars, this->byteCount) == 0);
  }
  bool operator!=(StringView other) const { return !(*this == other); }
  bool operator<(StringView other) const
  {
    ContainerSize common = this->byteCount < other.byteCount ? this->byteCount : other.byteCount;
    int c = common == 0 ? 0 : memcmp(this->chars, other.chars, common);
    return c != 0 ? c < 0 : this->byteCount < other.byteCount;
  }
  // Byte-wise as <: gives >, <= and >=.
  strong_ordering operator<=>(StringView other) const
  {
    return *this < other ? strong_ordering::less : other < *this ? strong_ordering::greater : strong_ordering::equal;
  }

  String toString() const
  {
    String result;
    result.append(this->chars, this->byteCount);
    return result;
  }
};

String toString(StringView text) { return text.toString(); }
size_t hashOf(StringView text)
{
  size_t h = 14695981039346656037ull;
  for (ContainerSize i = 0; i < text.byteCount; ++i)
    h = (h ^ (size_t)(uint8_t)text.chars[i]) * 1099511628211ull;
  return h;
}
