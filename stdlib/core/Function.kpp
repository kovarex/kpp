// Kpp standard library: Function<R(Args...)>, a callable of any kind (lambda, function pointer,
// object with operator()) behind one type, as std::function. `Function<Signature>` is only a name:
// the compiler reads the signature and makes `Function<void(int)>` mean FunctionImpl<void, int>,
// which is what this file defines. The callable is copied to the heap; calls go through one
// indirection; copying a Function copies the callable. Specified in docs/stdlib/function.md.
template<typename Signature>
struct Function;

// What calling an empty Function throws.
struct BadFunctionCall : Exception
{
  BadFunctionCall() : Exception(String("bad function call")) {}
};

template<typename R, typename... Args>
struct FunctionImpl
{
  void* target = nullptr;                        // the callable, on the heap
  R (*invoke)(void*, Args...) = nullptr;         // calls it
  void (*destroy)(void*) = nullptr;              // deletes it
  void* (*clone)(void*) = nullptr;               // copies it

  FunctionImpl() {}
  implicit FunctionImpl(nullptr_t) {}
  // From a callable, never from what cannot be called (a number, a pointer to an object such as a
  // string literal), so that another overload takes those, as std::function's constructor needs a
  // callable: `use("text")` with use(const String&) and use(Function<void()>) takes the String one.
  template<typename F>
  implicit FunctionImpl(F callable)
    requires(!isArithmetic<F> && !(isPointer<F> && !isFunction<RemovePointer<F>>))
    : target(new F(move(callable))),
      invoke(&FunctionImpl<R, Args...>::call<F>),
      destroy(&FunctionImpl<R, Args...>::destroyAs<F>),
      clone(&FunctionImpl<R, Args...>::cloneAs<F>)
  {}
  FunctionImpl(const FunctionImpl<R, Args...>& other)
    : target(other.target ? other.clone(other.target) : nullptr), invoke(other.invoke), destroy(other.destroy), clone(other.clone)
  {}
  FunctionImpl(FunctionImpl<R, Args...>&& other)
    : target(other.target), invoke(other.invoke), destroy(other.destroy), clone(other.clone)
  {
    other.target = nullptr;
  }
  ~FunctionImpl()
  {
    if (this->target)
      this->destroy(this->target);
  }

  FunctionImpl<R, Args...>& operator=(const FunctionImpl<R, Args...>& other)
  {
    if (this == &other)
      return *this;
    if (this->target)
      this->destroy(this->target);
    this->target = other.target ? other.clone(other.target) : nullptr;
    this->invoke = other.invoke;
    this->destroy = other.destroy;
    this->clone = other.clone;
    return *this;
  }
  FunctionImpl<R, Args...>& operator=(FunctionImpl<R, Args...>&& other)
  {
    if (this == &other)
      return *this;
    if (this->target)
      this->destroy(this->target);
    this->target = other.target;
    this->invoke = other.invoke;
    this->destroy = other.destroy;
    this->clone = other.clone;
    other.target = nullptr;
    return *this;
  }
  FunctionImpl<R, Args...>& operator=(nullptr_t)
  {
    this->reset();
    return *this;
  }

  explicit operator bool() const { return this->target != nullptr; }
  bool operator!() const { return this->target == nullptr; }
  bool operator==(nullptr_t) const { return this->target == nullptr; }
  bool operator!=(nullptr_t) const { return this->target != nullptr; }

  R operator()(Args... args) const
  {
    if (!this->target)
      throw BadFunctionCall();
    return this->invoke(this->target, forward<Args>(args)...);
  }

  void reset()
  {
    if (this->target)
      this->destroy(this->target);
    this->target = nullptr;
    this->invoke = nullptr;
    this->destroy = nullptr;
    this->clone = nullptr;
  }

  // The three operations of a callable of type F, taken by address in the constructor.
  template<typename F>
  static R call(void* target, Args... args) { return (*(F*)target)(forward<Args>(args)...); }
  template<typename F>
  static void destroyAs(void* target) { delete (F*)target; }
  template<typename F>
  static void* cloneAs(void* target) { return new F(*(F*)target); }
};

// A reference that is a value (std::reference_wrapper): it can be stored in containers, copied and
// assigned (assigning rebinds it), and it converts to the T& it refers to. Specified in
// docs/stdlib/function.md.
template<typename T>
struct ReferenceWrapper
{
  using type = T;

  T* pointer;

  // std also deletes the constructor from T&&, so that a ReferenceWrapper<const T> never refers to
  // a temporary; with that declared, codegen copies the wrapper through it
  // (classes/deleted_constructor_beside_implicit_copy, pending), so it waits for that fix.
  implicit ReferenceWrapper(T& value) : pointer(&value) {}

  T& get() const { return *this->pointer; }
  implicit operator T&() const { return *this->pointer; }

  template<typename... CallArgs>
  decltype(auto) operator()(CallArgs&&... args) const
  {
    return (*this->pointer)(forward<CallArgs>(args)...);
  }
};

// A ReferenceWrapper to value (std::ref, std::cref).
template<typename T>
ReferenceWrapper<T> ref(T& value) { return ReferenceWrapper<T>(value); }
template<typename T>
ReferenceWrapper<const T> cref(const T& value) { return ReferenceWrapper<const T>(value); }

template<typename T>
struct IsReferenceWrapper { static constexpr bool value = false; };
template<typename T>
struct IsReferenceWrapper<ReferenceWrapper<T>> { static constexpr bool value = true; };

// The class of a pointer to member, `R C::*` (a member function's too: its R is a function type).
template<typename M>
struct MemberPointerClass {};
template<typename R, typename C>
struct MemberPointerClass<R C::*> { using Type = C; };

// Calls f with args the way C++'s INVOKE does (std::invoke; Thread runs its function so). A
// pointer to a member function is called on the first argument and given the rest: that argument
// is an object of the member's class or of a class derived from it (or a reference to one), a
// ReferenceWrapper of one, or anything else `*` turns into one (a pointer, a UniquePtr, a
// SharedPtr). A pointer to a data member gives that member of the one argument, found the same
// way. Anything else is called with all the arguments. Specified in docs/stdlib/function.md.
template<typename F, typename... Args>
decltype(auto) invoke(F&& f, Args&&... args)
{
  if constexpr (isMemberPointer<Decay<F>>)
    return invokeMember(f, forward<Args>(args)...);
  else
    return forward<F>(f)(forward<Args>(args)...);
}

template<typename M, typename T, typename... Args>
decltype(auto) invokeMember(M member, T&& object, Args&&... args)
{
  using Class = typename MemberPointerClass<M>::Type;
  if constexpr (isMemberFunctionPointer<M>)
  {
    if constexpr (isBaseOf<Class, Decay<T>>)
      return (forward<T>(object).*member)(forward<Args>(args)...);
    else if constexpr (IsReferenceWrapper<Decay<T>>::value)
      return (object.get().*member)(forward<Args>(args)...);
    else
      return ((*forward<T>(object)).*member)(forward<Args>(args)...);
  }
  else
  {
    if constexpr (isBaseOf<Class, Decay<T>>)
      return (forward<T>(object).*member);
    else if constexpr (IsReferenceWrapper<Decay<T>>::value)
      return (object.get().*member);
    else
      return ((*forward<T>(object)).*member);
  }
}
