// Variant helpers: compile-time queries and visitors for Variant<...>.
// The core Variant template is elsewhere (or generated by the converter); these are the helper
// functions that std::holds_alternative, std::get_if, std::visit etc. convert to.

// holdsAlternative<T>(v): true when the variant currently holds type T.
// This is a stub that works for the common case where Variant has an index() method and a
// type list. The real implementation needs compiler support for type indexing.
template<typename T, typename V>
bool holdsAlternative(const V& variant)
{
  return variant.index() == V::template indexOf<T>();
}

// getIf<I>(v): pointer to the I-th alternative, or nullptr.
template<int I, typename V>
auto getIf(V* variant) -> decltype(&variant->template get<I>())
{
  if (variant && variant->index() == I)
    return &variant->template get<I>();
  return nullptr;
}

// variantSize: the number of alternatives.
template<typename V>
constexpr int variantSize = V::size;

// VariantAlternative: the type of the I-th alternative.
template<int I, typename V>
using VariantAlternative = typename V::template Alternative<I>;

// visit: calls a visitor with the current value. Supports up to 8 alternatives.
template<typename Visitor, typename V>
auto visit(Visitor&& vis, V&& variant) -> decltype(vis(variant.template get<0>()))
{
  switch (variant.index())
  {
    case 0: return vis(variant.template get<0>());
    case 1: return vis(variant.template get<1>());
    case 2: return vis(variant.template get<2>());
    case 3: return vis(variant.template get<3>());
    case 4: return vis(variant.template get<4>());
    case 5: return vis(variant.template get<5>());
    case 6: return vis(variant.template get<6>());
    case 7: return vis(variant.template get<7>());
  }
  return vis(variant.template get<0>());
}
