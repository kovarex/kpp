// Variant helpers: compile-time queries and visitors for Variant<...>.
// The core Variant template is elsewhere (or generated by the converter); these are the helper
// functions that std::holds_alternative, std::get_if, std::visit etc. convert to.

// holdsAlternative<T>(v), get<T>(v) and getIf<T>(&v) by type (std::holds_alternative, std::get and
// std::get_if) of a converted std::variant: a typed union with the converter's holds<T>, get<T> and
// getIf<T> members. The converter rewrites these calls to the members where it parses them; these
// are for the code it does not parse, the tests' bodies, which UnitTest++'s macros make
// (`CHECK_EQUAL(get<SegmentedUnitAI::Attacking>(ai.getState()).target.get(), belt)`).
template<typename T, typename V> requires requires (const V& v) { v.template holds<T>(); }

bool holdsAlternative(const V& variant)
{
  return variant.template holds<T>();
}

template<typename T, typename V> requires requires (V& v) { v.template holds<T>(); }

T& get(V& variant)
{
  return variant.template get<T>();
}

template<typename T, typename V> requires requires (const V& v) { v.template holds<T>(); }

const T& get(const V& variant)
{
  return variant.template get<T>();
}

template<typename T, typename V> requires requires (V& v) { v.template holds<T>(); }

T* getIf(V* variant)
{
  return variant ? variant->template getIf<T>() : nullptr;
}

template<typename T, typename V> requires requires (const V& v) { v.template holds<T>(); }

const T* getIf(const V* variant)
{
  return variant ? variant->template getIf<T>() : nullptr;
}

// getIf<I>(v): pointer to the I-th alternative, or nullptr.
template<i32 I, typename V>
auto getIf(V* variant) -> decltype(&variant->template get<I>())
{
  if (variant && variant->index() == I)
    return &variant->template get<I>();
  return nullptr;
}

// variantSize: the number of alternatives.
template<typename V>
constexpr i32 variantSize = V::size;

// VariantAlternative<I, U>: the type of the typed union U's I-th alternative, a built-in of the
// compiler's (design.md 8.5), as std::variant_alternative_t is.

// What visit throws for a variant that holds none of its alternatives, as std::bad_variant_access.
class BadVariantAccess : public Exception
{
public:
  BadVariantAccess() : Exception(String("bad variant access")) {}
};

// visit(visitor, variant): the visitor called with the alternative the variant holds, as std::visit
// of one variant ([variant.visit]). The variant is a class with index(), get<I>() and its number of
// alternatives as the constant `size` (variantSize), which can be any number. The visitor and the
// variant are passed on as they came, so an rvalue variant gives its visitor an rvalue, and the
// visitor gives one type for every alternative. A typed union takes no visit: it is asked with a
// `switch` (design.md 8.5).
template<typename Visitor, typename V> requires requires (V& v) { v.index(); }

auto visit(Visitor&& vis, V&& variant) -> decltype(forward<Visitor>(vis)(forward<V>(variant).template get<0>()))
{
  constexpr i32 count = variantSize<RemoveCvRef<V>>;
  using Result = decltype(forward<Visitor>(vis)(forward<V>(variant).template get<0>()));
  return visitIndexed<Result>(forward<Visitor>(vis), forward<V>(variant), MakeIndexSequence<count>());
}

// One case per alternative. (A switch, as nesting an instantiation per alternative runs out of the
// nesting the compiler types a generic lambda's call in.)
template<typename Result, typename Visitor, typename V, i32... I>
Result visitIndexed(Visitor&& vis, V&& variant, IndexSequence<I...>)
{
  switch (variant.index())
  {
    for constexpr (typename Index : types<IntegralConstant<i32, I>...>)
      case Index::value: return visitAlternative<Index::value, Result>(forward<Visitor>(vis), forward<V>(variant));
  }
  throw BadVariantAccess();
}

template<i32 I, typename Result, typename Visitor, typename V>
Result visitAlternative(Visitor&& vis, V&& variant)
{
  static_assert(isSame<decltype(forward<Visitor>(vis)(forward<V>(variant).template get<I>())), Result>, "visit: the visitor must give the same type for every alternative");
  return forward<Visitor>(vis)(forward<V>(variant).template get<I>());
}
