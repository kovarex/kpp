// Kpp standard library: the small utilities everything uses. (TrueType and FalseType, the trait
// bases, are IntegralConstant's bool instances in TypeTraits.kpp.)

// value as an rvalue (std::move): from an lvalue or an rvalue alike.
template<typename T>
RemoveReference<T>&& move(T&& value) { return (RemoveReference<T>&&)value; }

// value with the value category T says (std::forward<T>): an lvalue reference T keeps it an
// lvalue, any other T makes it an rvalue.
template<typename T>
T&& forward(RemoveReference<T>& value) { return (T&&)value; }
template<typename T>
T&& forward(RemoveReference<T>&& value) { return (T&&)value; }

// A value of type T where only its type matters (`decltype(declval<T>().str())`): declared, never
// defined, so a call outside decltype and requires does not link.
template<typename T>
T&& declval();

// Relocation: moves count objects from source into the unconstructed memory at destination and
// destroys the originals (move constructor, then destructor), as containers do when they grow or
// shift. For types whose moves are plain copies, clang turns these loops into memcpy/memmove.
// relocate goes front to back, so the destination may overlap the source from below;
// relocateBackward goes back to front, for a destination above the source.
template<typename T>
void relocate(T* destination, T* source, long long count)
{
  for (long long i = 0; i < count; ++i)
  {
    new (destination + i) T(move(source[i]));
    source[i].~T();
  }
}
template<typename T>
void relocateBackward(T* destination, T* source, long long count)
{
  for (long long i = count; i-- > 0;)
  {
    new (destination + i) T(move(source[i]));
    source[i].~T();
  }
}

template<typename T>
void swap(T& a, T& b)
{
  T tmp = move(a);
  a = move(b);
  b = move(tmp);
}

// Stores newValue and returns what was there.
template<typename T, typename U>
T exchange(T& slot, const U& newValue)
{
  T old = move(slot);
  slot = newValue;
  return old;
}

// The bits of one value read as another type of the same size (`bitCast<uint32_t>(f)`).
template<typename To, typename From>
To bitCast(const From& from) { return *(const To*)&from; }

template<typename T>
const T& min(const T& a, const T& b) { return b < a ? b : a; }
template<typename T>
const T& max(const T& a, const T& b) { return a < b ? b : a; }
template<typename T>
const T& clamp(const T& value, const T& low, const T& high) { return value < low ? low : high < value ? high : value; }

// Two values together: the result of split functions, entries of maps.
template<typename A, typename B>
struct Pair
{
  A first;
  B second;

  Pair() {}
  Pair(const A& first, const B& second) : first(first), second(second) {}
  // Rvalues are moved in, as std::pair's forwarding constructor does: Pair<K, UniquePtr<T>>(key,
  // makeUnique<T>()) works. (Plain overloads rather than a template, which would also claim to
  // build a Pair from any two arguments in constructibility checks.)
  Pair(A&& first, B&& second) : first(move(first)), second(move(second)) {}
  Pair(const A& first, B&& second) : first(first), second(move(second)) {}
  Pair(A&& first, const B& second) : first(move(first)), second(second) {}
  // From two values the members are constructed from, as std::pair's converting constructor:
  // explicit when one of them converts to its member only explicitly
  // (`Pair<SharedStringKey, bool> emptyItem{StringView(), false}` with an explicit
  // SharedStringKey(StringView)); there only for arguments the members can be constructed from.
  template<typename U1, typename U2>
  explicit(!isConvertible<U1, A> || !isConvertible<U2, B>) Pair(U1&& first, U2&& second)
    requires(isConstructible<A, U1> && isConstructible<B, U2>)
    : first(forward<U1>(first)), second(forward<U2>(second))
  {
  }
  // From a Pair of other types whose members these are constructed from (std::pair's converting
  // constructors), with the same explicitness rule: `map.emplace(Pair<uint32, Sound*>(...))` into
  // a Map<uint32, UniquePointer<Sound>> (ProcessionAudioCatalogue). The other's members are copied,
  // or moved from an rvalue Pair.
  template<typename U1, typename U2>
  explicit(!isConvertible<const U1&, A> || !isConvertible<const U2&, B>) Pair(const Pair<U1, U2>& other)
    requires(isConstructible<A, const U1&> && isConstructible<B, const U2&>)
    : first(other.first), second(other.second)
  {
  }
  template<typename U1, typename U2>
  explicit(!isConvertible<U1, A> || !isConvertible<U2, B>) Pair(Pair<U1, U2>&& other)
    requires(isConstructible<A, U1> && isConstructible<B, U2>)
    : first(forward<U1>(other.first)), second(forward<U2>(other.second))
  {
  }

  bool operator==(const Pair<A, B>& other) const { return this->first == other.first && this->second == other.second; }
  bool operator!=(const Pair<A, B>& other) const { return !(*this == other); }
  bool operator<(const Pair<A, B>& other) const
  {
    if (this->first < other.first)
      return true;
    if (other.first < this->first)
      return false;
    return this->second < other.second;
  }
};

// What makePair stores for an argument of type T (std::unwrap_ref_decay_t): T decayed (without
// reference and const, an array or a function as a pointer), and a ReferenceWrapper<U> as U&.
template<typename T>
struct UnwrapReference { using Type = T; };
template<typename T>
struct UnwrapReference<ReferenceWrapper<T>> { using Type = T&; };
template<typename T>
using UnwrapRefDecay = typename UnwrapReference<Decay<T>>::Type;

// A Pair of the two values, each moved in when it is an rvalue (std::make_pair):
// `makePair(id, move(animation))` moves a move-only value.
template<typename A, typename B>
Pair<UnwrapRefDecay<A>, UnwrapRefDecay<B>> makePair(A&& first, B&& second)
{
  return Pair<UnwrapRefDecay<A>, UnwrapRefDecay<B>>(forward<A>(first), forward<B>(second));
}

// Up to four values together (what std::tuple converts to); `get<I>(tuple)` reads one.
struct Nothing {};
template<typename A, typename B = Nothing, typename C = Nothing, typename D = Nothing>
struct Tuple
{
  A first;
  B second;
  C third;
  D fourth;

  Tuple() {}
  Tuple(const A& first, const B& second) : first(first), second(second) {}
  Tuple(const A& first, const B& second, const C& third) : first(first), second(second), third(third) {}
  Tuple(const A& first, const B& second, const C& third, const D& fourth) : first(first), second(second), third(third), fourth(fourth) {}
};
template<typename A, typename B>
Tuple<A, B> makeTuple(const A& a, const B& b) { return Tuple<A, B>(a, b); }
template<typename A, typename B, typename C>
Tuple<A, B, C> makeTuple(const A& a, const B& b, const C& c) { return Tuple<A, B, C>(a, b, c); }
template<typename A, typename B, typename C, typename D>
Tuple<A, B, C, D> makeTuple(const A& a, const B& b, const C& c, const D& d) { return Tuple<A, B, C, D>(a, b, c, d); }

// The type of element I of a Tuple, and the element itself.
template<int I, typename A, typename B, typename C, typename D>
struct TupleElement {};
template<typename A, typename B, typename C, typename D>
struct TupleElement<0, A, B, C, D> { using Type = A; };
template<typename A, typename B, typename C, typename D>
struct TupleElement<1, A, B, C, D> { using Type = B; };
template<typename A, typename B, typename C, typename D>
struct TupleElement<2, A, B, C, D> { using Type = C; };
template<typename A, typename B, typename C, typename D>
struct TupleElement<3, A, B, C, D> { using Type = D; };
template<int I>
struct TupleGet {};
template<>
struct TupleGet<0> { template<typename A, typename B, typename C, typename D> static A& of(Tuple<A, B, C, D>& t) { return t.first; } };
template<>
struct TupleGet<1> { template<typename A, typename B, typename C, typename D> static B& of(Tuple<A, B, C, D>& t) { return t.second; } };
template<>
struct TupleGet<2> { template<typename A, typename B, typename C, typename D> static C& of(Tuple<A, B, C, D>& t) { return t.third; } };
template<>
struct TupleGet<3> { template<typename A, typename B, typename C, typename D> static D& of(Tuple<A, B, C, D>& t) { return t.fourth; } };
template<int I, typename A, typename B, typename C, typename D>
typename TupleElement<I, A, B, C, D>::Type& get(Tuple<A, B, C, D>& t) { return TupleGet<I>::of(t); }
template<int I, typename A, typename B, typename C, typename D>
const typename TupleElement<I, A, B, C, D>::Type& get(const Tuple<A, B, C, D>& t) { return TupleGet<I>::of(const_cast<Tuple<A, B, C, D>&>(t)); }

// The result of a three-way comparison `a <=> b` (what std::strong_ordering, weak_ordering and
// partial_ordering convert to): less, equal or greater, compared with the literal 0 as in C++
// (`(a <=> b) < 0`). A defaulted `operator<=>` orders by the bases and members in turn, and gives
// the class `==` as well; `a != b` is `!(a == b)` and `a < b` is `(a <=> b) < 0` for every class.
struct strong_ordering
{
  int8_t value;
  constexpr strong_ordering(int8_t value) : value(value) {}
  static inline const strong_ordering less = strong_ordering(-1);
  static inline const strong_ordering equal = strong_ordering(0);
  static inline const strong_ordering equivalent = strong_ordering(0);
  static inline const strong_ordering greater = strong_ordering(1);
  constexpr bool operator==(const strong_ordering& other) const { return this->value == other.value; }
  constexpr bool operator==(int zero) const { return this->value == zero; }
  constexpr bool operator<(int zero) const { return this->value < zero; }
  constexpr bool operator>(int zero) const { return this->value > zero; }
  constexpr bool operator<=(int zero) const { return this->value <= zero; }
  constexpr bool operator>=(int zero) const { return this->value >= zero; }
};
using weak_ordering = strong_ordering;
using partial_ordering = strong_ordering;

// The properties of the arithmetic types (what std::numeric_limits converts to), for every
// integer and character type, bool, float and double; for any other type (an enum, a class)
// is_specialized is false and the values are zero. Specified in docs/stdlib/limits.md.
template<typename T>
struct Limits
{
  static constexpr bool is_specialized = isArithmetic<T>;
  static constexpr bool is_signed = isSigned<T>;
  static constexpr bool is_integer = isIntegral<T>;
  static constexpr bool is_exact = isIntegral<T>;
  static constexpr bool has_infinity = isFloatingPoint<T>;
  static constexpr bool has_quiet_NaN = isFloatingPoint<T>;
  static constexpr bool has_signaling_NaN = isFloatingPoint<T>;
  static constexpr bool is_iec559 = isFloatingPoint<T>;
  static constexpr bool is_bounded = isArithmetic<T>;
  static constexpr bool is_modulo = isIntegral<T> && !isSigned<T> && !isSame<T, bool>;
  static constexpr int radix = isArithmetic<T> ? 2 : 0;
  // Bits of the value (integers: without the sign; floating point: of the significand).
  static constexpr int digits = isSame<T, bool> ? 1 : isIntegral<T> ? int(sizeof(T)) * 8 - (isSigned<T> ? 1 : 0)
                                : isFloatingPoint<T> ? (sizeof(T) == 4 ? 24 : 53) : 0;
  // Decimal digits that survive a round trip through T; for floating point, the digits that
  // print every value of T distinctly.
  static constexpr int digits10 = isIntegral<T> ? digits * 301 / 1000 : isFloatingPoint<T> ? (sizeof(T) == 4 ? 6 : 15) : 0;
  static constexpr int max_digits10 = isFloatingPoint<T> ? (sizeof(T) == 4 ? 9 : 17) : 0;
  static constexpr int min_exponent = isFloatingPoint<T> ? (sizeof(T) == 4 ? -125 : -1021) : 0;
  static constexpr int min_exponent10 = isFloatingPoint<T> ? (sizeof(T) == 4 ? -37 : -307) : 0;
  static constexpr int max_exponent = isFloatingPoint<T> ? (sizeof(T) == 4 ? 128 : 1024) : 0;
  static constexpr int max_exponent10 = isFloatingPoint<T> ? (sizeof(T) == 4 ? 38 : 308) : 0;

  // The greatest value.
  static constexpr T max()
  {
    if constexpr (isSame<T, bool>)
      return true;
    else if constexpr (isFloatingPoint<T>)
    {
      if constexpr (sizeof(T) == 4)
        return 3.40282347e+38f;
      else
        return 1.7976931348623157e+308;
    }
    else if constexpr (isIntegral<T> && isSigned<T>)
      return (T)(((unsigned long long)1 << (sizeof(T) * 8 - 1)) - 1);
    else if constexpr (isIntegral<T>)
      return (T)~(unsigned long long)0;
    else
      return T();
  }
  // The least value of an integer type; the least positive normal value of a floating-point one.
  static constexpr T min()
  {
    if constexpr (isFloatingPoint<T>)
    {
      if constexpr (sizeof(T) == 4)
        return 1.17549435e-38f;
      else
        return 2.2250738585072014e-308;
    }
    else if constexpr (isIntegral<T> && isSigned<T>)
      return (T)(-(long long)(((unsigned long long)1 << (sizeof(T) * 8 - 1)) - 1) - 1);
    else
      return T();
  }
  // The least value (for floating point, -max()).
  static constexpr T lowest()
  {
    if constexpr (isFloatingPoint<T>)
      return -Limits::max();
    else
      return Limits::min();
  }
  // The difference between 1 and the next greater value.
  static constexpr T epsilon()
  {
    if constexpr (isFloatingPoint<T>)
    {
      if constexpr (sizeof(T) == 4)
        return 1.19209290e-07f;
      else
        return 2.2204460492503131e-16;
    }
    else
      return T();
  }
  static constexpr T round_error()
  {
    if constexpr (isFloatingPoint<T>)
      return (T)0.5;
    else
      return T();
  }
  // The least positive (subnormal) value.
  static constexpr T denorm_min()
  {
    if constexpr (isFloatingPoint<T>)
    {
      if constexpr (sizeof(T) == 4)
        return 1.40129846e-45f;
      else
        return 4.9406564584124654e-324;
    }
    else
      return T();
  }
  // Positive infinity and a quiet NaN of a floating-point type (zero for the others). Not usable
  // in constant expressions.
  static T infinity()
  {
    if constexpr (isFloatingPoint<T>)
    {
      T big = Limits::max();
      return big * (T)2;
    }
    else
      return T();
  }
  static T quiet_NaN()
  {
    if constexpr (isFloatingPoint<T>)
    {
      T zero = T();
      return zero / zero;
    }
    else
      return T();
  }
  static T signaling_NaN()
  {
    if constexpr (sizeof(T) == 4 && isFloatingPoint<T>)
    {
      uint32_t bits = 0x7FA00000u;
      T value;
      memcpy(&value, &bits, 4);
      return value;
    }
    else if constexpr (isFloatingPoint<T>)
    {
      uint64_t bits = 0x7FF4000000000000ull;
      T value;
      memcpy(&value, &bits, 8);
      return value;
    }
    else
      return T();
  }
};

// Errors carried by exceptions: a message and nothing else.
struct Exception
{
  String message;
  Exception() {}
  explicit Exception(const String& message) : message(message) {}
  const char* what() const { return this->message.c_str(); }
};
struct RuntimeError : Exception
{
  RuntimeError() {}
  explicit RuntimeError(const String& message) : Exception(message) {}
};
struct LogicError : Exception
{
  LogicError() {}
  explicit LogicError(const String& message) : Exception(message) {}
};
struct OutOfRange : LogicError
{
  OutOfRange() {}
  explicit OutOfRange(const String& message) : LogicError(message) {}
};
// What the checked accessors (at(), substr()) throw for an index or key that is not there. Out of
// line, so that the check costs the callers only a compare and a branch.
[[noinline]] void throwOutOfRange(const char* what) { throw OutOfRange(String(what)); }

struct InvalidArgument : LogicError
{
  InvalidArgument() {}
  explicit InvalidArgument(const String& message) : LogicError(message) {}
};
