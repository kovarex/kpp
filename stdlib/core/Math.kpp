// kpp standard library: the floating-point classification functions, which C's math.h only
// provides as macros.

// The C math library, as std::sqrt and friends convert to `::sqrt`.
extern "C" double sqrt(double value);
extern "C" double floor(double value);
extern "C" double ceil(double value);
extern "C" double round(double value);
extern "C" double trunc(double value);
extern "C" double pow(double base, double exponent);
extern "C" double fmod(double value, double divisor);
extern "C" double exp(double value);
extern "C" double log(double value);
extern "C" double sin(double value);
extern "C" double cos(double value);
extern "C" double atan2(double y, double x);
extern "C" double fabs(double value);
extern "C" long lround(double value);
extern "C" double nextafter(double from, double to);
float sqrt(float value) { return (float)sqrt((double)value); }
float floor(float value) { return (float)floor((double)value); }
float ceil(float value) { return (float)ceil((double)value); }
float round(float value) { return (float)round((double)value); }
// Of an integer: taken as a double, as <cmath>'s overloads for integral types (no tie between the
// float and the double form).
template<typename T> requires isIntegral<T>
double sqrt(T value) { return sqrt(double(value)); }
template<typename T> requires isIntegral<T>
double floor(T value) { return floor(double(value)); }
template<typename T> requires isIntegral<T>
double ceil(T value) { return ceil(double(value)); }
template<typename T> requires isIntegral<T>
double round(T value) { return round(double(value)); }
// fmod and nextafter of two floats are the C runtime's float ones, as MSVC's std::fmod(float, float)
// is fmodf: a float result (TestFloatingPoint's fmodFloat saves 10000 of them for a checksum) and
// a float's next value (its ClampCast test: nextafter(2147483520.0f, FLT_MAX) is 2147483648.0f).
// Arguments of two different arithmetic types, or integers, are taken as doubles, as C++'s
// templates for them do.
extern "C" float fmodf(float value, float divisor);
extern "C" float nextafterf(float from, float to);
float fmod(float value, float divisor) { return fmodf(value, divisor); }
float nextafter(float from, float to) { return nextafterf(from, to); }
template<typename A, typename B>
  requires isArithmetic<A> && isArithmetic<B> && (!isSame<A, B> || isIntegral<A>)
double fmod(A value, B divisor) { return fmod(double(value), double(divisor)); }
template<typename A, typename B>
  requires isArithmetic<A> && isArithmetic<B> && (!isSame<A, B> || isIntegral<A>)
double nextafter(A from, B to) { return nextafter(double(from), double(to)); }

bool isnan(double value) { return value != value; }
bool isnan(float value) { return value != value; }
bool isinf(double value) { return value == value && value != 0.0 && value * 2.0 == value; }
bool isinf(float value) { return value == value && value != 0.0f && value * 2.0f == value; }
bool isfinite(double value) { return !isnan(value) && !isinf(value); }
bool isfinite(float value) { return !isnan(value) && !isinf(value); }
template<typename T> requires isIntegral<T>
bool isnan(T value) { return false; }
template<typename T> requires isIntegral<T>
bool isinf(T value) { return false; }
template<typename T> requires isIntegral<T>
bool isfinite(T value) { return true; }

// The sign bit: of a negative zero and of a NaN too (0.0 / 0.0 is a negative NaN on x86-64, so
// std::signbit of it is true; a comparison never told it).
bool signbit(double value)
{
  if (value != value)
    return (bitCast<u64>(value) >> 63) != 0;
  return value < 0.0 || (value == 0.0 && 1.0 / value < 0.0);
}

bool signbit(float value)
{
  if (value != value)
    return (bitCast<u32>(value) >> 31) != 0;
  return value < 0.0f || (value == 0.0f && 1.0f / value < 0.0f);
}

// math.h defines these through compiler builtins, which the importer cannot bring over.
const float INFINITY = 1e39f;
const double HUGE_VAL = 1e309;
// The positive quiet NaN, as C's NAN and Limits' quiet_NaN (0.0 / 0.0 at startup was the
// processor's default NaN, a negative one: signbit(NAN) was true where C's is false).
const double NAN = Limits<double>::quiet_NaN();

// abs for the floating-point types (the C runtime's abs takes an int; std::abs on a double
// converts to `::abs` and finds these): the value without its sign, as fabs, so a negative zero's
// is +0 (it was -0: 1 / abs(-0.0) was -inf) and a NaN's sign bit is cleared.
i32 abs(i32 value) { return value < 0 ? -value : value; }

float abs(float value)
{
  if (value != value)
    return (float)fabs((double)value); // (fabsf is an inline of the UCRT's math.h: no symbol)
  return value < 0 ? -value : value == 0 ? 0.0f : value;
}

double abs(double value)
{
  if (value != value)
    return fabs(value);
  return value < 0 ? -value : value == 0 ? 0.0 : value;
}

i64 abs(i64 value) { return value < 0 ? -value : value; }
