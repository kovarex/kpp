// kpp standard library: UniqueArray<T>, sole ownership of a heap array (what std::unique_ptr<T[]>
// converts to): indexed, destroyed and freed when the owner goes away or is reset, moved but never
// copied. One pointer, as std's: every array it holds is laid out as `new T[n]` makes it (the
// count in a cookie before the elements when T needs destroying), its own made by `new T[n]` too,
// so `delete[]` destroys and frees any of them and release() hands one to code that will.
// Specified in docs/stdlib/uniqueptr.md.
template<typename T>
class UniqueArray
{
public:
  UniqueArray() {}
  implicit UniqueArray(nullptr_t) {}
  // count value-initialized elements (std::make_unique<T[]>(count)): numbers are zero.
  explicit UniqueArray(ContainerSize count) : pointer(count != 0 ? new T[count]() : nullptr) {}
  // Takes over array, made by `new T[n]` (std::unique_ptr<T[]>(array)), or nothing for null.
  explicit UniqueArray(T* array) : pointer(array) {}
  UniqueArray(const UniqueArray<T>& other) = delete;
  UniqueArray(UniqueArray<T>&& other) noexcept : pointer(other.pointer) { other.pointer = nullptr; }
  ~UniqueArray() { delete[] this->pointer; }

  UniqueArray<T>& operator=(const UniqueArray<T>& other) = delete;

  UniqueArray<T>& operator=(UniqueArray<T>&& other) noexcept
  {
    if (this != &other)
      this->reset(other.release());
    return *this;
  }

  UniqueArray<T>& operator=(nullptr_t)
  {
    this->reset();
    return *this;
  }

  T* get() const { return this->pointer; }
  T& operator[](ContainerSize index) const { return this->pointer[index]; }
  explicit operator bool() const { return this->pointer != nullptr; }
  bool operator!() const { return this->pointer == nullptr; }
  bool operator==(nullptr_t) const { return this->pointer == nullptr; }
  bool operator!=(nullptr_t) const { return this->pointer != nullptr; }

  // The array, which the caller now owns (to give to `delete[]`); the UniqueArray is empty.
  T* release()
  {
    T* array = this->pointer;
    this->pointer = nullptr;
    return array;
  }

  // Destroys the elements and frees the array; then the UniqueArray is empty.
  void reset() { this->reset(nullptr); }

  // Takes over array (made by `new T[n]`, or null), then destroys the array it had, as std's
  // reset does; resetting to the array it holds does nothing.
  void reset(T* array)
  {
    if (array && array == this->pointer)
      return;
    T* old = this->pointer;
    this->pointer = array;
    delete[] old;
  }

  void swap(UniqueArray<T>& other) { ::swap(this->pointer, other.pointer); }

private:
  T* pointer = nullptr;
};

template<typename T>
UniqueArray<T> makeUniqueArray(ContainerSize count) { return UniqueArray<T>(count); }

// count elements to be overwritten (std::make_unique_for_overwrite<T[]>(n)): default-initialized,
// which leaves a type that needs no construction (numbers, chars, plain structs) uninitialized
// instead of zeroed; other types are constructed.
template<typename T>
UniqueArray<T> makeUniqueArrayForOverwrite(ContainerSize count) { return UniqueArray<T>(count != 0 ? new T[count] : nullptr); }
