// Odds and ends for std:: names converted code uses: <codecvt>'s converters (over WString.kpp's
// conversions), two concepts and std::numbers' constants.

// Filesystem: moved to Filesystem.kpp

// codecvt_utf8 / wstring_convert: used in Factorio for UTF-8 ↔ wstring conversion.
// The real conversion is in WString.kpp (toUtf8/fromUtf8); these are thin stubs so code
// that was written against the C++ <codecvt> API compiles.
template<typename Elem>
struct CodecvtUtf8 {};

template<typename Codecvt>
struct WStringConvert
{
  WStringConvert() {}
  WStringConvert(Codecvt* cvt) { delete cvt; }

  String to_bytes(const WString& wide)
  {
    String result;
    for (i32 i = 0; i < wide.size(); ++i)
    {
      wchar_t ch = wide[i];
      if (ch < 0x80)
        result.append((char)ch);
      else if (ch < 0x800)
      {
        result.append((char)(0xC0 | (ch >> 6)));
        result.append((char)(0x80 | (ch & 0x3F)));
      }
      else
      {
        result.append((char)(0xE0 | (ch >> 12)));
        result.append((char)(0x80 | ((ch >> 6) & 0x3F)));
        result.append((char)(0x80 | (ch & 0x3F)));
      }
    }
    return result;
  }

  WString from_bytes(const String& narrow)
  {
    WString result;
    i32 i = 0;
    while (i < narrow.size())
    {
      u8 c = (u8)narrow[i];
      wchar_t ch;
      if (c < 0x80)
      {
        ch = c;
        ++i;
      }
      else if (c < 0xE0)
      {
        ch = (wchar_t)(((c & 0x1F) << 6) | ((u8)narrow[i + 1] & 0x3F));
        i += 2;
      }
      else
      {
        ch = (wchar_t)(((c & 0x0F) << 12) | (((u8)narrow[i + 1] & 0x3F) << 6)
              | ((u8)narrow[i + 2] & 0x3F));
        i += 3;
      }
      result.push_back(ch);
    }
    return result;
  }
};

// Concepts (std::convertible_to, std::equality_comparable).
template<typename From, typename To> constexpr bool ConvertibleTo = isConvertible<From, To>;
template<typename T> constexpr bool EqualityComparable = requires (const T& a, const T& b) { a == b; a != b; };

// Namespace-like stubs for rarely-used sub-namespaces.
struct Numbers
{
  template<typename T> static constexpr T pi_v = T(3.14159265358979323846);
  template<typename T> static constexpr T e_v = T(2.71828182845904523536);
};
