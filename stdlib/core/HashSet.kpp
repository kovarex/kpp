// Kpp standard library: HashSet<T>, open addressing with linear probing (HashMap without the
// values; what std::unordered_set converts to). Values need hashOf(value) (see Hash.kpp) and
// operator==. Iteration visits the used slots in table order. The table works as HashMap's does:
// at most 3/4 full, rehashed by moving the values (move constructor, then destructor).
template<typename T>
struct HashSetEntry
{
  T value;
  int state = 0; // 0 empty, 1 used, 2 deleted
};

template<typename T>
struct HashSetIterator
{
  HashSetEntry<T>* slot = nullptr;
  HashSetEntry<T>* end = nullptr;

  HashSetIterator() {}
  HashSetIterator(HashSetEntry<T>* slot, HashSetEntry<T>* end) : slot(slot), end(end) { this->skipUnused(); }

  const T& operator*() const { return this->slot->value; }
  const T* operator->() const { return &this->slot->value; }
  HashSetIterator<T>& operator++()
  {
    ++this->slot;
    this->skipUnused();
    return *this;
  }
  bool operator==(HashSetIterator<T> other) const { return this->slot == other.slot; }
  bool operator!=(HashSetIterator<T> other) const { return this->slot != other.slot; }

  void skipUnused()
  {
    while (this->slot != this->end && this->slot->state != 1)
      ++this->slot;
  }
};

template<typename T>
struct HashSet
{
  HashSetEntry<T>* entries = nullptr;
  int capacity = 0; // always a power of two
  int elementCount = 0; // used entries
  int usedSlots = 0;    // used + deleted entries

  using iterator = HashSetIterator<T>;
  using const_iterator = HashSetIterator<T>;
  using value_type = T;

  HashSet() {}
  HashSet(const HashSet<T>& other) { this->copyFrom(other); }
  HashSet(HashSet<T>&& other) : entries(other.entries), capacity(other.capacity), elementCount(other.elementCount), usedSlots(other.usedSlots)
  {
    other.entries = nullptr;
    other.capacity = 0;
    other.elementCount = 0;
    other.usedSlots = 0;
  }
  ~HashSet() { this->destroyEntries(); }

  HashSet<T>& operator=(const HashSet<T>& other)
  {
    if (this == &other)
      return *this;
    this->destroyEntries();
    this->copyFrom(other);
    return *this;
  }
  HashSet<T>& operator=(HashSet<T>&& other)
  {
    if (this == &other)
      return *this;
    this->destroyEntries();
    this->entries = other.entries;
    this->capacity = other.capacity;
    this->elementCount = other.elementCount;
    this->usedSlots = other.usedSlots;
    other.entries = nullptr;
    other.capacity = 0;
    other.elementCount = 0;
    other.usedSlots = 0;
    return *this;
  }

  int size() const { return this->elementCount; }
  bool empty() const { return this->elementCount == 0; }
  bool contains(const T& value) const { return this->findSlot(value) >= 0; }
  int count(const T& value) const { return this->findSlot(value) >= 0 ? 1 : 0; }

  HashSetIterator<T> begin() const { return HashSetIterator<T>(this->entries, this->entries + this->capacity); }
  HashSetIterator<T> end() const { return HashSetIterator<T>(this->entries + this->capacity, this->entries + this->capacity); }

  HashSetIterator<T> find(const T& value) const
  {
    int slot = this->findSlot(value);
    if (slot < 0)
      return this->end();
    return HashSetIterator<T>(this->entries + slot, this->entries + this->capacity);
  }

  // True when the value was not there before.
  bool insert(const T& value)
  {
    int slot = this->slotFor(value);
    if (slot < 0)
    {
      T copy(value); // value may be one of this set's, which growing moves
      this->grow();
      return this->insert(copy);
    }
    HashSetEntry<T>& e = this->entries[slot];
    bool added = e.state != 1;
    if (added)
    {
      new (&e.value) T(value);
      if (e.state == 0)
        ++this->usedSlots;
      e.state = 1;
      ++this->elementCount;
    }
    return added;
  }

  bool erase(const T& value)
  {
    int slot = this->findSlot(value);
    if (slot < 0)
      return false;
    HashSetEntry<T>& e = this->entries[slot];
    e.value.~T();
    // No probe path runs through this slot when the next one is empty, so it can be empty too.
    if (this->entries[(slot + 1) & (this->capacity - 1)].state == 0)
    {
      e.state = 0;
      --this->usedSlots;
    }
    else
      e.state = 2;
    --this->elementCount;
    return true;
  }

  void clear() { this->destroyEntries(); }

  // Internals.
  int findSlot(const T& value) const
  {
    if (this->capacity == 0)
      return -1;
    size_t mask = this->capacity - 1;
    size_t i = hashOf(value) & mask;
    while (true)
    {
      HashSetEntry<T>& e = this->entries[i];
      if (e.state == 0)
        return -1;
      if (e.state == 1 && e.value == value)
        return (int)i;
      i = (i + 1) & mask;
    }
  }

  // The slot holding value, else the first deleted slot on its probe path, else the empty slot
  // that ends the path.
  int probe(const T& value, size_t hash) const
  {
    size_t mask = this->capacity - 1;
    size_t i = hash & mask;
    int firstDeleted = -1;
    while (true)
    {
      const HashSetEntry<T>& e = this->entries[i];
      if (e.state == 0)
        return firstDeleted >= 0 ? firstDeleted : (int)i;
      if (e.state == 1)
      {
        if (e.value == value)
          return (int)i;
      }
      else if (firstDeleted < 0)
        firstDeleted = (int)i;
      i = (i + 1) & mask;
    }
  }

  // The slot holding value, or the free slot where it goes; -1 when taking an empty slot would
  // fill the table over 3/4, so that it has to grow first.
  int slotFor(const T& value)
  {
    if (this->capacity == 0)
      this->rehash(8);
    int slot = this->probe(value, hashOf(value));
    if (this->entries[slot].state == 0 && (this->usedSlots + 1) * 4 > this->capacity * 3)
      return -1;
    return slot;
  }

  // Twice the size, unless deleted entries made up the load: then the same size, cleared.
  void grow() { this->rehash((this->elementCount + 1) * 2 > this->capacity ? this->capacity * 2 : this->capacity); }

  // Moves the used entries into a new table of newCapacity slots, which drops the deleted ones.
  void rehash(int newCapacity)
  {
    HashSetEntry<T>* old = this->entries;
    int oldCapacity = this->capacity;
    this->entries = (HashSetEntry<T>*)malloc((size_t)newCapacity * sizeof(HashSetEntry<T>));
    for (int i = 0; i < newCapacity; ++i)
      this->entries[i].state = 0;
    this->capacity = newCapacity;
    this->usedSlots = this->elementCount;
    size_t mask = newCapacity - 1;
    for (int i = 0; i < oldCapacity; ++i)
      if (old[i].state == 1)
      {
        size_t j = hashOf(old[i].value) & mask;
        while (this->entries[j].state != 0)
          j = (j + 1) & mask;
        new (&this->entries[j].value) T(move(old[i].value));
        this->entries[j].state = 1;
        old[i].value.~T();
      }
    if (old)
      free(old);
  }

  // Copies other slot by slot: same capacity, same positions, deleted markers kept (the probe
  // paths of later values run through them).
  void copyFrom(const HashSet<T>& other)
  {
    if (other.elementCount == 0)
      return;
    this->entries = (HashSetEntry<T>*)malloc((size_t)other.capacity * sizeof(HashSetEntry<T>));
    for (int i = 0; i < other.capacity; ++i)
    {
      if (other.entries[i].state == 1)
        new (&this->entries[i].value) T(other.entries[i].value);
      this->entries[i].state = other.entries[i].state;
    }
    this->capacity = other.capacity;
    this->elementCount = other.elementCount;
    this->usedSlots = other.usedSlots;
  }

  void destroyEntries()
  {
    for (int i = 0; i < this->capacity; ++i)
      if (this->entries[i].state == 1)
        this->entries[i].value.~T();
    if (this->entries)
      free(this->entries);
    this->entries = nullptr;
    this->capacity = 0;
    this->elementCount = 0;
    this->usedSlots = 0;
  }
};
