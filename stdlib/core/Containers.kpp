// kpp standard library: Array and Span. (Deque, Queue and Stack are in Deque.kpp, Map and Set in
// Map.kpp.)

// A fixed-size array that knows its size (what std::array converts to).
template<typename T, ContainerSize N>
struct Array
{
  T items[N];

  using iterator = T*;
  using const_iterator = const T*;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  ContainerSize size() const { return N; }
  ContainerSize max_size() const { return N; }
  bool empty() const { return N == 0; }
  T& operator[](ContainerSize index) { return this->items[index]; }
  const T& operator[](ContainerSize index) const { return this->items[index]; }

  // Throws OutOfRange for an index outside [0, N).
  T& at(ContainerSize index)
  {
    if (index >= N)
      throwOutOfRange("Array::at: index out of range");
    return this->items[index];
  }

  const T& at(ContainerSize index) const
  {
    if (index >= N)
      throwOutOfRange("Array::at: index out of range");
    return this->items[index];
  }

  T* data() { return this->items; }
  const T* data() const { return this->items; }
  T* begin() { return this->items; }
  T* end() { return this->items + N; }
  const T* begin() const { return this->items; }
  const T* end() const { return this->items + N; }
  const T* cbegin() const { return this->begin(); }
  const T* cend() const { return this->end(); }
  ReverseIterator<T*> rbegin() { return ReverseIterator<T*>(this->end()); }
  ReverseIterator<T*> rend() { return ReverseIterator<T*>(this->begin()); }
  ReverseIterator<const T*> rbegin() const { return ReverseIterator<const T*>(this->end()); }
  ReverseIterator<const T*> rend() const { return ReverseIterator<const T*>(this->begin()); }
  ReverseIterator<const T*> crbegin() const { return this->rbegin(); }
  ReverseIterator<const T*> crend() const { return this->rend(); }
  T& front() { return this->items[0]; }
  T& back() { return this->items[N - 1]; }
  const T& front() const { return this->items[0]; }
  const T& back() const { return this->items[N - 1]; }

  void fill(const T& value)
  {
    for (ContainerSize i = 0; i < N; ++i)
      this->items[i] = value;
  }

  // Exchanges the elements one by one (std::array::swap).
  void swap(Array<T, N>& other)
  {
    for (ContainerSize i = 0; i < N; ++i)
    {
      T held = move(this->items[i]);
      this->items[i] = move(other.items[i]);
      other.items[i] = move(held);
    }
  }

  bool operator==(const Array<T, N>& other) const
  {
    for (ContainerSize i = 0; i < N; ++i)
      if (!(this->items[i] == other.items[i]))
        return false;
    return true;
  }

  // Ordered lexicographically by the elements (common.md): gives <, >, <= and >=.
  strong_ordering operator<=>(const Array<T, N>& other) const { return lexicographicalCompareThreeWay(this->items, this->items + N, other.items, other.items + N); }
};

// An Array of no elements (std::array<T, 0>, as the noise expressions' constant arrays of
// operations without constants): no storage, so T needs no constructor; begin() == end(), at()
// always throws, and operator[], front() and back() must not be called.
template<typename T>
struct Array<T, 0>
{
  using iterator = T*;
  using const_iterator = const T*;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  ContainerSize size() const { return 0; }
  ContainerSize max_size() const { return 0; }
  bool empty() const { return true; }
  T& operator[](ContainerSize index) { return *this->data(); }
  const T& operator[](ContainerSize index) const { return *this->data(); }

  T& at(ContainerSize index)
  {
    throwOutOfRange("Array::at: index out of range");
    return *this->data();
  }

  const T& at(ContainerSize index) const
  {
    throwOutOfRange("Array::at: index out of range");
    return *this->data();
  }

  T* data() { return nullptr; }
  const T* data() const { return nullptr; }
  T* begin() { return nullptr; }
  T* end() { return nullptr; }
  const T* begin() const { return nullptr; }
  const T* end() const { return nullptr; }
  const T* cbegin() const { return nullptr; }
  const T* cend() const { return nullptr; }
  ReverseIterator<T*> rbegin() { return ReverseIterator<T*>(nullptr); }
  ReverseIterator<T*> rend() { return ReverseIterator<T*>(nullptr); }
  ReverseIterator<const T*> rbegin() const { return ReverseIterator<const T*>(nullptr); }
  ReverseIterator<const T*> rend() const { return ReverseIterator<const T*>(nullptr); }
  ReverseIterator<const T*> crbegin() const { return this->rbegin(); }
  ReverseIterator<const T*> crend() const { return this->rend(); }
  T& front() { return *this->data(); }
  T& back() { return *this->data(); }
  const T& front() const { return *this->data(); }
  const T& back() const { return *this->data(); }
  void fill(const T& value) {}
  void swap(Array<T, 0>& other) {}
  bool operator==(const Array<T, 0>& other) const { return true; }
  strong_ordering operator<=>(const Array<T, 0>& other) const { return strong_ordering::equal; }
};

// The extent of a Span whose length is known only when the program runs (std::dynamic_extent).
// The Array of a C array's elements, copied, or moved from an rvalue (std::to_array): `toArray({1, 2, 3})`.
template<typename T, ContainerSize N>
Array<RemoveConst<T>, N> toArray(T (&source)[N])
{
  Array<RemoveConst<T>, N> result;
  for (ContainerSize i = 0; i < N; ++i)
    result[i] = source[i];
  return result;
}

template<typename T, ContainerSize N>
Array<T, N> toArray(T (&&source)[N])
{
  Array<T, N> result;
  for (ContainerSize i = 0; i < N; ++i)
    result[i] = move(source[i]);
  return result;
}

constexpr ContainerSize dynamicExtent = ContainerSize(-1);

// A view of contiguous elements (what std::span converts to): a pointer and a count, over an
// array, a Vector, an Array, a Subrange of pointers or another Span. Extent is the count when it
// is fixed (std::span<T, N>), dynamicExtent otherwise. Specified in docs/stdlib/span.md.
template<typename T, ContainerSize Extent = dynamicExtent>
class Span
{
public:
  static constexpr ContainerSize extent = Extent;

  using element_type = T;
  using iterator = T*;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  Span() {}
  Span(T* items, ContainerSize length) : items(items), length(length) {}
  Span(T* first, T* last) : items(first), length(checkedSize(last - first, "span too long")) {}
  // From a Vector or an Array, a plain array, a Subrange of pointers: implicit for a span of any
  // length, explicit for a fixed extent (std::span's range constructor), whose count the source's
  // must be (an Array's and a plain array's of a fixed extent only that count).
  template<typename U> requires (Extent == dynamicExtent && isConvertible<U*, T*>)
  implicit Span(Vector<U>& values) : items(values.data()), length(values.size()) {}
  template<typename U> requires (Extent == dynamicExtent && isConvertible<const U*, T*>)
  implicit Span(const Vector<U>& values) : items(values.data()), length(values.size()) {}
  template<typename U> requires (Extent != dynamicExtent && isConvertible<U*, T*>)
  Span(Vector<U>& values) : items(values.data()), length(values.size()) {}
  template<typename U> requires (Extent != dynamicExtent && isConvertible<const U*, T*>)
  Span(const Vector<U>& values) : items(values.data()), length(values.size()) {}
  template<typename U, ContainerSize N> requires ((Extent == dynamicExtent || N == Extent) && isConvertible<U*, T*>)
  implicit Span(Array<U, N>& values) : items(values.data()), length(N) {}
  template<typename U, ContainerSize N> requires ((Extent == dynamicExtent || N == Extent) && isConvertible<const U*, T*>)
  implicit Span(const Array<U, N>& values) : items(values.data()), length(N) {}
  template<ContainerSize N> requires (Extent == dynamicExtent || N == Extent)
  implicit Span(T (&a)[N]) : items(a), length(N) {}
  template<typename U> requires (Extent == dynamicExtent && isConvertible<U*, T*>)
  implicit Span(const Subrange<U*>& range) : items(range.begin()), length(checkedSize(range.end() - range.begin(), "span too long")) {}
  template<typename U> requires (Extent != dynamicExtent && isConvertible<U*, T*>)
  Span(const Subrange<U*>& range) : items(range.begin()), length(checkedSize(range.end() - range.begin(), "span too long")) {}
  // From a span of other elements (T const) or another extent: implicit when the length is sure
  // to fit, explicit from a span of any length to a fixed extent.
  template<typename U, ContainerSize N> requires (!(isSame<U, T> && N == Extent) && isConvertible<U*, T*> && (Extent == dynamicExtent || N == Extent))
  implicit Span(const Span<U, N>& other) : items(other.items), length(other.length) {}
  template<typename U, ContainerSize N> requires (Extent != dynamicExtent && N == dynamicExtent && isConvertible<U*, T*>)
  Span(const Span<U, N>& other) : items(other.items), length(other.length) {}

  ContainerSize size() const { return this->length; }
  usize size_bytes() const { return (usize)this->length * sizeof(T); }
  bool empty() const { return this->length == 0; }
  T& operator[](ContainerSize index) const { return this->items[index]; }
  T* data() const { return this->items; }
  T* begin() const { return this->items; }
  T* end() const { return this->items + this->length; }
  T* cbegin() const { return this->begin(); }
  T* cend() const { return this->end(); }
  // From the last element back (std::span's rbegin and rend).
  ReverseIterator<T*> rbegin() const { return ReverseIterator<T*>(this->end()); }
  ReverseIterator<T*> rend() const { return ReverseIterator<T*>(this->begin()); }
  ReverseIterator<T*> crbegin() const { return this->rbegin(); }
  ReverseIterator<T*> crend() const { return this->rend(); }
  T& front() const { return this->items[0]; }
  T& back() const { return this->items[this->length - 1]; }

  // A count of dynamicExtent (std::span's default) is the rest from offset.
  Span<T> subspan(ContainerSize offset, ContainerSize count) const
  {
    return Span<T>(this->items + offset, count == dynamicExtent ? this->length - offset : count);
  }

  Span<T> subspan(ContainerSize offset) const { return Span<T>(this->items + offset, this->length - offset); }
  Span<T> first(ContainerSize count) const { return Span<T>(this->items, count); }
  Span<T> last(ContainerSize count) const { return Span<T>(this->items + this->length - count, count); }

private:
  T* items = nullptr;
  ContainerSize length = Extent == dynamicExtent ? 0 : Extent;
};

// Deduction (std::span's guides): `Span(weights)` of a Vector<float> is a Span<float>, of an Array
// or a built-in array a Span of its count, of a pointer and a count or of two pointers a Span of
// any length (NURBS::calcPointWeight's `std::span(this->weights)`).
template<typename T>
Span(T*, ContainerSize) -> Span<T>;
template<typename T>
Span(T*, T*) -> Span<T>;
template<typename T, ContainerSize N>
Span(T (&array)[N]) -> Span<T, N>;
template<typename T, ContainerSize N>
Span(Array<T, N>& values) -> Span<T, N>;
template<typename T, ContainerSize N>
Span(const Array<T, N>& values) -> Span<const T, N>;
template<typename T>
Span(Vector<T>& values) -> Span<T>;
template<typename T>
Span(const Vector<T>& values) -> Span<const T>;
