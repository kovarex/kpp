// Kpp standard library: the small containers. Deque<T> is a Vector that also pops at the front,
// the simplest thing that has the interface. (Map and Set are in Map.kpp.)

// A fixed-size array that knows its size (what std::array converts to).
template<typename T, int N>
struct Array
{
  T items[N];

  using iterator = T*;
  using const_iterator = const T*;
  using value_type = T;

  int size() const { return N; }
  bool empty() const { return N == 0; }
  T& operator[](int index) { return this->items[index]; }
  const T& operator[](int index) const { return this->items[index]; }
  T& at(int index) { return this->items[index]; }
  const T& at(int index) const { return this->items[index]; }
  T* data() { return this->items; }
  const T* data() const { return this->items; }
  T* begin() { return this->items; }
  T* end() { return this->items + N; }
  const T* begin() const { return this->items; }
  const T* end() const { return this->items + N; }
  T& front() { return this->items[0]; }
  T& back() { return this->items[N - 1]; }
  operator Span<T>() { return Span<T>(this->items, N); }
  operator Span<const T>() const { return Span<const T>(this->items, N); }
  void fill(const T& value)
  {
    for (int i = 0; i < N; ++i)
      this->items[i] = value;
  }
  bool operator==(const Array<T, N>& other) const
  {
    for (int i = 0; i < N; ++i)
      if (!(this->items[i] == other.items[i]))
        return false;
    return true;
  }
};

// A view of contiguous elements (what std::span converts to): a pointer and a count, over an
// array, a Vector, an Array or a String's characters.
template<typename T>
struct Span
{
  T* items = nullptr;
  int length = 0;

  using iterator = T*;
  using value_type = T;

  Span() {}
  Span(T* items, int length) : items(items), length(length) {}
  Span(T* first, T* last) : items(first), length(int(last - first)) {}
  template<int N>
  implicit Span(T (&a)[N]) : items(a), length(N) {}

  int size() const { return this->length; }
  bool empty() const { return this->length == 0; }
  T& operator[](int index) const { return this->items[index]; }
  T* data() const { return this->items; }
  T* begin() const { return this->items; }
  T* end() const { return this->items + this->length; }
  T& front() const { return this->items[0]; }
  T& back() const { return this->items[this->length - 1]; }
  Span<T> subspan(int offset, int count) const { return Span<T>(this->items + offset, count); }
  Span<T> subspan(int offset) const { return Span<T>(this->items + offset, this->length - offset); }
  Span<T> first(int count) const { return Span<T>(this->items, count); }
  Span<T> last(int count) const { return Span<T>(this->items + this->length - count, count); }
};

template<typename T>
struct Deque
{
  Vector<T> values;
  int head = 0; // index of the first live value

  int size() const { return this->values.size() - this->head; }
  bool empty() const { return this->size() == 0; }
  T& front() { return this->values.items[this->head]; }
  T& back() { return this->values.back(); }
  T& operator[](int index) { return this->values.items[this->head + index]; }
  T* begin() { return this->values.begin() + this->head; }
  T* end() { return this->values.end(); }

  void push_back(const T& value) { this->values.push_back(value); }
  void pop_back() { this->values.pop_back(); }
  void pop_front()
  {
    ++this->head;
    if (this->head > 32 && this->head * 2 > this->values.size())
    {
      // Slide the live values down so that the dead prefix does not grow forever.
      int live = this->values.size() - this->head;
      for (int i = 0; i < live; ++i)
        this->values.items[i] = this->values.items[this->head + i];
      while (this->values.size() > live)
        this->values.pop_back();
      this->head = 0;
    }
  }
  void push_front(const T& value)
  {
    if (this->head > 0)
    {
      --this->head;
      this->values.items[this->head] = value;
      return;
    }
    this->values.push_back(value);
    for (int k = this->values.size() - 1; k > 0; --k)
      this->values.items[k] = this->values.items[k - 1];
    this->values.items[0] = value;
  }
  void clear()
  {
    this->values.clear();
    this->head = 0;
  }
};

// A first-in, first-out queue: push at the back, pop at the front (std::queue over a deque).
template<typename T>
struct Queue
{
  Deque<T> values;

  int size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T& front() { return this->values.front(); }
  T& back() { return this->values.back(); }
  void push(const T& value) { this->values.push_back(value); }
  void pop() { this->values.pop_front(); }
  void clear()
  {
    while (!this->values.empty())
      this->values.pop_front();
  }
};
