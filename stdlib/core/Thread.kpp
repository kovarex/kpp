// kpp standard library: threads and what keeps them apart (what std::thread,
// std::this_thread, std::mutex, std::lock_guard, std::unique_lock, std::condition_variable and
// std::atomic convert to). Specified in docs/stdlib/thread.md (Atomic: docs/stdlib/atomic.md).
// Mutex, SharedMutex and ConditionVariable hold the platform's lock and condition variable
// (platform::Lock, SharedLock and Condition: an SRW lock and a CONDITION_VARIABLE on Windows,
// pthreads' elsewhere);
// Atomic<T> holds a T of 1, 2, 4 or 8 bytes (integers, floating point, enums, pointers, small
// structs) and works on its bits with the processor's atomic instructions; Atomic<SharedPtr<T>>
// takes a lock. The system calls are platform::'s (stdlib/platform).

// The compiler turns these into atomic instructions (sequentially consistent); they are not
// functions of any library.
extern "C" uint8_t kpp_atomic_add8(uint8_t* target, uint8_t value);
extern "C" uint8_t kpp_atomic_exchange8(uint8_t* target, uint8_t value);
extern "C" uint8_t kpp_atomic_cas8(uint8_t* target, uint8_t exchange, uint8_t comparand);
extern "C" uint8_t kpp_atomic_load8(const uint8_t* target);
extern "C" void kpp_atomic_store8(uint8_t* target, uint8_t value);
extern "C" uint16_t kpp_atomic_add16(uint16_t* target, uint16_t value);
extern "C" uint16_t kpp_atomic_exchange16(uint16_t* target, uint16_t value);
extern "C" uint16_t kpp_atomic_cas16(uint16_t* target, uint16_t exchange, uint16_t comparand);
extern "C" uint16_t kpp_atomic_load16(const uint16_t* target);
extern "C" void kpp_atomic_store16(uint16_t* target, uint16_t value);
extern "C" long kpp_atomic_add32(long* target, long value);
extern "C" long kpp_atomic_exchange32(long* target, long value);
extern "C" long kpp_atomic_cas32(long* target, long exchange, long comparand);
extern "C" long kpp_atomic_load32(const long* target);
extern "C" void kpp_atomic_store32(long* target, long value);
extern "C" long long kpp_atomic_add64(long long* target, long long value);
extern "C" long long kpp_atomic_exchange64(long long* target, long long value);
extern "C" long long kpp_atomic_cas64(long long* target, long long exchange, long long comparand);
extern "C" long long kpp_atomic_load64(const long long* target);
extern "C" void kpp_atomic_store64(long long* target, long long value);

// The arguments a Thread's function gets: the constructor's copies, given to the function as
// rvalues by invoke, in order.
template<typename... Ts>
struct ThreadArguments
{
  ThreadArguments() {}
  template<typename F, typename... Taken>
  void invokeWith(F& function, Taken&&... taken) { invoke(move(function), forward<Taken>(taken)...); }
};

template<typename T, typename... Rest>
struct ThreadArguments<T, Rest...>
{
  T value;
  ThreadArguments<Rest...> rest;
  ThreadArguments(T value, Rest... rest) : value(move(value)), rest(move(rest)...) {}
  template<typename F, typename... Taken>
  void invokeWith(F& function, Taken&&... taken) { this.rest.invokeWith(function, forward<Taken>(taken)..., move(this.value)); }
};

// What a new thread runs, on the heap: the function and its arguments, called once on the thread,
// then destroyed there.
template<typename F, typename... Args>
struct ThreadCall
{
  F function;
  ThreadArguments<Args...> arguments;
  ThreadCall(F function, Args... arguments) : function(move(function)), arguments(move(arguments)...) {}

  // (noexcept: an exception leaving the thread's function ends the program through the terminate
  // handler, from the search, as C++'s std::thread does)
  static platform::ThreadResult start(void* parameter) noexcept
  {
    ThreadCall<F, Args...>* call = (ThreadCall<F, Args...>*)parameter;
    call->arguments.invokeWith(call->function);
    delete call;
    return platform::threadDone;
  }
};

// A thread of execution (std::thread): joinable from its start until join() or detach(), which
// every Thread that started one must call; specified in docs/stdlib/thread.md.
class Thread
{
public:
  // A thread's identity (std::thread::id): the system's id of a thread of execution, or, when
  // default-constructed, no thread's. Equal for the same thread, ordered and hashable (hashOf).
  struct Id
  {
    unsigned long value = 0;

    Id() {}
    Id(unsigned long value) : value(value) {}
    strong_ordering operator<=>(const Id& other) const = default;
  };

  using id = Id;

  Thread() {}

  // Runs invoke(function, arguments...) on a new thread, with copies of them made here (decayed: a
  // function is its pointer, a reference argument a copy of the value; ref() passes a reference).
  // A pointer to a member function takes the object, or a pointer to it, first. Throws SystemError
  // (resource_unavailable_try_again) when the system cannot start a thread.
  template<typename F, typename... Args>
  Thread(F function, Args... arguments)
  {
    ThreadCall<F, Args...>* call = new ThreadCall<F, Args...>(move(function), move(arguments)...);
    unsigned long id = 0;
    this.handle = platform::startThread(&ThreadCall<F, Args...>::start, call, &id);
    if (!this.handle)
    {
      delete call;
      throw SystemError(make_error_code(Errc::resource_unavailable_try_again), "Thread");
    }
    this.threadId = Id(id);
  }

  Thread(const Thread&) = delete;

  Thread(Thread&& other) noexcept : handle(other.handle), threadId(other.threadId)
  {
    other.handle = nullptr;
    other.threadId = Id();
  }

  Thread& operator=(const Thread&) = delete;

  // A Thread still joinable here ends the program (std::thread calls std::terminate).
  Thread& operator=(Thread&& other) noexcept
  {
    release_assert(!this.joinable());
    this.handle = other.handle;
    this.threadId = other.threadId;
    other.handle = nullptr;
    other.threadId = Id();
    return this;
  }

  // A Thread still joinable here ends the program (std::thread calls std::terminate).
  ~Thread() { release_assert(!this.joinable()); }

  bool joinable() const { return this.handle != nullptr; }

  // Waits until the thread has finished; then the Thread is not joinable. Throws SystemError:
  // invalid_argument when it is not joinable, resource_deadlock_would_occur when it is the
  // calling thread.
  void join()
  {
    if (!this.joinable())
      throw SystemError(make_error_code(Errc::invalid_argument), "Thread::join");
    if (this.threadId == thisThread::getId())
      throw SystemError(make_error_code(Errc::resource_deadlock_would_occur), "Thread::join");
    platform::joinThread(this.handle);
    this.handle = nullptr;
    this.threadId = Id();
  }

  // Lets the thread run on its own; the Thread is not joinable any more. Throws SystemError
  // (invalid_argument) when it is not joinable.
  void detach()
  {
    if (!this.joinable())
      throw SystemError(make_error_code(Errc::invalid_argument), "Thread::detach");
    platform::detachThread(this.handle);
    this.handle = nullptr;
    this.threadId = Id();
  }

  void swap(Thread& other)
  {
    std::swap(this.handle, other.handle);
    std::swap(this.threadId, other.threadId);
  }

  // The thread's Id, or Id() when not joinable.
  Id getId() const { return this.threadId; }
  Id get_id() const { return this.threadId; }
  // The system's handle of the thread (a Windows HANDLE; elsewhere its pthread_t), or null when not
  // joinable.
  void* nativeHandle() const { return this.handle; }
  void* native_handle() const { return this.handle; }
  // How many threads can run at once: the machine's logical processors (on Windows in all its
  // processor groups; elsewhere those online) (std::thread::hardware_concurrency, which may also say 0
  // for "not known"; this never does).
  static u32 hardwareConcurrency() { return platform::processorCount(); }
  static u32 hardware_concurrency() { return Thread::hardwareConcurrency(); }

private:
  void* handle = nullptr;
  Id threadId;
};

usize hashOf(Thread::Id id) { return hashOf((u32)id.value); }

// The calling thread (what std::this_thread converts to).
namespace thisThread
{
  Thread::Id getId() { return Thread::Id(platform::currentThreadId()); }
  Thread::Id get_id() { return getId(); }
  // Lets another thread run (std::this_thread::yield).
  void yield() { platform::yield(); }

  // Blocks until t has passed on t's clock (std::this_thread::sleep_until): at least until then,
  // waking up early as Windows' timer or a signal may only to sleep again.
  template<typename Clock, typename Dur>
  void sleepUntil(const TimePoint<Clock, Dur>& t)
  {
    for (auto now = Clock::now(); now < t; now = Clock::now())
      platform::sleepFor(t - now);
  }

  template<typename Clock, typename Dur>
  void sleep_until(const TimePoint<Clock, Dur>& t) { sleepUntil(t); }
  // Blocks for at least d, on the steady clock (std::this_thread::sleep_for); a d of zero or less
  // returns at once.
  template<typename Rep, typename Period>
  void sleepFor(const Duration<Rep, Period>& d) { sleepUntil(SteadyClock::now() + d); }
  template<typename Rep, typename Period>
  void sleep_for(const Duration<Rep, Period>& d) { sleepFor(d); }
}

// A mutex (std::mutex): lock, unlock, tryLock; not re-entrant (a thread locking it again waits
// for itself forever).
class Mutex
{
public:
  Mutex() {}
  Mutex(const Mutex&) = delete;
  Mutex& operator=(const Mutex&) = delete;

  void lock() { this.lock_.lock(); }
  void unlock() { this.lock_.unlock(); }
  bool tryLock() { return this.lock_.tryLock(); }
  bool try_lock() { return this.tryLock(); }

private:
  friend class ConditionVariable; // waits on lock_
  platform::Lock lock_;
};

// A mutex its owning thread may lock again (std::recursive_mutex); every lock needs its unlock.
class RecursiveMutex
{
public:
  RecursiveMutex() {}
  RecursiveMutex(const RecursiveMutex&) = delete;
  RecursiveMutex& operator=(const RecursiveMutex&) = delete;

  void lock()
  {
    unsigned long self = platform::currentThreadId();
    if (this.owner.load() == self)
    {
      ++this.depth;
      return;
    }
    this.mutex.lock();
    this.owner.store(self);
    this.depth = 1;
  }

  bool tryLock()
  {
    unsigned long self = platform::currentThreadId();
    if (this.owner.load() == self)
    {
      ++this.depth;
      return true;
    }
    if (!this.mutex.tryLock())
      return false;
    this.owner.store(self);
    this.depth = 1;
    return true;
  }

  bool try_lock() { return this.tryLock(); }

  void unlock()
  {
    if (--this.depth == 0)
    {
      this.owner.store(0);
      this.mutex.unlock();
    }
  }

private:
  Mutex mutex;
  Atomic<unsigned long> owner; // the owning thread's id; 0 (never a thread's) when free
  i32 depth = 0;
};

// A mutex that many readers may hold at once, or one writer (std::shared_mutex).
class SharedMutex
{
public:
  SharedMutex() {}
  SharedMutex(const SharedMutex&) = delete;
  SharedMutex& operator=(const SharedMutex&) = delete;

  void lock() { this.lock_.lock(); }
  void unlock() { this.lock_.unlock(); }
  bool tryLock() { return this.lock_.tryLock(); }
  bool try_lock() { return this.tryLock(); }
  void lockShared() { this.lock_.lockShared(); }
  void unlockShared() { this.lock_.unlockShared(); }
  bool tryLockShared() { return this.lock_.tryLockShared(); }
  void lock_shared() { this.lockShared(); }
  void unlock_shared() { this.unlockShared(); }
  bool try_lock_shared() { return this.tryLockShared(); }

private:
  platform::SharedLock lock_;
};

// How a lock takes its mutex (std::defer_lock, std::try_to_lock, std::adopt_lock): not yet, by a
// try, or as already locked by the calling thread.
struct DeferLock {};
struct TryToLock {};
struct AdoptLock {};
const DeferLock deferLock;
const TryToLock tryToLock;
const AdoptLock adoptLock;

// Holds a mutex locked for its scope (std::lock_guard; also std::scoped_lock of one mutex).
template<typename M>
class LockGuard
{
public:
  LockGuard(M& mutex) : mutex(mutex) { mutex.lock(); }
  // Takes over a mutex the calling thread has locked.
  LockGuard(M& mutex, AdoptLock) : mutex(mutex) {}
  LockGuard(const LockGuard<M>&) = delete;
  LockGuard<M>& operator=(const LockGuard<M>&) = delete;
  ~LockGuard() { this.mutex.unlock(); }

private:
  M& mutex;
};

// One mutex of a ScopedLock's, its type erased: what the deadlock-avoiding lock walks over.
struct ScopedLockMutex
{
  void* mutex;
  void (*lock)(void*);
  bool (*tryLock)(void*);
  void (*unlock)(void*);
};

template<typename M>
ScopedLockMutex scopedLockMutexOf(M& mutex)
{
  return ScopedLockMutex{&mutex, [](void* m) { ((M*)m)->lock(); }, [](void* m) { return ((M*)m)->try_lock(); },
                         [](void* m) { ((M*)m)->unlock(); }};
}

// Locks all count mutexes without deadlock, as std::lock does: it waits for one and tries the
// others; when one is taken, it lets go of what it holds and waits for that one first next time.
void lockWithoutDeadlock(ScopedLockMutex* mutexes, ContainerSize count)
{
  if (count == 0)
    return;
  ContainerSize first = 0;
  while (true)
  {
    mutexes[first].lock(mutexes[first].mutex);
    ContainerSize failed = count;
    for (ContainerSize i = 1; i < count; ++i)
    {
      ContainerSize at = (first + i) % count;
      if (!mutexes[at].tryLock(mutexes[at].mutex))
      {
        failed = at;
        for (ContainerSize j = 0; j < i; ++j)
        {
          ContainerSize held = (first + j) % count;
          mutexes[held].unlock(mutexes[held].mutex);
        }
        break;
      }
    }
    if (failed == count)
      return;
    first = failed;
    thisThread::yield();
  }
}

// Holds several mutexes locked for its scope (std::scoped_lock): they are locked together without
// deadlock, whatever order other threads take them in, and unlocked at its end.
// `ScopedLock(adoptLock, m...)` takes over mutexes the calling thread holds.
template<typename... M>
class ScopedLock
{
public:
  ScopedLock(M&... mutexes)
  {
    this.take(mutexes...);
    lockWithoutDeadlock(this.held, sizeof...(M));
  }

  ScopedLock(AdoptLock, M&... mutexes) { this.take(mutexes...); }
  ScopedLock(const ScopedLock&) = delete;
  ScopedLock& operator=(const ScopedLock&) = delete;

  ~ScopedLock()
  {
    for (ContainerSize i = 0; i < sizeof...(M); ++i)
      this.held[i].unlock(this.held[i].mutex);
  }

private:
  void take(M&... mutexes)
  {
    ContainerSize i = 0;
    ((this.held[i++] = scopedLockMutexOf(mutexes)), ...);
  }

  ScopedLockMutex held[sizeof...(M) > 0 ? sizeof...(M) : 1]; // (one unused for no mutex: std::scoped_lock<> holds nothing)
};

// `ScopedLock lock(a, b)`: the mutexes' types (std::scoped_lock's deduction guides).
template<typename... M>
ScopedLock(M&...) -> ScopedLock<M...>;
template<typename... M>
ScopedLock(AdoptLock, M&...) -> ScopedLock<M...>;

// Of one mutex: a lock guard (M needs no try_lock).
template<typename M>
class ScopedLock<M>
{
public:
  using mutex_type = M;
  ScopedLock(M& mutex) : mutex(mutex) { mutex.lock(); }
  ScopedLock(AdoptLock, M& mutex) : mutex(mutex) {}
  ScopedLock(const ScopedLock<M>&) = delete;
  ScopedLock<M>& operator=(const ScopedLock<M>&) = delete;
  ~ScopedLock() { this.mutex.unlock(); }

private:
  M& mutex;
};

// A flag for callOnce (std::once_flag): not yet called, or called once to the end.
class OnceFlag
{
public:
  OnceFlag() {}
  OnceFlag(const OnceFlag&) = delete;
  OnceFlag& operator=(const OnceFlag&) = delete;

private:
  template<typename F, typename... Args> friend void callOnce(OnceFlag& flag, F&& f, Args&&... args);
  Atomic<i32> done;
  Mutex mutex;
};

// Calls f(args...) once for a flag (std::call_once): of the calls made with one flag, at once or
// one after another, one calls f, and each returns after that call has finished. A call of f that
// throws does not count: the exception reaches its caller, and the next callOnce calls f again.
template<typename F, typename... Args>
void callOnce(OnceFlag& flag, F&& f, Args&&... args)
{
  if (flag.done.load() != 0)
    return;
  LockGuard<Mutex> guard(flag.mutex);
  if (flag.done.load() != 0)
    return;
  invoke(forward<F>(f), forward<Args>(args)...);
  flag.done.store(1);
}

template<typename F, typename... Args>
void call_once(OnceFlag& flag, F&& f, Args&&... args) { callOnce(flag, forward<F>(f), forward<Args>(args)...); }

// A movable owner of a mutex's lock (std::unique_lock): it may own the lock or not, and unlocks
// at its end only what it owns. lock() and unlock() throw SystemError: operation_not_permitted
// without a mutex (unlock: without the lock), resource_deadlock_would_occur when the lock is
// already owned.
template<typename M>
class UniqueLock
{
public:
  UniqueLock() {}
  UniqueLock(M& mutex) : mutex_(&mutex), owns(true) { mutex.lock(); }
  UniqueLock(M& mutex, DeferLock) : mutex_(&mutex) {}
  UniqueLock(M& mutex, TryToLock) : mutex_(&mutex) { this.owns = mutex.try_lock(); }
  UniqueLock(M& mutex, AdoptLock) : mutex_(&mutex), owns(true) {}
  UniqueLock(const UniqueLock<M>&) = delete;
  UniqueLock<M>& operator=(const UniqueLock<M>&) = delete;

  UniqueLock(UniqueLock<M>&& other) noexcept : mutex_(other.mutex_), owns(other.owns)
  {
    other.mutex_ = nullptr;
    other.owns = false;
  }

  UniqueLock<M>& operator=(UniqueLock<M>&& other) noexcept
  {
    if (&this != &other)
    {
      if (this.owns)
        this.mutex_->unlock();
      this.mutex_ = other.mutex_;
      this.owns = other.owns;
      other.mutex_ = nullptr;
      other.owns = false;
    }
    return this;
  }

  ~UniqueLock()
  {
    if (this.owns)
      this.mutex_->unlock();
  }

  void lock()
  {
    this.checkLockable("UniqueLock::lock");
    this.mutex_->lock();
    this.owns = true;
  }

  bool tryLock()
  {
    this.checkLockable("UniqueLock::try_lock");
    this.owns = this.mutex_->try_lock();
    return this.owns;
  }

  bool try_lock() { return this.tryLock(); }

  void unlock()
  {
    if (!this.owns)
      throw SystemError(make_error_code(Errc::operation_not_permitted), "UniqueLock::unlock");
    this.mutex_->unlock();
    this.owns = false;
  }

  // Lets go of the mutex without unlocking it, and returns it.
  M* release()
  {
    M* mutex = this.mutex_;
    this.mutex_ = nullptr;
    this.owns = false;
    return mutex;
  }

  void swap(UniqueLock<M>& other)
  {
    std::swap(this.mutex_, other.mutex_);
    std::swap(this.owns, other.owns);
  }

  M* mutex() const { return this.mutex_; }
  bool ownsLock() const { return this.owns; }
  bool owns_lock() const { return this.owns; }
  operator bool() const { return this.owns; }

  void checkLockable(const char* what) const
  {
    if (!this.mutex_)
      throw SystemError(make_error_code(Errc::operation_not_permitted), what);
    if (this.owns)
      throw SystemError(make_error_code(Errc::resource_deadlock_would_occur), what);
  }

private:
  M* mutex_ = nullptr;
  bool owns = false;
};

// A movable owner of a mutex's shared lock (std::shared_lock): UniqueLock's shape, through the
// mutex's lockShared, tryLockShared and unlockShared.
template<typename M>
class SharedLock
{
public:
  SharedLock() {}
  SharedLock(M& mutex) : mutex_(&mutex), owns(true) { mutex.lockShared(); }
  SharedLock(M& mutex, DeferLock) : mutex_(&mutex) {}
  SharedLock(M& mutex, TryToLock) : mutex_(&mutex) { this.owns = mutex.tryLockShared(); }
  SharedLock(M& mutex, AdoptLock) : mutex_(&mutex), owns(true) {}
  SharedLock(const SharedLock<M>&) = delete;
  SharedLock<M>& operator=(const SharedLock<M>&) = delete;

  SharedLock(SharedLock<M>&& other) noexcept : mutex_(other.mutex_), owns(other.owns)
  {
    other.mutex_ = nullptr;
    other.owns = false;
  }

  SharedLock<M>& operator=(SharedLock<M>&& other) noexcept
  {
    if (&this != &other)
    {
      if (this.owns)
        this.mutex_->unlockShared();
      this.mutex_ = other.mutex_;
      this.owns = other.owns;
      other.mutex_ = nullptr;
      other.owns = false;
    }
    return this;
  }

  ~SharedLock()
  {
    if (this.owns)
      this.mutex_->unlockShared();
  }

  void lock()
  {
    this.checkLockable("SharedLock::lock");
    this.mutex_->lockShared();
    this.owns = true;
  }

  bool tryLock()
  {
    this.checkLockable("SharedLock::try_lock");
    this.owns = this.mutex_->tryLockShared();
    return this.owns;
  }

  bool try_lock() { return this.tryLock(); }

  void unlock()
  {
    if (!this.owns)
      throw SystemError(make_error_code(Errc::operation_not_permitted), "SharedLock::unlock");
    this.mutex_->unlockShared();
    this.owns = false;
  }

  M* release()
  {
    M* mutex = this.mutex_;
    this.mutex_ = nullptr;
    this.owns = false;
    return mutex;
  }

  void swap(SharedLock<M>& other)
  {
    std::swap(this.mutex_, other.mutex_);
    std::swap(this.owns, other.owns);
  }

  M* mutex() const { return this.mutex_; }
  bool ownsLock() const { return this.owns; }
  bool owns_lock() const { return this.owns; }
  operator bool() const { return this.owns; }

  void checkLockable(const char* what) const
  {
    if (!this.mutex_)
      throw SystemError(make_error_code(Errc::operation_not_permitted), what);
    if (this.owns)
      throw SystemError(make_error_code(Errc::resource_deadlock_would_occur), what);
  }

private:
  M* mutex_ = nullptr;
  bool owns = false;
};

// Whether a timed wait returned because its time ran out (std::cv_status).
enum class CvStatus { no_timeout, timeout };

// Waits of threads for a condition other threads make true (std::condition_variable), always
// with the predicate checked again under the lock: a wait may return without a notify (a spurious
// wake-up), so a wait without a predicate is followed by the caller's check. A timed wait returns
// timeout when its time has passed on its clock (wait_for: the steady clock).
class ConditionVariable
{
public:
  ConditionVariable() {}
  ConditionVariable(const ConditionVariable&) = delete;
  ConditionVariable& operator=(const ConditionVariable&) = delete;

  void notifyOne() { this.condition.notifyOne(); }
  void notifyAll() { this.condition.notifyAll(); }
  void notify_one() { this.notifyOne(); }
  void notify_all() { this.notifyAll(); }

  // Unlocks lock's mutex and blocks until notified (or woken spuriously), then locks it again.
  void wait(UniqueLock<Mutex>& lock) { this.condition.wait(lock.mutex()->lock_); }

  template<typename Predicate>
  void wait(UniqueLock<Mutex>& lock, Predicate ready)
  {
    while (!ready())
      this.wait(lock);
  }

  template<typename Clock, typename Dur>
  CvStatus waitUntil(UniqueLock<Mutex>& lock, const TimePoint<Clock, Dur>& t)
  {
    for (;;)
    {
      auto now = Clock::now();
      if (!(now < t))
        return CvStatus::timeout;
      if (this.condition.waitFor(lock.mutex()->lock_, t - now))
        return CvStatus::no_timeout; // woken: by a notify, or spuriously
      // The system's timer ended the wait, which can be a little before t on t's clock: the rest.
    }
  }

  // Waits until ready() or until t has passed; returns ready() at the end.
  template<typename Clock, typename Dur, typename Predicate>
  bool waitUntil(UniqueLock<Mutex>& lock, const TimePoint<Clock, Dur>& t, Predicate ready)
  {
    while (!ready())
      if (this.waitUntil(lock, t) == CvStatus::timeout)
        return ready();
    return true;
  }

  template<typename Rep, typename Period>
  CvStatus waitFor(UniqueLock<Mutex>& lock, const Duration<Rep, Period>& d) { return this.waitUntil(lock, SteadyClock::now() + d); }

  template<typename Rep, typename Period, typename Predicate>
  bool waitFor(UniqueLock<Mutex>& lock, const Duration<Rep, Period>& d, Predicate ready)
  {
    return this.waitUntil(lock, SteadyClock::now() + d, move(ready));
  }

  template<typename Clock, typename Dur>
  CvStatus wait_until(UniqueLock<Mutex>& lock, const TimePoint<Clock, Dur>& t) { return this.waitUntil(lock, t); }
  template<typename Clock, typename Dur, typename Predicate>
  bool wait_until(UniqueLock<Mutex>& lock, const TimePoint<Clock, Dur>& t, Predicate ready) { return this.waitUntil(lock, t, move(ready)); }
  template<typename Rep, typename Period>
  CvStatus wait_for(UniqueLock<Mutex>& lock, const Duration<Rep, Period>& d) { return this.waitFor(lock, d); }
  template<typename Rep, typename Period, typename Predicate>
  bool wait_for(UniqueLock<Mutex>& lock, const Duration<Rep, Period>& d, Predicate ready) { return this.waitFor(lock, d, move(ready)); }

private:
  platform::Condition condition;
};

// How an atomic operation orders the memory accesses around it (std::memory_order). Every Atomic
// operation is sequentially consistent, the strongest order, whichever is asked: each order is
// accepted where C++ takes one and gives at least what it promises.
enum class MemoryOrder
{
  relaxed,
  consume,
  acquire,
  release,
  acq_rel,
  seq_cst,
};

using memory_order = MemoryOrder;
const MemoryOrder memory_order_relaxed = MemoryOrder::relaxed;
const MemoryOrder memory_order_consume = MemoryOrder::consume;
const MemoryOrder memory_order_acquire = MemoryOrder::acquire;
const MemoryOrder memory_order_release = MemoryOrder::release;
const MemoryOrder memory_order_acq_rel = MemoryOrder::acq_rel;
const MemoryOrder memory_order_seq_cst = MemoryOrder::seq_cst;

// A fence (std::atomic_thread_fence, atomic_signal_fence): an atomic read-modify-write of a word of
// its own, which orders every access before it against every access after it, as a sequentially
// consistent fence; the call keeps the compiler from moving accesses across it too.
i32 atomicFenceWord = 0;
void atomicThreadFence([[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) { kpp_atomic_exchange32((long*)&atomicFenceWord, 0); }
void atomic_thread_fence(MemoryOrder order) { atomicThreadFence(order); }
void atomicSignalFence([[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) { kpp_atomic_exchange32((long*)&atomicFenceWord, 0); }
void atomic_signal_fence(MemoryOrder order) { atomicSignalFence(order); }

// The unsigned integer of each size the atomic instructions work on.
template<i32 size>
struct AtomicWord {};
template<> struct AtomicWord<1> { using Type = u8; };
template<> struct AtomicWord<2> { using Type = u16; };
template<> struct AtomicWord<4> { using Type = u32; };
template<> struct AtomicWord<8> { using Type = u64; };

// A T read and written atomically (sequentially consistent), for a T of 1, 2, 4 or 8 bytes that is
// copied by its bits: integers, bool, floating point, enums, pointers, small structs. The value is
// aligned to its size and moved through the integer of its size as bits, never converted; a
// compare-exchange compares bits. Arithmetic for integers (wrapping, as in C++) and floating point.
template<typename T>
struct Atomic
{
  static_assert(sizeof(T) == 1 || sizeof(T) == 2 || sizeof(T) == 4 || sizeof(T) == 8, "Atomic<T> needs a T of 1, 2, 4 or 8 bytes");
  using Word = typename AtomicWord<sizeof(T)>::Type;
  using value_type = T;

  alignas(sizeof(T)) T value;

  Atomic() : value(T()) {}
  implicit Atomic(T initial) : value(initial) {}
  Atomic(const Atomic<T>&) = delete;
  Atomic<T>& operator=(const Atomic<T>&) = delete;

  static Word wordOf(const T& v)
  {
    Word w = 0;
    memcpy(&w, &v, sizeof(T));
    return w;
  }

  static T valueOf(Word w)
  {
    T v;
    memcpy(&v, &w, sizeof(T));
    return v;
  }

  Word* word() const { return (Word*)&this.value; }

  T load() const noexcept
  {
    if constexpr (sizeof(T) == 8)
      return Atomic::valueOf((Word)kpp_atomic_load64((const i64*)this.word()));
    else if constexpr (sizeof(T) == 4)
      return Atomic::valueOf((Word)kpp_atomic_load32((const long*)this.word()));
    else if constexpr (sizeof(T) == 2)
      return Atomic::valueOf(kpp_atomic_load16((const u16*)this.word()));
    else
      return Atomic::valueOf(kpp_atomic_load8((const u8*)this.word()));
  }

  void store(T v) noexcept
  {
    Word w = Atomic::wordOf(v);
    if constexpr (sizeof(T) == 8)
      kpp_atomic_store64((i64*)this.word(), (i64)w);
    else if constexpr (sizeof(T) == 4)
      kpp_atomic_store32((long*)this.word(), (long)w);
    else if constexpr (sizeof(T) == 2)
      kpp_atomic_store16((u16*)this.word(), w);
    else
      kpp_atomic_store8((u8*)this.word(), w);
  }

  T exchange(T v) noexcept
  {
    Word w = Atomic::wordOf(v);
    if constexpr (sizeof(T) == 8)
      return Atomic::valueOf((Word)kpp_atomic_exchange64((i64*)this.word(), (i64)w));
    else if constexpr (sizeof(T) == 4)
      return Atomic::valueOf((Word)kpp_atomic_exchange32((long*)this.word(), (long)w));
    else if constexpr (sizeof(T) == 2)
      return Atomic::valueOf(kpp_atomic_exchange16((u16*)this.word(), w));
    else
      return Atomic::valueOf(kpp_atomic_exchange8((u8*)this.word(), w));
  }

  // True when the value had expected's bits and now has desired's; otherwise false, and expected
  // receives the current value.
  bool compareExchange(T& expected, T desired) noexcept
  {
    Word want = Atomic::wordOf(expected);
    Word next = Atomic::wordOf(desired);
    Word seen;
    if constexpr (sizeof(T) == 8)
      seen = (Word)kpp_atomic_cas64((i64*)this.word(), (i64)next, (i64)want);
    else if constexpr (sizeof(T) == 4)
      seen = (Word)kpp_atomic_cas32((long*)this.word(), (long)next, (long)want);
    else if constexpr (sizeof(T) == 2)
      seen = kpp_atomic_cas16((u16*)this.word(), next, want);
    else
      seen = kpp_atomic_cas8((u8*)this.word(), next, want);
    if (seen == want)
      return true;
    expected = Atomic::valueOf(seen);
    return false;
  }

  bool compare_exchange_strong(T& expected, T desired) noexcept { return this.compareExchange(expected, desired); }
  bool compare_exchange_weak(T& expected, T desired) noexcept { return this.compareExchange(expected, desired); }

  // The same with memory orders (each sequentially consistent: MemoryOrder).
  T load([[maybe_unused]] MemoryOrder order) const noexcept { return this.load(); }
  void store(T v, [[maybe_unused]] MemoryOrder order) noexcept { this.store(v); }
  T exchange(T v, [[maybe_unused]] MemoryOrder order) noexcept { return this.exchange(v); }
  bool compareExchange(T& expected, T desired, [[maybe_unused]] MemoryOrder order) noexcept { return this.compareExchange(expected, desired); }
  bool compareExchange(T& expected, T desired, [[maybe_unused]] MemoryOrder success, [[maybe_unused]] MemoryOrder failure) noexcept { return this.compareExchange(expected, desired); }
  bool compare_exchange_strong(T& expected, T desired, [[maybe_unused]] MemoryOrder order) noexcept { return this.compareExchange(expected, desired); }
  bool compare_exchange_strong(T& expected, T desired, [[maybe_unused]] MemoryOrder success, [[maybe_unused]] MemoryOrder failure) noexcept { return this.compareExchange(expected, desired); }
  bool compare_exchange_weak(T& expected, T desired, [[maybe_unused]] MemoryOrder order) noexcept { return this.compareExchange(expected, desired); }
  bool compare_exchange_weak(T& expected, T desired, [[maybe_unused]] MemoryOrder success, [[maybe_unused]] MemoryOrder failure) noexcept { return this.compareExchange(expected, desired); }
  void wait(T old, [[maybe_unused]] MemoryOrder order) const { this.wait(old); }

  // An integer's bits and-ed, or-ed or xor-ed with mask (std::atomic::fetch_and, fetch_or,
  // fetch_xor): the value before, one indivisible step (a compare-exchange loop).
  T fetchAnd(T mask) noexcept
    requires isIntegral<T> && !isSame<T, bool>
  {
    T seen = this.load();
    while (!this.compareExchange(seen, (T)(seen & mask)))
    {
    }
    return seen;
  }

  T fetchOr(T mask) noexcept
    requires isIntegral<T> && !isSame<T, bool>
  {
    T seen = this.load();
    while (!this.compareExchange(seen, (T)(seen | mask)))
    {
    }
    return seen;
  }

  T fetchXor(T mask) noexcept
    requires isIntegral<T> && !isSame<T, bool>
  {
    T seen = this.load();
    while (!this.compareExchange(seen, (T)(seen ^ mask)))
    {
    }
    return seen;
  }

  T fetch_and(T mask, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) noexcept requires isIntegral<T> && !isSame<T, bool> { return this.fetchAnd(mask); }
  T fetch_or(T mask, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) noexcept requires isIntegral<T> && !isSame<T, bool> { return this.fetchOr(mask); }
  T fetch_xor(T mask, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) noexcept requires isIntegral<T> && !isSame<T, bool> { return this.fetchXor(mask); }
  T operator&=(T mask) requires isIntegral<T> && !isSame<T, bool> { return (T)(this.fetchAnd(mask) & mask); }
  T operator|=(T mask) requires isIntegral<T> && !isSame<T, bool> { return (T)(this.fetchOr(mask) | mask); }

  T operator^=(T mask) requires isIntegral<T> && !isSame<T, bool> { return (T)(this.fetchXor(mask) ^ mask); }

  // A pointer moved by delta elements (std::atomic<T*>::fetch_add): the pointer before.
  T fetchAdd(i64 delta) noexcept
    requires isPointer<T>
  {
    i64 bytes = delta * (i64)sizeof(RemovePointer<T>);
    Word before = (Word)kpp_atomic_add64((i64*)this.word(), bytes);
    return Atomic::valueOf(before);
  }

  T fetchSub(i64 delta) noexcept requires isPointer<T> { return this.fetchAdd(-delta); }
  T fetch_add(i64 delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) noexcept requires isPointer<T> { return this.fetchAdd(delta); }
  T fetch_sub(i64 delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) noexcept requires isPointer<T> { return this.fetchAdd(-delta); }
  T operator++() requires isPointer<T> { return this.fetchAdd((i64)1) + 1; }
  T operator++(i32) requires isPointer<T> { return this.fetchAdd((i64)1); }
  T operator--() requires isPointer<T> { return this.fetchAdd((i64)-1) - 1; }
  T operator--(i32) requires isPointer<T> { return this.fetchAdd((i64)-1); }
  T operator+=(i64 delta) requires isPointer<T> { return this.fetchAdd(delta) + delta; }

  T operator-=(i64 delta) requires isPointer<T> { return this.fetchAdd(-delta) - delta; }

  // The value before adding delta.
  T fetchAdd(T delta) noexcept
    requires (!isPointer<T>)
  {
    if constexpr (isFloatingPoint<T>)
    {
      T seen = this.load();
      while (!this.compareExchange(seen, seen + delta))
      {
      }
      return seen;
    }
    else
    {
      Word w = Atomic::wordOf(delta);
      if constexpr (sizeof(T) == 8)
        return Atomic::valueOf((Word)kpp_atomic_add64((i64*)this.word(), (i64)w));
      else if constexpr (sizeof(T) == 4)
        return Atomic::valueOf((Word)kpp_atomic_add32((long*)this.word(), (long)w));
      else if constexpr (sizeof(T) == 2)
        return Atomic::valueOf(kpp_atomic_add16((u16*)this.word(), w));
      else
        return Atomic::valueOf(kpp_atomic_add8((u8*)this.word(), w));
    }
  }

  T fetch_add(T delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) noexcept requires (!isPointer<T>) { return this.fetchAdd(delta); }

  T fetchSub(T delta) noexcept
    requires (!isPointer<T>)
  {
    if constexpr (isFloatingPoint<T>)
      return this.fetchAdd(-delta);
    else
      return this.fetchAdd((T)(0 - delta));
  }

  T fetch_sub(T delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) noexcept requires (!isPointer<T>) { return this.fetchSub(delta); }
  bool is_lock_free() const { return true; }

  implicit operator T() const { return this.load(); }

  Atomic<T>& operator=(T v)
  {
    this.store(v);
    return this;
  }

  T operator++() requires (!isPointer<T>) { return this.fetchAdd(1) + 1; }
  T operator++(i32) requires (!isPointer<T>) { return this.fetchAdd(1); }
  T operator--() requires (!isPointer<T>) { return this.fetchSub(1) - 1; }
  T operator--(i32) requires (!isPointer<T>) { return this.fetchSub(1); }
  T operator+=(T delta) requires (!isPointer<T>) { return this.fetchAdd(delta) + delta; }
  T operator-=(T delta) requires (!isPointer<T>) { return this.fetchSub(delta) - delta; }
  bool operator==(T other) const { return this.load() == other; }

  // Blocks while the value's bits are old's (std::atomic::wait); a notify after a store that
  // changed them wakes it. Waiters and notifiers meet at the lock and condition variable of
  // atomicWaitSlot(this): the waiter checks the value and sleeps under the lock, the notifier
  // wakes under it, so a store and notify between the check and the sleep cannot be missed.
  void wait(T old) const
  {
    AtomicWaitSlot& slot = atomicWaitSlot(&this);
    Word oldWord = Atomic::wordOf(old);
    slot.lock.lock();
    while (Atomic::wordOf(this.load()) == oldWord)
      slot.condition.wait(slot.lock);
    slot.lock.unlock();
  }

  // Wakes the waiters on this Atomic. notifyOne wakes all of the slot's waiters too (each checks
  // its own value again and sleeps on), which C++'s "at least one" allows.
  void notifyOne() { atomicNotify(&this); }
  void notifyAll() { atomicNotify(&this); }
  void notify_one() { atomicNotify(&this); }
  void notify_all() { atomicNotify(&this); }

  // The same on a volatile Atomic, as std::atomic has each member (`volatile std::atomic<sig_atomic_t>` written
  // by a signal handler): each operation is atomic already, so volatile changes nothing it does.
  Atomic<T>& self() const volatile { return *const_cast<Atomic<T>*>(&this); }
  bool is_lock_free() const volatile { return true; }
  T load() const volatile noexcept { return this.self().load(); }
  T load([[maybe_unused]] MemoryOrder order) const volatile noexcept { return this.self().load(); }
  void store(T v) volatile noexcept { this.self().store(v); }
  void store(T v, [[maybe_unused]] MemoryOrder order) volatile noexcept { this.self().store(v); }
  T exchange(T v) volatile noexcept { return this.self().exchange(v); }
  T exchange(T v, [[maybe_unused]] MemoryOrder order) volatile noexcept { return this.self().exchange(v); }
  bool compareExchange(T& expected, T desired) volatile noexcept { return this.self().compareExchange(expected, desired); }
  bool compareExchange(T& expected, T desired, [[maybe_unused]] MemoryOrder order) volatile noexcept { return this.self().compareExchange(expected, desired); }

  bool compareExchange(T& expected, T desired, [[maybe_unused]] MemoryOrder success, [[maybe_unused]] MemoryOrder failure) volatile noexcept
  {
    return this.self().compareExchange(expected, desired);
  }

  bool compare_exchange_strong(T& expected, T desired) volatile noexcept { return this.self().compareExchange(expected, desired); }
  bool compare_exchange_strong(T& expected, T desired, [[maybe_unused]] MemoryOrder order) volatile noexcept { return this.self().compareExchange(expected, desired); }

  bool compare_exchange_strong(T& expected, T desired, [[maybe_unused]] MemoryOrder success, [[maybe_unused]] MemoryOrder failure) volatile noexcept
  {
    return this.self().compareExchange(expected, desired);
  }

  bool compare_exchange_weak(T& expected, T desired) volatile noexcept { return this.self().compareExchange(expected, desired); }
  bool compare_exchange_weak(T& expected, T desired, [[maybe_unused]] MemoryOrder order) volatile noexcept { return this.self().compareExchange(expected, desired); }

  bool compare_exchange_weak(T& expected, T desired, [[maybe_unused]] MemoryOrder success, [[maybe_unused]] MemoryOrder failure) volatile noexcept
  {
    return this.self().compareExchange(expected, desired);
  }

  T fetchAnd(T mask) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self().fetchAnd(mask); }
  T fetchOr(T mask) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self().fetchOr(mask); }
  T fetchXor(T mask) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self().fetchXor(mask); }
  T fetch_and(T mask, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self().fetchAnd(mask); }
  T fetch_or(T mask, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self().fetchOr(mask); }
  T fetch_xor(T mask, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self().fetchXor(mask); }
  T operator&=(T mask) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self() &= mask; }
  T operator|=(T mask) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self() |= mask; }
  T operator^=(T mask) volatile noexcept requires isIntegral<T> && !isSame<T, bool> { return this.self() ^= mask; }
  T fetchAdd(i64 delta) volatile noexcept requires isPointer<T> { return this.self().fetchAdd(delta); }
  T fetchSub(i64 delta) volatile noexcept requires isPointer<T> { return this.self().fetchAdd(-delta); }
  T fetch_add(i64 delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) volatile noexcept requires isPointer<T> { return this.self().fetchAdd(delta); }
  T fetch_sub(i64 delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) volatile noexcept requires isPointer<T> { return this.self().fetchAdd(-delta); }
  T operator+=(i64 delta) volatile noexcept requires isPointer<T> { return this.self() += delta; }
  T operator-=(i64 delta) volatile noexcept requires isPointer<T> { return this.self() -= delta; }
  T fetchAdd(T delta) volatile noexcept requires (!isPointer<T>) { return this.self().fetchAdd(delta); }
  T fetchSub(T delta) volatile noexcept requires (!isPointer<T>) { return this.self().fetchSub(delta); }
  T fetch_add(T delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) volatile noexcept requires (!isPointer<T>) { return this.self().fetchAdd(delta); }
  T fetch_sub(T delta, [[maybe_unused]] MemoryOrder order = MemoryOrder::seq_cst) volatile noexcept requires (!isPointer<T>) { return this.self().fetchSub(delta); }
  T operator+=(T delta) volatile noexcept requires (!isPointer<T>) { return this.self() += delta; }
  T operator-=(T delta) volatile noexcept requires (!isPointer<T>) { return this.self() -= delta; }
  T operator++() volatile noexcept { return ++this.self(); }
  T operator++(i32) volatile noexcept { return this.self()++; }
  T operator--() volatile noexcept { return --this.self(); }
  T operator--(i32) volatile noexcept { return this.self()--; }
  implicit operator T() const volatile noexcept { return this.self().load(); }

  T operator=(T v) volatile noexcept
  {
    this.self().store(v);
    return v;
  }

  bool operator==(T other) const volatile { return this.self().load() == other; }
  void wait(T old) const volatile { this.self().wait(old); }
  void wait(T old, [[maybe_unused]] MemoryOrder order) const volatile { this.self().wait(old); }
  void notifyOne() volatile { atomicNotify(&this.self()); }
  void notifyAll() volatile { atomicNotify(&this.self()); }
  void notify_one() volatile { atomicNotify(&this.self()); }
  void notify_all() volatile { atomicNotify(&this.self()); }
};

// The lock and condition variable that Atomic::wait sleeps on, one of 64 picked by the Atomic's
// address; Atomics that share one wake each other's waiters, who check their values again.
struct AtomicWaitSlot
{
  platform::Lock lock;
  platform::Condition condition;
};

AtomicWaitSlot atomicWaitSlots[64];
AtomicWaitSlot& atomicWaitSlot(const void* address) { return atomicWaitSlots[((u64)address >> 3) % 64]; }

void atomicNotify(const void* address)
{
  AtomicWaitSlot& slot = atomicWaitSlot(address);
  slot.lock.lock();
  slot.condition.notifyAll();
  slot.lock.unlock();
}
