// kpp standard library: String. A growable sequence of UTF-8 code units, always zero-terminated
// so that c_str() is free. One plain class: no character traits, no allocator parameter.
//
// 24 bytes with 32-bit sizes (32 with 64-bit ones, core/Sizes.kpp). Up to 22 (30) characters live
// in the object itself, so most names, keys and numbers never allocate; longer strings live in a
// heap block. The last byte tells which: the length of a small string, or largeMark. All-zero bytes
// are the empty string. Nothing points into the object, so a move is a copy of its bytes and two
// byte stores.
//
// At compile time String always uses the heap representation, because reading the inactive union
// member (the mark in smallChars while the heap fields are alive) is undefined behaviour in a
// constant evaluation. The `if consteval` branches below are that path; the program holds none of
// them, so its String is the same code and size as without them (design.md "isConstantEvaluated").
struct String
{
  // The object's bytes: the heap fields (a pointer and two sizes) and, after them, the mark byte.
  static const int objectBytes = 32;
  static const ContainerSize smallCapacity = objectBytes - 2;
  static const int markIndex = objectBytes - 1;
  static const int largeMark = 0x80;

  union
  {
    struct
    {
      char* heapChars;
      ContainerSize heapLength;
      ContainerSize heapCapacity; // characters that fit, not counting the terminating zero
    };
    char smallChars[String::objectBytes]; // [markIndex] is the length of a small string, or largeMark
  };

  using iterator = char*;
  using const_iterator = const char*;
  using value_type = char;
  using size_type = ContainerSize;
  using difference_type = ptrdiff_t;
  using reference = char&;
  using const_reference = const char&;
  using pointer = char*;
  using const_pointer = const char*;

  String() { this->becomeEmpty(); }
  implicit String(const char* text) { this->initialize(text, checkedSize(strlen(text), "string too long")); }
  implicit String(StringView text) { this->initialize(text.chars, text.byteCount); }
  String(const char* text, ContainerSize count) { this->initialize(text, count); }
  String(const char* first, const char* last) { this->initialize(first, checkedSize(last - first, "string too long")); }
  String(ContainerSize count, char c)
  {
    this->becomeEmpty();
    this->append(count, c);
  }
  String(const String& other)
  {
    if (other.isLarge())
      this->initialize(other.heapChars, other.heapLength);
    else
      memcpy(this->smallChars, other.smallChars, sizeof(String));
  }
  String(String&& other) noexcept
  {
    if consteval
    {
      this->heapChars = other.heapChars; // the heap fields taken, other left empty (see the top)
      this->heapLength = other.heapLength;
      this->heapCapacity = other.heapCapacity;
      other.becomeEmpty();
      return;
    }
    memcpy(this->smallChars, other.smallChars, sizeof(String));
    other.becomeEmpty();
  }
  ~String()
  {
    if (this->isLarge())
      free(this->heapChars);
  }

  String& operator=(const String& other)
  {
    if (this != &other)
      this->assign(other.data(), other.size());
    return *this;
  }
  String& operator=(String&& other) noexcept
  {
    if (this == &other)
      return *this;
    if (this->isLarge())
      free(this->heapChars);
    if consteval
    {
      this->heapChars = other.heapChars; // the heap fields taken, other left empty (see the top)
      this->heapLength = other.heapLength;
      this->heapCapacity = other.heapCapacity;
      other.becomeEmpty();
      return *this;
    }
    memcpy(this->smallChars, other.smallChars, sizeof(String));
    other.becomeEmpty();
    return *this;
  }

  // Not found, or to the end: the largest size, as C++'s npos is the largest size_t, so that a
  // search result compares with sizes as in C++ (`min(s.find(x), s.size())`).
  static const ContainerSize npos = ContainerSize(-1);

  bool isLarge() const
  {
    if consteval
    {
      return true; // (at compile time always: see the top)
    }
    return (uint8_t)this->smallChars[String::markIndex] == String::largeMark;
  }
  ContainerSize size() const { return this->isLarge() ? this->heapLength : ContainerSize((uint8_t)this->smallChars[String::markIndex]); }
  ContainerSize length() const { return this->size(); }
  // Characters that fit without allocating.
  ContainerSize capacity() const { return this->isLarge() ? this->heapCapacity : String::smallCapacity; }
  bool empty() const { return this->size() == 0; }
  const char* c_str() const { return this->data(); }
  // Its text, appended (design.md 14: the conversion every type has).
  void appendTo(String& out) const { out.append(this->data(), this->size()); }
  char* data() { return this->isLarge() ? this->heapChars : this->smallChars; }
  const char* data() const { return this->isLarge() ? this->heapChars : this->smallChars; }
  const char& operator[](ContainerSize index) const { return this->data()[index]; } // a reference, as std::string's: `&s[i]` of a const String
  // Throws OutOfRange for an index outside [0, size()).
  char& at(ContainerSize index)
  {
    if (index >= this->size())
      throwOutOfRange("String::at: index out of range");
    return this->data()[index];
  }
  const char& at(ContainerSize index) const
  {
    if (index >= this->size())
      throwOutOfRange("String::at: index out of range");
    return this->data()[index];
  }
  char& operator[](ContainerSize index) { return this->data()[index]; }
  char* begin() { return this->data(); }
  char* end() { return this->data() + this->size(); }
  // The bytes from the last to the first (ZipPackage's `*path.string().rbegin() == '/'`).
  ReverseIterator<char*> rbegin() { return ReverseIterator<char*>(this->end()); }
  ReverseIterator<char*> rend() { return ReverseIterator<char*>(this->begin()); }
  ReverseIterator<const char*> rbegin() const { return ReverseIterator<const char*>(this->end()); }
  ReverseIterator<const char*> rend() const { return ReverseIterator<const char*>(this->begin()); }
  ReverseIterator<const char*> crbegin() const { return this->rbegin(); }
  ReverseIterator<const char*> crend() const { return this->rend(); }
  const char* begin() const { return this->data(); }
  const char* end() const { return this->data() + this->size(); }
  const char* cbegin() const { return this->data(); }
  const char* cend() const { return this->data() + this->size(); }
  char& back() { return this->data()[this->size() - 1]; }
  const char& back() const { return this->data()[this->size() - 1]; }
  char& front() { return this->data()[0]; }
  const char& front() const { return this->data()[0]; }

  void push_back(char c) { this->append(c); }
  void pop_back()
  {
    ContainerSize length = this->size();
    if (length > 0)
      this->setLength(length - 1);
  }
  void resize(ContainerSize newLength, char fill)
  {
    ContainerSize length = this->size();
    if (newLength > length)
    {
      this->reserve(newLength);
      memset(this->data() + length, fill, newLength - length);
    }
    this->setLength(newLength);
  }
  void resize(ContainerSize newLength) { this->resize(newLength, 0); }
  // Removes count bytes at index (to the end when count is npos or reaches past it); throws
  // OutOfRange when index is past the end. Returns the string.
  // The index takes any integer type, so that a literal 0 is the index, not a null position (with a
  // ContainerSize parameter `s.erase(0)` would be ambiguous with erase(char* at)).
  template<typename I> requires (isIntegral<I>)
  String& erase(I index, ContainerSize count)
  {
    ContainerSize length = this->size();
    if (index > length)
      throwOutOfRange("String::erase: index out of range");
    if (index == length)
      return *this;
    if (count > length - index)
      count = length - index;
    char* chars = this->data();
    memmove(chars + index, chars + index + count, length - index - count);
    this->setLength(length - count);
    return *this;
  }
  template<typename I> requires (isIntegral<I>)
  String& erase(I index) { return this->erase(index, npos); }
  // The range [first, last) of this string's characters (begin()/end() and what find functions
  // return); returns where the character after them is now.
  char* erase(char* first, char* last)
  {
    ContainerSize index = ContainerSize(first - this->data());
    this->erase(index, ContainerSize(last - first));
    return this->data() + index;
  }
  char* erase(char* at)
  {
    ContainerSize index = ContainerSize(at - this->data());
    this->erase(index, 1);
    return this->data() + index;
  }
  String& insert(ContainerSize index, const char* text, ContainerSize count)
  {
    if (count == 0)
      return *this;
    ContainerSize length = this->size();
    ContainerSize newLength = sizeSum(length, count, "string too long"); // before a byte is copied
    if (index > length)
      index = length;
    const char* chars = this->data();
    if (text >= chars && text < chars + length)
    {
      // Inserting part of this string into itself: copy it out before the characters move.
      String copy(text, count);
      return this->insert(index, copy.data(), count);
    }
    this->ensureRoom(newLength);
    char* target = this->data();
    memmove(target + index + count, target + index, length - index);
    memcpy(target + index, text, count);
    this->setLength(length + count);
    return *this;
  }
  String& insert(ContainerSize index, const char* text) { return this->insert(index, text, checkedSize(strlen(text), "string too long")); }
  // Inserts [first, last) before the character position points at.
  char* insert(char* position, const char* first, const char* last)
  {
    ContainerSize index = ContainerSize(position - this->data());
    this->insert(index, first, checkedSize(last - first, "string too long"));
    return this->data() + index;
  }
  String& insert(ContainerSize index, const String& text) { return this->insert(index, text.data(), text.size()); }
  // Inserts count copies of c at index.
  String& insert(ContainerSize index, ContainerSize count, char c)
  {
    if (count == 0)
      return *this;
    ContainerSize length = this->size();
    if (index > length)
      index = length;
    this->ensureRoom(sizeSum(length, count, "string too long"));
    char* chars = this->data();
    memmove(chars + index + count, chars + index, length - index);
    memset(chars + index, c, count);
    this->setLength(length + count);
    return *this;
  }
  // Replaces count bytes at index with text; returns the string.
  String& replace(ContainerSize index, ContainerSize count, const char* text)
  {
    ContainerSize textLength = checkedSize(strlen(text), "string too long");
    this->checkReplacement(index, count, textLength);
    this->erase(index, count);
    return this->insert(index, text, textLength);
  }
  String& replace(ContainerSize index, ContainerSize count, const String& text)
  {
    this->checkReplacement(index, count, text.size());
    this->erase(index, count);
    return this->insert(index, text);
  }

  // Searching. Every find returns the index of the first match at or after `from`, or npos.
  ContainerSize find(const char* needle, ContainerSize from) const
  {
    size_t count = strlen(needle);
    return count > (size_t)maxContainerSize ? npos : this->findBytes(needle, (ContainerSize)count, from);
  }
  ContainerSize find(const char* needle) const { return this->find(needle, 0); }
  ContainerSize find(const String& needle) const { return this->findBytes(needle.data(), needle.size(), 0); }
  ContainerSize find(const String& needle, ContainerSize from) const { return this->findBytes(needle.data(), needle.size(), from); }
  ContainerSize find(char c, ContainerSize from) const
  {
    ContainerSize length = this->size();
    if (from >= length)
      return npos;
    const char* chars = this->data();
    const char* at = (const char*)memchr(chars + from, c, length - from);
    return at ? ContainerSize(at - chars) : npos;
  }
  ContainerSize find(char c) const { return this->find(c, 0); }
  // memchr finds candidates for the first byte, memcmp checks the rest.
  ContainerSize findBytes(const char* needle, ContainerSize count, ContainerSize from) const
  {
    ContainerSize length = this->size();
    if (count == 0)
      return from <= length ? from : npos;
    if (count > length || from > length - count)
      return npos;
    const char* chars = this->data();
    const char* lastStart = chars + length - count;
    const char* at = chars + from;
    while (at <= lastStart)
    {
      at = (const char*)memchr(at, needle[0], lastStart - at + 1);
      if (!at)
        return npos;
      if (memcmp(at + 1, needle + 1, count - 1) == 0)
        return ContainerSize(at - chars);
      ++at;
    }
    return npos;
  }
  // The last occurrence starting at or before `from` (anywhere when from is npos), or npos. The
  // index counts down to 0 and stops there (a size cannot go below it).
  ContainerSize rfind(char c, ContainerSize from) const
  {
    ContainerSize length = this->size();
    if (length == 0)
      return npos;
    const char* chars = this->data();
    for (ContainerSize i = from < length - 1 ? from : length - 1;; --i)
    {
      if (chars[i] == c)
        return i;
      if (i == 0)
        return npos;
    }
  }
  ContainerSize rfind(char c) const { return this->rfind(c, npos); }
  ContainerSize rfindBytes(const char* needle, ContainerSize count, ContainerSize from) const
  {
    ContainerSize length = this->size();
    if (count > length)
      return npos;
    const char* chars = this->data();
    for (ContainerSize i = from < length - count ? from : length - count;; --i)
    {
      if (memcmp(chars + i, needle, count) == 0)
        return i;
      if (i == 0)
        return npos;
    }
  }
  ContainerSize rfind(const char* needle, ContainerSize from) const
  {
    size_t count = strlen(needle);
    return count > (size_t)maxContainerSize ? npos : this->rfindBytes(needle, (ContainerSize)count, from);
  }
  ContainerSize rfind(const char* needle) const { return this->rfind(needle, npos); }
  ContainerSize rfind(const String& needle, ContainerSize from) const { return this->rfindBytes(needle.data(), needle.size(), from); }
  ContainerSize rfind(const String& needle) const { return this->rfindBytes(needle.data(), needle.size(), npos); }
  // The last byte that is in set, or npos.
  ContainerSize find_last_of(const char* set) const
  {
    const char* chars = this->data();
    for (ContainerSize i = this->size(); i-- > 0;)
      if (String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  ContainerSize find_last_of(const String& set) const { return this->find_last_of(set.c_str()); }
  ContainerSize find_last_of(char c) const { return this->rfind(c); }
  // Up to count bytes from pos into dest; the number copied. OutOfRange when pos > size().
  uint64_t copy(char* dest, uint64_t count, uint64_t pos = 0) const
  {
    ContainerSize length = this->size();
    if (pos > (uint64_t)length)
      throwOutOfRange("String::copy: position out of range");
    uint64_t available = (uint64_t)length - pos;
    if (count > available)
      count = available;
    memcpy(dest, this->data() + pos, count);
    return count;
  }
  // Negative, zero or positive as this string orders before, equal to or after other (byte-wise,
  // as operator<).
  int compare(const String& other) const
  {
    ContainerSize length = this->size(), otherLength = other.size();
    int c = memcmp(this->data(), other.data(), length < otherLength ? length : otherLength);
    if (c != 0)
      return c;
    return length < otherLength ? -1 : length > otherLength ? 1 : 0;
  }
  int compare(const char* other) const { return this->compare(String(other)); }
  void swap(String& other)
  {
    String held(move(other));
    other = move(*this);
    *this = move(held);
  }
  static bool oneOf(char c, const char* set)
  {
    for (size_t i = 0; set[i] != 0; ++i)
      if (set[i] == c)
        return true;
    return false;
  }
  ContainerSize find_first_of(char c) const { return this->find(c); }
  ContainerSize find_first_of(char c, ContainerSize from) const { return this->find(c, from); }
  ContainerSize find_first_of(StringView set, ContainerSize from) const
  {
    const char* chars = this->data();
    ContainerSize length = this->size();
    for (ContainerSize i = from; i < length; ++i)
      for (ContainerSize k = 0; k < set.byteCount; ++k)
        if (chars[i] == set.chars[k])
          return i;
    return npos;
  }
  ContainerSize find_first_of(StringView set) const { return this->find_first_of(set, 0); }
  ContainerSize find_first_of(const String& set) const { return this->find_first_of(set.c_str()); }
  ContainerSize find_first_not_of(const String& set) const { return this->find_first_not_of(set.c_str()); }
  ContainerSize find_last_not_of(const String& set) const { return this->find_last_not_of(set.c_str()); }
  ContainerSize find_first_of(const char* set) const
  {
    const char* chars = this->data();
    ContainerSize length = this->size();
    for (ContainerSize i = 0; i < length; ++i)
      if (String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  ContainerSize find_first_not_of(const char* set) const
  {
    const char* chars = this->data();
    ContainerSize length = this->size();
    for (ContainerSize i = 0; i < length; ++i)
      if (!String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  // The first (last) byte other than c (LocaleStringReplacer's `find_first_not_of('0')`).
  ContainerSize find_first_not_of(char c) const
  {
    const char* chars = this->data();
    ContainerSize length = this->size();
    for (ContainerSize i = 0; i < length; ++i)
      if (chars[i] != c)
        return i;
    return npos;
  }
  ContainerSize find_last_not_of(char c) const
  {
    const char* chars = this->data();
    for (ContainerSize i = this->size(); i-- > 0;)
      if (chars[i] != c)
        return i;
    return npos;
  }
  ContainerSize find_last_not_of(const char* set) const
  {
    const char* chars = this->data();
    for (ContainerSize i = this->size(); i-- > 0;)
      if (!String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  bool startsWith(const String& prefix) const
  {
    ContainerSize count = prefix.size();
    return count <= this->size() && memcmp(this->data(), prefix.data(), count) == 0;
  }
  bool endsWith(const String& suffix) const
  {
    ContainerSize count = suffix.size(), length = this->size();
    return count <= length && memcmp(this->data() + length - count, suffix.data(), count) == 0;
  }
  // C++20's starts_with and ends_with: of a text (a String, a StringView, a literal) or of a char.
  bool starts_with(StringView prefix) const { return StringView(*this).startsWith(prefix); }
  bool starts_with(char c) const { return !this->empty() && this->front() == c; }
  bool ends_with(StringView suffix) const { return StringView(*this).endsWith(suffix); }
  bool ends_with(char c) const { return !this->empty() && this->back() == c; }

  bool operator==(const String& other) const
  {
    ContainerSize length = this->size();
    return length == other.size() && memcmp(this->data(), other.data(), length) == 0;
  }
  bool operator!=(const String& other) const { return !(*this == other); }
  bool operator==(const char* other) const
  {
    ContainerSize length = this->size();
    return strlen(other) == (size_t)length && memcmp(this->data(), other, length) == 0;
  }
  bool operator!=(const char* other) const { return !(*this == other); }
  bool operator<(const String& other) const
  {
    ContainerSize length = this->size(), otherLength = other.size();
    int c = memcmp(this->data(), other.data(), length < otherLength ? length : otherLength);
    return c != 0 ? c < 0 : length < otherLength;
  }
  // Byte-wise as <: gives >, <= and >= with a String or a const char* (and `"x" < s` below).
  strong_ordering operator<=>(const String& other) const { return strong_ordering(signOf(this->compare(other))); }
  strong_ordering operator<=>(const char* other) const { return strong_ordering(signOf(this->compare(other))); }
  static int8_t signOf(int compared) { return compared < 0 ? -1 : compared > 0 ? 1 : 0; }

  // Makes room for `needed` characters (exactly: growth by appending is geometric); LengthError
  // past maxContainerSize.
  void reserve(ContainerSize needed)
  {
    if (needed > maxContainerSize)
      throwLengthError("string too long");
    if (needed > this->capacity())
      this->reallocate(needed);
  }

  // Replaces the contents with count bytes (which may be part of this string); returns the string.
  String& assign(const char* bytes, ContainerSize count)
  {
    if (count <= this->capacity())
    {
      memmove(this->data(), bytes, count);
      this->setLength(count);
      return *this;
    }
    if (count > maxContainerSize)
      throwLengthError("string too long");
    char* block = allocateArray<char>((unsigned long long)count + 1);
    memcpy(block, bytes, count);
    block[count] = 0;
    this->adopt(block, count, count);
    return *this;
  }
  // The other forms of std::string's assign: the bytes of [first, last) (TCPSocket's
  // `result.assign(buffer, buffer + received)`), a C string, another String, count copies of c.
  String& assign(const char* first, const char* last) { return this->assign(first, checkedSize(last - first, "string too long")); }
  String& assign(const char* text) { return this->assign(text, checkedSize(strlen(text), "string too long")); }
  String& assign(const String& other) { return this->assign(other.data(), other.size()); }
  String& assign(ContainerSize count, char c)
  {
    this->clear();
    this->append(count, c);
    return *this;
  }

  // The appends return the string.
  String& append(const char* bytes, ContainerSize count)
  {
    if (count == 0)
      return *this;
    ContainerSize length = this->size();
    if (count > this->capacity() - length) // (length + count could wrap)
    {
      this->appendGrowing(bytes, count);
      return *this;
    }
    memcpy(this->data() + length, bytes, count);
    this->setLength(length + count);
    return *this;
  }
  String& append(const char* text) { return this->append(text, checkedSize(strlen(text), "string too long")); }
  // The bytes of [first, last) (cxxopts' `s.append(begin, end)`).
  String& append(const char* first, const char* last) { return this->append(first, checkedSize(last - first, "string too long")); }
  String& append(const String& other) { return this->append(other.data(), other.size()); }
  // Appends count copies of c.
  String& append(ContainerSize count, char c)
  {
    if (count == 0)
      return *this;
    ContainerSize length = this->size();
    this->ensureRoom(sizeSum(length, count, "string too long"));
    memset(this->data() + length, c, count);
    this->setLength(length + count);
    return *this;
  }
  // Appends count characters of other from index (fewer when other ends before, npos for all).
  String& append(const String& other, ContainerSize index, ContainerSize count)
  {
    ContainerSize otherLength = other.size();
    if (index >= otherLength)
      return *this;
    if (count > otherLength - index)
      count = otherLength - index;
    return this->append(other.data() + index, count);
  }
  String& append(char c)
  {
    if (this->isLarge())
    {
      ContainerSize length = this->heapLength;
      if (length < this->heapCapacity)
      {
        this->heapChars[length] = c;
        this->heapChars[length + 1] = 0;
        this->heapLength = length + 1;
        return *this;
      }
    }
    else
    {
      ContainerSize length = ContainerSize((uint8_t)this->smallChars[String::markIndex]);
      if (length < String::smallCapacity)
      {
        this->smallChars[length] = c;
        this->smallChars[length + 1] = 0;
        this->smallChars[String::markIndex] = (char)(length + 1);
        return *this;
      }
    }
    this->appendGrowing(&c, 1);
    return *this;
  }

  // (No +=: `<<` is String's one append, design.md 14, Format.kpp's operator<<.)
  String operator+(const String& other) const
  {
    String result;
    result.reserve(sizeSum(this->size(), other.size(), "string too long"));
    result.append(*this);
    result.append(other);
    return result;
  }
  String operator+(const char* text) const
  {
    String result;
    result.reserve(sizeSum(this->size(), strlen(text), "string too long"));
    result.append(*this);
    result.append(text);
    return result;
  }

  // count characters from start (all the rest when count is npos or runs past the end); throws
  // OutOfRange when start is past the end.
  String substr(ContainerSize start, ContainerSize count) const
  {
    ContainerSize length = this->size();
    if (start > length)
      throwOutOfRange("String::substr: start out of range");
    if (start == length)
      return String();
    ContainerSize available = length - start;
    return String(this->data() + start, count < available ? count : available);
  }
  String substr(ContainerSize start) const { return this->substr(start, npos); }
  // Empties the string; the capacity stays.
  void clear() { this->setLength(0); }

  // Internals.
  void becomeEmpty()
  {
    if consteval
    {
      this->initialize("", 0); // a heap block holding the terminator
      return;
    }
    this->smallChars[0] = 0;
    this->smallChars[String::markIndex] = 0;
  }
  // Construction from count bytes.
  void initialize(const char* bytes, ContainerSize count)
  {
    if consteval
    {
      // The heap representation, also for an empty or a short string (see the top).
      ContainerSize length = count;
      char* block = (char*)malloc(length + 1);
      memcpy(block, bytes, length);
      block[length] = 0;
      this->heapChars = block;
      this->heapLength = length;
      this->heapCapacity = length;
      return;
    }
    if (count == 0)
    {
      this->becomeEmpty();
      return;
    }
    if (count <= String::smallCapacity)
    {
      memcpy(this->smallChars, bytes, count);
      this->smallChars[count] = 0;
      this->smallChars[String::markIndex] = (char)count;
      return;
    }
    if (count > maxContainerSize)
      throwLengthError("string too long");
    char* block = allocateArray<char>((unsigned long long)count + 1);
    memcpy(block, bytes, count);
    block[count] = 0;
    this->heapChars = block;
    this->heapLength = count;
    this->heapCapacity = count;
    this->smallChars[String::markIndex] = (char)String::largeMark;
  }
  // Sets the length and writes the terminating zero after it.
  void setLength(ContainerSize length)
  {
    if (this->isLarge())
    {
      this->heapLength = length;
      this->heapChars[length] = 0;
    }
    else
    {
      this->smallChars[length] = 0;
      this->smallChars[String::markIndex] = (char)length;
    }
  }
  // Takes block (holding length characters and their terminator, room for capacity) as the storage.
  void adopt(char* block, ContainerSize length, ContainerSize capacity)
  {
    if (this->isLarge())
      free(this->heapChars);
    this->heapChars = block;
    this->heapLength = length;
    this->heapCapacity = capacity;
    if !consteval
    {
      this->smallChars[String::markIndex] = (char)String::largeMark; // (no mark at compile time: see the top)
    }
  }
  // Moves the characters into a heap block with room for newCapacity. Out of line, like every
  // growth path, so that the fast paths around it stay small enough to inline.
  [[noinline]] void reallocate(ContainerSize newCapacity)
  {
    ContainerSize length = this->size();
    char* block = allocateArray<char>((unsigned long long)newCapacity + 1);
    memcpy(block, this->data(), length + 1);
    this->adopt(block, length, newCapacity);
  }
  // Geometric growth: appending n characters one by one costs O(n) in total. At most
  // maxContainerSize (core/Sizes.kpp).
  void ensureRoom(ContainerSize needed)
  {
    ContainerSize capacity = this->capacity();
    if (needed > capacity)
      this->reallocate(grownCapacity(capacity, needed, 0, "string too long"));
  }
  // replace's size, checked before it erases: LengthError leaves the string as it was.
  void checkReplacement(ContainerSize index, ContainerSize count, ContainerSize textLength) const
  {
    ContainerSize length = this->size();
    if (index > length)
      return; // erase throws OutOfRange
    ContainerSize removed = count > length - index ? length - index : count;
    sizeSum(length - removed, textLength, "string too long");
  }
  // append() when the characters do not fit: bytes may point into this string, so the old block
  // is released only after they are copied.
  [[noinline]] void appendGrowing(const char* bytes, ContainerSize count)
  {
    ContainerSize length = this->size(), capacity = this->capacity();
    ContainerSize newLength = sizeSum(length, count, "string too long");
    ContainerSize newCapacity = grownCapacity(capacity, newLength, 0, "string too long");
    char* block = allocateArray<char>((unsigned long long)newCapacity + 1);
    memcpy(block, this->data(), length);
    memcpy(block + length, bytes, count);
    block[newLength] = 0;
    this->adopt(block, newLength, newCapacity);
  }
};

// A const char* on the left of an ordering comparison with a String (`"b" < name`), byte-wise as
// String's own.
bool operator<(const char* left, const String& right) { return right.compare(left) > 0; }
bool operator>(const char* left, const String& right) { return right.compare(left) < 0; }
bool operator<=(const char* left, const String& right) { return right.compare(left) >= 0; }
bool operator>=(const char* left, const String& right) { return right.compare(left) <= 0; }

String operator+(const char* left, const String& right)
{
  ContainerSize leftLength = checkedSize(strlen(left), "string too long");
  String result;
  result.reserve(sizeSum(leftLength, right.size(), "string too long"));
  result.append(left, leftLength);
  result.append(right);
  return result;
}
