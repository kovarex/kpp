// Kpp standard library: String. A growable sequence of UTF-8 code units, always zero-terminated
// so that c_str() is free. One plain class: no character traits, no allocator parameter.
//
// 24 bytes. Up to 22 characters live in the object itself, so most names, keys and numbers never
// allocate; longer strings live in a heap block. The last byte tells which: the length of a small
// string, or largeMark. All-zero bytes are the empty string. Nothing points into the object, so a
// move is a 24-byte copy and two byte stores.
struct String
{
  union
  {
    struct
    {
      char* heapChars;
      int heapLength;
      int heapCapacity; // characters that fit, not counting the terminating zero
    };
    char smallChars[24]; // [markIndex] is the length of a small string, or largeMark
  };

  static const int smallCapacity = 22;
  static const int markIndex = 23;
  static const int largeMark = 0x80;

  using iterator = char*;
  using const_iterator = const char*;
  using value_type = char;
  using size_type = int;
  using difference_type = ptrdiff_t;
  using reference = char&;
  using const_reference = const char&;
  using pointer = char*;
  using const_pointer = const char*;

  String() { this->becomeEmpty(); }
  implicit String(const char* text) { this->initialize(text, (int)strlen(text)); }
  implicit String(StringView text) { this->initialize(text.chars, text.byteCount); }
  String(const char* text, int count) { this->initialize(text, count); }
  String(const char* first, const char* last) { this->initialize(first, int(last - first)); }
  String(int count, char c)
  {
    this->becomeEmpty();
    this->append(count, c);
  }
  String(const String& other)
  {
    if (other.isLarge())
      this->initialize(other.heapChars, other.heapLength);
    else
      memcpy(this->smallChars, other.smallChars, sizeof(String));
  }
  String(String&& other)
  {
    memcpy(this->smallChars, other.smallChars, sizeof(String));
    other.becomeEmpty();
  }
  ~String()
  {
    if (this->isLarge())
      free(this->heapChars);
  }

  String& operator=(const String& other)
  {
    if (this != &other)
      this->assign(other.data(), other.size());
    return *this;
  }
  String& operator=(String&& other)
  {
    if (this == &other)
      return *this;
    if (this->isLarge())
      free(this->heapChars);
    memcpy(this->smallChars, other.smallChars, sizeof(String));
    other.becomeEmpty();
    return *this;
  }

  // Not found, or to the end: the largest int, as C++'s npos is the largest size_t, so that a
  // search result compares with sizes as in C++ (`min(s.find(x), s.size())`).
  static const int npos = 2147483647;

  bool isLarge() const { return (uint8_t)this->smallChars[String::markIndex] == String::largeMark; }
  int size() const { return this->isLarge() ? this->heapLength : (int)this->smallChars[String::markIndex]; }
  int length() const { return this->size(); }
  // Characters that fit without allocating.
  int capacity() const { return this->isLarge() ? this->heapCapacity : String::smallCapacity; }
  bool empty() const { return this->size() == 0; }
  const char* c_str() const { return this->data(); }
  char* data() { return this->isLarge() ? this->heapChars : this->smallChars; }
  const char* data() const { return this->isLarge() ? this->heapChars : this->smallChars; }
  const char& operator[](int index) const { return this->data()[index]; } // a reference, as std::string's: `&s[i]` of a const String
  // Throws OutOfRange for an index outside [0, size()).
  char& at(int index)
  {
    if (index < 0 || index >= this->size())
      throwOutOfRange("String::at: index out of range");
    return this->data()[index];
  }
  const char& at(int index) const
  {
    if (index < 0 || index >= this->size())
      throwOutOfRange("String::at: index out of range");
    return this->data()[index];
  }
  char& operator[](int index) { return this->data()[index]; }
  char* begin() { return this->data(); }
  char* end() { return this->data() + this->size(); }
  // The bytes from the last to the first (ZipPackage's `*path.string().rbegin() == '/'`).
  ReverseIterator<char*> rbegin() { return ReverseIterator<char*>(this->end()); }
  ReverseIterator<char*> rend() { return ReverseIterator<char*>(this->begin()); }
  ReverseIterator<const char*> rbegin() const { return ReverseIterator<const char*>(this->end()); }
  ReverseIterator<const char*> rend() const { return ReverseIterator<const char*>(this->begin()); }
  ReverseIterator<const char*> crbegin() const { return this->rbegin(); }
  ReverseIterator<const char*> crend() const { return this->rend(); }
  const char* begin() const { return this->data(); }
  const char* end() const { return this->data() + this->size(); }
  const char* cbegin() const { return this->data(); }
  const char* cend() const { return this->data() + this->size(); }
  char& back() { return this->data()[this->size() - 1]; }
  const char& back() const { return this->data()[this->size() - 1]; }
  char& front() { return this->data()[0]; }
  const char& front() const { return this->data()[0]; }

  void push_back(char c) { this->append(c); }
  void pop_back()
  {
    int length = this->size();
    if (length > 0)
      this->setLength(length - 1);
  }
  void resize(int newLength, char fill)
  {
    int length = this->size();
    if (newLength > length)
    {
      this->reserve(newLength);
      memset(this->data() + length, fill, newLength - length);
    }
    this->setLength(newLength);
  }
  void resize(int newLength) { this->resize(newLength, 0); }
  // Removes count bytes at index (to the end when count is negative or reaches past it); throws
  // OutOfRange when index is past the end. Returns the string.
  String& erase(int index, int count)
  {
    int length = this->size();
    if (index < 0 || index > length)
      throwOutOfRange("String::erase: index out of range");
    if (index == length)
      return *this;
    if (count < 0 || count > length - index)
      count = length - index;
    char* chars = this->data();
    memmove(chars + index, chars + index + count, length - index - count);
    this->setLength(length - count);
    return *this;
  }
  String& erase(int index) { return this->erase(index, npos); }
  // The range [first, last) of this string's characters (begin()/end() and what find functions
  // return); returns where the character after them is now.
  char* erase(char* first, char* last)
  {
    int index = int(first - this->data());
    this->erase(index, int(last - first));
    return this->data() + index;
  }
  char* erase(char* at)
  {
    int index = int(at - this->data());
    this->erase(index, 1);
    return this->data() + index;
  }
  String& insert(int index, const char* text, int count)
  {
    if (count <= 0)
      return *this;
    int length = this->size();
    if (index > length)
      index = length;
    const char* chars = this->data();
    if (text >= chars && text < chars + length)
    {
      // Inserting part of this string into itself: copy it out before the characters move.
      String copy(text, count);
      return this->insert(index, copy.data(), count);
    }
    this->ensureRoom(length + count);
    char* target = this->data();
    memmove(target + index + count, target + index, length - index);
    memcpy(target + index, text, count);
    this->setLength(length + count);
    return *this;
  }
  String& insert(int index, const char* text) { return this->insert(index, text, (int)strlen(text)); }
  // Inserts [first, last) before the character position points at.
  char* insert(char* position, const char* first, const char* last)
  {
    int index = int(position - this->data());
    this->insert(index, first, int(last - first));
    return this->data() + index;
  }
  String& insert(int index, const String& text) { return this->insert(index, text.data(), text.size()); }
  // Inserts count copies of c at index.
  String& insert(int index, int count, char c)
  {
    if (count <= 0)
      return *this;
    int length = this->size();
    if (index > length)
      index = length;
    this->ensureRoom(length + count);
    char* chars = this->data();
    memmove(chars + index + count, chars + index, length - index);
    memset(chars + index, c, count);
    this->setLength(length + count);
    return *this;
  }
  // Replaces count bytes at index with text; returns the string.
  String& replace(int index, int count, const char* text)
  {
    this->erase(index, count);
    return this->insert(index, text);
  }
  String& replace(int index, int count, const String& text)
  {
    this->erase(index, count);
    return this->insert(index, text);
  }

  // Searching. Every find returns the index of the first match at or after `from`, or npos.
  int find(const char* needle, int from) const { return this->findBytes(needle, (int)strlen(needle), from); }
  int find(const char* needle) const { return this->find(needle, 0); }
  int find(const String& needle) const { return this->findBytes(needle.data(), needle.size(), 0); }
  int find(const String& needle, int from) const { return this->findBytes(needle.data(), needle.size(), from); }
  int find(char c, int from) const
  {
    int length = this->size();
    if (from < 0)
      from = 0;
    if (from >= length)
      return npos;
    const char* chars = this->data();
    const char* at = (const char*)memchr(chars + from, c, length - from);
    return at ? int(at - chars) : npos;
  }
  int find(char c) const { return this->find(c, 0); }
  // memchr finds candidates for the first byte, memcmp checks the rest.
  int findBytes(const char* needle, int count, int from) const
  {
    int length = this->size();
    if (from < 0)
      from = 0;
    if (count == 0)
      return from <= length ? from : npos;
    if (count > length || from > length - count)
      return npos;
    const char* chars = this->data();
    const char* lastStart = chars + length - count;
    const char* at = chars + from;
    while (at <= lastStart)
    {
      at = (const char*)memchr(at, needle[0], lastStart - at + 1);
      if (!at)
        return npos;
      if (memcmp(at + 1, needle + 1, count - 1) == 0)
        return int(at - chars);
      ++at;
    }
    return npos;
  }
  // The last occurrence starting at or before `from` (anywhere when from is npos), or npos.
  int rfind(char c, int from) const
  {
    const char* chars = this->data();
    int i = this->size() - 1;
    if (from >= 0 && from < i)
      i = from;
    for (; i >= 0; --i)
      if (chars[i] == c)
        return i;
    return npos;
  }
  int rfind(char c) const { return this->rfind(c, npos); }
  int rfindBytes(const char* needle, int count, int from) const
  {
    int i = this->size() - count;
    if (i < 0)
      return npos;
    if (from >= 0 && from < i)
      i = from;
    const char* chars = this->data();
    for (; i >= 0; --i)
      if (memcmp(chars + i, needle, count) == 0)
        return i;
    return npos;
  }
  int rfind(const char* needle, int from) const { return this->rfindBytes(needle, (int)strlen(needle), from); }
  int rfind(const char* needle) const { return this->rfind(needle, npos); }
  int rfind(const String& needle, int from) const { return this->rfindBytes(needle.data(), needle.size(), from); }
  int rfind(const String& needle) const { return this->rfindBytes(needle.data(), needle.size(), npos); }
  // The last byte that is in set, or npos.
  int find_last_of(const char* set) const
  {
    const char* chars = this->data();
    for (int i = this->size(); i-- > 0;)
      if (String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  int find_last_of(const String& set) const { return this->find_last_of(set.c_str()); }
  int find_last_of(char c) const { return this->rfind(c); }
  // Negative, zero or positive as this string orders before, equal to or after other (byte-wise,
  // as operator<).
  uint64_t copy(char* dest, uint64_t count, uint64_t pos) const
  {
    int length = this->size();
    if (pos > (uint64_t)length)
      pos = (uint64_t)length;
    uint64_t available = (uint64_t)length - pos;
    if (count > available)
      count = available;
    memcpy(dest, this->data() + pos, count);
    return count;
  }
  int compare(const String& other) const
  {
    int length = this->size(), otherLength = other.size();
    int c = memcmp(this->data(), other.data(), length < otherLength ? length : otherLength);
    if (c != 0)
      return c;
    return length < otherLength ? -1 : length > otherLength ? 1 : 0;
  }
  int compare(const char* other) const { return this->compare(String(other)); }
  void swap(String& other)
  {
    String held(move(other));
    other = move(*this);
    *this = move(held);
  }
  static bool oneOf(char c, const char* set)
  {
    for (int i = 0; set[i] != 0; ++i)
      if (set[i] == c)
        return true;
    return false;
  }
  int find_first_of(char c) const { return this->find(c); }
  int find_first_of(char c, int from) const { return this->find(c, from); }
  int find_first_of(StringView set, int from) const
  {
    const char* chars = this->data();
    int length = this->size();
    for (int i = from < 0 ? 0 : from; i < length; ++i)
      for (int k = 0; k < set.byteCount; ++k)
        if (chars[i] == set.chars[k])
          return i;
    return npos;
  }
  int find_first_of(StringView set) const { return this->find_first_of(set, 0); }
  int find_first_of(const String& set) const { return this->find_first_of(set.c_str()); }
  int find_first_not_of(const String& set) const { return this->find_first_not_of(set.c_str()); }
  int find_last_not_of(const String& set) const { return this->find_last_not_of(set.c_str()); }
  int find_first_of(const char* set) const
  {
    const char* chars = this->data();
    int length = this->size();
    for (int i = 0; i < length; ++i)
      if (String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  int find_first_not_of(const char* set) const
  {
    const char* chars = this->data();
    int length = this->size();
    for (int i = 0; i < length; ++i)
      if (!String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  // The first (last) byte other than c (LocaleStringReplacer's `find_first_not_of('0')`).
  int find_first_not_of(char c) const
  {
    const char* chars = this->data();
    int length = this->size();
    for (int i = 0; i < length; ++i)
      if (chars[i] != c)
        return i;
    return npos;
  }
  int find_last_not_of(char c) const
  {
    const char* chars = this->data();
    for (int i = this->size(); i-- > 0;)
      if (chars[i] != c)
        return i;
    return npos;
  }
  int find_last_not_of(const char* set) const
  {
    const char* chars = this->data();
    for (int i = this->size(); i-- > 0;)
      if (!String::oneOf(chars[i], set))
        return i;
    return npos;
  }
  bool startsWith(const String& prefix) const
  {
    int count = prefix.size();
    return count <= this->size() && memcmp(this->data(), prefix.data(), count) == 0;
  }
  bool endsWith(const String& suffix) const
  {
    int count = suffix.size(), length = this->size();
    return count <= length && memcmp(this->data() + length - count, suffix.data(), count) == 0;
  }
  // C++20's starts_with and ends_with: of a text (a String, a StringView, a literal) or of a char.
  bool starts_with(StringView prefix) const { return StringView(*this).startsWith(prefix); }
  bool starts_with(char c) const { return !this->empty() && this->front() == c; }
  bool ends_with(StringView suffix) const { return StringView(*this).endsWith(suffix); }
  bool ends_with(char c) const { return !this->empty() && this->back() == c; }

  bool operator==(const String& other) const
  {
    int length = this->size();
    return length == other.size() && memcmp(this->data(), other.data(), length) == 0;
  }
  bool operator!=(const String& other) const { return !(*this == other); }
  bool operator==(const char* other) const
  {
    int length = this->size();
    return strlen(other) == (size_t)length && memcmp(this->data(), other, length) == 0;
  }
  bool operator!=(const char* other) const { return !(*this == other); }
  bool operator<(const String& other) const
  {
    int length = this->size(), otherLength = other.size();
    int c = memcmp(this->data(), other.data(), length < otherLength ? length : otherLength);
    return c != 0 ? c < 0 : length < otherLength;
  }
  // Byte-wise as <: gives >, <= and >= with a String or a const char* (and `"x" < s` below).
  strong_ordering operator<=>(const String& other) const { return strong_ordering(signOf(this->compare(other))); }
  strong_ordering operator<=>(const char* other) const { return strong_ordering(signOf(this->compare(other))); }
  static int8_t signOf(int compared) { return compared < 0 ? -1 : compared > 0 ? 1 : 0; }

  // Makes room for `needed` characters (exactly: growth by appending is geometric).
  void reserve(int needed)
  {
    if (needed > this->capacity())
      this->reallocate(needed);
  }

  // Replaces the contents with count bytes (which may be part of this string); returns the string.
  String& assign(const char* bytes, int count)
  {
    if (count <= this->capacity())
    {
      memmove(this->data(), bytes, count);
      this->setLength(count);
      return *this;
    }
    char* block = (char*)malloc(count + 1);
    memcpy(block, bytes, count);
    block[count] = 0;
    this->adopt(block, count, count);
    return *this;
  }
  // The other forms of std::string's assign: the bytes of [first, last) (TCPSocket's
  // `result.assign(buffer, buffer + received)`), a C string, another String, count copies of c.
  String& assign(const char* first, const char* last) { return this->assign(first, int(last - first)); }
  String& assign(const char* text) { return this->assign(text, int(strlen(text))); }
  String& assign(const String& other) { return this->assign(other.data(), other.size()); }
  String& assign(int count, char c)
  {
    this->clear();
    this->append(count, c);
    return *this;
  }

  // The appends return the string.
  String& append(const char* bytes, int count)
  {
    if (count <= 0)
      return *this;
    int length = this->size();
    if (length + count > this->capacity())
    {
      this->appendGrowing(bytes, count);
      return *this;
    }
    memcpy(this->data() + length, bytes, count);
    this->setLength(length + count);
    return *this;
  }
  String& append(const char* text) { return this->append(text, (int)strlen(text)); }
  // The bytes of [first, last) (cxxopts' `s.append(begin, end)`).
  String& append(const char* first, const char* last) { return this->append(first, int(last - first)); }
  String& append(const String& other) { return this->append(other.data(), other.size()); }
  // Appends count copies of c.
  String& append(int count, char c)
  {
    if (count <= 0)
      return *this;
    int length = this->size();
    this->ensureRoom(length + count);
    memset(this->data() + length, c, count);
    this->setLength(length + count);
    return *this;
  }
  // Appends count characters of other from index (fewer when other ends before).
  String& append(const String& other, int index, int count)
  {
    int otherLength = other.size();
    if (index >= otherLength)
      return *this;
    if (count < 0 || count > otherLength - index)
      count = otherLength - index;
    return this->append(other.data() + index, count);
  }
  String& append(char c)
  {
    if (this->isLarge())
    {
      int length = this->heapLength;
      if (length < this->heapCapacity)
      {
        this->heapChars[length] = c;
        this->heapChars[length + 1] = 0;
        this->heapLength = length + 1;
        return *this;
      }
    }
    else
    {
      int length = (int)this->smallChars[String::markIndex];
      if (length < String::smallCapacity)
      {
        this->smallChars[length] = c;
        this->smallChars[length + 1] = 0;
        this->smallChars[String::markIndex] = (char)(length + 1);
        return *this;
      }
    }
    this->appendGrowing(&c, 1);
    return *this;
  }

  String& operator+=(const char* text)
  {
    this->append(text);
    return *this;
  }
  String& operator+=(const String& other)
  {
    this->append(other);
    return *this;
  }
  String& operator+=(char c)
  {
    this->append(c);
    return *this;
  }
  String operator+(const String& other) const
  {
    String result;
    result.reserve(this->size() + other.size());
    result.append(*this);
    result.append(other);
    return result;
  }
  String operator+(const char* text) const
  {
    String result;
    result.reserve(this->size() + (int)strlen(text));
    result.append(*this);
    result.append(text);
    return result;
  }
  String operator+(char c) const
  {
    String result;
    result.reserve(this->size() + 1);
    result.append(*this);
    result.append(c);
    return result;
  }

  // count characters from start (all the rest when count is negative or runs past the end);
  // throws OutOfRange when start is past the end.
  String substr(int start, int count) const
  {
    int length = this->size();
    if (start < 0 || start > length)
      throwOutOfRange("String::substr: start out of range");
    if (start == length)
      return String();
    int available = length - start;
    return String(this->data() + start, count >= 0 && count < available ? count : available);
  }
  String substr(int start) const { return this->substr(start, npos); }
  // Empties the string; the capacity stays.
  void clear() { this->setLength(0); }

  // Internals.
  void becomeEmpty()
  {
    this->smallChars[0] = 0;
    this->smallChars[String::markIndex] = 0;
  }
  // Construction from count bytes.
  void initialize(const char* bytes, int count)
  {
    if (count <= 0)
    {
      this->becomeEmpty();
      return;
    }
    if (count <= String::smallCapacity)
    {
      memcpy(this->smallChars, bytes, count);
      this->smallChars[count] = 0;
      this->smallChars[String::markIndex] = (char)count;
      return;
    }
    char* block = (char*)malloc(count + 1);
    memcpy(block, bytes, count);
    block[count] = 0;
    this->heapChars = block;
    this->heapLength = count;
    this->heapCapacity = count;
    this->smallChars[String::markIndex] = (char)String::largeMark;
  }
  // Sets the length and writes the terminating zero after it.
  void setLength(int length)
  {
    if (this->isLarge())
    {
      this->heapLength = length;
      this->heapChars[length] = 0;
    }
    else
    {
      this->smallChars[length] = 0;
      this->smallChars[String::markIndex] = (char)length;
    }
  }
  // Takes block (holding length characters and their terminator, room for capacity) as the storage.
  void adopt(char* block, int length, int capacity)
  {
    if (this->isLarge())
      free(this->heapChars);
    this->heapChars = block;
    this->heapLength = length;
    this->heapCapacity = capacity;
    this->smallChars[String::markIndex] = (char)String::largeMark;
  }
  // Moves the characters into a heap block with room for newCapacity. Out of line, like every
  // growth path, so that the fast paths around it stay small enough to inline.
  [[noinline]] void reallocate(int newCapacity)
  {
    int length = this->size();
    char* block = (char*)malloc(newCapacity + 1);
    memcpy(block, this->data(), length + 1);
    this->adopt(block, length, newCapacity);
  }
  // Geometric growth: appending n characters one by one costs O(n) in total.
  void ensureRoom(int needed)
  {
    int capacity = this->capacity();
    if (needed > capacity)
      this->reallocate(needed > capacity * 2 ? needed : capacity * 2);
  }
  // append() when the characters do not fit: bytes may point into this string, so the old block
  // is released only after they are copied.
  [[noinline]] void appendGrowing(const char* bytes, int count)
  {
    int length = this->size(), capacity = this->capacity();
    int newLength = length + count;
    int newCapacity = newLength > capacity * 2 ? newLength : capacity * 2;
    char* block = (char*)malloc(newCapacity + 1);
    memcpy(block, this->data(), length);
    memcpy(block + length, bytes, count);
    block[newLength] = 0;
    this->adopt(block, newLength, newCapacity);
  }
};

// A const char* on the left of an ordering comparison with a String (`"b" < name`), byte-wise as
// String's own.
bool operator<(const char* left, const String& right) { return right.compare(left) > 0; }
bool operator>(const char* left, const String& right) { return right.compare(left) < 0; }
bool operator<=(const char* left, const String& right) { return right.compare(left) >= 0; }
bool operator>=(const char* left, const String& right) { return right.compare(left) <= 0; }

String operator+(const char* left, const String& right)
{
  int leftLength = (int)strlen(left);
  String result;
  result.reserve(leftLength + right.size());
  result.append(left, leftLength);
  result.append(right);
  return result;
}
String operator+(char left, const String& right)
{
  String result;
  result.reserve(1 + right.size());
  result.append(left);
  result.append(right);
  return result;
}
