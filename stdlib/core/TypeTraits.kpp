// Type traits: compile-time type predicates and transformations. These are what std::is_same_v,
// std::enable_if_t, std::conditional_t etc. convert to. Many resolve to compiler builtins in a
// real implementation; here they are the simplest thing that compiles.

template<bool B, typename T = void>
struct EnableIf {};
template<typename T>
struct EnableIf<true, T> { using Type = T; };

template<bool B, typename T, typename F>
struct Conditional { using Type = T; };
template<typename T, typename F>
struct Conditional<false, T, F> { using Type = F; };

template<typename T, typename U>
struct IsSame : FalseType {};
template<typename T>
struct IsSame<T, T> : TrueType {};

template<typename T>
struct IsConst : FalseType {};
template<typename T>
struct IsConst<const T> : TrueType {};

template<typename T>
struct RemoveCv { using Type = T; };
template<typename T>
struct RemoveCv<const T> { using Type = T; };
template<typename T>
struct RemoveCv<volatile T> { using Type = T; };
template<typename T>
struct RemoveCv<const volatile T> { using Type = T; };

template<typename T>
using AddConst = const T;

template<typename T>
using AddLvalueReference = T&;

template<typename T>
struct MakeUnsignedHelper {};
template<> struct MakeUnsignedHelper<int8_t> { using Type = uint8_t; };
template<> struct MakeUnsignedHelper<int16_t> { using Type = uint16_t; };
template<> struct MakeUnsignedHelper<int> { using Type = unsigned int; };
template<> struct MakeUnsignedHelper<long long> { using Type = unsigned long long; };
template<> struct MakeUnsignedHelper<uint8_t> { using Type = uint8_t; };
template<> struct MakeUnsignedHelper<uint16_t> { using Type = uint16_t; };
template<> struct MakeUnsignedHelper<unsigned int> { using Type = unsigned int; };
template<> struct MakeUnsignedHelper<unsigned long long> { using Type = unsigned long long; };

template<typename T>
using MakeUnsigned = typename MakeUnsignedHelper<T>::Type;

// void_t: always void, used in SFINAE detection patterns.
template<typename...>
using VoidT = void;

template<bool B>
using BoolConstant = typename Conditional<B, TrueType, FalseType>::Type;

// A value as a type (std::integral_constant). IntegralConstant<bool, true> is a TrueType and
// IntegralConstant<bool, false> a FalseType, so either passes where the other is expected
// (`f(x, IntegralConstant<bool, isSigned>())` choosing between `f(T, TrueType)` and
// `f(T, FalseType)`); in C++ they are the same type.
template<typename T, T V>
struct IntegralConstant
{
  using value_type = T;
  static constexpr T value = V;
  constexpr operator T() const { return V; }
  constexpr T operator()() const { return V; }
};
template<>
struct IntegralConstant<bool, true> : TrueType
{
  using value_type = bool;
  constexpr bool operator()() const { return true; }
};
template<>
struct IntegralConstant<bool, false> : FalseType
{
  using value_type = bool;
  constexpr bool operator()() const { return false; }
};

// The type predicates are the compiler's (resolver.cpp, traitValue), not declared here: a
// declaration of the same name would hide them. isClass, isAbstract, isPolymorphic, isFinal,
// isSame, isBaseOf, isConvertible, isConstructible, isMoveConstructible, isCopyConstructible,
// isMoveAssignable, isCopyAssignable and their Trivially/Nothrow forms, isInvocable, isInvocableR,
// isMemberPointer, ... take types and are constants as C++'s std::is_*_v are; where a predicate
// cannot be decided (a class without a definition) it is not a constant, never a guess. C++'s
// class forms used for their value (`std::is_member_function_pointer<T>()`, `::value`) convert to
// these.

template<typename T> constexpr size_t alignmentOf = alignof(T);
