// Type traits: compile-time type predicates and transformations. These are what std::is_same_v,
// std::enable_if_t, std::conditional_t etc. convert to. Many resolve to compiler builtins in a
// real implementation; here they are the simplest thing that compiles.

template<bool B, typename T = void>
struct EnableIf {};
template<typename T>
struct EnableIf<true, T> { using Type = T; };

template<bool B, typename T, typename F>
struct Conditional { using Type = T; };
template<typename T, typename F>
struct Conditional<false, T, F> { using Type = F; };

template<typename T, typename U>
struct IsSame : FalseType {};
template<typename T>
struct IsSame<T, T> : TrueType {};

// std::is_constructible: isConstructible as a type of a ::value, which std::disjunction and std::conjunction take
// (`std::disjunction_v<std::is_same<T, U>, std::is_constructible<T, U>>`, Unreal's TArrayElementsAreCompatible_V)
template<typename T, typename... Args>
struct IsConstructible : BoolConstant<isConstructible<T, Args...>> {};

// std::is_assignable_v: whether `declval<T>() = declval<U>()` is well-formed (T an rvalue unless a reference: an int is
// not assignable, an int& is), and std::is_assignable, the same as a type with `::value`.
template<typename T, typename U>
constexpr bool isAssignable = requires(T&& t, U&& u) { static_cast<T&&>(t) = static_cast<U&&>(u); };
template<typename T, typename U>
struct IsAssignable : BoolConstant<isAssignable<T, U>> {};

template<typename T>
struct IsConst : FalseType {};
template<typename T>
struct IsConst<const T> : TrueType {};

template<typename T>
struct RemoveCv { using Type = T; };
template<typename T>
struct RemoveCv<const T> { using Type = T; };
template<typename T>
struct RemoveCv<volatile T> { using Type = T; };
template<typename T>
struct RemoveCv<const volatile T> { using Type = T; };

template<typename T>
using AddConst = const T;

template<typename T>
using AddLvalueReference = T&;

template<typename T>
using AddVolatile = volatile T;

// std::conjunction_v and std::disjunction_v: whether every (any) B::value holds; true (false) for none. Every
// B::value is instantiated (std::conjunction stops at the first false one: docs/stdlib-conformance.md).
template<typename... B>
constexpr bool conjunction = (B::value && ...);
template<typename... B>
constexpr bool disjunction = (B::value || ...);

// std::common_type_t: the type two values of the types have together, as `c ? a : b` gives it, decayed; of more types the
// first two's with the next, and so on (a program's specialization of std::common_type is not consulted).
template<typename... T>
struct CommonTypeOf
{
};

template<typename T>
struct CommonTypeOf<T>
{
  using Type = Decay<T>;
};

template<typename A, typename B>
struct CommonTypeOf<A, B>
{
  using Type = Decay<decltype(false ? declval<A>() : declval<B>())>;
};

template<typename A, typename B, typename C, typename... R>
struct CommonTypeOf<A, B, C, R...>
{
  using Type = typename CommonTypeOf<typename CommonTypeOf<A, B>::Type, C, R...>::Type;
};

template<typename... T>
using CommonType = typename CommonTypeOf<T...>::Type;

template<typename T>
struct MakeUnsignedHelper {};
template<> struct MakeUnsignedHelper<i8> { using Type = u8; };
template<> struct MakeUnsignedHelper<i16> { using Type = u16; };
template<> struct MakeUnsignedHelper<i32> { using Type = u32; };
template<> struct MakeUnsignedHelper<i64> { using Type = u64; };
template<> struct MakeUnsignedHelper<long> { using Type = unsigned long; }; // (C's long, a type of its own)
template<> struct MakeUnsignedHelper<u8> { using Type = u8; };
template<> struct MakeUnsignedHelper<u16> { using Type = u16; };
template<> struct MakeUnsignedHelper<u32> { using Type = u32; };
template<> struct MakeUnsignedHelper<u64> { using Type = u64; };
template<> struct MakeUnsignedHelper<unsigned long> { using Type = unsigned long; };

template<typename T>
using MakeUnsigned = typename MakeUnsignedHelper<T>::Type;

// void_t: always void, used in SFINAE detection patterns.
template<typename...>
using VoidT = void;

// A value as a type (std::integral_constant): a static `value` and a conversion to it. TrueType and
// FalseType, what traits derive from, are its two bool instances, as in C++ (std::true_type), so
// `IntegralConstant<bool, isSigned<T>>()` passes where a TrueType or FalseType is expected.
template<typename T, T V>
struct IntegralConstant
{
  using value_type = T;
  using type = IntegralConstant<T, V>;
  static constexpr T value = V;
  implicit constexpr operator T() const { return V; }
  constexpr T operator()() const { return V; }
};

using TrueType = IntegralConstant<bool, true>;
using FalseType = IntegralConstant<bool, false>;
template<bool B>
using BoolConstant = IntegralConstant<bool, B>;

// The type predicates are the compiler's (resolver.cpp, traitValue), not declared here: a
// declaration of the same name would hide them. isClass, isStruct (kpp's: declared `struct`),
// isInstanceOf<T, Template> (kpp's: T an instance of the class template),
// hasConstructor<T, Args...> (kpp's: a constructor T declares takes Args),
// isAbstract, isPolymorphic, isFinal, isSame, isBaseOf, isConvertible, isConstructible, isMoveConstructible, isCopyConstructible,
// isMoveAssignable, isCopyAssignable and their Trivially/Nothrow forms, isInvocable, isInvocableR,
// isMemberPointer, ... take types and are constants as C++'s std::is_*_v are; where a predicate
// cannot be decided (a class without a definition) it is not a constant, never a guess. C++'s
// class forms used for their value (`std::is_member_function_pointer<T>()`, `::value`) convert to
// these.

template<typename T> constexpr usize alignmentOf = alignof(T);
