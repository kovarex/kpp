// kpp standard library: time (what std::chrono converts to). A Duration<Rep, Period> is a count of
// ticks of Period seconds (a Ratio); Nanoseconds to Hours are the usual ones. A TimePoint<Clock> is
// a Duration since the clock's epoch. SteadyClock never goes back (QueryPerformanceCounter);
// SystemClock is the wall clock (UTC, since 1970, in 100 ns ticks). Specified in
// docs/stdlib/time.md.

// --- Ratio ---

// A fraction known at compile time (std::ratio): num and den are N/D in lowest terms, den positive
// (gcd folds at compile time).
template<i64 N, i64 D = 1>
struct Ratio
{
  static constexpr i64 num = (D < 0 ? -N : N) / gcd(N, D);
  static constexpr i64 den = (D < 0 ? -D : D) / gcd(N, D);
};

using Nano = Ratio<1, 1000000000>;
using Micro = Ratio<1, 1000000>;
using Milli = Ratio<1, 1000>;
using Centi = Ratio<1, 100>;
using Deci = Ratio<1, 10>;
using Kilo = Ratio<1000, 1>;
using Mega = Ratio<1000000, 1>;

// Arithmetic and comparison of ratios at compile time (std::ratio_add, ratio_subtract,
// ratio_multiply, ratio_divide, ratio_equal, ratio_less, ...): each result in lowest terms. Common
// factors are divided out before the products are formed, so that a result is given whenever it fits,
// as std's (Ratio<1, 10^12> + Ratio<1, 10^12> is 1/(5 * 10^11), though 10^12 * 10^12 is past i64).
template<typename R1, typename R2>
using RatioAdd = Ratio<R1::num * (R2::den / gcd(R1::den, R2::den)) + R2::num * (R1::den / gcd(R1::den, R2::den)),
                       R1::den * (R2::den / gcd(R1::den, R2::den))>;
template<typename R1, typename R2>
using RatioSubtract = Ratio<R1::num * (R2::den / gcd(R1::den, R2::den)) - R2::num * (R1::den / gcd(R1::den, R2::den)),
                            R1::den * (R2::den / gcd(R1::den, R2::den))>;
template<typename R1, typename R2>
using RatioMultiply = Ratio<(R1::num / gcd(R1::num, R2::den)) * (R2::num / gcd(R2::num, R1::den)),
                            (R1::den / gcd(R2::num, R1::den)) * (R2::den / gcd(R1::num, R2::den))>;
template<typename R1, typename R2>
using RatioDivide = RatioMultiply<R1, Ratio<R2::den, R2::num>>;
template<typename R1, typename R2>
constexpr bool ratioEqual = R1::num == R2::num && R1::den == R2::den;
template<typename R1, typename R2>
constexpr bool ratioNotEqual = !ratioEqual<R1, R2>;
template<typename R1, typename R2>
constexpr bool ratioLess = R1::num * R2::den < R2::num * R1::den;
template<typename R1, typename R2>
constexpr bool ratioLessEqual = !ratioLess<R2, R1>;
template<typename R1, typename R2>
constexpr bool ratioGreater = ratioLess<R2, R1>;
template<typename R1, typename R2>
constexpr bool ratioGreaterEqual = !ratioLess<R1, R2>;

// --- Duration ---

template<typename Rep, typename Period = Ratio<1>>
class Duration
{
public:
  using rep = Rep;
  using period = Period;

  constexpr Duration() : ticks(Rep()) {}
  // From a count of ticks.
  constexpr Duration(Rep count) : ticks(count) {}
  // From another duration, converted to this one's period: implicit when nothing is lost (this Rep
  // is floating point, or the other period is a whole multiple of this one), durationCast otherwise.
  template<typename Rep2, typename Period2> requires (isFloatingPoint<Rep> || (!isFloatingPoint<Rep2> && (Period2::num * Period::den) % (Period2::den * Period::num) == 0))
  implicit Duration(const Duration<Rep2, Period2>& other) : ticks(convertDuration(other, (const Duration<Rep, Period>*)nullptr).count()) {}

  constexpr Rep count() const { return this->ticks; }
  static constexpr Duration<Rep, Period> zero() { return Duration<Rep, Period>(Rep()); }
  static constexpr Duration<Rep, Period> min() { return Duration<Rep, Period>(Limits<Rep>::lowest()); }
  static constexpr Duration<Rep, Period> max() { return Duration<Rep, Period>(Limits<Rep>::max()); }

  Duration<Rep, Period>& operator++()
  {
    ++this->ticks;
    return *this;
  }

  Duration<Rep, Period>& operator--()
  {
    --this->ticks;
    return *this;
  }

  Duration<Rep, Period> operator++(i32) { return Duration<Rep, Period>(this->ticks++); }
  Duration<Rep, Period> operator--(i32) { return Duration<Rep, Period>(this->ticks--); }

  Duration<Rep, Period>& operator+=(const Duration<Rep, Period>& other)
  {
    this->ticks += other.ticks;
    return *this;
  }

  Duration<Rep, Period>& operator-=(const Duration<Rep, Period>& other)
  {
    this->ticks -= other.ticks;
    return *this;
  }

  Duration<Rep, Period>& operator*=(const Rep& factor)
  {
    this->ticks *= factor;
    return *this;
  }

  Duration<Rep, Period>& operator/=(const Rep& divisor)
  {
    this->ticks /= divisor;
    return *this;
  }

  Duration<Rep, Period> operator+() const { return *this; }
  Duration<Rep, Period> operator-() const { return Duration<Rep, Period>(-this->ticks); }

  // The sum, difference and remainder of two durations of any types are in their common duration
  // (inCommonDuration: Milliseconds + Seconds is Milliseconds), as is the quotient of two, a count.
  template<typename Rep2, typename Period2>
  auto operator+(const Duration<Rep2, Period2>& other) const
  {
    auto sum = inCommonDuration(*this, other);
    sum.ticks += inCommonDuration(other, *this).count();
    return sum;
  }

  template<typename Rep2, typename Period2>
  auto operator-(const Duration<Rep2, Period2>& other) const
  {
    auto difference = inCommonDuration(*this, other);
    difference.ticks -= inCommonDuration(other, *this).count();
    return difference;
  }

  template<typename Rep2, typename Period2>
  auto operator%(const Duration<Rep2, Period2>& other) const
  {
    auto rest = inCommonDuration(*this, other);
    rest.ticks %= inCommonDuration(other, *this).count();
    return rest;
  }

  // How many times other fits in this duration.
  template<typename Rep2, typename Period2>
  auto operator/(const Duration<Rep2, Period2>& other) const
  {
    return inCommonDuration(*this, other).count() / inCommonDuration(other, *this).count();
  }

  // Times or divided by an integer keeps the type; by a floating-point number it counts in double.
  // (Members, one per scalar type: C++ takes any rep, in the common type of the two.)
  Duration<Rep, Period> operator*(i32 factor) const { return Duration<Rep, Period>(this->ticks * factor); }
  Duration<Rep, Period> operator*(i64 factor) const { return Duration<Rep, Period>(this->ticks * factor); }
  Duration<double, Period> operator*(double factor) const { return Duration<double, Period>((double)this->ticks * factor); }
  Duration<Rep, Period> operator/(i32 divisor) const { return Duration<Rep, Period>(this->ticks / divisor); }
  Duration<Rep, Period> operator/(i64 divisor) const { return Duration<Rep, Period>(this->ticks / divisor); }
  Duration<double, Period> operator/(double divisor) const { return Duration<double, Period>((double)this->ticks / divisor); }
  Duration<Rep, Period> operator%(i32 divisor) const { return Duration<Rep, Period>(this->ticks % divisor); }
  Duration<Rep, Period> operator%(i64 divisor) const { return Duration<Rep, Period>(this->ticks % divisor); }
  // Comparisons with a duration of any type, in their common duration.
  template<typename Rep2, typename Period2>
  bool operator==(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) == 0; }
  template<typename Rep2, typename Period2>
  bool operator<(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) < 0; }
  template<typename Rep2, typename Period2>
  bool operator<=(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) <= 0; }
  template<typename Rep2, typename Period2>
  bool operator>(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) > 0; }
  template<typename Rep2, typename Period2>
  bool operator>=(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) >= 0; }

private:
  Rep ticks;
};

// d in the duration type of target (which is only read for its type): exact when that is possible,
// truncated toward zero for an integer rep otherwise (durationCast's rule). An integer count is
// computed as std's in the common type of the reps and intmax_t: a u64 when either rep is a 64-bit
// unsigned type, an i64 otherwise.
template<typename ToRep, typename ToPeriod, typename Rep, typename Period>
Duration<ToRep, ToPeriod> convertDuration(const Duration<Rep, Period>& d, const Duration<ToRep, ToPeriod>* target)
{
  // The factor (Period::num / Period::den) / (ToPeriod::num / ToPeriod::den), reduced before it is
  // multiplied out (RatioDivide's).
  i64 numerators = gcd(Period::num, ToPeriod::num);
  i64 denominators = gcd(Period::den, ToPeriod::den);
  i64 multiplier = (Period::num / numerators) * (ToPeriod::den / denominators);
  i64 divisor = (Period::den / denominators) * (ToPeriod::num / numerators);
  if constexpr (isFloatingPoint<ToRep> || isFloatingPoint<Rep>)
    return Duration<ToRep, ToPeriod>((ToRep)((double)d.count() * (double)multiplier / (double)divisor));
  else
  {
    constexpr bool unsignedWide = (isUnsigned<Rep> && sizeof(Rep) == 8) || (isUnsigned<ToRep> && sizeof(ToRep) == 8);
    using Wide = typename Conditional<unsignedWide, u64, i64>::Type;
    if (divisor == 1)
      return Duration<ToRep, ToPeriod>((ToRep)((Wide)d.count() * (Wide)multiplier));
    return Duration<ToRep, ToPeriod>((ToRep)((Wide)d.count() * (Wide)multiplier / (Wide)divisor));
  }
}

using Nanoseconds = Duration<i64, Nano>;
using Microseconds = Duration<i64, Micro>;
using Milliseconds = Duration<i64, Milli>;
using Seconds = Duration<i64>;
using Minutes = Duration<i64, Ratio<60>>;
using Hours = Duration<i64, Ratio<3600>>;
using Days = Duration<i64, Ratio<86400>>;
// The calendar's lengths (std::chrono::weeks, months, years): a week of 7 days, an average
// Gregorian year of 365.2425 days, a twelfth of it as a month.
using Weeks = Duration<i64, Ratio<604800>>;
using Years = Duration<i64, Ratio<31556952>>;
using Months = Duration<i64, Ratio<2629746>>;

// Whether a duration of this rep may be converted to and from implicitly with a loss: a
// floating-point one (std::chrono::treat_as_floating_point).
template<typename Rep>
constexpr bool treatAsFloatingPoint = isFloatingPoint<Rep>;

// d without its sign (std::chrono::abs), for a signed rep.
template<typename Rep, typename Period>
  requires isSigned<Rep> || isFloatingPoint<Rep>
Duration<Rep, Period> abs(const Duration<Rep, Period>& d)
{
  return d.count() < Rep(0) ? Duration<Rep, Period>(-d.count()) : d;
}

// d in To's period (std::chrono::duration_cast): truncated toward zero for an integer To.
template<typename To, typename Rep, typename Period>
To durationCast(const Duration<Rep, Period>& d)
{
  return convertDuration(d, (const To*)nullptr);
}

// Rounded down, up, and to the nearest (ties to even) instead of toward zero, as std::chrono's
// floor, ceil and round. Compared in the two durations' exact common duration (compareDurations): a
// comparison in double nanoseconds lost a remainder past 2^53 ns, about 104 days
// (floor<Microseconds>(Nanoseconds(-100000000000000001)) was -100000000000000, not ...001).
template<typename To, typename Rep, typename Period>
To floor(const Duration<Rep, Period>& d)
{
  To t = durationCast<To>(d);
  if (t > d)
    t -= To(1);
  return t;
}

template<typename To, typename Rep, typename Period>
To ceil(const Duration<Rep, Period>& d)
{
  To t = durationCast<To>(d);
  if (t < d)
    t += To(1);
  return t;
}

template<typename To, typename Rep, typename Period>
  requires (!isFloatingPoint<typename To::rep>)
To round(const Duration<Rep, Period>& d)
{
  To lower = floor<To>(d);
  To upper = lower + To(1);
  auto below = d - lower;
  auto above = upper - d;
  if (below < above)
    return lower;
  if (above < below)
    return upper;
  return lower.count() % 2 == 0 ? lower : upper;
}

// A number times a duration, as the duration times the number.
template<typename R, typename P>
Duration<R, P> operator*(i32 factor, const Duration<R, P>& d) { return d * factor; }
template<typename R, typename P>
Duration<R, P> operator*(i64 factor, const Duration<R, P>& d) { return d * factor; }
template<typename R, typename P>
Duration<double, P> operator*(double factor, const Duration<R, P>& d) { return d * factor; }

// a in the common duration of a and b (std::common_type of two durations), which both convert to
// without loss: its rep is the type of the sum of the two reps, its period the greatest that divides
// both periods, so the finer of the two when the other is a whole multiple of it (Milliseconds and
// Seconds: Milliseconds, as for every two of the standard durations), else the fraction
// gcd(numerators) / lcm(denominators) (Ratio<1, 2> and Ratio<1, 3>: Ratio<1, 6>).
template<typename R1, typename P1, typename R2, typename P2>
auto inCommonDuration(const Duration<R1, P1>& a, const Duration<R2, P2>& b)
{
  if constexpr ((P2::num * P1::den) % (P2::den * P1::num) == 0)
    return Duration<decltype(a.count() + b.count()), P1>(a);
  else if constexpr ((P1::num * P2::den) % (P1::den * P2::num) == 0)
    return Duration<decltype(a.count() + b.count()), P2>(a);
  else
    return Duration<decltype(a.count() + b.count()), Ratio<gcd(P1::num, P2::num), P1::den / gcd(P1::den, P2::den) * P2::den>>(a);
}

// The ticks of a and b in their common duration, compared.
template<typename R1, typename P1, typename R2, typename P2>
i32 compareDurations(const Duration<R1, P1>& a, const Duration<R2, P2>& b)
{
  auto x = inCommonDuration(a, b);
  auto y = inCommonDuration(b, a);
  return x.count() < y.count() ? -1 : y.count() < x.count() ? 1 : 0;
}

// --- TimePoint and the clocks ---

// A point in time of Clock: a Duration since the clock's epoch.
template<typename Clock, typename Dur = typename Clock::duration>
class TimePoint
{
public:
  using clock = Clock;
  using duration = Dur;
  using rep = typename Dur::rep;
  using period = typename Dur::period;

  constexpr TimePoint() {}
  constexpr TimePoint(const Dur& sinceEpoch) : sinceEpoch(sinceEpoch) {}
  // From a time point of the same clock in another duration, when nothing is lost.
  template<typename Dur2>
  implicit TimePoint(const TimePoint<Clock, Dur2>& other) : sinceEpoch(other.sinceEpoch) {}

  constexpr Dur time_since_epoch() const { return this->sinceEpoch; }
  static constexpr TimePoint<Clock, Dur> min() { return TimePoint<Clock, Dur>(Dur::min()); }
  static constexpr TimePoint<Clock, Dur> max() { return TimePoint<Clock, Dur>(Dur::max()); }

  TimePoint<Clock, Dur>& operator+=(const Dur& d)
  {
    this->sinceEpoch += d;
    return *this;
  }

  TimePoint<Clock, Dur>& operator-=(const Dur& d)
  {
    this->sinceEpoch -= d;
    return *this;
  }

  // A time point plus or minus a duration, and the difference of two time points of the clock, are
  // in the common duration of the two (a SteadyClock time point plus Milliseconds counts in
  // nanoseconds; a Seconds one plus Milliseconds in milliseconds). The operators are members, so
  // that their types come from the class (`durationCast<Milliseconds>(end - start)`).
  template<typename R, typename P>
  auto operator+(const Duration<R, P>& d) const
  {
    auto sinceEpoch = this->sinceEpoch + d;
    return TimePoint<Clock, decltype(sinceEpoch)>(sinceEpoch);
  }

  template<typename R, typename P>
  auto operator-(const Duration<R, P>& d) const
  {
    auto sinceEpoch = this->sinceEpoch - d;
    return TimePoint<Clock, decltype(sinceEpoch)>(sinceEpoch);
  }

  template<typename Dur2>
  auto operator-(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch - other.sinceEpoch; }
  // Comparisons with a time point of the clock in any duration.
  template<typename Dur2>
  bool operator==(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch == other.sinceEpoch; }
  template<typename Dur2>
  bool operator<(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch < other.sinceEpoch; }
  template<typename Dur2>
  bool operator<=(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch <= other.sinceEpoch; }
  template<typename Dur2>
  bool operator>(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch > other.sinceEpoch; }
  template<typename Dur2>
  bool operator>=(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch >= other.sinceEpoch; }

private:
  Dur sinceEpoch;
};

// A duration plus a time point, as the time point plus the duration.
template<typename R, typename P, typename C, typename D>
auto operator+(const Duration<R, P>& d, const TimePoint<C, D>& t) { return t + d; }

// t in another duration of the same clock (std::chrono::time_point_cast).
template<typename To, typename C, typename D>
TimePoint<C, To> timePointCast(const TimePoint<C, D>& t) { return TimePoint<C, To>(durationCast<To>(t.time_since_epoch())); }

// A monotonic clock in nanoseconds (std::chrono::steady_clock; also high_resolution_clock).
struct SteadyClock
{
  using rep = i64;
  using period = Nano;
  using duration = Nanoseconds;
  using time_point = TimePoint<SteadyClock>;
  static constexpr bool is_steady = true;

  static TimePoint<SteadyClock> now() { return TimePoint<SteadyClock>(Nanoseconds(platform::steadyNanoseconds())); }
};

using HighResolutionClock = SteadyClock;

// The wall clock (std::chrono::system_clock): UTC since 1970-01-01, in 100 ns ticks; it can jump
// when the system time is set.
struct SystemClock
{
  using rep = i64;
  using period = Ratio<1, 10000000>;
  using duration = Duration<i64, Ratio<1, 10000000>>;
  using time_point = TimePoint<SystemClock>;
  static constexpr bool is_steady = false;

  static TimePoint<SystemClock> now() { return TimePoint<SystemClock>(Duration<i64, Ratio<1, 10000000>>(platform::systemTicks())); }

  // Whole seconds since 1970 (time_t), rounded toward negative infinity, and back.
  static i64 to_time_t(const TimePoint<SystemClock>& t)
  {
    i64 ticks = t.time_since_epoch().count();
    return ticks >= 0 ? ticks / 10000000 : -((-ticks + 9999999) / 10000000);
  }

  static TimePoint<SystemClock> from_time_t(i64 seconds) { return TimePoint<SystemClock>(Duration<i64, Ratio<1, 10000000>>(seconds * 10000000)); }
};

// The decimal digits below a second that std::chrono::hh_mm_ss keeps for a period of denominator den:
// the fewest n (up to 18) for which 10^n is a multiple of den, 6 when there is none.
constexpr i32 hmsFractionalWidth(i64 den)
{
  i64 power = 1;
  for (i32 n = 0; n < 18; ++n, power *= 10)
    if (power % den == 0)
      return n;
  return power % den == 0 ? 18 : 6;
}

constexpr i64 hmsPowerOfTen(i32 n)
{
  i64 power = 1;
  for (i32 i = 0; i < n; ++i)
    power *= 10;
  return power;
}

// A duration taken apart into hours, minutes, seconds and what is left below a second
// (std::chrono::hh_mm_ss), each of its absolute value; is_negative() tells the sign. The precision
// is std's: seconds, or 10^-fractional_width seconds (6 digits for a period such as a third of a
// second, which has no decimal fraction); subseconds() and to_duration() are in it.
template<typename D>
class HoursMinutesSeconds
{
public:
  static constexpr i32 fractional_width = hmsFractionalWidth(D::period::den);
  using precision = Duration<typename Conditional<isFloatingPoint<typename D::rep>, typename D::rep, i64>::Type,
                             Ratio<1, hmsPowerOfTen(fractional_width)>>;

  constexpr HoursMinutesSeconds() : HoursMinutesSeconds(D()) {}

  constexpr HoursMinutesSeconds(D d)
  {
    this->negative = d.count() < typename D::rep(0);
    precision whole = durationCast<precision>(this->negative ? D(-d.count()) : d);
    this->h = durationCast<Hours>(whole);
    whole -= durationCast<precision>(this->h);
    this->m = durationCast<Minutes>(whole);
    whole -= durationCast<precision>(this->m);
    this->s = durationCast<Seconds>(whole);
    whole -= durationCast<precision>(this->s);
    this->rest = whole;
  }

  constexpr bool is_negative() const { return this->negative; }
  constexpr Hours hours() const { return this->h; }
  constexpr Minutes minutes() const { return this->m; }
  constexpr Seconds seconds() const { return this->s; }
  constexpr precision subseconds() const { return this->rest; }

  constexpr precision to_duration() const
  {
    precision whole = durationCast<precision>(this->h) + durationCast<precision>(this->m) + durationCast<precision>(this->s);
    whole += this->rest;
    return this->negative ? precision(-whole.count()) : whole;
  }

private:
  bool negative = false;
  Hours h;
  Minutes m;
  Seconds s;
  precision rest;
};

// The file system's clock (std::chrono::file_clock), what a file's last write time is in
// (filesystem::file_time_type): 100 ns ticks since 1601-01-01 UTC, Windows' FILETIME, on every
// target. to_sys and from_sys convert to and from SystemClock, 11644473600 seconds later.
struct FileClock
{
  using rep = i64;
  using period = Ratio<1, 10000000>;
  using duration = Duration<i64, Ratio<1, 10000000>>;
  using time_point = TimePoint<FileClock>;
  static constexpr bool is_steady = false;
  static constexpr i64 ticksTo1970 = 116444736000000000ll;

  static TimePoint<FileClock> now() { return FileClock::from_sys(SystemClock::now()); }

  static TimePoint<SystemClock> to_sys(const TimePoint<FileClock>& t)
  {
    return TimePoint<SystemClock>(Duration<i64, Ratio<1, 10000000>>(t.time_since_epoch().count() - FileClock::ticksTo1970));
  }

  static TimePoint<FileClock> from_sys(const TimePoint<SystemClock>& t)
  {
    return TimePoint<FileClock>(Duration<i64, Ratio<1, 10000000>>(t.time_since_epoch().count() + FileClock::ticksTo1970));
  }
};

// d in whole milliseconds, rounded up, for the Windows waits: 0 for a negative d, and below
// 0xFFFFFFFF, which would mean forever.
template<typename Rep, typename Period>
unsigned long waitMilliseconds(const Duration<Rep, Period>& d)
{
  i64 ms = ceil<Milliseconds>(d).count();
  if (ms <= 0)
    return 0;
  if (ms >= 0xFFFFFFFEll)
    return 0xFFFFFFFEul;
  return (unsigned long)ms;
}

// --- Reading a time from text ---

// Reads text by a strftime-style format into the fields of result (what std::get_time does with a
// stream): %Y (the year), %m (the month, 1-12), %d (the day), %H, %M and %S (hour, minute, second),
// %% and plain characters, which must match; a space in the format matches any run of white space.
// Numbers are read in decimal, at most as many digits as the field has (4 for %Y, 2 for the rest).
// Returns whether the whole format matched; the fields read before a mismatch or a specifier it
// does not know keep their values.
bool parseTime(const char* text, const char* format, tm* result)
{
  auto number = [&](i32 maxDigits, i32& value) -> bool
  {
    i32 digits = 0;
    i32 n = 0;
    while (digits < maxDigits && *text >= '0' && *text <= '9')
    {
      n = n * 10 + (*text - '0');
      ++text;
      ++digits;
    }
    if (digits == 0)
      return false;
    value = n;
    return true;
  };
  for (; *format; ++format)
  {
    if (*format == ' ')
    {
      while (*text == ' ' || *text == '\t' || *text == '\n' || *text == '\r')
        ++text;
      continue;
    }
    if (*format != '%')
    {
      if (*text != *format)
        return false;
      ++text;
      continue;
    }
    ++format;
    i32 value = 0;
    switch (*format)
    {
      case 'Y':
        if (!number(4, value))
          return false;
        result->tm_year = value - 1900;
      case 'm':
        if (!number(2, value) || value < 1 || value > 12)
          return false;
        result->tm_mon = value - 1;
      case 'd':
        if (!number(2, value) || value < 1 || value > 31)
          return false;
        result->tm_mday = value;
      case 'H':
        if (!number(2, value) || value > 23)
          return false;
        result->tm_hour = value;
      case 'M':
        if (!number(2, value) || value > 59)
          return false;
        result->tm_min = value;
      case 'S':
        if (!number(2, value) || value > 60)
          return false;
        result->tm_sec = value;
      case '%':
        if (*text != '%')
          return false;
        ++text;
      default:
        return false;
    }
  }
  return true;
}
