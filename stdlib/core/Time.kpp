// Kpp standard library: time (what std::chrono converts to). A Duration<Rep, Period> is a count of
// ticks of Period seconds (a Ratio); Nanoseconds to Hours are the usual ones. A TimePoint<Clock> is
// a Duration since the clock's epoch. SteadyClock never goes back (QueryPerformanceCounter);
// SystemClock is the wall clock (UTC, since 1970, in 100 ns ticks). Specified in
// docs/stdlib/time.md.
extern "C" int QueryPerformanceCounter(int64_t* count);
extern "C" int QueryPerformanceFrequency(int64_t* frequency);
extern "C" void GetSystemTimePreciseAsFileTime(uint64_t* fileTime);

// --- Ratio ---

// The greatest common divisor of a and b, not negative (0 for two zeros); one return expression, so
// that it folds at compile time (Ratio's terms, CommonDuration's period).
constexpr long long ratioGcd(long long a, long long b) { return b == 0 ? (a < 0 ? -a : a) : ratioGcd(b, a % b); }

// A fraction known at compile time (std::ratio): num and den are N/D in lowest terms, den positive.
template<long long N, long long D = 1>
struct Ratio
{
  static constexpr long long num = (D < 0 ? -N : N) / ratioGcd(N, D);
  static constexpr long long den = (D < 0 ? -D : D) / ratioGcd(N, D);
};
using Nano = Ratio<1, 1000000000>;
using Micro = Ratio<1, 1000000>;
using Milli = Ratio<1, 1000>;
using Centi = Ratio<1, 100>;
using Deci = Ratio<1, 10>;
using Kilo = Ratio<1000, 1>;
using Mega = Ratio<1000000, 1>;

// --- Duration ---

template<typename Rep, typename Period = Ratio<1>>
struct Duration
{
  using rep = Rep;
  using period = Period;

  Rep ticks;

  constexpr Duration() : ticks(Rep()) {}
  // From a count of ticks.
  constexpr explicit Duration(Rep count) : ticks(count) {}
  // From another duration, converted to this one's period: implicit when nothing is lost (this Rep
  // is floating point, or the other period is a whole multiple of this one), durationCast otherwise.
  template<typename Rep2, typename Period2> requires (isFloatingPoint<Rep> || (!isFloatingPoint<Rep2> && (Period2::num * Period::den) % (Period2::den * Period::num) == 0))
  implicit Duration(const Duration<Rep2, Period2>& other) : ticks(convertDuration(other, (const Duration<Rep, Period>*)nullptr).ticks) {}

  constexpr Rep count() const { return this->ticks; }
  static constexpr Duration<Rep, Period> zero() { return Duration<Rep, Period>(Rep()); }
  static constexpr Duration<Rep, Period> min() { return Duration<Rep, Period>(Limits<Rep>::lowest()); }
  static constexpr Duration<Rep, Period> max() { return Duration<Rep, Period>(Limits<Rep>::max()); }

  Duration<Rep, Period>& operator++()
  {
    ++this->ticks;
    return *this;
  }
  Duration<Rep, Period>& operator--()
  {
    --this->ticks;
    return *this;
  }
  Duration<Rep, Period>& operator+=(const Duration<Rep, Period>& other)
  {
    this->ticks += other.ticks;
    return *this;
  }
  Duration<Rep, Period>& operator-=(const Duration<Rep, Period>& other)
  {
    this->ticks -= other.ticks;
    return *this;
  }
  Duration<Rep, Period>& operator*=(const Rep& factor)
  {
    this->ticks *= factor;
    return *this;
  }
  Duration<Rep, Period>& operator/=(const Rep& divisor)
  {
    this->ticks /= divisor;
    return *this;
  }

  Duration<Rep, Period> operator+() const { return *this; }
  Duration<Rep, Period> operator-() const { return Duration<Rep, Period>(-this->ticks); }
  // The sum, difference and remainder of two durations of any types are in their common duration
  // (inCommonDuration: Milliseconds + Seconds is Milliseconds), as is the quotient of two, a count.
  template<typename Rep2, typename Period2>
  auto operator+(const Duration<Rep2, Period2>& other) const
  {
    auto sum = inCommonDuration(*this, other);
    sum.ticks += inCommonDuration(other, *this).ticks;
    return sum;
  }
  template<typename Rep2, typename Period2>
  auto operator-(const Duration<Rep2, Period2>& other) const
  {
    auto difference = inCommonDuration(*this, other);
    difference.ticks -= inCommonDuration(other, *this).ticks;
    return difference;
  }
  template<typename Rep2, typename Period2>
  auto operator%(const Duration<Rep2, Period2>& other) const
  {
    auto rest = inCommonDuration(*this, other);
    rest.ticks %= inCommonDuration(other, *this).ticks;
    return rest;
  }
  // How many times other fits in this duration.
  template<typename Rep2, typename Period2>
  auto operator/(const Duration<Rep2, Period2>& other) const
  {
    return inCommonDuration(*this, other).ticks / inCommonDuration(other, *this).ticks;
  }
  // Times or divided by an integer keeps the type; by a floating-point number it counts in double.
  // (Members, one per scalar type: C++ takes any rep, in the common type of the two.)
  Duration<Rep, Period> operator*(int factor) const { return Duration<Rep, Period>(this->ticks * factor); }
  Duration<Rep, Period> operator*(long long factor) const { return Duration<Rep, Period>(this->ticks * factor); }
  Duration<double, Period> operator*(double factor) const { return Duration<double, Period>((double)this->ticks * factor); }
  Duration<Rep, Period> operator/(int divisor) const { return Duration<Rep, Period>(this->ticks / divisor); }
  Duration<Rep, Period> operator/(long long divisor) const { return Duration<Rep, Period>(this->ticks / divisor); }
  Duration<double, Period> operator/(double divisor) const { return Duration<double, Period>((double)this->ticks / divisor); }
  Duration<Rep, Period> operator%(int divisor) const { return Duration<Rep, Period>(this->ticks % divisor); }
  Duration<Rep, Period> operator%(long long divisor) const { return Duration<Rep, Period>(this->ticks % divisor); }
  // Comparisons with a duration of any type, in their common duration.
  template<typename Rep2, typename Period2>
  bool operator==(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) == 0; }
  template<typename Rep2, typename Period2>
  bool operator!=(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) != 0; }
  template<typename Rep2, typename Period2>
  bool operator<(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) < 0; }
  template<typename Rep2, typename Period2>
  bool operator<=(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) <= 0; }
  template<typename Rep2, typename Period2>
  bool operator>(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) > 0; }
  template<typename Rep2, typename Period2>
  bool operator>=(const Duration<Rep2, Period2>& other) const { return compareDurations(*this, other) >= 0; }
};

// d in the duration type of target (which is only read for its type): exact when that is possible,
// truncated toward zero for an integer rep otherwise (durationCast's rule).
template<typename ToRep, typename ToPeriod, typename Rep, typename Period>
Duration<ToRep, ToPeriod> convertDuration(const Duration<Rep, Period>& d, const Duration<ToRep, ToPeriod>* target)
{
  // The factor (Period::num / Period::den) / (ToPeriod::num / ToPeriod::den), reduced.
  long long multiplier = Period::num * ToPeriod::den;
  long long divisor = Period::den * ToPeriod::num;
  long long common = ratioGcd(multiplier, divisor);
  multiplier /= common;
  divisor /= common;
  if constexpr (isFloatingPoint<ToRep> || isFloatingPoint<Rep>)
    return Duration<ToRep, ToPeriod>((ToRep)((double)d.ticks * (double)multiplier / (double)divisor));
  else if (divisor == 1)
    return Duration<ToRep, ToPeriod>((ToRep)((long long)d.ticks * multiplier));
  else
    return Duration<ToRep, ToPeriod>((ToRep)((long long)d.ticks * multiplier / divisor));
}

using Nanoseconds = Duration<long long, Nano>;
using Microseconds = Duration<long long, Micro>;
using Milliseconds = Duration<long long, Milli>;
using Seconds = Duration<long long>;
using Minutes = Duration<long long, Ratio<60>>;
using Hours = Duration<long long, Ratio<3600>>;
using Days = Duration<long long, Ratio<86400>>;

// d in To's period (std::chrono::duration_cast): truncated toward zero for an integer To.
template<typename To, typename Rep, typename Period>
To durationCast(const Duration<Rep, Period>& d)
{
  return convertDuration(d, (const To*)nullptr);
}
// Rounded down, up, and to the nearest (ties to even) instead of toward zero.
template<typename To, typename Rep, typename Period>
To floor(const Duration<Rep, Period>& d)
{
  To t = durationCast<To>(d);
  if (Duration<double, Nano>(t) > Duration<double, Nano>(d))
    t -= To(1);
  return t;
}
template<typename To, typename Rep, typename Period>
To ceil(const Duration<Rep, Period>& d)
{
  To t = durationCast<To>(d);
  if (Duration<double, Nano>(t) < Duration<double, Nano>(d))
    t += To(1);
  return t;
}

// A number times a duration, as the duration times the number.
template<typename R, typename P>
Duration<R, P> operator*(int factor, const Duration<R, P>& d) { return d * factor; }
template<typename R, typename P>
Duration<R, P> operator*(long long factor, const Duration<R, P>& d) { return d * factor; }
template<typename R, typename P>
Duration<double, P> operator*(double factor, const Duration<R, P>& d) { return d * factor; }

// a in the common duration of a and b (std::common_type of two durations), which both convert to
// without loss: its rep is the type of the sum of the two reps, its period the greatest that divides
// both periods, so the finer of the two when the other is a whole multiple of it (Milliseconds and
// Seconds: Milliseconds, as for every two of the standard durations), else the fraction
// gcd(numerators) / lcm(denominators) (Ratio<1, 2> and Ratio<1, 3>: Ratio<1, 6>).
template<typename R1, typename P1, typename R2, typename P2>
auto inCommonDuration(const Duration<R1, P1>& a, const Duration<R2, P2>& b)
{
  if constexpr ((P2::num * P1::den) % (P2::den * P1::num) == 0)
    return Duration<decltype(a.ticks + b.ticks), P1>(a);
  else if constexpr ((P1::num * P2::den) % (P1::den * P2::num) == 0)
    return Duration<decltype(a.ticks + b.ticks), P2>(a);
  else // (the call in parentheses: written bare, kppc reads it as a function type)
    return Duration<decltype(a.ticks + b.ticks), Ratio<(ratioGcd(P1::num, P2::num)), P1::den / ratioGcd(P1::den, P2::den) * P2::den>>(a);
}

// The ticks of a and b in their common duration, compared.
template<typename R1, typename P1, typename R2, typename P2>
int compareDurations(const Duration<R1, P1>& a, const Duration<R2, P2>& b)
{
  auto x = inCommonDuration(a, b);
  auto y = inCommonDuration(b, a);
  return x.ticks < y.ticks ? -1 : y.ticks < x.ticks ? 1 : 0;
}
// --- TimePoint and the clocks ---

// A point in time of Clock: a Duration since the clock's epoch.
template<typename Clock, typename Dur = typename Clock::duration>
struct TimePoint
{
  using clock = Clock;
  using duration = Dur;
  using rep = typename Dur::rep;
  using period = typename Dur::period;

  Dur sinceEpoch;

  constexpr TimePoint() {}
  constexpr explicit TimePoint(const Dur& sinceEpoch) : sinceEpoch(sinceEpoch) {}
  // From a time point of the same clock in another duration, when nothing is lost.
  template<typename Dur2>
  implicit TimePoint(const TimePoint<Clock, Dur2>& other) : sinceEpoch(other.sinceEpoch) {}

  constexpr Dur time_since_epoch() const { return this->sinceEpoch; }
  static constexpr TimePoint<Clock, Dur> min() { return TimePoint<Clock, Dur>(Dur::min()); }
  static constexpr TimePoint<Clock, Dur> max() { return TimePoint<Clock, Dur>(Dur::max()); }

  TimePoint<Clock, Dur>& operator+=(const Dur& d)
  {
    this->sinceEpoch += d;
    return *this;
  }
  TimePoint<Clock, Dur>& operator-=(const Dur& d)
  {
    this->sinceEpoch -= d;
    return *this;
  }
  // A time point plus or minus a duration, and the difference of two time points of the clock, are
  // in the common duration of the two (a SteadyClock time point plus Milliseconds counts in
  // nanoseconds; a Seconds one plus Milliseconds in milliseconds). The operators are members, so
  // that their types come from the class (`durationCast<Milliseconds>(end - start)`).
  template<typename R, typename P>
  auto operator+(const Duration<R, P>& d) const
  {
    auto sinceEpoch = this->sinceEpoch + d;
    return TimePoint<Clock, decltype(sinceEpoch)>(sinceEpoch);
  }
  template<typename R, typename P>
  auto operator-(const Duration<R, P>& d) const
  {
    auto sinceEpoch = this->sinceEpoch - d;
    return TimePoint<Clock, decltype(sinceEpoch)>(sinceEpoch);
  }
  template<typename Dur2>
  auto operator-(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch - other.sinceEpoch; }
  // Comparisons with a time point of the clock in any duration.
  template<typename Dur2>
  bool operator==(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch == other.sinceEpoch; }
  template<typename Dur2>
  bool operator!=(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch != other.sinceEpoch; }
  template<typename Dur2>
  bool operator<(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch < other.sinceEpoch; }
  template<typename Dur2>
  bool operator<=(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch <= other.sinceEpoch; }
  template<typename Dur2>
  bool operator>(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch > other.sinceEpoch; }
  template<typename Dur2>
  bool operator>=(const TimePoint<Clock, Dur2>& other) const { return this->sinceEpoch >= other.sinceEpoch; }
};

// A duration plus a time point, as the time point plus the duration.
template<typename R, typename P, typename C, typename D>
auto operator+(const Duration<R, P>& d, const TimePoint<C, D>& t) { return t + d; }

// t in another duration of the same clock (std::chrono::time_point_cast).
template<typename To, typename C, typename D>
TimePoint<C, To> timePointCast(const TimePoint<C, D>& t) { return TimePoint<C, To>(durationCast<To>(t.sinceEpoch)); }

int64_t steadyClockFrequency = 0; // QueryPerformanceCounter's counts per second, read once

// A monotonic clock in nanoseconds (std::chrono::steady_clock; also high_resolution_clock).
struct SteadyClock
{
  using rep = long long;
  using period = Nano;
  using duration = Nanoseconds;
  using time_point = TimePoint<SteadyClock>;
  static constexpr bool is_steady = true;

  static TimePoint<SteadyClock> now()
  {
    if (steadyClockFrequency == 0)
      QueryPerformanceFrequency(&steadyClockFrequency);
    int64_t counter = 0;
    QueryPerformanceCounter(&counter);
    // Split to keep the multiplication within 64 bits for long uptimes.
    int64_t whole = counter / steadyClockFrequency;
    int64_t rest = counter % steadyClockFrequency;
    return TimePoint<SteadyClock>(Nanoseconds(whole * 1000000000 + rest * 1000000000 / steadyClockFrequency));
  }
};
using HighResolutionClock = SteadyClock;

// The wall clock (std::chrono::system_clock): UTC since 1970-01-01, in 100 ns ticks; it can jump
// when the system time is set.
struct SystemClock
{
  using rep = long long;
  using period = Ratio<1, 10000000>;
  using duration = Duration<long long, Ratio<1, 10000000>>;
  using time_point = TimePoint<SystemClock>;
  static constexpr bool is_steady = false;

  static TimePoint<SystemClock> now()
  {
    uint64_t fileTime = 0; // 100 ns ticks since 1601-01-01
    GetSystemTimePreciseAsFileTime(&fileTime);
    return TimePoint<SystemClock>(Duration<long long, Ratio<1, 10000000>>((long long)fileTime - 116444736000000000ll));
  }
  // Whole seconds since 1970 (time_t), rounded toward negative infinity, and back.
  static long long to_time_t(const TimePoint<SystemClock>& t)
  {
    long long ticks = t.sinceEpoch.ticks;
    return ticks >= 0 ? ticks / 10000000 : -((-ticks + 9999999) / 10000000);
  }
  static TimePoint<SystemClock> from_time_t(long long seconds) { return TimePoint<SystemClock>(Duration<long long, Ratio<1, 10000000>>(seconds * 10000000)); }
};

// d in whole milliseconds, rounded up, for the Windows waits: 0 for a negative d, and below
// 0xFFFFFFFF, which would mean forever.
template<typename Rep, typename Period>
unsigned long waitMilliseconds(const Duration<Rep, Period>& d)
{
  long long ms = ceil<Milliseconds>(d).count();
  if (ms <= 0)
    return 0;
  if (ms >= 0xFFFFFFFEll)
    return 0xFFFFFFFEul;
  return (unsigned long)ms;
}

// --- Reading a time from text ---

// Reads text by a strftime-style format into the fields of result (what std::get_time does with a
// stream): %Y (the year), %m (the month, 1-12), %d (the day), %H, %M and %S (hour, minute, second),
// %% and plain characters, which must match; a space in the format matches any run of white space.
// Numbers are read in decimal, at most as many digits as the field has (4 for %Y, 2 for the rest).
// Returns whether the whole format matched; the fields read before a mismatch or a specifier it
// does not know keep their values.
bool parseTime(const char* text, const char* format, tm* result)
{
  auto number = [&](int maxDigits, int& value) -> bool
  {
    int digits = 0;
    int n = 0;
    while (digits < maxDigits && *text >= '0' && *text <= '9')
    {
      n = n * 10 + (*text - '0');
      ++text;
      ++digits;
    }
    if (digits == 0)
      return false;
    value = n;
    return true;
  };
  for (; *format; ++format)
  {
    if (*format == ' ')
    {
      while (*text == ' ' || *text == '\t' || *text == '\n' || *text == '\r')
        ++text;
      continue;
    }
    if (*format != '%')
    {
      if (*text != *format)
        return false;
      ++text;
      continue;
    }
    ++format;
    int value = 0;
    switch (*format)
    {
      case 'Y':
        if (!number(4, value))
          return false;
        result->tm_year = value - 1900;
        break;
      case 'm':
        if (!number(2, value) || value < 1 || value > 12)
          return false;
        result->tm_mon = value - 1;
        break;
      case 'd':
        if (!number(2, value) || value < 1 || value > 31)
          return false;
        result->tm_mday = value;
        break;
      case 'H':
        if (!number(2, value) || value > 23)
          return false;
        result->tm_hour = value;
        break;
      case 'M':
        if (!number(2, value) || value > 59)
          return false;
        result->tm_min = value;
        break;
      case 'S':
        if (!number(2, value) || value > 60)
          return false;
        result->tm_sec = value;
        break;
      case '%':
        if (*text != '%')
          return false;
        ++text;
        break;
      default:
        return false;
    }
  }
  return true;
}
