// Kpp standard library: Optional<T>, a value that may be absent. Specified in
// docs/stdlib/optional.md. The value is stored inline and default-constructed while absent (raw
// storage needs alignas on a template's member, which the compiler does not honour yet; see
// docs/stdlib-conformance.md); giving the value up assigns T() so that it releases what it held.
struct NullOpt {};
const NullOpt nullopt;

// What value() throws on an empty Optional.
struct BadOptionalAccess : Exception
{
  BadOptionalAccess() : Exception(String("bad optional access")) {}
};

template<typename T>
struct Optional
{
  T stored;
  bool present = false;

  Optional() {}
  implicit Optional(NullOpt) {}
  implicit Optional(const T& v) : stored(v), present(true) {}
  implicit Optional(T&& v) : stored(move(v)), present(true) {}

  Optional<T>& operator=(NullOpt)
  {
    this->reset();
    return *this;
  }
  Optional<T>& operator=(const T& v)
  {
    this->stored = v;
    this->present = true;
    return *this;
  }
  Optional<T>& operator=(T&& v)
  {
    this->stored = move(v);
    this->present = true;
    return *this;
  }

  // Comparisons with a value: an absent optional equals nothing.
  bool operator==(const T& v) const { return this->present && this->stored == v; }
  bool operator!=(const T& v) const { return !this->present || !(this->stored == v); }
  bool operator==(const Optional<T>& other) const
  {
    if (this->present != other.present)
      return false;
    return !this->present || this->stored == other.stored;
  }
  bool operator!=(const Optional<T>& other) const { return !(*this == other); }
  bool operator==(NullOpt) const { return !this->present; }
  bool operator!=(NullOpt) const { return this->present; }
  // An absent optional orders before every present one.
  bool operator<(const Optional<T>& other) const
  {
    if (!other.present)
      return false;
    return !this->present || this->stored < other.stored;
  }

  bool hasValue() const { return this->present; }
  bool has_value() const { return this->present; }
  explicit operator bool() const { return this->present; }
  bool operator!() const { return !this->present; }
  T& get() { return this->stored; }
  const T& get() const { return this->stored; }
  T& value()
  {
    if (!this->present)
      throw BadOptionalAccess();
    return this->stored;
  }
  const T& value() const
  {
    if (!this->present)
      throw BadOptionalAccess();
    return this->stored;
  }
  T& operator*() { return this->stored; }
  const T& operator*() const { return this->stored; }
  T* operator->() { return &this->stored; }
  const T* operator->() const { return &this->stored; }
  T valueOr(const T& fallback) const
  {
    if (this->present)
      return this->stored;
    return fallback;
  }
  // Builds the value in place from the arguments (std::optional's emplace): the old value is
  // destroyed first, and nothing is assigned.
  template<typename... Args>
  T& emplace(Args&&... args)
  {
    this->stored.~T();
    new (&this->stored) T(forward<Args>(args)...);
    this->present = true;
    return this->stored;
  }
  void set(const T& v)
  {
    this->stored = v;
    this->present = true;
  }
  // Gives the value up: it is destroyed at once (and a default T takes its place in the storage).
  void reset()
  {
    if (this->present)
    {
      this->stored.~T();
      new (&this->stored) T();
    }
    this->present = false;
  }
  void clear() { this->reset(); }
  void swap(Optional<T>& other)
  {
    Optional<T> held = move(*this);
    *this = move(other);
    other = move(held);
  }

  // Unchecked access (Factorio's operator~ on Optional).
  T& operator~() { return this->stored; }
  const T& operator~() const { return this->stored; }

  // Sentinel for types using MAKE_OPTIONAL; returns default T.
  static constexpr T emptyValue() { return T(); }
};

template<typename T>
Optional<T> makeOptional(const T& value) { return Optional<T>(value); }

// The generated `E::fromStr(text)` of a Kpp enum (design.md 8.4): the value whose str() is text,
// or none. The compiler lowers E::fromStr to this function.
template<typename E>
Optional<E> enumFromStr(const char* text)
{
  for (E value : E::values)
    if (strcmp(value.str(), text) == 0)
      return Optional<E>(value);
  return Optional<E>();
}
