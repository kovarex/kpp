// Kpp standard library: Optional<T>, a value that may be absent. Specified in
// docs/stdlib/optional.md. The value lives in storage inside the Optional (a union's, so T's size
// and alignment): it is constructed when the Optional gets one and destroyed when it gives it up,
// and an empty Optional holds no T.
struct NullOpt {};
const NullOpt nullopt;

// Whether T is an Optional (what Optional's comparisons with a value leave out).
template<typename T>
struct IsOptional { static constexpr bool value = false; };
template<typename T>
struct IsOptional<Optional<T>> { static constexpr bool value = true; };
// What asks Optional's constructor to build the value in place (std::in_place).
struct InPlaceTag {};
const InPlaceTag inPlace;

// What value() throws on an empty Optional.
struct BadOptionalAccess : Exception
{
  BadOptionalAccess() : Exception(String("bad optional access")) {}
};

// Storage for a T with T's size and alignment, which constructs nothing itself (a union's member
// is not constructed with the union): Optional builds its value in it and destroys it there.
// OptionalStorage is for a trivially destructible T (its destructor stays trivial),
// OptionalOwningStorage for the others.
template<typename T>
union OptionalStorage
{
  T value;
  OptionalStorage() {}
};
template<typename T>
union OptionalOwningStorage
{
  T value;
  OptionalOwningStorage() {}
  ~OptionalOwningStorage() {}
};

// An Optional's value and whether it is there, with their copies, moves and destruction as
// std::optional has them: trivial when T's are (an Optional of a trivially copyable T is
// trivially copyable; of a trivially destructible T, trivially destructible). Otherwise a copy or
// a move constructs the value when the source holds one, and an assignment assigns it when both
// hold one, constructs it when only the source does and destroys it when only the target does.
// (Three class templates chosen by OptionalValue, not one with partial specializations: a class
// derived from a partial specialization gets the primary template's copies and moves,
// templates/partial_specialization_special_members.)
template<typename T>
struct OptionalTrivialValue
{
  OptionalStorage<T> storage;
  bool present = false;
};
template<typename T>
struct OptionalCopiedValue
{
  OptionalStorage<T> storage;
  bool present = false;

  OptionalCopiedValue() {}
  OptionalCopiedValue(const OptionalCopiedValue<T>& other) : present(other.present)
  {
    if (other.present)
      new (&this->storage.value) T(other.storage.value);
  }
  // The value moved over; the source keeps its state (present, with a moved-from value).
  OptionalCopiedValue(OptionalCopiedValue<T>&& other) : present(other.present)
  {
    if (other.present)
      new (&this->storage.value) T(move(other.storage.value));
  }
  OptionalCopiedValue<T>& operator=(const OptionalCopiedValue<T>& other)
  {
    optionalAssign<T>(*this, other.present, other.storage.value);
    return *this;
  }
  OptionalCopiedValue<T>& operator=(OptionalCopiedValue<T>&& other)
  {
    optionalAssign<T>(*this, other.present, move(other.storage.value));
    return *this;
  }
};
template<typename T>
struct OptionalOwnedValue
{
  OptionalOwningStorage<T> storage;
  bool present = false;

  OptionalOwnedValue() {}
  OptionalOwnedValue(const OptionalOwnedValue<T>& other) : present(other.present)
  {
    if (other.present)
      new (&this->storage.value) T(other.storage.value);
  }
  OptionalOwnedValue(OptionalOwnedValue<T>&& other) : present(other.present)
  {
    if (other.present)
      new (&this->storage.value) T(move(other.storage.value));
  }
  ~OptionalOwnedValue()
  {
    if (this->present)
      this->storage.value.~T();
  }
  OptionalOwnedValue<T>& operator=(const OptionalOwnedValue<T>& other)
  {
    optionalAssign<T>(*this, other.present, other.storage.value);
    return *this;
  }
  OptionalOwnedValue<T>& operator=(OptionalOwnedValue<T>&& other)
  {
    optionalAssign<T>(*this, other.present, move(other.storage.value));
    return *this;
  }
};
template<typename T>
using OptionalValue = Conditional<isTriviallyCopyable<T>, OptionalTrivialValue<T>,
                                  Conditional<isTriviallyDestructible<T>, OptionalCopiedValue<T>, OptionalOwnedValue<T>>>;

// Gives target the source's state: a source value (when present) is assigned over target's or
// constructed in it; no source value destroys target's.
template<typename T, typename O, typename V>
void optionalAssign(O& target, bool present, V&& value)
{
  if (present)
  {
    if (target.present)
      target.storage.value = forward<V>(value);
    else
    {
      new (&target.storage.value) T(forward<V>(value));
      target.present = true;
    }
  }
  else if (target.present)
  {
    target.present = false;
    target.storage.value.~T();
  }
}

template<typename T>
struct Optional : OptionalValue<T>
{
  T* slot() { return &this->storage.value; }
  const T* slot() const { return &this->storage.value; }

  Optional() {}
  implicit Optional(NullOpt) {}
  implicit Optional(const T& v)
  {
    new (this->slot()) T(v);
    this->present = true;
  }
  implicit Optional(T&& v)
  {
    new (this->slot()) T(move(v));
    this->present = true;
  }
  // From a value of another type a T is built from (std::optional's converting constructor),
  // explicit when only an explicit constructor of T takes it:
  // `Optional<ActionData::SetupBlueprintData>(*parameters)` from a SetupBlueprintParameters.
  template<typename U = T>
  explicit(!isConvertible<U, T>) Optional(U&& v)
    requires(!isSame<RemoveCvRef<U>, T> && !isSame<RemoveCvRef<U>, InPlaceTag> && !isSame<RemoveCvRef<U>, NullOpt> &&
             !IsOptional<RemoveCvRef<U>>::value && isConstructible<T, U>)
  {
    new (this->slot()) T(forward<U>(v));
    this->present = true;
  }
  // From an Optional of another type whose value converts (std::optional's converting
  // constructor), empty from empty: an Optional<const Territory*> from an Optional<Territory*>.
  template<typename U> requires(!isSame<U, T> && isConvertible<const U&, T>)
  implicit Optional(const Optional<U>& other)
  {
    if (other.hasValue())
    {
      new (this->slot()) T(*other.slot());
      this->present = true;
    }
  }
  // The value built from the arguments, in place (std::optional's in_place_t constructor).
  template<typename... Args>
  explicit Optional(InPlaceTag, Args&&... args)
  {
    new (this->slot()) T(forward<Args>(args)...);
    this->present = true;
  }

  Optional<T>& operator=(NullOpt)
  {
    this->reset();
    return *this;
  }
  Optional<T>& operator=(const T& v)
  {
    if (this->present)
      *this->slot() = v;
    else
    {
      new (this->slot()) T(v);
      this->present = true;
    }
    return *this;
  }
  Optional<T>& operator=(T&& v)
  {
    if (this->present)
      *this->slot() = move(v);
    else
    {
      new (this->slot()) T(move(v));
      this->present = true;
    }
    return *this;
  }

  // Comparisons with a value of any type the held one compares with (`source == entity` for an
  // Optional<Targeter<Entity>>, `maxSpeed <= 0`): an empty Optional equals no value and orders
  // before every value.
  template<typename U>
  bool operator==(const U& v) const requires(!IsOptional<U>::value && !isSame<U, NullOpt>) { return this->present && *this->slot() == v; }
  template<typename U>
  strong_ordering operator<=>(const U& v) const requires(!IsOptional<U>::value && !isSame<U, NullOpt>)
  {
    return this->present ? synthThreeWay(*this->slot(), v) : strong_ordering::less;
  }
  bool operator==(const Optional<T>& other) const
  {
    if (this->present != other.present)
      return false;
    return !this->present || *this->slot() == *other.slot();
  }
  bool operator!=(const Optional<T>& other) const { return !(*this == other); }
  bool operator==(NullOpt) const { return !this->present; }
  bool operator!=(NullOpt) const { return this->present; }
  // An absent optional orders before every present one.
  bool operator<(const Optional<T>& other) const
  {
    if (!other.present)
      return false;
    return !this->present || *this->slot() < *other.slot();
  }
  strong_ordering operator<=>(const Optional<T>& other) const
  {
    if (this->present && other.present)
      return synthThreeWay(*this->slot(), *other.slot());
    return this->present ? strong_ordering::greater : other.present ? strong_ordering::less : strong_ordering::equal;
  }

  bool hasValue() const { return this->present; }
  bool has_value() const { return this->present; }
  explicit operator bool() const { return this->present; }
  bool operator!() const { return !this->present; }
  T& value()
  {
    if (!this->present)
      throw BadOptionalAccess();
    return *this->slot();
  }
  const T& value() const
  {
    if (!this->present)
      throw BadOptionalAccess();
    return *this->slot();
  }
  // The value, unchecked: on an empty Optional the program is wrong.
  T& operator*() { return *this->slot(); }
  const T& operator*() const { return *this->slot(); }
  T* operator->() { return this->slot(); }
  const T* operator->() const { return this->slot(); }
  T valueOr(const T& fallback) const
  {
    if (this->present)
      return *this->slot();
    return fallback;
  }
  // Builds the value in place from the arguments (std::optional's emplace): the old value is
  // destroyed first, and nothing is assigned.
  template<typename... Args>
  T& emplace(Args&&... args)
  {
    this->reset();
    new (this->slot()) T(forward<Args>(args)...);
    this->present = true;
    return *this->slot();
  }
  // Gives the value up: it is destroyed at once.
  void reset()
  {
    if (this->present)
    {
      this->present = false;
      this->slot()->~T();
    }
  }
  void swap(Optional<T>& other)
  {
    Optional<T> held = move(*this);
    *this = move(other);
    other = move(held);
  }

  // Kept from the game's own Optional (not in the specification): get() and operator~ are the
  // unchecked value, set(v) assigns, clear() resets, emptyValue() is T().
  T& get() { return *this->slot(); }
  const T& get() const { return *this->slot(); }
  void set(const T& v) { *this = v; }
  void clear() { this->reset(); }
  T& operator~() { return *this->slot(); }
  const T& operator~() const { return *this->slot(); }
  static constexpr T emptyValue() { return T(); }
};

template<typename T>
Optional<T> makeOptional(const T& value) { return Optional<T>(value); }
// An Optional<T> holding a T built from the arguments (std::make_optional<T>(args...)).
template<typename T, typename... Args>
Optional<T> makeOptional(Args&&... args) { return Optional<T>(inPlace, forward<Args>(args)...); }

// The generated `E::fromStr(text)` of a Kpp enum (design.md 8.4): the value whose str() is text,
// or none. The compiler lowers E::fromStr to this function.
template<typename E>
Optional<E> enumFromStr(const char* text)
{
  for (E value : E::values)
    if (strcmp(value.str(), text) == 0)
      return Optional<E>(value);
  return Optional<E>();
}
