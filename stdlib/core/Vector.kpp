// kpp standard library: Vector<T>. A growable array. Elements that shift for an insert or an erase
// are move-assigned, as std's (those an insert moves past the end are move constructed), and a T
// without move assignment is relocated (move constructor, then destructor); when the buffer grows, as
// in std::vector's reallocation, by move_if_noexcept: a copyable T whose move constructor may throw
// is copied. Appending grows the capacity geometrically, reserve() exactly.
template<typename T>
class Vector
{
public:
  using iterator = T*;
  using const_iterator = const T*;
  using reverse_iterator = ReverseIterator<T*>;
  using const_reverse_iterator = ReverseIterator<const T*>;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  Vector() {}

  // count default-constructed elements.
  Vector(ContainerSize count) : Vector()
  {
    // The elements are made in their place, so T needs no copy or move (as for std::vector(n)):
    // TypeAwareMemoryPool keeps Vectors of SpriteRegistration, which has neither.
    if (count == 0)
      return;
    if (count > maxContainerSize)
      throwLengthError("vector too long");
    this.items = allocateArray<T>(count);
    this.allocated = count;
    for (; this.length < count; ++this.length)
      new (this.items + this.length) T();
  }

  // `Vector<int> primes = {2, 3, 5, 7};`
  implicit Vector(InitializerList<T> list) : Vector()
  {
    this.reserve(list.size());
    for (const T& item : list)
      this.push_back(item);
  }

  Vector(const Vector<T>& other) : Vector() { this.appendCopies(other.items, other.length); }
  // count copies of value.
  Vector(ContainerSize count, const T& value) : Vector() { this.assign(count, value); }
  // Copies of [first, last).
  Vector(const T* first, const T* last) : Vector() { this.appendCopies(first, checkedSize(last - first, "vector too long")); }
  // The elements of [first, last), input iterators of any kind (`Vector<TransportLine*>
  // sorted(lines.begin(), lines.end())` from a HashSet), as insert(end(), first, last).
  template<typename InputIt> requires (!isIntegral<InputIt>)
  Vector(InputIt first, InputIt last) : Vector() { this.insert(this.items, first, last); }

  Vector(Vector<T>&& other) noexcept : items(other.items), length(other.length), allocated(other.allocated)
  {
    other.items = nullptr;
    other.length = 0;
    other.allocated = 0;
  }

  ~Vector()
  {
    this.clear();
    if (this.items)
      free(this.items);
  }

  Vector<T>& operator=(const Vector<T>& other)
  {
    if (&this == &other)
      return this;
    this.assignCopies(other.items, other.length);
    return this;
  }

  Vector<T>& operator=(Vector<T>&& other) noexcept
  {
    if (&this == &other)
      return this;
    this.clear();
    if (this.items)
      free(this.items);
    this.items = other.items;
    this.length = other.length;
    this.allocated = other.allocated;
    other.items = nullptr;
    other.length = 0;
    other.allocated = 0;
    return this;
  }

  // `v = {a, b, c}`: the listed elements, as assign({...}).
  Vector<T>& operator=(InitializerList<T> list)
  {
    this.assign(list);
    return this;
  }

  ContainerSize size() const { return this.length; }
  ContainerSize capacity() const { return this.allocated; }
  T* data() { return this.items; }
  const T* data() const { return this.items; }
  bool empty() const { return this.length == 0; }

  T& operator[](ContainerSize index)
  {
    assert(index < this.length);
    return this.items[index];
  }

  const T& operator[](ContainerSize index) const
  {
    assert(index < this.length);
    return this.items[index];
  }

  T& back()
  {
    assert(this.length > 0);
    return this.items[this.length - 1];
  }

  const T& back() const
  {
    assert(this.length > 0);
    return this.items[this.length - 1];
  }

  T* begin() { return this.items; }
  T* end() { return this.items + this.length; }
  const T* begin() const { return this.items; }
  const T* end() const { return this.items + this.length; }
  const T* cbegin() const { return this.items; }
  const T* cend() const { return this.items + this.length; }
  ReverseIterator<T*> rbegin() { return ReverseIterator<T*>(this.items + this.length); }
  ReverseIterator<T*> rend() { return ReverseIterator<T*>(this.items); }
  ReverseIterator<const T*> rbegin() const { return ReverseIterator<const T*>(this.items + this.length); }
  ReverseIterator<const T*> rend() const { return ReverseIterator<const T*>(this.items); }
  ReverseIterator<const T*> crbegin() const { return ReverseIterator<const T*>(this.items + this.length); }
  ReverseIterator<const T*> crend() const { return ReverseIterator<const T*>(this.items); }

  // Lets go of unused capacity: afterwards capacity() == size().
  void shrink_to_fit()
  {
    if (this.allocated == this.length)
      return;
    if (this.length == 0)
    {
      free(this.items);
      this.items = nullptr;
      this.allocated = 0;
      return;
    }
    this.moveToBlock(this.length);
  }

  // By hand, not by ::swap: kpp checks this member for every Vector<T>, and ::swap of the block pointer
  // was swap<T*> and move<T*&> for every element type.
  void swap(Vector<T>& other) noexcept
  {
    T* block = this.items;
    this.items = other.items;
    other.items = block;
    ContainerSize count = this.length;
    this.length = other.length;
    other.length = count;
    ContainerSize capacity = this.allocated;
    this.allocated = other.allocated;
    other.allocated = capacity;
  }

  // Replaces the contents with count copies of value (which may be an element) / with copies of
  // [first, last) (which must not be elements).
  // As std::vector's: copy-assigned over the elements there are, copies built after them or the
  // rest destroyed; value may be an element.
  void assign(ContainerSize count, const T& value)
  {
    if (count > this.allocated)
    {
      T copy(value);
      this.clear();
      this.reserve(count);
      for (; this.length < count; ++this.length)
        new (this.items + this.length) T(copy);
      return;
    }
    ContainerSize common = count < this.length ? count : this.length;
    for (ContainerSize i = 0; i < common; ++i)
      this.items[i] = value;
    for (; this.length < count; ++this.length)
      new (this.items + this.length) T(value);
    this.truncate(count);
  }

  void assign(const T* first, const T* last) { this.assignCopies(first, checkedSize(last - first, "vector too long")); }

  // The elements of [first, last), input iterators of any kind (ResearchQueue's
  // `queue.assign(other.queue.begin(), other.queue.end())`); they must not point into this vector.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  void assign(InputIt first, InputIt last)
  {
    if constexpr (requires { this.items[0] = *first; })
    {
      ContainerSize index = 0;
      for (; index < this.length && first != last; ++index, ++first)
        this.items[index] = *first;
      this.truncate(index);
    }
    else
      this.clear();
    this.insert(this.items + this.length, first, last);
  }

  void assign(InitializerList<T> list) { this.assignCopies(list.begin(), list.size()); }

  // Room for `needed` elements, exactly; LengthError past maxContainerSize.
  void reserve(ContainerSize needed)
  {
    if (needed > maxContainerSize)
      throwLengthError("vector too long");
    if (needed > this.allocated)
      this.moveToBlock(needed);
  }

  // The value may be an element of this vector: v.push_back(v[0]) is fine.
  void push_back(const T& value)
  {
    if (this.length < this.allocated)
      new (this.items + this.length) T(value);
    else if constexpr (isNothrowMoveConstructible<T> || isNothrowCopyConstructible<T>)
    {
      ContainerSize newCapacity = this.capacityFor((u64)this.length + 1);
      T* grown = allocateArray<T>(newCapacity);
      OwnedBlock block(grown);
      new (grown + this.length) T(value);
      block.release();
      this.adoptBlock(grown, newCapacity);
    }
    else
    {
      this.appendGrown(value);
      return;
    }
    ++this.length;
  }

  void push_back(T&& value)
  {
    if (this.length < this.allocated)
      new (this.items + this.length) T(move(value));
    else if constexpr (isNothrowMoveConstructible<T> || isNothrowCopyConstructible<T>)
    {
      ContainerSize newCapacity = this.capacityFor((u64)this.length + 1);
      T* grown = allocateArray<T>(newCapacity);
      OwnedBlock block(grown);
      new (grown + this.length) T(move(value));
      block.release();
      this.adoptBlock(grown, newCapacity);
    }
    else
    {
      this.appendGrown(move(value));
      return;
    }
    ++this.length;
  }

  // Builds the new element in place from the arguments.
  template<typename... Args>
  T& emplace_back(Args&&... args)
  {
    if (this.length < this.allocated)
      new (this.items + this.length) T(forward<Args>(args)...);
    else if constexpr (isNothrowMoveConstructible<T> || isNothrowCopyConstructible<T>)
    {
      ContainerSize newCapacity = this.capacityFor((u64)this.length + 1);
      T* grown = allocateArray<T>(newCapacity);
      OwnedBlock block(grown);
      new (grown + this.length) T(forward<Args>(args)...);
      block.release();
      this.adoptBlock(grown, newCapacity);
    }
    else
    {
      this.appendGrown(forward<Args>(args)...);
      return this.items[this.length - 1];
    }
    ++this.length;
    return this.items[this.length - 1];
  }

  T& front()
  {
    assert(this.length > 0);
    return this.items[0];
  }

  const T& front() const
  {
    assert(this.length > 0);
    return this.items[0];
  }

  // New elements are default-constructed (zero for numbers).
  void resize(ContainerSize newLength)
  {
    if (newLength <= this.length)
    {
      this.truncate(newLength);
      return;
    }
    this.ensureRoom(newLength);
    if constexpr (isNothrowDefaultConstructible<T>)
    {
      for (; this.length < newLength; ++this.length)
        new (this.items + this.length) T();
    }
    else
    {
      BuiltObjects built(destroyObjects<T>);
      while (built.count() < i64(newLength - this.length))
        built.add(new (this.items + this.length + built.count()) T());
      built.keep();
      this.length = newLength;
    }
  }

  // New elements are copies of value.
  void resize(ContainerSize newLength, const T& value)
  {
    if (newLength <= this.length)
    {
      this.truncate(newLength);
      return;
    }
    T copy(value); // value may be an element, and the elements may move
    this.ensureRoom(newLength);
    if constexpr (isNothrowCopyConstructible<T>)
    {
      for (; this.length < newLength; ++this.length)
        new (this.items + this.length) T(copy);
    }
    else
    {
      BuiltObjects built(destroyObjects<T>);
      while (built.count() < i64(newLength - this.length))
        built.add(new (this.items + this.length + built.count()) T(copy));
      built.keep();
      this.length = newLength;
    }
  }

  // Throws OutOfRange for an index outside [0, size()).
  T& at(ContainerSize index)
  {
    if (index >= this.length)
      throwOutOfRange("Vector::at: index out of range");
    return this.items[index];
  }

  const T& at(ContainerSize index) const
  {
    if (index >= this.length)
      throwOutOfRange("Vector::at: index out of range");
    return this.items[index];
  }

  // Inserts before the element position points at (begin()/end() and what find functions return,
  // const or not). The work is here, not in the index forms, which are templates: a member that called
  // one instantiated it for every element type.
  T* insert(const T* position, const T& value)
  {
    ContainerSize index = ContainerSize(position - this.items);
    if (index == this.length)
      this.push_back(value);
    else
    {
      T copy(value); // value may be an element, which the insertion moves
      this.insertOne(index, copy);
    }
    return this.items + index;
  }

  T* insert(const T* position, T&& value)
  {
    ContainerSize index = ContainerSize(position - this.items);
    if (index == this.length)
      this.push_back(move(value));
    else
      this.insertOne(index, value);
    return this.items + index;
  }

  // `v.emplace(position, args...)`: the element built from args, before position (std::vector::emplace):
  // in its place at the end, as emplace_back builds it; before another element through a
  // temporary, since the arguments may be elements the insertion moves.
  template<typename... Args>
  T* emplace(const T* position, Args&&... args)
  {
    ContainerSize index = ContainerSize(position - this.items);
    if (index == this.length)
    {
      this.emplace_back(forward<Args>(args)...);
      return this.items + index;
    }
    return this.insert(position, T(forward<Args>(args)...));
  }

  // Inserts count copies of value (which may be an element) before position; returns the
  // position of the first one.
  T* insert(const T* position, ContainerSize count, const T& value)
  {
    T copy(value);
    ContainerSize index = ContainerSize(position - this.items);
    if constexpr (isNothrowCopyConstructible<T> && isNothrowMoveConstructible<T> && (isNothrowMoveAssignable<T> || !isMoveAssignable<T>))
    {
      ContainerSize moved = this.openSlots(index, count);
      for (ContainerSize i = moved; i < count; ++i)
        new (this.items + index + i) T(copy);
      for (ContainerSize i = 0; i < moved; ++i)
        if constexpr (isCopyAssignable<T>)
          this.items[index + i] = copy;
        else if constexpr (isMoveAssignable<T>)
          this.items[index + i] = T(copy);
    }
    else
      this.insertBuilt(index, Copies(&copy, 0), count);
    return this.items + index;
  }

  // Inserts the elements of [first, last), input iterators of any kind that do not point into this
  // vector, before position: copies, or moves through MoveIterator. Returns the position of the
  // first one. Forward iterators are counted first and the elements open their room at once; a
  // single-pass range goes in one element at a time.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  T* insert(const T* position, InputIt first, InputIt last)
  {
    ContainerSize index = ContainerSize(position - this.items);
    // Elements of this vector (`v.insert(v.begin(), v.begin() + 1, v.end())`) are copied out
    // first: opening the room moves them, and growing frees them. Constant evaluation cannot order
    // pointers into different objects, so there first is compared with each element.
    if constexpr (isPointer<InputIt> && isSame<RemoveConst<RemovePointer<InputIt>>, T>)
    {
      bool inside = false;
      if consteval
      {
        for (ContainerSize i = 0; i < this.length && !inside; ++i)
          inside = first == this.items + i;
      }
      else
      {
        inside = first >= this.items && first < this.items + this.length;
      }
      if (inside && first != last)
      {
        Vector<T> copy(first, last);
        return this.insert(this.items + index, copy.begin(), copy.end());
      }
    }
    if constexpr (isBaseOf<ForwardIteratorTag, typename IteratorTraits<InputIt>::iterator_category>)
    {
      ContainerSize count = checkedSize(distance(first, last), "vector too long");
      if constexpr (isPointer<InputIt> && isSame<RemoveConst<RemovePointer<InputIt>>, T>)
        this.insertCopies(index, first, count);
      else
        this.insertBuilt(index, first, count);
    }
    else
    {
      for (ContainerSize at = index; first != last; ++first)
        this.insert(this.items + at++, T(*first));
    }
    return this.items + index;
  }

  // `v.insert(position, {a, b, c})`: the list's elements are copies, never this vector's.
  T* insert(const T* position, InitializerList<T> list)
  {
    ContainerSize index = ContainerSize(position - this.items);
    this.insertCopies(index, list.begin(), list.size());
    return this.items + index;
  }

  // Copies of the count elements from first, which are not this vector's, before index: the work of
  // insert(position, first, last) for pointers to elements and of insert(position, {...}). Not a
  // template: insert(position, {...}) is a member kpp checks for every Vector<T>, and through the range
  // insert it was insert<const T*> and distance<const T*> for every element type.
  void insertCopies(ContainerSize index, const T* first, ContainerSize count)
  {
    if constexpr (isNothrowCopyConstructible<T> && isNothrowMoveConstructible<T> && (isNothrowMoveAssignable<T> || !isMoveAssignable<T>))
    {
      ContainerSize moved = this.openSlots(index, count);
      for (ContainerSize i = moved; i < count; ++i)
        new (this.items + index + i) T(first[i]);
      for (ContainerSize i = 0; i < moved; ++i)
      {
        if constexpr (requires { this.items[0] = *first; })
          this.items[index + i] = first[i];
        else if constexpr (isMoveAssignable<T>)
          this.items[index + i] = T(first[i]); // a conversion that is only explicit
      }
    }
    else
      this.insertBuilt(index, Copies(first, 1), count);
  }

  // The index forms take any integer type, so that a literal 0 is the index, not a null position
  // (with a ContainerSize parameter `v.insert(0, x)` would be ambiguous between the two).
  template<typename I> requires (isIntegral<I>)
  void insert(I index, const T& value) { this.insert(this.items + ContainerSize(index), value); }

  template<typename I> requires (isIntegral<I>)
  void insert(I index, T&& value) { this.insert(this.items + ContainerSize(index), move(value)); }

  bool contains(const T& value) const
  {
    for (ContainerSize i = 0; i < this.length; ++i)
      if (this.items[i] == value)
        return true;
    return false;
  }

  // Not on an empty vector (its length would wrap to the largest size).
  void pop_back()
  {
    assert(this.length > 0);
    --this.length;
    this.items[this.length].~T();
  }

  void clear() { this.truncate(0); }

  // (Any integer type, as insert's index.)
  template<typename I> requires (isIntegral<I>)
  void erase(I index)
  {
    this.erase(this.items + index, this.items + index + 1);
  }

  // Removes [first, last), given as pointers into the vector (begin()/end() and what find functions
  // return, const or not); returns the position of the element after the removed ones.
  T* erase(const T* first, const T* last)
  {
    ContainerSize index = ContainerSize(first - this.items), count = ContainerSize(last - first);
    if (count == 0)
      return this.items + index; // an empty range changes nothing (no self-assignment)
    if constexpr (isMoveAssignable<T>)
    {
      // As [vector.modifiers]: the elements after the erased ones are move-assigned down, then the
      // last count are destroyed (one destructor call per erased element).
      for (ContainerSize i = index; i + count < this.length; ++i)
        this.items[i] = move(this.items[i + count]);
      this.truncate(this.length - count);
    }
    else
    {
      // No move assignment (a kpp addition: std::vector::erase requires it): relocated down.
      for (ContainerSize i = 0; i < count; ++i)
        this.items[index + i].~T();
      relocate(this.items + index, this.items + index + count, this.length - index - count);
      this.length -= count;
    }
    return this.items + index;
  }

  T* erase(const T* at) { return this.erase(at, at + 1); }

private:
  // Destroys the elements from newLength on.
  void truncate(ContainerSize newLength)
  {
    for (ContainerSize i = newLength; i < this.length; ++i)
      this.items[i].~T();
    this.length = newLength;
  }

  // For elements that move without throwing (construction and assignment), the room for count new ones at index (index <= length):
  // the elements from index move up by count, in place or into a new block with the ones before index.
  // Returns how many of the count slots from index on hold moved-from elements, to be assigned; the
  // slots after them are unconstructed and already counted, so the caller builds them first, by
  // constructions that cannot throw, and assigns after (as std::vector's insert: with room the new
  // elements past the end and the elements moved up there are constructed, the others assigned).
  ContainerSize openSlots(ContainerSize index, ContainerSize count)
  {
    ContainerSize needed = sizeSum(this.length, count, "vector too long");
    ContainerSize following = this.length - index;
    if (needed > this.allocated)
    {
      ContainerSize newCapacity = this.capacityFor(needed);
      T* block = allocateArray<T>(newCapacity);
      relocate(block, this.items, (i64)index);
      relocate(block + index + count, this.items + index, (i64)following);
      if (this.items)
        free(this.items);
      this.items = block;
      this.allocated = newCapacity;
      this.length = needed;
      return 0;
    }
    if constexpr (isMoveAssignable<T>)
    {
      ContainerSize constructed = following < count ? following : count;
      for (ContainerSize i = this.length - constructed; i < this.length; ++i)
        new (this.items + i + count) T(move(this.items[i]));
      for (ContainerSize i = this.length - constructed; i-- > index;)
        this.items[i + count] = move(this.items[i]);
      this.length = needed;
      return constructed;
    }
    else
    {
      relocateBackward(this.items + index + count, this.items + index, (i64)following);
      this.length = needed;
      return 0;
    }
  }

  // Inserts value, not an element, before index (< length), moving it in: directly where the elements
  // move without throwing, otherwise through insertBuilt.
  void insertOne(ContainerSize index, T& value)
  {
    if constexpr (isNothrowMoveConstructible<T> && (isNothrowMoveAssignable<T> || !isMoveAssignable<T>))
    {
      ContainerSize moved = this.openSlots(index, 1);
      if (moved == 0)
        new (this.items + index) T(move(value));
      else if constexpr (isMoveAssignable<T>)
        this.items[index] = move(value);
    }
    else
      this.insertBuilt(index, MoveIterator<T*>(&value), 1);
  }

  // Values to copy, as an iterator: from a pointer, stepping by step (1: an array of them, 0: one value
  // given count times, the count form of insert). One type for both, so that the count and the array
  // forms of insert share one instance of insertBuilt.
  class Copies
  {
  public:
    Copies(const T* value, i64 step) : value(value), step(step) {}
    const T& operator*() const { return *this.value; }

    Copies& operator++()
    {
      this.value += this.step;
      return this;
    }

  private:
    const T* value;
    i64 step;
  };

  // A hole the elements after it were relocated up past: unless the hole is filled, the destructor
  // relocates them back down over it (an element type without move assignment whose move does not
  // throw).
  class Hole
  {
  public:
    Hole(T* at, ContainerSize count, ContainerSize following) : at(at), count(count), following(following) {}
    Hole(const Hole&) = delete;
    Hole& operator=(const Hole&) = delete;

    ~Hole()
    {
      if (this.at)
        relocate(this.at, this.at + this.count, (i64)this.following);
    }

    void fill() { this.at = nullptr; }

  private:
    T* at;
    ContainerSize count;
    ContainerSize following;
  };

  // Inserts count elements before index, built from first, a forward iterator over count values
  // that are not this vector's elements (Copies, or moves through MoveIterator), as std::vector's insert does it. With room the new elements past the end and the
  // elements moved up there are constructed, the others assigned; without, everything is built in a
  // new block, the new elements first, and the elements move over. Every step leaves the vector
  // whole when a constructor or an assignment throws: nothing is counted that is not built, nothing
  // built is left behind (std's basic guarantee, the strong one at the end).
  template<typename It>
  void insertBuilt(ContainerSize index, It first, ContainerSize count)
  {
    if (count == 0)
      return;
    ContainerSize needed = sizeSum(this.length, count, "vector too long");
    ContainerSize following = this.length - index;
    bool inPlace = needed <= this.allocated;
    if constexpr (!isMoveAssignable<T> && !isNothrowMoveConstructible<T>)
      inPlace = inPlace && following == 0; // relocating in place could throw half way
    if (!inPlace)
    {
      ContainerSize newCapacity = needed > this.allocated ? this.capacityFor(needed) : this.allocated;
      T* grown = allocateArray<T>(newCapacity);
      OwnedBlock block(grown);
      BuiltObjects fresh(destroyObjects<T>);
      for (; fresh.count() < (i64)count; ++first)
        fresh.add(new (grown + index + fresh.count()) T(*first));
      // At the end std::vector's strong guarantee: the elements are copied where the move may
      // throw (relocateIfNoexcept); before the end they move, as MSVC's do.
      BuiltObjects front(destroyObjects<T>);
      for (ContainerSize i = 0; i < index; ++i)
        if constexpr (!isNothrowMoveConstructible<T> && isCopyConstructible<T>)
        {
          if (following == 0)
            front.add(new (grown + front.count()) T(static_cast<const T&>(this.items[i])));
          else
            front.add(new (grown + front.count()) T(move(this.items[i])));
        }
        else
          front.add(new (grown + front.count()) T(move(this.items[i])));
      BuiltObjects back(destroyObjects<T>);
      for (ContainerSize i = index; i < this.length; ++i)
        back.add(new (grown + index + count + back.count()) T(move(this.items[i])));
      fresh.keep();
      front.keep();
      back.keep();
      for (ContainerSize i = 0; i < this.length; ++i)
        this.items[i].~T();
      if (this.items)
        free(this.items);
      block.release();
      this.items = grown;
      this.allocated = newCapacity;
      this.length = needed;
      return;
    }
    T* end = this.items + this.length;
    if constexpr (isMoveAssignable<T>)
    {
      if (following > count)
      {
        // The last count elements are moved up into the room past the end, the ones before them
        // move-assigned up, the new values assigned in their place.
        BuiltObjects moved(destroyObjects<T>);
        for (ContainerSize i = this.length - count; i < this.length; ++i)
          moved.add(new (end + moved.count()) T(move(this.items[i])));
        moved.keep();
        this.length = needed;
        for (ContainerSize i = ContainerSize(end - this.items) - count; i-- > index;)
          this.items[i + count] = move(this.items[i]);
        for (ContainerSize i = 0; i < count; ++i, ++first)
        {
          if constexpr (requires { this.items[0] = *first; })
            this.items[index + i] = *first;
          else
            this.items[index + i] = T(*first); // a conversion that is only explicit
        }
      }
      else
      {
        // The new values past the first `following` go into the room past the end, the elements
        // from index after them, and the first `following` values are assigned over the elements.
        It rest = first;
        for (ContainerSize i = 0; i < following; ++i)
          ++rest;
        BuiltObjects fresh(destroyObjects<T>);
        for (; fresh.count() < (i64)(count - following); ++rest)
          fresh.add(new (end + fresh.count()) T(*rest));
        BuiltObjects moved(destroyObjects<T>);
        for (ContainerSize i = index; i < this.length; ++i)
          moved.add(new (end + (count - following) + moved.count()) T(move(this.items[i])));
        fresh.keep();
        moved.keep();
        this.length = needed;
        for (ContainerSize i = 0; i < following; ++i, ++first)
        {
          if constexpr (requires { this.items[0] = *first; })
            this.items[index + i] = *first;
          else
            this.items[index + i] = T(*first); // a conversion that is only explicit
        }
      }
    }
    else
    {
      // No move assignment (a kpp addition: std::vector::insert requires it): the elements from
      // index are relocated up (their move does not throw, or there are none), the new ones built in
      // the hole; a throw relocates them back.
      relocateBackward(this.items + index + count, this.items + index, (i64)following);
      Hole hole(this.items + index, count, following);
      BuiltObjects fresh(destroyObjects<T>);
      for (; fresh.count() < (i64)count; ++first)
        fresh.add(new (this.items + index + fresh.count()) T(*first));
      fresh.keep();
      hole.fill();
      this.length = needed;
    }
  }

  // Moves the elements into a new block for newCapacity elements.
  void moveToBlock(ContainerSize newCapacity)
  {
    T* grown = allocateArray<T>(newCapacity);
    if constexpr (isNothrowMoveConstructible<T> || isNothrowCopyConstructible<T>)
      this.adoptBlock(grown, newCapacity);
    else
    {
      OwnedBlock block(grown);
      this.adoptBlock(grown, newCapacity);
      block.release();
    }
  }

  // Moves the elements into block, which has room for newCapacity, and frees the old one, keeping
  // std::vector's strong exception guarantee (an append, reserve, resize, shrink_to_fit): they are
  // copied where the move may throw and a copy exists (move_if_noexcept), otherwise moved. A throw
  // leaves the elements where they were and block as it came, to its owner.
  void adoptBlock(T* block, ContainerSize newCapacity)
  {
    if (this.items)
    {
      if constexpr (isNothrowMoveConstructible<T>)
        relocate(block, this.items, this.length);
      else
        relocateIfNoexcept(block, this.items, this.length);
      free(this.items);
    }
    this.items = block;
    this.allocated = newCapacity;
  }

  // Geometric growth (doubling, at least 4, at most maxContainerSize): n appends cost O(n) element
  // moves in total. LengthError when needed is past maxContainerSize (core/Sizes.kpp).
  ContainerSize capacityFor(u64 needed) const { return grownCapacity(this.allocated, needed, 4, "vector too long"); }

  void ensureRoom(ContainerSize needed)
  {
    if (needed > this.allocated)
      this.moveToBlock(this.capacityFor(needed));
  }

  // An append to a full vector whose elements' relocation may throw, a move that may throw without a
  // copy that cannot (push_back and emplace_back build the others' themselves): the new element is built in a new block first, as its arguments may be
  // elements, and the elements move over after it. A throw leaves the vector as it was.
  template<typename... Args>
  void appendGrown(Args&&... args)
  {
    ContainerSize newCapacity = this.capacityFor((u64)this.length + 1);
    T* grown = allocateArray<T>(newCapacity);
    OwnedBlock block(grown);
    BuiltObjects appended(destroyObjects<T>);
    appended.add(new (grown + this.length) T(forward<Args>(args)...));
    this.adoptBlock(grown, newCapacity);
    appended.keep();
    block.release();
    ++this.length;
  }

  // The count elements from source (not this vector's) in place of the elements: copy-assigned
  // over the ones there are, the others copy constructed, as std's when they fit.
  void assignCopies(const T* source, ContainerSize count)
  {
    if constexpr (isCopyAssignable<T>)
    {
      if (count <= this.allocated)
      {
        ContainerSize common = count < this.length ? count : this.length;
        for (ContainerSize i = 0; i < common; ++i)
          this.items[i] = source[i];
        this.truncate(common);
        this.appendCopies(source + common, count - common);
        return;
      }
    }
    this.clear();
    this.appendCopies(source, count);
  }

  // Copy-constructs count elements from source after the last one (exact growth: the copy and
  // assignment of a whole vector).
  void appendCopies(const T* source, ContainerSize count)
  {
    this.reserve(sizeSum(this.length, count, "vector too long"));
    for (ContainerSize i = 0; i < count; ++i, ++this.length)
      new (this.items + this.length) T(source[i]);
  }

  T* items = nullptr;
  ContainerSize length = 0;
  ContainerSize allocated = 0; // the capacity: elements that fit in the block
};

// Equal when of the same length with every element equal; ordered lexicographically by the elements
// (common.md), which gives <, >, <= and >=. Function templates, as std's are: only a comparison that is
// written instantiates them, never every element type.
template<typename T>
bool operator==(const Vector<T>& a, const Vector<T>& b)
{
  if (a.size() != b.size())
    return false;
  const T* x = a.data();
  const T* y = b.data();
  for (ContainerSize i = 0; i < a.size(); ++i)
    if (!(x[i] == y[i]))
      return false;
  return true;
}

template<typename T>
strong_ordering operator<=>(const Vector<T>& a, const Vector<T>& b) { return lexicographicalCompareThreeWay(a.begin(), a.end(), b.begin(), b.end()); }
