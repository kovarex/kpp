// Kpp standard library: Vector<T>. A growable array. When elements shift for an insert or erase,
// they are relocated (move constructor, then destructor); when the buffer grows, as in
// std::vector's reallocation, by move_if_noexcept: a copyable T whose move constructor may throw
// is copied. Appending grows the capacity geometrically, reserve() exactly.
template<typename T>
struct Vector
{
  T* items = nullptr;
  int length = 0;
  int allocated = 0; // the capacity: elements that fit in the block

  using iterator = T*;
  using const_iterator = const T*;
  using reverse_iterator = ReverseIterator<T*>;
  using const_reverse_iterator = ReverseIterator<const T*>;
  using value_type = T;
  using size_type = int;
  using difference_type = ptrdiff_t;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  Vector() {}
  // count default-constructed elements.
  explicit Vector(int count)
  {
    // The elements are made in their place, so T needs no copy or move (as for std::vector(n)):
    // TypeAwareMemoryPool keeps Vectors of SpriteRegistration, which has neither.
    if (count <= 0)
      return;
    this->items = (T*)malloc((size_t)count * sizeof(T));
    this->allocated = count;
    for (; this->length < count; ++this->length)
      new (this->items + this->length) T();
  }
  // `Vector<int> primes = {2, 3, 5, 7};`
  Vector(InitializerList<T> list)
  {
    this->reserve(list.size());
    for (const T& item : list)
      this->push_back(item);
  }
  Vector(const Vector<T>& other) { this->appendCopies(other.items, other.length); }
  // count copies of value.
  Vector(int count, const T& value) { this->assign(count, value); }
  // Copies of [first, last).
  Vector(const T* first, const T* last) { this->appendCopies(first, int(last - first)); }
  // The elements of [first, last), input iterators of any kind (`Vector<TransportLine*>
  // sorted(lines.begin(), lines.end())` from a HashSet), as insert(end(), first, last).
  template<typename InputIt> requires (!isIntegral<InputIt>)
  Vector(InputIt first, InputIt last) { this->insert(this->items, first, last); }
  Vector(Vector<T>&& other) noexcept : items(other.items), length(other.length), allocated(other.allocated)
  {
    other.items = nullptr;
    other.length = 0;
    other.allocated = 0;
  }
  ~Vector()
  {
    this->clear();
    if (this->items)
      free(this->items);
  }

  Vector<T>& operator=(const Vector<T>& other)
  {
    if (this == &other)
      return *this;
    this->clear();
    this->appendCopies(other.items, other.length);
    return *this;
  }
  Vector<T>& operator=(Vector<T>&& other) noexcept
  {
    if (this == &other)
      return *this;
    this->clear();
    if (this->items)
      free(this->items);
    this->items = other.items;
    this->length = other.length;
    this->allocated = other.allocated;
    other.items = nullptr;
    other.length = 0;
    other.allocated = 0;
    return *this;
  }
  // `v = {a, b, c}`: the listed elements, as assign({...}).
  Vector<T>& operator=(InitializerList<T> list)
  {
    this->assign(list);
    return *this;
  }

  int size() const { return this->length; }
  int capacity() const { return this->allocated; }
  T* data() { return this->items; }
  const T* data() const { return this->items; }
  bool empty() const { return this->length == 0; }
  T& operator[](int index) { return this->items[index]; }
  const T& operator[](int index) const { return this->items[index]; }
  // Equal when of the same length with every element equal.
  bool operator==(const Vector& other) const
  {
    if (this->length != other.length)
      return false;
    for (int i = 0; i < this->length; ++i)
      if (!(this->items[i] == other.items[i]))
        return false;
    return true;
  }
  bool operator!=(const Vector& other) const { return !(*this == other); }
  // Ordered lexicographically by the elements (common.md): gives <, >, <= and >=.
  strong_ordering operator<=>(const Vector& other) const { return lexicographicalCompareThreeWay(this->begin(), this->end(), other.begin(), other.end()); }
  T& back() { return this->items[this->length - 1]; }
  const T& back() const { return this->items[this->length - 1]; }
  T* begin() { return this->items; }
  T* end() { return this->items + this->length; }
  const T* begin() const { return this->items; }
  const T* end() const { return this->items + this->length; }
  const T* cbegin() const { return this->items; }
  const T* cend() const { return this->items + this->length; }
  ReverseIterator<T*> rbegin() { return ReverseIterator<T*>(this->items + this->length); }
  ReverseIterator<T*> rend() { return ReverseIterator<T*>(this->items); }
  ReverseIterator<const T*> rbegin() const { return ReverseIterator<const T*>(this->items + this->length); }
  ReverseIterator<const T*> rend() const { return ReverseIterator<const T*>(this->items); }
  ReverseIterator<const T*> crbegin() const { return ReverseIterator<const T*>(this->items + this->length); }
  ReverseIterator<const T*> crend() const { return ReverseIterator<const T*>(this->items); }

  // Lets go of unused capacity: afterwards capacity() == size().
  void shrink_to_fit()
  {
    if (this->allocated == this->length)
      return;
    if (this->length == 0)
    {
      free(this->items);
      this->items = nullptr;
      this->allocated = 0;
      return;
    }
    this->moveToBlock(this->length);
  }
  void swap(Vector<T>& other)
  {
    ::swap(this->items, other.items);
    ::swap(this->length, other.length);
    ::swap(this->allocated, other.allocated);
  }
  // Replaces the contents with count copies of value (which may be an element) / with copies of
  // [first, last) (which must not be elements).
  void assign(int count, const T& value)
  {
    T copy(value);
    this->clear();
    this->reserve(count);
    for (int i = 0; i < count; ++i)
      new (this->items + i) T(copy);
    this->length = count;
  }
  void assign(const T* first, const T* last)
  {
    this->clear();
    this->appendCopies(first, int(last - first));
  }
  // The elements of [first, last), input iterators of any kind (ResearchQueue's
  // `queue.assign(other.queue.begin(), other.queue.end())`); they must not point into this vector.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  void assign(InputIt first, InputIt last)
  {
    this->clear();
    this->insert(this->items + this->length, first, last);
  }
  void assign(InitializerList<T> list)
  {
    this->clear();
    this->reserve(list.size());
    for (const T& item : list)
      this->push_back(item);
  }

  // Room for `needed` elements, exactly.
  void reserve(int needed)
  {
    if (needed > this->allocated)
      this->moveToBlock(needed);
  }

  // The value may be an element of this vector: v.push_back(v[0]) is fine.
  void push_back(const T& value)
  {
    T* grown;
    new (this->appendSlot(grown)) T(value);
    this->finishAppend(grown);
  }
  void push_back(T&& value)
  {
    T* grown;
    new (this->appendSlot(grown)) T(move(value));
    this->finishAppend(grown);
  }
  // Builds the new element in place from the arguments.
  template<typename... Args>
  T& emplace_back(Args&&... args)
  {
    T* grown;
    T* slot = this->appendSlot(grown);
    new (slot) T(forward<Args>(args)...);
    this->finishAppend(grown);
    return this->items[this->length - 1];
  }
  T& front() { return this->items[0]; }
  const T& front() const { return this->items[0]; }
  // New elements are default-constructed (zero for numbers).
  void resize(int newLength)
  {
    if (newLength <= this->length)
    {
      this->truncate(newLength);
      return;
    }
    this->ensureRoom(newLength);
    for (int i = this->length; i < newLength; ++i)
      new (this->items + i) T();
    this->length = newLength;
  }
  // New elements are copies of value.
  void resize(int newLength, const T& value)
  {
    if (newLength <= this->length)
    {
      this->truncate(newLength);
      return;
    }
    T copy(value); // value may be an element, and the elements may move
    this->ensureRoom(newLength);
    for (int i = this->length; i < newLength; ++i)
      new (this->items + i) T(copy);
    this->length = newLength;
  }
  // Throws OutOfRange for an index outside [0, size()).
  T& at(int index)
  {
    if (index < 0 || index >= this->length)
      throwOutOfRange("Vector::at: index out of range");
    return this->items[index];
  }
  const T& at(int index) const
  {
    if (index < 0 || index >= this->length)
      throwOutOfRange("Vector::at: index out of range");
    return this->items[index];
  }
  // Inserts before the element position points at (begin()/end() and what find functions return,
  // const or not).
  T* insert(const T* position, const T& value)
  {
    int index = int(position - this->items);
    this->insert(index, value);
    return this->items + index;
  }
  T* insert(const T* position, T&& value)
  {
    int index = int(position - this->items);
    this->insert(index, move(value));
    return this->items + index;
  }
  // `v.emplace(position, args...)`: the element built from args, before position (std::vector::emplace):
  // in its place at the end, as emplace_back builds it; before another element through a
  // temporary, since the arguments may be elements the insertion moves.
  template<typename... Args>
  T* emplace(const T* position, Args&&... args)
  {
    int index = int(position - this->items);
    if (index == this->length)
    {
      this->emplace_back(forward<Args>(args)...);
      return this->items + index;
    }
    return this->insert(position, T(forward<Args>(args)...));
  }
  // Inserts count copies of value (which may be an element) before position; returns the
  // position of the first one.
  T* insert(const T* position, int count, const T& value)
  {
    T copy(value);
    int index = int(position - this->items);
    this->openSlots(index, count);
    for (int i = 0; i < count; ++i)
      new (this->items + index + i) T(copy);
    return this->items + index;
  }
  // Inserts the elements of [first, last), input iterators of any kind that do not point into this
  // vector, before position: copies, or moves through MoveIterator. Returns the position of the
  // first one. Forward iterators are counted first and the elements open their room at once; a
  // single-pass range goes in one element at a time.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  T* insert(const T* position, InputIt first, InputIt last)
  {
    int index = int(position - this->items);
    if constexpr (isBaseOf<ForwardIteratorTag, typename IteratorTraits<InputIt>::iterator_category>)
    {
      int count = int(distance(first, last));
      this->openSlots(index, count);
      for (int i = 0; i < count; ++i)
      {
        new (this->items + index + i) T(*first);
        ++first;
      }
    }
    else
    {
      for (int at = index; first != last; ++first)
        this->insert(at++, T(*first));
    }
    return this->items + index;
  }
  // `v.insert(position, {a, b, c})`.
  T* insert(const T* position, InitializerList<T> list) { return this->insert(position, list.begin(), list.end()); }
  void insert(int index, const T& value)
  {
    T copy(value); // value may be an element, which the opening moves
    this->openSlots(index, 1);
    new (this->items + index) T(move(copy));
  }
  void insert(int index, T&& value)
  {
    this->openSlots(index, 1);
    new (this->items + index) T(move(value));
  }
  // Makes room for count elements at index: the elements from there on move up. The new slots
  // are left unconstructed.
  void openSlots(int index, int count)
  {
    this->ensureRoom(this->length + count, index == this->length); // only at the end the strong guarantee
    relocateBackward(this->items + index + count, this->items + index, this->length - index);
    this->length += count;
  }
  bool contains(const T& value) const
  {
    for (int i = 0; i < this->length; ++i)
      if (this->items[i] == value)
        return true;
    return false;
  }
  void pop_back()
  {
    --this->length;
    this->items[this->length].~T();
  }
  void clear() { this->truncate(0); }
  void erase(int index)
  {
    this->items[index].~T();
    relocate(this->items + index, this->items + index + 1, this->length - index - 1);
    --this->length;
  }
  // Removes [first, last), given as pointers into the vector (begin()/end() and what find functions
  // return, const or not); returns the position of the element after the removed ones.
  T* erase(const T* first, const T* last)
  {
    int index = int(first - this->items), count = int(last - first);
    for (int i = 0; i < count; ++i)
      this->items[index + i].~T();
    relocate(this->items + index, this->items + index + count, this->length - index - count);
    this->length -= count;
    return this->items + index;
  }
  T* erase(const T* at) { return this->erase(at, at + 1); }

  // Internals.
  // Destroys the elements from newLength on.
  void truncate(int newLength)
  {
    for (int i = newLength; i < this->length; ++i)
      this->items[i].~T();
    this->length = newLength;
  }
  // Moves the elements into a new block for newCapacity elements.
  void moveToBlock(int newCapacity, bool strong = true) { this->adoptBlock((T*)malloc((size_t)newCapacity * sizeof(T)), newCapacity, strong); }
  // Moves the elements into block, which has room for newCapacity, and frees the old one. strong
  // (an append, reserve, shrink_to_fit: std::vector's strong exception guarantee) copies them
  // where the move may throw and a copy exists (move_if_noexcept); an insert before the end moves
  // them, as MSVC's std::vector does (the standard guarantees nothing there).
  void adoptBlock(T* block, int newCapacity, bool strong = true)
  {
    if (this->items)
    {
      if (strong)
        relocateIfNoexcept(block, this->items, this->length);
      else
        relocate(block, this->items, this->length);
      free(this->items);
    }
    this->items = block;
    this->allocated = newCapacity;
  }
  // Geometric growth (doubling, at least 4): n appends cost O(n) element moves in total.
  int grownCapacity(int needed) const
  {
    int doubled = this->allocated < 2 ? 4 : this->allocated * 2;
    return needed > doubled ? needed : doubled;
  }
  void ensureRoom(int needed, bool strong = true)
  {
    if (needed > this->allocated)
      this->moveToBlock(this->grownCapacity(needed), strong);
  }
  // Where the next appended element goes. When the vector is full that is in grown, a new block:
  // the new element's arguments may be elements, so they move over only in finishAppend, after
  // the new element is constructed.
  T* appendSlot(T*& grown)
  {
    if (this->length < this->allocated)
    {
      grown = nullptr;
      return this->items + this->length;
    }
    grown = (T*)malloc((size_t)this->grownCapacity(this->length + 1) * sizeof(T));
    return grown + this->length;
  }
  void finishAppend(T* grown)
  {
    if (grown)
      this->adoptBlock(grown, this->grownCapacity(this->length + 1));
    ++this->length;
  }
  // Copy-constructs count elements from source after the last one (exact growth: the copy and
  // assignment of a whole vector).
  void appendCopies(const T* source, int count)
  {
    this->reserve(this->length + count);
    T* target = this->items + this->length;
    for (int i = 0; i < count; ++i)
      new (target + i) T(source[i]);
    this->length += count;
  }
};
