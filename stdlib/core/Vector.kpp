// Kpp standard library: Vector<T>. A growable array. When the buffer grows, or elements shift
// for an insert or erase, they are relocated as in std::vector: move constructor, then destructor.
// Appending grows the capacity geometrically, reserve() exactly.
template<typename T>
struct Vector
{
  T* items = nullptr;
  int length = 0;
  int capacity = 0;

  using iterator = T*;
  using const_iterator = const T*;
  using reverse_iterator = ReverseIterator<T>;
  using const_reverse_iterator = ReverseIterator<const T>;
  using value_type = T;

  Vector() {}
  // count default-constructed elements.
  explicit Vector(int count) { this->resize(count); }
  // `Vector<int> primes = {2, 3, 5, 7};`
  Vector(InitializerList<T> list)
  {
    this->reserve(list.size());
    for (const T& item : list)
      this->push_back(item);
  }
  Vector(const Vector<T>& other) { this->appendCopies(other.items, other.length); }
  Vector(Vector<T>&& other) : items(other.items), length(other.length), capacity(other.capacity)
  {
    other.items = nullptr;
    other.length = 0;
    other.capacity = 0;
  }
  ~Vector()
  {
    this->clear();
    if (this->items)
      free(this->items);
  }

  Vector<T>& operator=(const Vector<T>& other)
  {
    if (this == &other)
      return *this;
    this->clear();
    this->appendCopies(other.items, other.length);
    return *this;
  }
  Vector<T>& operator=(Vector<T>&& other)
  {
    if (this == &other)
      return *this;
    this->clear();
    if (this->items)
      free(this->items);
    this->items = other.items;
    this->length = other.length;
    this->capacity = other.capacity;
    other.items = nullptr;
    other.length = 0;
    other.capacity = 0;
    return *this;
  }

  int size() const { return this->length; }
  T* data() { return this->items; }
  const T* data() const { return this->items; }
  // A Vector is a Span of its elements (what passing a std::vector to a std::span parameter does).
  operator Span<T>() { return Span<T>(this->items, this->length); }
  operator Span<const T>() const { return Span<const T>(this->items, this->length); }
  bool empty() const { return this->length == 0; }
  T& operator[](int index) { return this->items[index]; }
  // Equal when of the same length with every element equal.
  bool operator==(const Vector& other) const
  {
    if (this->length != other.length)
      return false;
    for (int i = 0; i < this->length; ++i)
      if (!(this->items[i] == other.items[i]))
        return false;
    return true;
  }
  bool operator!=(const Vector& other) const { return !(*this == other); }
  T& back() { return this->items[this->length - 1]; }
  T* begin() { return this->items; }
  T* end() { return this->items + this->length; }
  const T* begin() const { return this->items; }
  const T* end() const { return this->items + this->length; }
  const T* cbegin() const { return this->items; }
  const T* cend() const { return this->items + this->length; }
  ReverseIterator<T> rbegin() { return ReverseIterator<T>(this->items + this->length); }
  ReverseIterator<T> rend() { return ReverseIterator<T>(this->items); }
  ReverseIterator<const T> rbegin() const { return ReverseIterator<const T>(this->items + this->length); }
  ReverseIterator<const T> rend() const { return ReverseIterator<const T>(this->items); }
  ReverseIterator<const T> crbegin() const { return ReverseIterator<const T>(this->items + this->length); }
  ReverseIterator<const T> crend() const { return ReverseIterator<const T>(this->items); }

  // Room for `needed` elements, exactly.
  void reserve(int needed)
  {
    if (needed > this->capacity)
      this->moveToBlock(needed);
  }

  // The value may be an element of this vector: v.push_back(v[0]) is fine.
  void push_back(const T& value)
  {
    T* grown;
    new (this->appendSlot(grown)) T(value);
    this->finishAppend(grown);
  }
  void push_back(T&& value)
  {
    T* grown;
    new (this->appendSlot(grown)) T(move(value));
    this->finishAppend(grown);
  }
  void emplace_back(const T& value) { this->push_back(value); }
  // Builds the new element in place from the arguments.
  template<typename... Args>
  T& emplace_back(Args&&... args)
  {
    T* grown;
    T* slot = this->appendSlot(grown);
    new (slot) T(forward<Args>(args)...);
    this->finishAppend(grown);
    return this->items[this->length - 1];
  }
  T& front() { return this->items[0]; }
  // New elements are default-constructed (zero for numbers).
  void resize(int newLength)
  {
    if (newLength <= this->length)
    {
      this->truncate(newLength);
      return;
    }
    this->ensureRoom(newLength);
    for (int i = this->length; i < newLength; ++i)
      new (this->items + i) T();
    this->length = newLength;
  }
  // New elements are copies of value.
  void resize(int newLength, const T& value)
  {
    if (newLength <= this->length)
    {
      this->truncate(newLength);
      return;
    }
    T copy(value); // value may be an element, and the elements may move
    this->ensureRoom(newLength);
    for (int i = this->length; i < newLength; ++i)
      new (this->items + i) T(copy);
    this->length = newLength;
  }
  // Throws OutOfRange for an index outside [0, size()).
  T& at(int index)
  {
    if (index < 0 || index >= this->length)
      throwOutOfRange("Vector::at: index out of range");
    return this->items[index];
  }
  const T& at(int index) const
  {
    if (index < 0 || index >= this->length)
      throwOutOfRange("Vector::at: index out of range");
    return this->items[index];
  }
  // Inserts before the element position points at (begin()/end() and what find functions return).
  T* insert(T* position, const T& value)
  {
    int index = int(position - this->items);
    this->insert(index, value);
    return this->items + index;
  }
  T* insert(T* position, T&& value)
  {
    int index = int(position - this->items);
    this->insert(index, move(value));
    return this->items + index;
  }
  // `v.emplace(position, args...)`: the element built from args, before position (std::vector::emplace).
  template<typename... Args>
  T* emplace(T* position, Args&&... args) { return this->insert(position, T(forward<Args>(args)...)); }
  // Inserts copies of [first, last), which must not be elements of this vector; returns the
  // position of the first one.
  T* insert(T* position, const T* first, const T* last)
  {
    int index = int(position - this->items), count = int(last - first);
    this->openSlots(index, count);
    for (int i = 0; i < count; ++i)
      new (this->items + index + i) T(first[i]);
    return this->items + index;
  }
  void insert(int index, const T& value)
  {
    T copy(value); // value may be an element, which the opening moves
    this->openSlots(index, 1);
    new (this->items + index) T(move(copy));
  }
  void insert(int index, T&& value)
  {
    this->openSlots(index, 1);
    new (this->items + index) T(move(value));
  }
  // Makes room for count elements at index: the elements from there on move up. The new slots
  // are left unconstructed.
  void openSlots(int index, int count)
  {
    this->ensureRoom(this->length + count);
    relocateBackward(this->items + index + count, this->items + index, this->length - index);
    this->length += count;
  }
  bool contains(const T& value) const
  {
    for (int i = 0; i < this->length; ++i)
      if (this->items[i] == value)
        return true;
    return false;
  }
  void pop_back()
  {
    --this->length;
    this->items[this->length].~T();
  }
  void clear() { this->truncate(0); }
  void erase(int index)
  {
    this->items[index].~T();
    relocate(this->items + index, this->items + index + 1, this->length - index - 1);
    --this->length;
  }
  // Removes [first, last), given as pointers into the vector (begin()/end() and what find functions
  // return); returns the position of the element after the removed ones.
  T* erase(T* first, T* last)
  {
    int index = int(first - this->items), count = int(last - first);
    for (int i = 0; i < count; ++i)
      this->items[index + i].~T();
    relocate(this->items + index, this->items + index + count, this->length - index - count);
    this->length -= count;
    return this->items + index;
  }
  T* erase(T* at) { return this->erase(at, at + 1); }

  // Internals.
  // Destroys the elements from newLength on.
  void truncate(int newLength)
  {
    for (int i = newLength; i < this->length; ++i)
      this->items[i].~T();
    this->length = newLength;
  }
  // Moves the elements into a new block for newCapacity elements.
  void moveToBlock(int newCapacity) { this->adoptBlock((T*)malloc((size_t)newCapacity * sizeof(T)), newCapacity); }
  // Moves the elements into block, which has room for newCapacity, and frees the old one.
  void adoptBlock(T* block, int newCapacity)
  {
    if (this->items)
    {
      relocate(block, this->items, this->length);
      free(this->items);
    }
    this->items = block;
    this->capacity = newCapacity;
  }
  // Geometric growth (doubling, at least 4): n appends cost O(n) element moves in total.
  int grownCapacity(int needed) const
  {
    int doubled = this->capacity < 2 ? 4 : this->capacity * 2;
    return needed > doubled ? needed : doubled;
  }
  void ensureRoom(int needed)
  {
    if (needed > this->capacity)
      this->moveToBlock(this->grownCapacity(needed));
  }
  // Where the next appended element goes. When the vector is full that is in grown, a new block:
  // the new element's arguments may be elements, so they move over only in finishAppend, after
  // the new element is constructed.
  T* appendSlot(T*& grown)
  {
    if (this->length < this->capacity)
    {
      grown = nullptr;
      return this->items + this->length;
    }
    grown = (T*)malloc((size_t)this->grownCapacity(this->length + 1) * sizeof(T));
    return grown + this->length;
  }
  void finishAppend(T* grown)
  {
    if (grown)
      this->adoptBlock(grown, this->grownCapacity(this->length + 1));
    ++this->length;
  }
  // Copy-constructs count elements from source after the last one (exact growth: the copy and
  // assignment of a whole vector).
  void appendCopies(const T* source, int count)
  {
    this->reserve(this->length + count);
    T* target = this->items + this->length;
    for (int i = 0; i < count; ++i)
      new (target + i) T(source[i]);
    this->length += count;
  }
};
