// kpp standard library: text conversion and output (design.md 14). A text is pieces one after
// another, nothing parsed: print("Hello ", name, " you are ", age), out << a << ", " << b,
// toString(x), a + b; format("{} of {}", a, b) puts them at a literal pattern's {}s.
extern "C" int snprintf(char* buffer, size_t size, const char* format, ...);

String toString(long long value)
{
  char digits[24];
  int n = 0;
  bool negative = value < 0;
  unsigned long long magnitude = negative ? (unsigned long long)(-(value + 1)) + 1 : (unsigned long long)value;
  do
  {
    digits[n] = (char)('0' + magnitude % 10);
    ++n;
    magnitude /= 10;
  } while (magnitude != 0);
  String result;
  if (negative)
    result.append('-');
  while (n > 0)
  {
    --n;
    result.append(digits[n]);
  }
  return result;
}

String toString(unsigned long long value)
{
  char digits[24];
  int n = 0;
  do
  {
    digits[n] = (char)('0' + value % 10);
    ++n;
    value /= 10;
  } while (value != 0);
  String result;
  while (n > 0)
  {
    --n;
    result.append(digits[n]);
  }
  return result;
}

String toString(int value) { return toString((long long)value); }
String toString(unsigned int value) { return toString((unsigned long long)value); }
String toString(long value) { return toString((long long)value); } // (C's long, a type of its own as in std::to_string)
String toString(unsigned long value) { return toString((unsigned long long)value); }

// A floating value's text is the shortest that reads back to the same value (design.md 14: all the
// information, nothing lost): %g's form at the fewest significant digits that round-trip, 0.1 as
// "0.1", 0.1 + 0.2 as "0.30000000000000004", 1e21 as "1e+21". Infinities and NaN are "inf", "-inf"
// and "nan" on every platform (MSVC's %g writes "-nan(ind)"); a negative zero is "-0".
String floatingText(double value, int maxDigits, bool asFloat)
{
  if (value != value)
    return String("nan");
  if (value != 0 && value * 0.5 == value)
    return String(value > 0 ? "inf" : "-inf");
  char buffer[40];
  int n = 0;
  for (int digits = 1; digits <= maxDigits; ++digits)
  {
    n = snprintf(buffer, 40, "%.*g", digits, value);
    double back = strtod(buffer, nullptr);
    if (asFloat ? (float)back == (float)value : back == value)
      break;
  }
  // (%g at few digits writes 100 as "1e+02": below 1e16, as Python's repr, positionally.)
  for (int i = 0; i < n; ++i)
    if (buffer[i] == 'e')
    {
      int exponent = (int)strtol(buffer + i + 1, nullptr, 10);
      if (exponent >= 0 && exponent < 16)
        n = snprintf(buffer, 40, "%.*g", exponent + 1 > maxDigits ? maxDigits : exponent + 1, value);
      break;
    }
  String result;
  result.append(buffer, n);
  return result;
}

String toString(double value) { return floatingText(value, 17, false); }
String toString(float value) { return floatingText(value, 9, true); }

String toString(bool value) { return String(value ? "true" : "false"); }
String toString(const String& text) { return text; }
String toString(const char* text) { return String(text); }
String toString(char c)
{
  String result;
  result.append(c);
  return result;
}

// The pieces of a text, written to the standard output; println ends the line.
void print(Text text)
{
  String out;
  text.appendTo(out);
  fwrite(out.data(), 1, out.size(), stdout);
}

void println(Text text)
{
  String out;
  text.appendTo(out);
  out.append('\n');
  fwrite(out.data(), 1, out.size(), stdout);
}

// The pieces of a text as a new String: toString(x) for one value, toString(a, " = ", b) for several.
String toString(Text text)
{
  String out;
  text.appendTo(out);
  return out;
}

// Appends the pieces to out, and returns out for the next `<<`: out << left << " = " << right. The
// only append on String (design.md 14: String has no +=).
String& operator<<(String& out, Text text)
{
  text.appendTo(out);
  return out;
}
// The same on a temporary String, which it returns: `String(name) << '_'` (C++'s `std::string(name) +=
// '_'`, TileGraphicsSet's layer prefixes).
String operator<<(String&& out, Text text)
{
  text.appendTo(out);
  return move(out);
}

// a + b, one side a String or a StringView: a new String of both texts.
String operator+(const String& left, Text right)
{
  String out = left;
  right.appendTo(out);
  return out;
}

String operator+(StringView left, Text right)
{
  String out;
  out.append(left.data(), left.size());
  right.appendTo(out);
  return out;
}

template<typename T>
  requires (!isSame<T, String> && !isSame<T, StringView>)
String operator+(const T& left, const String& right)
{
  String out;
  out << left;
  out.append(right);
  return out;
}

template<typename T>
  requires (!isSame<T, String> && !isSame<T, StringView>)
String operator+(const T& left, StringView right)
{
  String out;
  out << left;
  out.append(right.data(), right.size());
  return out;
}

// format's pattern: a compile-time literal (design.md 14: a format that is not a literal is no
// format), each {} the place of the next piece; a { without its } or a } alone is a compile error,
// and so is a call whose pieces are not one per {} (checkPieces, which the compiler runs at every
// call with the call's piece count: `format("{} {}", a)` does not compile).
struct FormatString
{
  const char* pattern;
  ContainerSize holes = 0;

  consteval implicit FormatString(const char* pattern) : pattern(pattern)
  {
    for (const char* p = pattern; *p != 0; ++p)
    {
      if (*p == '{')
      {
        if (p[1] != '}')
          throw LogicError("format: a { without its }");
        ++this->holes;
        ++p;
      }
      else if (*p == '}')
        throw LogicError("format: a } without its {");
    }
  }
  consteval void checkPieces(ContainerSize pieces) const
  {
    if (pieces != this->holes)
    {
      String message("format: ");
      message << this->holes << " {} for " << pieces << StringView(pieces == 1 ? " piece" : " pieces");
      throw LogicError(message);
    }
  }
};

// The pattern with each {} replaced by the next piece's text. The compiler has paired them up
// (checkPieces); a FormatString passed on as a parameter is checked at the call that made it, and
// release_assert backs that up.
String format(FormatString pattern, Text args)
{
  release_assert(pattern.holes == args.count);
  String out;
  ContainerSize next = 0;
  for (const char* p = pattern.pattern; *p != 0; ++p)
  {
    if (p[0] == '{' && p[1] == '}')
    {
      args.pieces[next].append(args.pieces[next].object, out);
      ++next;
      ++p;
    }
    else
      out.append(*p);
  }
  return out;
}
