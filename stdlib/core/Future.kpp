// Futures and promises: the async/await primitives (what std::future, std::promise, std::async
// and std::shared_future convert to). Built on Windows threads and condition variables.

enum class FutureStatus { ready, timeout, deferred };

// How async runs its callable (std::launch): on a new thread now, or on the first get() or wait().
enum class Launch { async = 1, deferred = 2 };

// Why a Future is ready without a value (std::future_errc): its Promise was destroyed first.
enum class FutureErrc { brokenPromise = 1, futureAlreadyRetrieved = 2, promiseAlreadySatisfied = 3, noState = 4 };

// The error a Future's get() throws when it has none of its own (std::future_error).
class FutureError : public LogicError
{
public:
  FutureErrc code;
  FutureError(FutureErrc code) : LogicError(String(code == FutureErrc::brokenPromise ? "broken promise" : "future error")), code(code) {}
};

template<typename T>
struct SharedState
{
  Mutex mutex;
  ConditionVariable cv;
  Optional<T> value;
  ExceptionPtr exception;
  bool ready = false;
  Function<void()> deferred; // async with Launch::deferred: runs on the first get() or wait()
  // async with Launch::async: the thread that computes the value, joined when the last Future lets
  // the state go (std::async's future waits as it is destroyed, [futures.async] 5.4), so that a
  // callable referring to the caller's locals never outlives them. The thread itself holds no
  // reference to the state.
  Thread worker;

  ~SharedState()
  {
    if (this->worker.joinable())
      this->worker.join();
  }

  // The Promise is gone with nothing set: ready with a broken promise ([futures.promise] 9).
  void abandon()
  {
    LockGuard<Mutex> guard(this->mutex);
    if (this->ready)
      return;
    this->exception = makeExceptionPtr(FutureError(FutureErrc::brokenPromise));
    this->ready = true;
    this->cv.notifyAll();
  }

  // The deferred function runs once, on the thread that takes it first (under the lock); the
  // threads that call get() or wait() beside it wait for the result it sets. Until 2026-10-30 each
  // took it without the lock, and two at once could both take it: the second called it empty.
  void runDeferred()
  {
    Function<void()> run;
    {
      LockGuard<Mutex> guard(this->mutex);
      if (!this->deferred)
        return;
      run = move(this->deferred);
      this->deferred = nullptr;
    }
    run();
  }

  void set(const T& v)
  {
    LockGuard<Mutex> guard(this->mutex);
    this->value = v;
    this->ready = true;
    this->cv.notifyAll();
  }

  void set(T&& v)
  {
    LockGuard<Mutex> guard(this->mutex);
    this->value = move(v);
    this->ready = true;
    this->cv.notifyAll();
  }

  void setException(ExceptionPtr e)
  {
    LockGuard<Mutex> guard(this->mutex);
    this->exception = e;
    this->ready = true;
    this->cv.notifyAll();
  }

  // The value, once it is there; an exception set instead is thrown here.
  T& get()
  {
    this->runDeferred();
    UniqueLock<Mutex> lock(this->mutex);
    this->cv.wait(lock, [this]() -> bool { return this->ready; });
    if (this->exception)
      rethrowException(this->exception);
    return this->value.value();
  }

  void wait()
  {
    this->runDeferred();
    UniqueLock<Mutex> lock(this->mutex);
    this->cv.wait(lock, [this]() -> bool { return this->ready; });
  }

  template<typename Rep, typename Period>
  FutureStatus waitFor(const Duration<Rep, Period>& d)
  {
    UniqueLock<Mutex> lock(this->mutex);
    if (this->deferred)
      return FutureStatus::deferred;
    return this->cv.waitFor(lock, d, [this]() -> bool { return this->ready; }) ? FutureStatus::ready : FutureStatus::timeout;
  }
};

template<>
struct SharedState<void>
{
  Mutex mutex;
  ConditionVariable cv;
  ExceptionPtr exception;
  bool ready = false;
  Function<void()> deferred; // async with Launch::deferred: runs on the first get() or wait()
  Thread worker;             // (as SharedState<T>'s)

  ~SharedState()
  {
    if (this->worker.joinable())
      this->worker.join();
  }

  void abandon()
  {
    LockGuard<Mutex> guard(this->mutex);
    if (this->ready)
      return;
    this->exception = makeExceptionPtr(FutureError(FutureErrc::brokenPromise));
    this->ready = true;
    this->cv.notifyAll();
  }

  // The deferred function runs once, on the thread that takes it first (under the lock); the
  // threads that call get() or wait() beside it wait for the result it sets. Until 2026-10-30 each
  // took it without the lock, and two at once could both take it: the second called it empty.
  void runDeferred()
  {
    Function<void()> run;
    {
      LockGuard<Mutex> guard(this->mutex);
      if (!this->deferred)
        return;
      run = move(this->deferred);
      this->deferred = nullptr;
    }
    run();
  }

  void set()
  {
    LockGuard<Mutex> guard(this->mutex);
    this->ready = true;
    this->cv.notifyAll();
  }

  void setException(ExceptionPtr e)
  {
    LockGuard<Mutex> guard(this->mutex);
    this->exception = e;
    this->ready = true;
    this->cv.notifyAll();
  }

  void get()
  {
    this->runDeferred();
    UniqueLock<Mutex> lock(this->mutex);
    this->cv.wait(lock, [this]() -> bool { return this->ready; });
    if (this->exception)
      rethrowException(this->exception);
  }

  void wait()
  {
    this->runDeferred();
    UniqueLock<Mutex> lock(this->mutex);
    this->cv.wait(lock, [this]() -> bool { return this->ready; });
  }

  template<typename Rep, typename Period>
  FutureStatus waitFor(const Duration<Rep, Period>& d)
  {
    UniqueLock<Mutex> lock(this->mutex);
    if (this->deferred)
      return FutureStatus::deferred;
    return this->cv.waitFor(lock, d, [this]() -> bool { return this->ready; }) ? FutureStatus::ready : FutureStatus::timeout;
  }
};

template<typename T>
class Future
{
public:
  Future() {}
  Future(SharedPtr<SharedState<T>> state) : state(move(state)) {}
  Future(const Future<T>&) = delete;
  Future(Future<T>&& other) noexcept : state(move(other.state)) {}
  Future<T>& operator=(const Future<T>&) = delete;

  Future<T>& operator=(Future<T>&& other) noexcept
  {
    this->state = move(other.state);
    return *this;
  }

  bool valid() const { return (bool)this->state; }

  // Releases the state, as std::future::get does: valid() is false after it (ThreadedBufferedReadStream
  // asserts that once it has waited for its worker).
  T get()
  {
    SharedPtr<SharedState<T>> held = move(this->state);
    return move(held->get());
  }

  void wait() const { this->state->wait(); }

  template<typename Rep, typename Period>
  FutureStatus wait_for(const Duration<Rep, Period>& d) const { return this->state->waitFor(d); }
  template<typename Rep, typename Period>
  FutureStatus waitFor(const Duration<Rep, Period>& d) const { return this->state->waitFor(d); }

private:
  template<typename U> friend class SharedFuture;

  SharedPtr<SharedState<T>> state;
};

template<>
class Future<void>
{
public:
  Future() {}
  Future(SharedPtr<SharedState<void>> state) : state(move(state)) {}
  Future(const Future<void>&) = delete;
  Future(Future<void>&& other) noexcept : state(move(other.state)) {}
  Future<void>& operator=(const Future<void>&) = delete;

  Future<void>& operator=(Future<void>&& other) noexcept
  {
    this->state = move(other.state);
    return *this;
  }

  bool valid() const { return (bool)this->state; }

  void get()
  {
    SharedPtr<SharedState<void>> held = move(this->state); // released, as Future<T>::get does
    held->get();
  }

  void wait() const { this->state->wait(); }
  template<typename Rep, typename Period>
  FutureStatus wait_for(const Duration<Rep, Period>& d) const { return this->state->waitFor(d); }
  template<typename Rep, typename Period>
  FutureStatus waitFor(const Duration<Rep, Period>& d) const { return this->state->waitFor(d); }

private:
  SharedPtr<SharedState<void>> state;
};

template<typename T>
class SharedFuture
{
public:
  SharedFuture() {}
  implicit SharedFuture(Future<T>&& f) noexcept : state(move(f.state)) {}
  SharedFuture(const SharedFuture<T>& other) : state(other.state) {}

  bool valid() const { return (bool)this->state; }
  const T& get() const { return this->state->get(); }
  void wait() const { this->state->wait(); }
  template<typename Rep, typename Period>
  FutureStatus wait_for(const Duration<Rep, Period>& d) const { return this->state->waitFor(d); }

private:
  SharedPtr<SharedState<T>> state;
};

template<typename T>
class Promise
{
public:
  Promise() : state(makeShared<SharedState<T>>()) {}
  Promise(const Promise<T>&) = delete;
  Promise(Promise<T>&& other) noexcept : state(move(other.state)) {}
  Promise<T>& operator=(const Promise<T>&) = delete;

  // A Promise that set nothing leaves its Future ready with a broken promise, never waiting forever.
  ~Promise()
  {
    if (this->state)
      this->state->abandon();
  }

  Promise<T>& operator=(Promise<T>&& other) noexcept
  {
    if (this->state)
      this->state->abandon();
    this->state = move(other.state);
    return *this;
  }

  Future<T> get_future() { return Future<T>(this->state); }
  Future<T> getFuture() { return Future<T>(this->state); }

  void set_value(const T& value) { this->state->set(value); }
  void set_value(T&& value) { this->state->set(move(value)); }
  void setValue(const T& value) { this->state->set(value); }
  void setValue(T&& value) { this->state->set(move(value)); }

  void set_exception(ExceptionPtr e) { this->state->setException(e); }

private:
  SharedPtr<SharedState<T>> state;
};

template<>
class Promise<void>
{
public:
  Promise() : state(makeShared<SharedState<void>>()) {}
  Promise(const Promise<void>&) = delete;
  Promise(Promise<void>&& other) noexcept : state(move(other.state)) {}
  Promise<void>& operator=(const Promise<void>&) = delete;

  ~Promise()
  {
    if (this->state)
      this->state->abandon();
  }

  Promise<void>& operator=(Promise<void>&& other) noexcept
  {
    if (this->state)
      this->state->abandon();
    this->state = move(other.state);
    return *this;
  }

  Future<void> get_future() { return Future<void>(this->state); }
  Future<void> getFuture() { return Future<void>(this->state); }
  void set_value() { this->state->set(); }
  void setValue() { this->state->set(); }
  void set_exception(ExceptionPtr e) { this->state->setException(e); }

private:
  SharedPtr<SharedState<void>> state;
};

// Calls callable and stores what it returns in state (a void callable just completes it), or what
// it throws, which get() throws again ([futures.async] 4; until 2026-11-06 it ended the program).
template<typename R, typename F>
void runInto(SharedState<R>* state, F callable)
{
  try
  {
    if constexpr (isVoid<R>)
    {
      callable();
      state->set();
    }
    else
      state->set(callable());
  }
  catch (...)
  {
    state->setException(currentException());
  }
}

// async: runs a callable on a new thread (Launch::async) or on the first get() or wait() of its
// Future (Launch::deferred), and returns a Future to its result.
template<typename F>
auto async(Launch policy, F callable) -> Future<decltype(callable())>
{
  using R = decltype(callable());
  auto state = makeShared<SharedState<R>>();
  SharedState<R>* raw = state.get(); // the state owns the deferred function, which only points back
  // The callable is moved along, never copied: it may hold what cannot be copied
  // (ThreadedChunkedZipPackageWriteStream's `[buffer = move(buffer)]`).
  if (policy == Launch::deferred)
    state->deferred = [raw, callable = move(callable)]() mutable { runInto<R>(raw, move(callable)); };
  else
    state->worker = Thread([raw, callable = move(callable)]() mutable { runInto<R>(raw, move(callable)); }); // (joined by the state)
  return Future<R>(state);
}

template<typename F>
auto async(F callable) -> Future<decltype(callable())>
{
  return async(Launch::async, move(callable));
}

// Free-standing atomic operations (what std::atomic_load/store convert to).
template<typename T>
T atomicLoad(const Atomic<T>* a) { return a->load(); }

template<typename T>
void atomicStore(Atomic<T>* a, T value) { a->store(value); }
