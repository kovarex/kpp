// kpp standard library: Text, the parameter type that takes a call's arguments as they are
// (design.md 14). `void log(Text text)` called as `log("Hello ", name, age)`: the compiler packs
// the arguments from the Text parameter's position on into one Text, each piece with the function
// that appends it through its type's appendTo, so log is compiled once whatever its callers pass.
// The arguments live to the end of the caller's full expression, so a Text is valid during the
// call only: it is a parameter (or a local copy of one) and is never stored, a compile error.
// The compiler builds it directly (a pointer to the pieces, then their count: keep these two
// fields first, and TextPiece's two).

// One argument: where it is, and the function that appends it.
struct TextPiece
{
  const void* object = nullptr;
  void (*append)(const void* object, String& out) = nullptr;
};

struct Text
{
  const TextPiece* pieces = nullptr;
  ContainerSize count = 0;

  // Every piece appended to out, in order.
  void appendTo(String& out) const
  {
    for (ContainerSize i = 0; i < this.count; ++i)
      this.pieces[i].append(this.pieces[i].object, out);
  }
};

// What appends a piece, the compiler choosing by its type: a class's `void appendTo(String& out)
// const`; a built-in type's or an enumeration's, which the standard library writes as a free
// `void appendTo(T value, String& out)` (the program writes no free appendTo); or C text (a string
// literal or an array of chars, to its first zero).
template<typename T>
void appendMemberPiece(const void* object, String& out)
{
  static_cast<const T*>(object)->appendTo(out);
}

template<typename T>
void appendFreePiece(const void* object, String& out)
{
  appendTo(*static_cast<const T*>(object), out);
}

void appendCTextPiece(const void* object, String& out)
{
  out.append(static_cast<const char*>(object));
}

// The built-in types' appendTo (design.md 14: `x.appendTo(out)` for every type; the compiler
// resolves the member call on a built-in to these, which only the standard library writes). One for
// each type, taken exactly: an integer as its digits (u8 and i8 too: a character is appended only
// from a char), a float or double as its shortest round-trip text, a bool as true or false.
void appendTo(char value, String& out) { out.append(value); }
void appendTo(bool value, String& out) { out.append(value ? "true" : "false"); }
void appendTo(i8 value, String& out) { out.append(toString(i32(value))); }
void appendTo(u8 value, String& out) { out.append(toString((u32)value)); }
void appendTo(i16 value, String& out) { out.append(toString(i32(value))); }
void appendTo(u16 value, String& out) { out.append(toString((u32)value)); }
void appendTo(i32 value, String& out) { out.append(toString(value)); }
void appendTo(u32 value, String& out) { out.append(toString(value)); }
void appendTo(long value, String& out) { out.append(toString(value)); }
void appendTo(unsigned long value, String& out) { out.append(toString(value)); }
void appendTo(i64 value, String& out) { out.append(toString(value)); }
void appendTo(u64 value, String& out) { out.append(toString(value)); }
void appendTo(float value, String& out) { out.append(toString(value)); }
void appendTo(double value, String& out) { out.append(toString(value)); }

// An enumeration's appendTo (design.md 14): its enumerator's name (`Direction::North` is "North"),
// or for a value that is no enumerator the enumeration's name and the value (`Direction(7)`). An
// enumeration with its own appendTo method uses that. The two intrinsics are the compiler's.
template<typename E>
const char* kppEnumeratorName(E value);
template<typename E>
const char* kppEnumTypeName();

template<typename E>
  requires isEnum<E>
void appendTo(E value, String& out)
{
  if (const char* name = kppEnumeratorName(value))
  {
    out.append(name);
    return;
  }
  out.append(kppEnumTypeName<E>());
  out.append("(");
  appendTo(static_cast<UnderlyingType<E>>(value), out);
  out.append(")");
}
