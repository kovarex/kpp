// Kpp standard library: Map<K, V>, Set<T>, MultiMap<K, V> and MultiSet<T> (what std::map,
// std::set, std::multimap and std::multiset convert to), ordered by operator<.
//
// They keep the guarantees of the C++ standard, which converted code relies on: each entry lives
// in a node of its own, in a red-black tree (as in all three C++ libraries), so inserting never
// invalidates iterators, pointers or references, and erasing invalidates only those to the erased
// entries; lookups, inserts and erases are O(log n), iterator steps amortized O(1). The multi
// versions keep equal keys in insertion order. FastMap/FastSet (FastMap.kpp) are faster but
// move entries around: a choice to make explicitly.

// The links of a node. Every tree has a header node of its own: header.parent is the root (whose
// parent is the header), header.left the first node, header.right the last, and the header itself
// is end(). The header is red and the root black, which is how decrementing tells end() apart.
struct RbNodeBase
{
  RbNodeBase* parent = nullptr;
  RbNodeBase* left = nullptr;
  RbNodeBase* right = nullptr;
  bool red = false;
};

template<typename E>
struct RbNode : RbNodeBase
{
  E entry;
};

RbNodeBase* rbMinimum(RbNodeBase* node)
{
  while (node->left)
    node = node->left;
  return node;
}

RbNodeBase* rbMaximum(RbNodeBase* node)
{
  while (node->right)
    node = node->right;
  return node;
}

// The node after node in order; the header after the last one.
RbNodeBase* rbNext(RbNodeBase* node)
{
  if (node->right)
    return rbMinimum(node->right);
  RbNodeBase* parent = node->parent;
  while (node == parent->right)
  {
    node = parent;
    parent = parent->parent;
  }
  // From the last node the climb ends at the header, whose parent is the root: then node is the
  // header already.
  return node->right != parent ? parent : node;
}

// The node before node in order; the last one before the header.
RbNodeBase* rbPrevious(RbNodeBase* node)
{
  if (node->red && node->parent->parent == node)
    return node->right; // the header
  if (node->left)
    return rbMaximum(node->left);
  RbNodeBase* parent = node->parent;
  while (node == parent->left)
  {
    node = parent;
    parent = parent->parent;
  }
  return parent;
}

void rbRotateLeft(RbNodeBase* node, RbNodeBase*& root)
{
  RbNodeBase* pivot = node->right;
  node->right = pivot->left;
  if (pivot->left)
    pivot->left->parent = node;
  pivot->parent = node->parent;
  if (node == root)
    root = pivot;
  else if (node == node->parent->left)
    node->parent->left = pivot;
  else
    node->parent->right = pivot;
  pivot->left = node;
  node->parent = pivot;
}

void rbRotateRight(RbNodeBase* node, RbNodeBase*& root)
{
  RbNodeBase* pivot = node->left;
  node->left = pivot->right;
  if (pivot->right)
    pivot->right->parent = node;
  pivot->parent = node->parent;
  if (node == root)
    root = pivot;
  else if (node == node->parent->right)
    node->parent->right = pivot;
  else
    node->parent->left = pivot;
  pivot->right = node;
  node->parent = pivot;
}

// Links node in as the left or right child of parent (the header for an empty tree) and restores
// the red-black properties.
void rbInsertAndRebalance(bool asLeft, RbNodeBase* node, RbNodeBase* parent, RbNodeBase& header)
{
  node->parent = parent;
  node->left = nullptr;
  node->right = nullptr;
  node->red = true;
  if (asLeft)
  {
    parent->left = node; // the header's left too: the first node of an empty tree
    if (parent == &header)
    {
      header.parent = node;
      header.right = node;
    }
    else if (parent == header.left)
      header.left = node;
  }
  else
  {
    parent->right = node;
    if (parent == header.right)
      header.right = node;
  }
  RbNodeBase*& root = header.parent;
  while (node != root && node->parent->red)
  {
    RbNodeBase* grandparent = node->parent->parent;
    if (node->parent == grandparent->left)
    {
      RbNodeBase* uncle = grandparent->right;
      if (uncle && uncle->red)
      {
        node->parent->red = false;
        uncle->red = false;
        grandparent->red = true;
        node = grandparent;
      }
      else
      {
        if (node == node->parent->right)
        {
          node = node->parent;
          rbRotateLeft(node, root);
        }
        node->parent->red = false;
        grandparent->red = true;
        rbRotateRight(grandparent, root);
      }
    }
    else
    {
      RbNodeBase* uncle = grandparent->left;
      if (uncle && uncle->red)
      {
        node->parent->red = false;
        uncle->red = false;
        grandparent->red = true;
        node = grandparent;
      }
      else
      {
        if (node == node->parent->left)
        {
          node = node->parent;
          rbRotateRight(node, root);
        }
        node->parent->red = false;
        grandparent->red = true;
        rbRotateLeft(grandparent, root);
      }
    }
  }
  root->red = false;
}

// Unlinks node from the tree and restores the red-black properties; the caller frees the node.
void rbEraseAndRebalance(RbNodeBase* node, RbNodeBase& header)
{
  RbNodeBase*& root = header.parent;
  RbNodeBase* removed = node; // the node that leaves its place: node, or its successor
  RbNodeBase* child = nullptr; // what takes removed's place
  RbNodeBase* childParent = nullptr;
  if (!removed->left)
    child = removed->right;
  else if (!removed->right)
    child = removed->left;
  else
  {
    removed = rbMinimum(removed->right);
    child = removed->right;
  }
  bool removedRed = removed->red;
  if (removed != node)
  {
    // node has two children: its successor takes its place (and colour).
    node->left->parent = removed;
    removed->left = node->left;
    if (removed != node->right)
    {
      childParent = removed->parent;
      if (child)
        child->parent = removed->parent;
      removed->parent->left = child;
      removed->right = node->right;
      node->right->parent = removed;
    }
    else
      childParent = removed;
    if (root == node)
      root = removed;
    else if (node->parent->left == node)
      node->parent->left = removed;
    else
      node->parent->right = removed;
    removed->parent = node->parent;
    removedRed = removed->red;
    removed->red = node->red;
  }
  else
  {
    childParent = removed->parent;
    if (child)
      child->parent = removed->parent;
    if (root == node)
      root = child;
    else if (node->parent->left == node)
      node->parent->left = child;
    else
      node->parent->right = child;
    if (header.left == node)
      header.left = node->right ? rbMinimum(child) : node->parent;
    if (header.right == node)
      header.right = node->left ? rbMaximum(child) : node->parent;
  }
  if (removedRed)
    return;
  // A black node left: child carries an extra black up until it can be absorbed.
  while (child != root && (!child || !child->red))
  {
    if (child == childParent->left)
    {
      RbNodeBase* sibling = childParent->right;
      if (sibling->red)
      {
        sibling->red = false;
        childParent->red = true;
        rbRotateLeft(childParent, root);
        sibling = childParent->right;
      }
      if ((!sibling->left || !sibling->left->red) && (!sibling->right || !sibling->right->red))
      {
        sibling->red = true;
        child = childParent;
        childParent = childParent->parent;
      }
      else
      {
        if (!sibling->right || !sibling->right->red)
        {
          sibling->left->red = false;
          sibling->red = true;
          rbRotateRight(sibling, root);
          sibling = childParent->right;
        }
        sibling->red = childParent->red;
        childParent->red = false;
        if (sibling->right)
          sibling->right->red = false;
        rbRotateLeft(childParent, root);
        break;
      }
    }
    else
    {
      RbNodeBase* sibling = childParent->left;
      if (sibling->red)
      {
        sibling->red = false;
        childParent->red = true;
        rbRotateRight(childParent, root);
        sibling = childParent->left;
      }
      if ((!sibling->right || !sibling->right->red) && (!sibling->left || !sibling->left->red))
      {
        sibling->red = true;
        child = childParent;
        childParent = childParent->parent;
      }
      else
      {
        if (!sibling->left || !sibling->left->red)
        {
          sibling->right->red = false;
          sibling->red = true;
          rbRotateLeft(sibling, root);
          sibling = childParent->left;
        }
        sibling->red = childParent->red;
        childParent->red = false;
        if (sibling->left)
          sibling->left->red = false;
        rbRotateRight(childParent, root);
        break;
      }
    }
  }
  if (child)
    child->red = false;
}

// A position in a tree: an entry's node, or the header for end().
template<typename E>
struct RbIterator
{
  RbNodeBase* node = nullptr;

  RbIterator() {}
  explicit RbIterator(RbNodeBase* node) : node(node) {}

  E& operator*() const { return ((RbNode<E>*)this->node)->entry; }
  E* operator->() const { return &((RbNode<E>*)this->node)->entry; }
  bool operator==(const RbIterator<E>& other) const { return this->node == other.node; }
  bool operator!=(const RbIterator<E>& other) const { return this->node != other.node; }
  RbIterator<E>& operator++()
  {
    this->node = rbNext(this->node);
    return *this;
  }
  RbIterator<E> operator++(int)
  {
    RbIterator<E> before = *this;
    this->node = rbNext(this->node);
    return before;
  }
  RbIterator<E>& operator--()
  {
    this->node = rbPrevious(this->node);
    return *this;
  }
  RbIterator<E> operator--(int)
  {
    RbIterator<E> before = *this;
    this->node = rbPrevious(this->node);
    return before;
  }
};

// The tree behind the four containers: entries E ordered by their keys KeyOf::of(entry), of type
// K. It allows equal keys; the unique containers look before they insert.
template<typename E, typename K, typename KeyOf>
struct RbTree
{
  RbNodeBase header;
  int count = 0;

  RbTree() { this->becomeEmpty(); }
  RbTree(const RbTree<E, K, KeyOf>& other)
  {
    this->becomeEmpty();
    this->copyFrom(other);
  }
  RbTree(RbTree<E, K, KeyOf>&& other)
  {
    this->becomeEmpty();
    this->take(other);
  }
  ~RbTree() { this->clear(); }
  RbTree<E, K, KeyOf>& operator=(const RbTree<E, K, KeyOf>& other)
  {
    if (this != &other)
    {
      this->clear();
      this->copyFrom(other);
    }
    return *this;
  }
  RbTree<E, K, KeyOf>& operator=(RbTree<E, K, KeyOf>&& other)
  {
    if (this != &other)
    {
      this->clear();
      this->take(other);
    }
    return *this;
  }

  RbIterator<E> begin() const { return RbIterator<E>(this->header.left); }
  RbIterator<E> end() const { return RbIterator<E>((RbNodeBase*)&this->header); }

  // The first entry whose key is not less than key.
  RbIterator<E> lowerBound(const K& key) const
  {
    RbNodeBase* result = (RbNodeBase*)&this->header;
    RbNodeBase* node = this->header.parent;
    while (node)
    {
      const K& nodeKey = RbTree::keyOf(node);
      if (nodeKey < key)
        node = node->right;
      else
      {
        result = node;
        node = node->left;
      }
    }
    return RbIterator<E>(result);
  }
  // The first entry whose key is greater than key.
  RbIterator<E> upperBound(const K& key) const
  {
    RbNodeBase* result = (RbNodeBase*)&this->header;
    RbNodeBase* node = this->header.parent;
    while (node)
    {
      if (key < RbTree::keyOf(node))
      {
        result = node;
        node = node->left;
      }
      else
        node = node->right;
    }
    return RbIterator<E>(result);
  }
  // An entry with key (the first of equal ones), or end().
  RbIterator<E> find(const K& key) const
  {
    RbIterator<E> at = this->lowerBound(key);
    if (at.node == &this->header || key < RbTree::keyOf(at.node))
      return this->end();
    return at;
  }
  int countOf(const K& key) const
  {
    int n = 0;
    for (RbIterator<E> at = this->lowerBound(key); at.node != &this->header && !(key < RbTree::keyOf(at.node)); ++at)
      ++n;
    return n;
  }

  // Adds entry after any entries with an equal key and returns where it went.
  RbIterator<E> insertEqual(E&& entry)
  {
    const K& key = KeyOf::of(entry);
    RbNodeBase* parent = &this->header;
    RbNodeBase* node = this->header.parent;
    bool asLeft = true;
    while (node)
    {
      parent = node;
      asLeft = key < RbTree::keyOf(node);
      node = asLeft ? node->left : node->right;
    }
    RbNode<E>* fresh = (RbNode<E>*)malloc(sizeof(RbNode<E>));
    new (&fresh->entry) E(move(entry));
    rbInsertAndRebalance(asLeft, fresh, parent, this->header);
    ++this->count;
    return RbIterator<E>(fresh);
  }

  // Removes the entry at position; returns the position after it.
  RbIterator<E> erase(RbIterator<E> position)
  {
    RbNodeBase* next = rbNext(position.node);
    rbEraseAndRebalance(position.node, this->header);
    this->destroyNode(position.node);
    --this->count;
    return RbIterator<E>(next);
  }
  RbIterator<E> erase(RbIterator<E> first, RbIterator<E> last)
  {
    while (first != last)
      first = this->erase(first);
    return last;
  }

  void clear()
  {
    if (this->header.parent)
      this->destroySubtree(this->header.parent);
    this->becomeEmpty();
    this->count = 0;
  }

  // Internals.
  static const K& keyOf(const RbNodeBase* node) { return KeyOf::of(((const RbNode<E>*)node)->entry); }

  void becomeEmpty()
  {
    this->header.parent = nullptr;
    this->header.left = &this->header;
    this->header.right = &this->header;
    this->header.red = true;
  }
  void destroyNode(RbNodeBase* node)
  {
    ((RbNode<E>*)node)->entry.~E();
    free(node);
  }
  void destroySubtree(RbNodeBase* node)
  {
    while (node)
    {
      if (node->right)
        this->destroySubtree(node->right);
      RbNodeBase* left = node->left;
      this->destroyNode(node);
      node = left;
    }
  }
  RbNodeBase* clone(const RbNodeBase* source, RbNodeBase* parent)
  {
    RbNode<E>* node = (RbNode<E>*)malloc(sizeof(RbNode<E>));
    new (&node->entry) E(((const RbNode<E>*)source)->entry);
    node->red = source->red;
    node->parent = parent;
    node->left = source->left ? this->clone(source->left, node) : nullptr;
    node->right = source->right ? this->clone(source->right, node) : nullptr;
    return node;
  }
  void copyFrom(const RbTree<E, K, KeyOf>& other)
  {
    if (!other.header.parent)
      return;
    this->header.parent = this->clone(other.header.parent, &this->header);
    this->header.left = rbMinimum(this->header.parent);
    this->header.right = rbMaximum(this->header.parent);
    this->count = other.count;
  }
  // Takes other's nodes; the root has to point at this header instead.
  void take(RbTree<E, K, KeyOf>& other)
  {
    if (!other.header.parent)
      return;
    this->header.parent = other.header.parent;
    this->header.left = other.header.left;
    this->header.right = other.header.right;
    this->header.parent->parent = &this->header;
    this->count = other.count;
    other.becomeEmpty();
    other.count = 0;
  }
};

template<typename K, typename V>
struct MapKey
{
  static const K& of(const Pair<K, V>& entry) { return entry.first; }
};

template<typename T>
struct SetKey
{
  static const T& of(const T& entry) { return entry; }
};

// An ordered map with unique keys: entries are Pair<K, V> in key order.
template<typename K, typename V>
struct Map
{
  RbTree<Pair<K, V>, K, MapKey<K, V>> tree;

  using iterator = RbIterator<Pair<K, V>>;
  using const_iterator = RbIterator<Pair<K, V>>;
  using value_type = Pair<K, V>;

  Map() {}
  // `Map<char, Kind> table = {{'+', Kind::Plus}, {'-', Kind::Minus}};`
  implicit Map(InitializerList<Pair<K, V>> items)
  {
    for (const Pair<K, V>& item : items)
      this->insert(item);
  }

  int size() const { return this->tree.count; }
  bool empty() const { return this->tree.count == 0; }
  RbIterator<Pair<K, V>> begin() const { return this->tree.begin(); }
  RbIterator<Pair<K, V>> end() const { return this->tree.end(); }

  RbIterator<Pair<K, V>> find(const K& key) const { return this->tree.find(key); }
  bool contains(const K& key) const { return this->tree.find(key) != this->tree.end(); }
  int count(const K& key) const { return this->contains(key) ? 1 : 0; }
  RbIterator<Pair<K, V>> lowerBound(const K& key) const { return this->tree.lowerBound(key); }
  RbIterator<Pair<K, V>> lower_bound(const K& key) const { return this->tree.lowerBound(key); }
  RbIterator<Pair<K, V>> upperBound(const K& key) const { return this->tree.upperBound(key); }
  RbIterator<Pair<K, V>> upper_bound(const K& key) const { return this->tree.upperBound(key); }
  Pair<RbIterator<Pair<K, V>>, RbIterator<Pair<K, V>>> equal_range(const K& key) const
  {
    return Pair<RbIterator<Pair<K, V>>, RbIterator<Pair<K, V>>>(this->tree.lowerBound(key), this->tree.upperBound(key));
  }

  // The value for key, inserted default-constructed when new.
  V& operator[](const K& key)
  {
    RbIterator<Pair<K, V>> at = this->tree.lowerBound(key);
    if (at != this->tree.end() && !(key < at->first))
      return at->second;
    return this->tree.insertEqual(Pair<K, V>(key, V()))->second;
  }
  V& at(const K& key) { return this->tree.find(key)->second; }
  const V& at(const K& key) const { return this->tree.find(key)->second; }
  // std::map::insert: the entry with the key and whether it was added (an existing value is kept).
  Pair<RbIterator<Pair<K, V>>, bool> insert(const Pair<K, V>& entry)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(entry.first);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.insertEqual(Pair<K, V>(entry)), true);
  }
  Pair<RbIterator<Pair<K, V>>, bool> insert(Pair<K, V>&& entry)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(entry.first);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.insertEqual(move(entry)), true);
  }
  // std::map::emplace: the entry built from the arguments, unless its key is there already.
  template<typename... Args>
  Pair<RbIterator<Pair<K, V>>, bool> emplace(Args&&... args) { return this->insert(Pair<K, V>(forward<Args>(args)...)); }
  // std::map::try_emplace: builds the value from the arguments only when the key is new.
  template<typename... Args>
  Pair<RbIterator<Pair<K, V>>, bool> try_emplace(const K& key, Args&&... args)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.insertEqual(Pair<K, V>(key, V(forward<Args>(args)...))), true);
  }
  // Kpp's shorthand: true when the key was new.
  bool insert(const K& key, const V& value) { return this->insert(Pair<K, V>(key, value)).second; }
  // The number of entries removed (0 or 1).
  int erase(const K& key)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at == this->tree.end())
      return 0;
    this->tree.erase(at);
    return 1;
  }
  RbIterator<Pair<K, V>> erase(RbIterator<Pair<K, V>> position) { return this->tree.erase(position); }
  RbIterator<Pair<K, V>> erase(RbIterator<Pair<K, V>> first, RbIterator<Pair<K, V>> last) { return this->tree.erase(first, last); }
  void clear() { this->tree.clear(); }
};

// An ordered set of unique values.
template<typename T>
struct Set
{
  RbTree<T, T, SetKey<T>> tree;

  using iterator = RbIterator<T>;
  using const_iterator = RbIterator<T>;
  using value_type = T;

  Set() {}
  implicit Set(InitializerList<T> items)
  {
    for (const T& value : items)
      this->insert(value);
  }

  int size() const { return this->tree.count; }
  bool empty() const { return this->tree.count == 0; }
  RbIterator<T> begin() const { return this->tree.begin(); }
  RbIterator<T> end() const { return this->tree.end(); }

  RbIterator<T> find(const T& value) const { return this->tree.find(value); }
  bool contains(const T& value) const { return this->tree.find(value) != this->tree.end(); }
  int count(const T& value) const { return this->contains(value) ? 1 : 0; }
  RbIterator<T> lowerBound(const T& value) const { return this->tree.lowerBound(value); }
  RbIterator<T> lower_bound(const T& value) const { return this->tree.lowerBound(value); }
  RbIterator<T> upperBound(const T& value) const { return this->tree.upperBound(value); }
  RbIterator<T> upper_bound(const T& value) const { return this->tree.upperBound(value); }
  Pair<RbIterator<T>, RbIterator<T>> equal_range(const T& value) const
  {
    return Pair<RbIterator<T>, RbIterator<T>>(this->tree.lowerBound(value), this->tree.upperBound(value));
  }

  // std::set::insert: the entry with the value and whether it was added.
  Pair<RbIterator<T>, bool> insert(const T& value)
  {
    RbIterator<T> at = this->tree.find(value);
    if (at != this->tree.end())
      return Pair<RbIterator<T>, bool>(at, false);
    return Pair<RbIterator<T>, bool>(this->tree.insertEqual(T(value)), true);
  }
  Pair<RbIterator<T>, bool> insert(T&& value)
  {
    RbIterator<T> at = this->tree.find(value);
    if (at != this->tree.end())
      return Pair<RbIterator<T>, bool>(at, false);
    return Pair<RbIterator<T>, bool>(this->tree.insertEqual(move(value)), true);
  }
  template<typename... Args>
  Pair<RbIterator<T>, bool> emplace(Args&&... args) { return this->insert(T(forward<Args>(args)...)); }
  // The number of values removed (0 or 1).
  int erase(const T& value)
  {
    RbIterator<T> at = this->tree.find(value);
    if (at == this->tree.end())
      return 0;
    this->tree.erase(at);
    return 1;
  }
  RbIterator<T> erase(RbIterator<T> position) { return this->tree.erase(position); }
  RbIterator<T> erase(RbIterator<T> first, RbIterator<T> last) { return this->tree.erase(first, last); }
  void clear() { this->tree.clear(); }
};

// An ordered map that allows equal keys, kept in insertion order among themselves.
template<typename K, typename V>
struct MultiMap
{
  RbTree<Pair<K, V>, K, MapKey<K, V>> tree;

  using iterator = RbIterator<Pair<K, V>>;
  using const_iterator = RbIterator<Pair<K, V>>;
  using value_type = Pair<K, V>;

  MultiMap() {}
  implicit MultiMap(InitializerList<Pair<K, V>> items)
  {
    for (const Pair<K, V>& item : items)
      this->insert(item);
  }

  int size() const { return this->tree.count; }
  bool empty() const { return this->tree.count == 0; }
  RbIterator<Pair<K, V>> begin() const { return this->tree.begin(); }
  RbIterator<Pair<K, V>> end() const { return this->tree.end(); }

  RbIterator<Pair<K, V>> find(const K& key) const { return this->tree.find(key); }
  bool contains(const K& key) const { return this->tree.find(key) != this->tree.end(); }
  int count(const K& key) const { return this->tree.countOf(key); }
  RbIterator<Pair<K, V>> lowerBound(const K& key) const { return this->tree.lowerBound(key); }
  RbIterator<Pair<K, V>> lower_bound(const K& key) const { return this->tree.lowerBound(key); }
  RbIterator<Pair<K, V>> upperBound(const K& key) const { return this->tree.upperBound(key); }
  RbIterator<Pair<K, V>> upper_bound(const K& key) const { return this->tree.upperBound(key); }
  Pair<RbIterator<Pair<K, V>>, RbIterator<Pair<K, V>>> equal_range(const K& key) const
  {
    return Pair<RbIterator<Pair<K, V>>, RbIterator<Pair<K, V>>>(this->tree.lowerBound(key), this->tree.upperBound(key));
  }

  RbIterator<Pair<K, V>> insert(const Pair<K, V>& entry) { return this->tree.insertEqual(Pair<K, V>(entry)); }
  RbIterator<Pair<K, V>> insert(Pair<K, V>&& entry) { return this->tree.insertEqual(move(entry)); }
  template<typename... Args>
  RbIterator<Pair<K, V>> emplace(Args&&... args) { return this->tree.insertEqual(Pair<K, V>(forward<Args>(args)...)); }
  RbIterator<Pair<K, V>> insert(const K& key, const V& value) { return this->tree.insertEqual(Pair<K, V>(key, value)); }
  // Removes every entry with key; returns how many.
  int erase(const K& key)
  {
    RbIterator<Pair<K, V>> first = this->tree.lowerBound(key);
    RbIterator<Pair<K, V>> last = this->tree.upperBound(key);
    int removed = 0;
    while (first != last)
    {
      first = this->tree.erase(first);
      ++removed;
    }
    return removed;
  }
  RbIterator<Pair<K, V>> erase(RbIterator<Pair<K, V>> position) { return this->tree.erase(position); }
  RbIterator<Pair<K, V>> erase(RbIterator<Pair<K, V>> first, RbIterator<Pair<K, V>> last) { return this->tree.erase(first, last); }
  void clear() { this->tree.clear(); }
};

// An ordered set that allows equal values, kept in insertion order among themselves.
template<typename T>
struct MultiSet
{
  RbTree<T, T, SetKey<T>> tree;

  using iterator = RbIterator<T>;
  using const_iterator = RbIterator<T>;
  using value_type = T;

  MultiSet() {}
  implicit MultiSet(InitializerList<T> items)
  {
    for (const T& value : items)
      this->insert(value);
  }

  int size() const { return this->tree.count; }
  bool empty() const { return this->tree.count == 0; }
  RbIterator<T> begin() const { return this->tree.begin(); }
  RbIterator<T> end() const { return this->tree.end(); }

  RbIterator<T> find(const T& value) const { return this->tree.find(value); }
  bool contains(const T& value) const { return this->tree.find(value) != this->tree.end(); }
  int count(const T& value) const { return this->tree.countOf(value); }
  RbIterator<T> lowerBound(const T& value) const { return this->tree.lowerBound(value); }
  RbIterator<T> lower_bound(const T& value) const { return this->tree.lowerBound(value); }
  RbIterator<T> upperBound(const T& value) const { return this->tree.upperBound(value); }
  RbIterator<T> upper_bound(const T& value) const { return this->tree.upperBound(value); }
  Pair<RbIterator<T>, RbIterator<T>> equal_range(const T& value) const
  {
    return Pair<RbIterator<T>, RbIterator<T>>(this->tree.lowerBound(value), this->tree.upperBound(value));
  }

  RbIterator<T> insert(const T& value) { return this->tree.insertEqual(T(value)); }
  RbIterator<T> insert(T&& value) { return this->tree.insertEqual(move(value)); }
  // Removes every value equal to value; returns how many.
  int erase(const T& value)
  {
    RbIterator<T> first = this->tree.lowerBound(value);
    RbIterator<T> last = this->tree.upperBound(value);
    int removed = 0;
    while (first != last)
    {
      first = this->tree.erase(first);
      ++removed;
    }
    return removed;
  }
  RbIterator<T> erase(RbIterator<T> position) { return this->tree.erase(position); }
  RbIterator<T> erase(RbIterator<T> first, RbIterator<T> last) { return this->tree.erase(first, last); }
  void clear() { this->tree.clear(); }
};
