// kpp standard library: Map<K, V>, Set<T>, MultiMap<K, V> and MultiSet<T> (what std::map,
// std::set, std::multimap and std::multiset convert to), ordered by a comparator: the last
// template argument, Less<K> (operator<) unless given.
//
// They keep the guarantees of the C++ standard, which converted code relies on: each entry lives
// in a node of its own, in a red-black tree (as in all three C++ libraries), so inserting never
// invalidates iterators, pointers or references, and erasing invalidates only those to the erased
// entries; lookups, inserts and erases are O(log n), iterator steps amortized O(1). The multi
// versions keep equal keys in insertion order. FastMap/FastSet (FastMap.kpp) are faster but
// move entries around: a choice to make explicitly.

// The links of a node. Every tree has a header node of its own: header.parent is the root (whose
// parent is the header), header.left the first node, header.right the last, and the header itself
// is end(). The header is red and the root black, which is how decrementing tells end() apart.
struct RbNodeBase
{
  RbNodeBase* parent = nullptr;
  RbNodeBase* left = nullptr;
  RbNodeBase* right = nullptr;
  bool red = false;
};

template<typename E>
struct RbNode : RbNodeBase
{
  E entry;
};

RbNodeBase* rbMinimum(RbNodeBase* node)
{
  while (node->left)
    node = node->left;
  return node;
}

RbNodeBase* rbMaximum(RbNodeBase* node)
{
  while (node->right)
    node = node->right;
  return node;
}

// The node after node in order; the header after the last one.
RbNodeBase* rbNext(RbNodeBase* node)
{
  if (node->right)
    return rbMinimum(node->right);
  RbNodeBase* parent = node->parent;
  while (node == parent->right)
  {
    node = parent;
    parent = parent->parent;
  }
  // From the last node the climb ends at the header, whose parent is the root: then node is the
  // header already.
  return node->right != parent ? parent : node;
}

// The node before node in order; the last one before the header.
RbNodeBase* rbPrevious(RbNodeBase* node)
{
  if (node->red && node->parent->parent == node)
    return node->right; // the header
  if (node->left)
    return rbMaximum(node->left);
  RbNodeBase* parent = node->parent;
  while (node == parent->left)
  {
    node = parent;
    parent = parent->parent;
  }
  return parent;
}

void rbRotateLeft(RbNodeBase* node, RbNodeBase*& root)
{
  RbNodeBase* pivot = node->right;
  node->right = pivot->left;
  if (pivot->left)
    pivot->left->parent = node;
  pivot->parent = node->parent;
  if (node == root)
    root = pivot;
  else if (node == node->parent->left)
    node->parent->left = pivot;
  else
    node->parent->right = pivot;
  pivot->left = node;
  node->parent = pivot;
}

void rbRotateRight(RbNodeBase* node, RbNodeBase*& root)
{
  RbNodeBase* pivot = node->left;
  node->left = pivot->right;
  if (pivot->right)
    pivot->right->parent = node;
  pivot->parent = node->parent;
  if (node == root)
    root = pivot;
  else if (node == node->parent->right)
    node->parent->right = pivot;
  else
    node->parent->left = pivot;
  pivot->right = node;
  node->parent = pivot;
}

// Links node in as the left or right child of parent (the header for an empty tree) and restores
// the red-black properties.
void rbInsertAndRebalance(bool asLeft, RbNodeBase* node, RbNodeBase* parent, RbNodeBase& header)
{
  node->parent = parent;
  node->left = nullptr;
  node->right = nullptr;
  node->red = true;
  if (asLeft)
  {
    parent->left = node; // the header's left too: the first node of an empty tree
    if (parent == &header)
    {
      header.parent = node;
      header.right = node;
    }
    else if (parent == header.left)
      header.left = node;
  }
  else
  {
    parent->right = node;
    if (parent == header.right)
      header.right = node;
  }
  RbNodeBase*& root = header.parent;
  while (node != root && node->parent->red)
  {
    RbNodeBase* grandparent = node->parent->parent;
    if (node->parent == grandparent->left)
    {
      RbNodeBase* uncle = grandparent->right;
      if (uncle && uncle->red)
      {
        node->parent->red = false;
        uncle->red = false;
        grandparent->red = true;
        node = grandparent;
      }
      else
      {
        if (node == node->parent->right)
        {
          node = node->parent;
          rbRotateLeft(node, root);
        }
        node->parent->red = false;
        grandparent->red = true;
        rbRotateRight(grandparent, root);
      }
    }
    else
    {
      RbNodeBase* uncle = grandparent->left;
      if (uncle && uncle->red)
      {
        node->parent->red = false;
        uncle->red = false;
        grandparent->red = true;
        node = grandparent;
      }
      else
      {
        if (node == node->parent->left)
        {
          node = node->parent;
          rbRotateRight(node, root);
        }
        node->parent->red = false;
        grandparent->red = true;
        rbRotateLeft(grandparent, root);
      }
    }
  }
  root->red = false;
}

// Unlinks node from the tree and restores the red-black properties; the caller frees the node.
void rbEraseAndRebalance(RbNodeBase* node, RbNodeBase& header)
{
  RbNodeBase*& root = header.parent;
  RbNodeBase* removed = node; // the node that leaves its place: node, or its successor
  RbNodeBase* child = nullptr; // what takes removed's place
  RbNodeBase* childParent = nullptr;
  if (!removed->left)
    child = removed->right;
  else if (!removed->right)
    child = removed->left;
  else
  {
    removed = rbMinimum(removed->right);
    child = removed->right;
  }
  bool removedRed = removed->red;
  if (removed != node)
  {
    // node has two children: its successor takes its place (and colour).
    node->left->parent = removed;
    removed->left = node->left;
    if (removed != node->right)
    {
      childParent = removed->parent;
      if (child)
        child->parent = removed->parent;
      removed->parent->left = child;
      removed->right = node->right;
      node->right->parent = removed;
    }
    else
      childParent = removed;
    if (root == node)
      root = removed;
    else if (node->parent->left == node)
      node->parent->left = removed;
    else
      node->parent->right = removed;
    removed->parent = node->parent;
    removedRed = removed->red;
    removed->red = node->red;
  }
  else
  {
    childParent = removed->parent;
    if (child)
      child->parent = removed->parent;
    if (root == node)
      root = child;
    else if (node->parent->left == node)
      node->parent->left = child;
    else
      node->parent->right = child;
    if (header.left == node)
      header.left = node->right ? rbMinimum(child) : node->parent;
    if (header.right == node)
      header.right = node->left ? rbMaximum(child) : node->parent;
  }
  if (removedRed)
    return;
  // A black node left: child carries an extra black up until it can be absorbed.
  while (child != root && (!child || !child->red))
  {
    if (child == childParent->left)
    {
      RbNodeBase* sibling = childParent->right;
      if (sibling->red)
      {
        sibling->red = false;
        childParent->red = true;
        rbRotateLeft(childParent, root);
        sibling = childParent->right;
      }
      if ((!sibling->left || !sibling->left->red) && (!sibling->right || !sibling->right->red))
      {
        sibling->red = true;
        child = childParent;
        childParent = childParent->parent;
      }
      else
      {
        if (!sibling->right || !sibling->right->red)
        {
          sibling->left->red = false;
          sibling->red = true;
          rbRotateRight(sibling, root);
          sibling = childParent->right;
        }
        sibling->red = childParent->red;
        childParent->red = false;
        if (sibling->right)
          sibling->right->red = false;
        rbRotateLeft(childParent, root);
        break;
      }
    }
    else
    {
      RbNodeBase* sibling = childParent->left;
      if (sibling->red)
      {
        sibling->red = false;
        childParent->red = true;
        rbRotateRight(childParent, root);
        sibling = childParent->left;
      }
      if ((!sibling->right || !sibling->right->red) && (!sibling->left || !sibling->left->red))
      {
        sibling->red = true;
        child = childParent;
        childParent = childParent->parent;
      }
      else
      {
        if (!sibling->left || !sibling->left->red)
        {
          sibling->right->red = false;
          sibling->red = true;
          rbRotateLeft(sibling, root);
          sibling = childParent->left;
        }
        sibling->red = childParent->red;
        childParent->red = false;
        if (sibling->left)
          sibling->left->red = false;
        rbRotateRight(childParent, root);
        break;
      }
    }
  }
  if (child)
    child->red = false;
}

// A position in a tree: an entry's node, or the header for end(). RbIterator<const E> is the
// const_iterator: the same position, its entry const. An iterator converts to it implicitly, and
// back only explicitly (erase(const_iterator) reaches the node so).
template<typename E>
class RbIterator
{
public:
  using value_type = RemoveConst<E>;
  using difference_type = i64;
  using pointer = E*;
  using reference = E&;
  using iterator_category = BidirectionalIteratorTag;

  RbIterator() {}
  RbIterator(RbNodeBase* node) : node(node) {}
  template<typename F> requires (isSame<F, RemoveConst<E>> && !isSame<F, E>)
  implicit RbIterator(const RbIterator<F>& other) : node(other.node) {}
  template<typename F> requires (isSame<E, RemoveConst<F>> && !isSame<F, E>)
  RbIterator(const RbIterator<F>& other) : node(other.node) {}

  E& operator*() const { return ((RbNode<RemoveConst<E>>*)this->node)->entry; }
  E* operator->() const { return &((RbNode<RemoveConst<E>>*)this->node)->entry; }
  bool operator==(const RbIterator<E>& other) const = default;
  template<typename F> requires (isSame<RemoveConst<F>, RemoveConst<E>> && !isSame<F, E>)
  bool operator==(const RbIterator<F>& other) const { return this->node == other.node; }

  RbIterator<E>& operator++()
  {
    this->node = rbNext(this->node);
    return *this;
  }

  RbIterator<E> operator++(i32)
  {
    RbIterator<E> before = *this;
    this->node = rbNext(this->node);
    return before;
  }

  RbIterator<E>& operator--()
  {
    this->node = rbPrevious(this->node);
    return *this;
  }

  RbIterator<E> operator--(i32)
  {
    RbIterator<E> before = *this;
    this->node = rbPrevious(this->node);
    return before;
  }

private:
  template<typename F> friend class RbIterator;
  template<typename E2, typename K, typename KeyOf, typename Compare> friend class RbTree;
  template<typename K, typename V, typename Compare> friend class Map;
  template<typename T, typename Compare> friend class Set;
  template<typename K, typename V, typename Compare> friend class MultiMap;
  template<typename T, typename Compare> friend class MultiSet;

  RbNodeBase* node = nullptr;
};

// The tree behind the four containers: entries E ordered by their keys KeyOf::of(entry), of type
// K, under the comparator Compare (`compare(a, b)` is a < b). It allows equal keys; the unique
// containers look before they insert.
template<typename E, typename K, typename KeyOf, typename Compare>
class RbTree
{
public:
  ContainerSize size() const { return this->count; }
  const Compare& keyCompare() const { return this->compare; }
  RbTree() { this->becomeEmpty(); }
  RbTree(const Compare& compare) : compare(compare) { this->becomeEmpty(); }

  // Delegates, so that the destructor frees the nodes copied when an entry's copy throws.
  RbTree(const RbTree<E, K, KeyOf, Compare>& other) : RbTree(other.compare) { this->copyFrom(other); }

  RbTree(RbTree<E, K, KeyOf, Compare>&& other) noexcept(isNothrowCopyConstructible<Compare>) : compare(other.compare)
  {
    this->becomeEmpty();
    this->take(other);
  }

  ~RbTree() { this->clear(); }

  // A copy taken over: an entry's copy that throws leaves this as it was.
  RbTree<E, K, KeyOf, Compare>& operator=(const RbTree<E, K, KeyOf, Compare>& other)
  {
    if (this != &other)
      *this = RbTree<E, K, KeyOf, Compare>(other);
    return *this;
  }

  RbTree<E, K, KeyOf, Compare>& operator=(RbTree<E, K, KeyOf, Compare>&& other) noexcept(isNothrowCopyAssignable<Compare>)
  {
    if (this != &other)
    {
      this->clear();
      this->compare = other.compare;
      this->take(other);
    }
    return *this;
  }

  RbIterator<E> begin() const { return RbIterator<E>(this->header.left); }
  RbIterator<E> end() const { return RbIterator<E>((RbNodeBase*)&this->header); }

  // The lookups take a key of any type when the comparator is transparent (`Less<>`), and convert
  // any other argument to K once, before the search, otherwise.

  // The first entry whose key is not less than key.
  template<typename Key>
  RbIterator<E> lowerBound(const Key& key) const
  {
    if constexpr (!isTransparent<Compare> && !isSame<RemoveCvRef<Key>, RemoveCvRef<K>>)
    {
      const K& converted = key;
      return this->lowerBound(converted);
    }
    else
    {
      RbNodeBase* result = (RbNodeBase*)&this->header;
      RbNodeBase* node = this->header.parent;
      while (node)
      {
        if (this->compare(RbTree::keyOf(node), key))
          node = node->right;
        else
        {
          result = node;
          node = node->left;
        }
      }
      return RbIterator<E>(result);
    }
  }

  // The first entry whose key is greater than key.
  template<typename Key>
  RbIterator<E> upperBound(const Key& key) const
  {
    if constexpr (!isTransparent<Compare> && !isSame<RemoveCvRef<Key>, RemoveCvRef<K>>)
    {
      const K& converted = key;
      return this->upperBound(converted);
    }
    else
    {
      RbNodeBase* result = (RbNodeBase*)&this->header;
      RbNodeBase* node = this->header.parent;
      while (node)
      {
        if (this->compare(key, RbTree::keyOf(node)))
        {
          result = node;
          node = node->left;
        }
        else
          node = node->right;
      }
      return RbIterator<E>(result);
    }
  }

  // An entry with key (the first of equivalent ones), or end().
  template<typename Key>
  RbIterator<E> find(const Key& key) const
  {
    if constexpr (!isTransparent<Compare> && !isSame<RemoveCvRef<Key>, RemoveCvRef<K>>)
    {
      const K& converted = key;
      return this->find(converted);
    }
    else
    {
      RbIterator<E> at = this->lowerBound(key);
      if (at.node == &this->header || this->compare(key, RbTree::keyOf(at.node)))
        return this->end();
      return at;
    }
  }

  template<typename Key>
  ContainerSize countOf(const Key& key) const
  {
    if constexpr (!isTransparent<Compare> && !isSame<RemoveCvRef<Key>, RemoveCvRef<K>>)
    {
      const K& converted = key;
      return this->countOf(converted);
    }
    else
    {
      ContainerSize n = 0;
      for (RbIterator<E> at = this->lowerBound(key); at.node != &this->header && !this->compare(key, RbTree::keyOf(at.node)); ++at)
        ++n;
      return n;
    }
  }

  // Adds entry after any entries with an equal key and returns where it went.
  RbIterator<E> insertEqual(E&& entry) { return this->emplaceEqual(move(entry)); }

  // The same with the entry constructed in its node from the arguments.
  template<typename... Args>
  RbIterator<E> emplaceEqual(Args&&... args)
  {
    RbNode<E>* node = this->newNode(forward<Args>(args)...);
    RbNodeBase* parent;
    bool asLeft;
    this->equalPosition(RbTree::keyOf(node), parent, asLeft);
    return this->link(node, parent, asLeft);
  }

  // A unique key's entry constructed in its node from the arguments, std::map::emplace's order:
  // built first, then linked when no entry has an equivalent key, destroyed again when one has, so
  // the entry is never copied or moved (BuildingRenderer's nodes, whose base deletes its copy).
  template<typename... Args>
  Pair<RbIterator<E>, bool> emplaceUnique(Args&&... args)
  {
    RbNode<E>* node = this->newNode(forward<Args>(args)...);
    RbIterator<E> at = this->find(RbTree::keyOf(node));
    if (at != this->end())
    {
      this->destroyNode(node);
      return Pair<RbIterator<E>, bool>(at, false);
    }
    RbNodeBase* parent;
    bool asLeft;
    this->equalPosition(RbTree::keyOf(node), parent, asLeft);
    return Pair<RbIterator<E>, bool>(this->link(node, parent, asLeft), true);
  }

  // Where insertEqual links a node with key: under parent, on its left or right.
  void equalPosition(const K& key, RbNodeBase*& parent, bool& asLeft) const
  {
    parent = (RbNodeBase*)&this->header;
    asLeft = true;
    RbNodeBase* node = this->header.parent;
    while (node)
    {
      parent = node;
      asLeft = this->compare(key, RbTree::keyOf(node));
      node = asLeft ? node->left : node->right;
    }
  }

  // Where a node with key goes when it belongs right before hint (any position, end() included):
  // false when it does not (or, for unique keys, when an equivalent key is a neighbour), and the
  // caller searches from the root instead. Inserting at a right hint is O(1) amortized.
  bool hintPosition(RbNodeBase* hint, const K& key, bool unique, RbNodeBase*& parent, bool& asLeft) const
  {
    RbNodeBase* header = (RbNodeBase*)&this->header;
    if (hint != header && (unique ? !this->compare(key, RbTree::keyOf(hint)) : this->compare(RbTree::keyOf(hint), key)))
      return false;
    if (hint != header->left)
    {
      RbNodeBase* before = rbPrevious(hint);
      if (unique ? !this->compare(RbTree::keyOf(before), key) : this->compare(key, RbTree::keyOf(before)))
        return false;
      if (!before->right)
      {
        parent = before;
        asLeft = false;
        return true;
      }
    }
    // hint is the first node (or the header of an empty tree), or its predecessor is in its left
    // subtree, which then has room on the left of hint.
    parent = hint;
    asLeft = true;
    return true;
  }

  template<typename... Args>
  RbNode<E>* newNode(Args&&... args)
  {
    if (this->count == maxContainerSize) // its count is a size (core/Sizes.kpp)
      throwLengthError("map/set too long");
    RbNode<E>* node = (RbNode<E>*)allocateBytes(sizeof(RbNode<E>));
    OwnedBlock block(node); // freed when the entry's constructor throws
    new (&node->entry) E(forward<Args>(args)...);
    block.release();
    return node;
  }

  RbIterator<E> link(RbNode<E>* node, RbNodeBase* parent, bool asLeft)
  {
    rbInsertAndRebalance(asLeft, node, parent, this->header);
    ++this->count;
    return RbIterator<E>(node);
  }

  // Takes the node at position out of the tree, entry and all.
  RbNode<E>* unlink(RbIterator<E> position)
  {
    rbEraseAndRebalance(position.node, this->header);
    --this->count;
    return (RbNode<E>*)position.node;
  }

  void swap(RbTree<E, K, KeyOf, Compare>& other) noexcept(isNothrowCopyConstructible<Compare> && isNothrowCopyAssignable<Compare>)
  {
    RbTree<E, K, KeyOf, Compare> held(move(other));
    other = move(*this);
    *this = move(held);
  }

  // Removes the entry at position; returns the position after it.
  RbIterator<E> erase(RbIterator<E> position)
  {
    RbNodeBase* next = rbNext(position.node);
    rbEraseAndRebalance(position.node, this->header);
    this->destroyNode(position.node);
    --this->count;
    return RbIterator<E>(next);
  }

  RbIterator<E> erase(RbIterator<E> first, RbIterator<E> last)
  {
    while (first != last)
      first = this->erase(first);
    return last;
  }

  void clear()
  {
    if (this->header.parent)
      this->destroySubtree(this->header.parent);
    this->becomeEmpty();
    this->count = 0;
  }

private:
  static const K& keyOf(const RbNodeBase* node) { return KeyOf::of(((const RbNode<E>*)node)->entry); }

  void becomeEmpty()
  {
    this->header.parent = nullptr;
    this->header.left = &this->header;
    this->header.right = &this->header;
    this->header.red = true;
  }

  void destroyNode(RbNodeBase* node)
  {
    ((RbNode<E>*)node)->entry.~E();
    free(node);
  }

  void destroySubtree(RbNodeBase* node)
  {
    while (node)
    {
      if (node->right)
        this->destroySubtree(node->right);
      RbNodeBase* left = node->left;
      this->destroyNode(node);
      node = left;
    }
  }

  // Copies source's subtree under parent, into link. Each node is linked once its entry is built
  // and before its children are copied, so that when an entry's copy throws, clear() reaches every
  // node built (the count and the ends are set after).
  void clone(const RbNodeBase* source, RbNodeBase* parent, RbNodeBase*& link)
  {
    RbNode<E>* node = (RbNode<E>*)allocateBytes(sizeof(RbNode<E>));
    OwnedBlock block(node);
    new (&node->entry) E(((const RbNode<E>*)source)->entry);
    block.release();
    node->red = source->red;
    node->parent = parent;
    node->left = nullptr;
    node->right = nullptr;
    link = node;
    if (source->left)
      this->clone(source->left, node, node->left);
    if (source->right)
      this->clone(source->right, node, node->right);
  }

  void copyFrom(const RbTree<E, K, KeyOf, Compare>& other)
  {
    if (!other.header.parent)
      return;
    this->clone(other.header.parent, &this->header, this->header.parent);
    this->header.left = rbMinimum(this->header.parent);
    this->header.right = rbMaximum(this->header.parent);
    this->count = other.count;
  }

  // Takes other's nodes; the root has to point at this header instead.
  void take(RbTree<E, K, KeyOf, Compare>& other)
  {
    if (!other.header.parent)
      return;
    this->header.parent = other.header.parent;
    this->header.left = other.header.left;
    this->header.right = other.header.right;
    this->header.parent->parent = &this->header;
    this->count = other.count;
    other.becomeEmpty();
    other.count = 0;
  }

  RbNodeBase header;
  ContainerSize count = 0;
  Compare compare;
};

// What extract() returns: an entry taken out of a Map or MultiMap together with its node, without
// copying or moving the entry; insert() puts it into this or another map of the same type.
// Empty when default-constructed, after being inserted, and after being moved from.
template<typename E>
void rbFreeNode(RbNode<E>* node)
{
  node->entry.~E();
  free(node);
}

template<typename K, typename V>
class MapNodeHandle
{
public:
  MapNodeHandle() {}
  MapNodeHandle(RbNode<Pair<K, V>>* node) : node(node) {}
  MapNodeHandle(MapNodeHandle<K, V>&& other) noexcept : node(other.node) { other.node = nullptr; }
  MapNodeHandle(const MapNodeHandle<K, V>& other) = delete;
  ~MapNodeHandle() { this->reset(); }

  MapNodeHandle<K, V>& operator=(MapNodeHandle<K, V>&& other) noexcept
  {
    if (this != &other)
    {
      this->reset();
      this->node = other.node;
      other.node = nullptr;
    }
    return *this;
  }

  bool empty() const { return this->node == nullptr; }
  operator bool() const { return this->node != nullptr; }
  K& key() const { return this->node->entry.first; }
  V& mapped() const { return this->node->entry.second; }

  void reset()
  {
    if (this->node)
      rbFreeNode(this->node);
    this->node = nullptr;
  }

private:
  template<typename K2, typename V2, typename Compare> friend class Map;
  template<typename K2, typename V2, typename Compare> friend class MultiMap;

  RbNode<Pair<K, V>>* node = nullptr;
};

// The same for Set and MultiSet.
template<typename T>
class SetNodeHandle
{
public:
  SetNodeHandle() {}
  SetNodeHandle(RbNode<T>* node) : node(node) {}
  SetNodeHandle(SetNodeHandle<T>&& other) noexcept : node(other.node) { other.node = nullptr; }
  SetNodeHandle(const SetNodeHandle<T>& other) = delete;
  ~SetNodeHandle() { this->reset(); }

  SetNodeHandle<T>& operator=(SetNodeHandle<T>&& other) noexcept
  {
    if (this != &other)
    {
      this->reset();
      this->node = other.node;
      other.node = nullptr;
    }
    return *this;
  }

  bool empty() const { return this->node == nullptr; }
  operator bool() const { return this->node != nullptr; }
  T& value() const { return this->node->entry; }

  void reset()
  {
    if (this->node)
      rbFreeNode(this->node);
    this->node = nullptr;
  }

private:
  template<typename T2, typename Compare> friend class Set;
  template<typename T2, typename Compare> friend class MultiSet;

  RbNode<T>* node = nullptr;
};

// What inserting a node handle into a unique-key container returns: where the key's entry is,
// whether the node went in, and the node when it did not (its key was there already).
template<typename It, typename Handle>
struct NodeInsertReturn
{
  It position;
  bool inserted = false;
  Handle node;
};

template<typename K, typename V>
struct MapKey
{
  static const K& of(const Pair<K, V>& entry) { return entry.first; }
};

template<typename T>
struct SetKey
{
  static const T& of(const T& entry) { return entry; }
};

// An ordered map with unique keys: entries are Pair<K, V> in key order, ordered by Compare.
template<typename K, typename V, typename Compare = Less<K>>
class Map
{
public:
  using iterator = RbIterator<Pair<K, V>>;
  using const_iterator = RbIterator<const Pair<K, V>>;
  using value_type = Pair<K, V>;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = Pair<K, V>&;
  using const_reference = const Pair<K, V>&;
  using pointer = Pair<K, V>*;
  using const_pointer = const Pair<K, V>*;
  using reverse_iterator = ReverseIterator<RbIterator<Pair<K, V>>>;
  using const_reverse_iterator = ReverseIterator<RbIterator<const Pair<K, V>>>;
  using key_type = K;
  using mapped_type = V;
  using key_compare = Compare;

  Map() {}
  Map(const Compare& compare) : tree(compare) {}

  // `Map<char, Kind> table = {{'+', Kind::Plus}, {'-', Kind::Minus}};`
  implicit Map(InitializerList<Pair<K, V>> items, const Compare& compare = Compare()) : tree(compare)
  {
    for (const Pair<K, V>& item : items)
      this->insert(item);
  }

  // `= {...}`: the listed entries, replacing the contents (later duplicates as in the
  // list constructor).
  Map<K, V, Compare>& operator=(InitializerList<Pair<K, V>> items)
  {
    this->clear();
    for (const Pair<K, V>& item : items)
      this->insert(item);
    return *this;
  }

  // The entries of [first, last), as insert(entry) one by one.
  template<typename It>
  Map(It first, It last, const Compare& compare = Compare()) : tree(compare) { this->insert(first, last); }

  ContainerSize size() const { return this->tree.size(); }
  bool empty() const { return this->tree.size() == 0; }
  // A const Map's positions are const_iterators: its entries are not changed through them.
  iterator begin() { return this->tree.begin(); }
  iterator end() { return this->tree.end(); }
  const_iterator begin() const { return this->tree.begin(); }
  const_iterator end() const { return this->tree.end(); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }
  const_reverse_iterator crbegin() const { return this->rbegin(); }
  const_reverse_iterator crend() const { return this->rend(); }
  Compare key_comp() const { return this->tree.keyCompare(); }

  // The lookups by K, and by any other type: with a transparent comparator that key itself is
  // compared, otherwise it is converted to K first.
  iterator find(const K& key) { return this->tree.find(key); }
  template<typename Key>
  iterator find(const Key& key) { return this->tree.find(key); }
  const_iterator find(const K& key) const { return this->tree.find(key); }
  template<typename Key>
  const_iterator find(const Key& key) const { return this->tree.find(key); }
  bool contains(const K& key) const { return this->tree.find(key) != this->tree.end(); }
  template<typename Key>
  bool contains(const Key& key) const { return this->tree.find(key) != this->tree.end(); }
  ContainerSize count(const K& key) const { return this->contains(key) ? 1 : 0; }
  template<typename Key>
  ContainerSize count(const Key& key) const { return this->tree.countOf(key); }
  iterator lowerBound(const K& key) { return this->tree.lowerBound(key); }
  template<typename Key>
  iterator lowerBound(const Key& key) { return this->tree.lowerBound(key); }
  const_iterator lowerBound(const K& key) const { return this->tree.lowerBound(key); }
  template<typename Key>
  const_iterator lowerBound(const Key& key) const { return this->tree.lowerBound(key); }
  iterator lower_bound(const K& key) { return this->tree.lowerBound(key); }
  template<typename Key>
  iterator lower_bound(const Key& key) { return this->tree.lowerBound(key); }
  const_iterator lower_bound(const K& key) const { return this->tree.lowerBound(key); }
  template<typename Key>
  const_iterator lower_bound(const Key& key) const { return this->tree.lowerBound(key); }
  iterator upperBound(const K& key) { return this->tree.upperBound(key); }
  template<typename Key>
  iterator upperBound(const Key& key) { return this->tree.upperBound(key); }
  const_iterator upperBound(const K& key) const { return this->tree.upperBound(key); }
  template<typename Key>
  const_iterator upperBound(const Key& key) const { return this->tree.upperBound(key); }
  iterator upper_bound(const K& key) { return this->tree.upperBound(key); }
  template<typename Key>
  iterator upper_bound(const Key& key) { return this->tree.upperBound(key); }
  const_iterator upper_bound(const K& key) const { return this->tree.upperBound(key); }
  template<typename Key>
  const_iterator upper_bound(const Key& key) const { return this->tree.upperBound(key); }
  Pair<iterator, iterator> equal_range(const K& key) { return Pair<iterator, iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }
  template<typename Key>
  Pair<iterator, iterator> equal_range(const Key& key) { return Pair<iterator, iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }

  Pair<const_iterator, const_iterator> equal_range(const K& key) const
  {
    return Pair<const_iterator, const_iterator>(this->tree.lowerBound(key), this->tree.upperBound(key));
  }

  template<typename Key>
  Pair<const_iterator, const_iterator> equal_range(const Key& key) const
  {
    return Pair<const_iterator, const_iterator>(this->tree.lowerBound(key), this->tree.upperBound(key));
  }

  // The value for key, inserted default-constructed when new.
  V& operator[](const K& key)
  {
    RbIterator<Pair<K, V>> at = this->tree.lowerBound(key);
    if (at != this->tree.end() && !this->tree.keyCompare()(key, at->first))
      return at->second;
    return this->tree.emplaceEqual(inPlaceSecond, key)->second;
  }

  // The value of key's entry; throws OutOfRange when there is none.
  V& at(const K& key)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at == this->tree.end())
      throwOutOfRange("Map::at: key not found");
    return at->second;
  }

  const V& at(const K& key) const
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at == this->tree.end())
      throwOutOfRange("Map::at: key not found");
    return at->second;
  }

  // std::map::insert: the entry with the key and whether it was added (an existing value is kept).
  Pair<RbIterator<Pair<K, V>>, bool> insert(const Pair<K, V>& entry)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(entry.first);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.insertEqual(Pair<K, V>(entry)), true);
  }

  Pair<RbIterator<Pair<K, V>>, bool> insert(Pair<K, V>&& entry)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(entry.first);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.insertEqual(move(entry)), true);
  }

  // std::map::emplace: the entry built from the arguments, unless its key is there already.
  template<typename... Args>
  Pair<RbIterator<Pair<K, V>>, bool> emplace(Args&&... args) { return this->tree.emplaceUnique(forward<Args>(args)...); }

  // emplace(key, value...): the key looked up first, as std's do, so an existing key builds no
  // entry; a new one is built in its node.
  template<typename KArg, typename... VArgs> requires (isSame<RemoveCvRef<KArg>, K>)
  Pair<RbIterator<Pair<K, V>>, bool> emplace(KArg&& key, VArgs&&... values)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.emplaceEqual(forward<KArg>(key), forward<VArgs>(values)...), true);
  }

  // std::map::try_emplace: builds the value from the arguments, in its node, only when the key is new.
  template<typename... Args>
  Pair<RbIterator<Pair<K, V>>, bool> try_emplace(const K& key, Args&&... args)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.emplaceEqual(inPlaceSecond, key, forward<Args>(args)...), true);
  }

  // An rvalue key is moved into the new entry, not copied (the map deserialiser's
  // `target.try_emplace(move(index), input)`). Only a K rvalue itself: a key of another type is
  // converted by the const K& overload.
  template<typename KK, typename... Args> requires (isSame<KK, K>)
  Pair<RbIterator<Pair<K, V>>, bool> try_emplace(KK&& key, Args&&... args)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at != this->tree.end())
      return Pair<RbIterator<Pair<K, V>>, bool>(at, false);
    return Pair<RbIterator<Pair<K, V>>, bool>(this->tree.emplaceEqual(inPlaceSecond, move(key), forward<Args>(args)...), true);
  }

  // With a position hint (ScriptRendering's `objectMapping.try_emplace(objectMapping.end(), id,
  // move(item))`): the hint is not needed; the entry's position, new or found.
  template<typename... Args>
  iterator try_emplace(const_iterator hint, const K& key, Args&&... args)
  {
    return this->try_emplace(key, forward<Args>(args)...).first;
  }

  template<typename KK, typename... Args> requires (isSame<KK, K>)
  iterator try_emplace(const_iterator hint, KK&& key, Args&&... args)
  {
    return this->try_emplace(move(key), forward<Args>(args)...).first;
  }

  // std::map::insert_or_assign: inserts the entry when the key is new (the value built from value,
  // forwarded, in the new node), assigns value to the existing entry's otherwise; returns the entry
  // and whether it was inserted. An rvalue key is moved into a new entry only.
  template<typename M>
  Pair<RbIterator<Pair<K, V>>, bool> insert_or_assign(const K& key, M&& value)
  {
    Pair<RbIterator<Pair<K, V>>, bool> result = this->try_emplace(key, forward<M>(value));
    if (!result.second)
      result.first->second = forward<M>(value); // (try_emplace left value alone: the key was there)
    return result;
  }

  template<typename KK, typename M> requires (isSame<KK, K>)
  Pair<RbIterator<Pair<K, V>>, bool> insert_or_assign(KK&& key, M&& value)
  {
    Pair<RbIterator<Pair<K, V>>, bool> result = this->try_emplace(move(key), forward<M>(value));
    if (!result.second)
      result.first->second = forward<M>(value);
    return result;
  }

  // With a position hint, not needed: the entry's position, new or found.
  template<typename M>
  iterator insert_or_assign(const_iterator hint, const K& key, M&& value)
  {
    return this->insert_or_assign(key, forward<M>(value)).first;
  }

  template<typename KK, typename M> requires (isSame<KK, K>)
  iterator insert_or_assign(const_iterator hint, KK&& key, M&& value)
  {
    return this->insert_or_assign(move(key), forward<M>(value)).first;
  }

  // kpp's shorthand: true when the key was new.
  bool insert(const K& key, const V& value) { return this->insert(Pair<K, V>(key, value)).second; }

  // The number of entries removed (0 or 1).
  ContainerSize erase(const K& key)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at == this->tree.end())
      return 0;
    this->tree.erase(at);
    return 1;
  }

  iterator erase(const_iterator position) { return this->tree.erase(iterator(position)); }
  iterator erase(const_iterator first, const_iterator last) { return this->tree.erase(iterator(first), iterator(last)); }
  reverse_iterator rbegin() { return reverse_iterator(this->tree.end()); }
  reverse_iterator rend() { return reverse_iterator(this->tree.begin()); }
  const_reverse_iterator rbegin() const { return const_reverse_iterator(this->tree.end()); }
  const_reverse_iterator rend() const { return const_reverse_iterator(this->tree.begin()); }
  // Inserts as insert(entry) does; hint, a position next to where the entry belongs, makes it
  // O(1) amortized when the entry goes right before hint.
  iterator insert(const_iterator hint, const Pair<K, V>& entry) { return this->insert(hint, Pair<K, V>(entry)); }

  iterator insert(const_iterator hint, Pair<K, V>&& entry)
  {
    RbNodeBase* parent;
    bool asLeft;
    if (!this->tree.hintPosition(hint.node, entry.first, true, parent, asLeft))
      return this->insert(move(entry)).first;
    return this->tree.link(this->tree.newNode(move(entry)), parent, asLeft);
  }

  template<typename... Args>
  iterator emplace_hint(const_iterator hint, Args&&... args) { return this->insert(hint, Pair<K, V>(forward<Args>(args)...)); }

  // Inserts copies of the entries of [first, last), as insert(entry) does.
  template<typename It>
  void insert(It first, It last)
  {
    for (; first != last; ++first)
      this->insert(*first);
  }

  // Inserts the listed entries, as insert(entry) does one by one (std's insert({...})).
  void insert(InitializerList<Pair<K, V>> items)
  {
    for (const Pair<K, V>& item : items)
      this->insert(item);
  }

  // Takes the entry at position out, together with its node: no copy, and pointers and references
  // to it stay valid while it is in the handle and after it is inserted somewhere.
  MapNodeHandle<K, V> extract(const_iterator position) { return MapNodeHandle<K, V>(this->tree.unlink(iterator(position))); }

  MapNodeHandle<K, V> extract(const K& key)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at == this->tree.end())
      return MapNodeHandle<K, V>();
    return MapNodeHandle<K, V>(this->tree.unlink(at));
  }

  NodeInsertReturn<RbIterator<Pair<K, V>>, MapNodeHandle<K, V>> insert(MapNodeHandle<K, V>&& handle)
  {
    NodeInsertReturn<RbIterator<Pair<K, V>>, MapNodeHandle<K, V>> result;
    if (handle.empty())
    {
      result.position = this->tree.end();
      return result;
    }
    RbIterator<Pair<K, V>> at = this->tree.find(handle.key());
    if (at != this->tree.end())
    {
      result.position = at;
      result.node = move(handle);
      return result;
    }
    RbNodeBase* parent;
    bool asLeft;
    this->tree.equalPosition(handle.key(), parent, asLeft);
    result.position = this->tree.link(handle.node, parent, asLeft);
    handle.node = nullptr;
    result.inserted = true;
    return result;
  }

  // Moves the entries of other whose keys are not here into this container, node and all (no
  // copies; pointers and references to them now refer into this one). The rest stay in other.
  template<typename OtherCompare>
  void merge(Map<K, V, OtherCompare>& other)
  {
    for (RbIterator<Pair<K, V>> it = other.tree.begin(); it != other.tree.end();)
    {
      RbIterator<Pair<K, V>> next = it;
      ++next;
      if (!this->contains(it->first))
      {
        RbNode<Pair<K, V>>* node = other.tree.unlink(it);
        RbNodeBase* parent;
        bool asLeft;
        this->tree.equalPosition(node->entry.first, parent, asLeft);
        this->tree.link(node, parent, asLeft);
      }
      it = next;
    }
  }

  void swap(Map<K, V, Compare>& other) noexcept(isNothrowCopyConstructible<Compare> && isNothrowCopyAssignable<Compare>) { this->tree.swap(other.tree); }
  void clear() { this->tree.clear(); }

private:
  RbTree<Pair<K, V>, K, MapKey<K, V>, Compare> tree;
};

// Equal with equal entries in the same order, ordered lexicographically by them (common.md). Function
// templates, as std's are: only a comparison that is written instantiates them, never every element
// type.
template<typename K, typename V, typename Compare>
bool operator==(const Map<K, V, Compare>& a, const Map<K, V, Compare>& b) { return a.size() == b.size() && equal(a.begin(), a.end(), b.begin()); }
template<typename K, typename V, typename Compare>
strong_ordering operator<=>(const Map<K, V, Compare>& a, const Map<K, V, Compare>& b) { return lexicographicalCompareThreeWay(a.begin(), a.end(), b.begin(), b.end()); }

// An ordered set of unique values, ordered by Compare.
template<typename T, typename Compare = Less<T>>
class Set
{
public:
  using iterator = RbIterator<const T>; // a set's elements are its keys: const through every position
  using const_iterator = RbIterator<const T>;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;
  using reverse_iterator = ReverseIterator<RbIterator<const T>>;
  using const_reverse_iterator = ReverseIterator<RbIterator<const T>>;
  using key_type = T;
  using key_compare = Compare;

  Set() {}
  Set(const Compare& compare) : tree(compare) {}

  implicit Set(InitializerList<T> items, const Compare& compare = Compare()) : tree(compare)
  {
    for (const T& value : items)
      this->insert(value);
  }

  // `= {...}`: the listed values, replacing the contents (later duplicates as in the
  // list constructor).
  Set<T, Compare>& operator=(InitializerList<T> items)
  {
    this->clear();
    for (const T& item : items)
      this->insert(item);
    return *this;
  }

  // The values of [first, last), as insert(value) one by one.
  template<typename It>
  Set(It first, It last, const Compare& compare = Compare()) : tree(compare) { this->insert(first, last); }

  ContainerSize size() const { return this->tree.size(); }
  bool empty() const { return this->tree.size() == 0; }
  const_iterator begin() const { return this->tree.begin(); }
  const_iterator end() const { return this->tree.end(); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }
  auto crbegin() const { return this->rbegin(); }
  auto crend() const { return this->rend(); }
  Compare key_comp() const { return this->tree.keyCompare(); }

  // The lookups by T, and by any other type: with a transparent comparator that key itself is
  // compared, otherwise it is converted to T first.
  const_iterator find(const T& value) const { return this->tree.find(value); }
  template<typename Key>
  const_iterator find(const Key& key) const { return this->tree.find(key); }
  bool contains(const T& value) const { return this->tree.find(value) != this->tree.end(); }
  template<typename Key>
  bool contains(const Key& key) const { return this->tree.find(key) != this->tree.end(); }
  ContainerSize count(const T& value) const { return this->contains(value) ? 1 : 0; }
  template<typename Key>
  ContainerSize count(const Key& key) const { return this->tree.countOf(key); }
  const_iterator lowerBound(const T& value) const { return this->tree.lowerBound(value); }
  template<typename Key>
  const_iterator lowerBound(const Key& key) const { return this->tree.lowerBound(key); }
  const_iterator lower_bound(const T& value) const { return this->tree.lowerBound(value); }
  template<typename Key>
  const_iterator lower_bound(const Key& key) const { return this->tree.lowerBound(key); }
  const_iterator upperBound(const T& value) const { return this->tree.upperBound(value); }
  template<typename Key>
  const_iterator upperBound(const Key& key) const { return this->tree.upperBound(key); }
  const_iterator upper_bound(const T& value) const { return this->tree.upperBound(value); }
  template<typename Key>
  const_iterator upper_bound(const Key& key) const { return this->tree.upperBound(key); }
  Pair<const_iterator, const_iterator> equal_range(const T& value) const { return Pair<const_iterator, const_iterator>(this->tree.lowerBound(value), this->tree.upperBound(value)); }
  template<typename Key>
  Pair<const_iterator, const_iterator> equal_range(const Key& key) const { return Pair<const_iterator, const_iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }

  // std::set::insert: the entry with the value and whether it was added.
  Pair<iterator, bool> insert(const T& value)
  {
    RbIterator<T> at = this->tree.find(value);
    if (at != this->tree.end())
      return Pair<RbIterator<T>, bool>(at, false);
    return Pair<RbIterator<T>, bool>(this->tree.insertEqual(T(value)), true);
  }

  Pair<iterator, bool> insert(T&& value)
  {
    RbIterator<T> at = this->tree.find(value);
    if (at != this->tree.end())
      return Pair<RbIterator<T>, bool>(at, false);
    return Pair<RbIterator<T>, bool>(this->tree.insertEqual(move(value)), true);
  }

  template<typename... Args>
  Pair<iterator, bool> emplace(Args&&... args) { return this->tree.emplaceUnique(forward<Args>(args)...); }

  // The number of values removed (0 or 1).
  ContainerSize erase(const T& value)
  {
    RbIterator<T> at = this->tree.find(value);
    if (at == this->tree.end())
      return 0;
    this->tree.erase(at);
    return 1;
  }

  iterator erase(const_iterator position) { return this->tree.erase(RbIterator<T>(position)); }
  iterator erase(const_iterator first, const_iterator last) { return this->tree.erase(RbIterator<T>(first), RbIterator<T>(last)); }
  const_reverse_iterator rbegin() const { return const_reverse_iterator(this->tree.end()); }
  const_reverse_iterator rend() const { return const_reverse_iterator(this->tree.begin()); }
  // Inserts as insert(entry) does; hint, a position next to where the entry belongs, makes it
  // O(1) amortized when the entry goes right before hint.
  iterator insert(const_iterator hint, const T& entry) { return this->insert(hint, T(entry)); }

  iterator insert(const_iterator hint, T&& entry)
  {
    RbNodeBase* parent;
    bool asLeft;
    if (!this->tree.hintPosition(hint.node, entry, true, parent, asLeft))
      return this->insert(move(entry)).first;
    return this->tree.link(this->tree.newNode(move(entry)), parent, asLeft);
  }

  template<typename... Args>
  iterator emplace_hint(const_iterator hint, Args&&... args) { return this->insert(hint, T(forward<Args>(args)...)); }

  // Inserts copies of the entries of [first, last), as insert(entry) does.
  template<typename It>
  void insert(It first, It last)
  {
    for (; first != last; ++first)
      this->insert(*first);
  }

  // Inserts the listed entries, as insert(entry) does one by one (std's insert({...})).
  void insert(InitializerList<T> items)
  {
    for (const T& item : items)
      this->insert(item);
  }

  // Takes the entry at position out, together with its node: no copy, and pointers and references
  // to it stay valid while it is in the handle and after it is inserted somewhere.
  SetNodeHandle<T> extract(const_iterator position) { return SetNodeHandle<T>(this->tree.unlink(RbIterator<T>(position))); }

  SetNodeHandle<T> extract(const T& key)
  {
    RbIterator<T> at = this->tree.find(key);
    if (at == this->tree.end())
      return SetNodeHandle<T>();
    return SetNodeHandle<T>(this->tree.unlink(at));
  }

  NodeInsertReturn<iterator, SetNodeHandle<T>> insert(SetNodeHandle<T>&& handle)
  {
    NodeInsertReturn<iterator, SetNodeHandle<T>> result;
    if (handle.empty())
    {
      result.position = this->tree.end();
      return result;
    }
    RbIterator<T> at = this->tree.find(handle.value());
    if (at != this->tree.end())
    {
      result.position = at;
      result.node = move(handle);
      return result;
    }
    RbNodeBase* parent;
    bool asLeft;
    this->tree.equalPosition(handle.value(), parent, asLeft);
    result.position = this->tree.link(handle.node, parent, asLeft);
    handle.node = nullptr;
    result.inserted = true;
    return result;
  }

  // Moves the entries of other whose keys are not here into this container, node and all (no
  // copies; pointers and references to them now refer into this one). The rest stay in other.
  template<typename OtherCompare>
  void merge(Set<T, OtherCompare>& other)
  {
    for (RbIterator<T> it = other.tree.begin(); it != other.tree.end();)
    {
      RbIterator<T> next = it;
      ++next;
      if (!this->contains(*it))
      {
        RbNode<T>* node = other.tree.unlink(it);
        RbNodeBase* parent;
        bool asLeft;
        this->tree.equalPosition(node->entry, parent, asLeft);
        this->tree.link(node, parent, asLeft);
      }
      it = next;
    }
  }

  void swap(Set<T, Compare>& other) noexcept(isNothrowCopyConstructible<Compare> && isNothrowCopyAssignable<Compare>) { this->tree.swap(other.tree); }
  void clear() { this->tree.clear(); }

private:
  RbTree<T, T, SetKey<T>, Compare> tree;
};

// Equal with equal entries in the same order, ordered lexicographically by them (common.md). Function
// templates, as std's are: only a comparison that is written instantiates them, never every element
// type.
template<typename T, typename Compare>
bool operator==(const Set<T, Compare>& a, const Set<T, Compare>& b) { return a.size() == b.size() && equal(a.begin(), a.end(), b.begin()); }
template<typename T, typename Compare>
strong_ordering operator<=>(const Set<T, Compare>& a, const Set<T, Compare>& b) { return lexicographicalCompareThreeWay(a.begin(), a.end(), b.begin(), b.end()); }

// An ordered map that allows equivalent keys, kept in insertion order among themselves.
template<typename K, typename V, typename Compare = Less<K>>
class MultiMap
{
public:
  using iterator = RbIterator<Pair<K, V>>;
  using const_iterator = RbIterator<const Pair<K, V>>;
  using value_type = Pair<K, V>;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = Pair<K, V>&;
  using const_reference = const Pair<K, V>&;
  using pointer = Pair<K, V>*;
  using const_pointer = const Pair<K, V>*;
  using reverse_iterator = ReverseIterator<RbIterator<Pair<K, V>>>;
  using const_reverse_iterator = ReverseIterator<RbIterator<const Pair<K, V>>>;
  using key_type = K;
  using mapped_type = V;
  using key_compare = Compare;

  MultiMap() {}
  MultiMap(const Compare& compare) : tree(compare) {}

  implicit MultiMap(InitializerList<Pair<K, V>> items, const Compare& compare = Compare()) : tree(compare)
  {
    for (const Pair<K, V>& item : items)
      this->insert(item);
  }

  // `= {...}`: the listed entries, replacing the contents.
  MultiMap<K, V, Compare>& operator=(InitializerList<Pair<K, V>> items)
  {
    this->clear();
    for (const Pair<K, V>& item : items)
      this->insert(item);
    return *this;
  }

  template<typename It>
  MultiMap(It first, It last, const Compare& compare = Compare()) : tree(compare) { this->insert(first, last); }

  ContainerSize size() const { return this->tree.size(); }
  bool empty() const { return this->tree.size() == 0; }
  iterator begin() { return this->tree.begin(); }
  const_iterator begin() const { return this->tree.begin(); }
  iterator end() { return this->tree.end(); }
  const_iterator end() const { return this->tree.end(); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }
  auto crbegin() const { return this->rbegin(); }
  auto crend() const { return this->rend(); }
  Compare key_comp() const { return this->tree.keyCompare(); }

  // The lookups by K, and by any other type as in Map.
  iterator find(const K& key) { return this->tree.find(key); }
  const_iterator find(const K& key) const { return this->tree.find(key); }
  template<typename Key>
  iterator find(const Key& key) { return this->tree.find(key); }
  template<typename Key>
  const_iterator find(const Key& key) const { return this->tree.find(key); }
  bool contains(const K& key) const { return this->tree.find(key) != this->tree.end(); }
  template<typename Key>
  bool contains(const Key& key) const { return this->tree.find(key) != this->tree.end(); }
  ContainerSize count(const K& key) const { return this->tree.countOf(key); }
  template<typename Key>
  ContainerSize count(const Key& key) const { return this->tree.countOf(key); }
  iterator lowerBound(const K& key) { return this->tree.lowerBound(key); }
  const_iterator lowerBound(const K& key) const { return this->tree.lowerBound(key); }
  template<typename Key>
  iterator lowerBound(const Key& key) { return this->tree.lowerBound(key); }
  template<typename Key>
  const_iterator lowerBound(const Key& key) const { return this->tree.lowerBound(key); }
  iterator lower_bound(const K& key) { return this->tree.lowerBound(key); }
  const_iterator lower_bound(const K& key) const { return this->tree.lowerBound(key); }
  template<typename Key>
  iterator lower_bound(const Key& key) { return this->tree.lowerBound(key); }
  template<typename Key>
  const_iterator lower_bound(const Key& key) const { return this->tree.lowerBound(key); }
  iterator upperBound(const K& key) { return this->tree.upperBound(key); }
  const_iterator upperBound(const K& key) const { return this->tree.upperBound(key); }
  template<typename Key>
  iterator upperBound(const Key& key) { return this->tree.upperBound(key); }
  template<typename Key>
  const_iterator upperBound(const Key& key) const { return this->tree.upperBound(key); }
  iterator upper_bound(const K& key) { return this->tree.upperBound(key); }
  const_iterator upper_bound(const K& key) const { return this->tree.upperBound(key); }
  template<typename Key>
  iterator upper_bound(const Key& key) { return this->tree.upperBound(key); }
  template<typename Key>
  const_iterator upper_bound(const Key& key) const { return this->tree.upperBound(key); }
  Pair<iterator, iterator> equal_range(const K& key) { return Pair<iterator, iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }
  Pair<const_iterator, const_iterator> equal_range(const K& key) const { return Pair<const_iterator, const_iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }
  template<typename Key>
  Pair<iterator, iterator> equal_range(const Key& key) { return Pair<iterator, iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }
  template<typename Key>
  Pair<const_iterator, const_iterator> equal_range(const Key& key) const { return Pair<const_iterator, const_iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }

  RbIterator<Pair<K, V>> insert(const Pair<K, V>& entry) { return this->tree.insertEqual(Pair<K, V>(entry)); }
  RbIterator<Pair<K, V>> insert(Pair<K, V>&& entry) { return this->tree.insertEqual(move(entry)); }
  template<typename... Args>
  RbIterator<Pair<K, V>> emplace(Args&&... args) { return this->tree.emplaceEqual(forward<Args>(args)...); }
  RbIterator<Pair<K, V>> insert(const K& key, const V& value) { return this->tree.insertEqual(Pair<K, V>(key, value)); }

  // Removes every entry with key; returns how many.
  ContainerSize erase(const K& key)
  {
    RbIterator<Pair<K, V>> first = this->tree.lowerBound(key);
    RbIterator<Pair<K, V>> last = this->tree.upperBound(key);
    ContainerSize removed = 0;
    while (first != last)
    {
      first = this->tree.erase(first);
      ++removed;
    }
    return removed;
  }

  iterator erase(const_iterator position) { return this->tree.erase(iterator(position)); }
  iterator erase(const_iterator first, const_iterator last) { return this->tree.erase(iterator(first), iterator(last)); }
  reverse_iterator rbegin() { return reverse_iterator(this->tree.end()); }
  reverse_iterator rend() { return reverse_iterator(this->tree.begin()); }
  const_reverse_iterator rbegin() const { return const_reverse_iterator(this->tree.end()); }
  const_reverse_iterator rend() const { return const_reverse_iterator(this->tree.begin()); }
  // Inserts as insert(entry) does; hint, a position next to where the entry belongs, makes it
  // O(1) amortized when the entry goes right before hint.
  iterator insert(const_iterator hint, const Pair<K, V>& entry) { return this->insert(hint, Pair<K, V>(entry)); }

  iterator insert(const_iterator hint, Pair<K, V>&& entry)
  {
    RbNodeBase* parent;
    bool asLeft;
    if (!this->tree.hintPosition(hint.node, entry.first, false, parent, asLeft))
      return this->insert(move(entry));
    return this->tree.link(this->tree.newNode(move(entry)), parent, asLeft);
  }

  template<typename... Args>
  iterator emplace_hint(const_iterator hint, Args&&... args) { return this->insert(hint, Pair<K, V>(forward<Args>(args)...)); }

  // Inserts copies of the entries of [first, last), as insert(entry) does.
  template<typename It>
  void insert(It first, It last)
  {
    for (; first != last; ++first)
      this->insert(*first);
  }

  // Inserts the listed entries, as insert(entry) does one by one (std's insert({...})).
  void insert(InitializerList<Pair<K, V>> items)
  {
    for (const Pair<K, V>& item : items)
      this->insert(item);
  }

  // Takes the entry at position out, together with its node: no copy, and pointers and references
  // to it stay valid while it is in the handle and after it is inserted somewhere.
  MapNodeHandle<K, V> extract(const_iterator position) { return MapNodeHandle<K, V>(this->tree.unlink(iterator(position))); }

  MapNodeHandle<K, V> extract(const K& key)
  {
    RbIterator<Pair<K, V>> at = this->tree.find(key);
    if (at == this->tree.end())
      return MapNodeHandle<K, V>();
    return MapNodeHandle<K, V>(this->tree.unlink(at));
  }

  // Inserts the handle's node (after equivalent keys); returns its position, or end() for an
  // empty handle.
  RbIterator<Pair<K, V>> insert(MapNodeHandle<K, V>&& handle)
  {
    if (handle.empty())
      return this->tree.end();
    RbNodeBase* parent;
    bool asLeft;
    this->tree.equalPosition(handle.key(), parent, asLeft);
    RbIterator<Pair<K, V>> at = this->tree.link(handle.node, parent, asLeft);
    handle.node = nullptr;
    return at;
  }

  // Moves all entries of other into this container, node and all.
  template<typename OtherCompare>
  void merge(MultiMap<K, V, OtherCompare>& other)
  {
    while (!other.empty())
    {
      RbNode<Pair<K, V>>* node = other.tree.unlink(other.tree.begin());
      RbNodeBase* parent;
      bool asLeft;
      this->tree.equalPosition(node->entry.first, parent, asLeft);
      this->tree.link(node, parent, asLeft);
    }
  }

  void swap(MultiMap<K, V, Compare>& other) noexcept(isNothrowCopyConstructible<Compare> && isNothrowCopyAssignable<Compare>) { this->tree.swap(other.tree); }
  void clear() { this->tree.clear(); }

private:
  RbTree<Pair<K, V>, K, MapKey<K, V>, Compare> tree;
};

// Equal with equal entries in the same order, ordered lexicographically by them (common.md). Function
// templates, as std's are: only a comparison that is written instantiates them, never every element
// type.
template<typename K, typename V, typename Compare>
bool operator==(const MultiMap<K, V, Compare>& a, const MultiMap<K, V, Compare>& b) { return a.size() == b.size() && equal(a.begin(), a.end(), b.begin()); }
template<typename K, typename V, typename Compare>
strong_ordering operator<=>(const MultiMap<K, V, Compare>& a, const MultiMap<K, V, Compare>& b) { return lexicographicalCompareThreeWay(a.begin(), a.end(), b.begin(), b.end()); }

// An ordered set that allows equivalent values, kept in insertion order among themselves.
template<typename T, typename Compare = Less<T>>
class MultiSet
{
public:
  using iterator = RbIterator<const T>; // a set's elements are its keys: const through every position
  using const_iterator = RbIterator<const T>;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;
  using reverse_iterator = ReverseIterator<RbIterator<const T>>;
  using const_reverse_iterator = ReverseIterator<RbIterator<const T>>;
  using key_type = T;
  using key_compare = Compare;

  MultiSet() {}
  MultiSet(const Compare& compare) : tree(compare) {}

  implicit MultiSet(InitializerList<T> items, const Compare& compare = Compare()) : tree(compare)
  {
    for (const T& value : items)
      this->insert(value);
  }

  // `= {...}`: the listed values, replacing the contents.
  MultiSet<T, Compare>& operator=(InitializerList<T> items)
  {
    this->clear();
    for (const T& item : items)
      this->insert(item);
    return *this;
  }

  template<typename It>
  MultiSet(It first, It last, const Compare& compare = Compare()) : tree(compare) { this->insert(first, last); }

  ContainerSize size() const { return this->tree.size(); }
  bool empty() const { return this->tree.size() == 0; }
  const_iterator begin() const { return this->tree.begin(); }
  const_iterator end() const { return this->tree.end(); }
  const_iterator cbegin() const { return this->begin(); }
  const_iterator cend() const { return this->end(); }
  auto crbegin() const { return this->rbegin(); }
  auto crend() const { return this->rend(); }
  Compare key_comp() const { return this->tree.keyCompare(); }

  // The lookups by T, and by any other type as in Set.
  const_iterator find(const T& value) const { return this->tree.find(value); }
  template<typename Key>
  const_iterator find(const Key& key) const { return this->tree.find(key); }
  bool contains(const T& value) const { return this->tree.find(value) != this->tree.end(); }
  template<typename Key>
  bool contains(const Key& key) const { return this->tree.find(key) != this->tree.end(); }
  ContainerSize count(const T& value) const { return this->tree.countOf(value); }
  template<typename Key>
  ContainerSize count(const Key& key) const { return this->tree.countOf(key); }
  const_iterator lowerBound(const T& value) const { return this->tree.lowerBound(value); }
  template<typename Key>
  const_iterator lowerBound(const Key& key) const { return this->tree.lowerBound(key); }
  const_iterator lower_bound(const T& value) const { return this->tree.lowerBound(value); }
  template<typename Key>
  const_iterator lower_bound(const Key& key) const { return this->tree.lowerBound(key); }
  const_iterator upperBound(const T& value) const { return this->tree.upperBound(value); }
  template<typename Key>
  const_iterator upperBound(const Key& key) const { return this->tree.upperBound(key); }
  const_iterator upper_bound(const T& value) const { return this->tree.upperBound(value); }
  template<typename Key>
  const_iterator upper_bound(const Key& key) const { return this->tree.upperBound(key); }
  Pair<const_iterator, const_iterator> equal_range(const T& value) const { return Pair<const_iterator, const_iterator>(this->tree.lowerBound(value), this->tree.upperBound(value)); }
  template<typename Key>
  Pair<const_iterator, const_iterator> equal_range(const Key& key) const { return Pair<const_iterator, const_iterator>(this->tree.lowerBound(key), this->tree.upperBound(key)); }

  iterator insert(const T& value) { return this->tree.insertEqual(T(value)); }
  iterator insert(T&& value) { return this->tree.insertEqual(move(value)); }
  template<typename... Args>
  iterator emplace(Args&&... args) { return this->tree.emplaceEqual(forward<Args>(args)...); }

  // Removes every value equal to value; returns how many.
  ContainerSize erase(const T& value)
  {
    RbIterator<T> first = this->tree.lowerBound(value);
    RbIterator<T> last = this->tree.upperBound(value);
    ContainerSize removed = 0;
    while (first != last)
    {
      first = this->tree.erase(first);
      ++removed;
    }
    return removed;
  }

  iterator erase(const_iterator position) { return this->tree.erase(RbIterator<T>(position)); }
  iterator erase(const_iterator first, const_iterator last) { return this->tree.erase(RbIterator<T>(first), RbIterator<T>(last)); }
  const_reverse_iterator rbegin() const { return const_reverse_iterator(this->tree.end()); }
  const_reverse_iterator rend() const { return const_reverse_iterator(this->tree.begin()); }
  // Inserts as insert(entry) does; hint, a position next to where the entry belongs, makes it
  // O(1) amortized when the entry goes right before hint.
  iterator insert(const_iterator hint, const T& entry) { return this->insert(hint, T(entry)); }

  iterator insert(const_iterator hint, T&& entry)
  {
    RbNodeBase* parent;
    bool asLeft;
    if (!this->tree.hintPosition(hint.node, entry, false, parent, asLeft))
      return this->insert(move(entry));
    return this->tree.link(this->tree.newNode(move(entry)), parent, asLeft);
  }

  template<typename... Args>
  iterator emplace_hint(const_iterator hint, Args&&... args) { return this->insert(hint, T(forward<Args>(args)...)); }

  // Inserts copies of the entries of [first, last), as insert(entry) does.
  template<typename It>
  void insert(It first, It last)
  {
    for (; first != last; ++first)
      this->insert(*first);
  }

  // Inserts the listed entries, as insert(entry) does one by one (std's insert({...})).
  void insert(InitializerList<T> items)
  {
    for (const T& item : items)
      this->insert(item);
  }

  // Takes the entry at position out, together with its node: no copy, and pointers and references
  // to it stay valid while it is in the handle and after it is inserted somewhere.
  SetNodeHandle<T> extract(const_iterator position) { return SetNodeHandle<T>(this->tree.unlink(RbIterator<T>(position))); }

  SetNodeHandle<T> extract(const T& key)
  {
    RbIterator<T> at = this->tree.find(key);
    if (at == this->tree.end())
      return SetNodeHandle<T>();
    return SetNodeHandle<T>(this->tree.unlink(at));
  }

  // Inserts the handle's node (after equivalent keys); returns its position, or end() for an
  // empty handle.
  iterator insert(SetNodeHandle<T>&& handle)
  {
    if (handle.empty())
      return this->tree.end();
    RbNodeBase* parent;
    bool asLeft;
    this->tree.equalPosition(handle.value(), parent, asLeft);
    RbIterator<T> at = this->tree.link(handle.node, parent, asLeft);
    handle.node = nullptr;
    return at;
  }

  // Moves all entries of other into this container, node and all.
  template<typename OtherCompare>
  void merge(MultiSet<T, OtherCompare>& other)
  {
    while (!other.empty())
    {
      RbNode<T>* node = other.tree.unlink(other.tree.begin());
      RbNodeBase* parent;
      bool asLeft;
      this->tree.equalPosition(node->entry, parent, asLeft);
      this->tree.link(node, parent, asLeft);
    }
  }

  void swap(MultiSet<T, Compare>& other) noexcept(isNothrowCopyConstructible<Compare> && isNothrowCopyAssignable<Compare>) { this->tree.swap(other.tree); }
  void clear() { this->tree.clear(); }

private:
  RbTree<T, T, SetKey<T>, Compare> tree;
};

// Equal with equal entries in the same order, ordered lexicographically by them (common.md). Function
// templates, as std's are: only a comparison that is written instantiates them, never every element
// type.
template<typename T, typename Compare>
bool operator==(const MultiSet<T, Compare>& a, const MultiSet<T, Compare>& b) { return a.size() == b.size() && equal(a.begin(), a.end(), b.begin()); }
template<typename T, typename Compare>
strong_ordering operator<=>(const MultiSet<T, Compare>& a, const MultiSet<T, Compare>& b) { return lexicographicalCompareThreeWay(a.begin(), a.end(), b.begin(), b.end()); }
