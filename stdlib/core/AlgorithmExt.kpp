// Extended algorithms: the less common ones that std::adjacent_find, std::copy_backward, etc.
// convert to.

template<typename T>
T* adjacentFind(T* first, T* last)
{
  if (first == last)
    return last;
  T* next = first + 1;
  while (next != last)
  {
    if (*first == *next)
      return first;
    first = next;
    ++next;
  }
  return last;
}

template<typename T, typename F>
T* adjacentFind(T* first, T* last, F predicate)
{
  if (first == last)
    return last;
  T* next = first + 1;
  while (next != last)
  {
    if (predicate(*first, *next))
      return first;
    first = next;
    ++next;
  }
  return last;
}

template<typename T>
T* copyBackward(const T* first, const T* last, T* dLast)
{
  while (first != last)
  {
    --last;
    --dLast;
    *dLast = *last;
  }
  return dLast;
}

template<typename T>
T* copyN(const T* first, int count, T* result)
{
  for (int i = 0; i < count; ++i)
  {
    *result = *first;
    ++first;
    ++result;
  }
  return result;
}

template<typename T>
T* copy(const T* first, const T* last, T* result)
{
  while (first != last)
  {
    *result = *first;
    ++first;
    ++result;
  }
  return result;
}

template<typename T, typename V>
bool equal(const T* first1, const T* last1, const V* first2)
{
  while (first1 != last1)
  {
    if (!(*first1 == *first2))
      return false;
    ++first1;
    ++first2;
  }
  return true;
}

template<typename T, typename V>
void fillN(T* first, int count, const V& value)
{
  for (int i = 0; i < count; ++i)
  {
    *first = value;
    ++first;
  }
}

template<typename T, typename F>
void generateN(T* first, int count, F generator)
{
  for (int i = 0; i < count; ++i)
  {
    *first = generator();
    ++first;
  }
}

template<typename T>
bool isSorted(const T* first, const T* last)
{
  if (first == last)
    return true;
  const T* next = first + 1;
  while (next != last)
  {
    if (*next < *first)
      return false;
    first = next;
    ++next;
  }
  return true;
}

template<typename T, typename F>
bool isSorted(const T* first, const T* last, F less)
{
  if (first == last)
    return true;
  const T* next = first + 1;
  while (next != last)
  {
    if (less(*next, *first))
      return false;
    first = next;
    ++next;
  }
  return true;
}

template<typename T>
void iterSwap(T* a, T* b) { swap(*a, *b); }

template<typename T, typename U>
bool lexicographicalCompare(const T* first1, const T* last1, const U* first2, const U* last2)
{
  while (first1 != last1 && first2 != last2)
  {
    if (*first1 < *first2)
      return true;
    if (*first2 < *first1)
      return false;
    ++first1;
    ++first2;
  }
  return first1 == last1 && first2 != last2;
}

template<typename T, typename U>
T* merge(const T* first1, const T* last1, const U* first2, const U* last2, T* result)
{
  while (first1 != last1 && first2 != last2)
  {
    if (*first2 < *first1)
    {
      *result = *first2;
      ++first2;
    }
    else
    {
      *result = *first1;
      ++first1;
    }
    ++result;
  }
  while (first1 != last1)
  {
    *result = *first1;
    ++first1;
    ++result;
  }
  while (first2 != last2)
  {
    *result = *first2;
    ++first2;
    ++result;
  }
  return result;
}

template<typename T>
T* moveBackward(T* first, T* last, T* dLast)
{
  while (first != last)
  {
    --last;
    --dLast;
    *dLast = move(*last);
  }
  return dLast;
}

template<typename T>
T* next(T* it, int n = 1) { return it + n; }

template<typename T>
T* prev(T* it, int n = 1) { return it - n; }

template<typename T>
bool nextPermutation(T* first, T* last)
{
  if (first == last || first + 1 == last)
    return false;
  T* i = last - 1;
  while (true)
  {
    T* ii = i;
    --i;
    if (*i < *ii)
    {
      T* j = last;
      while (!(*i < *--j))
        ;
      swap(*i, *j);
      reverse(ii, last);
      return true;
    }
    if (i == first)
    {
      reverse(first, last);
      return false;
    }
  }
}

// Puts into *nth the element a sort would put there, with nothing greater before it and nothing
// less after it. Introselect: quicksort's partitioning (Algorithm.kpp) into the side holding nth
// only, O(n) on average; heapsort of what is left past 2 log n rounds bounds the worst case.
template<typename T, typename F>
void nthElement(T* first, T* nth, T* last, F less)
{
  if (nth == last)
    return;
  int depthLimit = 0;
  for (long long k = last - first; k > 1; k >>= 1)
    depthLimit += 2;
  while (last - first > 16)
  {
    if (depthLimit-- == 0)
    {
      heapSort(first, last, less);
      return;
    }
    moveMedianToFirst(first, first + 1, first + (last - first) / 2, last - 1, less);
    T* cut = partitionAroundFirst(first, last, less);
    if (cut <= nth)
      first = cut;
    else
      last = cut;
  }
  insertionSort(first, last, less);
}

template<typename T>
void nthElement(T* first, T* nth, T* last)
{
  nthElement(first, nth, last, [](const T& a, const T& b) { return a < b; });
}

template<typename T>
T* rotate(T* first, T* middle, T* last)
{
  if (first == middle)
    return last;
  if (middle == last)
    return first;
  reverse(first, middle);
  reverse(middle, last);
  reverse(first, last);
  return first + (last - middle);
}

template<typename T>
T* setDifference(const T* first1, const T* last1, const T* first2, const T* last2, T* result)
{
  while (first1 != last1 && first2 != last2)
  {
    if (*first1 < *first2)
    {
      *result = *first1;
      ++result;
      ++first1;
    }
    else if (*first2 < *first1)
      ++first2;
    else
    {
      ++first1;
      ++first2;
    }
  }
  while (first1 != last1)
  {
    *result = *first1;
    ++result;
    ++first1;
  }
  return result;
}

template<typename T>
T* setIntersection(const T* first1, const T* last1, const T* first2, const T* last2, T* result)
{
  while (first1 != last1 && first2 != last2)
  {
    if (*first1 < *first2)
      ++first1;
    else if (*first2 < *first1)
      ++first2;
    else
    {
      *result = *first1;
      ++result;
      ++first1;
      ++first2;
    }
  }
  return result;
}

// Memory construction/destruction for uninitialized storage.
template<typename T>
void destroy(T* first, T* last)
{
  for (; first != last; ++first)
    first->~T();
}

template<typename T>
void uninitializedDefaultConstruct(T* first, T* last)
{
  for (; first != last; ++first)
    new (first) T();
}

template<typename T>
void uninitializedMove(T* first, T* last, T* dest)
{
  for (; first != last; ++first, ++dest)
    new (dest) T(move(*first));
}

template<typename T>
void uninitializedValueConstruct(T* first, T* last)
{
  for (; first != last; ++first)
    new (first) T();
}

template<typename T>
void uninitializedCopy(const T* first, const T* last, T* dest)
{
  for (; first != last; ++first, ++dest)
    new (dest) T(*first);
}

template<typename T>
ReverseIterator<T> makeReverseIterator(T* it) { return ReverseIterator<T>(it); }
