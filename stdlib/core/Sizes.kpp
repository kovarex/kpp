// Container sizes (docs/stdlib-conformance.md, "Sizes are unsigned"). Every size, count, capacity,
// length, index and position the library's containers and strings take or return is a
// ContainerSize: u64, the one width, so that there is one String and one Vector (design.md,
// "Container sizes are u64").
//
// The largest value is npos, "not found" or "to the end", as std's npos is size_t's largest; the
// most a container holds is one less, maxContainerSize. A size past it is never a silent wrap:
// every growth path goes through these, which throw LengthError past maxContainerSize, as std
// throws length_error past max_size(), with MSVC's message ("vector too long"); and a block malloc
// cannot give throws BadAlloc, as std's operator new does.
using ContainerSize = u64;

// The largest element count, or byte length, a container holds.
const ContainerSize maxContainerSize = ContainerSize(-1) - 1;

[[noreturn]] [[noinline]] void throwLengthError(const char* what) { throw LengthError(String(what)); }
[[noreturn]] [[noinline]] void throwBadAlloc() { throw BadAlloc(); }

// count as a container size: a count from outside the container (a strlen, a pointer range, a
// distance), of any integer type. LengthError when it is negative or past maxContainerSize, as
// std's length_error for a negative count converted to a size_t past max_size().
template<typename N>
ContainerSize checkedSize(N count, const char* what)
{
  if constexpr (isSigned<N>)
  {
    if (count < 0)
      throwLengthError(what);
  }
  if ((unsigned long long)count > maxContainerSize)
    throwLengthError(what);
  return (ContainerSize)count;
}

// a + b as a container size, a being one: a length plus what is added to it. LengthError past
// maxContainerSize (checked without forming the sum, which could wrap).
ContainerSize sizeSum(ContainerSize a, unsigned long long b, const char* what)
{
  if (a > maxContainerSize || b > (unsigned long long)(maxContainerSize - a))
    throwLengthError(what);
  return a + (ContainerSize)b;
}

// The capacity after growing one of capacity to hold needed: doubled, at least needed and minimum,
// at most maxContainerSize (instead of a doubling past the size's range); LengthError when needed
// is past maxContainerSize.
ContainerSize grownCapacity(ContainerSize capacity, unsigned long long needed, ContainerSize minimum, const char* what = "container too long")
{
  if (needed > maxContainerSize)
    throwLengthError(what);
  ContainerSize doubled = capacity > maxContainerSize / 2 ? maxContainerSize : capacity * 2;
  ContainerSize grown = doubled < minimum ? minimum : doubled;
  return grown < needed ? (ContainerSize)needed : grown;
}

// malloc of bytes, BadAlloc when it fails (instead of a null pointer the caller writes through).
void* allocateBytes(size_t bytes)
{
  void* block = malloc(bytes == 0 ? 1 : bytes);
  if (!block)
    throwBadAlloc();
  return block;
}

// An uninitialized block for count elements of T, BadAlloc when malloc fails or when count * sizeof(T)
// does not fit in a size_t (a u64 size of large elements).
template<typename T>
T* allocateArray(unsigned long long count)
{
  if (count != 0 && count > ~(size_t)0 / sizeof(T))
    throwBadAlloc();
  return (T*)allocateBytes((size_t)count * sizeof(T));
}
