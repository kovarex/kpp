// Iterator tags and adapters: what std::input_iterator_tag, std::back_inserter, etc. convert to.

struct InputIteratorTag {};
struct OutputIteratorTag {};
struct ForwardIteratorTag : InputIteratorTag {};
struct BidirectionalIteratorTag : ForwardIteratorTag {};
struct RandomAccessIteratorTag : BidirectionalIteratorTag {};

// What an iterator type yields (std::iterator_traits): a pointer's from the pointer, an iterator
// class's from its value_type, difference_type and the rest.
template<typename It>
struct IteratorTraits
{
  using value_type = typename It::value_type;
  using difference_type = typename It::difference_type;
  using pointer = typename It::pointer;
  using reference = typename It::reference;
  using iterator_category = typename It::iterator_category;
};
template<typename T>
struct IteratorTraits<T*>
{
  using value_type = RemoveConst<T>;
  using difference_type = ptrdiff_t;
  using pointer = T*;
  using reference = T&;
  using iterator_category = RandomAccessIteratorTag;
};

// MoveIterator<It> (std::move_iterator): an iterator of type It whose dereference moves the
// element out instead of copying it.
template<typename It>
struct MoveIterator
{
  using value_type = typename IteratorTraits<It>::value_type;
  using difference_type = ptrdiff_t;
  using pointer = typename IteratorTraits<It>::pointer;
  using reference = typename IteratorTraits<It>::value_type&&;
  using iterator_category = typename IteratorTraits<It>::iterator_category;

  It current;

  explicit MoveIterator(It it) : current(it) {}

  IteratorTraits<It>::value_type&& operator*() const { return move(*this->current); }
  MoveIterator<It>& operator++()
  {
    ++this->current;
    return *this;
  }
  MoveIterator<It> operator++(int)
  {
    MoveIterator<It> tmp = *this;
    ++this->current;
    return tmp;
  }
  It base() const { return this->current; }
  bool operator==(const MoveIterator<It>& other) const { return this->current == other.current; }
  bool operator!=(const MoveIterator<It>& other) const { return this->current != other.current; }
};

template<typename It>
MoveIterator<It> makeMoveIterator(It it) { return MoveIterator<It>(it); }

// BackInserter: an output iterator that push_back's into a container.
template<typename Container>
struct BackInsertIterator
{
  using value_type = void;
  using difference_type = ptrdiff_t;
  using pointer = void;
  using reference = void;
  using iterator_category = OutputIteratorTag;

  Container* container;

  explicit BackInsertIterator(Container& c) : container(&c) {}

  BackInsertIterator<Container>& operator=(const typename Container::value_type& value)
  {
    this->container->push_back(value);
    return *this;
  }
  BackInsertIterator<Container>& operator=(typename Container::value_type&& value)
  {
    this->container->push_back(move(value));
    return *this;
  }
  BackInsertIterator<Container>& operator*() { return *this; }
  BackInsertIterator<Container>& operator++() { return *this; }
};

template<typename Container>
BackInsertIterator<Container> backInserter(Container& c) { return BackInsertIterator<Container>(c); }

// Inserter: an output iterator that insert's at a position.
template<typename Container>
struct InsertIterator
{
  using value_type = void;
  using difference_type = ptrdiff_t;
  using pointer = void;
  using reference = void;
  using iterator_category = OutputIteratorTag;

  Container* container;
  typename Container::iterator position;

  InsertIterator(Container& c, typename Container::iterator pos) : container(&c), position(pos) {}

  InsertIterator<Container>& operator=(const typename Container::value_type& value)
  {
    this->position = this->container->insert(this->position, value);
    ++this->position;
    return *this;
  }
  InsertIterator<Container>& operator*() { return *this; }
  InsertIterator<Container>& operator++() { return *this; }
};

template<typename Container>
InsertIterator<Container> inserter(Container& c, typename Container::iterator pos) { return InsertIterator<Container>(c, pos); }

// The free forms of a container's begin(), end(), size() and the rest (std::begin and friends), for
// generic code that calls them on any range. Each takes part only for a type that has the member
// (a class with its own free begin, like a reverse wrapper, keeps it). Built-in arrays wait for the
// compiler to deduce an array's bound from a `const T (&)[N]` parameter (spec
// templates/array_reference_parameter).
template<typename C> requires requires (C& c) { c.begin(); }
auto begin(C& c) { return c.begin(); }
template<typename C> requires requires (const C& c) { c.begin(); }
auto begin(const C& c) { return c.begin(); }
template<typename C> requires requires (C& c) { c.end(); }
auto end(C& c) { return c.end(); }
template<typename C> requires requires (const C& c) { c.end(); }
auto end(const C& c) { return c.end(); }
template<typename C> requires requires (const C& c) { c.begin(); }
auto cbegin(const C& c) { return c.begin(); }
template<typename C> requires requires (const C& c) { c.end(); }
auto cend(const C& c) { return c.end(); }
template<typename C> requires requires (C& c) { c.rbegin(); }
auto rbegin(C& c) { return c.rbegin(); }
template<typename C> requires requires (const C& c) { c.rbegin(); }
auto rbegin(const C& c) { return c.rbegin(); }
template<typename C> requires requires (C& c) { c.rend(); }
auto rend(C& c) { return c.rend(); }
template<typename C> requires requires (const C& c) { c.rend(); }
auto rend(const C& c) { return c.rend(); }
template<typename C> requires requires (const C& c) { c.size(); }
auto size(const C& c) { return c.size(); }
template<typename C> requires requires (const C& c) { c.size(); }
ptrdiff_t ssize(const C& c) { return (ptrdiff_t)c.size(); }
template<typename C> requires requires (const C& c) { c.empty(); }
auto empty(const C& c) { return c.empty(); }
template<typename C> requires requires (C& c) { c.data(); }
auto data(C& c) { return c.data(); }
template<typename C> requires requires (const C& c) { c.data(); }
auto data(const C& c) { return c.data(); }
