// Extended utilities: misc helpers that std::as_const, std::to_address, std::mem_fn etc.
// convert to.

template<typename T>
const T& asConst(const T& value) noexcept { return value; }

// std::to_address: a raw pointer as it is, a fancy pointer or class iterator through its
// operator->, recursively (pointer_traits<P>::to_address is not consulted: no stdlib class has one).
template<typename P>
auto toAddress(const P& ptr)
{
  if constexpr (isPointer<P>)
    return ptr;
  else
    return toAddress(ptr.operator->());
}

// mem_fn: wraps a member function pointer into a callable object.
template<typename R, typename C>
struct MemFnWrapper
{
  R C::*pmf;
  MemFnWrapper(R C::*pmf) : pmf(pmf) {}

  template<typename... Args>
  auto operator()(C& obj, Args... args) -> decltype((obj.*pmf)(args...))
  {
    return (obj.*pmf)(args...);
  }
};

template<typename R, typename C>
MemFnWrapper<R, C> memFn(R C::*pmf) { return MemFnWrapper<R, C>(pmf); }

// NulloptType: what std::nullopt_t converts to; nullopt itself is in Optional.kpp.
using NulloptType = NullOpt;

// GreaterEqual comparator.
template<typename T = void>
struct GreaterEqual
{
  bool operator()(const T& a, const T& b) const { return !(a < b); }
};

template<>
struct GreaterEqual<void>
{
  template<typename A, typename B>
  bool operator()(const A& a, const B& b) const { return !(a < b); }
};

// Variant helpers: InPlaceIndex and InPlaceType tags used in Variant construction.
template<i32 I>
struct InPlaceIndex {};

template<typename T>
struct InPlaceType {};

struct PiecewiseConstruct_t {};
const PiecewiseConstruct_t piecewiseConstruct;

// --- Bits (C++20's <bit>, under kpp's names) ---

// The unsigned integer types the bit functions take, as std's do: no signed type, no bool, no char.
template<typename T>
constexpr bool isBitOperand = isIntegral<T> && isUnsigned<T> && !isSame<T, bool> && !isSame<T, char>;

// Rotation by count modulo the width, a negative count rotating the other way (std::rotl, std::rotr).
// Neither shift is ever by the width or more (rotr(x, 0) shifted left by 32, which an optimized
// build makes anything: 0x12345678 gave 0x0b6baa20).
template<typename T> requires isBitOperand<T>
constexpr T rotl(T value, i32 count)
{
  constexpr i32 width = i32(sizeof(T) * 8);
  i32 r = count % width;
  if (r < 0)
    r += width;
  return r == 0 ? value : static_cast<T>(static_cast<T>(value << r) | static_cast<T>(value >> (width - r)));
}

template<typename T> requires isBitOperand<T>
constexpr T rotr(T value, i32 count)
{
  constexpr i32 width = i32(sizeof(T) * 8);
  i32 r = count % width;
  if (r < 0)
    r += width;
  return r == 0 ? value : static_cast<T>(static_cast<T>(value >> r) | static_cast<T>(value << (width - r)));
}

// The number of set bits (std::popcount).
template<typename T> requires isBitOperand<T>
constexpr i32 popcount(T value)
{
  i32 count = 0;
  for (; value != 0; value = static_cast<T>(value & (value - 1)))
    ++count;
  return count;
}

// The zero (one) bits above the highest one (zero) bit, and below the lowest (std::countl_zero,
// countl_one, countr_zero, countr_one): the width for 0 (all ones).
template<typename T> requires isBitOperand<T>
constexpr i32 countlZero(T value)
{
  constexpr i32 width = i32(sizeof(T) * 8);
  i32 count = 0;
  for (i32 bit = width - 1; bit >= 0 && ((value >> bit) & 1) == 0; --bit)
    ++count;
  return count;
}

template<typename T> requires isBitOperand<T>
constexpr i32 countlOne(T value)
{
  return countlZero(static_cast<T>(~value));
}

template<typename T> requires isBitOperand<T>
constexpr i32 countrZero(T value)
{
  constexpr i32 width = i32(sizeof(T) * 8);
  i32 count = 0;
  for (i32 bit = 0; bit < width && ((value >> bit) & 1) == 0; ++bit)
    ++count;
  return count;
}

template<typename T> requires isBitOperand<T>
constexpr i32 countrOne(T value)
{
  return countrZero(static_cast<T>(~value));
}

// The bits needed for value: 0 for 0 (std::bit_width).
template<typename T> requires isBitOperand<T>
constexpr i32 bitWidth(T value)
{
  return i32(sizeof(T) * 8) - countlZero(value);
}

// The least power of two not below value, 1 for 0 and 1 (std::bit_ceil; a value above the largest
// power of two the type holds has none, as in C++); the greatest not above it, 0 for 0 (std::bit_floor).
template<typename T> requires isBitOperand<T>
constexpr T bitCeil(T value)
{
  return value <= 1 ? static_cast<T>(1) : static_cast<T>(static_cast<T>(1) << bitWidth(static_cast<T>(value - 1)));
}

template<typename T> requires isBitOperand<T>
constexpr T bitFloor(T value)
{
  return value == 0 ? static_cast<T>(0) : static_cast<T>(static_cast<T>(1) << (bitWidth(value) - 1));
}

// Whether value is a power of two (std::has_single_bit).
template<typename T> requires isBitOperand<T>
constexpr bool hasSingleBit(T value)
{
  return value != 0 && (value & (value - 1)) == 0;
}

// The bytes in reverse order, of any integer type (std::byteswap).
template<typename T> requires (isIntegral<T> && !isSame<T, bool>)
constexpr T byteswap(T value)
{
  MakeUnsigned<T> bits = static_cast<MakeUnsigned<T>>(value);
  MakeUnsigned<T> result = 0;
  for (usize i = 0; i < sizeof(T); ++i)
  {
    result = static_cast<MakeUnsigned<T>>(result << 8) | static_cast<MakeUnsigned<T>>(bits & 0xFF);
    bits = static_cast<MakeUnsigned<T>>(bits >> 8);
  }
  return static_cast<T>(result);
}

// The greatest common divisor of |a| and |b| (std::gcd), 0 when both are 0, and their least common
// multiple (std::lcm), 0 when either is 0; they fold at compile time (a Ratio's terms, the common
// period of two durations).
// Any two integer types: the result is their common type (std::common_type: the type itself for two
// of one type, else the usual arithmetic conversions), computed on the absolute values in its
// unsigned form, so that every value of an unsigned type is itself and the most negative value of
// a signed one has its magnitude. (static_cast, not `T(x)`: a functional cast through a dependent
// alias does not fold at compile time yet, and Ratio needs these folded.)
template<typename M, typename N>
using GcdType = typename Conditional<isSame<M, N>, M, decltype(true ? declval<M>() : declval<N>())>::Type;

template<typename U>
constexpr U gcdUnsigned(U a, U b) { return b == 0 ? a : gcdUnsigned(b, static_cast<U>(a % b)); }

// |value| in T's unsigned form.
template<typename T>
constexpr MakeUnsigned<T> unsignedMagnitude(T value)
{
  return value < 0 ? static_cast<MakeUnsigned<T>>(static_cast<MakeUnsigned<T>>(0) - static_cast<MakeUnsigned<T>>(value))
                   : static_cast<MakeUnsigned<T>>(value);
}

template<typename M, typename N> requires (isIntegral<M> && isIntegral<N> && !isSame<M, bool> && !isSame<N, bool>)
constexpr GcdType<M, N> gcd(M m, N n)
{
  return static_cast<GcdType<M, N>>(
    gcdUnsigned(unsignedMagnitude(static_cast<GcdType<M, N>>(m)), unsignedMagnitude(static_cast<GcdType<M, N>>(n))));
}

template<typename M, typename N> requires (isIntegral<M> && isIntegral<N> && !isSame<M, bool> && !isSame<N, bool>)
constexpr GcdType<M, N> lcm(M m, N n)
{
  if (m == 0 || n == 0)
    return 0;
  auto a = unsignedMagnitude(static_cast<GcdType<M, N>>(m));
  auto b = unsignedMagnitude(static_cast<GcdType<M, N>>(n));
  return static_cast<GcdType<M, N>>(a / gcdUnsigned(a, b) * b);
}

// Halfway from a to b (std::midpoint): an integer's without overflow, rounded towards a; a floating
// point value's without overflow at its range's ends; a pointer's within its array.
template<typename T> requires (isIntegral<T> && !isSame<T, bool>)
constexpr T midpoint(T a, T b)
{
  MakeUnsigned<T> ua = static_cast<MakeUnsigned<T>>(a), ub = static_cast<MakeUnsigned<T>>(b);
  if (a > b)
    return static_cast<T>(ua - static_cast<MakeUnsigned<T>>(static_cast<MakeUnsigned<T>>(ua - ub) / 2));
  return static_cast<T>(ua + static_cast<MakeUnsigned<T>>(static_cast<MakeUnsigned<T>>(ub - ua) / 2));
}

template<typename T> requires isFloatingPoint<T>
constexpr T midpoint(T a, T b)
{
  constexpr T low = Limits<T>::min() * 2;
  constexpr T high = Limits<T>::max() / 2;
  T absA = a < 0 ? -a : a;
  T absB = b < 0 ? -b : b;
  if (absA <= high && absB <= high)
    return (a + b) / 2;
  if (absA < low)
    return a + b / 2;
  if (absB < low)
    return a / 2 + b;
  return a / 2 + b / 2;
}

template<typename T>
constexpr T* midpoint(T* a, T* b)
{
  return a + (b - a) / 2;
}

// a + t (b - a) (std::lerp): exactly a at t 0 and b at t 1, monotonic in t, and a for a == b.
template<typename T> requires isFloatingPoint<T>
constexpr T lerp(T a, T b, T t)
{
  if ((a <= 0 && b >= 0) || (a >= 0 && b <= 0))
    return t * b + (1 - t) * a;
  if (t == 1)
    return b;
  T x = a + t * (b - a);
  return (t > 1) == (b > a) ? (b < x ? x : b) : (x < b ? x : b);
}

// make_unique_for_overwrite: allocates uninitialized storage.
template<typename T>
UniquePtr<T> makeUniqueForOverwrite() { return UniquePtr<T>(new T); }
