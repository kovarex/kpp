// kpp standard library: WString, a string of wchar_t for the Windows API (UTF-16 code units),
// always zero-terminated: what std::wstring converts to. String's interface over wchar_t;
// specified in docs/stdlib/string.md, "WString". Conversions to and from UTF-8 live in StringUtil
// of the program using it (and in Filesystem's path).
class WString
{
public:
  // Not found, or to the end: the largest size, as C++'s npos is the largest size_t, so that a
  // search result compares with sizes as in C++ (`min(s.find(x), s.size())`).
  static const ContainerSize npos = ContainerSize(-1);

  using iterator = wchar_t*;
  using const_iterator = const wchar_t*;
  using value_type = wchar_t;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = wchar_t&;
  using const_reference = const wchar_t&;
  using pointer = wchar_t*;
  using const_pointer = const wchar_t*;

  WString() {}
  implicit WString(const wchar_t* text) { this->append(text, WString::lengthOf(text)); }
  WString(const wchar_t* text, ContainerSize count) { this->append(text, count); }
  WString(const wchar_t* first, const wchar_t* last) { this->append(first, checkedSize(last - first, "string too long")); }
  WString(ContainerSize count, wchar_t c) { this->append(count, c); }
  WString(const WString& other) { this->append(other.chars, other.unitCount); }

  WString(WString&& other) noexcept : chars(other.chars), unitCount(other.unitCount), capacity(other.capacity)
  {
    other.chars = nullptr;
    other.unitCount = 0;
    other.capacity = 0;
  }

  ~WString()
  {
    if (this->chars)
      free(this->chars);
  }

  WString& operator=(const WString& other)
  {
    if (this == &other)
      return *this;
    this->clear();
    this->append(other.chars, other.unitCount);
    return *this;
  }

  WString& operator=(WString&& other) noexcept
  {
    if (this == &other)
      return *this;
    if (this->chars)
      free(this->chars);
    this->chars = other.chars;
    this->unitCount = other.unitCount;
    this->capacity = other.capacity;
    other.chars = nullptr;
    other.unitCount = 0;
    other.capacity = 0;
    return *this;
  }

  WString& operator=(const wchar_t* text)
  {
    WString copy(text); // text may point into this WString
    *this = move(copy);
    return *this;
  }

  // The terminator of a WString that never held anything, writable as std's data()[size()] is.
  static wchar_t* noChars()
  {
    static wchar_t terminator = 0;
    return &terminator;
  }

  static ContainerSize lengthOf(const wchar_t* text)
  {
    usize n = 0;
    while (text != nullptr && text[n] != 0)
      ++n;
    return checkedSize(n, "string too long");
  }

  ContainerSize size() const { return this->unitCount; }
  ContainerSize length() const { return this->unitCount; }
  bool empty() const { return this->unitCount == 0; }
  const wchar_t* c_str() const { return this->chars ? this->chars : L""; }
  wchar_t* data() { return this->chars ? this->chars : WString::noChars(); }
  const wchar_t* data() const { return this->c_str(); }
  wchar_t& operator[](ContainerSize index) { return this->data()[index]; }
  const wchar_t& operator[](ContainerSize index) const { return this->c_str()[index]; }

  wchar_t& at(ContainerSize index)
  {
    if (index >= this->unitCount)
      throw OutOfRange(String("WString::at"));
    return this->chars[index];
  }

  wchar_t& front() { return this->chars[0]; }
  wchar_t front() const { return this->chars[0]; }
  wchar_t& back() { return this->chars[this->unitCount - 1]; }
  wchar_t back() const { return this->chars[this->unitCount - 1]; }
  wchar_t* begin() { return this->chars; }
  wchar_t* end() { return this->chars + this->unitCount; }
  const wchar_t* begin() const { return this->chars; }
  const wchar_t* end() const { return this->chars + this->unitCount; }
  const wchar_t* cbegin() const { return this->begin(); }
  const wchar_t* cend() const { return this->end(); }
  ReverseIterator<const wchar_t*> rbegin() const { return ReverseIterator<const wchar_t*>(this->end()); }
  ReverseIterator<const wchar_t*> rend() const { return ReverseIterator<const wchar_t*>(this->begin()); }
  ReverseIterator<const wchar_t*> crbegin() const { return this->rbegin(); }
  ReverseIterator<const wchar_t*> crend() const { return this->rend(); }

  // Room for needed units and the terminator: the capacity doubles from 16 until they fit, at most
  // maxContainerSize; LengthError when they do not fit in it (core/Sizes.kpp).
  void reserve(ContainerSize needed)
  {
    if (needed >= maxContainerSize) // (needed + 1 is past it, or wraps to 0)
      throwLengthError("string too long");
    if (needed < this->capacity)
      return;
    ContainerSize doubled = this->capacity == 0 ? 16 : this->capacity;
    while (doubled < needed + 1 && doubled <= maxContainerSize / 2)
      doubled *= 2;
    ContainerSize newCapacity = doubled < needed + 1 ? maxContainerSize : doubled;
    wchar_t* bigger = allocateArray<wchar_t>(newCapacity);
    if (this->chars)
    {
      memcpy(bigger, this->chars, (usize)(this->unitCount + 1) * sizeof(wchar_t));
      free(this->chars);
    }
    else
      bigger[0] = 0;
    this->chars = bigger;
    this->capacity = newCapacity;
  }

  // count units at units appended; units may point into this WString. The appends return the string.
  WString& append(const wchar_t* units, ContainerSize count)
  {
    if (count <= 0)
      return *this;
    ContainerSize newLength = sizeSum(this->unitCount, count, "string too long"); // before a unit is copied
    if (this->chars && units >= this->chars && units < this->chars + this->capacity)
    {
      WString copy(units, count);
      return this->append(copy.chars, count);
    }
    this->reserve(newLength);
    memcpy(this->chars + this->unitCount, units, (usize)count * sizeof(wchar_t));
    this->unitCount += count;
    this->chars[this->unitCount] = 0;
    return *this;
  }

  WString& append(const wchar_t* text) { return this->append(text, WString::lengthOf(text)); }
  WString& append(const WString& other) { return this->append(other.chars, other.unitCount); }

  WString& append(ContainerSize count, wchar_t c)
  {
    if (count <= 0)
      return *this;
    this->reserve(sizeSum(this->unitCount, count, "string too long"));
    for (ContainerSize i = 0; i < count; ++i)
      this->chars[this->unitCount + i] = c;
    this->unitCount += count;
    this->chars[this->unitCount] = 0;
    return *this;
  }

  void push_back(wchar_t c) { this->append(&c, 1); }

  void pop_back()
  {
    --this->unitCount;
    this->chars[this->unitCount] = 0;
  }

  void resize(ContainerSize newLength, wchar_t fill)
  {
    if (newLength < this->unitCount)
    {
      this->unitCount = newLength;
      this->chars[newLength] = 0;
    }
    else
      this->append(newLength - this->unitCount, fill);
  }

  void resize(ContainerSize newLength) { this->resize(newLength, 0); }

  void clear()
  {
    this->unitCount = 0;
    if (this->chars)
      this->chars[0] = 0;
  }

  // Removes count units from index (to the end when count is npos or reaches past it);
  // throws OutOfRange when index is past the end.
  WString& erase(ContainerSize index, ContainerSize count)
  {
    if (index > this->unitCount)
      throw OutOfRange(String("WString::erase"));
    if (count > this->unitCount - index)
      count = this->unitCount - index;
    if (count > 0)
    {
      memmove(this->chars + index, this->chars + index + count, (usize)(this->unitCount - index - count) * sizeof(wchar_t));
      this->unitCount -= count;
      this->chars[this->unitCount] = 0;
    }
    return *this;
  }

  // Inserts count units before index (ForkTask.cpp puts the executable's path in front of a
  // command line); throws OutOfRange when index is past the end. units may point into this WString.
  WString& insert(ContainerSize index, const wchar_t* units, ContainerSize count)
  {
    if (index > this->unitCount)
      throw OutOfRange(String("WString::insert"));
    if (count <= 0)
      return *this;
    ContainerSize newLength = sizeSum(this->unitCount, count, "string too long"); // before a unit is copied
    if (this->chars && units >= this->chars && units < this->chars + this->capacity)
    {
      WString copy(units, count);
      return this->insert(index, copy.chars, count);
    }
    this->reserve(newLength);
    // The units from index on, the terminating 0 with them, move up by count.
    memmove(this->chars + index + count, this->chars + index, (usize)(this->unitCount - index + 1) * sizeof(wchar_t));
    memcpy(this->chars + index, units, (usize)count * sizeof(wchar_t));
    this->unitCount += count;
    return *this;
  }

  WString& insert(ContainerSize index, const wchar_t* text) { return this->insert(index, text, WString::lengthOf(text)); }
  WString& insert(ContainerSize index, const WString& text) { return this->insert(index, text.chars, text.unitCount); }

  WString& insert(ContainerSize index, ContainerSize count, wchar_t c)
  {
    WString units;
    units.append(count, c);
    return this->insert(index, units.chars, units.unitCount);
  }

  // `<<` appends, as on String (design.md 14: no +=): a WString, wide C text or a wchar_t.
  WString& operator<<(const WString& other)
  {
    this->append(other);
    return *this;
  }

  WString& operator<<(const wchar_t* text)
  {
    this->append(text);
    return *this;
  }

  WString& operator<<(wchar_t c)
  {
    this->push_back(c);
    return *this;
  }

  WString operator+(const WString& other) const
  {
    WString result;
    result.reserve(sizeSum(this->unitCount, other.unitCount, "string too long"));
    result.append(*this);
    result.append(other);
    return result;
  }

  WString operator+(const wchar_t* text) const
  {
    WString result(*this);
    result.append(text);
    return result;
  }

  WString operator+(wchar_t c) const
  {
    WString result(*this);
    result.push_back(c);
    return result;
  }

  // Searching: each returns the index of the first match at or after from, or npos.
  ContainerSize find(const wchar_t* needle, ContainerSize from, ContainerSize count) const
  {
    if (count > this->unitCount) // (unitCount - count would wrap)
      return npos;
    for (ContainerSize i = from; i <= this->unitCount - count; ++i)
    {
      ContainerSize k = 0;
      while (k < count && this->chars[i + k] == needle[k])
        ++k;
      if (k == count)
        return i;
    }
    return npos;
  }

  ContainerSize find(const wchar_t* needle, ContainerSize from) const { return this->find(needle, from, WString::lengthOf(needle)); }
  ContainerSize find(const wchar_t* needle) const { return this->find(needle, 0); }
  ContainerSize find(const WString& needle, ContainerSize from) const { return this->find(needle.c_str(), from, needle.unitCount); }
  ContainerSize find(const WString& needle) const { return this->find(needle, 0); }
  ContainerSize find(wchar_t c, ContainerSize from) const { return this->find(&c, from, 1); }
  ContainerSize find(wchar_t c) const { return this->find(c, 0); }

  // The last c at or before from (anywhere when from is npos), or npos.
  ContainerSize rfind(wchar_t c, ContainerSize from) const
  {
    if (this->unitCount == 0)
      return npos;
    for (ContainerSize i = from < this->unitCount - 1 ? from : this->unitCount - 1;; --i) // down to 0, which ends it
    {
      if (this->chars[i] == c)
        return i;
      if (i == 0)
        return npos;
    }
  }

  ContainerSize rfind(wchar_t c) const { return this->rfind(c, npos); }

  // The first unit at or after from that is in set, or npos.
  ContainerSize find_first_of(const wchar_t* set, ContainerSize from) const
  {
    for (ContainerSize i = from; i < this->unitCount; ++i)
      for (const wchar_t* s = set; *s; ++s)
        if (this->chars[i] == *s)
          return i;
    return npos;
  }

  ContainerSize find_first_of(const wchar_t* set) const { return this->find_first_of(set, 0); }

  // The last unit that is in set, or npos.
  ContainerSize find_last_of(const wchar_t* set) const
  {
    for (ContainerSize i = this->unitCount; i-- > 0;)
      for (const wchar_t* s = set; *s; ++s)
        if (this->chars[i] == *s)
          return i;
    return npos;
  }

  ContainerSize find_last_of(wchar_t c) const { return this->rfind(c); }

  // count units from start (all the rest when count is npos or runs past the end); throws
  // OutOfRange when start is past the end.
  WString substr(ContainerSize start, ContainerSize count) const
  {
    if (start > this->unitCount)
      throw OutOfRange(String("WString::substr"));
    if (count > this->unitCount - start)
      count = this->unitCount - start;
    return WString(this->c_str() + start, count);
  }

  WString substr(ContainerSize start) const { return this->substr(start, npos); }

  // Negative, 0 or positive as this sorts before, with or after other, unit by unit.
  i32 compare(const WString& other) const
  {
    ContainerSize n = this->unitCount < other.unitCount ? this->unitCount : other.unitCount;
    for (ContainerSize i = 0; i < n; ++i)
      if (this->chars[i] != other.chars[i])
        return this->chars[i] < other.chars[i] ? -1 : 1;
    return this->unitCount < other.unitCount ? -1 : this->unitCount > other.unitCount ? 1 : 0;
  }

  bool operator==(const WString& other) const
  {
    return this->unitCount == other.unitCount &&
           (this->unitCount == 0 || memcmp(this->chars, other.chars, (usize)this->unitCount * sizeof(wchar_t)) == 0);
  }

  bool operator==(const wchar_t* text) const { return *this == WString(text); }
  bool operator<(const WString& other) const { return this->compare(other) < 0; }
  bool operator>(const WString& other) const { return this->compare(other) > 0; }
  bool operator<=(const WString& other) const { return this->compare(other) <= 0; }
  bool operator>=(const WString& other) const { return this->compare(other) >= 0; }

  strong_ordering operator<=>(const WString& other) const
  {
    i32 c = this->compare(other);
    return c < 0 ? strong_ordering::less : c > 0 ? strong_ordering::greater : strong_ordering::equal;
  }

private:
  wchar_t* chars = nullptr;
  ContainerSize unitCount = 0;
  ContainerSize capacity = 0;
};

WString operator+(const wchar_t* left, const WString& right)
{
  WString result(left);
  result.append(right);
  return result;
}

WString operator+(wchar_t left, const WString& right)
{
  WString result(1, left);
  result.append(right);
  return result;
}
