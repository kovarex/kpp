// Source locations.

// The place a function was called from (what std::source_location converts to). A parameter
// declared `CallerLocation here = caller` is filled in by the compiler at every call that leaves it
// out, in the order of the fields below:
//
//   void log(const char* text, CallerLocation here = caller);
//   log("hello");   // here.file_name() "main.kpp", here.line() 12, here.column() 3, here.function_name() "main"
struct CallerLocation
{
  const char* sourceFile;
  u32 sourceLine;
  u32 sourceColumn;
  const char* sourceFunction;

  const char* file_name() const { return this.sourceFile; }
  u32 line() const { return this.sourceLine; }
  u32 column() const { return this.sourceColumn; }
  const char* function_name() const { return this.sourceFunction; }
};
