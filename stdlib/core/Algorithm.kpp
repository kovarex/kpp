// Kpp standard library: the algorithms over ranges [first, last) given by iterators (what std::sort,
// std::find and the rest of <algorithm> convert to), and the reverse iterators and comparator
// objects they use. Specified in docs/stdlib/algorithms.md. Each algorithm takes any iterator of
// the category it needs (common.md): input iterators for the scans, forward iterators for the
// algorithms that write in place, bidirectional ones for reverse, random access ones for sorting.
// Pointers are random access iterators, and so are the iterators of Vector, String, Array, Deque.

// --- Iterator steps ---

// Whether It is at least a random access (or bidirectional) iterator, by its iterator_category.
template<typename It>
constexpr bool isRandomAccessIterator = isBaseOf<RandomAccessIteratorTag, typename IteratorTraits<It>::iterator_category>;
template<typename It>
constexpr bool isBidirectionalIterator = isBaseOf<BidirectionalIteratorTag, typename IteratorTraits<It>::iterator_category>;

// The number of steps from first to last: O(1) for random access iterators, O(n) for the others.
template<typename It>
ptrdiff_t distance(It first, It last)
{
  if constexpr (isRandomAccessIterator<It>)
    return last - first;
  else
  {
    ptrdiff_t n = 0;
    for (; first != last; ++first)
      ++n;
    return n;
  }
}

// Moves it n steps forward, or back for a negative n (a bidirectional iterator): O(1) for random
// access iterators, O(|n|) for the others.
template<typename It>
void advance(It& it, ptrdiff_t n)
{
  if constexpr (isRandomAccessIterator<It>)
    it += n;
  else
  {
    for (; n > 0; --n)
      ++it;
    if constexpr (isBidirectionalIterator<It>)
      for (; n < 0; ++n)
        --it;
  }
}
template<typename It>
It next(It it, ptrdiff_t n = 1)
{
  advance(it, n);
  return it;
}
template<typename It>
It prev(It it, ptrdiff_t n = 1)
{
  advance(it, -n);
  return it;
}

template<typename It1, typename It2>
void iterSwap(It1 a, It2 b) { swap(*a, *b); }

// --- Scans ---

template<typename It, typename V>
It find(It first, It last, const V& value)
{
  for (; first != last; ++first)
    if (*first == value)
      return first;
  return last;
}

template<typename It, typename F>
It findIf(It first, It last, F predicate)
{
  for (; first != last; ++first)
    if (predicate(*first))
      return first;
  return last;
}

template<typename It, typename F>
It findIfNot(It first, It last, F predicate)
{
  for (; first != last; ++first)
    if (!predicate(*first))
      return first;
  return last;
}

template<typename It, typename V>
ptrdiff_t count(It first, It last, const V& value)
{
  ptrdiff_t n = 0;
  for (; first != last; ++first)
    if (*first == value)
      ++n;
  return n;
}

template<typename It, typename F>
ptrdiff_t countIf(It first, It last, F predicate)
{
  ptrdiff_t n = 0;
  for (; first != last; ++first)
    if (predicate(*first))
      ++n;
  return n;
}

template<typename It, typename F>
bool allOf(It first, It last, F predicate)
{
  for (; first != last; ++first)
    if (!predicate(*first))
      return false;
  return true;
}

template<typename It, typename F>
bool anyOf(It first, It last, F predicate)
{
  for (; first != last; ++first)
    if (predicate(*first))
      return true;
  return false;
}

template<typename It, typename F>
bool noneOf(It first, It last, F predicate) { return !anyOf(first, last, predicate); }

// Calls f(x) for every x in order; returns f.
template<typename It, typename F>
F forEach(It first, It last, F f)
{
  for (; first != last; ++first)
    f(*first);
  return f;
}

// The greatest element (the first of equal greatest ones), or last for an empty range.
template<typename It>
It maxElement(It first, It last)
{
  if (first == last)
    return last;
  It best = first;
  for (++first; first != last; ++first)
    if (*best < *first)
      best = first;
  return best;
}
template<typename It, typename F>
It maxElement(It first, It last, F less)
{
  if (first == last)
    return last;
  It best = first;
  for (++first; first != last; ++first)
    if (less(*best, *first))
      best = first;
  return best;
}

// The least element (the first of equal least ones), or last for an empty range.
template<typename It>
It minElement(It first, It last)
{
  if (first == last)
    return last;
  It best = first;
  for (++first; first != last; ++first)
    if (*first < *best)
      best = first;
  return best;
}
template<typename It, typename F>
It minElement(It first, It last, F less)
{
  if (first == last)
    return last;
  It best = first;
  for (++first; first != last; ++first)
    if (less(*first, *best))
      best = first;
  return best;
}

// The largest and the smallest of a brace list: `max({a, b, c})`.
template<typename T>
T max(InitializerList<T> values)
{
  T best = values[0];
  for (int i = 1; i < values.size(); ++i)
    if (best < values[i])
      best = values[i];
  return best;
}
template<typename T>
T min(InitializerList<T> values)
{
  T best = values[0];
  for (int i = 1; i < values.size(); ++i)
    if (values[i] < best)
      best = values[i];
  return best;
}

// init with every element added in order (std::accumulate): `init = init + x`, or `init = op(init, x)`.
template<typename It, typename T>
T accumulate(It first, It last, T init)
{
  for (; first != last; ++first)
    init = move(init) + *first;
  return init;
}
template<typename It, typename T, typename F>
T accumulate(It first, It last, T init, F op)
{
  for (; first != last; ++first)
    init = op(move(init), *first);
  return init;
}

// --- Writing ---

// Writes f(x) for every x of [first, last) to out; returns one past the last written.
template<typename InIt, typename OutIt, typename F>
OutIt transform(InIt first, InIt last, OutIt out, F f)
{
  for (; first != last; ++first, ++out)
    *out = f(*first);
  return out;
}
// Writes f(x, y) for the elements x of [first1, last1) and y of the range from first2, in pairs.
template<typename InIt1, typename InIt2, typename OutIt, typename F>
OutIt transform(InIt1 first1, InIt1 last1, InIt2 first2, OutIt out, F f)
{
  for (; first1 != last1; ++first1, ++first2, ++out)
    *out = f(*first1, *first2);
  return out;
}

template<typename It, typename V>
void fill(It first, It last, const V& value)
{
  for (; first != last; ++first)
    *first = value;
}

template<typename It, typename F>
void generate(It first, It last, F generator)
{
  for (; first != last; ++first)
    *first = generator();
}

// Replaces every element equal to oldValue with newValue.
template<typename It, typename V>
void replace(It first, It last, const V& oldValue, const V& newValue)
{
  for (; first != last; ++first)
    if (*first == oldValue)
      *first = newValue;
}
template<typename It, typename F, typename V>
void replaceIf(It first, It last, F predicate, const V& newValue)
{
  for (; first != last; ++first)
    if (predicate(*first))
      *first = newValue;
}

// Moves the elements not equal to value to the front, in order; returns the end of those. The
// elements from there to last are left valid but unspecified (moved from).
template<typename It, typename V>
It remove(It first, It last, const V& value)
{
  first = find(first, last, value);
  if (first == last)
    return first;
  It out = first;
  for (++first; first != last; ++first)
    if (!(*first == value))
    {
      *out = move(*first);
      ++out;
    }
  return out;
}
// The same for the elements that do not satisfy predicate.
template<typename It, typename F>
It removeIf(It first, It last, F predicate)
{
  first = findIf(first, last, predicate);
  if (first == last)
    return first;
  It out = first;
  for (++first; first != last; ++first)
    if (!predicate(*first))
    {
      *out = move(*first);
      ++out;
    }
  return out;
}

// Keeps the first of every run of equal neighbours (equal by == or by same(a, b)), moved to the
// front; returns the end of the kept ones.
template<typename It>
It unique(It first, It last)
{
  if (first == last)
    return last;
  It out = first;
  for (++first; first != last; ++first)
    if (!(*out == *first))
    {
      ++out;
      if (out != first)
        *out = move(*first);
    }
  return ++out;
}
template<typename It, typename F>
It unique(It first, It last, F same)
{
  if (first == last)
    return last;
  It out = first;
  for (++first; first != last; ++first)
    if (!same(*out, *first))
    {
      ++out;
      if (out != first)
        *out = move(*first);
    }
  return ++out;
}

// Reverses the order of the elements (a bidirectional range).
template<typename It>
void reverse(It first, It last)
{
  while (first != last)
  {
    --last;
    if (first == last)
      break;
    swap(*first, *last);
    ++first;
  }
}

// --- Searching sorted ranges ---

// The first position whose element is not less than value: O(log n) comparisons, and O(log n)
// steps for random access iterators, O(n) for the others.
template<typename It, typename V, typename F>
It lowerBound(It first, It last, const V& value, F less)
{
  ptrdiff_t count = distance(first, last);
  while (count > 0)
  {
    ptrdiff_t half = count / 2;
    It middle = first;
    advance(middle, half);
    if (less(*middle, value))
    {
      first = ++middle;
      count -= half + 1;
    }
    else
      count = half;
  }
  return first;
}
template<typename It, typename V>
It lowerBound(It first, It last, const V& value)
{
  return lowerBound(first, last, value, Less<>());
}

// The first position whose element is greater than value.
template<typename It, typename V, typename F>
It upperBound(It first, It last, const V& value, F less)
{
  ptrdiff_t count = distance(first, last);
  while (count > 0)
  {
    ptrdiff_t half = count / 2;
    It middle = first;
    advance(middle, half);
    if (!less(value, *middle))
    {
      first = ++middle;
      count -= half + 1;
    }
    else
      count = half;
  }
  return first;
}
template<typename It, typename V>
It upperBound(It first, It last, const V& value)
{
  return upperBound(first, last, value, Less<>());
}

// Whether an element equivalent to value is there.
template<typename It, typename V, typename F>
bool binarySearch(It first, It last, const V& value, F less)
{
  first = lowerBound(first, last, value, less);
  return first != last && !less(value, *first);
}
template<typename It, typename V>
bool binarySearch(It first, It last, const V& value) { return binarySearch(first, last, value, Less<>()); }

// The range of the elements equivalent to value: (lowerBound, upperBound).
template<typename It, typename V, typename F>
Pair<It, It> equalRange(It first, It last, const V& value, F less)
{
  return Pair<It, It>(lowerBound(first, last, value, less), upperBound(first, last, value, less));
}
template<typename It, typename V>
Pair<It, It> equalRange(It first, It last, const V& value) { return equalRange(first, last, value, Less<>()); }

// --- Sorting (random access iterators) ---

// sort is introsort, as in the C++ libraries: quicksort around the median of three, heapsort when
// the recursion gets deeper than 2 log n (so O(n log n) in the worst case), insertion sort over the
// short ranges quicksort leaves. Not stable; stableSort is.
template<typename It, typename F>
void sort(It first, It last, F less)
{
  ptrdiff_t count = last - first;
  if (count < 2)
    return;
  int depthLimit = 0;
  for (ptrdiff_t k = count; k > 1; k >>= 1)
    depthLimit += 2;
  introSortLoop(first, last, depthLimit, less);
  insertionSort(first, last, less);
}

// Sorts [first, last) by operator<.
template<typename It>
void sort(It first, It last)
{
  sort(first, last, Less<>());
}

// Quicksorts until every range is at most 16 elements long, each element already in its range.
template<typename It, typename F>
void introSortLoop(It first, It last, int depthLimit, F& less)
{
  while (last - first > 16)
  {
    if (depthLimit == 0)
    {
      heapSort(first, last, less);
      return;
    }
    --depthLimit;
    moveMedianToFirst(first, first + 1, first + (last - first) / 2, last - 1, less);
    It cut = partitionAroundFirst(first, last, less);
    introSortLoop(cut, last, depthLimit, less);
    last = cut;
  }
}

// Swaps the median of *a, *b and *c into *result.
template<typename It, typename F>
void moveMedianToFirst(It result, It a, It b, It c, F& less)
{
  if (less(*a, *b))
  {
    if (less(*b, *c))
      swap(*result, *b);
    else if (less(*a, *c))
      swap(*result, *c);
    else
      swap(*result, *a);
  }
  else if (less(*a, *c))
    swap(*result, *a);
  else if (less(*b, *c))
    swap(*result, *c);
  else
    swap(*result, *b);
}

// Partitions (first, last) around the pivot *first: returns cut with nothing in [first + 1, cut)
// greater than the pivot and nothing in [cut, last) less. The median of three guarantees an
// element on each side that stops the scans, so they need no bounds checks.
template<typename It, typename F>
It partitionAroundFirst(It first, It last, F& less)
{
  It left = first + 1;
  It right = last;
  while (true)
  {
    while (less(*left, *first))
      ++left;
    --right;
    while (less(*first, *right))
      --right;
    if (!(left < right))
      return left;
    swap(*left, *right);
    ++left;
  }
}

template<typename It, typename F>
void insertionSort(It first, It last, F& less)
{
  using T = typename IteratorTraits<It>::value_type;
  if (first == last)
    return;
  for (It next = first + 1; next < last; ++next)
  {
    if (!less(*next, *(next - 1)))
      continue;
    T value = move(*next);
    It hole = next;
    do
    {
      *hole = move(*(hole - 1));
      --hole;
    } while (hole > first && less(value, *(hole - 1)));
    *hole = move(value);
  }
}

template<typename It, typename F>
void heapSort(It first, It last, F& less)
{
  ptrdiff_t count = last - first;
  for (ptrdiff_t i = count / 2; i-- > 0;)
    heapSiftDown(first, i, count, less);
  for (ptrdiff_t end = count - 1; end > 0; --end)
  {
    swap(first[0], first[end]);
    heapSiftDown(first, 0, end, less);
  }
}

// Restores the max-heap property below hole in the heap first[0, count).
template<typename It, typename F>
void heapSiftDown(It first, ptrdiff_t hole, ptrdiff_t count, F& less)
{
  using T = typename IteratorTraits<It>::value_type;
  T value = move(first[hole]);
  while (true)
  {
    ptrdiff_t child = 2 * hole + 1;
    if (child >= count)
      break;
    if (child + 1 < count && less(first[child], first[child + 1]))
      ++child;
    if (!less(value, first[child]))
      break;
    first[hole] = move(first[child]);
    hole = child;
  }
  first[hole] = move(value);
}

// Sorts keeping equivalent elements in their order: insertion-sorted runs of 32, then merged in
// passes between the range and a buffer, moving the elements (relocate in Utility.kpp). Over a
// range that is not an array (a Deque's), the elements are moved into one, sorted and moved back.
template<typename It, typename F>
void stableSort(It first, It last, F less)
{
  using T = typename IteratorTraits<It>::value_type;
  if constexpr (!isPointer<It>)
  {
    Vector<T> items;
    items.reserve(int(last - first));
    for (It it = first; it != last; ++it)
      items.push_back(move(*it));
    stableSort(items.begin(), items.end(), less);
    It out = first;
    for (T& item : items)
    {
      *out = move(item);
      ++out;
    }
  }
  else
  {
    ptrdiff_t count = last - first;
    const ptrdiff_t run = 32;
    for (ptrdiff_t start = 0; start < count; start += run)
      insertionSort(first + start, first + (start + run < count ? start + run : count), less);
    if (count <= run)
      return;
    T* buffer = (T*)malloc((size_t)count * sizeof(T));
    T* from = first;
    T* to = buffer;
    for (ptrdiff_t width = run; width < count; width *= 2)
    {
      for (ptrdiff_t start = 0; start < count; start += 2 * width)
      {
        ptrdiff_t middle = start + width < count ? start + width : count;
        ptrdiff_t end = start + 2 * width < count ? start + 2 * width : count;
        mergeRelocating(from + start, from + middle, from + end, to + start, less);
      }
      T* swapped = from;
      from = to;
      to = swapped;
    }
    if (from != first)
      relocate(first, from, count);
    free(buffer);
  }
}

template<typename It>
void stableSort(It first, It last)
{
  stableSort(first, last, Less<>());
}

// Moves the sorted [a, middle) and [middle, end) into the unconstructed out, merged; on ties the
// first run's element goes first.
template<typename T, typename F>
void mergeRelocating(T* a, T* middle, T* end, T* out, F& less)
{
  T* b = middle;
  while (a < middle && b < end)
  {
    if (less(*b, *a))
      relocate(out++, b++, 1);
    else
      relocate(out++, a++, 1);
  }
  relocate(out, a, middle - a);
  relocate(out + (middle - a), b, end - b);
}

// --- Reverse iterators ---

// Walks a pointer range backwards: rbegin() of a vector is its end, and *it is the element before.
template<typename T>
struct ReverseIterator
{
  using value_type = RemoveConst<T>;
  using difference_type = ptrdiff_t;
  using pointer = T*;
  using reference = T&;
  using iterator_category = RandomAccessIteratorTag;

  T* position = nullptr; // one past the element *this yields

  ReverseIterator() {}
  explicit ReverseIterator(T* position) : position(position) {}
  template<typename U>
  implicit ReverseIterator(ReverseIterator<U> other) : position(other.position) {} // const_reverse_iterator from reverse_iterator

  T& operator*() const { return *(this->position - 1); }
  T* operator->() const { return this->position - 1; }
  T& operator[](ptrdiff_t n) const { return *(this->position - 1 - n); }
  T* base() const { return this->position; }
  ReverseIterator<T>& operator++()
  {
    --this->position;
    return *this;
  }
  ReverseIterator<T> operator++(int)
  {
    ReverseIterator<T> before = *this;
    --this->position;
    return before;
  }
  ReverseIterator<T>& operator--()
  {
    ++this->position;
    return *this;
  }
  ReverseIterator<T> operator--(int)
  {
    ReverseIterator<T> before = *this;
    ++this->position;
    return before;
  }
  ReverseIterator<T>& operator+=(ptrdiff_t n)
  {
    this->position -= n;
    return *this;
  }
  ReverseIterator<T>& operator-=(ptrdiff_t n)
  {
    this->position += n;
    return *this;
  }
  ReverseIterator<T> operator+(ptrdiff_t n) const { return ReverseIterator<T>(this->position - n); }
  ReverseIterator<T> operator-(ptrdiff_t n) const { return ReverseIterator<T>(this->position + n); }
  ptrdiff_t operator-(ReverseIterator<T> other) const { return other.position - this->position; }
  bool operator==(ReverseIterator<T> other) const { return this->position == other.position; }
  bool operator!=(ReverseIterator<T> other) const { return this->position != other.position; }
  bool operator<(ReverseIterator<T> other) const { return other.position < this->position; }
  bool operator>(ReverseIterator<T> other) const { return this->position < other.position; }
  bool operator<=(ReverseIterator<T> other) const { return !(other.position > this->position); }
  bool operator>=(ReverseIterator<T> other) const { return !(this->position > other.position); }
};

// The reverse of a bidirectional iterator It (rbegin()/rend() of the maps, sets and lists): it
// refers to the element before its base position, and ++ steps backwards.
template<typename It>
struct ReverseOf
{
  using value_type = typename It::value_type;
  using difference_type = ptrdiff_t;
  using pointer = typename It::value_type*;
  using reference = typename It::value_type&;
  using iterator_category = BidirectionalIteratorTag;

  It position;

  ReverseOf() {}
  explicit ReverseOf(It position) : position(position) {}

  typename It::value_type& operator*() const
  {
    It before = this->position;
    --before;
    return *before;
  }
  typename It::value_type* operator->() const { return &**this; }
  It base() const { return this->position; }
  ReverseOf<It>& operator++()
  {
    --this->position;
    return *this;
  }
  ReverseOf<It> operator++(int)
  {
    ReverseOf<It> before = *this;
    --this->position;
    return before;
  }
  ReverseOf<It>& operator--()
  {
    ++this->position;
    return *this;
  }
  ReverseOf<It> operator--(int)
  {
    ReverseOf<It> before = *this;
    ++this->position;
    return before;
  }
  bool operator==(const ReverseOf<It>& other) const { return this->position == other.position; }
  bool operator!=(const ReverseOf<It>& other) const { return this->position != other.position; }
};

// --- Comparator objects ---

// Comparator objects (std::less, std::greater, std::equal_to): `Less<T>` compares two T with <,
// the transparent `Less<>` compares any two operands (and says so with `is_transparent`), so
// `Map<String, V, Less<>>` can look a String up by a StringView.
template<typename T = void>
struct Less
{
  bool operator()(const T& a, const T& b) const { return a < b; }
};
template<>
struct Less<void>
{
  using is_transparent = void;
  template<typename A, typename B>
  bool operator()(const A& a, const B& b) const { return a < b; }
};
template<typename T = void>
struct Greater
{
  bool operator()(const T& a, const T& b) const { return b < a; }
};
template<>
struct Greater<void>
{
  using is_transparent = void;
  template<typename A, typename B>
  bool operator()(const A& a, const B& b) const { return b < a; }
};
template<typename T = void>
struct EqualTo
{
  bool operator()(const T& a, const T& b) const { return a == b; }
};
template<>
struct EqualTo<void>
{
  using is_transparent = void;
  template<typename A, typename B>
  bool operator()(const A& a, const B& b) const { return a == b; }
};

// True when the comparator (or hasher) C declares `is_transparent`: the containers then look keys
// up by any type C accepts, without converting them to the key type first.
template<typename C>
constexpr bool isTransparent = requires { typename C::is_transparent; };
