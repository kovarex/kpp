// Kpp standard library: algorithms over ranges given as pointer pairs, which is what the
// containers' begin()/end() return.

template<typename T>
long long distance(const T* first, const T* last) { return last - first; }

template<typename T, typename V>
T* find(T* first, T* last, const V& value)
{
  for (; first != last; ++first)
    if (*first == value)
      return first;
  return last;
}

template<typename T, typename F>
T* findIf(T* first, T* last, F predicate)
{
  for (; first != last; ++first)
    if (predicate(*first))
      return first;
  return last;
}

template<typename T, typename V>
long long count(const T* first, const T* last, const V& value)
{
  long long n = 0;
  for (; first != last; ++first)
    if (*first == value)
      ++n;
  return n;
}

template<typename T, typename F>
long long countIf(const T* first, const T* last, F predicate)
{
  long long n = 0;
  for (; first != last; ++first)
    if (predicate(*first))
      ++n;
  return n;
}

template<typename T, typename F>
bool allOf(const T* first, const T* last, F predicate)
{
  for (; first != last; ++first)
    if (!predicate(*first))
      return false;
  return true;
}

template<typename T, typename F>
bool anyOf(const T* first, const T* last, F predicate)
{
  for (; first != last; ++first)
    if (predicate(*first))
      return true;
  return false;
}

template<typename T, typename F>
bool noneOf(const T* first, const T* last, F predicate) { return !anyOf(first, last, predicate); }

// Writes f(x) for every x of [first, last) to out; returns one past the last written.
template<typename T, typename U, typename F>
U* transform(const T* first, const T* last, U* out, F f)
{
  for (; first != last; ++first, ++out)
    *out = f(*first);
  return out;
}

template<typename T, typename V>
void fill(T* first, T* last, const V& value)
{
  for (; first != last; ++first)
    *first = value;
}

template<typename T>
void reverse(T* first, T* last)
{
  while (first < last)
  {
    --last;
    swap(*first, *last);
    ++first;
  }
}

template<typename T>
T* maxElement(T* first, T* last)
{
  T* best = first;
  for (; first != last; ++first)
    if (*best < *first)
      best = first;
  return best;
}

template<typename T>
T* minElement(T* first, T* last)
{
  T* best = first;
  for (; first != last; ++first)
    if (*first < *best)
      best = first;
  return best;
}

// Moves the elements equal to value to the end; returns the new end of the kept ones.
template<typename T, typename V>
T* remove(T* first, T* last, const V& value)
{
  T* out = first;
  for (; first != last; ++first)
    if (!(*first == value))
    {
      if (out != first)
        *out = move(*first);
      ++out;
    }
  return out;
}

// The largest and the smallest of a brace list: `max({a, b, c})`.
template<typename T>
T max(InitializerList<T> values)
{
  T best = values[0];
  for (int i = 1; i < values.size(); ++i)
    if (best < values[i])
      best = values[i];
  return best;
}
template<typename T>
T min(InitializerList<T> values)
{
  T best = values[0];
  for (int i = 1; i < values.size(); ++i)
    if (values[i] < best)
      best = values[i];
  return best;
}

// Moves the elements that satisfy predicate to the end; returns the new end of the kept ones.
template<typename T, typename F>
T* removeIf(T* first, T* last, F predicate)
{
  T* out = first;
  for (; first != last; ++first)
    if (!predicate(*first))
    {
      if (out != first)
        *out = move(*first);
      ++out;
    }
  return out;
}

template<typename T, typename V>
T* lowerBound(T* first, T* last, const V& value)
{
  while (first < last)
  {
    T* middle = first + (last - first) / 2;
    if (*middle < value)
      first = middle + 1;
    else
      last = middle;
  }
  return first;
}
template<typename T, typename V, typename Less>
T* lowerBound(T* first, T* last, const V& value, Less less)
{
  while (first < last)
  {
    T* middle = first + (last - first) / 2;
    if (less(*middle, value))
      first = middle + 1;
    else
      last = middle;
  }
  return first;
}

template<typename T, typename V>
T* upperBound(T* first, T* last, const V& value)
{
  while (first < last)
  {
    T* middle = first + (last - first) / 2;
    if (value < *middle)
      last = middle;
    else
      first = middle + 1;
  }
  return first;
}

// Sorting. sort is introsort, as in the C++ libraries: quicksort around the median of three,
// heapsort when the recursion gets deeper than 2 log n (so O(n log n) in the worst case),
// insertion sort over the short ranges quicksort leaves. Not stable; stableSort is.
template<typename T, typename F>
void sort(T* first, T* last, F less)
{
  long long count = last - first;
  if (count < 2)
    return;
  int depthLimit = 0;
  for (long long k = count; k > 1; k >>= 1)
    depthLimit += 2;
  introSortLoop(first, last, depthLimit, less);
  insertionSort(first, last, less);
}

// Sorts [first, last) by operator<.
template<typename T>
void sort(T* first, T* last)
{
  sort(first, last, [](const T& a, const T& b) { return a < b; });
}

// Quicksorts until every range is at most 16 elements long, each element already in its range.
template<typename T, typename F>
void introSortLoop(T* first, T* last, int depthLimit, F& less)
{
  while (last - first > 16)
  {
    if (depthLimit == 0)
    {
      heapSort(first, last, less);
      return;
    }
    --depthLimit;
    moveMedianToFirst(first, first + 1, first + (last - first) / 2, last - 1, less);
    T* cut = partitionAroundFirst(first, last, less);
    introSortLoop(cut, last, depthLimit, less);
    last = cut;
  }
}

// Swaps the median of *a, *b and *c into *result.
template<typename T, typename F>
void moveMedianToFirst(T* result, T* a, T* b, T* c, F& less)
{
  if (less(*a, *b))
  {
    if (less(*b, *c))
      swap(*result, *b);
    else if (less(*a, *c))
      swap(*result, *c);
    else
      swap(*result, *a);
  }
  else if (less(*a, *c))
    swap(*result, *a);
  else if (less(*b, *c))
    swap(*result, *c);
  else
    swap(*result, *b);
}

// Partitions (first, last) around the pivot *first: returns cut with nothing in [first + 1, cut)
// greater than the pivot and nothing in [cut, last) less. The median of three guarantees an
// element on each side that stops the scans, so they need no bounds checks.
template<typename T, typename F>
T* partitionAroundFirst(T* first, T* last, F& less)
{
  T* left = first + 1;
  T* right = last;
  while (true)
  {
    while (less(*left, *first))
      ++left;
    --right;
    while (less(*first, *right))
      --right;
    if (!(left < right))
      return left;
    swap(*left, *right);
    ++left;
  }
}

template<typename T, typename F>
void insertionSort(T* first, T* last, F& less)
{
  for (T* next = first + 1; next < last; ++next)
  {
    if (!less(*next, *(next - 1)))
      continue;
    T value = move(*next);
    T* hole = next;
    do
    {
      *hole = move(*(hole - 1));
      --hole;
    } while (hole > first && less(value, *(hole - 1)));
    *hole = move(value);
  }
}

template<typename T, typename F>
void heapSort(T* first, T* last, F& less)
{
  long long count = last - first;
  for (long long i = count / 2; i-- > 0;)
    heapSiftDown(first, i, count, less);
  for (long long end = count - 1; end > 0; --end)
  {
    swap(first[0], first[end]);
    heapSiftDown(first, 0, end, less);
  }
}

// Restores the max-heap property below hole in the heap first[0, count).
template<typename T, typename F>
void heapSiftDown(T* first, long long hole, long long count, F& less)
{
  T value = move(first[hole]);
  while (true)
  {
    long long child = 2 * hole + 1;
    if (child >= count)
      break;
    if (child + 1 < count && less(first[child], first[child + 1]))
      ++child;
    if (!less(value, first[child]))
      break;
    first[hole] = move(first[child]);
    hole = child;
  }
  first[hole] = move(value);
}

// Sorts keeping equal elements in their order: insertion-sorted runs of 32, then merged in
// passes between the range and a buffer. The merges relocate elements bitwise, which every Kpp
// type allows, so no constructor runs while they move.
template<typename T, typename F>
void stableSort(T* first, T* last, F less)
{
  long long count = last - first;
  const long long run = 32;
  for (long long start = 0; start < count; start += run)
    insertionSort(first + start, first + (start + run < count ? start + run : count), less);
  if (count <= run)
    return;
  T* buffer = (T*)malloc((size_t)count * sizeof(T));
  T* from = first;
  T* to = buffer;
  for (long long width = run; width < count; width *= 2)
  {
    for (long long start = 0; start < count; start += 2 * width)
    {
      long long middle = start + width < count ? start + width : count;
      long long end = start + 2 * width < count ? start + 2 * width : count;
      mergeRelocating(from + start, from + middle, from + end, to + start, less);
    }
    T* swapped = from;
    from = to;
    to = swapped;
  }
  if (from != first)
    memcpy(first, from, (size_t)count * sizeof(T));
  free(buffer);
}

template<typename T>
void stableSort(T* first, T* last)
{
  stableSort(first, last, [](const T& a, const T& b) { return a < b; });
}

// Merges the sorted [a, middle) and [middle, end) into out, bitwise; on ties the first run's
// element goes first.
template<typename T, typename F>
void mergeRelocating(T* a, T* middle, T* end, T* out, F& less)
{
  T* b = middle;
  while (a < middle && b < end)
  {
    if (less(*b, *a))
      memcpy(out++, b++, sizeof(T));
    else
      memcpy(out++, a++, sizeof(T));
  }
  if (a < middle)
    memcpy(out, a, (size_t)(middle - a) * sizeof(T));
  else if (b < end)
    memcpy(out, b, (size_t)(end - b) * sizeof(T));
}

// A view of a contiguous range.
template<typename T>
struct Span
{
  T* items = nullptr;
  int length = 0;

  using iterator = T*;
  using value_type = T;

  Span() {}
  Span(T* items, int length) : items(items), length(length) {}
  implicit Span(Vector<T>& values) : items(values.items), length(values.length) {}

  int size() const { return this->length; }
  bool empty() const { return this->length == 0; }
  T* data() const { return this->items; }
  T& operator[](int index) const { return this->items[index]; }
  T* begin() const { return this->items; }
  T* end() const { return this->items + this->length; }
  T& front() const { return this->items[0]; }
  T& back() const { return this->items[this->length - 1]; }
  Span<T> subspan(int start, int count) const { return Span<T>(this->items + start, count); }
};

// Replaces every element equal to oldValue in [first, last) with newValue.
template<typename T, typename V>
void replace(T* first, T* last, const V& oldValue, const V& newValue)
{
  for (T* it = first; it != last; ++it)
    if (*it == oldValue)
      *it = newValue;
}

// Moves a pointer iterator n elements forward (backward for a negative n).
template<typename T>
void advance(T*& it, int n) { it += n; }

// Walks a pointer range backwards: rbegin() of a vector is its end, and *it is the element before.
template<typename T>
struct ReverseIterator
{
  T* position = nullptr; // one past the element *this yields

  ReverseIterator() {}
  explicit ReverseIterator(T* position) : position(position) {}
  template<typename U>
  implicit ReverseIterator(ReverseIterator<U> other) : position(other.position) {} // const_reverse_iterator from reverse_iterator

  T& operator*() const { return *(this->position - 1); }
  T* operator->() const { return this->position - 1; }
  T* base() const { return this->position; }
  ReverseIterator<T>& operator++()
  {
    --this->position;
    return *this;
  }
  ReverseIterator<T>& operator--()
  {
    ++this->position;
    return *this;
  }
  ReverseIterator<T> operator+(int n) const { return ReverseIterator<T>(this->position - n); }
  ReverseIterator<T> operator-(int n) const { return ReverseIterator<T>(this->position + n); }
  int operator-(ReverseIterator<T> other) const { return int(other.position - this->position); }
  bool operator==(ReverseIterator<T> other) const { return this->position == other.position; }
  bool operator!=(ReverseIterator<T> other) const { return this->position != other.position; }
};

// Comparator objects (std::less, std::greater): `Less<T>` compares two T with <, the transparent
// `Less<>` compares any two operands, so `FlatMap<K, V, Less<>>` can look a String up by a StringView.
template<typename T = void>
struct Less
{
  bool operator()(const T& a, const T& b) const { return a < b; }
};
template<>
struct Less<void>
{
  template<typename A, typename B>
  bool operator()(const A& a, const B& b) const { return a < b; }
};
template<typename T = void>
struct Greater
{
  bool operator()(const T& a, const T& b) const { return b < a; }
};
template<>
struct Greater<void>
{
  template<typename A, typename B>
  bool operator()(const A& a, const B& b) const { return b < a; }
};
