// A fixed-size set of bits (what std::bitset<N> converts to). Specified in docs/stdlib/bitset.md.
template<ContainerSize N>
class Bitset
{
public:
  // A bit of a Bitset that reads as a bool and assigns (std::bitset<N>::reference), what the
  // non-const operator[] gives.
  class reference
  {
  public:
    reference(Bitset<N>* bits, ContainerSize position) : bits(bits), position(position) {}

    reference& operator=(bool value)
    {
      this->bits->set(this->position, value);
      return *this;
    }

    reference& operator=(const reference& other)
    {
      this->bits->set(this->position, other.bits->test(other.position));
      return *this;
    }

    implicit operator bool() const { return this->bits->test(this->position); }
    bool operator~() const { return !this->bits->test(this->position); }

    reference& flip()
    {
      this->bits->flip(this->position);
      return *this;
    }

  private:
    Bitset<N>* bits;
    ContainerSize position;
  };

  bool test(ContainerSize pos) const { return (this->words[pos / 64] >> (pos % 64)) & 1; }
  bool operator[](ContainerSize pos) const { return this->test(pos); }
  reference operator[](ContainerSize pos) { return reference(this, pos); }

  Bitset<N>& set(ContainerSize pos)
  {
    this->words[pos / 64] |= 1ull << (pos % 64);
    return *this;
  }

  Bitset<N>& set(ContainerSize pos, bool value) { return value ? this->set(pos) : this->reset(pos); }

  Bitset<N>& set()
  {
    for (i32 i = 0; i < (N + 63) / 64; ++i)
      this->words[i] = ~0ull;
    return this->trim();
  }

  Bitset<N>& reset(ContainerSize pos)
  {
    this->words[pos / 64] &= ~(1ull << (pos % 64));
    return *this;
  }

  Bitset<N>& reset()
  {
    for (i32 i = 0; i < (N + 63) / 64; ++i)
      this->words[i] = 0;
    return *this;
  }

  Bitset<N>& flip(ContainerSize pos)
  {
    this->words[pos / 64] ^= 1ull << (pos % 64);
    return *this;
  }

  Bitset<N>& flip()
  {
    for (i32 i = 0; i < (N + 63) / 64; ++i)
      this->words[i] = ~this->words[i];
    return this->trim();
  }

  // The bits past N in the last word, which no operation may leave set.
  Bitset<N>& trim()
  {
    if (N % 64 != 0)
      this->words[(N + 63) / 64 - 1] &= (1ull << (N % 64)) - 1;
    return *this;
  }

  ContainerSize count() const
  {
    ContainerSize total = 0;
    for (i32 i = 0; i < (N + 63) / 64; ++i)
    {
      u64 w = this->words[i];
      while (w)
      {
        ++total;
        w &= w - 1;
      }
    }
    return total;
  }

  ContainerSize size() const { return N; }
  bool none() const { return this->count() == 0; }
  bool any() const { return !this->none(); }
  bool all() const { return this->count() == N; }

  // The bits as a number, bit 0 lowest; throws Overflow when a set bit does not fit.
  u64 to_ullong() const
  {
    for (i32 i = 1; i < (N + 63) / 64; ++i)
      if (this->words[i] != 0)
        throw OverflowError(String("Bitset::to_ullong"));
    return (N + 63) / 64 == 0 ? 0 : this->words[0];
  }

  unsigned long to_ulong() const
  {
    u64 value = this->to_ullong();
    if (value > 0xFFFFFFFFull)
      throw OverflowError(String("Bitset::to_ulong"));
    return (unsigned long)value;
  }

  // The bits as text, bit N - 1 first.
  String to_string(char zero = '0', char one = '1') const
  {
    String result;
    for (ContainerSize i = N; i-- > 0;) // bit N - 1 down to 0
      result.push_back(this->test(i) ? one : zero);
    return result;
  }

  Bitset<N> operator&(const Bitset<N>& other) const
  {
    Bitset<N> result;
    for (i32 i = 0; i < (N + 63) / 64; ++i)
      result.words[i] = this->words[i] & other.words[i];
    return result;
  }

  Bitset<N> operator|(const Bitset<N>& other) const
  {
    Bitset<N> result;
    for (i32 i = 0; i < (N + 63) / 64; ++i)
      result.words[i] = this->words[i] | other.words[i];
    return result;
  }

  Bitset<N> operator^(const Bitset<N>& other) const
  {
    Bitset<N> result;
    for (i32 i = 0; i < (N + 63) / 64; ++i)
      result.words[i] = this->words[i] ^ other.words[i];
    return result;
  }

  Bitset<N> operator~() const
  {
    Bitset<N> result = *this;
    return result.flip();
  }

  Bitset<N>& operator&=(const Bitset<N>& other) { return *this = *this & other; }
  Bitset<N>& operator|=(const Bitset<N>& other) { return *this = *this | other; }
  Bitset<N>& operator^=(const Bitset<N>& other) { return *this = *this ^ other; }

  Bitset<N> operator<<(i32 shift) const
  {
    Bitset<N> result;
    i32 wordShift = shift / 64;
    i32 bitShift = shift % 64;
    for (i32 i = i32((N + 63) / 64) - 1; i >= 0; --i)
    {
      i32 src = i - wordShift;
      if (src >= 0)
        result.words[i] = this->words[src] << bitShift;
      if (bitShift > 0 && src - 1 >= 0)
        result.words[i] |= this->words[src - 1] >> (64 - bitShift);
    }
    return result.trim();
  }

  Bitset<N> operator>>(i32 shift) const
  {
    Bitset<N> result;
    i32 wordShift = shift / 64;
    i32 bitShift = shift % 64;
    for (i32 i = 0; i < (N + 63) / 64; ++i)
    {
      i32 src = i + wordShift;
      if (src < (N + 63) / 64)
        result.words[i] = this->words[src] >> bitShift;
      if (bitShift > 0 && src + 1 < (N + 63) / 64)
        result.words[i] |= this->words[src + 1] << (64 - bitShift);
    }
    return result;
  }

  Bitset<N>& operator<<=(i32 shift) { return *this = *this << shift; }
  Bitset<N>& operator>>=(i32 shift) { return *this = *this >> shift; }

  bool operator==(const Bitset<N>& other) const
  {
    for (i32 i = 0; i < (N + 63) / 64; ++i)
      if (this->words[i] != other.words[i])
        return false;
    return true;
  }

private:
  u64 words[(N + 63) / 64] = {};
};
