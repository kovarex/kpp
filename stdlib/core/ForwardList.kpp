// kpp standard library: ForwardList<T>, a singly linked list (what std::forward_list converts
// to). Specified in docs/stdlib/list.md: each element in a node of its own, so inserting and
// erasing never move or invalidate other elements. Operations work after a position, since a node
// only knows the next one; before_begin() is the position before the first element.
struct ForwardLinks
{
  ForwardLinks* next = nullptr;
};

template<typename T>
struct ForwardNode : ForwardLinks
{
  T value;
};

template<typename T>
class ForwardIterator
{
public:
  using value_type = T;
  using difference_type = i64;
  using pointer = T*;
  using reference = T&;
  using iterator_category = ForwardIteratorTag;

  ForwardIterator() {}
  ForwardIterator(ForwardLinks* node) : node(node) {}

  T& operator*() const { return ((ForwardNode<T>*)this->node)->value; }
  T* operator->() const { return &((ForwardNode<T>*)this->node)->value; }
  bool operator==(const ForwardIterator<T>& other) const = default;
  bool operator!=(const ForwardIterator<T>& other) const { return this->node != other.node; }

  ForwardIterator<T>& operator++()
  {
    this->node = this->node->next;
    return *this;
  }

  ForwardIterator<T> operator++(i32)
  {
    ForwardIterator<T> before = *this;
    this->node = this->node->next;
    return before;
  }

private:
  template<typename F> friend class ForwardIterator;
  template<typename U> friend class ForwardList;

  ForwardLinks* node = nullptr;
};

template<typename T>
class ForwardList
{
public:
  using iterator = ForwardIterator<T>;
  using const_iterator = ForwardIterator<T>;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  ForwardList() {}

  implicit ForwardList(InitializerList<T> items) { this->insert_after(this->before_begin(), items.begin(), items.end()); }

  // count value-initialized elements, or count copies of value.
  ForwardList(ContainerSize count) { this->resize(count); }
  ForwardList(ContainerSize count, const T& value) { this->insert_after(this->before_begin(), count, value); }

  // The elements of [first, last), input iterators of any kind, in order.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  ForwardList(InputIt first, InputIt last) { this->insert_after(this->before_begin(), first, last); }

  // `= {...}`: the listed elements, replacing the contents.
  ForwardList<T>& operator=(InitializerList<T> items)
  {
    this->assign(items.begin(), items.end());
    return *this;
  }

  ForwardList(const ForwardList<T>& other) { this->insert_after(this->before_begin(), other.begin(), other.end()); }

  ForwardList(ForwardList<T>&& other) noexcept
  {
    this->beforeHead.next = other.beforeHead.next;
    other.beforeHead.next = nullptr;
  }

  ~ForwardList() { this->clear(); }

  ForwardList<T>& operator=(const ForwardList<T>& other)
  {
    if (this != &other)
      this->assign(other.begin(), other.end());
    return *this;
  }

  ForwardList<T>& operator=(ForwardList<T>&& other) noexcept
  {
    if (this != &other)
    {
      this->clear();
      this->beforeHead.next = other.beforeHead.next;
      other.beforeHead.next = nullptr;
    }
    return *this;
  }

  // Replace the contents: assigned over the elements there are, as std's, the others added or
  // erased at the back. The range must not be this list's.
  template<typename InputIt> requires (!isIntegral<InputIt>)
  void assign(InputIt first, InputIt last)
  {
    ForwardIterator<T> previous = this->before_begin();
    if constexpr (requires { *previous = *first; })
      for (; previous.node->next != nullptr && first != last; ++first)
        *++previous = *first;
    this->erase_after(previous, this->end());
    this->insert_after(previous, first, last);
  }

  void assign(ContainerSize count, const T& value)
  {
    ForwardIterator<T> previous = this->before_begin();
    for (; previous.node->next != nullptr && count > 0; --count)
      *++previous = value;
    this->erase_after(previous, this->end());
    this->insert_after(previous, count, value);
  }

  void assign(InitializerList<T> items) { this->assign(items.begin(), items.end()); }

  // The first newLength elements kept, value-initialized ones (copies of value) added after them.
  void resize(ContainerSize newLength)
  {
    ContainerSize missing = newLength;
    ForwardIterator<T> last = this->walk(missing);
    this->erase_after(last, this->end());
    for (; missing > 0; --missing)
      last = this->emplace_after(last);
  }

  void resize(ContainerSize newLength, const T& value)
  {
    ContainerSize missing = newLength;
    ForwardIterator<T> last = this->walk(missing);
    this->erase_after(last, this->end());
    this->insert_after(last, missing, value);
  }

  void swap(ForwardList<T>& other) { ::swap(this->beforeHead.next, other.beforeHead.next); }

  bool empty() const { return this->beforeHead.next == nullptr; }
  T& front() const { return ((ForwardNode<T>*)this->beforeHead.next)->value; }
  ForwardIterator<T> before_begin() const { return ForwardIterator<T>((ForwardLinks*)&this->beforeHead); }
  ForwardIterator<T> begin() const { return ForwardIterator<T>(this->beforeHead.next); }
  ForwardIterator<T> end() const { return ForwardIterator<T>(nullptr); }
  ForwardIterator<T> cbefore_begin() const { return this->before_begin(); }
  ForwardIterator<T> cbegin() const { return this->begin(); }
  ForwardIterator<T> cend() const { return this->end(); }
  // Equal with the same elements in the same order, ordered lexicographically (common.md).
  bool operator==(const ForwardList<T>& other) const { return equal(this->begin(), this->end(), other.begin(), other.end()); }
  strong_ordering operator<=>(const ForwardList<T>& other) const { return lexicographicalCompareThreeWay(this->begin(), this->end(), other.begin(), other.end()); }

  void push_front(const T& value) { this->insert_after(this->before_begin(), value); }
  void push_front(T&& value) { this->insert_after(this->before_begin(), move(value)); }
  template<typename... Args>
  T& emplace_front(Args&&... args) { return *this->emplace_after(this->before_begin(), forward<Args>(args)...); }
  void pop_front() { this->erase_after(this->before_begin()); }

  // Inserts after position; returns the new element's position.
  ForwardIterator<T> insert_after(ForwardIterator<T> position, const T& value) { return this->emplace_after(position, value); }
  ForwardIterator<T> insert_after(ForwardIterator<T> position, T&& value) { return this->emplace_after(position, move(value)); }

  // count copies of value, or the elements of [first, last) (input iterators of any kind, not this
  // list's), after position, in order; returns the last one's position, or position for none.
  ForwardIterator<T> insert_after(ForwardIterator<T> position, ContainerSize count, const T& value)
  {
    for (; count > 0; --count)
      position = this->emplace_after(position, value);
    return position;
  }

  template<typename InputIt> requires (!isIntegral<InputIt>)
  ForwardIterator<T> insert_after(ForwardIterator<T> position, InputIt first, InputIt last)
  {
    for (; first != last; ++first)
      position = this->emplace_after(position, *first);
    return position;
  }

  ForwardIterator<T> insert_after(ForwardIterator<T> position, InitializerList<T> items) { return this->insert_after(position, items.begin(), items.end()); }

  template<typename... Args>
  ForwardIterator<T> emplace_after(ForwardIterator<T> position, Args&&... args)
  {
    ForwardNode<T>* node = (ForwardNode<T>*)allocateBytes(sizeof(ForwardNode<T>));
    new (&node->value) T(forward<Args>(args)...);
    node->next = position.node->next;
    position.node->next = node;
    return ForwardIterator<T>(node);
  }

  // Removes the element after position; returns the position after the removed one.
  ForwardIterator<T> erase_after(ForwardIterator<T> position)
  {
    ForwardLinks* removed = position.node->next;
    position.node->next = removed->next;
    this->destroyNode(removed);
    return ForwardIterator<T>(position.node->next);
  }

  // Removes the elements strictly between first and last; returns last.
  ForwardIterator<T> erase_after(ForwardIterator<T> first, ForwardIterator<T> last)
  {
    while (first.node->next != last.node)
      this->erase_after(first);
    return last;
  }

  // Removes every element equal to value; returns how many.
  ContainerSize remove(const T& value)
  {
    // value may be an element of this list: the equal nodes move to another list first, and are
    // destroyed only when it goes, after the last comparison (as std's, which copies nothing).
    ForwardList<T> removed;
    ForwardLinks* removedLast = &removed.beforeHead;
    ContainerSize count = 0;
    ForwardLinks* previous = &this->beforeHead;
    while (previous->next)
      if (ForwardList<T>::valueOf(previous->next) == value)
      {
        ForwardLinks* moved = previous->next;
        previous->next = moved->next;
        moved->next = nullptr;
        removedLast->next = moved;
        removedLast = moved;
        ++count;
      }
      else
        previous = previous->next;
    return count;
  }

  // Removes every element for which predicate is true (std's remove_if); returns how many.
  template<typename F>
  ContainerSize removeIf(F predicate)
  {
    ContainerSize removed = 0;
    ForwardIterator<T> previous = this->before_begin();
    while (previous.node->next)
    {
      if (predicate(((ForwardNode<T>*)previous.node->next)->value))
      {
        this->erase_after(previous);
        ++removed;
      }
      else
        ++previous;
    }
    return removed;
  }

  // Removes each element equal to (by == or same(previous, element)) the kept one before it; returns
  // how many.
  ContainerSize unique() { return this->unique(EqualTo<>()); }

  template<typename F>
  ContainerSize unique(F same)
  {
    ContainerSize removed = 0;
    ForwardLinks* kept = this->beforeHead.next;
    if (kept == nullptr)
      return 0;
    while (kept->next)
      if (same(ForwardList<T>::valueOf(kept), ForwardList<T>::valueOf(kept->next)))
      {
        this->erase_after(ForwardIterator<T>(kept));
        ++removed;
      }
      else
        kept = kept->next;
    return removed;
  }

  // Moves all of other's nodes after position, without copying (other ends up empty); O(other's
  // length), as std's.
  void splice_after(ForwardIterator<T> position, ForwardList<T>& other)
  {
    if (this != &other && !other.empty())
      this->splice_after(position, other, other.before_begin(), other.end());
  }

  void splice_after(ForwardIterator<T> position, ForwardList<T>&& other) { this->splice_after(position, other); }

  // Moves the node after it (in other, which may be this list) after position.
  void splice_after(ForwardIterator<T> position, ForwardList<T>& other, ForwardIterator<T> it)
  {
    ForwardLinks* moved = it.node->next;
    if (position.node == it.node || position.node == moved)
      return;
    it.node->next = moved->next;
    moved->next = position.node->next;
    position.node->next = moved;
  }

  void splice_after(ForwardIterator<T> position, ForwardList<T>&& other, ForwardIterator<T> it) { this->splice_after(position, other, it); }

  // Moves the nodes strictly between first and last (in other, which may be this list; position is
  // not among them) after position.
  void splice_after(ForwardIterator<T> position, ForwardList<T>& other, ForwardIterator<T> first, ForwardIterator<T> last)
  {
    if (first.node->next == last.node)
      return;
    ForwardLinks* head = first.node->next;
    ForwardLinks* tail = head;
    while (tail->next != last.node)
      tail = tail->next;
    first.node->next = last.node;
    tail->next = position.node->next;
    position.node->next = head;
  }

  void splice_after(ForwardIterator<T> position, ForwardList<T>&& other, ForwardIterator<T> first, ForwardIterator<T> last)
  {
    this->splice_after(position, other, first, last);
  }

  // Merges the sorted other into this sorted list by relinking its nodes (stable: other's elements
  // after equal ones of this list); other ends up empty.
  void merge(ForwardList<T>& other) { this->merge(other, Less<>()); }
  void merge(ForwardList<T>&& other) { this->merge(other, Less<>()); }

  template<typename F>
  void merge(ForwardList<T>&& other, F less) { this->merge(other, less); }

  template<typename F>
  void merge(ForwardList<T>& other, F less)
  {
    if (this == &other)
      return;
    ForwardLinks* previous = &this->beforeHead;
    while (other.beforeHead.next)
    {
      ForwardLinks* incoming = other.beforeHead.next;
      while (previous->next && !less(ForwardList<T>::valueOf(incoming), ForwardList<T>::valueOf(previous->next)))
        previous = previous->next;
      if (previous->next == nullptr)
      {
        previous->next = incoming;
        other.beforeHead.next = nullptr;
        return;
      }
      other.beforeHead.next = incoming->next;
      incoming->next = previous->next;
      previous->next = incoming;
      previous = incoming;
    }
  }

  // Stable sort that relinks the nodes; elements do not move (as List's).
  void sort()
  {
    this->sort([](const T& a, const T& b) { return a < b; });
  }

  template<typename F>
  void sort(F less)
  {
    Vector<ForwardNode<T>*> nodes;
    for (ForwardLinks* node = this->beforeHead.next; node; node = node->next)
      nodes.push_back((ForwardNode<T>*)node);
    if (nodes.size() < 2)
      return;
    stableSort(nodes.begin(), nodes.end(), [&](ForwardNode<T>* a, ForwardNode<T>* b) { return less(a->value, b->value); });
    ForwardLinks* previous = &this->beforeHead;
    for (ForwardNode<T>* node : nodes)
    {
      previous->next = node;
      previous = node;
    }
    previous->next = nullptr;
  }

  void reverse()
  {
    ForwardLinks* reversed = nullptr;
    ForwardLinks* node = this->beforeHead.next;
    while (node)
    {
      ForwardLinks* next = node->next;
      node->next = reversed;
      reversed = node;
      node = next;
    }
    this->beforeHead.next = reversed;
  }

  void clear()
  {
    while (this->beforeHead.next)
      this->erase_after(this->before_begin());
  }

private:
  void destroyNode(ForwardLinks* node)
  {
    ((ForwardNode<T>*)node)->value.~T();
    free(node);
  }

  static T& valueOf(ForwardLinks* node) { return ((ForwardNode<T>*)node)->value; }

  // The position count elements in (before_begin() for 0), or the last element's when there are
  // fewer; count is left with how many were missing.
  ForwardIterator<T> walk(ContainerSize& count) const
  {
    ForwardIterator<T> position = this->before_begin();
    for (; count > 0 && position.node->next != nullptr; --count)
      ++position;
    return position;
  }

  ForwardLinks beforeHead; // its next is the first node; end() is null
};
