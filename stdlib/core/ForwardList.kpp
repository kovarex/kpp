// kpp standard library: ForwardList<T>, a singly linked list (what std::forward_list converts
// to). Specified in docs/stdlib/list.md: each element in a node of its own, so inserting and
// erasing never move or invalidate other elements. Operations work after a position, since a node
// only knows the next one; before_begin() is the position before the first element.
struct ForwardLinks
{
  ForwardLinks* next = nullptr;
};

template<typename T>
struct ForwardNode : ForwardLinks
{
  T value;
};

template<typename T>
struct ForwardIterator
{
  using value_type = T;
  using difference_type = i64;
  using pointer = T*;
  using reference = T&;
  using iterator_category = ForwardIteratorTag;

  ForwardLinks* node = nullptr;

  ForwardIterator() {}
  explicit ForwardIterator(ForwardLinks* node) : node(node) {}

  T& operator*() const { return ((ForwardNode<T>*)this->node)->value; }
  T* operator->() const { return &((ForwardNode<T>*)this->node)->value; }
  bool operator==(const ForwardIterator<T>& other) const { return this->node == other.node; }
  bool operator!=(const ForwardIterator<T>& other) const { return this->node != other.node; }
  ForwardIterator<T>& operator++()
  {
    this->node = this->node->next;
    return *this;
  }
  ForwardIterator<T> operator++(i32)
  {
    ForwardIterator<T> before = *this;
    this->node = this->node->next;
    return before;
  }
};

template<typename T>
class ForwardList
{
public:
  using iterator = ForwardIterator<T>;
  using const_iterator = ForwardIterator<T>;
  using value_type = T;
  using size_type = ContainerSize;
  using difference_type = i64;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  ForwardList() {}
  implicit ForwardList(InitializerList<T> items)
  {
    ForwardIterator<T> last = this->before_begin();
    for (const T& item : items)
      last = this->insert_after(last, item);
  }
  // `= {...}`: the listed elements, replacing the contents.
  ForwardList<T>& operator=(InitializerList<T> items)
  {
    this->clear();
    ForwardIterator<T> last = this->before_begin();
    for (const T& item : items)
      last = this->insert_after(last, item);
    return *this;
  }
  ForwardList(const ForwardList<T>& other) { this->copyFrom(other); }
  ForwardList(ForwardList<T>&& other) noexcept
  {
    this->beforeHead.next = other.beforeHead.next;
    other.beforeHead.next = nullptr;
  }
  ~ForwardList() { this->clear(); }
  ForwardList<T>& operator=(const ForwardList<T>& other)
  {
    if (this != &other)
    {
      this->clear();
      this->copyFrom(other);
    }
    return *this;
  }
  ForwardList<T>& operator=(ForwardList<T>&& other) noexcept
  {
    if (this != &other)
    {
      this->clear();
      this->beforeHead.next = other.beforeHead.next;
      other.beforeHead.next = nullptr;
    }
    return *this;
  }

  bool empty() const { return this->beforeHead.next == nullptr; }
  T& front() const { return ((ForwardNode<T>*)this->beforeHead.next)->value; }
  ForwardIterator<T> before_begin() const { return ForwardIterator<T>((ForwardLinks*)&this->beforeHead); }
  ForwardIterator<T> begin() const { return ForwardIterator<T>(this->beforeHead.next); }
  ForwardIterator<T> end() const { return ForwardIterator<T>(nullptr); }
  ForwardIterator<T> cbegin() const { return this->begin(); }
  ForwardIterator<T> cend() const { return this->end(); }
  // Equal with the same elements in the same order, ordered lexicographically (common.md).
  bool operator==(const ForwardList<T>& other) const { return equal(this->begin(), this->end(), other.begin(), other.end()); }
  strong_ordering operator<=>(const ForwardList<T>& other) const { return lexicographicalCompareThreeWay(this->begin(), this->end(), other.begin(), other.end()); }

  void push_front(const T& value) { this->insert_after(this->before_begin(), value); }
  void push_front(T&& value) { this->insert_after(this->before_begin(), move(value)); }
  template<typename... Args>
  T& emplace_front(Args&&... args) { return *this->emplace_after(this->before_begin(), forward<Args>(args)...); }
  void pop_front() { this->erase_after(this->before_begin()); }

  // Inserts after position; returns the new element's position.
  ForwardIterator<T> insert_after(ForwardIterator<T> position, const T& value) { return this->emplace_after(position, value); }
  ForwardIterator<T> insert_after(ForwardIterator<T> position, T&& value) { return this->emplace_after(position, move(value)); }
  template<typename... Args>
  ForwardIterator<T> emplace_after(ForwardIterator<T> position, Args&&... args)
  {
    ForwardNode<T>* node = (ForwardNode<T>*)allocateBytes(sizeof(ForwardNode<T>));
    new (&node->value) T(forward<Args>(args)...);
    node->next = position.node->next;
    position.node->next = node;
    return ForwardIterator<T>(node);
  }
  // Removes the element after position; returns the position after the removed one.
  ForwardIterator<T> erase_after(ForwardIterator<T> position)
  {
    ForwardLinks* removed = position.node->next;
    position.node->next = removed->next;
    this->destroyNode(removed);
    return ForwardIterator<T>(position.node->next);
  }
  // Removes the elements strictly between first and last; returns last.
  ForwardIterator<T> erase_after(ForwardIterator<T> first, ForwardIterator<T> last)
  {
    while (first.node->next != last.node)
      this->erase_after(first);
    return last;
  }

  // Removes every element equal to value; returns how many.
  ContainerSize remove(const T& value)
  {
    T copy(value); // value may be an element
    ContainerSize removed = 0;
    ForwardIterator<T> previous = this->before_begin();
    while (previous.node->next)
    {
      if (((ForwardNode<T>*)previous.node->next)->value == copy)
      {
        this->erase_after(previous);
        ++removed;
      }
      else
        ++previous;
    }
    return removed;
  }
  void reverse()
  {
    ForwardLinks* reversed = nullptr;
    ForwardLinks* node = this->beforeHead.next;
    while (node)
    {
      ForwardLinks* next = node->next;
      node->next = reversed;
      reversed = node;
      node = next;
    }
    this->beforeHead.next = reversed;
  }
  void clear()
  {
    while (this->beforeHead.next)
      this->erase_after(this->before_begin());
  }

private:
  void destroyNode(ForwardLinks* node)
  {
    ((ForwardNode<T>*)node)->value.~T();
    free(node);
  }
  void copyFrom(const ForwardList<T>& other)
  {
    ForwardIterator<T> last = this->before_begin();
    for (const T& value : other)
      last = this->insert_after(last, value);
  }

  ForwardLinks beforeHead; // its next is the first node; end() is null
};
