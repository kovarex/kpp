// kpp standard library: the file system, what std::filesystem converts to (namespace filesystem,
// std's names). Paths are wide text on every target (UTF-16 as Windows keeps them, UTF-32 where
// wchar_t is 32 bits), and the system's calls are platform::'s (stdlib/platform): the Win32
// wide-character API on Windows, POSIX's elsewhere, with the path in UTF-8. Specified in
// docs/stdlib/filesystem.md.

namespace filesystem
{
  // UTF-8 to the wide text and back (platform::widenUtf8, narrowWide); an invalid sequence becomes
  // U+FFFD.
  WString widenUtf8(const char* text, i32 length) { return platform::widenUtf8(text, length); }
  String narrowUtf16(const wchar_t* text, i32 length) { return platform::narrowWide(text, length); }

  // --- path ---

  class pathIterator;

  // A path (std::filesystem::path): wide text in the target's form. On Windows `\` and `/` are both
  // separators and a root name is a drive `C:` or a server `\\name`; elsewhere `/` is the one
  // separator (a `\` is part of a name) and there is no root name.
  class path
  {
  public:
    using value_type = wchar_t;
    using string_type = WString;
    using iterator = pathIterator;
    using const_iterator = pathIterator;
    static const wchar_t preferred_separator = config::platform == Platform::Windows ? L'\\' : L'/';

    path() {}
    implicit path(const WString& source) : text(source) {}
    implicit path(WString&& source) : text(move(source)) {}
    implicit path(const wchar_t* source) : text(source) {}
    path(const wchar_t* first, const wchar_t* last) : text(first, last) {}
    // From UTF-8 (where C++ on Windows reads a narrow string in the ANSI code page).
    implicit path(const String& source) : text(widenUtf8(source.data(), source.size())) {}
    implicit path(const char* source) : text(widenUtf8(source, checkedSize(strlen(source), "string too long"))) {}
    implicit path(StringView source) : text(widenUtf8(source.data(), source.size())) {}
    path(const char* first, const char* last) : text(widenUtf8(first, checkedSize(last - first, "string too long"))) {}

    path& operator=(const WString& source)
    {
      this->text = source;
      return *this;
    }
    path& operator=(const wchar_t* source)
    {
      this->text = WString(source);
      return *this;
    }
    path& operator=(const String& source)
    {
      this->text = widenUtf8(source.data(), source.size());
      return *this;
    }
    path& operator=(const char* source)
    {
      this->text = widenUtf8(source, checkedSize(strlen(source), "string too long"));
      return *this;
    }
    path& assign(const path& source)
    {
      this->text = source.text;
      return *this;
    }

    static bool isSeparator(wchar_t c) { return c == L'/' || (config::platform == Platform::Windows && c == L'\\'); }

    // The parts, as offsets into the text: the root name ends at rootNameEnd (a drive `C:` or a
    // server `\\name`, on Windows), the root directory is the one separator after it, and the
    // relative path starts after every separator there.
    ContainerSize rootNameEnd() const
    {
      if constexpr (config::platform != Platform::Windows)
        return 0;
      const WString& t = this->text;
      ContainerSize n = t.size();
      if (n >= 2 && t[1] == L':' && ((t[0] >= L'A' && t[0] <= L'Z') || (t[0] >= L'a' && t[0] <= L'z')))
        return 2;
      if (n >= 3 && path::isSeparator(t[0]) && path::isSeparator(t[1]) && !path::isSeparator(t[2]))
      {
        ContainerSize i = 3;
        while (i < n && !path::isSeparator(t[i]))
          ++i;
        return i;
      }
      return 0;
    }
    ContainerSize rootDirectoryEnd() const
    {
      ContainerSize i = this->rootNameEnd();
      return i < this->text.size() && path::isSeparator(this->text[i]) ? i + 1 : i;
    }
    ContainerSize relativeStart() const
    {
      ContainerSize i = this->rootNameEnd();
      while (i < this->text.size() && path::isSeparator(this->text[i]))
        ++i;
      return i;
    }
    ContainerSize filenameStart() const
    {
      ContainerSize start = this->relativeStart();
      ContainerSize i = this->text.size();
      while (i > start && !path::isSeparator(this->text[i - 1]))
        --i;
      return i;
    }

    // Appending with a separator (std's operator/=): an absolute p, or one with another root
    // name, replaces this path; one with a root directory keeps only this root name; otherwise
    // p follows a separator (none after a root name alone or a trailing separator).
    path& operator/=(const path& p)
    {
      ContainerSize otherRootName = p.rootNameEnd();
      if (p.is_absolute() || (otherRootName > 0 && p.root_name().text != this->root_name().text))
      {
        this->text = p.text;
        return *this;
      }
      if (p.has_root_directory())
      {
        this->text = this->text.substr(0, this->rootNameEnd()) + p.text.substr(otherRootName);
        return *this;
      }
      if (this->has_filename() || (!this->has_root_directory() && this->is_absolute()))
        this->text.push_back(path::preferred_separator);
      this->text.append(p.text.c_str() + otherRootName, p.text.size() - otherRootName);
      return *this;
    }
    path& append(const path& p) { return *this /= p; }
    // Concatenation without a separator.
    path& operator+=(const path& p)
    {
      this->text.append(p.text);
      return *this;
    }
    path& operator+=(const WString& s)
    {
      this->text.append(s);
      return *this;
    }
    path& operator+=(const wchar_t* s)
    {
      this->text.append(s);
      return *this;
    }
    path& operator+=(wchar_t c)
    {
      this->text.push_back(c);
      return *this;
    }
    path& operator+=(const String& s)
    {
      this->text.append(widenUtf8(s.data(), s.size()));
      return *this;
    }
    path& operator+=(const char* s)
    {
      this->text.append(widenUtf8(s, checkedSize(strlen(s), "string too long")));
      return *this;
    }
    path& concat(const path& p) { return *this += p; }

    void clear() { this->text.clear(); }
    // `/` as `\` on Windows; nothing elsewhere, where `/` is the one separator.
    path& make_preferred()
    {
      if constexpr (config::platform == Platform::Windows)
        for (wchar_t& c : this->text)
          if (c == L'/')
            c = L'\\';
      return *this;
    }
    path& remove_filename()
    {
      this->text.resize(this->filenameStart());
      return *this;
    }
    path& replace_filename(const path& replacement)
    {
      this->remove_filename();
      return *this /= replacement;
    }
    path& replace_extension(const path& replacement)
    {
      this->text.resize(this->text.size() - this->extension().text.size());
      if (!replacement.text.empty())
      {
        if (replacement.text[0] != L'.')
          this->text.push_back(L'.');
        this->text.append(replacement.text);
      }
      return *this;
    }
    path& replace_extension() { return this->replace_extension(path()); }
    void swap(path& other) { ::swap(this->text, other.text); }

    const WString& native() const { return this->text; }
    const wchar_t* c_str() const { return this->text.c_str(); }
    // The native string, implicitly (std::filesystem::path's operator string_type): Logger's
    // `widen(directory / "factorio-dump-current.dmp")` takes it as a WString.
    implicit operator WString() const { return this->text; }
    // The text as UTF-8 (string, u8string) or UTF-16 (wstring); the generic forms with `/`.
    String string() const { return narrowUtf16(this->text.c_str(), this->text.size()); }
    WString wstring() const { return this->text; }
    String u8string() const { return this->string(); }
    WString generic_wstring() const
    {
      WString generic = this->text;
      if constexpr (config::platform == Platform::Windows)
        for (wchar_t& c : generic)
          if (c == L'\\')
            c = L'/';
      return generic;
    }
    String generic_string() const
    {
      WString generic = this->generic_wstring();
      return narrowUtf16(generic.c_str(), generic.size());
    }
    String generic_u8string() const { return this->generic_string(); }

    // Element by element: the root names as text, then a root directory before none, then the
    // relative parts' elements as text.
    i32 compare(const path& other) const;
    i32 compare(const WString& other) const { return this->compare(path(other)); }
    i32 compare(const wchar_t* other) const { return this->compare(path(other)); }

    path root_name() const { return path(this->text.substr(0, this->rootNameEnd())); }
    path root_directory() const
    {
      ContainerSize a = this->rootNameEnd();
      return path(this->text.substr(a, this->rootDirectoryEnd() - a));
    }
    path root_path() const { return path(this->text.substr(0, this->rootDirectoryEnd())); }
    path relative_path() const { return path(this->text.substr(this->relativeStart())); }
    // The path without its last element (itself when it has no relative path), trailing
    // separators before that element removed.
    path parent_path() const
    {
      ContainerSize start = this->relativeStart();
      if (start == this->text.size())
        return *this;
      ContainerSize end = this->filenameStart();
      while (end > start && path::isSeparator(this->text[end - 1]))
        --end;
      if (end == start)
        return this->root_path();
      return path(this->text.substr(0, end));
    }
    path filename() const { return path(this->text.substr(this->filenameStart())); }
    // The filename without its extension; the extension is from its last `.`, unless that is its
    // first character or the filename is `.` or `..`.
    path stem() const
    {
      WString name = this->text.substr(this->filenameStart());
      ContainerSize dot = path::extensionDot(name);
      return path(dot == WString::npos ? name : name.substr(0, dot));
    }
    path extension() const
    {
      WString name = this->text.substr(this->filenameStart());
      ContainerSize dot = path::extensionDot(name);
      return path(dot == WString::npos ? WString() : name.substr(dot));
    }
    static ContainerSize extensionDot(const WString& name)
    {
      if (name == L"." || name == L"..")
        return WString::npos;
      ContainerSize dot = name.rfind(L'.');
      return dot == 0 ? WString::npos : dot; // (rfind's npos stays npos)
    }

    bool empty() const { return this->text.empty(); }
    bool has_root_name() const { return this->rootNameEnd() > 0; }
    bool has_root_directory() const { return this->rootDirectoryEnd() > this->rootNameEnd(); }
    bool has_root_path() const { return this->rootDirectoryEnd() > 0; }
    bool has_relative_path() const { return this->relativeStart() < this->text.size(); }
    bool has_parent_path() const { return !this->parent_path().empty(); }
    bool has_filename() const { return this->filenameStart() < this->text.size(); }
    bool has_stem() const { return !this->stem().empty(); }
    bool has_extension() const { return !this->extension().empty(); }
    // Absolute on Windows: a root name and a root directory (`C:\x`, `\\server\share`); elsewhere a
    // root directory (`/x`).
    bool is_absolute() const { return (config::platform != Platform::Windows || this->has_root_name()) && this->has_root_directory(); }
    bool is_relative() const { return !this->is_absolute(); }

    path lexically_normal() const;
    path lexically_relative(const path& base) const;
    path lexically_proximate(const path& base) const
    {
      path relative = this->lexically_relative(base);
      return relative.empty() ? *this : relative;
    }

    pathIterator begin() const;
    pathIterator end() const;

  private:
    friend class pathIterator; // reads text

    WString text;
  };

  // Comparisons by compare(), free so that a String or a `const char*` converts on either side
  // (`name == directory` with a String name).
  bool operator==(const path& left, const path& right) { return left.compare(right) == 0; }
  bool operator!=(const path& left, const path& right) { return left.compare(right) != 0; }
  bool operator<(const path& left, const path& right) { return left.compare(right) < 0; }
  bool operator<=(const path& left, const path& right) { return left.compare(right) <= 0; }
  bool operator>(const path& left, const path& right) { return left.compare(right) > 0; }
  bool operator>=(const path& left, const path& right) { return left.compare(right) >= 0; }

  path operator/(const path& left, const path& right)
  {
    path result = left;
    result /= right;
    return result;
  }

  // The elements of a path, front to back: its root name, its root directory, each filename of
  // its relative part, and an empty element when it ends with a separator after a filename.
  // Dereferencing gives the element as a path (std::filesystem::path::iterator).
  class pathIterator
  {
  public:
    using value_type = path;
    using difference_type = i64;
    using pointer = const path*;
    using reference = const path&;
    using iterator_category = BidirectionalIteratorTag;

    pathIterator() {}
    pathIterator(const path* owner, ContainerSize position, ContainerSize length) : owner(owner), position(position), length(length)
    {
      if (owner && position <= owner->text.size())
        this->element = path(owner->text.substr(position, length));
    }

    // The element after the one at [position, position + length).
    static pathIterator after(const path* owner, ContainerSize position, ContainerSize length)
    {
      const WString& t = owner->text;
      ContainerSize n = t.size();
      ContainerSize rootName = owner->rootNameEnd();
      ContainerSize rootDirectory = owner->rootDirectoryEnd();
      if (position >= n)
        return pathIterator(owner, n + 1, 0);
      if (position == 0 && length == rootName && rootName > 0)
      {
        if (rootDirectory > rootName)
          return pathIterator(owner, rootName, 1);
        return pathIterator::filenameAt(owner, rootName);
      }
      if (position == rootName && rootDirectory > rootName && length == 1)
        return pathIterator::filenameAt(owner, owner->relativeStart());
      ContainerSize i = position + length;
      ContainerSize separators = i;
      while (i < n && path::isSeparator(t[i]))
        ++i;
      if (i == n)
        return separators < n ? pathIterator(owner, n, 0) : pathIterator(owner, n + 1, 0);
      return pathIterator::filenameAt(owner, i);
    }
    static pathIterator filenameAt(const path* owner, ContainerSize start)
    {
      const WString& t = owner->text;
      if (start >= t.size())
        return pathIterator(owner, t.size() + 1, 0);
      ContainerSize end = start;
      while (end < t.size() && !path::isSeparator(t[end]))
        ++end;
      return pathIterator(owner, start, end - start);
    }
    static pathIterator first(const path* owner)
    {
      if (owner->text.empty())
        return pathIterator(owner, 1, 0);
      ContainerSize rootName = owner->rootNameEnd();
      if (rootName > 0)
        return pathIterator(owner, 0, rootName);
      if (owner->rootDirectoryEnd() > 0)
        return pathIterator(owner, 0, 1);
      return pathIterator::filenameAt(owner, owner->relativeStart());
    }

    const path& operator*() const { return this->element; }
    const path* operator->() const { return &this->element; }
    pathIterator& operator++()
    {
      *this = pathIterator::after(this->owner, this->position, this->length);
      return *this;
    }
    pathIterator operator++(i32)
    {
      pathIterator before = *this;
      ++*this;
      return before;
    }
    // The element before: found from the front.
    pathIterator& operator--()
    {
      pathIterator previous = pathIterator::first(this->owner);
      for (pathIterator next = previous; next.position != this->position; next = pathIterator::after(this->owner, next.position, next.length))
        previous = next;
      *this = previous;
      return *this;
    }
    pathIterator operator--(i32)
    {
      pathIterator before = *this;
      --*this;
      return before;
    }
    bool operator==(const pathIterator& other) const { return this->owner == other.owner && this->position == other.position; }

  private:
    const path* owner = nullptr;
    ContainerSize position = 0; // where the element starts; past the text's end for end()
    ContainerSize length = 0;
    path element;
  };

  pathIterator path::begin() const { return pathIterator::first(this); }
  pathIterator path::end() const { return pathIterator(this, this->text.size() + 1, 0); }

  i32 path::compare(const path& other) const
  {
    i32 names = this->root_name().text.compare(other.root_name().text);
    if (names != 0)
      return names;
    bool directory = this->has_root_directory();
    bool otherDirectory = other.has_root_directory();
    if (directory != otherDirectory)
      return directory ? 1 : -1;
    path relative = this->relative_path();
    path otherRelative = other.relative_path();
    pathIterator a = relative.begin();
    pathIterator b = otherRelative.begin();
    pathIterator aEnd = relative.end();
    pathIterator bEnd = otherRelative.end();
    for (; a != aEnd && b != bEnd; ++a, ++b)
    {
      i32 c = a->text.compare(b->text);
      if (c != 0)
        return c;
    }
    if (a == aEnd && b == bEnd)
      return 0;
    return a == aEnd ? -1 : 1;
  }

  // std's lexically_normal: separators made `\`, `.` elements and each `name\..` pair gone, a `..`
  // right after the root directory gone, no trailing separator after a final `..`, and `.` for
  // what ends up empty.
  path path::lexically_normal() const
  {
    if (this->text.empty())
      return path();
    Vector<WString> parts;
    bool trailing = false;
    path relative = this->relative_path();
    for (const path& element : relative)
    {
      const WString& e = element.text;
      if (e.empty() || e == L".")
        trailing = true;
      else if (e == L"..")
      {
        if (!parts.empty() && parts.back() != L"..")
        {
          parts.pop_back();
          trailing = true;
        }
        else if (!this->has_root_directory())
        {
          parts.push_back(e);
          trailing = false;
        }
      }
      else
      {
        parts.push_back(e);
        trailing = false;
      }
    }
    WString result = this->root_name().text;
    for (wchar_t& c : result)
      if (c == L'/')
        c = path::preferred_separator;
    if (this->has_root_directory())
      result.push_back(path::preferred_separator);
    for (ContainerSize i = 0; i < parts.size(); ++i)
    {
      if (i > 0)
        result.push_back(path::preferred_separator);
      result.append(parts[i]);
    }
    if (trailing && !parts.empty() && parts.back() != L"..")
      result.push_back(path::preferred_separator);
    if (result.empty())
      result = L".";
    return path(result);
  }

  // std's lexically_relative: empty when the root names or absoluteness differ (or only base has a
  // root directory); otherwise `..` for each element of base after the common start (net of its
  // `.` and `..`), then the rest of this path, or `.` for none.
  path path::lexically_relative(const path& base) const
  {
    if (this->root_name().text != base.root_name().text || this->is_absolute() != base.is_absolute() ||
        (!this->has_root_directory() && base.has_root_directory()))
      return path();
    pathIterator a = this->begin();
    pathIterator aEnd = this->end();
    pathIterator b = base.begin();
    pathIterator bEnd = base.end();
    while (a != aEnd && b != bEnd && a->text == b->text)
    {
      ++a;
      ++b;
    }
    if (a == aEnd && b == bEnd)
      return path(L".");
    i32 count = 0;
    for (; b != bEnd; ++b)
    {
      if (b->text == L"..")
        --count;
      else if (!b->text.empty() && b->text != L".")
        ++count;
    }
    if (count < 0)
      return path();
    if (count == 0 && (a == aEnd || a->text.empty()))
      return path(L".");
    path result;
    for (i32 i = 0; i < count; ++i)
      result /= path(L"..");
    for (; a != aEnd; ++a)
      result /= *a;
    return result;
  }

  // --- what a file is ---

  enum class file_type
  {
    none = 0,
    not_found = -1,
    regular = 1,
    directory = 2,
    symlink = 3,
    block = 4,
    character = 5,
    fifo = 6,
    socket = 7,
    unknown = 8,
    junction = 10,
  };

  // POSIX permission bits; Windows has only the read-only attribute, which status reports as
  // 0555 (others 0777) and permissions sets when the result has no write bit.
  enum class perms : u32
  {
    none = 0,
    owner_read = 0400,
    owner_write = 0200,
    owner_exec = 0100,
    owner_all = 0700,
    group_read = 040,
    group_write = 020,
    group_exec = 010,
    group_all = 070,
    others_read = 04,
    others_write = 02,
    others_exec = 01,
    others_all = 07,
    all = 0777,
    set_uid = 04000,
    set_gid = 02000,
    sticky_bit = 01000,
    mask = 07777,
    unknown = 0xFFFF,
  };
  perms operator|(perms a, perms b) { return perms((u32)a | (u32)b); }
  perms operator&(perms a, perms b) { return perms((u32)a & (u32)b); }
  perms operator^(perms a, perms b) { return perms((u32)a ^ (u32)b); }
  perms operator~(perms a) { return perms(~(u32)a & 0xFFFF); }
  perms& operator|=(perms& a, perms b) { return a = a | b; }
  perms& operator&=(perms& a, perms b) { return a = a & b; }
  perms& operator^=(perms& a, perms b) { return a = a ^ b; }

  enum class perm_options : u32
  {
    replace = 1,
    add = 2,
    remove = 4,
    nofollow = 8,
  };
  perm_options operator|(perm_options a, perm_options b) { return perm_options((u32)a | (u32)b); }
  perm_options operator&(perm_options a, perm_options b) { return perm_options((u32)a & (u32)b); }

  enum class copy_options : u32
  {
    none = 0,
    skip_existing = 1,
    overwrite_existing = 2,
    update_existing = 4,
    recursive = 0x10,
    copy_symlinks = 0x100,
    skip_symlinks = 0x200,
    directories_only = 0x1000,
    create_symlinks = 0x2000,
    create_hard_links = 0x4000,
    inRecursiveCopy = 0x10000, // kpp: copy's own mark for the entries of a directory it copies
  };
  copy_options operator|(copy_options a, copy_options b) { return copy_options((u32)a | (u32)b); }
  copy_options operator&(copy_options a, copy_options b) { return copy_options((u32)a & (u32)b); }

  enum class directory_options : u32
  {
    none = 0,
    follow_directory_symlink = 1,
    skip_permission_denied = 2,
  };

  struct space_info
  {
    u64 capacity = 0;
    u64 free = 0;
    u64 available = 0;
  };

  class file_status
  {
  public:
    file_status() {}
    explicit file_status(file_type type, perms permissions = perms::unknown) : typeValue(type), permsValue(permissions) {}
    file_type type() const { return this->typeValue; }
    perms permissions() const { return this->permsValue; }
    void type(file_type type) { this->typeValue = type; }
    void permissions(perms permissions) { this->permsValue = permissions; }
    bool operator==(const file_status& other) const = default;

  private:
    file_type typeValue = file_type::none;
    perms permsValue = perms::unknown;
  };

  bool status_known(file_status s) { return s.type() != file_type::none; }
  bool exists(file_status s) { return status_known(s) && s.type() != file_type::not_found; }
  bool is_regular_file(file_status s) { return s.type() == file_type::regular; }
  bool is_directory(file_status s) { return s.type() == file_type::directory; }
  bool is_symlink(file_status s) { return s.type() == file_type::symlink; }
  bool is_block_file(file_status s) { return s.type() == file_type::block; }
  bool is_character_file(file_status s) { return s.type() == file_type::character; }
  bool is_fifo(file_status s) { return s.type() == file_type::fifo; }
  bool is_socket(file_status s) { return s.type() == file_type::socket; }
  bool is_other(file_status s) { return exists(s) && !is_regular_file(s) && !is_directory(s) && !is_symlink(s); }

  // --- errors ---

  // An error of an operation on paths (std::filesystem::filesystem_error): what() is the message
  // given, then the error code's, then the paths in brackets.
  class filesystem_error : public SystemError
  {
  public:
    path path1Value;
    path path2Value;

    filesystem_error(const String& what, ErrorCode code) : SystemError(code, what) {}
    filesystem_error(const String& what, const path& path1, ErrorCode code) : SystemError(code, what), path1Value(path1)
    {
      this->message = what + ": " + code.message() + " [" + path1.string() + "]";
    }
    filesystem_error(const String& what, const path& path1, const path& path2, ErrorCode code)
      : SystemError(code, what), path1Value(path1), path2Value(path2)
    {
      this->message = what + ": " + code.message() + " [" + path1.string() + "] [" + path2.string() + "]";
    }
    const path& path1() const { return this->path1Value; }
    const path& path2() const { return this->path2Value; }
  };

  // What the system says of a file (platform::fileInfo, and a directory listing's entries): its type
  // (a symlink only when links are not followed), whether it is a directory (a link to one too, on
  // Windows), its permissions, its size when sizeKnown (a regular file's), and its last write time in
  // the system's ticks (only compared).
  struct FileInfo
  {
    file_type type = file_type::none;
    bool directory = false;
    perms permissions = perms::unknown;
    u64 size = 0;
    bool sizeKnown = false;
    u64 writeTime = 0;
  };

  bool isNotFound(i32 error) { return platform::isNotFoundError(error); }

  // --- what a path names ---

  // What p names, links followed: not_found when it does not resolve (ec says why, as std's does).
  file_status status(const path& p, ErrorCode& ec)
  {
    FileInfo info;
    if (!platform::fileInfo(p, true, info, ec))
      return file_status(isNotFound(ec.value()) ? file_type::not_found : file_type::none);
    return file_status(info.type, info.permissions);
  }
  file_status status(const path& p)
  {
    ErrorCode ec;
    file_status s = status(p, ec);
    if (s.type() == file_type::none)
      throw filesystem_error(String("status"), p, ec);
    return s;
  }
  // What p itself is: a link (on Windows a reparse point, a symbolic link or a junction) is a
  // symlink.
  file_status symlink_status(const path& p, ErrorCode& ec)
  {
    FileInfo info;
    if (!platform::fileInfo(p, false, info, ec))
      return file_status(isNotFound(ec.value()) ? file_type::not_found : file_type::none);
    return file_status(info.type, info.permissions);
  }
  file_status symlink_status(const path& p)
  {
    ErrorCode ec;
    file_status s = symlink_status(p, ec);
    if (s.type() == file_type::none)
      throw filesystem_error(String("symlink_status"), p, ec);
    return s;
  }

  bool exists(const path& p, ErrorCode& ec)
  {
    file_status s = status(p, ec);
    if (status_known(s))
      ec.clear();
    return exists(s);
  }
  bool exists(const path& p) { return exists(status(p)); }
  bool is_directory(const path& p, ErrorCode& ec) { return is_directory(status(p, ec)); }
  bool is_directory(const path& p) { return is_directory(status(p)); }
  bool is_regular_file(const path& p, ErrorCode& ec) { return is_regular_file(status(p, ec)); }
  bool is_regular_file(const path& p) { return is_regular_file(status(p)); }
  bool is_symlink(const path& p, ErrorCode& ec) { return is_symlink(symlink_status(p, ec)); }
  bool is_symlink(const path& p) { return is_symlink(symlink_status(p)); }
  bool is_other(const path& p, ErrorCode& ec) { return is_other(status(p, ec)); }
  bool is_other(const path& p) { return is_other(status(p)); }

  // The size of the regular file p, links followed; an error for a directory or a missing file.
  u64 file_size(const path& p, ErrorCode& ec)
  {
    FileInfo info;
    if (!platform::fileInfo(p, true, info, ec))
      return (u64)-1;
    if (info.type == file_type::directory)
    {
      ec = make_error_code(Errc::is_a_directory);
      return (u64)-1;
    }
    return info.size;
  }
  u64 file_size(const path& p)
  {
    ErrorCode ec;
    u64 size = file_size(p, ec);
    if (ec)
      throw filesystem_error(String("file_size"), p, ec);
    return size;
  }

  // Whether a and b name the same file or directory, links followed; an error (and false) when
  // either does not resolve.
  bool equivalent(const path& a, const path& b, ErrorCode& ec)
  {
    bool same = false;
    if (!platform::sameFile(a, b, same, ec))
      return false;
    return same;
  }
  bool equivalent(const path& a, const path& b)
  {
    ErrorCode ec;
    bool same = equivalent(a, b, ec);
    if (ec)
      throw filesystem_error(String("equivalent"), a, b, ec);
    return same;
  }

  // --- directories ---

  // A directory's entry: its path, and what the listing said of it (std::filesystem::directory_entry).
  class directory_entry
  {
  public:
    directory_entry() {}
    explicit directory_entry(const filesystem::path& p) : pathValue(p) {}

    const filesystem::path& path() const { return this->pathValue; }
    implicit operator const filesystem::path&() const { return this->pathValue; }
    void assign(const filesystem::path& p)
    {
      this->pathValue = p;
      this->listed = false;
    }
    void refresh() { this->listed = false; }
    // The listing's status, links followed (a link is asked anew).
    file_status status(ErrorCode& ec) const
    {
      if (this->listed && this->info.type != file_type::symlink)
      {
        ec.clear();
        return file_status(this->info.type, this->info.permissions);
      }
      return filesystem::status(this->pathValue, ec);
    }
    file_status status() const
    {
      ErrorCode ec;
      file_status s = this->status(ec);
      if (s.type() == file_type::none)
        throw filesystem_error(String("directory_entry::status"), this->pathValue, ec);
      return s;
    }
    file_status symlink_status(ErrorCode& ec) const
    {
      if (this->listed)
      {
        ec.clear();
        return file_status(this->info.type, this->info.permissions);
      }
      return filesystem::symlink_status(this->pathValue, ec);
    }
    file_status symlink_status() const
    {
      ErrorCode ec;
      return this->symlink_status(ec);
    }
    bool exists() const { return filesystem::exists(this->status()); }
    bool is_directory() const { return filesystem::is_directory(this->status()); }
    bool is_regular_file() const { return filesystem::is_regular_file(this->status()); }
    bool is_symlink() const { return filesystem::is_symlink(this->symlink_status()); }
    u64 file_size(ErrorCode& ec) const
    {
      if (this->listed && this->info.sizeKnown)
      {
        ec.clear();
        return this->info.size;
      }
      return filesystem::file_size(this->pathValue, ec);
    }
    u64 file_size() const
    {
      ErrorCode ec;
      u64 s = this->file_size(ec);
      if (ec)
        throw filesystem_error(String("directory_entry::file_size"), this->pathValue, ec);
      return s;
    }
    bool operator==(const directory_entry& other) const { return this->pathValue == other.pathValue; }
    bool operator!=(const directory_entry& other) const { return this->pathValue != other.pathValue; }
    bool operator<(const directory_entry& other) const { return this->pathValue < other.pathValue; }

  private:
    friend class directory_iterator; // fills it in

    filesystem::path pathValue;
    FileInfo info;
    bool listed = false; // info came with the listing
  };

  // A directory listing in progress, which copies of a directory_iterator share.
  struct DirectoryListing
  {
    platform::DirectoryReader reader;
    path directory;
    directory_entry entry;

    DirectoryListing() {}
    DirectoryListing(const DirectoryListing&) = delete;
  };

  // The entries of a directory, `.` and `..` left out, in the order the file system gives them
  // (std::filesystem::directory_iterator). Copies share the position; the end iterator is the
  // default-constructed one.
  class directory_iterator
  {
  public:
    using value_type = directory_entry;
    using difference_type = i64;
    using pointer = const directory_entry*;
    using reference = const directory_entry&;
    using iterator_category = InputIteratorTag;

    directory_iterator() {}
    explicit directory_iterator(const path& p)
    {
      ErrorCode ec;
      this->open(p, ec);
      if (ec)
        throw filesystem_error(String("directory_iterator"), p, ec);
    }
    directory_iterator(const path& p, ErrorCode& ec) { this->open(p, ec); }
    directory_iterator(const path& p, directory_options options)
    {
      ErrorCode ec;
      this->open(p, ec);
      if (ec)
        throw filesystem_error(String("directory_iterator"), p, ec);
    }
    directory_iterator(const path& p, directory_options options, ErrorCode& ec) { this->open(p, ec); }

    void open(const path& p, ErrorCode& ec)
    {
      ec.clear();
      SharedPtr<DirectoryListing> state = makeShared<DirectoryListing>();
      state->directory = p;
      if (!state->reader.open(p, ec))
        return; // an error, or an empty directory (the end)
      this->listing = state;
      this->advance(ec);
    }
    // The next entry; the end when there is none (or on an error, which ec reports).
    void advance(ErrorCode& ec)
    {
      ec.clear();
      if (!this->listing)
        return;
      WString name;
      DirectoryListing& state = *this->listing;
      if (!state.reader.next(name, state.entry.info, ec))
      {
        this->listing = SharedPtr<DirectoryListing>();
        return;
      }
      state.entry.pathValue = state.directory / path(name);
      state.entry.listed = true;
    }
    directory_iterator& increment(ErrorCode& ec)
    {
      this->advance(ec);
      return *this;
    }
    directory_iterator& operator++()
    {
      ErrorCode ec;
      this->advance(ec);
      if (ec)
        throw filesystem_error(String("directory_iterator::operator++"), ec);
      return *this;
    }
    const directory_entry& operator*() const { return this->listing->entry; }
    const directory_entry* operator->() const { return &this->listing->entry; }
    bool operator==(const directory_iterator& other) const = default;
    bool operator!=(const directory_iterator& other) const { return this->listing != other.listing; }

  private:
    SharedPtr<DirectoryListing> listing;
  };
  directory_iterator begin(directory_iterator it) { return it; }
  directory_iterator end(const directory_iterator& it) { return directory_iterator(); }

  // --- paths from the system ---

  // p made absolute against the current directory (on Windows GetFullPathName, which also resolves
  // `.` and `..`; elsewhere the current directory joined with p).
  path absolute(const path& p, ErrorCode& ec)
  {
    ec.clear();
    if (p.empty())
      return path();
    return platform::absolutePath(p, ec);
  }
  path absolute(const path& p)
  {
    ErrorCode ec;
    path result = absolute(p, ec);
    if (ec)
      throw filesystem_error(String("absolute"), p, ec);
    return result;
  }

  // The absolute path of what p names with every link resolved; p must exist (on Windows the
  // system's `\\?\` prefix is removed, `\\?\UNC\` becoming `\\`).
  path canonical(const path& p, ErrorCode& ec) { return platform::canonicalPath(p, ec); }
  path canonical(const path& p)
  {
    ErrorCode ec;
    path result = canonical(p, ec);
    if (ec)
      throw filesystem_error(String("canonical"), p, ec);
    return result;
  }

  // canonical of the longest leading part of p that exists, then the rest; lexically normal.
  path weakly_canonical(const path& p, ErrorCode& ec)
  {
    ec.clear();
    path head = p.root_path();
    path tail;
    bool inTail = false;
    path relative = p.relative_path();
    for (const path& element : relative)
    {
      if (!inTail)
      {
        path candidate = head / element;
        ErrorCode probe;
        if (exists(candidate, probe))
        {
          head = candidate;
          continue;
        }
        inTail = true;
      }
      tail /= element;
    }
    path result = head;
    if (!head.empty() && head != p.root_path())
    {
      result = canonical(head, ec);
      if (ec)
        return path();
    }
    if (!tail.empty())
      result /= tail;
    return result.lexically_normal();
  }
  path weakly_canonical(const path& p)
  {
    ErrorCode ec;
    path result = weakly_canonical(p, ec);
    if (ec)
      throw filesystem_error(String("weakly_canonical"), p, ec);
    return result;
  }

  path current_path(ErrorCode& ec) { return platform::currentPath(ec); }
  path current_path()
  {
    ErrorCode ec;
    return current_path(ec);
  }
  void current_path(const path& p, ErrorCode& ec) { platform::setCurrentPath(p, ec); }
  void current_path(const path& p)
  {
    ErrorCode ec;
    current_path(p, ec);
    if (ec)
      throw filesystem_error(String("current_path"), p, ec);
  }
  // The directory for temporary files: GetTempPath's on Windows; elsewhere TMPDIR (or TMP, TEMP,
  // TEMPDIR), else /tmp.
  path temp_directory_path(ErrorCode& ec) { return platform::tempDirectoryPath(ec); }
  path temp_directory_path()
  {
    ErrorCode ec;
    return temp_directory_path(ec);
  }

  space_info space(const path& p, ErrorCode& ec)
  {
    space_info result;
    if (!platform::spaceOf(p, result, ec))
    {
      result.capacity = (u64)-1;
      result.free = (u64)-1;
      result.available = (u64)-1;
    }
    return result;
  }
  space_info space(const path& p)
  {
    ErrorCode ec;
    space_info result = space(p, ec);
    if (ec)
      throw filesystem_error(String("space"), p, ec);
    return result;
  }

  // --- changing the file system ---

  // Creates the directory p; false (and no error) when a directory is there already.
  bool create_directory(const path& p, ErrorCode& ec)
  {
    if (platform::createDirectory(p, ec))
      return true;
    ErrorCode failure = ec;
    if (platform::isAlreadyThereError(failure.value()) && is_directory(p, ec))
    {
      ec.clear();
      return false;
    }
    ec = failure;
    return false;
  }
  bool create_directory(const path& p)
  {
    ErrorCode ec;
    bool created = create_directory(p, ec);
    if (ec)
      throw filesystem_error(String("create_directory"), p, ec);
    return created;
  }
  // Creates p and every missing directory above it; true when it created any.
  bool create_directories(const path& p, ErrorCode& ec)
  {
    ec.clear();
    if (p.empty())
      return false;
    file_status s = status(p, ec);
    if (is_directory(s))
    {
      ec.clear();
      return false;
    }
    if (exists(s))
    {
      ec = make_error_code(Errc::not_a_directory);
      return false;
    }
    path parent = p.parent_path();
    if (!p.has_filename())
      return create_directories(parent, ec); // `a/b/`: b is the last directory
    if (!parent.empty() && parent != p)
    {
      create_directories(parent, ec);
      if (ec)
        return false;
    }
    return create_directory(p, ec);
  }
  bool create_directories(const path& p)
  {
    ErrorCode ec;
    bool created = create_directories(p, ec);
    if (ec)
      throw filesystem_error(String("create_directories"), p, ec);
    return created;
  }

  // Removes the file or empty directory p (a link itself); false (and no error) when there is none.
  // On Windows a read-only file is not removed (the error is access denied), as with MSVC.
  bool remove(const path& p, ErrorCode& ec)
  {
    FileInfo info;
    if (!platform::fileInfo(p, false, info, ec))
    {
      if (isNotFound(ec.value()))
        ec.clear();
      return false;
    }
    return platform::removePath(p, info.directory, ec);
  }
  bool remove(const path& p)
  {
    ErrorCode ec;
    bool removed = remove(p, ec);
    if (ec)
      throw filesystem_error(String("remove"), p, ec);
    return removed;
  }
  // Removes p and, for a directory (not a link to one), everything in it; the count removed, or
  // -1 on an error.
  u64 remove_all(const path& p, ErrorCode& ec)
  {
    file_status s = symlink_status(p, ec);
    if (s.type() == file_type::not_found)
    {
      ec.clear();
      return 0;
    }
    if (ec)
      return (u64)-1;
    u64 count = 0;
    if (s.type() == file_type::directory)
    {
      Vector<path> children;
      for (directory_iterator it(p, ec); !ec && it != directory_iterator(); it.increment(ec))
        children.push_back(it->path());
      if (ec)
        return (u64)-1;
      for (const path& child : children)
      {
        u64 removed = remove_all(child, ec);
        if (ec)
          return (u64)-1;
        count += removed;
      }
    }
    if (remove(p, ec))
      ++count;
    return ec ? (u64)-1 : count;
  }
  u64 remove_all(const path& p)
  {
    ErrorCode ec;
    u64 count = remove_all(p, ec);
    if (ec)
      throw filesystem_error(String("remove_all"), p, ec);
    return count;
  }

  // Moves from to to, replacing a file there (not across volumes, which is errc::cross_device_link).
  void rename(const path& from, const path& to, ErrorCode& ec) { platform::renamePath(from, to, ec); }
  void rename(const path& from, const path& to)
  {
    ErrorCode ec;
    rename(from, to, ec);
    if (ec)
      throw filesystem_error(String("rename"), from, to, ec);
  }

  // Copies the regular file from to to: with none, an existing to is an error (file_exists);
  // skip_existing leaves it; overwrite_existing replaces it; update_existing replaces it when from
  // is newer. True when it copied.
  bool copy_file(const path& from, const path& to, copy_options options, ErrorCode& ec)
  {
    ec.clear();
    FileInfo source;
    FileInfo target;
    if (!platform::fileInfo(from, true, source, ec))
      return false;
    if (source.type == file_type::directory)
    {
      ec = make_error_code(Errc::is_a_directory);
      return false;
    }
    ErrorCode probe;
    if (platform::fileInfo(to, true, target, probe))
    {
      if ((options & copy_options::skip_existing) != copy_options::none)
        return false;
      if ((options & copy_options::update_existing) != copy_options::none)
      {
        if (source.writeTime <= target.writeTime)
          return false;
      }
      else if ((options & copy_options::overwrite_existing) == copy_options::none)
      {
        ec = make_error_code(Errc::file_exists);
        return false;
      }
    }
    return platform::copyFileContents(from, to, ec);
  }
  bool copy_file(const path& from, const path& to, ErrorCode& ec) { return copy_file(from, to, copy_options::none, ec); }
  bool copy_file(const path& from, const path& to, copy_options options)
  {
    ErrorCode ec;
    bool copied = copy_file(from, to, options, ec);
    if (ec)
      throw filesystem_error(String("copy_file"), from, to, ec);
    return copied;
  }
  bool copy_file(const path& from, const path& to) { return copy_file(from, to, copy_options::none); }

  // std's copy: a file is copied as copy_file does (into to when to is a directory); a directory,
  // with recursive or with no options, to a directory created at to, entry by entry (its
  // subdirectories only with recursive). Links are followed.
  void copy(const path& from, const path& to, copy_options options, ErrorCode& ec)
  {
    file_status source = status(from, ec);
    if (!exists(source))
    {
      if (!ec)
        ec = make_error_code(Errc::no_such_file_or_directory);
      return;
    }
    ErrorCode probe;
    file_status target = status(to, probe);
    if (exists(target) && source.type() == target.type() && canonical(from, probe) == canonical(to, probe))
    {
      ec = make_error_code(Errc::file_exists);
      return;
    }
    ec.clear();
    bool nested = (options & copy_options::inRecursiveCopy) != copy_options::none;
    bool recursive = (options & copy_options::recursive) != copy_options::none;
    if (is_regular_file(source))
    {
      if ((options & copy_options::directories_only) != copy_options::none)
        return;
      if (is_directory(target))
        copy_file(from, to / from.filename(), options, ec);
      else
        copy_file(from, to, options, ec);
      return;
    }
    if (is_directory(source) && (recursive || (options == copy_options::none && !nested)))
    {
      if (!exists(target))
      {
        create_directory(to, ec);
        if (ec)
          return;
      }
      Vector<path> entries;
      for (directory_iterator it(from, ec); !ec && it != directory_iterator(); it.increment(ec))
        entries.push_back(it->path());
      if (ec)
        return;
      for (const path& entry : entries)
      {
        copy(entry, to / entry.filename(), options | copy_options::inRecursiveCopy, ec);
        if (ec)
          return;
      }
    }
  }
  void copy(const path& from, const path& to, ErrorCode& ec) { copy(from, to, copy_options::none, ec); }
  void copy(const path& from, const path& to, copy_options options)
  {
    ErrorCode ec;
    copy(from, to, options, ec);
    if (ec)
      throw filesystem_error(String("copy"), from, to, ec);
  }
  void copy(const path& from, const path& to) { copy(from, to, copy_options::none); }

  // Sets p's permissions (replace, add or remove the bits given). Windows keeps only whether it is
  // read-only, which it is when the result has no write bit; elsewhere chmod.
  void permissions(const path& p, perms permissions, perm_options options, ErrorCode& ec) { platform::changePermissions(p, permissions, options, ec); }
  void permissions(const path& p, perms permissions, ErrorCode& ec) { filesystem::permissions(p, permissions, perm_options::replace, ec); }
  void permissions(const path& p, perms permissions, perm_options options)
  {
    ErrorCode ec;
    filesystem::permissions(p, permissions, options, ec);
    if (ec)
      throw filesystem_error(String("permissions"), p, ec);
  }
  void permissions(const path& p, perms permissions) { filesystem::permissions(p, permissions, perm_options::replace); }

  // Whether p is an empty file or a directory without entries.
  bool is_empty(const path& p, ErrorCode& ec)
  {
    file_status s = status(p, ec);
    if (ec)
      return false;
    if (is_directory(s))
    {
      directory_iterator it(p, ec);
      return !ec && it == directory_iterator();
    }
    u64 size = file_size(p, ec);
    return !ec && size == 0;
  }
  bool is_empty(const path& p)
  {
    ErrorCode ec;
    bool empty = is_empty(p, ec);
    if (ec)
      throw filesystem_error(String("is_empty"), p, ec);
    return empty;
  }
}
