// Filesystem: maps std::filesystem types and functions for converted code.
// Actual I/O is handled through extern "C" calls; these are the type declarations.

struct Filesystem
{
  struct file_type
  {
    int value;
    static const file_type none;
    static const file_type not_found;
    static const file_type regular;
    static const file_type directory;
    static const file_type symlink;
    static const file_type junction;
    bool operator==(const file_type& other) const { return this->value == other.value; }
    bool operator!=(const file_type& other) const { return this->value != other.value; }
  };

  struct perms
  {
    unsigned int value;
    static const perms owner_write;
    static const perms others_write;
    perms operator|(const perms& other) const { return perms{this->value | other.value}; }
    perms operator&(const perms& other) const { return perms{this->value & other.value}; }
    bool operator==(const perms& other) const { return this->value == other.value; }
    bool operator!=(const perms& other) const { return this->value != other.value; }
  };

  struct perm_options
  {
    int value;
    static const perm_options add;
    static const perm_options remove;
    static const perm_options replace;
  };

  struct copy_options
  {
    int value;
    static const copy_options overwrite_existing;
  };

  struct ErrorCode
  {
    int code;
    ErrorCode() : code(0) {}
    explicit ErrorCode(int c) : code(c) {}
    String message() const;
    const char* c_str() const;
    bool operator==(const ErrorCode& other) const { return this->code == other.code; }
    bool operator!=(const ErrorCode& other) const { return this->code != other.code; }
    explicit operator bool() const { return this->code != 0; }
  };

  struct ErrorCodes
  {
    static const ErrorCode cross_device_link;
    static const ErrorCode permission_denied;
    static const ErrorCode no_such_file_or_directory;
  };

  struct file_status
  {
    file_type type() const;
    perms permissions() const;
  };

  struct Path
  {
    Path();
    Path(const char* s);
    Path(const String& s);
    Path(const Path& other);
    Path(Path&& other);
    Path& operator=(const Path& other);
    Path& operator=(Path&& other);

    String string() const;
    String wstring() const;
    String generic_string() const;
    const char* c_str() const;
    const String& native() const;
    Path filename() const;
    Path parent_path() const;
    Path extension() const;
    Path stem() const;
    Path lexically_normal() const;
    bool is_absolute() const;
    bool has_filename() const;
    bool empty() const;
    void clear();

    Path operator/(const Path& other) const;
    Path operator/(const char* other) const;
    Path operator/(const String& other) const;
    Path& operator/=(const Path& other);
    Path& operator/=(const char* other);
    Path& operator/=(const String& other);
    Path& operator+=(const Path& other);
    Path& operator+=(const char* other);
    Path& operator+=(const String& other);
    bool operator==(const Path& other) const;
    bool operator!=(const Path& other) const;
    bool operator<(const Path& other) const;

    struct iterator
    {
      bool operator==(const iterator& other) const;
      bool operator!=(const iterator& other) const;
      iterator& operator++();
      Path operator*() const;
    };

    iterator begin() const;
    iterator end() const;
  };

  using path = Path;

  struct directory_entry
  {
    Path path() const;
    file_status status() const;
    uint64_t file_size() const;
  };

  struct directory_iterator
  {
    directory_iterator();
    explicit directory_iterator(const Path& p);
    directory_iterator(const Path& p, ErrorCode& ec);
    bool operator==(const directory_iterator& other) const;
    bool operator!=(const directory_iterator& other) const;
    directory_iterator& operator++();
    const directory_entry& operator*() const;
    const directory_entry* operator->() const;
  };

  struct filesystem_error
  {
    const char* what() const;
    const Path& path1() const;
    const Path& path2() const;
  };

  struct SystemError
  {
    ErrorCode code;
    explicit SystemError(const ErrorCode& ec);
    const char* what() const;
  };

  static const Path dotDot;

  static bool exists(const Path& p);
  static bool exists(const Path& p, ErrorCode& ec);
  static bool is_directory(const Path& p);
  static bool is_directory(const file_status& s);
  static bool is_regular_file(const Path& p);
  static bool is_regular_file(const file_status& s);
  static file_status status(const Path& p);
  static file_status status(const Path& p, ErrorCode& ec);
  static file_status symlink_status(const Path& p, ErrorCode& ec);
  static Path canonical(const Path& p);
  static Path weakly_canonical(const Path& p);
  static Path absolute(const Path& p);
  static bool create_directories(const Path& p);
  static bool create_directories(const Path& p, ErrorCode& ec);
  static void copy_file(const Path& from, const Path& to, copy_options options);
  static void copy(const Path& from, const Path& to);
  static void rename(const Path& from, const Path& to, ErrorCode& ec);
  static bool remove(const Path& p, ErrorCode& ec);
  static uint64_t RemoveAll(const Path& p, ErrorCode& ec);
  static uint64_t file_size(const Path& p);
  static void permissions(const Path& p, perms prm, perm_options opts, ErrorCode& ec);
  static int64_t LastWriteTime(const Path& p);
  static Path unique_path(const String& pattern);
};
