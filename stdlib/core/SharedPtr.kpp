// Kpp standard library: SharedPtr<T> and WeakPtr<T>, shared ownership of a heap object through a
// control block of two atomic counts, and EnableSharedFromThis<T>, the base that lets an object
// owned by SharedPtrs make another one from `this`. Specified in docs/stdlib/sharedptr.md.

// The control block. strong: the SharedPtrs. weak: the WeakPtrs and an EnableSharedFromThis
// self-reference, plus one for all the SharedPtrs together, so that whichever goes last frees the
// block, on exactly one thread.
struct SharedControl
{
  Atomic<int> strong;
  Atomic<int> weak;
  void (*destroy)(void*) = nullptr; // deletes the object as the type it was created with
  void* object = nullptr;

  SharedControl() : strong(1), weak(1) {}
};

// A weak reference given back; the last one frees the block.
void sharedReleaseWeak(SharedControl* control)
{
  if (control->weak.fetchSub(1) == 1)
    delete control;
}

// A strong reference taken from a weak one, while the object lives (strong is not 0).
bool sharedTryLock(SharedControl* control)
{
  int seen = control->strong.load();
  while (seen != 0)
    if (control->strong.compareExchange(seen, seen + 1))
      return true;
  return false;
}

template<typename T>
void sharedDestroy(void* p) { delete (T*)p; }

// What EnableSharedFromThis<T> holds for any T, so that a SharedPtr of any type can set it: a
// weak reference to the control block of the first SharedPtr that takes the object.
struct EnableSharedFromThisBase
{
  mutable SharedControl* sharedSelf = nullptr;

  EnableSharedFromThisBase() {}
  // A copy is another object, which no SharedPtr owns yet.
  EnableSharedFromThisBase(const EnableSharedFromThisBase&) {}
  EnableSharedFromThisBase& operator=(const EnableSharedFromThisBase&) { return *this; }
  ~EnableSharedFromThisBase()
  {
    if (this->sharedSelf)
      sharedReleaseWeak(this->sharedSelf);
  }

  // Called by a SharedPtr that takes ownership of the object: kept unless an owner that still
  // lives set it before.
  void adoptSharedSelf(SharedControl* control) const
  {
    if (this->sharedSelf && this->sharedSelf->strong.load() != 0)
      return;
    control->weak.fetchAdd(1);
    if (this->sharedSelf)
      sharedReleaseWeak(this->sharedSelf);
    this->sharedSelf = control;
  }
};

template<typename T>
struct SharedPtr
{
  using element_type = T;

  T* pointer = nullptr;
  SharedControl* control = nullptr;

  SharedPtr() {}
  implicit SharedPtr(nullptr_t) {}
  // Takes ownership of an object made with new (makeShared does both).
  explicit SharedPtr(T* object)
  {
    if (object)
      this->own(object);
  }
  SharedPtr(const SharedPtr<T>& other) : pointer(other.pointer), control(other.control)
  {
    if (this->control)
      this->control->strong.fetchAdd(1);
  }
  SharedPtr(SharedPtr<T>&& other) : pointer(other.pointer), control(other.control)
  {
    other.pointer = nullptr;
    other.control = nullptr;
  }
  // From a SharedPtr to a type whose pointer converts to T* (a derived class, T const): the same
  // owners.
  template<typename U> requires (isConvertible<U*, T*> && !isSame<U, T>)
  implicit SharedPtr(const SharedPtr<U>& other) : pointer(other.pointer), control(other.control)
  {
    if (this->control)
      this->control->strong.fetchAdd(1);
  }
  template<typename U> requires (isConvertible<U*, T*> && !isSame<U, T>)
  implicit SharedPtr(SharedPtr<U>&& other) : pointer(other.pointer), control(other.control)
  {
    other.pointer = nullptr;
    other.control = nullptr;
  }
  // Takes the object a UniquePtr owned.
  template<typename U> requires (isConvertible<U*, T*>)
  implicit SharedPtr(UniquePtr<U>&& unique)
  {
    if (U* object = unique.release())
      this->own(object);
  }
  ~SharedPtr() { this->release(); }

  // A SharedPtr sharing control's owners, if the object still lives; empty otherwise.
  static SharedPtr<T> locked(T* object, SharedControl* owners)
  {
    SharedPtr<T> result;
    if (owners != nullptr && sharedTryLock(owners))
    {
      result.pointer = object;
      result.control = owners;
    }
    return result;
  }

  SharedPtr<T>& operator=(const SharedPtr<T>& other)
  {
    if (this != &other)
    {
      if (other.control)
        other.control->strong.fetchAdd(1);
      this->release();
      this->pointer = other.pointer;
      this->control = other.control;
    }
    return *this;
  }
  SharedPtr<T>& operator=(SharedPtr<T>&& other)
  {
    if (this != &other)
    {
      this->release();
      this->pointer = other.pointer;
      this->control = other.control;
      other.pointer = nullptr;
      other.control = nullptr;
    }
    return *this;
  }
  SharedPtr<T>& operator=(nullptr_t)
  {
    this->release();
    return *this;
  }

  // Gives up this owner: the last one deletes the object.
  void release()
  {
    if (!this->control)
      return;
    if (this->control->strong.fetchSub(1) == 1)
    {
      this->control->destroy(this->control->object);
      sharedReleaseWeak(this->control);
    }
    this->pointer = nullptr;
    this->control = nullptr;
  }
  void reset() { this->release(); }
  void reset(T* newPointer)
  {
    this->release();
    if (newPointer)
      this->own(newPointer);
  }
  void swap(SharedPtr<T>& other)
  {
    T* p = this->pointer;
    SharedControl* c = this->control;
    this->pointer = other.pointer;
    this->control = other.control;
    other.pointer = p;
    other.control = c;
  }

  T* get() const { return this->pointer; }
  T& operator*() const { return *this->pointer; }
  T* operator->() const { return this->pointer; }
  explicit operator bool() const { return this->pointer != nullptr; }
  bool operator!() const { return this->pointer == nullptr; }
  bool operator==(const SharedPtr<T>& other) const { return this->pointer == other.pointer; }
  bool operator!=(const SharedPtr<T>& other) const { return this->pointer != other.pointer; }
  bool operator<(const SharedPtr<T>& other) const { return this->pointer < other.pointer; }
  bool operator==(nullptr_t) const { return this->pointer == nullptr; }
  bool operator!=(nullptr_t) const { return this->pointer != nullptr; }
  int use_count() const { return this->control ? this->control->strong.load() : 0; }
  int useCount() const { return this->use_count(); }

  // A new control block for an object that has no owner yet; an object that derives from
  // EnableSharedFromThis learns its owner.
  template<typename U>
  void own(U* object)
  {
    this->pointer = object;
    this->control = new SharedControl();
    this->control->destroy = &sharedDestroy<U>;
    this->control->object = (void*)object;
    if constexpr (isBaseOf<EnableSharedFromThisBase, U>)
      object->adoptSharedSelf(this->control);
  }
};

template<typename T, typename... Args>
SharedPtr<T> makeShared(Args&&... args) { return SharedPtr<T>(new T(forward<Args>(args)...)); }

template<typename T>
struct WeakPtr
{
  using element_type = T;

  T* pointer = nullptr;
  SharedControl* control = nullptr;

  WeakPtr() {}
  implicit WeakPtr(const SharedPtr<T>& shared) : pointer(shared.pointer), control(shared.control)
  {
    if (this->control)
      this->control->weak.fetchAdd(1);
  }
  WeakPtr(const WeakPtr<T>& other) : pointer(other.pointer), control(other.control)
  {
    if (this->control)
      this->control->weak.fetchAdd(1);
  }
  WeakPtr(WeakPtr<T>&& other) : pointer(other.pointer), control(other.control)
  {
    other.pointer = nullptr;
    other.control = nullptr;
  }
  // A weak reference to the object control owns (EnableSharedFromThis::weak_from_this).
  WeakPtr(T* object, SharedControl* owners) : pointer(owners ? object : nullptr), control(owners)
  {
    if (owners)
      owners->weak.fetchAdd(1);
  }
  ~WeakPtr() { this->release(); }

  WeakPtr<T>& operator=(const WeakPtr<T>& other)
  {
    if (this != &other)
    {
      if (other.control)
        other.control->weak.fetchAdd(1);
      this->release();
      this->pointer = other.pointer;
      this->control = other.control;
    }
    return *this;
  }
  WeakPtr<T>& operator=(WeakPtr<T>&& other)
  {
    if (this != &other)
    {
      this->release();
      this->pointer = other.pointer;
      this->control = other.control;
      other.pointer = nullptr;
      other.control = nullptr;
    }
    return *this;
  }
  WeakPtr<T>& operator=(const SharedPtr<T>& shared)
  {
    if (shared.control)
      shared.control->weak.fetchAdd(1);
    this->release();
    this->pointer = shared.pointer;
    this->control = shared.control;
    return *this;
  }

  void release()
  {
    if (this->control)
      sharedReleaseWeak(this->control);
    this->pointer = nullptr;
    this->control = nullptr;
  }
  void reset() { this->release(); }

  bool expired() const { return !this->control || this->control->strong.load() == 0; }
  int use_count() const { return this->control ? this->control->strong.load() : 0; }
  int useCount() const { return this->use_count(); }
  // A SharedPtr to the object while it lives, empty otherwise.
  SharedPtr<T> lock() const { return SharedPtr<T>::locked(this->pointer, this->control); }
};

// What shared_from_this() throws for an object no SharedPtr owns.
struct BadWeakPtr : Exception
{
  BadWeakPtr() : Exception(String("bad_weak_ptr")) {}
};

// The base of an object that makes SharedPtrs to itself: T derives from EnableSharedFromThis<T>,
// and the first SharedPtr that takes the object (makeShared, SharedPtr(T*), reset) records
// itself; shared_from_this() then shares its owners.
template<typename T>
struct EnableSharedFromThis : EnableSharedFromThisBase
{
  SharedPtr<T> shared_from_this()
  {
    SharedPtr<T> result = SharedPtr<T>::locked(static_cast<T*>(this), this->sharedSelf);
    if (!result)
      throw BadWeakPtr();
    return result;
  }
  SharedPtr<const T> shared_from_this() const
  {
    SharedPtr<const T> result = SharedPtr<const T>::locked(static_cast<const T*>(this), this->sharedSelf);
    if (!result)
      throw BadWeakPtr();
    return result;
  }
  WeakPtr<T> weak_from_this() { return WeakPtr<T>(static_cast<T*>(this), this->sharedSelf); }
  WeakPtr<const T> weak_from_this() const { return WeakPtr<const T>(static_cast<const T*>(this), this->sharedSelf); }
  SharedPtr<T> sharedFromThis() { return this->shared_from_this(); }
  SharedPtr<const T> sharedFromThis() const { return this->shared_from_this(); }
  WeakPtr<T> weakFromThis() { return this->weak_from_this(); }
  WeakPtr<const T> weakFromThis() const { return this->weak_from_this(); }
};

// Atomic access to a SharedPtr (std::atomic_load, atomic_store and atomic_exchange on a
// shared_ptr, and std::atomic<std::shared_ptr<T>>): a read, write or exchange of the whole
// SharedPtr happens as one step with respect to the others on the same SharedPtr. Not lock-free:
// each takes an SRW lock, for the free functions one of sixteen picked by the SharedPtr's address
// (as C++ libraries do). Plain reads and writes of that SharedPtr are not synchronised with them.
void* sharedPtrLocks[16]; // SRW locks: zero is unlocked

void** sharedPtrLockFor(const void* address) { return &sharedPtrLocks[hashBits((uint64_t)address) >> 60]; }

template<typename T>
SharedPtr<T> atomicLoad(const SharedPtr<T>* p)
{
  void** lock = sharedPtrLockFor(p);
  win32::AcquireSRWLockShared(win32::srwLock(lock));
  SharedPtr<T> copy = *p;
  win32::ReleaseSRWLockShared(win32::srwLock(lock));
  return copy;
}
// The value p held before is released after the lock (its object may be destroyed then).
template<typename T>
void atomicStore(SharedPtr<T>* p, SharedPtr<T> desired)
{
  void** lock = sharedPtrLockFor(p);
  win32::AcquireSRWLockExclusive(win32::srwLock(lock));
  p->swap(desired);
  win32::ReleaseSRWLockExclusive(win32::srwLock(lock));
}
template<typename T>
SharedPtr<T> atomicExchange(SharedPtr<T>* p, SharedPtr<T> desired)
{
  void** lock = sharedPtrLockFor(p);
  win32::AcquireSRWLockExclusive(win32::srwLock(lock));
  p->swap(desired);
  win32::ReleaseSRWLockExclusive(win32::srwLock(lock));
  return desired;
}
template<typename T>
bool atomicIsLockFree(const SharedPtr<T>* p) { return false; }

template<typename T>
struct Atomic<SharedPtr<T>>
{
  using value_type = SharedPtr<T>;

  SharedPtr<T> value;
  mutable void* lock = nullptr; // an SRW lock

  Atomic() {}
  implicit Atomic(SharedPtr<T> initial) : value(move(initial)) {}
  Atomic(const Atomic<SharedPtr<T>>&) = delete;
  Atomic<SharedPtr<T>>& operator=(const Atomic<SharedPtr<T>>&) = delete;

  SharedPtr<T> load() const
  {
    win32::AcquireSRWLockShared(win32::srwLock(&this->lock));
    SharedPtr<T> copy = this->value;
    win32::ReleaseSRWLockShared(win32::srwLock(&this->lock));
    return copy;
  }
  void store(SharedPtr<T> desired)
  {
    win32::AcquireSRWLockExclusive(win32::srwLock(&this->lock));
    this->value.swap(desired);
    win32::ReleaseSRWLockExclusive(win32::srwLock(&this->lock));
  }
  SharedPtr<T> exchange(SharedPtr<T> desired)
  {
    win32::AcquireSRWLockExclusive(win32::srwLock(&this->lock));
    this->value.swap(desired);
    win32::ReleaseSRWLockExclusive(win32::srwLock(&this->lock));
    return desired;
  }
  // True when the value held the same object with the same ownership as expected (and now holds
  // desired); otherwise false, and expected receives the value.
  bool compareExchange(SharedPtr<T>& expected, SharedPtr<T> desired)
  {
    SharedPtr<T> previous; // what expected held, released after the lock
    win32::AcquireSRWLockExclusive(win32::srwLock(&this->lock));
    bool same = this->value.pointer == expected.pointer && this->value.control == expected.control;
    if (same)
      this->value.swap(desired);
    else
    {
      previous = move(expected);
      expected = this->value;
    }
    win32::ReleaseSRWLockExclusive(win32::srwLock(&this->lock));
    return same;
  }
  bool compare_exchange_strong(SharedPtr<T>& expected, SharedPtr<T> desired) { return this->compareExchange(expected, move(desired)); }
  bool compare_exchange_weak(SharedPtr<T>& expected, SharedPtr<T> desired) { return this->compareExchange(expected, move(desired)); }
  bool is_lock_free() const { return false; }

  operator SharedPtr<T>() const { return this->load(); }
  Atomic<SharedPtr<T>>& operator=(SharedPtr<T> desired)
  {
    this->store(move(desired));
    return *this;
  }
};
