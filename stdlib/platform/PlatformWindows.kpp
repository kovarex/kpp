requires config::platform == Platform::Windows;
// The platform layer on Windows (design.md, "Targets and hosts", 3): the Win32 and UCRT calls the
// portable files make through platform:: (PlatformPosix.kpp for Linux and FreeBSD).

// errno, which the UCRT defines as (*_errno()).
extern "C" int* _errno();

namespace platform
{
  i64 steadyClockFrequency = 0; // QueryPerformanceCounter's counts per second, read once

  // The monotonic clock in nanoseconds (SteadyClock).
  i64 steadyNanoseconds()
  {
    if (steadyClockFrequency == 0)
      win32::QueryPerformanceFrequency((_LARGE_INTEGER*)&steadyClockFrequency);
    i64 counter = 0;
    win32::QueryPerformanceCounter((_LARGE_INTEGER*)&counter);
    // Split to keep the multiplication within 64 bits for long uptimes.
    i64 whole = counter / steadyClockFrequency;
    i64 rest = counter % steadyClockFrequency;
    return whole * 1000000000 + rest * 1000000000 / steadyClockFrequency;
  }

  // A count that changes faster than the clocks tick, for seeds (RandomDevice):
  // QueryPerformanceCounter's.
  i64 fastCounter()
  {
    i64 counter = 0;
    win32::QueryPerformanceCounter((_LARGE_INTEGER*)&counter);
    return counter;
  }

  // The wall clock in 100 ns ticks since 1970-01-01 UTC (SystemClock).
  i64 systemTicks()
  {
    u64 fileTime = 0; // 100 ns ticks since 1601-01-01
    win32::GetSystemTimePreciseAsFileTime((_FILETIME*)&fileTime);
    return (i64)fileTime - 116444736000000000ll;
  }

  // Blocks the calling thread for at least d's milliseconds, rounded up (Windows' timer may wake it
  // early, so callers check their clock and sleep again).
  template<typename Rep, typename Period>
  void sleepFor(const Duration<Rep, Period>& d) { win32::Sleep(waitMilliseconds(d)); }

  // Lets another thread run.
  void yield() { win32::SwitchToThread(); }

  // C's errno of the calling thread.
  i32* errnoLocation() { return _errno(); }

  // The UCRT's errno values where the C libraries differ (errno.h; Errc).
  const i32 errnoAgain = 11;
  const i32 errnoDeadlock = 36;
  const i32 errnoNameTooLong = 38;
  const i32 errnoNoSys = 40;
  const i32 errnoNotEmpty = 41;
  const i32 errnoNotSupported = 129;
  const i32 errnoOpNotSupported = 130;
  const i32 errnoTimedOut = 138;

  // The text Windows has for a system error (what GetLastError returns): FormatMessage's, in UTF-8,
  // without its line end.
  String systemErrorMessage(i32 value)
  {
    wchar_t buffer[512];
    unsigned long count = win32::FormatMessageW(0x1000 | 0x200, nullptr, (unsigned long)value, 0, buffer, 512, nullptr); // FROM_SYSTEM | IGNORE_INSERTS
    while (count > 0 && (buffer[count - 1] == L'\r' || buffer[count - 1] == L'\n' || buffer[count - 1] == L' '))
      --count;
    if (count == 0)
      return String("unknown error ") + toString(value);
    char narrow[1536];
    i32 length = win32::WideCharToMultiByte(65001, 0, buffer, (i32)count, narrow, 1536, nullptr, nullptr); // CP_UTF8
    return String(narrow, length);
  }

  // The condition (an Errc's value) a system error means, or 0.
  i32 errcOfSystemError(i32 value) { return errcOfWindowsError(value); }

  // --- Threads and locks (Thread.kpp, SharedPtr.kpp) ---

  // A lock for one thread at a time, or for many readers (Mutex, SharedMutex, the library's own
  // locks): an SRWLOCK, one pointer, zero when unlocked, with nothing to release. Lock and SharedLock
  // are one type here; on POSIX a Lock is a mutex, which a Condition waits with, and a SharedLock a
  // read-write lock.
  class Lock
  {
  public:
    Lock() {}
    Lock(const Lock&) = delete;
    Lock& operator=(const Lock&) = delete;

    void lock() { win32::AcquireSRWLockExclusive(win32::srwLock(&this->srw)); }
    void unlock() { win32::ReleaseSRWLockExclusive(win32::srwLock(&this->srw)); }
    bool tryLock() { return win32::TryAcquireSRWLockExclusive(win32::srwLock(&this->srw)) != 0; }
    void lockShared() { win32::AcquireSRWLockShared(win32::srwLock(&this->srw)); }
    void unlockShared() { win32::ReleaseSRWLockShared(win32::srwLock(&this->srw)); }
    bool tryLockShared() { return win32::TryAcquireSRWLockShared(win32::srwLock(&this->srw)) != 0; }

  private:
    friend class Condition; // waits on srw

    void* srw = nullptr;
  };

  using SharedLock = Lock;

  // A condition variable that waits with a Lock: a CONDITION_VARIABLE, one pointer, zero when
  // initialised.
  class Condition
  {
  public:
    Condition() {}
    Condition(const Condition&) = delete;
    Condition& operator=(const Condition&) = delete;

    void notifyOne() { win32::WakeConditionVariable(win32::conditionVariable(&this->condition)); }
    void notifyAll() { win32::WakeAllConditionVariable(win32::conditionVariable(&this->condition)); }
    // Unlocks lock and blocks until notified (or woken spuriously), then locks it again.
    void wait(Lock& lock) { win32::SleepConditionVariableSRW(win32::conditionVariable(&this->condition), win32::srwLock(&lock.srw), 0xFFFFFFFFu, 0); }

    // The same for at most d (whole milliseconds, rounded up): false when the time ran out first.
    template<typename Rep, typename Period>
    bool waitFor(Lock& lock, const Duration<Rep, Period>& d)
    {
      return win32::SleepConditionVariableSRW(win32::conditionVariable(&this->condition), win32::srwLock(&lock.srw), waitMilliseconds(d), 0) != 0;
    }

  private:
    void* condition = nullptr;
  };

  // What a thread runs: a function of one pointer, and what it returns (CreateThread's).
  using ThreadFunction = unsigned long (*)(void*);
  using ThreadResult = unsigned long;
  const ThreadResult threadDone = 0;

  // Starts start(parameter) on a new thread: its handle, null when the system cannot start one, and
  // its id in *id.
  void* startThread(ThreadFunction start, void* parameter, unsigned long* id) { return win32::CreateThread(nullptr, 0, start, parameter, 0, id); }

  // Waits until the thread has finished, and releases its handle.
  void joinThread(void* handle)
  {
    win32::WaitForSingleObject(handle, 0xFFFFFFFFu);
    win32::CloseHandle(handle);
  }

  // Lets the thread run on its own: its handle is released.
  void detachThread(void* handle) { win32::CloseHandle(handle); }
  // The calling thread's id: never 0.
  unsigned long currentThreadId() { return win32::GetCurrentThreadId(); }
  // The machine's logical processors, in all its processor groups.
  u32 processorCount() { return (u32)win32::GetActiveProcessorCount(0xFFFF); }
}
