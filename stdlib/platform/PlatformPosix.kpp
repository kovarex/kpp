requires config::platform != Platform::Windows;
// The platform layer on Linux and FreeBSD (design.md, "Targets and hosts", 3): the POSIX calls the
// portable files make through platform:: (PlatformWindows.kpp for Windows). What differs between
// the two is in PlatformLinux.kpp and PlatformFreeBSD.kpp: the clocks' ids and the errno accessor.

// struct timespec, both C libraries' (time_t and long: 16 bytes on LP64). Declared by its tag
// alone, as the headers name it, so that a program's import of time.h declares these functions the
// same way; the library passes its own storage of the same layout.
struct timespec;

namespace posix
{
  extern "C" int clock_gettime(int clock, timespec* time);
  extern "C" int nanosleep(const timespec* duration, timespec* remaining);
  extern "C" int sched_yield();
}

namespace platform
{
  // A struct timespec's two fields.
  struct TimeSpec
  {
    int64_t seconds = 0;
    int64_t nanoseconds = 0;
  };

  TimeSpec clockTime(int clock)
  {
    TimeSpec time;
    posix::clock_gettime(clock, (timespec*)&time);
    return time;
  }

  // The monotonic clock in nanoseconds (SteadyClock).
  int64_t steadyNanoseconds()
  {
    TimeSpec time = clockTime(clockMonotonic);
    return time.seconds * 1000000000 + time.nanoseconds;
  }

  // A count that changes faster than the clocks tick, for seeds (RandomDevice): the monotonic
  // clock's nanoseconds.
  int64_t fastCounter() { return steadyNanoseconds(); }

  // The wall clock in 100 ns ticks since 1970-01-01 UTC (SystemClock).
  int64_t systemTicks()
  {
    TimeSpec time = clockTime(clockRealtime);
    return time.seconds * 10000000 + time.nanoseconds / 100;
  }

  // Blocks the calling thread for about d (a signal may wake it early, so callers check their clock
  // and sleep again); a d of zero or less returns at once.
  template<typename Rep, typename Period>
  void sleepFor(const Duration<Rep, Period>& d)
  {
    long long nanoseconds = ceil<Nanoseconds>(d).count();
    if (nanoseconds <= 0)
      return;
    TimeSpec duration;
    duration.seconds = nanoseconds / 1000000000;
    duration.nanoseconds = nanoseconds % 1000000000;
    posix::nanosleep((const timespec*)&duration, nullptr);
  }

  // Lets another thread run.
  void yield() { posix::sched_yield(); }

  // The terminate handler: kpp's own, as no C++ runtime is linked here. Called by nothing yet: an
  // exception does not unwind on these targets before stage 3 (stdlib-conformance.md).
  Atomic<TerminateHandlerFunction> terminateHandler;

  // Installs the terminate handler and returns the one before.
  TerminateHandlerFunction setTerminate(TerminateHandlerFunction handler) { return terminateHandler.exchange(handler); }
}
