requires config::platform == Platform::Linux;
// What glibc has its own way in the platform layer (PlatformPosix.kpp; PlatformFreeBSD.kpp).

namespace posix
{
  // errno, which glibc's errno.h defines as (*__errno_location()).
  extern "C" i32* __errno_location();
  // time.h's clockid_t, clock_gettime's clock: an int.
  using clockid = i32;
  using pthread_t = unsigned long;
  using pthread_attr_t = ::pthread_attr_t;
  using pthread_mutex_t = ::pthread_mutex_t;
  using pthread_cond_t = ::pthread_cond_t;
  using pthread_rwlock_t = ::pthread_rwlock_t;
  using DIR = __dirstream;
  using mode_t = u32;
}

namespace platform
{
  // The clocks' ids (glibc's time.h).
  const i32 clockRealtime = 0;
  const i32 clockMonotonic = 1;

  // The locks' sizes in 8-byte words (bits/pthreadtypes-arch.h): pthread_mutex_t 40 bytes on x86-64,
  // 48 on arm64; pthread_cond_t 48, pthread_rwlock_t 56 on both.
  const i32 mutexWords = config::arch == Arch::Arm64 ? 6 : 5;
  const i32 conditionWords = 6;
  const i32 rwlockWords = 7;
  // The first word of PTHREAD_MUTEX_INITIALIZER, _COND_ and _RWLOCK_ (Lock, Condition, SharedLock):
  // glibc's are zeroes throughout.
  const u64 mutexSignature = 0;
  const u64 conditionSignature = 0;
  const u64 rwlockSignature = 0;
  // sysconf's name for the processors online (bits/confname.h).
  const i32 scNprocessorsOnln = 84;
  // A thread's pthread_t from the handle startThread gave.
  posix::pthread_t threadOf(void* handle) { return (unsigned long)handle; }

  // Where the file system's structs keep what FilesPosix.kpp reads (glibc): struct stat (144 bytes on
  // x86-64, 128 on arm64, asm-generic's) st_mode at 24 (arm64: 16), st_size at 48, st_mtim at 88 (st_dev
  // at 0, st_ino at 8); struct statvfs f_frsize at 8, f_blocks 16, f_bfree 24, f_bavail 32; struct
  // dirent's d_name at 19.
  const i32 statModeOffset = config::arch == Arch::Arm64 ? 16 : 24;
  const i32 statSizeOffset = 48;
  const i32 statWriteTimeOffset = 88;
  const i32 statLinksOffset = config::arch == Arch::Arm64 ? 20 : 16; // st_nlink, 64 bits (arm64: 32)
  const i32 statLinksBytes = config::arch == Arch::Arm64 ? 4 : 8;
  // utimensat's AT_FDCWD and UTIME_OMIT (fcntl.h, sys/stat.h).
  const i32 atCurrentDirectory = -100;
  const i64 utimeOmit = (1ll << 30) - 2;
  const i32 statDeviceBytes = 8; // st_dev at 0
  const i32 statvfsCountBytes = 8; // f_blocks, f_bfree, f_bavail
  const i32 statvfsFragmentSizeOffset = 8;
  const i32 statvfsBlocksOffset = 16;
  const i32 statvfsFreeOffset = 24;
  const i32 statvfsAvailableOffset = 32;
  const i32 direntNameOffset = 19;

  // C's errno of the calling thread.
  i32* errnoLocation() { return posix::__errno_location(); }

  // glibc's errno values where the C libraries differ (asm-generic/errno-base.h, errno.h; Errc).
  const i32 errnoAgain = 11;
  const i32 errnoIllegalSequence = 84;
  const i32 errnoDeadlock = 35;
  const i32 errnoNameTooLong = 36;
  const i32 errnoNoSys = 38;
  const i32 errnoNotEmpty = 39;
  const i32 errnoNotSupported = 95;
  const i32 errnoOpNotSupported = 95;
  const i32 errnoTimedOut = 110;
}
