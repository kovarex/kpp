requires config::platform == Platform::Windows;
// The file system's calls on Windows (filesystem's, core/Filesystem.kpp): the Win32 wide-character
// API, the path's UTF-16 text as it is (FilesPosix.kpp for Linux and FreeBSD).

namespace platform
{
  struct Win32FileTime
  {
    unsigned long low;
    unsigned long high;
  };

  // WIN32_FILE_ATTRIBUTE_DATA
  struct Win32AttributeData
  {
    unsigned long attributes;
    Win32FileTime creation;
    Win32FileTime access;
    Win32FileTime write;
    unsigned long sizeHigh;
    unsigned long sizeLow;
  };

  // BY_HANDLE_FILE_INFORMATION
  struct Win32HandleInformation
  {
    unsigned long attributes;
    Win32FileTime creation;
    Win32FileTime access;
    Win32FileTime write;
    unsigned long volumeSerial;
    unsigned long sizeHigh;
    unsigned long sizeLow;
    unsigned long links;
    unsigned long indexHigh;
    unsigned long indexLow;
  };

  // WIN32_FIND_DATAW
  struct Win32FindData
  {
    unsigned long attributes;
    Win32FileTime creation;
    Win32FileTime access;
    Win32FileTime write;
    unsigned long sizeHigh;
    unsigned long sizeLow;
    unsigned long reserved0;
    unsigned long reserved1;
    wchar_t name[260];
    wchar_t alternateName[14];
  };

  const unsigned long invalidAttributes = 0xFFFFFFFF;
  // INVALID_HANDLE_VALUE, the pointer of all ones (written through a 64-bit integer: `(void*)-1`
  // zero-extends -1 today, language/negative_integer_to_pointer).
  void* const invalidHandle = (void*)(i64)-1;
  const unsigned long attributeReadOnly = 0x1;
  const unsigned long attributeDirectory = 0x10;
  const unsigned long attributeReparsePoint = 0x400;

  // UTF-8 to UTF-16 (CP_UTF8); an invalid sequence becomes U+FFFD.
  WString widenUtf8(const char* text, i32 length)
  {
    if (length <= 0)
      return WString();
    i32 count = win32::MultiByteToWideChar(65001, 0, text, length, nullptr, 0);
    WString result;
    result.resize(count);
    win32::MultiByteToWideChar(65001, 0, text, length, result.data(), count);
    return result;
  }

  // UTF-16 to UTF-8 (CP_UTF8). A lone surrogate has no UTF-8 form: SystemError with
  // ERROR_NO_UNICODE_TRANSLATION (WC_ERR_INVALID_CHARS), as MSVC's path::string().
  String narrowWide(const wchar_t* text, i32 length)
  {
    if (length <= 0)
      return String();
    i32 count = win32::WideCharToMultiByte(65001, 128, text, length, nullptr, 0, nullptr, nullptr);
    if (count == 0)
      throw SystemError(ErrorCode(1113, systemCategory()));
    String result;
    result.resize(count);
    win32::WideCharToMultiByte(65001, 128, text, length, result.data(), count, nullptr, nullptr);
    return result;
  }

  // The same for text to show, not to name anything by: a lone surrogate becomes U+FFFD.
  String narrowWideReplacing(const wchar_t* text, i32 length)
  {
    if (length <= 0)
      return String();
    i32 count = win32::WideCharToMultiByte(65001, 0, text, length, nullptr, 0, nullptr, nullptr);
    String result;
    result.resize(count);
    win32::WideCharToMultiByte(65001, 0, text, length, result.data(), count, nullptr, nullptr);
    return result;
  }

  // A UTF-8 copy getenv handed out, kept until its variable changes. A program reads few variables:
  // a list, with no container instantiated for every program. Never destroyed: a global's
  // destructor or an atexit function may still ask.
  struct EnvironmentCopy
  {
    String name;
    String value;
    EnvironmentCopy* next = nullptr;
  };

  struct EnvironmentCopies
  {
    Mutex mutex;
    EnvironmentCopy* first = nullptr;
  };

  char* environmentVariable(const char* name)
  {
    static EnvironmentCopies* copies = new EnvironmentCopies();
    WString wideName = widenUtf8(name, (i32)strlen(name));
    LockGuard<Mutex> guard(copies->mutex);
    const wchar_t* wide = wideName.empty() ? nullptr : win32::_wgetenv(wideName.c_str());
    if (!wide)
      return nullptr;
    i32 length = 0;
    while (wide[length] != 0)
      ++length;
    String value = narrowWide(wide, length);
    EnvironmentCopy* kept = copies->first;
    while (kept && kept->name != name)
      kept = kept->next;
    if (!kept)
    {
      kept = new EnvironmentCopy();
      kept->name = name;
      kept->next = copies->first;
      copies->first = kept;
    }
    if (kept->value != value)
      kept->value = move(value);
    return kept->value.data();
  }

  // The calling thread's last error (GetLastError), of the system category.
  ErrorCode lastFileError() { return ErrorCode((i32)win32::GetLastError(), systemCategory()); }
  // Win32 errors that mean the path does not resolve: file, path not found; a bad name, network
  // path, net name, path.
  bool isNotFoundError(i32 error) { return error == 2 || error == 3 || error == 123 || error == 53 || error == 67 || error == 161; }
  // The errors of CreateDirectory that may mean the directory is there already:
  // ERROR_ALREADY_EXISTS, and ACCESS_DENIED for a drive's root.
  bool isAlreadyThereError(i32 error) { return error == 183 || error == 5; }

  filesystem::FileInfo infoOfAttributes(unsigned long attributes, unsigned long sizeHigh, unsigned long sizeLow, Win32FileTime write)
  {
    filesystem::FileInfo info;
    info.permissions = (attributes & attributeReadOnly) != 0 ? filesystem::perms(0555) : filesystem::perms::all;
    info.directory = (attributes & attributeDirectory) != 0;
    if ((attributes & attributeReparsePoint) != 0)
      info.type = filesystem::file_type::symlink;
    else
      info.type = info.directory ? filesystem::file_type::directory : filesystem::file_type::regular;
    info.size = ((u64)sizeHigh << 32) | sizeLow;
    info.sizeKnown = info.type == filesystem::file_type::regular;
    info.writeTime = ((u64)write.high << 32) | write.low;
    return info;
  }

  // The attributes, size and write time of what p names, links followed (a reparse point is opened
  // and asked).
  bool attributesOf(const filesystem::path& p, Win32HandleInformation& out, ErrorCode& ec)
  {
    Win32AttributeData data;
    if (!win32::GetFileAttributesExW(p.c_str(), GetFileExInfoStandard, &data))
    {
      ec = lastFileError();
      return false;
    }
    if ((data.attributes & attributeReparsePoint) != 0)
    {
      void* file = win32::CreateFileW(p.c_str(), 0x80, 7, nullptr, 3, 0x02000000, nullptr); // FILE_READ_ATTRIBUTES, share all, OPEN_EXISTING, BACKUP_SEMANTICS
      if (file == invalidHandle)
      {
        ec = lastFileError();
        return false;
      }
      bool ok = win32::GetFileInformationByHandle(file, (_BY_HANDLE_FILE_INFORMATION*)(void*)&out) != 0;
      if (!ok)
        ec = lastFileError();
      win32::CloseHandle(file);
      if (!ok)
        return false;
      ec.clear();
      return true;
    }
    out.attributes = data.attributes;
    out.sizeHigh = data.sizeHigh;
    out.sizeLow = data.sizeLow;
    out.write = data.write;
    ec.clear();
    return true;
  }

  // What p names: with followLinks what a link leads to (attributesOf); without, p itself, a reparse
  // point (a symbolic link or a junction) a symlink.
  bool fileInfo(const filesystem::path& p, bool followLinks, filesystem::FileInfo& out, ErrorCode& ec)
  {
    if (followLinks)
    {
      Win32HandleInformation info;
      if (!attributesOf(p, info, ec))
        return false;
      out = infoOfAttributes(info.attributes & ~attributeReparsePoint, info.sizeHigh, info.sizeLow, info.write);
      return true;
    }
    unsigned long attributes = win32::GetFileAttributesW(p.c_str());
    if (attributes == invalidAttributes)
    {
      ec = lastFileError();
      return false;
    }
    ec.clear();
    out = infoOfAttributes(attributes, 0, 0, Win32FileTime{0, 0});
    out.sizeKnown = false;
    return true;
  }

  // The identity of what p names, links followed: its volume's serial number and its index there.
  bool identityOf(const filesystem::path& p, Win32HandleInformation& out, ErrorCode& ec)
  {
    void* file = win32::CreateFileW(p.c_str(), 0x80, 7, nullptr, 3, 0x02000000, nullptr); // FILE_READ_ATTRIBUTES, share all, OPEN_EXISTING, BACKUP_SEMANTICS
    if (file == invalidHandle)
    {
      ec = lastFileError();
      return false;
    }
    bool ok = win32::GetFileInformationByHandle(file, (_BY_HANDLE_FILE_INFORMATION*)(void*)&out) != 0;
    if (!ok)
      ec = lastFileError();
    win32::CloseHandle(file);
    return ok;
  }

  // Whether a and b name the same file or directory, links followed; false (and ec) when either
  // does not resolve.
  bool sameFile(const filesystem::path& a, const filesystem::path& b, bool& same, ErrorCode& ec)
  {
    Win32HandleInformation first, second;
    if (!identityOf(a, first, ec) || !identityOf(b, second, ec))
      return false;
    ec.clear();
    same = first.volumeSerial == second.volumeSerial && first.indexHigh == second.indexHigh && first.indexLow == second.indexLow;
    return true;
  }

  // A directory's entries in the order the file system gives them, `.` and `..` left out:
  // FindFirstFile and FindNextFile.
  class DirectoryReader
  {
  public:
    DirectoryReader() {}
    DirectoryReader(const DirectoryReader&) = delete;

    ~DirectoryReader()
    {
      if (this->find != invalidHandle)
        win32::FindClose(this->find);
    }

    // False on an error (ec), or when the directory is there but empty (no ec).
    bool open(const filesystem::path& p, ErrorCode& ec)
    {
      ec.clear();
      filesystem::path pattern = p / filesystem::path(L"*");
      this->find = win32::FindFirstFileW(pattern.c_str(), (_WIN32_FIND_DATAW*)(void*)&this->data);
      if (this->find == invalidHandle)
      {
        // ERROR_FILE_NOT_FOUND or ERROR_NO_MORE_FILES on a directory that is there: an empty
        // listing; on a missing one, its own error.
        ErrorCode failure = lastFileError();
        if (failure.value() != 2 && failure.value() != 18)
          ec = failure;
        else
        {
          filesystem::FileInfo info;
          if (!fileInfo(p, true, info, ec))
            return false;
          if (info.type != filesystem::file_type::directory)
            ec = make_error_code(Errc::not_a_directory);
        }
        return false;
      }
      this->pending = true;
      return true;
    }

    // The next entry's name and what the listing says of it; false at the end (or on an error, ec).
    bool next(WString& name, filesystem::FileInfo& info, ErrorCode& ec)
    {
      ec.clear();
      for (;;)
      {
        if (!this->pending && !win32::FindNextFileW(this->find, (_WIN32_FIND_DATAW*)(void*)&this->data))
        {
          i32 error = (i32)win32::GetLastError();
          if (error != 18)
            ec = ErrorCode(error, systemCategory());
          return false;
        }
        this->pending = false;
        const wchar_t* found = this->data.name;
        if (found[0] == L'.' && (found[1] == 0 || (found[1] == L'.' && found[2] == 0)))
          continue;
        name = WString(found);
        info = infoOfAttributes(this->data.attributes, this->data.sizeHigh, this->data.sizeLow, this->data.write);
        return true;
      }
    }

  private:
    void* find = invalidHandle;
    Win32FindData data;
    bool pending = false; // data holds an entry next() has not given yet
  };

  // A path a Win32 function writes (its size, its buffer -> the length, or the size it needs).
  WString systemPath(unsigned long (*get)(unsigned long, wchar_t*))
  {
    wchar_t buffer[520];
    unsigned long n = get(520, buffer);
    if (n < 520)
      return WString(buffer, (ContainerSize)n);
    WString big;
    big.resize((ContainerSize)n);
    n = get(n, big.data());
    big.resize((ContainerSize)n);
    return big;
  }

  // p made absolute against the current directory (GetFullPathName, which also resolves `.` and `..`).
  filesystem::path absolutePath(const filesystem::path& p, ErrorCode& ec)
  {
    ec.clear();
    wchar_t buffer[520];
    unsigned long n = win32::GetFullPathNameW(p.c_str(), 520, buffer, nullptr);
    if (n == 0)
    {
      ec = lastFileError();
      return filesystem::path();
    }
    if (n < 520)
      return filesystem::path(WString(buffer, (ContainerSize)n));
    WString big;
    big.resize((ContainerSize)n);
    n = win32::GetFullPathNameW(p.c_str(), n, big.data(), nullptr);
    big.resize((ContainerSize)n);
    return filesystem::path(big);
  }

  // The absolute path of what p names with every link resolved; p must exist. The system's `\\?\`
  // prefix is removed (`\\?\UNC\` becomes `\\`).
  filesystem::path canonicalPath(const filesystem::path& p, ErrorCode& ec)
  {
    void* file = win32::CreateFileW(p.c_str(), 0, 7, nullptr, 3, 0x02000000, nullptr); // no access, share all, OPEN_EXISTING, BACKUP_SEMANTICS
    if (file == invalidHandle)
    {
      ec = lastFileError();
      return filesystem::path();
    }
    wchar_t buffer[520];
    unsigned long n = win32::GetFinalPathNameByHandleW(file, buffer, 520, 0);
    WString result;
    if (n > 0 && n < 520)
      result = WString(buffer, (ContainerSize)n);
    else if (n >= 520)
    {
      result.resize((ContainerSize)n);
      n = win32::GetFinalPathNameByHandleW(file, result.data(), n, 0);
      result.resize((ContainerSize)n);
    }
    if (n == 0)
      ec = lastFileError();
    else
      ec.clear();
    win32::CloseHandle(file);
    if (ec)
      return filesystem::path();
    if (result.find(L"\\\\?\\UNC\\") == 0)
      result = L"\\\\" + result.substr(8);
    else if (result.find(L"\\\\?\\") == 0)
      result = result.substr(4);
    return filesystem::path(result);
  }

  filesystem::path currentPath(ErrorCode& ec)
  {
    ec.clear();
    return filesystem::path(systemPath(win32::GetCurrentDirectoryW));
  }

  void setCurrentPath(const filesystem::path& p, ErrorCode& ec)
  {
    if (win32::SetCurrentDirectoryW(p.c_str()))
      ec.clear();
    else
      ec = lastFileError();
  }

  filesystem::path tempDirectoryPath(ErrorCode& ec)
  {
    ec.clear();
    return filesystem::path(systemPath(win32::GetTempPathW));
  }

  // The space of the volume p is on; false (and ec) on an error.
  bool spaceOf(const filesystem::path& p, filesystem::space_info& result, ErrorCode& ec)
  {
    u64 available = 0;
    u64 total = 0;
    u64 free = 0;
    if (!win32::GetDiskFreeSpaceExW(p.c_str(), (_ULARGE_INTEGER*)&available, (_ULARGE_INTEGER*)&total, (_ULARGE_INTEGER*)&free))
    {
      ec = lastFileError();
      return false;
    }
    ec.clear();
    result.capacity = total;
    result.free = free;
    result.available = available;
    return true;
  }

  bool createDirectory(const filesystem::path& p, ErrorCode& ec)
  {
    if (win32::CreateDirectoryW(p.c_str(), nullptr))
    {
      ec.clear();
      return true;
    }
    ec = lastFileError();
    return false;
  }

  // Removes the directory (RemoveDirectory) or the file (DeleteFile) p names, a link itself.
  bool removePath(const filesystem::path& p, bool directory, ErrorCode& ec)
  {
    bool ok = directory ? win32::RemoveDirectoryW(p.c_str()) != 0 : win32::DeleteFileW(p.c_str()) != 0;
    if (!ok)
    {
      ec = lastFileError();
      return false;
    }
    ec.clear();
    return true;
  }

  // Moves from to to, replacing a file there (MoveFileEx with MOVEFILE_REPLACE_EXISTING: not across
  // volumes, which is errc::cross_device_link).
  bool renamePath(const filesystem::path& from, const filesystem::path& to, ErrorCode& ec)
  {
    if (win32::MoveFileExW(from.c_str(), to.c_str(), 1))
    {
      ec.clear();
      return true;
    }
    ec = lastFileError();
    return false;
  }

  // Copies the regular file from over to (CopyFile).
  bool copyFileContents(const filesystem::path& from, const filesystem::path& to, ErrorCode& ec)
  {
    if (!win32::CopyFileW(from.c_str(), to.c_str(), 0))
    {
      ec = lastFileError();
      return false;
    }
    ec.clear();
    return true;
  }

  // Sets p's permissions (replace, add or remove the bits given): Windows keeps only whether it is
  // read-only, which it is when the result has no write bit.
  void changePermissions(const filesystem::path& p, filesystem::perms permissions, filesystem::perm_options options, ErrorCode& ec)
  {
    unsigned long attributes = win32::GetFileAttributesW(p.c_str());
    if (attributes == invalidAttributes)
    {
      ec = lastFileError();
      return;
    }
    filesystem::perms current = (attributes & attributeReadOnly) != 0 ? filesystem::perms(0555) : filesystem::perms::all;
    filesystem::perms result = permissions;
    if ((options & filesystem::perm_options::add) != filesystem::perm_options(0))
      result = current | permissions;
    else if ((options & filesystem::perm_options::remove) != filesystem::perm_options(0))
      result = current & ~permissions;
    bool readOnly = (result & (filesystem::perms::owner_write | filesystem::perms::group_write | filesystem::perms::others_write)) == filesystem::perms::none;
    unsigned long wanted = readOnly ? (attributes | attributeReadOnly) : (attributes & ~attributeReadOnly);
    if (wanted != attributes && !win32::SetFileAttributesW(p.c_str(), wanted))
    {
      ec = lastFileError();
      return;
    }
    ec.clear();
  }

  // A listing's or fileInfo's write time as FileClock ticks: Windows' own FILETIME, 100 ns since 1601.
  i64 fileClockTicksOf(u64 writeTime) { return (i64)writeTime; }

  // Sets the last write time of p (links followed) to ticks of FileClock: SetFileTime.
  bool setWriteTime(const filesystem::path& p, i64 ticks, ErrorCode& ec)
  {
    void* file = win32::CreateFileW(p.c_str(), 0x100, 7, nullptr, 3, 0x02000000, nullptr); // FILE_WRITE_ATTRIBUTES, share all, OPEN_EXISTING, BACKUP_SEMANTICS
    if (file == invalidHandle)
    {
      ec = lastFileError();
      return false;
    }
    Win32FileTime time{(unsigned long)((u64)ticks & 0xFFFFFFFFu), (unsigned long)((u64)ticks >> 32)};
    bool ok = win32::SetFileTime(file, nullptr, nullptr, (const _FILETIME*)(const void*)&time) != 0;
    if (!ok)
      ec = lastFileError();
    win32::CloseHandle(file);
    if (ok)
      ec.clear();
    return ok;
  }

  // Makes the regular file p size bytes long, cut or zero-filled (the C runtime's _chsize_s on a
  // descriptor opened for writing); its errors are errno values.
  bool resizeFile(const filesystem::path& p, u64 size, ErrorCode& ec)
  {
    if (size > (u64)0x7FFFFFFFFFFFFFFFll)
    {
      ec = make_error_code(Errc::file_too_large);
      return false;
    }
    int descriptor = win32::_wopen(p.c_str(), 0x8002); // _O_RDWR | _O_BINARY
    if (descriptor < 0)
    {
      ec = ErrorCode(*errnoLocation(), genericCategory());
      return false;
    }
    int error = win32::_chsize_s(descriptor, (long long)size);
    win32::_close(descriptor);
    if (error != 0)
    {
      ec = ErrorCode(error, genericCategory());
      return false;
    }
    ec.clear();
    return true;
  }

  // The number of names of what p names (links followed): BY_HANDLE_FILE_INFORMATION's link count.
  bool hardLinkCount(const filesystem::path& p, u64& count, ErrorCode& ec)
  {
    Win32HandleInformation info;
    if (!identityOf(p, info, ec))
      return false;
    count = info.links;
    ec.clear();
    return true;
  }

  // A new name link for the file target: CreateHardLink.
  bool createHardLink(const filesystem::path& target, const filesystem::path& link, ErrorCode& ec)
  {
    if (!win32::CreateHardLinkW(link.c_str(), target.c_str(), nullptr))
    {
      ec = lastFileError();
      return false;
    }
    ec.clear();
    return true;
  }

  // A symbolic link at link to target (a directory link when directory): CreateSymbolicLink, which
  // needs Developer Mode or the privilege to create symbolic links (ERROR_PRIVILEGE_NOT_HELD).
  bool createSymlink(const filesystem::path& target, const filesystem::path& link, bool directory, ErrorCode& ec)
  {
    unsigned long flags = (directory ? 1u : 0u) | 2u; // SYMBOLIC_LINK_FLAG_DIRECTORY, ..._ALLOW_UNPRIVILEGED_CREATE
    if (!win32::CreateSymbolicLinkW(link.c_str(), target.c_str(), flags))
    {
      ec = lastFileError();
      return false;
    }
    ec.clear();
    return true;
  }

  // What the symbolic link or junction p leads to, as it was written: the reparse point's print
  // name (its substitute name without the `\??\` prefix when there is none).
  bool readSymlink(const filesystem::path& p, filesystem::path& target, ErrorCode& ec)
  {
    void* file = win32::CreateFileW(p.c_str(), 0x80, 7, nullptr, 3, 0x02200000, nullptr); // FILE_READ_ATTRIBUTES, OPEN_REPARSE_POINT | BACKUP_SEMANTICS
    if (file == invalidHandle)
    {
      ec = lastFileError();
      return false;
    }
    Vector<u8> buffer(16 * 1024);
    unsigned long returned = 0;
    bool ok = win32::DeviceIoControl(file, 0x000900A8, nullptr, 0, buffer.data(), (unsigned long)buffer.size(), &returned, nullptr) != 0; // FSCTL_GET_REPARSE_POINT
    if (!ok)
      ec = lastFileError();
    win32::CloseHandle(file);
    if (!ok)
      return false;
    auto read16 = [&](i32 at) -> u32 { return (u32)buffer[at] | ((u32)buffer[at + 1] << 8); };
    u32 tag = read16(0) | (read16(2) << 16);
    i32 names = 0;
    if (tag == 0xA000000Cu) // IO_REPARSE_TAG_SYMLINK: Flags before the names
      names = 20;
    else if (tag == 0xA0000003u) // IO_REPARSE_TAG_MOUNT_POINT, a junction
      names = 16;
    else
    {
      ec = make_error_code(Errc::invalid_argument);
      return false;
    }
    u32 substituteOffset = read16(8), substituteLength = read16(10), printOffset = read16(12), printLength = read16(14);
    auto text = [&](u32 offset, u32 length) {
      WString out;
      for (u32 i = 0; i + 1 < length; i += 2)
        out.push_back((wchar_t)read16(names + (i32)(offset + i)));
      return out;
    };
    WString name = printLength > 0 ? text(printOffset, printLength) : text(substituteOffset, substituteLength);
    if (printLength == 0 && name.size() >= 4 && name[0] == L'\\' && name[1] == L'?' && name[2] == L'?' && name[3] == L'\\')
      name = name.substr(4);
    target = filesystem::path(name);
    ec.clear();
    return true;
  }
}

// C's getenv, whose text is UTF-8 here too (the C runtime's is the ANSI code page's): a program's
// import of stdlib.h leaves it to this one. A value holding a lone surrogate throws SystemError.
char* getenv(const char* name) { return platform::environmentVariable(name); }
