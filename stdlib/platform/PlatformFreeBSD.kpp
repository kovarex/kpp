requires config::platform == Platform::FreeBSD;
// What FreeBSD's C library has its own way in the platform layer (PlatformPosix.kpp;
// PlatformLinux.kpp).

// pthreads' types, as sys/_pthreadtypes.h names them: each a pointer to a struct the C library
// allocates (`typedef struct pthread_mutex *pthread_mutex_t;`). The structs are declared by their
// tags, so that a program's import of pthread.h declares the functions that take them the same way.
struct pthread;
struct pthread_attr;
struct pthread_mutex;
struct pthread_cond;
struct pthread_rwlock;
// A directory stream, as dirent.h names it: `typedef struct _dirdesc DIR;`.
struct _dirdesc;

namespace posix
{
  // errno, which FreeBSD's errno.h defines as (*__error()).
  extern "C" int* __error();
  using pthread_t = pthread*;
  using pthread_attr_t = pthread_attr*;
  using pthread_mutex_t = pthread_mutex*;
  using pthread_cond_t = pthread_cond*;
  using pthread_rwlock_t = pthread_rwlock*;
  using DIR = _dirdesc;
  using mode_t = unsigned short;
}

namespace platform
{
  // The clocks' ids (FreeBSD's sys/_clock_id.h).
  const int clockRealtime = 0;
  const int clockMonotonic = 4;

  // The locks' sizes in 8-byte words: each is a pointer to what the C library allocates on first use
  // (sys/_pthreadtypes.h).
  const int mutexWords = 1;
  const int conditionWords = 1;
  const int rwlockWords = 1;
  // sysconf's name for the processors online (unistd.h).
  const int scNprocessorsOnln = 58;
  // A thread's pthread_t from the handle startThread gave.
  posix::pthread_t threadOf(void* handle) { return (pthread*)handle; }

  // Where the file system's structs keep what FilesPosix.kpp reads (FreeBSD 12 and later, x86-64):
  // struct stat (224 bytes) st_mode (16 bits) at 24, st_mtim at 64, st_size at 112 (st_dev at 0,
  // st_ino at 8); struct statvfs (88 bytes) f_bavail at 0, f_bfree 8, f_blocks 16, f_frsize 64;
  // struct dirent's d_name at 24.
  const int statModeOffset = 24;
  const int statSizeOffset = 112;
  const int statWriteTimeOffset = 64;
  const int statvfsFragmentSizeOffset = 64;
  const int statvfsBlocksOffset = 16;
  const int statvfsFreeOffset = 8;
  const int statvfsAvailableOffset = 0;
  const int direntNameOffset = 24;

  // C's errno of the calling thread.
  int* errnoLocation() { return posix::__error(); }

  // FreeBSD's errno values where the C libraries differ (sys/errno.h; Errc).
  const int errnoAgain = 35;
  const int errnoDeadlock = 11;
  const int errnoNameTooLong = 63;
  const int errnoNoSys = 78;
  const int errnoNotEmpty = 66;
  const int errnoNotSupported = 45;
  const int errnoOpNotSupported = 45;
  const int errnoTimedOut = 60;
}
