// C stdio beyond what core/Format.kpp declares (printf, snprintf are already there).
// FILE is the C runtime's, as the UCRT's stdio.h defines it (an import of stdio.h then agrees); the
// functions here take it as void*. stdin, stdout and stderr are FILE*, as in C, so that they pass
// to a FILE* parameter (a class holding `FILE* fp` built from stdout).
extern "C" void* fopen(const char* filename, const char* mode);
extern "C" int fclose(void* stream);
extern "C" size_t fread(void* buffer, size_t size, size_t count, void* stream);
extern "C" size_t fwrite(const void* buffer, size_t size, size_t count, void* stream);
extern "C" int fseek(void* stream, long offset, int origin);
extern "C" long ftell(void* stream);
extern "C" int fflush(void* stream);
extern "C" int fprintf(void* stream, const char* format, ...);
extern "C" int feof(void* stream);
extern "C" int ferror(void* stream);
extern "C" int fgetc(void* stream);
extern "C" int fputc(int c, void* stream);
extern "C" char* fgets(char* str, int count, void* stream);
extern "C" int fputs(const char* str, void* stream);
extern "C" int sscanf(const char* str, const char* format, ...);
extern "C" int sprintf(char* str, const char* format, ...);
extern "C" int puts(const char* str);
extern "C" int remove(const char* filename);
extern "C" int rename(const char* oldname, const char* newname);
extern "C" void* tmpfile();

struct _iobuf { void* _Placeholder; };
using FILE = _iobuf;
extern "C" FILE* __acrt_iob_func(unsigned index);
FILE* stdin  = __acrt_iob_func(0);
FILE* stdout = __acrt_iob_func(1);
FILE* stderr = __acrt_iob_func(2);
