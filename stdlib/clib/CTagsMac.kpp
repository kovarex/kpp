requires config::platform == Platform::Mac;
// kpp standard library: macOS's C tags, global as every C name is, so that a program's import of the C headers declares the same types (--std-scope, design.md 16).

// pthreads' types, as sys/_pthread/_pthread_types.h names them: pthread_t a pointer to
// `struct _opaque_pthread_t`, the others structs of a signature and opaque bytes. Declared by their
// tags, so that a program's import of pthread.h declares the functions that take them the same way.
struct _opaque_pthread_t;
struct _opaque_pthread_attr_t;
struct _opaque_pthread_mutex_t;
struct _opaque_pthread_cond_t;
struct _opaque_pthread_rwlock_t;
// A directory stream, as dirent.h names it: `typedef struct { ... } DIR;`, a struct of no tag, which
// the C import names by its typedef.
struct DIR;
// The clocks' ids, as time.h names them: `typedef enum { _CLOCK_REALTIME = 0, ... } clockid_t;`, an enum
// of no tag (unsigned int: its values are not negative), which the C import names by its typedef.
enum clockid_t : u32;
