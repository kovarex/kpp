// C standard library: process control, environment, sorting, and string-to-number conversions.
extern "C" [[noreturn]] void exit(int status);
extern "C" [[noreturn]] void _Exit(int status);
extern "C" [[noreturn]] void abort();
extern "C" int system(const char* command);
extern "C" int atexit(void (*func)());
extern "C" void qsort(void* base, size_t count, size_t size, int (*compare)(const void*, const void*));
extern "C" void* bsearch(const void* key, const void* base, size_t count, size_t size,
                          int (*compare)(const void*, const void*));
extern "C" double strtod(const char* str, char** endptr);
extern "C" float strtof(const char* str, char** endptr);
extern "C" long strtol(const char* str, char** endptr, int base);
extern "C" unsigned long strtoul(const char* str, char** endptr, int base);
extern "C" long long strtoll(const char* str, char** endptr, int base);
extern "C" unsigned long long strtoull(const char* str, char** endptr, int base);
extern "C" int atoi(const char* str);
extern "C" double atof(const char* str);

// strtold: the string's value as a long double, which is a double here (kpp's long double is double on
// every target): strtod's. C's strtold returns x87's 80 bits off Windows and binary128 on Linux arm64,
// where kpp reads a double (it gave 0 for "0.125" on Linux); the UCRT's strtold is strtod.
long double strtold(const char* str, char** endptr) { return strtod(str, endptr); }
