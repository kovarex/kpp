// C-style limit macros and constants: what NULL, UINT32_MAX, INT_MAX etc. expand to.
// These are preprocessor macros in C/C++; Kpp defines them as global constants.

const void* NULL = nullptr;

const int8_t INT8_MIN = -128;
const int8_t INT8_MAX = 127;
const uint8_t UINT8_MAX = 255;

const int16_t INT16_MIN = -32768;
const int16_t INT16_MAX = 32767;
const uint16_t UINT16_MAX = 65535;

const int INT32_MIN = -2147483647 - 1;
const int INT32_MAX = 2147483647;
const unsigned int UINT32_MAX = 4294967295u;

const long long INT64_MIN = -9223372036854775807ll - 1;
const long long INT64_MAX = 9223372036854775807ll;
const unsigned long long UINT64_MAX = 18446744073709551615ull;

const unsigned long long SIZE_MAX = 18446744073709551615ull;

const int INT_MIN = -2147483647 - 1;
const int INT_MAX = 2147483647;
const unsigned int UINT_MAX = 4294967295u;

const long long LLONG_MIN = -9223372036854775807ll - 1;
const long long LLONG_MAX = 9223372036854775807ll;
const unsigned long long ULLONG_MAX = 18446744073709551615ull;

const int CHAR_BIT = 8;
