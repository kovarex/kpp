// C math functions beyond what core/Math.kpp declares (sqrt, floor, ceil, round, trunc, pow,
// fmod, exp, log, sin, cos, atan2, fabs, lround, nextafter and nextafterf, isnan, isinf, isfinite,
// signbit, abs are already there).
extern "C" double acos(double x);
extern "C" double asin(double x);
extern "C" double atan(double x);
extern "C" double tan(double x);
extern "C" double cosh(double x);
extern "C" double sinh(double x);
extern "C" double tanh(double x);
extern "C" double log2(double x);
extern "C" double log10(double x);
extern "C" double hypot(double x, double y);
extern "C" double modf(double x, double* intpart);
extern "C" double copysign(double magnitude, double sign);
extern "C" double remainder(double x, double y);
extern "C" double ldexp(double x, int exp);
extern "C" double frexp(double x, int* exp);
extern "C" double cbrt(double x);

// Neither zero nor subnormal, infinite or NaN: a magnitude of at least DBL_MIN (FLT_MIN). A
// subnormal was normal (isnormal(4.9e-324) true where C's is false).
bool isnormal(double value) { return isfinite(value) && abs(value) >= 2.2250738585072014e-308; }
bool isnormal(float value) { return isfinite(value) && abs(value) >= 1.17549435e-38f; }

float acos(float x) { return (float)acos((double)x); }
float asin(float x) { return (float)asin((double)x); }
float atan(float x) { return (float)atan((double)x); }
float tan(float x) { return (float)tan((double)x); }
float log2(float x) { return (float)log2((double)x); }
float log10(float x) { return (float)log10((double)x); }
float hypot(float x, float y) { return (float)hypot((double)x, (double)y); }
