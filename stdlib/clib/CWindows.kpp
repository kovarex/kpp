requires config::platform == Platform::Windows;
// What the C runtime of Windows (the UCRT) has its own way (CLinux.kpp, CFreeBSD.kpp for the others).

// FILE as the UCRT's stdio.h defines it (one pointer: sizeof(FILE) is 8, as C's), so that a program's
// import of stdio.h has the same type.
struct _iobuf { void* _Placeholder; };
using FILE = _iobuf;

// The standard streams: the UCRT's stdio.h's macros call __acrt_iob_func.
extern "C" FILE* __acrt_iob_func(unsigned index);
FILE* stdin  = __acrt_iob_func(0);
FILE* stdout = __acrt_iob_func(1);
FILE* stderr = __acrt_iob_func(2);

// math.h's fpclassify, a macro that calls the C runtime's classifiers, whose results are its FP_NAN,
// FP_INFINITE, FP_NORMAL, FP_SUBNORMAL and FP_ZERO (isnan and the others: core/Math.kpp): the UCRT's
// (FP_NORMAL is -1, FP_SUBNORMAL -2), or with MinGW-w64's headers (config::mingw, windows-gnu) its
// own libmingwex's (FP_NAN 0x100...).
extern "C" short _dclass(double value);
extern "C" short _fdclass(float value);
extern "C" int __fpclassify(double value);
extern "C" int __fpclassifyf(float value);

int fpclassify(double value)
{
  if constexpr (config::mingw)
    return __fpclassify(value);
  else
    return _dclass(value);
}

int fpclassify(float value)
{
  if constexpr (config::mingw)
    return __fpclassifyf(value);
  else
    return _fdclass(value);
}

template<typename T> requires isIntegral<T>
int fpclassify(T value) { return fpclassify(double(value)); }
