// Random number generation: a simple engine and uniform distribution, enough for what
// std::default_random_engine, std::random_device and std::uniform_int_distribution convert to.
// The engine is a 64-bit xoshiro256**, fast and good enough for games and simulations.

struct RandomDevice
{
  u64 operator()()
  {
    u64 x = (u64)platform::fastCounter();
    x ^= x >> 30;
    x *= 0xbf58476d1ce4e5b9ull;
    x ^= x >> 27;
    x *= 0x94d049bb133111ebull;
    x ^= x >> 31;
    return x;
  }
};

class DefaultRandomEngine
{
public:
  // The seed a default-constructed engine starts from, so that its sequence is the same in every run
  // (std::default_random_engine's default_seed); RandomDevice is the nondeterministic source.
  static constexpr u64 default_seed = 1;

  DefaultRandomEngine() { this->seed(default_seed); }

  explicit DefaultRandomEngine(u64 seed)
  {
    this->state[0] = seed;
    this->state[1] = seed * 6364136223846793005ull + 1;
    this->state[2] = this->state[1] * 6364136223846793005ull + 1;
    this->state[3] = this->state[2] * 6364136223846793005ull + 1;
  }

  void seed(u64 s)
  {
    this->state[0] = s;
    this->state[1] = s * 6364136223846793005ull + 1;
    this->state[2] = this->state[1] * 6364136223846793005ull + 1;
    this->state[3] = this->state[2] * 6364136223846793005ull + 1;
  }

  u64 operator()()
  {
    u64 result = this->state[1] * 5;
    result = (result << 7 | result >> 57) * 9;
    u64 t = this->state[1] << 17;
    this->state[2] ^= this->state[0];
    this->state[3] ^= this->state[1];
    this->state[1] ^= this->state[2];
    this->state[0] ^= this->state[3];
    this->state[2] ^= t;
    this->state[3] = (this->state[3] << 45) | (this->state[3] >> 19);
    return result;
  }

  static u64 min() { return 0; }
  static u64 max() { return ~0ull; }

  void discard(u64 count)
  {
    for (u64 i = 0; i < count; ++i)
      (*this)();
  }

private:
  u64 state[4];
};

template<typename IntType = i32>
class UniformIntDistribution
{
public:
  // [0, IntType's greatest value], as std's default b.
  UniformIntDistribution() : low(0), high(Limits<IntType>::max()) {}
  UniformIntDistribution(IntType low, IntType high) : low(low), high(high) {}

  template<typename Engine>
  IntType operator()(Engine& engine)
  {
    // In u64, where the difference cannot wrap: a range of the type's every value is 2^64 there,
    // which wraps to 0, and then every raw value is one (the engine gives 64 random bits).
    u64 range = (u64)this->high - (u64)this->low + 1;
    if (range == 0)
      return (IntType)((u64)this->low + engine());
    // Every value equally likely ([rand.dist.uni.int]): raw values below 2^64 mod range would make
    // the low part of the range more likely under `raw % range`, so they are drawn again.
    u64 rejectBelow = (0 - range) % range;
    u64 raw = engine();
    while (raw < rejectBelow)
      raw = engine();
    return (IntType)((u64)this->low + raw % range);
  }

  IntType a() const { return this->low; }
  IntType b() const { return this->high; }

private:
  IntType low;
  IntType high;
};

// The elements of [first, last) (random access) in a random order, each order equally likely
// (std::shuffle): from the back, each element swapped with one drawn from it and those before it.
template<typename It, typename G>
void shuffle(It first, It last, G&& g)
{
  for (i64 i = (i64)(last - first) - 1; i > 0; --i)
  {
    i64 j = UniformIntDistribution<i64>(0, i)(g);
    if (j != i)
      iterSwap(first + i, first + j);
  }
}

// n distinct elements of [first, last) (all of them when there are fewer), each choice equally likely,
// written to out (std::sample); returns the end of what was written. From forward iterators the
// chosen ones keep their order (selection sampling); from input iterators out must be random
// access, and their order there is random (reservoir sampling).
template<typename InIt, typename OutIt, typename G>
OutIt sample(InIt first, InIt last, OutIt out, i64 n, G&& g)
{
  if constexpr (isBaseOf<ForwardIteratorTag, typename IteratorTraits<InIt>::iterator_category>)
  {
    i64 remaining = (i64)distance(first, last);
    i64 needed = n < remaining ? n : remaining;
    for (; needed > 0; ++first, --remaining)
      if (UniformIntDistribution<i64>(0, remaining - 1)(g) < needed)
      {
        *out = *first;
        ++out;
        --needed;
      }
    return out;
  }
  else
  {
    i64 kept = 0;
    for (; first != last && kept < n; ++first, ++kept)
      out[kept] = *first;
    for (i64 seen = kept; first != last; ++first, ++seen)
    {
      i64 slot = UniformIntDistribution<i64>(0, seen)(g);
      if (slot < n)
        out[slot] = *first;
    }
    return out + kept;
  }
}
