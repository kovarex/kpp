// Probe (2026-10-29, master 89058a6): `delete p` with p == nullptr must do nothing (C++). kppc's
// DeleteExpr destroys and frees without a null check, so a class with a virtual destructor is
// destroyed through a null vtable pointer: the program ends with 0xC0000005 before "virtual ok".
// kppc --exe probe.exe probe_delete_null.kpp
extern "C" int printf(const char* format, ...);
struct Plain
{
  int value = 1;
};
struct Virtual
{
  int value = 1;
  virtual ~Virtual() {}
};
int main()
{
  Plain* a = nullptr;
  delete a;
  printf("plain ok\n");
  Virtual* b = nullptr;
  delete b;
  printf("virtual ok\n");
  return 0;
}
