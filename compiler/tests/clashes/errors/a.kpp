// Each name here is declared again in b.kpp: two entities of one top-level name, an error at the
// second (docs/design.md, "One global scope, so clashes are errors"). A static name and one in an
// unnamed namespace are local to their file in C++, which kpp does not support yet: an error too,
// where they were one variable that both files read.
int total = 1;
struct Crate { int v = 1; };
int measure() { return 1; }
static int counter = 1;
namespace { int depth = 10; }
int useA() { return total + Crate{}.v + measure() + counter + depth; }
