// spec: a class with a deleted constructor from an rvalue of another type (`Ref(const int&&) = delete`, no reference to a temporary) is still copied and moved by its implicit constructors
// factorio: std::reference_wrapper<const std::string> in a Vector (WrappedFont's allFontsData, FontStashFont), whose constructor from T&& is deleted
// pending: a copy or move of the class picks the deleted constructor (codegen: constructing Ref with a deleted constructor)
struct Ref
{
  const int* pointer;
  implicit Ref(const int& value) : pointer(&value) {}
  Ref(const int&& value) = delete;
  implicit operator const int&() const { return *this->pointer; }
};

int main()
{
  int a = 4;
  int b = 7;
  Ref r(a);
  Ref copy = r;
  Ref moved = ::move(copy);
  Vector<Ref> all;
  all.push_back(r);
  all.push_back(Ref(b));
  int first = all[0];
  int second = all[1];
  println("{} {} {} {}", int(moved), all.size(), first, second);
  return 0;
}
