// spec: dynamic_cast
// factorio: 443 uses in 244 files
class Base { public: virtual ~Base() {} };
class A : public Base { public: int a = 1; };
class B : public Base { public: int b = 2; };
int main()
{
  Base* x = new A();
  A* asA = dynamic_cast<A*>(x);
  B* asB = dynamic_cast<B*>(x);
  std::println(asA != nullptr, " ", asB == nullptr);
  delete x;
  return 0;
}
