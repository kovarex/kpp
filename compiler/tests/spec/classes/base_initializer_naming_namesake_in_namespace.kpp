// spec: a constructor's initializer of a base class that has the class's own name in another namespace (`class TestRunner : UnitTest::TestRunner` initializing `UnitTest::TestRunner(reporter)`): the qualified name is the base, not the class being constructed
// factorio: the tests' TestRunner.hpp, the runner every test run builds first (the converted test binary aborts there: the constructor is left out)
namespace UnitTest
{
  class TestRunner
  {
  public:
    explicit TestRunner(int& reporter) : reporter(&reporter) {}
  protected:
    int* reporter;
  };
}
class TestRunner : UnitTest::TestRunner
{
public:
  TestRunner(int& reporter, bool exitOnFailure)
    : UnitTest::TestRunner(reporter)
    , exitOnFailure(exitOnFailure)
  {}
  int value() const { return *this->reporter; }
  bool exitOnFailure;
};
int main()
{
  int reporter = 7;
  TestRunner runner(reporter, true);
  println(runner.value(), " ", runner.exitOnFailure);
  return 0;
}
