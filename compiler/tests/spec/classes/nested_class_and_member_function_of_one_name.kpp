// spec: a nested class and a member function of one name in one class, as C++ allows: where the name is a value (a call through an object, the member function's address) it is the function, which hides the class there ([basic.scope.hiding]/2); as a type it is the class (kpp needs no `struct` before it)
// pending: the checker passes it, and codegen fails: "does not support taking the address of Reading yet" and, for p.Reading(3), "does not support a member access that did not resolve to a field yet" (A, found 2026-11-04 beside the C imports' struct stat and stat())
struct Probe
{
  struct Reading
  {
    int value;
  };
  int Reading(int scale) { return base * scale; }
  int base = 7;
};
int main()
{
  Probe p;
  Probe::Reading r{5};
  int (Probe::*m)(int) = &Probe::Reading;
  println(p.Reading(3), " ", r.value, " ", (p.*m)(2));
  return 0;
}
