// spec: `using Option = Option<DataType>;` in a class deriving the class that declares the member template Option: inside its own definition the name is not yet the alias (C++ declares an alias after its type) but the base's template, and afterwards `Option::Predicate` is that instance's member
// factorio: LuaEventFiltersInstance<DataType> (Option::Predicate, Option::ValidCallback members of every event filter instance)
class Filters
{
public:
  template<class DataType_>
  struct Option
  {
    using DataType = DataType_;
    using Predicate = Function<bool(const DataType&)>;
  };
  virtual ~Filters() = default;
};
template<class DataType>
class Instance final : public Filters
{
public:
  using Option = Option<DataType>;
  class Filter
  {
  public:
    Filter(Option::Predicate predicate) : predicate(::move(predicate)) {}
    Option::Predicate predicate;
  };
  Vector<Filter> filters;
};
int main()
{
  Instance<int> i;
  i.filters.push_back(Instance<int>::Filter([](const int& x) { return x > 2; }));
  println("{} {}", i.filters[0].predicate(5), i.filters[0].predicate(1));
  return 0;
}
