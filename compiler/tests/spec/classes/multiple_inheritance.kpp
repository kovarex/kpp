// spec: multiple inheritance (one polymorphic base), access to both bases, pointer conversions
// factorio: 264 uses in 261 files
struct Named { std::String name; Named(const char* n) : name(n) {} };
struct Counted { int count = 0; void bump() { ++this.count; } };
class Widget : public Named, public Counted
{
public:
  virtual int kind() const { return 1; }
  Widget(const char* n) : Named(n) {}
};
int total(const Counted* c) { return c->count; }
int main()
{
  Widget w("w");
  w.bump();
  w.bump();
  Counted* asCounted = &w;
  Named* asNamed = &w;
  Widget* back = static_cast<Widget*>(asCounted);
  std::println(w.name, " ", total(&w), " ", asCounted->count, " ", asNamed->name, " ", back == &w);
  return 0;
}
