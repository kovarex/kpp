// spec: candidates reached through the same conversion function rank by the standard conversion after it ([over.ics.rank] 3.3): a class with `operator bool()` passed to push(const bool&) beside push(const uint8_t&), push(uint64_t), push(const int32_t&), push(const double&) and the like calls the bool one (identity beats a promotion or a conversion), as take(bool) beats take(int64_t)
// factorio: LuaHelper::push over a BoolModifierTarget (`LuaHelper::push(L, this->getForceData().travelToSpacePlatformsUnlocked)`, an operator bool): Lua read the number 0 instead of false (LuaForce LuaUnlockTravelToSpacePlatforms: "Expected false but was 0"); every bool-convertible class pushed to Lua is a number
struct Flag
{
  bool value = false;
  implicit operator bool() const { return this->value; }
};
void push(const uint8_t&) { print("uint8 "); }
void push(const uint32_t&) { print("uint32 "); }
void push(uint64_t) { print("uint64 "); }
void push(const bool&) { print("bool "); }
void push(const int32_t&) { print("int32 "); }
void push(const double&) { print("double "); }
void take(int64_t) { print("int64 "); }
void take(bool) { print("bool "); }
int main()
{
  Flag flag;
  push(flag);
  take(flag);
  println("");
  return 0;
}
