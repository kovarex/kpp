// spec: a constructor initializes its base through a member alias of the base, `using Inherited = Conditional<...>; Const(const T& v) : Inherited(v) {}`
// found in the game's UtilityConstants: Const<T> (276 members) names its base Value<T> or T through `super`
template<typename T>
struct Value
{
  T value;
  Value(const T& v) : value(v) {}
};
template<typename T>
struct Const : std::Conditional<std::isClass<T>, T, Value<T>>
{
  using Inherited = Conditional<std::isClass<T>, T, Value<T>>;
  Const(const T& v) : Inherited(v) {}
};
struct Point
{
  int x = 0;
  Point(int x) : x(x) {}
};
int main()
{
  Const<int> number(7);
  Const<Point> point(Point(3));
  std::println(number.value, " ", point.x);
  return 0;
}