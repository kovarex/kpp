// spec: at compile time a call's reference result given to a constructor is the object it refers to: `Leaf<A>(fwd<U>(a))` handed on a value, and a reference member silently kept a copy of it; clang's output
extern "C" int printf(const char* format, ...);
template <typename T> constexpr T&& fwd(T& v) { return static_cast<T&&>(v); }
template <typename T> struct Leaf
{
  T value;
  template <typename U> constexpr Leaf(U&& v) : value(fwd<U>(v)) {}
};
template <typename T> struct Direct { T value; constexpr Direct(T v) : value(static_cast<T&&>(v)) {} };
struct Plain { int& r; constexpr Plain(int& v) : r(v) {} };
struct PlainR { int&& r; constexpr PlainR(int&& v) : r(static_cast<int&&>(v)) {} };
template <typename A, typename B> struct Two : Leaf<A>, Leaf<B>
{
  template <typename U, typename V> constexpr Two(U&& a, V&& b) : Leaf<A>(fwd<U>(a)), Leaf<B>(fwd<V>(b)) {}
  constexpr A& first() { return Leaf<A>::value; }
};
constexpr int m1() { int a = 1; Leaf<int&> l(a); l.value = 3; return a; }
constexpr int m2() { int a = 1; Leaf<int&&> l(static_cast<int&&>(a)); l.value = 3; return a; }
constexpr int m3() { int a = 1; Plain l(a); l.r = 3; return a; }
constexpr int m4() { int a = 1; PlainR l(static_cast<int&&>(a)); l.r = 3; return a; }
constexpr int m5() { int a = 1; Direct<int&> l(a); l.value = 3; return a; }
constexpr int m6() { int a = 1; Direct<int&&> l(static_cast<int&&>(a)); l.value = 3; return a; }
constexpr int m7() { int a = 1; Two<int&, char> l(a, 'x'); l.first() = 3; return a; }
constexpr int m8() { int a = 1; Two<int&, char> l(a, 'x'); Leaf<int&>& leaf = l; leaf.value = 3; return a; }
constexpr int m9() { int a = 1, b = 2; Two<int&, long> l(a, b); l.first() = 3; return a * 10 + b; }
constexpr int c1 = m1(), c2 = m2(), c3 = m3(), c4 = m4(), c5 = m5(), c6 = m6(), c7 = m7(), c8 = m8(), c9 = m9();
int main()
{
  printf("%d %d %d %d %d %d %d %d %d\n", c1, c2, c3, c4, c5, c6, c7, c8, c9);
  printf("%d %d %d %d %d %d %d %d %d\n", m1(), m2(), m3(), m4(), m5(), m6(), m7(), m8(), m9());
  return 0;
}
