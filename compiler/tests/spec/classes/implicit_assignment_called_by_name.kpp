// spec: a class's implicitly declared copy assignment called by name, `this->Mask::operator=(other)` in a derived class's operator= and `plain.operator=(m)`, assigns member by member and gives the object, as the implicit operator= does when written as `=`
// found in the converted game: CollisionMaskConnector's and TileCollisionMaskConnector's operator= calling `this->CollisionMask::operator=(other)` (3 "member access that did not resolve to a field")
struct Mask
{
  int bits = 0;
  int extra = 0;
};
struct Connector : Mask
{
  bool setup = false;
  Connector& operator=(const Mask& other)
  {
    this.Mask::operator=(other);
    this.setup = true;
    return this;
  }
  Connector& operator=(const Connector& other)
  {
    this.Mask::operator=(other);
    this.setup = other.setup;
    return this;
  }
};
int main()
{
  Mask m;
  m.bits = 5;
  m.extra = 6;
  Connector c;
  c = m;
  Connector d;
  d = c;
  Mask plain;
  plain.operator=(m).bits += 1;
  std::println(c.bits, " ", c.extra, " ", c.setup, " ", d.bits, " ", d.setup, " ", plain.bits);
  return 0;
}
