// spec: the same at compile time: the evaluator runs a free operator<=> behind a rewritten relation, a function template's under what the operands deduce, clang's output
extern "C" import "stdio.h";
struct W { double v; };
constexpr auto operator<=>(const W& a, const W& b) { return a.v <=> b.v; }
constexpr bool operator==(const W& a, const W& b) { return a.v == b.v; }
template <typename T> struct O { T v; };
template <typename T> constexpr auto operator<=>(const O<T>& a, const O<T>& b) { return a.v <=> b.v; }
template <typename T> constexpr auto operator<=>(const O<T>& a, const T& b) { return a.v <=> b; }
struct M { int v; };
constexpr auto operator<=>(const M& a, int b) { return a.v <=> b; }
constexpr bool operator==(const M& a, int b) { return a.v == b; }
constexpr bool l1 = W{1.0} < W{2.0};
constexpr bool l2 = W{1.0} >= W{2.0};
constexpr bool l3 = O<int>{1} < O<int>{2};
constexpr bool l4 = O<double>{1.0} > O<double>{2.0};
constexpr bool l5 = O<int>{3} >= 3;
constexpr bool l6 = 2 < O<int>{1};
constexpr bool l7 = M{1} < 2;
constexpr bool l8 = 2 < M{1};
constexpr bool l9 = 3 >= M{3};
constexpr bool l10 = W{3.0} > W{2.0};
int main()
{
  printf("%d %d %d %d %d %d %d %d %d %d\n", l1, l2, l3, l4, l5, l6, l7, l8, l9, l10);
  return 0;
}
