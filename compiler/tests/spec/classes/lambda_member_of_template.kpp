// spec: a class template instantiated with a lambda's closure type holds the lambda as a member and calls it (`Holder<decltype(lambda)>{lambda}`, made by a function template from its argument)
// factorio: ScopedCallback<F> (the game's scope guards: destructorCallback), the library's transformView, Function's small callables
template<typename F>
struct Holder
{
  F f;
  int call(int x) const { return this->f(x); }
};
template<typename F>
Holder<F> hold(F f) { return Holder<F>{f}; }
int main()
{
  int base = 10;
  auto h = hold([base](int x) { return base + x; });
  println("{}", h.call(5));
  return 0;
}
