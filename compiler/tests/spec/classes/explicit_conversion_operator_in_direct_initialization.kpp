// spec: direct-initialization of a class from an object with an explicit conversion operator to that class, `Constant(parsed)` with `explicit operator const Constant&() const`, `AchievementId(id)` with `explicit operator AchievementId() const`, `Scale(zoom)` with a template `explicit operator CastType() const`: the class's copy or move constructor takes what the operator gives (C++'s rule for a constructor's first parameter in direct-initialization), also as a template's `Value(x)` and in an if's declaration
// factorio: NoiseExpressionParser::processNamedFunction<NoiseExpressionConstant>'s `storage[i] = Value((*parameters)[i].defaultValue);` (ParsedNoiseExpression's `explicit operator const NoiseExpressionConstant&() const`), CustomGuiToolTipCreator::createToolTip's `if (AchievementID achievementID = AchievementID(this->id))` and its 20 siblings (ChooseElemID's `explicit operator AchievementID() const`), UniverseWidget::SpaceConnectionWidget::getSegmentCount's `Scale(this->universe.zoomLevel)` (StrongTypedef's `template<typename CastType> explicit operator CastType() const`)
class Constant
{
public:
  Constant() {}
  Constant(double value) : number(value) {}
  Constant(String value) : text(value) {}
  Constant(const Constant& other) { *this = other; }
  Constant& operator=(const Constant& other)
  {
    this->number = other.number;
    this->text = other.text;
    return *this;
  }
  double number = 0;
  String text;
};
class Parsed
{
public:
  Parsed() = default;
  Parsed(Constant&& constant) : constant(move(constant)) {}
  operator bool() const { return this->constant.number != 0; }
  operator const Constant&() const { return this->constant; }
  Constant constant;
};
template<typename Value>
Value fromParsed(const Parsed& parsed) { return Value(parsed); }

template<typename Prototype>
class Id
{
public:
  Id() = default;
  Id(int index) : index(index) {}
  operator bool() const { return this->index != 0; }
  int index = 0;
};
struct AchievementPrototype {};
struct ItemPrototype {};
using AchievementId = Id<AchievementPrototype>;
using ItemId = Id<ItemPrototype>;
class ChooseElemId
{
public:
  ChooseElemId() = default;
  ChooseElemId(ItemId item) : item(item) {}
  operator AchievementId() const { return this->achievement; }
  operator ItemId() const { return this->item; }
  AchievementId achievement;
  ItemId item;
};

template<typename ValueType, class Tag>
class StrongTypedef
{
public:
  constexpr StrongTypedef(const ValueType& value) : value(value) {}
  constexpr operator const ValueType&() const { return this->value; }
  template<typename CastType> requires (!isSame<CastType, ValueType>)
  constexpr operator CastType() const { return CastType(this->value); }
private:
  ValueType value;
};
struct ScaleTag {};
struct ZoomTag {};
using Scale = StrongTypedef<double, ScaleTag>;
using Zoom = StrongTypedef<double, ZoomTag>;
double toScreen(double distance, Scale scale) { return distance * double(scale); }

int main()
{
  Parsed parsed(Constant(2.5));
  Constant direct = Constant(parsed);
  Constant viaTemplate = fromParsed<Constant>(parsed);
  Constant cast = static_cast<const Constant&>(parsed);
  ChooseElemId id(ItemId(3));
  int found = 0;
  if (AchievementId achievement = AchievementId(id))
    found = -1;
  else if (ItemId item = ItemId(id))
    found = item.index;
  Zoom zoom(2.5);
  double screen = toScreen(4.0, Scale(zoom));
  println(direct.number, " ", viaTemplate.number, " ", cast.number, " ", found, " ", screen);
  return 0;
}
