// spec: the operator== that a defaulted operator<=> declares is a member a qualified call names: a derived class's own operator== written `super::operator==(other) && ...` (super an alias of the base) compares the base's members, as `a == b` on two bases does
// factorio: RelativeItemStackLocation::operator== is `super::operator==(condition) && this->source == condition.source` over ItemStackLocation's `operator<=>(...) const = default`: the call came out as a copy of condition, converted to bool by ItemStackLocation's explicit operator bool, so any two locations with the same source compared equal and the tests' getWidget lookups found the first slot: InsertPlan's "Expected {speed-module, normal} x 1 but was {<null>, <null>} x 0" and the like (8 failed checks, all passing with the call written as a comparison of the bases); ApplicationVersion::operator== over Version is written the same way
class Base
{
public:
  Base() = default;
  Base(int a, int b) : a(a), b(b) {}
  strong_ordering operator<=>(const Base&) const = default;
  explicit operator bool() const { return this->a != 0; }
  int a = 0;
  int b = 0;
};
class Derived : public Base
{
  using super = Base;
public:
  Derived(int a, int b, int source) : Base(a, b), source(source) {}
  bool operator==(const Derived& other) const;
  bool operator==(const Base& other) const { return *(const Base*)(this) == other; }
  bool operator<(const Derived& other) const;
  int source = 0;
};
bool Derived::operator==(const Derived& other) const
{
  return super::operator==(other) && this->source == other.source;
}
bool Derived::operator<(const Derived& other) const
{
  return super::operator<=>(other) < 0;
}
int main()
{
  Derived x(4, 0, 4);
  Derived y(4, 1, 4);
  Base base(4, 1);
  println(x == y ? 1 : 0, " ", x == x ? 1 : 0, " ", y == base ? 1 : 0, " ", x < y ? 1 : 0, " ", Base(4, 0) == Base(4, 1) ? 1 : 0);
  return 0;
}
