// spec: a constructor that throws destroys what it had built, as C++ does: the bases and members constructed before the throw (in its body, or in a later member's initializer), for a local, for `new` (whose memory is freed too) and for a member of an enclosing object
// factorio: after LuaBlueprintInvalidOptions, whose invalid entities make set_blueprint_entities throw while it builds them, 4 entities stay alive (Entity::count): the tests' leak check in fmain aborts at exit and LuaBlueprint stops, its output lost with the abort. Locals are destroyed in unwinding; only a throwing constructor's own parts are not
int live = 0;
struct Base
{
  Base() { live += 1; }
  ~Base() { live -= 1; }
};
struct Member
{
  Member() { live += 10; }
  ~Member() { live -= 10; }
};
struct Derived : Base
{
  Member member;
  explicit Derived(bool fail)
  {
    if (fail)
      throw RuntimeError("no");
  }
};
struct Later
{
  Member first;
  Derived second;
  explicit Later() : second(true) {}
};
int main()
{
  try
  {
    Derived d(true);
  }
  catch (const Exception&)
  {
  }
  print("local {}; ", live);
  try
  {
    UniquePtr<Derived> p(new Derived(true));
  }
  catch (const Exception&)
  {
  }
  print("new {}; ", live);
  try
  {
    Later later;
  }
  catch (const Exception&)
  {
  }
  println("member {}", live);
  return 0;
}
