// spec: `Vector<Pair<int, bool>> v{ { {1, false}, {2, true} } }`: the outer list's one element is a list that makes no Pair (no constructor takes two lists: a constructor template deduces nothing from a brace list), so the element list is the InitializerList argument, two Pairs; likewise with four
// found in tests/TestSpacePlatform (`Vector<Pair<TilePosition, bool>> checks{ { { r.tilePosition(-1, 1), false}, ... } }`)
// pending: Pair's `template<U1, U2> Pair(U1&&, U2&&)` counts as taking two lists, the outer list becomes a one-element InitializerList and codegen finds no Pair for the inner list (`a constructor of Pair taking 2 arguments`)
struct Tile { int x, y; };
Tile tileAt(int x, int y) { return Tile{x, y}; }
int main()
{
  Vector<Pair<int, bool>> two{ { {1, false}, {2, true} } };
  Vector<Pair<Tile, bool>> four{ { { tileAt(-1, 1), false }, { tileAt(0, 1), false }, { tileAt(-1, 2), true }, { tileAt(0, 2), true } } };
  Vector<Pair<int, bool>> flat{ {5, true}, {6, false} };
  println("{} {} {} | {} {} {} {} | {} {}", int(two.size()), two[1].first, two[1].second, int(four.size()), four[0].first.x, four[3].first.y, four[2].second, int(flat.size()), flat[1].first);
  return 0;
}
