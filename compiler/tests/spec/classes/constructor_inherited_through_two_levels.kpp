// spec: a converting constructor inherited through two levels of `using Base::Base;` (CompressionState from MipmapState from Handle) converts an assigned value, as one inherited through one level does: `compression = create(5);` constructs a CompressionState from the UniquePtr
// factorio: PipelineStateManager::setupSpriteLoadingStates' `this->ycocgDXTCompressionState = this->graphics.createPipelineStateObject(spec);`, CompressionPipelineState inheriting MipmapGeneratorPipelineState's constructors, which inherits PipelineStateHandle's
struct PipelineStateObject
{
  int id = 0;
};
class Handle
{
public:
  Handle() = default;
  implicit Handle(std::UniquePtr<PipelineStateObject> state) : state(std::move(state)) {}
  int id() const { return this.state ? this.state->id : -1; }
  std::UniquePtr<PipelineStateObject> state;
};
class MipmapState : public Handle
{
public:
  using Handle::Handle;
};
class CompressionState : public MipmapState
{
public:
  using MipmapState::MipmapState;
};
std::UniquePtr<PipelineStateObject> create(int id)
{
  std::UniquePtr<PipelineStateObject> result = std::makeUnique<PipelineStateObject>();
  result->id = id;
  return result;
}
int main()
{
  MipmapState mipmap;
  mipmap = create(4);
  CompressionState compression;
  compression = create(5);
  CompressionState direct = create(3);
  std::println(mipmap.id(), " ", compression.id(), " ", direct.id());
  return 0;
}
