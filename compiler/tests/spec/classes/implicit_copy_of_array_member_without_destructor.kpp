// spec: the implicit copy and move of a class with a member array copy or move each element through the element's own copy or move constructor or assignment even when the element needs no destruction (only an element that copies bitwise is copied bitwise); C++ gives `1 1 11 2`
// factorio: found by the templates thread comparing the compile-time interpreter's copies with the program's: `Arr r2 = r;` of a `Counted cs[2]` member copied the elements bitwise, their copy constructors never ran (silent)
struct Counted
{
  int copies = 0;
  int moves = 0;
  Counted() {}
  Counted(const Counted& o) : copies(o.copies + 1), moves(o.moves) {}
  Counted(Counted&& o) : copies(o.copies), moves(o.moves + 1) {}
  Counted& operator=(const Counted& o)
  {
    this.copies = o.copies + 10;
    this.moves = o.moves;
    return this;
  }
  Counted& operator=(Counted&& o)
  {
    this.copies = o.copies;
    this.moves = o.moves + 1;
    return this;
  }
};
struct Arr { Counted cs[2]; };
int main()
{
  Arr r;
  Arr r2 = r;
  Arr r3 = std::move(r);
  Arr r4;
  r4 = r2;
  Arr r5;
  r5 = std::move(r3);
  std::println(r2.cs[1].copies, " ", r3.cs[1].moves, " ", r4.cs[1].copies, " ", r5.cs[1].moves);
  return 0;
}
