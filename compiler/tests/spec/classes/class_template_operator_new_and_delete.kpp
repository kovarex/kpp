// spec: a class template's own operator new and operator delete are its instance's members: `new Box<int>` calls Box<int>'s with its size, from a function template's instance and a lambda too
// factorio: the class operator new work (codegen named the instance's functions without the class's arguments and never defined them); clang's output
template<typename T>
struct Box
{
  T value;
  Box(T v) : value(v) {}
  void* operator new(size_t size) { println("box new ", size); return malloc(size); }
  void operator delete(void* p, size_t size) { println("box delete ", size); free(p); }
};
template<typename T>
T* make(T v) { return new T(v); }
int main()
{
  Box<int>* a = new Box<int>(1);
  Box<double>* b = make(Box<double>(2.5));
  println(a->value, " ", b->value);
  delete a;
  delete b;
  auto f = [] { return new Box<char>('x'); };
  Box<char>* c = f();
  delete c;
  return 0;
}
