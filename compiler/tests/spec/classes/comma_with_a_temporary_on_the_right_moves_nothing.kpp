// spec: a comma expression whose right operand is a temporary is that prvalue: it builds the result object itself, also of a class that cannot move ([expr.comma], [class.temporary]); so in a return, a variable, a member initializer, a conditional's branch, a lambda's variable and a new-expression (battery ce against clang)
struct Counted
{
  static int moved, destroyed;
  int value;
  Counted(int value) : value(value) {}
  Counted(Counted&& other) : value(other.value) { moved++; }
  ~Counted() { destroyed++; }
};
int Counted::moved = 0;
int Counted::destroyed = 0;

struct Pinned
{
  int value;
  Pinned(int value) : value(value) {}
  Pinned(const Pinned&) = delete;
  Pinned(Pinned&&) = delete;
};

struct Holder
{
  Counted counted;
  Holder(int side) : counted((side, Counted(7))) {}
};

Counted counted(int side) { return (side, Counted(4)); }
Pinned pinned(int side) { return (side, Pinned(5)); }

int main()
{
  {
    Counted result = counted(1);
    println(result.value);
  }
  println(Counted::moved, " moved, ", Counted::destroyed, " destroyed");
  Pinned result = pinned(1);
  println(result.value);
  {
    int side = 1;
    Counted local = (side, Counted(6));
    Holder holder(side);
    Counted chosen = side ? (side, Counted(8)) : Counted(9);
    auto lambda = (side, [kept = Counted(10)] { return kept.value; });
    Counted* made = new Counted((side, Counted(11)));
    println(local.value, " ", holder.counted.value, " ", chosen.value, " ", lambda(), " ", made->value);
    delete made;
  }
  println(Counted::moved, " moved, ", Counted::destroyed, " destroyed");
  return 0;
}
