// spec: a member whose constructor throws was never constructed, so its destructor does not run while the constructor unwinds; only the members built before it are destroyed (C++ [except.ctor] 3), also when the constructor's body calls a function that may throw: one Part destroyed of the three objects, the one built before the throw (`0 0 1`)
// factorio: E's exceptions battery against C++ (ex1, 2026-11-06): on Windows, Part's destructor ran for the member whose constructor threw, whenever the class's constructor body called a function that may throw (`1 1 1`); on Linux `0 0 1`
// kppc: --no-optimize
// pending on windows: the cleanup that destroys the member covers its own constructor call (B); built unoptimized (`kppc: --no-optimize`) in every configuration, since the optimized build, its cleanups rearranged, happened to get it right and made the release spec run report it fixed
extern "C" import "stdio.h";
int destroyed = 0;
void work()
{
  if (destroyed < 0)
    throw 3;
  printf("not reached ");
}
struct Part
{
  int id;
  Part(int i) : id(i)
  {
    if (i == 1)
      throw i;
  }
  ~Part() { ++destroyed; }
};
class Whole
{
public:
  Part part{1};
  Whole() { work(); }
};
class Listed
{
public:
  Part part;
  Listed() : part(1) { work(); }
};
class Two
{
public:
  Part a{2};
  Part b{1};
  Two() { work(); }
};
int main()
{
  try { Whole w; } catch (int) {}
  printf("%d ", destroyed);
  destroyed = 0;
  try { Listed l; } catch (int) {}
  printf("%d ", destroyed);
  destroyed = 0;
  try { Two t; } catch (int) {}
  printf("%d\n", destroyed);
  return 0;
}
