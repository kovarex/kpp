// spec: the allocation functions new and delete do not call yet are errors where declared, never silently passed by: a class's own operator new[] and operator delete[], a polymorphic class's own operator delete (C++ calls the deleted object's class's through a virtual destructor), and a program's own global operator new ([expr.new] 9, [expr.delete] 10)
// error: class_operator_new_array_is_not_supported_yet.kpp:9: error: a class's own operator new[] is not supported yet
// error: class_operator_new_array_is_not_supported_yet.kpp:10: error: a class's own operator delete[] is not supported yet
// error: class_operator_new_array_is_not_supported_yet.kpp:16: error: a polymorphic class's own operator delete is not supported yet
// error: class_operator_new_array_is_not_supported_yet.kpp:18: error: a program's own global operator new (a replacement of the library's, or a form of its own) is not supported yet
// factorio: the class operator new work (A's find); kppc refused every one of them before
struct Arrays
{
  void* operator new[](size_t size) { return malloc(size); }
  void operator delete[](void* p) { free(p); }
};
class Polymorphic
{
public:
  virtual ~Polymorphic() {}
  void operator delete(void* p) { free(p); }
};
void* operator new(usize bytes, int tag) { return malloc(bytes); }
int main()
{
  return 0;
}
