// spec: a protected member of a base named through a class N (`c->forceID` with a Character*, `handle->forceID` through a Handle<Character>'s operator->) may be named in a friend of N, as C++'s [class.access.base] 5 has it
// factorio: EntityWithOwner::forceID in AssociatedCharacters (a friend of Character, through Targeter<Character>), SegmentEngine and LatencyState
// kpp: --access-warnings
// warning: Entity::forceID is protected, named in Associated::direct, which a friend class declaration allows
// warning: Entity::forceID is protected, named in Associated::viaHandle, which a friend class declaration allows
class Entity
{
protected:
  int forceID = 3;
};
class Character : public Entity
{
  friend class Associated;
};
template<class T>
class Handle
{
  T* p;
public:
  Handle(T* t) : p(t) {}
  T* operator->() const { return this.p; }
};
class Associated
{
public:
  int direct(Character* c) { return c->forceID; }
  int viaHandle(Handle<Character>& h) { return h->forceID; }
};
int main()
{
  Character c;
  Handle<Character> h(&c);
  Associated a;
  println(a.direct(&c), " ", a.viaHandle(h));
  return 0;
}
