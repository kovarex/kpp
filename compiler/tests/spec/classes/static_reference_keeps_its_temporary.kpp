// spec: a temporary that a reference of static storage binds lives as long as the reference, the whole program ([class.temporary]/6), and is destroyed at its end: a global `const T& g = T(1)`, one of a scalar computed at run time, one of a derived class bound to its base, and an aggregate's reference member given a temporary, global or static local; each is an object of static storage of its own, never destroyed (as no global is yet), where until 2026-11-05 it was the initialising function's and was destroyed at its end, the reference dangling
class T
{
public:
  int id;
  T(int i) : id(i) { println("ctor ", id); }
  T(const T& o) : id(o.id + 100) { println("copy ", id); }
  virtual ~T() { println("dtor ", id); }
  virtual int get() const { return id; }
};
class D : public T { public: int extra; D(int i) : T(i), extra(i * 10) {} int get() const override { return id + extra; } };
struct Holder { const T& ref; int n; };
int seven() { return 7; }
const T& one = T(1);
const int& eight = seven() + 1;
const T& base = D(2);
Holder held{T(3), 4};
int noise(int a)
{
  int x[256];
  for (int i = 0; i < 256; ++i)
    x[i] = a + i;
  return x[255];
}
int main()
{
  println("main ", noise(1));
  println(one.get(), " ", eight, " ", base.get(), " ", held.ref.get(), " ", held.n);
  for (int i = 0; i < 2; ++i)
  {
    static Holder kept{T(5), 6};
    println(noise(i), " ", kept.ref.get(), " ", kept.n);
  }
  return 0;
}
