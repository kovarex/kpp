// spec: a return in a destructor's body leaves the body, and the members and bases are destroyed after it as at its end: `~Guard() { if (this->early) return; ... }` still destroys Guard's members and its base
// factorio: CargoBayResizeHelper's destructor returns early after `this->hub->recalculateInventorySize();`: its member `Targeter<SpacePlatformHub> hub` was never destroyed, so it stayed in the hub's list after the helper's stack frame was gone, and destroying the hub faulted in Targeters::clear (CargoBay and SpacePlatform stop); SpaceMapGui's `if (!gameView) return;` left its widgets alive: 71 leaked widgets in AudioGui's space map tests, a bad address in agui::Widget's destructor stopping SpaceMap and BrowseHistory. All five pass with those two destructors written without the returns (23 converted destructors have a return)
int destroyed = 0;
struct Member
{
  int id = 0;
  ~Member() { destroyed += 1; }
};
struct Base
{
  ~Base() { destroyed += 10; }
};
struct Guard : Base
{
  bool early = false;
  Member a;
  Member b;
  ~Guard()
  {
    if (this.early)
      return;
    destroyed += 100;
  }
};
int main()
{
  {
    Guard g;
  }
  std::print(destroyed, " ");
  destroyed = 0;
  {
    Guard g;
    g.early = true;
  }
  std::println(destroyed);
  return 0;
}
