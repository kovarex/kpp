// spec: a handler of a pointer type by value or by const reference takes a thrown pointer that converts to it, and nullptr, as C++'s [except.handle] 3.3 and 3.4 have it: `catch (Second* p)` a thrown `Both*`, moved to its Second part (`2 3`), `catch (const Both* p)` a `Both*` (`3`), `catch (void* p)` any object pointer (`1`), `catch (Base* const& p)` a `Derived*`, a null `Derived*` and nullptr (null, `-1 0`), `catch (const void* p)` a string literal; `catch (char* p)` no `const char*`, and `catch (Base*& p)`, a non-const reference, its own type alone (3.1: `exact`); g++ prints the same, but for the `Base*&` handler, which g++ (whose type_info drops the reference) and MSVC (which calls a later `Base* const&` handler unreachable) also give a converted pointer
// found by thread B (2026-11-05), comparing kpp with clang: a thrown pointer's descriptor listed no conversions, so only a handler of its own type took it and the others fell through to `catch (...)`; no code of the game or of kpp throws a pointer
class First
{
public:
  int a = 1;
  virtual ~First() {}
};
class Second
{
public:
  int b = 2;
  virtual ~Second() {}
  virtual int which() const { return 2; }
};
class Both : public First, public Second
{
public:
  int c = 3;
  int which() const override { return 3; }
};
Both object;
struct A
{
  int a = 1;
};
struct B
{
  int b = 2;
};
struct C : A, B
{
  int c = 3;
};
C plain;
int which(int kind)
{
  try
  {
    if (kind == 0)
      throw &plain;
    if (kind == 1)
      throw static_cast<C*>(nullptr);
    if (kind == 2)
      throw nullptr;
    if (kind == 3)
      throw "text";
    if (kind == 4)
      throw static_cast<const C*>(&plain);
    if (kind == 5)
      throw static_cast<B*>(&plain);
    throw 5;
  }
  catch (B*& exact)
  {
    std::print("exact ", exact ? exact->b : -1, " ");
    return 1;
  }
  catch (B* const& p)
  {
    std::print("B* const& ", p ? p->b : -1, " ", p == static_cast<B*>(&plain) ? 1 : 0, " ");
    return 2;
  }
  catch (char* p)
  {
    std::print("char* ");
    return 3;
  }
  catch (const void* p)
  {
    std::print("const void* ", p == static_cast<const void*>(&plain) ? 1 : 0, " ");
    return 4;
  }
  catch (...)
  {
    std::print("any ");
    return 5;
  }
}
int main()
{
  try
  {
    throw &object;
  }
  catch (Second* p)
  {
    std::println(p->b, " ", p->which());
  }
  catch (...)
  {
    std::println("other");
  }
  try
  {
    throw &object;
  }
  catch (const Both* p)
  {
    std::println(p->c);
  }
  catch (...)
  {
    std::println("other");
  }
  try
  {
    throw &object;
  }
  catch (void* p)
  {
    std::println(p == static_cast<void*>(&object) ? 1 : 0);
  }
  catch (...)
  {
    std::println("other");
  }
  for (int kind = 0; kind <= 6; ++kind)
    std::println("| ", which(kind));
  return 0;
}
