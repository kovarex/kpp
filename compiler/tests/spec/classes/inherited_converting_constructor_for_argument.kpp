// spec: a constructor inherited with `using Base::Base;` converts implicitly, as the derived class's own converting constructor would: a SignalID passed for a SignalFilter parameter, of a function or of another class's constructor, or assigned to a SignalFilter, constructs the SignalFilter through the base's `Filter(const WithQuality<IdType>&)`
// factorio: LogisticFilter(SignalID(itemID), value) and its five siblings (TransitionalRequestLogic::request, ItemRequestProxy::setRequests, ConstantCombinatorControlBehavior, ...) and ChooseOrbitalRequestButton::selectFromSignalID: SignalFilter inherits IDWithQualityFilter<SignalIDBase>'s constructors (`using super::super;`), one of which takes the SignalID; PipelineStateManager's `spritePipelineStatesByBlendMode[i] = createPipelineStateObject(spec)` (SpritePipelineState inherits PipelineStateHandle(std::unique_ptr<PipelineStateObject>), four functions)
struct SignalIdBase
{
  int value = 0;
};
template<typename IdType>
struct WithQuality
{
  WithQuality(IdType id, int quality) : baseId(id), quality(quality) {}
  IdType baseId;
  int quality = 0;
};
using SignalId = WithQuality<SignalIdBase>;
template<typename IdType>
class Filter
{
public:
  Filter() = default;
  implicit Filter(const WithQuality<IdType>& id) : baseId(id.baseId), quality(id.quality) {}
  IdType baseId;
  int quality = 0;
};
class SignalFilter : public Filter<SignalIdBase>
{
public:
  using super = Filter<SignalIdBase>;
  using super::super;
  SignalFilter(int raw) { this.baseId.value = raw; }
};
class Holder
{
public:
  Holder(SignalFilter filter, int count) : filter(filter), count(count) {}
  Holder(StringView name, int count) : count(-1) {}
  SignalFilter filter;
  int count;
};
int quality(const SignalFilter& filter) { return filter.quality; }
int main()
{
  SignalIdBase base;
  base.value = 4;
  SignalFilter direct = SignalId(base, 1);
  Holder holder(SignalId(base, 2), 3);
  Array<SignalFilter, 2> filters;
  filters[1] = SignalId(base, 6);
  println(direct.quality, " ", holder.filter.baseId.value, " ", holder.filter.quality, " ", holder.count, " ", quality(SignalId(base, 5)), " ", filters[1].quality);
  return 0;
}
