// spec: an object assigned from a value that a constructor inherited with `using Base::Base;` converts: the temporary is built by the inherited constructor, then moved in
// factorio: PipelineStateManager's `this->spritePipelineStatesByBlendMode[mode] = this->graphics.createPipelineStateObject(spec);`, SpritePipelineState inheriting PipelineStateHandle's constructor from UniquePtr<PipelineStateObject>: "assigning an unrelated class" (six setup functions)
class Object
{
public:
  int value = 5;
};
class Handle
{
public:
  Handle() = default;
  implicit Handle(std::UniquePtr<Object>&& o) : object(std::move(o)) {}
  std::UniquePtr<Object> object;
};
class SpriteState : public Handle
{
public:
  using Handle::Handle;
  int get() const { return this.object ? this.object->value : -1; }
};
std::UniquePtr<Object> make() { return std::makeUnique<Object>(); }
int main()
{
  std::Array<SpriteState, 2> states;
  states[1] = make();
  std::println(states[0].get(), " ", states[1].get());
  return 0;
}
