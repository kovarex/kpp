// spec: a member function the class declares hides the base's of the same parameter types and qualifiers that a using-declaration brings in (C++ [namespace.udecl] 15), so a call of it is no ambiguity: ArtilleryTurret's `getInventory(uint8) override` beside `using super::getInventory;`, virtual or not; the base's other overloads stay candidates
struct Entity
{
  virtual int inventory(uint8_t index) { return 1; }
  int inventory(uint8_t index) const { return 2; }
  int name(int x) { return 10; }
  int name(const char* s) { return 11; }
  virtual ~Entity() = default;
};
struct Turret : Entity
{
  int inventory(uint8_t index) override { return 3; }
  using Entity::inventory;
  int name(int x) { return 20; }
  using Entity::name;
};
int main()
{
  Turret turret;
  const Turret& view = turret;
  Entity& base = turret;
  println("{} {} {} {} {}", turret.inventory(0), view.inventory(0), base.inventory(0), turret.name(1), turret.name("a"));
  return 0;
}
