// spec: a member no class declares is the checker's error at each use, naming the class: a field or a function, through `.` and `->`, of a class and of a template's instance; a function's other errors still show (codegen stopped at the first with "does not support a member access that did not resolve to a field")
// found by thread E's batteries (2026-11-06): that wording for every missing member
// error: missing_member_is_a_front_end_error.kpp:15: error: Plain has no member 'missing'
// error: missing_member_is_a_front_end_error.kpp:17: error: Plain has no member 'missingToo'
// error: missing_member_is_a_front_end_error.kpp:18: error: Plain has no member 'call'
// error: missing_member_is_a_front_end_error.kpp:19: error: Plain has no member 'callToo'
// error: missing_member_is_a_front_end_error.kpp:21: error: Box<int32> has no member 'nothing'
struct Plain { int x = 0; };
template<class T> struct Box { T v; };
int main()
{
  Plain a;
  Plain* p = &a;
  Box<int> b;
  int n = a.missing;
  n += a.x;
  n += p->missingToo;
  a.call();
  p->callToo(1);
  n += b.v;
  n += b.nothing;
  return n;
}
