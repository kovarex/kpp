// spec: an object of a class with `operator bool()` and `operator Enum()` (a scoped enum, which converts to no bool) assigned to a bool: operator bool converts it, as for `bool b = x;` and `if (x)`; assigned to an Enum, operator Enum does
// factorio: LuaEntity::luaRotate's and luaFlip's `result = this->entityTarget->rotate(rotateDirection);` and AssemblingMachine::fastReplaceSetup's `recipeCopied = this->setupForCrafting(...);`: ActionResult has `operator bool()` beside `operator Enum()`
class ActionResult
{
public:
  enum class Enum
  {
    Success, Ignorable, GenericFail
  };
  using enum Enum;
  constexpr ActionResult(Enum value) : value(value) {}
  operator bool() const { return this->value == Success || this->value == Ignorable; }
  operator Enum() const { return this->value; }
  Enum value;
};
ActionResult act(int x) { return x ? ActionResult::Success : ActionResult::GenericFail; }
int main()
{
  bool declared = act(0);
  bool tested = false;
  if (act(1))
    tested = true;
  bool assigned = false;
  assigned = act(1);
  ActionResult::Enum kind = ActionResult::Success;
  kind = act(0);
  println("{} {} {} {}", declared, tested, assigned, kind == ActionResult::GenericFail);
  return 0;
}
