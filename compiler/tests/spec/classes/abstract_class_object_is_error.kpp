// spec: an object of a class whose pure virtual function nothing overrides (it is abstract) is an error, as in C++: here Derived's write(int) does not override Base's write(unsigned), so `Derived d;` makes an object of an abstract class
// factorio: found with classes/override_of_nothing_is_error: a stream deriving from OutStream whose old writeBytes(const char*, int) no longer overrode the pure writeBytes(const char*, ContainerSize) was still made, and writing to it called the pure virtual function (an access violation)
// error: abstract_class_object_is_error.kpp:17: error: an object of the abstract class Derived
class Base
{
public:
  virtual void write(unsigned count) = 0;
  virtual ~Base() {}
};
class Derived : public Base
{
public:
  void write(int count) { std::println(count); }
};
int main()
{
  Derived d;
  Base& b = d;
  b.write(3);
  return 0;
}
