// spec: a base-class initializer given an object of the derived class (`Name(const Name& n) : Label(n)`, `: Plain(d)`) copies or moves the base part through the base's own copy or move constructor, the derived-to-base conversion of the argument
// factorio: Filesystem::Path's copy and move constructors (`Path(Path&& p) : path(std::move(p))`, `explicit Path(const Path& p) : path(p)`), over std::filesystem::path
struct Label
{
  std::String value;
  Label() {}
  implicit Label(const char* v) : value(v) {}
};
struct Name : Label
{
  Name() {}
  implicit Name(const char* s) : Label(s) {}
  Name(const Name& n) : Label(n) {}
  Name(Name&& n) : Label(std::move(n)) {}
};
struct Plain
{
  int v = 1;
};
struct Derived : Plain
{
  Derived() {}
  Derived(const Derived& d) : Plain(d) {}
};
int main()
{
  Name a("abc");
  Name b(a);
  Name c(std::move(b));
  Derived d;
  d.v = 5;
  Derived e(d);
  std::println(c.value, " ", e.v);
  return 0;
}
