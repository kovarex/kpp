// spec: inheriting constructors through an alias of the base's injected name (`using super = Template; using super::super;` in a class deriving from Template<Proto, int>): super is the base instance, and `new Proto(7, nullptr)` runs the base's constructor
// factorio: the Lua prototype wrappers (`using super = LuaPrototypeTemplate; using super::super;` in LuaEntityPrototype and its siblings, 197 constructions)
struct lua_State;
template<typename TemplateType, typename IDType>
class Template
{
public:
  Template(IDType id, lua_State* L) : id(id) {}
  virtual ~Template() {}
  IDType id;
};
class Proto : public Template<Proto, int>
{
public:
  using super = Template;
  using super::super;
  int viaSuper() { super* s = &this; return s->id; }
};
int main()
{
  Proto* p = new Proto(7, nullptr);
  println(p->viaSuper());
  delete p;
  return 0;
}
