// spec: two conversion operators on one class (operator bool and operator String)
// factorio: 376 conversion operators in 292 files
struct Vec
{
  int x, y;
  operator bool() const { return this.x != 0 || this.y != 0; }
  implicit operator std::String() const { return std::format("({}, {})", this.x, this.y); }
};
int main()
{
  Vec v{1, 2};
  std::String text = v;
  std::println(text, " ", bool(v));
  return 0;
}
