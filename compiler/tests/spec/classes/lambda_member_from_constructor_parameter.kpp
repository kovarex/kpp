// spec: a constructor that takes a lambda by value and initialises a member from it (`Holder(int base, F f) : base(base), f(f) {}`), then calls it
// factorio: ScopedCallback's constructor, the library's TransformView (transformView(range, lambda)), Function's constructor from a callable
// pending: the IR passes the closure parameter as a pointer and stores it as the closure value ('%p2' defined with type 'ptr' but expected the closure type)
template<typename F>
struct Holder
{
  int base;
  F f;
  Holder(int base, F f) : base(base), f(f) {}
  int call(int x) const { return this->f(x) + this->base; }
};
int main()
{
  int k = 10;
  auto lambda = [k](int x) { return x + k; };
  Holder<decltype(lambda)> h(100, lambda);
  println("{}", h.call(5));
  return 0;
}
