// spec: a class template deriving from its parameter (`class Dragging : public W`) may name the protected members of the base an instance's argument makes (`Inherited::paint()` with W a Table)
// factorio: DragPaneWidget<agui::Table, ...> calling agui::Layout's and agui::Widget's protected recursivePaint functions
// kpp: --access-warnings
class Widget
{
protected:
  virtual int paint() { return 1; }
};
class Table : public Widget
{
protected:
  int paint() override { return 2; }
};
template<class W>
class Dragging : public W
{
  using Inherited = W;
public:
  int paint() override { return Inherited::paint() + 10; }
};
int main()
{
  Dragging<Table> d;
  std::println(d.paint());
  return 0;
}
