// spec: at compile time a qualified name chooses the subobject of a base the class has twice, as at run time: `Q::id` and `Q::get()` of Q's Id, `this->Q::id` too; clang and g++ print `12 12 2`
// found by thread J's inheritance battery (h10, 2026-11-06)
extern "C" int printf(const char* format, ...);
struct Id
{
  int id;
  constexpr Id(int v) : id(v) {}
  constexpr int get() const { return id; }
};
struct P : Id { constexpr P() : Id(1) {} };
struct Q : Id { constexpr Q() : Id(2) {} };
struct Both : P, Q
{
  constexpr int fields() const { return P::id * 10 + Q::id; }
  constexpr int calls() const { return P::get() * 10 + Q::get(); }
  constexpr int arrow() const { return this->Q::id; }
};
constexpr int atCompileTimeFields = Both{}.fields();
constexpr int atCompileTimeCalls = Both{}.calls();
constexpr int atCompileTimeArrow = Both{}.arrow();
int main()
{
  printf("%d %d %d\n", atCompileTimeFields, atCompileTimeCalls, atCompileTimeArrow);
  return 0;
}
