// spec: when the constructor of a new-expression's object throws, the memory goes back through the class's operator delete: the usual one for `new T`, for a placement form `new (args) T` the one whose parameters after the first are its operator new's, and none when the class declares no such one ([expr.new] 26-27)
// factorio: the class operator new work (A's find that a class's own operator new was refused); clang's output
struct Thrower
{
  Thrower() { throw 5; }
  void* operator new(size_t size) { println("thrower new"); return malloc(size); }
  void operator delete(void* p) { println("thrower delete"); free(p); }
};
struct Arena { char bytes[64]; int used = 0; };
struct Pooled
{
  int v;
  Pooled(int x) : v(x) { if (x < 0) throw x; }
  void* operator new(size_t size, Arena& a) { println("arena new ", size); void* p = a.bytes + a.used; a.used += int(size); return p; }
  void operator delete(void*, Arena& a) { println("arena delete ", a.used); }
};
struct NoDelete
{
  NoDelete() { throw 1; }
  void* operator new(size_t size, int tag) { println("tagged new ", tag); return malloc(size); }
};
int main()
{
  try { new Thrower; } catch (int x) { println("caught ", x); }
  Arena arena;
  Pooled* p = new (arena) Pooled(7);
  println(p->v, " ", arena.used);
  try { new (arena) Pooled(-1); } catch (int x) { println("caught ", x); }
  try { new (3) NoDelete; } catch (int x) { println("caught ", x); }
  return 0;
}
