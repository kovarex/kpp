// spec: `override` of nothing in a class template is an error at the instance, when no call names the member too: C++ checks it as the class is instantiated ([class.virtual] 5)
// pending: an instance's member reaches checkOverride only through a call by name, so this compiles, and a call through the base runs the base's function (thread A, 2026-11-06: the error needs a unit a compile server can forget, so it lands with required `override`'s error)
// error: override_of_nothing_in_an_instance_is_error.kpp:13: error: value is marked override but overrides no virtual function
class Base
{
public:
  virtual ~Base() {}
  virtual int value() const { return 1; }
};
template<class T> class Over : public T
{
public:
  int value(int extra) const override { return extra; }
};
int main()
{
  Over<Base> o;
  Base* b = &o;
  return b->value();
}
