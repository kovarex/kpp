// spec: in a const member function a data member is const (unless mutable): its member operators are chosen as for a const object (`T* operator[](int) const` over `T& operator[](int)`), and a const reference initialised directly from a const member (`const Sprite& s(proto->horizontal);`) binds to it without a copy (Sprite's copy constructor is deleted)
// found by the resolver thread: TerritoryManager::save's `this->territoriesByChunk.data[x]` (InfiniteVector's two operator[]), Pipe.kpp's `const Sprite& s(this->getPrototype()->horizontal)`
struct Sprite
{
  int v = 3;
  Sprite() = default;
  Sprite(const Sprite&) = delete;
  Sprite(Sprite&&) = default;
};
struct Proto { Sprite horizontal; };
struct Holder
{
  Proto proto;
  const Proto* getPrototype() const { return &this->proto; }
  int one() const
  {
    const Sprite& s(this->getPrototype()->horizontal);
    const Sprite& t{this->proto.horizontal};
    return s.v + t.v;
  }
};
template<class T>
struct InfiniteVector
{
  T data[4];
  T& operator[](int32_t i) { return this->data[i]; }
  T* operator[](int32_t i) const { return const_cast<T*>(&this->data[i]); }
};
struct Territory { int id = 9; };
struct Manager
{
  InfiniteVector<Territory> byChunk;
  int save() const
  {
    const Territory* column = this->byChunk[1];
    return column->id;
  }
  int load() { return this->byChunk[2].id + 1; }
};
int main()
{
  Holder h;
  Manager m;
  println("{} {} {}", h.one(), m.save(), m.load());
  return 0;
}
