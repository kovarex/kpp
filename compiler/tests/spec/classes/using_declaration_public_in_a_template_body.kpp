// spec: a protected member of a base made public by a using-declaration through an alias of the base (`using SuperType = Base<...>; public: using SuperType::Num;`) is public where a class template's body names it through a member of a dependent type (`this.elements.Num()`, elements an Array<T>), as outside a template; clang prints the same
// found by thread UE (2026-11-22): Unreal's TSet naming its TSparseArray's Num was "TSparseArrayBase::Num is protected, named in TSet::Compact" (46 errors in converted Core): the check of the template's body had no class the member was named through, so the using-declaration was not seen
template<int N>
class Base
{
protected:
  int Num() const { return N; }
};

template<typename T>
class Array : public Base<int(sizeof(T))>
{
  using SuperType = Base<int(sizeof(T))>;
public:
  using SuperType::Num;
};

template<typename T>
class Holder
{
public:
  Array<T> elements;
  int size() const { return this.elements.Num(); }
  int through(const Array<T>* p) const { return p->Num(); }
};

int main()
{
  Holder<int> h;
  Holder<short> s;
  Array<char> a;
  std::println(h.size(), " ", s.size(), " ", s.through(&s.elements), " ", a.Num());
  return 0;
}
