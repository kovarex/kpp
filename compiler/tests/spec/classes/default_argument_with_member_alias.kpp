// spec: a default argument naming the callee's class member alias (`ModifierValueType maximumValue = Limits<ModifierValueType>::max()`, with `using ModifierValueType = double;` in the class) is typed in the callee's scope wherever a call leaves it out, here another class's member initializer
// factorio: CharacterModifier's constructor, `ModifierValueType maximumValue = std::numeric_limits<ModifierValueType>::max()`, called from CharacterModifiers' two constructors
class CharacterModifier
{
public:
  using ModifierValueType = double;
  CharacterModifier(int type, ModifierValueType defaultValue = 0, ModifierValueType maximumValue = std::Limits<ModifierValueType>::max())
    : type(type), value(defaultValue), maximum(maximumValue) {}
  int type;
  ModifierValueType value;
  ModifierValueType maximum;
};
class CharacterModifiers
{
public:
  CharacterModifiers() : speed(1), reach(2, 5.0) {}
  CharacterModifier speed;
  CharacterModifier reach;
};
int main()
{
  CharacterModifiers modifiers;
  std::println(modifiers.speed.maximum > 1e300, " ", modifiers.reach.value);
  return 0;
}
