// spec: a new-expression of a class with its own operator new calls it with the size, and a delete-expression calls the class's operator delete after the destructor, a base's when the class inherits it, the sized form with the class's size; `::new` and `::delete` pass them by, and a null pointer's delete calls none ([expr.new] 9, [expr.delete] 10, [class.free]); operator new and operator delete members are static whether or not they say so
// factorio: found checking C++17's sequencing for new (templates thread): kppc allocated with the global functions whatever the class declared (0 0 3 where C++ has 1 1 3), then refused a class's own; clang's output
int allocations = 0;
int deletions = 0;
struct Counted
{
  int value;
  Counted(int v) : value(v) {}
  static void* operator new(size_t size) { ++allocations; return malloc(size); }
  static void operator delete(void* p) { ++deletions; free(p); }
};
struct Sized
{
  long long a, b;
  void* operator new(size_t size) { println("new ", size); return malloc(size); }
  void operator delete(void* p, size_t size) { println("delete ", size); free(p); }
};
struct Larger : Sized { long long c; };
int main()
{
  Counted* c = new Counted(3);
  int v = c->value;
  delete c;
  println(allocations, " ", deletions, " ", v);
  Counted* g = ::new Counted(4);
  ::delete g;
  Counted* none = nullptr;
  delete none;
  println(allocations, " ", deletions);
  Sized* s = new Sized;
  delete s;
  Larger* l = new Larger;
  delete l;
  return 0;
}
