// spec: `scale < minimum` with a scalar on the left and a class whose operator<=>(const double&) takes it is a bool wherever its type matters (a println argument, an auto variable), as `0 < (minimum <=> scale)` is; and `scale <=> minimum` itself is the reversed `0 <=> (minimum <=> scale)`, the order turned round
// found by the code generator thread in the converted game: CommandProcessor's `println(scale < minimum)` with a StrongTypedef<double> (the walk typed the comparison as unknown, C++20's reversed candidate missing)
template<typename T, typename Tag>
struct StrongTypedef
{
  T value;
  StrongTypedef(T v) : value(v) {}
  auto operator<=>(const T& other) const { return this.value <=> other; }
  bool operator==(const T& other) const { return this.value == other; }
  auto operator<=>(const StrongTypedef& other) const = default;
};
struct ScaleTag {};
using Scale = StrongTypedef<double, ScaleTag>;
int main()
{
  Scale minimum(2.0);
  double low = 1.0;
  double high = 3.0;
  auto below = low < minimum;
  std::println(below, " ", high < minimum, " ", low >= minimum, " ", high > minimum, " ", low == minimum);
  std::println((low <=> minimum) < 0, " ", (high <=> minimum) > 0, " ", (2.0 <=> minimum) == 0);
  return 0;
}
