// spec: an anonymous union in a class template whose members name the template's own nested types and parameters (`union { Long longStr; char shortStr[N]; };` in Label<N>) is laid out with the instantiation's arguments
// factorio: ImmutableStringTemplate<N> (`union { SharedString sharedStr; LongStr longStr; char shortStr[short_string_size]; }`), inside PropertyTree and everything holding one
template<int N>
struct Label
{
  struct Long
  {
    char* ptr;
    uint32_t len;
  };
  union
  {
    Long longStr;
    char shortStr[N];
  };
  bool isShort = true;
};
int main()
{
  Label<16> t;
  t.shortStr[0] = 'k';
  t.shortStr[1] = 0;
  std::println(sizeof(t) >= 17, " ", t.shortStr[0]);
  t.longStr.len = 7;
  std::println(t.longStr.len);
  return 0;
}
