// spec: virtual functions, override, pure virtual, virtual destructor, base calls
// factorio: 16323 override, 1158 pure virtual
class Shape
{
public:
  virtual ~Shape() { println("~Shape"); }
  virtual int area() const = 0;
  virtual const char* name() const { return "shape"; }
  int doubled() const { return this->area() * 2; }
};
class Square : public Shape
{
public:
  int side;
  Square(int side) : side(side) {}
  ~Square() override { println("~Square"); }
  int area() const override { return this->side * this->side; }
  const char* name() const override { return "square"; }
};
class Unit : public Square
{
public:
  Unit() : Square(1) {}
  const char* name() const override { return Square::name(); }
};
int main()
{
  Vector<Shape*> shapes;
  shapes.push_back(new Square(3));
  shapes.push_back(new Unit());
  for (Shape* s : shapes)
    println(StringView(s->name()), " ", s->area(), " ", s->doubled());
  for (Shape* s : shapes)
    delete s;
  return 0;
}
