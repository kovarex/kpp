// spec: `new T(...)` of a class with its own static operator new allocates through it, and `delete` of one with its own operator delete frees through it ([expr.new] 9, [expr.delete] 10), the allocation before the initializer's arguments ([expr.new] 19)
// factorio: found checking C++17's sequencing for new (templates thread): kppc ignores a class's operator new and operator delete (0 0 3 where C++ has 1 1 3); the converted game declares none
// pending: kppc allocates with the global allocation functions whatever the class declares
int allocations = 0;
int deletions = 0;
struct Counted
{
  int value;
  Counted(int v) : value(v) {}
  static void* operator new(size_t size) { ++allocations; return malloc(size); }
  static void operator delete(void* p) { ++deletions; free(p); }
};
int main()
{
  Counted* c = new Counted(3);
  int v = c->value;
  delete c;
  println("{} {} {}", allocations, deletions, v);
  return 0;
}
