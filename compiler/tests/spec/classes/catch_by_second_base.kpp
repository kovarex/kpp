// spec: catch takes a thrown class by any of its bases, a second base included (the handler sees that base's subobject)
// found writing multiple inheritance: the descriptor a throw carries listed only the first base
class Error
{
public:
  int code = 5;
  virtual ~Error() {}
};
class Context
{
public:
  int line = 42;
  virtual ~Context() {}
  virtual int where() const { return this.line; }
};
class ParseError : public Error, public Context
{
public:
  ParseError() { this.line = 7; }
  int where() const override { return this.line * 10; }
};
int main()
{
  try
  {
    throw ParseError();
  }
  catch (const Context& c)
  {
    std::println("context ", c.where(), " ", c.line);
  }
  try
  {
    throw ParseError();
  }
  catch (const Error& e)
  {
    std::println("error ", e.code);
  }
  return 0;
}