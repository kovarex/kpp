// spec: an assignment from a scalar prvalue picks `operator=(char&&)` over `operator=(const char&)` and binds a temporary of the value to it: from a function's result, from a dereferenced iterator's char, and in a function template (std::copy's `*out = *first`); an lvalue takes the `const char&` one
// factorio: the tests' ForkLogic.cpp `std::copy(std::istreambuf_iterator<char>(in), {}, std::back_inserter(buffer))`: copy's `*out = *first` assigns the iterator's char to BackInsertIterator<String>, whose operator=(value_type&&) was passed the char's value where its address belongs; clang rejects that module, which fails the whole build (blocks making IstreambufIterator a template as std's is)
struct Sink
{
  int got = 0;
  Sink& operator=(const char& c) { this.got = 1; return this; }
  Sink& operator=(char&& c) { this.got = c == 'x' ? 2 : 3; return this; }
};
struct Source
{
  char operator*() const { return 'x'; }
};
char make()
{
  return 'x';
}
template<typename In, typename Out>
int transfer(In in, Out out)
{
  out = *in;
  return out.got;
}
int main()
{
  Sink s;
  s = make();
  Source source;
  Sink t;
  t = *source;
  Sink u;
  char lvalue = 'y';
  u = lvalue;
  std::println(s.got, " ", t.got, " ", transfer(source, Sink()), " ", u.got);
  return 0;
}
