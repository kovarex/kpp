// spec: a friend function defined in its class (a hidden friend) is a function of the class's namespace that argument-dependent lookup finds through an argument of the class, a name and an operator alike, in a class and in a class template's instances (one function per instance)
// factorio: Optional's hidden friend operators, which the converter moves out to namespace scope; the C++ libraries' (glm, imgui) idiom
class Coin
{
  int cents;
public:
  Coin(int c) : cents(c) {}
  friend int valueOf(const Coin& c) { return c.cents; }
  friend bool operator<(const Coin& a, const Coin& b) { return a.cents < b.cents; }
};
template<class T>
class Holder
{
  T item;
public:
  Holder(T t) : item(t) {}
  friend T unwrap(const Holder& h) { return h.item; }
  friend bool operator==(const Holder& a, const Holder& b) { return a.item == b.item; }
};
int main()
{
  Coin a(1), b(2);
  Holder<int> h(3), g(3), k(4);
  println(valueOf(b), " ", a < b, " ", b < a, " ", unwrap(k), " ", h == g, " ", h == k);
  return 0;
}
