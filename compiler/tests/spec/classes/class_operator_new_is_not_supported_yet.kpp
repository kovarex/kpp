// spec: a class's own static operator new or operator delete (and a replacement of the global ones) is a compile error until `new` and `delete` call it ([expr.new] 9, [expr.delete] 10), never silently passed by for the library's allocation
// error: class_operator_new_is_not_supported_yet.kpp:11: error: a class's own operator new or operator delete is not supported yet
// error: class_operator_new_is_not_supported_yet.kpp:12: error: a class's own operator new or operator delete is not supported yet
// factorio: found checking C++17's sequencing for new (templates thread): kppc allocated with the global functions whatever the class declared (0 0 3 where C++ has 1 1 3); the converted game, the overrides and the library declare none
int allocations = 0;
int deletions = 0;
struct Counted
{
  int value;
  Counted(int v) : value(v) {}
  static void* operator new(size_t size) { ++allocations; return malloc(size); }
  static void operator delete(void* p) { ++deletions; free(p); }
};
int main()
{
  Counted* c = new Counted(3);
  int v = c->value;
  delete c;
  println(allocations, " ", deletions, " ", v);
  return 0;
}
