template <class Tag>
class NamedBool
{
public:
  enum class Enum : uint8_t {False, True};
  using Enum::True;
  using Enum::False;
  constexpr NamedBool() = default;
  implicit constexpr NamedBool(Enum value) : value(value == Enum::True) {}
  static constexpr NamedBool fromBool(bool value) { return value ? True : False; }
  static int code(Enum e)
  {
    switch (e)
    {
      case True: return 7;
      case NamedBool::False: return 3;
    }
    return 0;
  }
  constexpr bool asBool() const { return this.value; }
private:
  bool value = false;
};
template <class Tag>
class OldBool
{
public:
  enum class Enum : uint8_t {False, True};
  static constexpr Enum True = Enum::True;
  static constexpr Enum False = Enum::False;
  implicit constexpr OldBool(Enum value) : value(value == Enum::True) {}
  static OldBool fromBool(bool value) { return value ? OldBool::True : OldBool::False; }
  bool asBool() const { return this.value; }
private:
  bool value = false;
};
class FocusTag {};
using Focus = NamedBool<FocusTag>;
static_assert(Focus(Focus::True).asBool());
static_assert(!Focus::fromBool(false).asBool());
bool take(Focus f) { return f.asBool(); }
int main()
{
  const Focus::Enum& r = Focus::True;
  std::println(Focus::fromBool(true).asBool(), " ", Focus::code(Focus::True), " ", Focus::code(Focus::False), " ", take(Focus::True), " ", OldBool<FocusTag>::fromBool(true).asBool(), " ", r == Focus::Enum::True);
  return 0;
}
