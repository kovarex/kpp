// spec: a scalar compared with a class whose operator<=> is defaulted, the scalar on the left (`value != MAX_TICK`): C++20's reversed implicit ==, the scalar converted through the class's converting constructor
// factorio: MapTick::toLuaDouble's `if (this->value != MAX_TICK)`, MapTick having `MapTick(ValueType)` and a defaulted operator<=>: "an operator with a class on the right that no function defines"
class Tick
{
public:
  using ValueType = uint64_t;
  constexpr Tick() = default;
  implicit constexpr Tick(ValueType value) : value(value) {}
  constexpr strong_ordering operator<=>(const Tick& other) const = default;
  ValueType value = 0u;
};
constexpr Tick MAX = Tick(1000);
int main()
{
  uint64_t small = 5;
  uint64_t max = 1000;
  println(int(small != MAX), " ", int(max != MAX), " ", int(small == MAX), " ", int(max == MAX));
  return 0;
}
