// spec: `a > b`, `a >= b` with a class on the left whose own operator<=> does not take b and a class on the right whose operator<=> takes an a (`operator<=>(const Version&)`, a template's `operator<=>(const U&)` as Optional's): C++20's reversed candidate, `0 > (b <=> a)`
// factorio: InstallButton::logic's `downloading && *downloading > latestVersion` (ModVersion > Optional<ModVersion>, ModVersion deriving Version's defaulted <=>) and ControllerManager::resolveRequestedZoomLevel's `*zoomData.zoom >= getFurthestGameViewZoom()` (Zoom >= Optional<Zoom>), through the library Optional's `operator<=>(const U&)`
struct Version
{
  int major = 0;
  int minor = 0;
  strong_ordering operator<=>(const Version& other) const = default;
};
struct ModVersion : Version
{
};
struct Holder
{
  int held = 0;
  strong_ordering operator<=>(const ModVersion& v) const { return this->held <=> v.major; }
  bool operator==(const ModVersion& v) const { return this->held == v.major; }
};
template<typename T>
struct Box
{
  int held = 0;
  template<typename U>
  strong_ordering operator<=>(const U& v) const { return this->held <=> v.major; }
  template<typename U>
  bool operator==(const U& v) const { return this->held == v.major; }
};
ModVersion version(int major, int minor)
{
  ModVersion v;
  v.major = major;
  v.minor = minor;
  return v;
}
int main()
{
  ModVersion current = version(3, 0);
  Holder holder{2};
  Box<int> box{4};
  Optional<ModVersion> latest = version(1, 2);
  Optional<ModVersion> none;
  bool a = current > holder;
  bool b = current >= box;
  bool c = holder < current;
  bool d = current > latest;
  bool e = current > none;
  bool f = version(1, 2) >= latest;
  println(a, " ", b, " ", c, " ", d, " ", e, " ", f);
  return 0;
}
