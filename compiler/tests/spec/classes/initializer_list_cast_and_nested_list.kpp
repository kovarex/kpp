// spec: an InitializerList written as a functional cast over a brace list (`InitializerList<Case>{{"a", 1}, {"bb", 20}}`, a range-for's range) is the list over its elements' array, which lives as long as the list object; and a class with an InitializerList constructor list-initialized from one brace list element its element type is not made from (`Vector<ID> ids{{ID(1), ID(2), ID(3)}}`) takes the inner list as the InitializerList (C++'s second phase)
// factorio: tests/TestNoiseProgram.cpp's `for (const auto& testCase : InitializerList<OperationTestCase<...>>{{...}, ...})` (and TestUpgradeItem.cpp), tests/TestPump.cpp's `const Vector<FluidID> fluids{ { FluidID("water"), FluidID("crude-oil"), FluidID("lubricant") } };`
struct Case
{
  String name;
  int value = 0;
};
struct ID
{
  int value = 0;
  ID() = default;
  explicit ID(int value) : value(value) {}
};
int main()
{
  int sum = 0;
  String names;
  for (const auto& c : InitializerList<Case>{{"a", 1}, {"bb", 20}, {"ccc", 300}})
  {
    sum += c.value;
    names << c.name;
  }
  for (int n : InitializerList<int>{4})
    sum += n;
  const Vector<ID> ids{ { ID(1), ID(2), ID(3) } };
  Vector<int> plain{ { 4, 5 } };
  println(sum, " ", names, " ", int(ids.size()), " ", ids[2].value, " ", int(plain.size()));
  return 0;
}
