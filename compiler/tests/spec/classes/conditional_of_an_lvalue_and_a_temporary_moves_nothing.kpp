// spec: a conditional of an lvalue and a temporary is a prvalue: the chosen operand builds the result object itself, with no move after it ([expr.cond], [class.temporary])
struct Counted
{
  static int copied, moved, destroyed;
  int value;
  Counted(int value) : value(value) {}
  Counted(const Counted& other) : value(other.value) { This::copied++; }
  Counted(Counted&& other) : value(other.value) { This::moved++; }
  ~Counted() { This::destroyed++; }
};
int Counted::copied = 0;
int Counted::moved = 0;
int Counted::destroyed = 0;

Counted choose(bool first, const Counted& given) { return first ? given : Counted(2); }

void report()
{
  std::println(Counted::copied, " copied, ", Counted::moved, " moved, ", Counted::destroyed, " destroyed");
  Counted::copied = Counted::moved = Counted::destroyed = 0;
}

int main()
{
  {
    Counted given(1);
    Counted chosen = choose(true, given);
    std::println(chosen.value);
  }
  report();
  {
    Counted given(1);
    Counted chosen = choose(false, given);
    std::println(chosen.value);
  }
  report();
  return 0;
}
