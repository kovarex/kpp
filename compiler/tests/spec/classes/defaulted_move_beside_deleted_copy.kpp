// spec: a defaulted move constructor beside a deleted copy constructor moves the members, in a containing class's implicit move and when a Vector relocates its elements
// factorio: Animation (`explicit Animation(Animation&&) = default`), Trigger, TriggerEffect, ProductPrototype, ResearchIngredient in Vectors and Pairs: ~45 headline lines "copying X, whose copy constructor is deleted"
struct Anim
{
  Anim() = default;
  explicit Anim(const Anim&) = delete;
  explicit Anim(Anim&&) = default;
  Vector<int> frames;
};
struct Element
{
  Anim anim;
  int id = 0;
};
int main()
{
  Vector<Element> v;
  for (int i = 0; i < 20; ++i)
  {
    v.emplace_back();
    v.back().id = i;
    v.back().anim.frames.push_back(i * 2);
  }
  Element moved = move(v[19]);
  println("{} {} {} {}", v.size(), v[18].id, v[18].anim.frames[0], moved.anim.frames[0]);
  return 0;
}
