// spec: a class deriving from UniquePtr<Entity> moves its base in its own move constructor, `Holder(Holder&& other) : UniquePtr<Entity>(::move(other))`: the derived rvalue binds to the base's move constructor (UniquePtr(UniquePtr&&)), the copy constructor being deleted
// factorio: EntityBuildabilityCheckHolder(EntityBuildabilityCheckHolder&& other) : std::unique_ptr<Entity>(std::move(other)) {}
struct Entity
{
  int id = 3;
};
class Holder : public std::UniquePtr<Entity>
{
public:
  Holder() : UniquePtr<Entity>(std::makeUnique<Entity>()) {}
  Holder(Holder&& other) : UniquePtr<Entity>(std::move(other)) {}
};
int main()
{
  Holder a;
  Holder b(std::move(a));
  std::println(a == nullptr, " ", b->id);
  return 0;
}
