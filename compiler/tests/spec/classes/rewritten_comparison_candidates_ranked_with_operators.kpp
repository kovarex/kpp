// spec: a comparison's rewritten candidates are ranked with the class's own operators, as C++ ranks them ([over.match.best]): the conversions first, then a function over a template's specialization (2.4), and only then the non-rewritten candidate over a rewritten one (2.8): `D{1} < D{2}` takes a non-template operator<=> over an operator< template, `G(1) != G(1)` the rewritten `!(G(1) == G(1))` over an operator!= template, `H(1) != 1` the rewritten `!(H(1) == 1)` over an operator!=(const H&) needing a conversion, while `E{1} < E{2}` keeps the operator< that ties with operator<=> (`110110110101101`, clang's)
// found by D (2026-11-06), widening classes/rewritten_three_way_beats_operator_needing_a_conversion to a battery against clang: those three called the class's own operator, without a word
extern "C" import "stdio.h";
using SO = strong_ordering;

struct C
{
  int v;
  C(int x) : v(x) {}
  bool operator<(const C&) const { return false; }
  SO operator<=>(const int& i) const { return v <=> i; }
};

struct D
{
  int v;
  template<typename U> bool operator<(const U&) const { return false; }
  SO operator<=>(const D& o) const { return v <=> o.v; }
};

struct E
{
  int v;
};

bool operator<(const E&, const E&) { return false; }
SO operator<=>(const E& a, const E& b) { return a.v <=> b.v; }

struct F
{
  int v;
  bool operator==(int i) const { return v == i; }
};

struct G
{
  int v;
  G(int x) : v(x) {}
  bool operator==(const G& o) const { return v == o.v; }
  template<class U> bool operator!=(const U&) const { return true; }
};

struct H
{
  int v;
  H(int x) : v(x) {}
  bool operator!=(const H&) const { return true; }
  bool operator==(const int& i) const { return v == i; }
};

struct K
{
  int v;
  template<class U> bool operator==(const U&) const { return false; }
  bool operator==(const K& o) const { return v == o.v; }
};

int main()
{
  int r[] = {
    C(1) < 2, 2 > C(1), C(3) <= 2, D{1} < D{2}, D{2} > D{1}, E{1} < E{2}, 3 == F{3}, F{3} != 4, G(1) != G(1), G(1) != 2,
    H(1) != 1, H(1) != H(1), K{1} == K{1}, K{1} == 1, 1 != K{1},
  };
  for (int x : r)
    printf("%d", x);
  printf("\n");
  return 0;
}
