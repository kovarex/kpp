// spec: assigning a struct with a large member (a 64 KB array) through a pointer copies it, as any struct assignment does; the code generator copies its bytes (a memcpy), not one first-class value of the whole struct
// factorio: minizip (converted as C): zip.c's zipOpen4 ends `*zi = ziinit;`, a zip64_internal holding curfile64_info's `uint8_t buffered_data[Z_BUFSIZE]` (65535 bytes)
struct Inner
{
  int a;
  unsigned char buffered[65536];
  char* text;
};
struct Outer
{
  int n;
  Inner inner;
  long long tail;
};

int main()
{
  Outer local;
  local.n = 3;
  local.inner.buffered[65535] = 7;
  local.tail = 9;
  Outer* p = new Outer;
  *p = local;
  println("{} {} {}", p->n, (int)p->inner.buffered[65535], p->tail);
  delete p;
  return 0;
}
