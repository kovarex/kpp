// spec: under --explicit-by-default a requires-expression whose assignment or initialization needs an unmarked constructor is not satisfied, as in C++ with that constructor `explicit` ([expr.prim.req]: an expression that is ill-formed is a requirement not met): `assignable<Strict, int>` is false and `if constexpr (requires { t = u; })` takes the other branch, where a marked constructor (`implicit Loose(int)`) satisfies both (`0 1 2 1 7 8`)
// factorio: checking the stdlib under --explicit-by-default with K's removal of `explicit` (7d9fd9ac), 2026-11-07: Vector's assign and insert test `requires { this->items[0] = *first; }` to choose between assigning and constructing, took the assignment for a Counted with an unmarked Counted(int), and failed with "copy-initialising Counted from int32" (vector_element_work_as_std)
// kppc: --explicit-by-default --no-std
extern "C" import "stdio.h";
struct Strict
{
  int v;
  Strict(int v) : v(v) {}
};
struct Loose
{
  int v;
  implicit Loose(int v) : v(v) {}
};
template<typename T, typename U>
constexpr bool assignable = requires(T& t, U u) { t = u; };
template<typename T, typename U>
int assignOrBuild(T& t, U u)
{
  if constexpr (requires { t = u; })
  {
    t = u;
    return 1;
  }
  else
  {
    t = T(u);
    return 2;
  }
}
int main()
{
  Strict s(1);
  Loose l(1);
  int a = assignOrBuild(s, 7);
  int b = assignOrBuild(l, 8);
  printf("%d %d %d %d %d %d\n", (int)assignable<Strict, int>, (int)assignable<Loose, int>, a, b, s.v, l.v);
  return 0;
}
