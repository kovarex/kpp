// spec: under --unused-field-checks (on by default since 2026-11-17) a private data member nothing names is an error (kovarex, 2026-11-11: unused private fields are errors, as unused locals, parameters and captures are), each once, at its declaration: one never named, one only initialized (a constructor's `x(...)`, a default initializer: as clang's -Wunused-private-field, initializing is no use), a pointer, a class's member before any label (private), a class template's member of a type that does not depend on its parameters
// kpp: --unused-field-checks
// error: unused_private_fields_are_errors.kpp:16: error: the private field initialized of Plain is never used: remove it, or keep it with [[maybe_unused]]
// error: unused_private_fields_are_errors.kpp:17: error: the private field never of Plain is never used: remove it, or keep it with [[maybe_unused]]
// error: unused_private_fields_are_errors.kpp:18: error: the private field pointer of Plain is never used: remove it, or keep it with [[maybe_unused]]
// error: unused_private_fields_are_errors.kpp:22: error: the private field hidden of Defaulted is never used: remove it, or keep it with [[maybe_unused]]
// error: unused_private_fields_are_errors.kpp:34: error: the private field count of Box is never used: remove it, or keep it with [[maybe_unused]]
class Plain
{
public:
  Plain(int v) : used(v), initialized(v) {}
  int get() const { return this.used; }

private:
  int used;
  int initialized;
  int never = 3;
  double* pointer = nullptr;
};
class Defaulted
{
  int hidden;

public:
  int value = 0;
};
template <typename T> class Box
{
public:
  T get() const { return this.held; }

private:
  T held{};
  int count = 0;
};
int main()
{
  Plain p(1);
  Defaulted d;
  Box<int> b;
  return p.get() + d.value + b.get();
}
