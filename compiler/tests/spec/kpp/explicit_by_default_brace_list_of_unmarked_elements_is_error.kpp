// spec: under --explicit-by-default `Box<Strict> b = {5, 6};`, where neither the InitializerList<Strict> constructor (each element copy-initialized from an int) nor Box(int, const Strict&) (its second argument) is viable without Strict's unmarked constructor converting, is the resolver's error naming that conversion, as C++ refuses `std::vector<Strict> v = {5, 6};` for an explicit Strict(int)
// factorio: checking the stdlib under --explicit-by-default with K's removal of `explicit` (7d9fd9ac), 2026-11-07: list_as_std's `List<Counted> x = {1, 2, 3, 4};` and `Vector<Counted> z = {5, 6};` stopped in codegen
// kppc: --explicit-by-default --no-std
// error: explicit_by_default_brace_list_of_unmarked_elements_is_error.kpp:20: error: copy-initialising Strict from int32 by its constructor, which converts only when marked implicit (design.md "Explicit by default"): Strict(...) takes it
// pending: the resolver takes it and codegen stops: "codegen does not support a constructor of Box taking 2 arguments yet" (K, 2026-11-07; D)
struct Strict
{
  int v;
  Strict(int v) : v(v) {}
};
template<typename T>
struct Box
{
  int count = 0;
  Box(InitializerList<T> list) : count((int)list.size()) {}
  Box(int count, const T& value) : count(count) {}
};
int main()
{
  Box<Strict> b = {5, 6};
  return b.count;
}
