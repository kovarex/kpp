// spec: two scoped libraries and the program declare one name each (design.md 16: adding a scoped library never changes or breaks existing code): no clash, and each library's functions, globals, classes with their vtables and out-of-line members, and template instances are its own; a library names another's qualified
// factorio: none yet; zlib and minizip, ogg and vorbis, once each is a scoped library
int version() { return 3; }
int main()
{
  alpha::Node a;
  beta::Node b;
  const alpha::Node* pa = &a;
  const beta::Node* pb = &b;
  alpha::Box<int> x{5};
  beta::Box<int> y{5};
  std::println(alpha::version(), " ", beta::version(), " ", version());
  std::println(a.id(), " ", b.id(), " ", pa->kind(), " ", pb->kind());
  std::println(x.get(), " ", y.get(), " ", beta::fromAlpha());
  alpha::counter += 1;
  std::println(alpha::counter, " ", beta::counter);
  return 0;
}
