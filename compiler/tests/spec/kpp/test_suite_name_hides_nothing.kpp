// spec: suite names are a name context of their own: suite Beacon beside class Beacon hides nothing, and a suite's helpers are its own
// test:
// exit: 0
class Beacon
{
public:
  int range = 3;
};

suite Beacon
{
  int helperRange(const Beacon& b) { return b.range; }

  test Range
  {
    Beacon beacon;
    require(helperRange(beacon) == 3);
    std::println("range ", helperRange(beacon));
  }
}

suite Other
{
  int helperRange() { return 9; }

  test Own
  {
    require(helperRange() == 9);
    std::println("own helper");
  }
}
