// spec: `test "name" { check(...); }` declarations are accepted and cost nothing without --tests
// design.md 8.6; replaces the unit test macros. The generated runner (kppc --tests) is not implemented and not covered here.
// pending: `test "name" { }` is not parsed yet (a parse error); it showed as passing only because a parse error at namespace scope does not fail the build (language/namespace_scope_parse_error_fails_build)
int square(int x) { return x * x; }
test "square"
{
  check(square(3) == 9);
}
int main()
{
  println("{}", square(4));
  return 0;
}
