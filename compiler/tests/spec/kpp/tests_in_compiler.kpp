// spec: `test name { check(...); }` declarations are accepted and cost nothing without --tests
// design.md 8.6; replaces the unit test macros. The runner (kpp --test) is covered by the test_* snippets.
int square(int x) { return x * x; }
test square
{
  check(square(3) == 9);
}
int main()
{
  println(square(4));
  return 0;
}
