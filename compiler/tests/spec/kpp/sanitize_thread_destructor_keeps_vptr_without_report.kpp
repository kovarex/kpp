// spec: under `--sanitize thread` a destructor's store of its own class's vtable pointer, which the object already has, is no data race with another thread's virtual call on it: kpp marks a vtable pointer's loads and stores as such (TBAA's "vtable pointer"), and ThreadSanitizer's pass makes them __tsan_vptr_read and __tsan_vptr_update, which reports only a store that changes the pointer, as clang's C++ does. The game's routers end their read thread in their destructor, whose virtual calls went on until the join; until 2026-11-14 that was a report in 5 of the game's tests (ServerRouter::~ServerRouter, ClientRouter::~ClientRouter against RouterBase::readPacketsLoop), which the C++ build of the same code never had. The threads meet through the C file beside it, which ThreadSanitizer does not see, so that the worker's call is concurrent with the destructor whatever the scheduling (the untagged store is reported every time)
// target: linux (ThreadSanitizer's runtime is Linux's)
// kpp: --sanitize thread
extern "C" void handshakeCalled();
extern "C" void handshakeWaitCalled();
extern "C" void handshakeStop();
extern "C" void handshakeWaitStop();

class Base
{
public:
  virtual ~Base() {}
  virtual void tick() {}

  void work()
  {
    this.tick();
    handshakeCalled();
    handshakeWaitStop();
  }
};

class Worker : public Base
{
public:
  std::Thread thread;

  Worker() { this.thread = std::Thread(&Base::work, (Base*)&this); }
  ~Worker()
  {
    handshakeStop();
    this.thread.join();
  }

  void tick() override {}
};

int main()
{
  Worker* worker = new Worker();
  handshakeWaitCalled();
  delete worker;
  std::println("done");
  return 0;
}
