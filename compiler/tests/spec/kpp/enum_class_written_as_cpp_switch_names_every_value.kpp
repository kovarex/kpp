// spec: a switch on an enum class written as C++ writes it names every value, or has a default, by a kpp enum's rule (design.md 8.4)
// error: enum_class_written_as_cpp_switch_names_every_value.kpp:6: error: switch on Mode does not handle Fast
enum class Mode { Slow, Fast };
int speedOf(Mode m)
{
  switch (m)
  {
    case Mode::Slow:
      return 1;
  }
  return 0;
}
int main() { return speedOf(Mode::Slow); }
