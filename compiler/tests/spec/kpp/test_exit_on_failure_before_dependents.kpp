// spec: --exit-on-failure stops after the first failed test has finished; dependencies run first, so a failing dependency stops the run before its dependents
// test: --exit-on-failure
// exit: 1
suite Splitters depends Belts
{
  test Splits { std::println("not reached"); }
}

suite Belts
{
  test Moves
  {
    check(1 == 2);
    std::println("the failed test finishes");
  }
  test Stops { std::println("not reached either"); }
}
