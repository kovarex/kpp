// spec: --exit-on-failure stops after the first failed test has finished; dependencies run first, so a failing dependency stops the run before its dependents
// pending: suites, fixtures and the checks of design.md 8.7 are not implemented yet
// test: --exit-on-failure
// exit: 1
suite Splitters depends Belts
{
  test Splits { println("not reached"); }
}

suite Belts
{
  test Moves
  {
    check(1 == 2);
    println("the failed test finishes");
  }
  test Stops { println("not reached either"); }
}
