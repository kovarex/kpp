// spec: a value of a scoped enum indexes a built-in array and std::Array as its number does, read and written, in a constant too (design.md 8.4, "An enum indexes an array"; kovarex, 2026-11-18: the enums all become scoped, and a table indexed by one needs no cast); `E::count` sizes the array
enum class Color : u8
{
  { Red, Green, Blue }
};
enum class Side : i16 { Left = 1, Right = 2 };
constexpr int weights[Color::count] = {10, 20, 30};
static_assert(weights[Color::Blue] == 30);
struct Palette
{
  const char* names[Color::count] = {"red", "green", "blue"};
  std::Array<int, Color::count> uses = {};
};
int sum(const std::Array<int, Color::count>& values)
{
  int total = 0;
  for (Color c : Color::values)
    total += values[c];
  return total;
}
int main()
{
  int counts[Color::count] = {};
  counts[Color::Green] = 5;
  counts[Color::Green] += 2;
  ++counts[Color::Red];
  Palette palette;
  palette.uses[Color::Blue] = 3;
  const Palette& view = palette;
  int sides[3] = {0, 100, 200};
  Color c = Color::Blue;
  std::println(counts[Color::Red], " ", counts[Color::Green], " ", view.names[c], " ", view.uses[Color::Blue], " ", weights[Color::Green], " ",
               sum(palette.uses), " ", sides[Side::Right]);
  return 0;
}
