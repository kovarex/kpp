// spec: several `when` declarations may declare one name in one scope (design.md 19), as an `#ifdef`/`#else` pair did: a debug timer or a null timer named `timer`, whichever the configuration has, each with its own constructor and destructor at the end of the block
// factorio: `#ifdef DEBUG` / `#else` pairs declaring one local or member two ways, converted to two `when` declarations (design.md 12)
struct DebugTimer
{
  DebugTimer(int id) { std::println("debug timer ", id); }
  ~DebugTimer() { std::println("debug timer done"); }
};

struct NullTimer
{
  NullTimer(int) { std::println("no timer"); }
};

int main()
{
  {
    when (config::debug) DebugTimer timer(1);
    when (!config::debug) NullTimer timer(1);
    std::println("work");
  }
  return 0;
}
