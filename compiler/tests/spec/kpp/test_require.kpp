// spec: require ends the test when it fails, a failing release_assert (an assert in a debug build) inside a test fails that test, and the run goes on; check and require are never compiled out
// test:
// exit: 1
struct Guard
{
  ~Guard() { std::println("guard destroyed"); }
};

test require
{
  Guard guard;
  int x = 1;
  require(x == 2);
  std::println("not reached");
}

test assert
{
  int x = 1;
  release_assert(x == 2);
  std::println("not reached either");
}

test after
{
  std::println("still running");
}
