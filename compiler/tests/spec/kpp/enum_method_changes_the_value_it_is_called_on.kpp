// spec: a method of a kpp enum that is not const changes the value it is called on, as a class's method changes its object (design.md 8.4): its `this` is the place it was called on, a variable, an array's element, a member, a reference's object, a pointer's target (`p->turn()`), and a method it calls on `this` changes it too; a const method gets a copy (until 2026-11-11 every call passed a copy and the assignment wrote a copy of that: `d.turn()` left d as it was, silently)
enum class Dir : u8
{
  { North, East, South, West }
  void turn() { this = Dir((u8(this) + 1) & 3); }
  void turnTwice()
  {
    this.turn();
    this.turn();
  }
  Dir turned() const
  {
    Dir copy = this;
    copy.turn();
    return copy;
  }
};

struct Holder
{
  Dir facing = Dir::West;
};

void turnThrough(Dir& d) { d.turn(); }

int main()
{
  Dir d = Dir::East;
  d.turn();
  Dir row[2] = { Dir::North, Dir::North };
  row[1].turn();
  Holder h;
  h.facing.turn();
  Dir e = Dir::North;
  Dir* p = &e;
  p->turn();
  turnThrough(e);
  Dir f = Dir::North;
  f.turnTwice();
  Dir g = Dir::South;
  Dir t = g.turned();
  std::println(std::StringView(d.str()), " ", std::StringView(row[0].str()), " ", std::StringView(row[1].str()), " ", std::StringView(h.facing.str()), " ",
               std::StringView(e.str()), " ", std::StringView(f.str()), " ", std::StringView(g.str()), " ", std::StringView(t.str()));
  return 0;
}
