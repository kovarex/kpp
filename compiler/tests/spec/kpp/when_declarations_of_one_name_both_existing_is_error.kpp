// spec: two `when` declarations of one name that both exist in a template instance (design.md 19) are a clash, a compile error in that instance: limit<int> has both `size` declarations (an int is trivially copyable and 4 bytes), while limit<double> has only the first and compiles
// factorio: none: the converter writes complementary conditions (`config::debug`, `!config::debug`)
// error: when_declarations_of_one_name_both_existing_is_error.kpp:8: error: 'size' is declared twice in this instance (limit<int32>): both `when` conditions hold
template<typename T>
int limit()
{
  when (isTriviallyCopyable<T>) int size = 1;
  when (sizeof(T) == 4) int size = 2;
  if constexpr (isTriviallyCopyable<T>)
    return size;
  return 0;
}

int main()
{
  println(limit<double>(), " ", limit<int>());
  return 0;
}
