// spec: runTest of an unknown name, of an ambiguous one or of the running test fails and ends the caller
// test:
// exit: 1
suite A
{
  test Same { }
  test Unknown { runTest("Nothing"); std::println("not reached"); }
  test Ambiguous { runTest("Same"); std::println("not reached"); }
  test Itself { runTest("A.Itself"); std::println("not reached"); }
}

suite B
{
  test Same { }
}
