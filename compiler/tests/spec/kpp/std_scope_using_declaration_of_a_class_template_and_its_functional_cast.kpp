// spec: a top-level using-declaration of a library's class template or class names it as the library does: after `using std::Vector;` `Vector<int> v;` is a std::Vector<int>, and after `using std::String;` `String(p)` makes a std::String from p (a functional cast), as `std::String(p)` does
// pending: `Vector<int> v;` is "no constructor or deduction guide of Vector deduces its arguments from ()" (the template's arguments dropped), and `String(p)` is "codegen does not support taking the address of String yet"; an alias (`using String = std::String;`, `template <typename T> using Vector = std::Vector<T>;`) works. Found adapting the differential tests' programs to the std scope (compiler/tests/differential/std-names.kpp), 2026-11-16; A
extern "C" int printf(const char* format, ...);
using std::String;
using std::Vector;
int main()
{
  Vector<int> v;
  v.push_back(3);
  const char* p = "abc";
  String s = String(p);
  printf("%d %s\n", (int)v.size(), s.c_str());
  return 0;
}
