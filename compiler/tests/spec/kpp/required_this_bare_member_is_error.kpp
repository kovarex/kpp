int helper(int x) { return x + 1; }
class Train
{
public:
  int speed = 0;
  static int made;
  int wheels() const { return 3; }
  int helper(int x) const { return x; }
  enum class State { Moving, Stopped };
  using Speed = int;
  class Wheel
  {
  public:
    int r = 1;
  };
  void setSpeed(int s)
  {
    speed = s;
    made++;
    int n = wheels();
    Speed v = n;
    State st = State::Moving;
    Wheel w;
    int h = helper(2) + v + w.r + (st == State::Moving ? 1 : 0);
    int twice = [&]() { return speed * 2; }() + h;
  }
  int doubled = speed * 2;
  Train(int s) : speed(s) {}
};
int Train::made = 0;
int main()
{
  Train t(1);
  t.setSpeed(2);
  return 0;
}
