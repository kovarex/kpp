// spec: `--sanitize undefined` alone does not check signed overflow: kpp's signed arithmetic wraps (as Factorio's builds with -fwrapv, whose UBSan build checked float to integer conversions alone), and `--sanitize overflow` is the sanitizer that reports it; a division by zero is checked
// kpp: --sanitize undefined
extern "C" void kpp_assert_failed(const char* file, i32 line, i32 column, const char* text)
{
  std::println("line ", line, ": ", std::StringView(text));
}

int main(int argc, char** argv)
{
  int big = 2147483647;
  std::println(big + argc);
  std::println(-(-big - argc));
  std::println(big / (argc - 1));
  return 0;
}
