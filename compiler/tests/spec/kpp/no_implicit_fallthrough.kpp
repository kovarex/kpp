// spec: --no-implicit-fallthrough (design.md "No implicit fallthrough", step 2 behind a flag until the code builds with it): every group of statements after a label ends with an implicit break; labels side by side share their statements; `fallthrough;` as a group's last statement runs on into the next; `break;` still leaves early; each group is a scope of its own (a declaration needs no braces, two groups may declare one name, an object is destroyed at its group's end); a `for constexpr`'s elements are groups too; the evaluator alike
// kppc: --no-implicit-fallthrough --no-std
int destroyed = 0;
struct Noisy
{
  int v;
  Noisy(int v) : v(v) {}
  ~Noisy() { destroyed += v; }
};
int classify(int x)
{
  int r = 0;
  switch (x)
  {
    case 0:
      r = 10;
    case 1:
    case 2:
      r = 20;
    case 3:
      r = 30;
      fallthrough;
    case 4:
      r += 1;
    case 5:
      if (r == 0)
        break;
      r = 99;
    default:
      r = -1;
  }
  return r;
}
int scoped(int x)
{
  int r = 0;
  switch (x)
  {
    case 0:
      Noisy n(1);
      int k = 5;
      r = k + n.v + destroyed;
    case 1:
      Noisy n(2);
      int k = 7;
      r = k + n.v + destroyed;
      fallthrough;
    default:
      int k = 100;
      r += k + destroyed;
  }
  return r;
}
struct A
{
  static const int kind = 1;
  static const int value = 10;
};
struct B
{
  static const int kind = 2;
  static const int value = 20;
};
int valueOf(int kind)
{
  int r = 0;
  switch (kind)
  {
    case 0:
      Noisy n(4);
      r = 5;
    for constexpr (typename T : types<A, B>)
      case T::kind: r += T::value;
    default:
      r += 1000;
  }
  return r;
}
constexpr int folded(int x)
{
  switch (x)
  {
    case 1:
      return 1;
    case 2:
      x = 5;
    case 3:
      x += 1;
      fallthrough;
    case 4:
      x += 10;
  }
  return x;
}
static_assert(folded(1) == 1);
static_assert(folded(2) == 5);
static_assert(folded(3) == 14);
static_assert(folded(4) == 14);
int main()
{
  int wrong = 0;
  wrong += classify(0) != 10;
  wrong += classify(1) != 20;
  wrong += classify(2) != 20;
  wrong += classify(3) != 31;
  wrong += classify(4) != 1;
  wrong += classify(5) != 0;
  wrong += classify(7) != -1;
  wrong += scoped(0) != 6;                    // n(1) destroyed after r is set
  wrong += destroyed != 1;
  wrong += scoped(1) != 9 + 1 + 100 + 3;      // r = 7 + 2 + 1, then n(2) destroyed before the default group: 100 + 3
  wrong += destroyed != 3;
  wrong += scoped(9) != 103;
  wrong += valueOf(1) != 10;
  wrong += valueOf(2) != 20;
  wrong += valueOf(0) != 5;
  wrong += destroyed != 7;                    // n(4) destroyed at its group's end
  wrong += valueOf(9) != 1000;
  int f2 = folded(2), f3 = folded(3);
  wrong += f2 != 5 || f3 != 14;
  return wrong;
}
