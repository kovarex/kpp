// spec: while --no-implicit-fallthrough is opt-in, the standard library's own trailing `break;`s (the 7 of Time.kpp's parseTime; the old compiler gave this program those 7 errors) are no errors under it, as its `explicit`s were none under --explicit-by-default until that flip (7ab51b62): a trailing break means the same with the flag and without, and C can remove them only with the flip, since without the flag step 1 refuses a case that runs on; so a program builds with the flag beside the stdlib (C's converted game) and the stdlib's switches run as before (parseTime's seven; errcOfWindowsError's lists of values, `case 2, 3, 15, 53, 67, 123, 161:`, which as labels side by side before C's 9c32275b mapped only each run's last (161, 82, 183, 112 and 30) under the flag, the others to 0: `0 0 2 0 13 0 17 0 28 0 5 18 0`). The program's own switch follows the flag: each group ends with an implicit break and `fallthrough;` runs on, and its own trailing `break;` is still the error (kpp/no_implicit_fallthrough_errors_is_error) (`one two`, `two`, `three`, `1 2026 11 8 12 34`, `2 2 2 13 13 17 17 28 28 5 5 18 0`)
// kpp: --no-implicit-fallthrough
extern "C" import "time.h";

int main()
{
  for (int i = 1; i <= 3; ++i)
  {
    switch (i)
    {
      case 1:
        print("one ");
        fallthrough;
      case 2:
        println("two");
      case 3:
        println("three");
    }
  }
  tm t = {};
  bool parsed = parseTime("2026-11-08 12:34", "%Y-%m-%d %H:%M", &t);
  println(parsed ? 1 : 0, " ", t.tm_year + 1900, " ", t.tm_mon + 1, " ", t.tm_mday, " ", t.tm_hour, " ", t.tm_min);
  // (Windows errors: file and path not found, ..., bad network name; access denied, ..., cannot make; file exists twice;
  // disk full twice; write and read fault; not same device; one it does not map)
  int errors[] = {2, 3, 161, 5, 82, 80, 183, 39, 112, 29, 30, 17, 999};
  for (int k = 0; k < 13; ++k)
    print(k == 0 ? StringView("") : StringView(" "), errcOfWindowsError(errors[k]));
  println();
  return 0;
}
