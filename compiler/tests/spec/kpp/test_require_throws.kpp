// spec: requireThrows<T>(expr) evaluates expr inside a try, is the caught T and ends the test unless one is thrown; checkThrows<T>(expr) is an Optional<T> and goes on
// test:
// exit: 1
int parse(int x)
{
  if (x < 0)
    throw std::RuntimeError("negative");
  return x;
}

suite Throwing
{
  test Throws
  {
    std::RuntimeError e = requireThrows<std::RuntimeError>(parse(-1));
    require(std::StringView(e.what()) == "negative");
    std::println("caught ", std::StringView(e.what()));
  }

  test DoesNotThrow
  {
    std::Optional<std::RuntimeError> e = checkThrows<std::RuntimeError>(parse(2));
    check(!e.hasValue());
    requireThrows<std::RuntimeError>(parse(3));
    std::println("not reached");
  }
}
