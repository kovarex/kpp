// kpp: --tests
//--- step: the program
test void requireNonNegative(int value)
{
  require(value >= 0, "value ", value);
}

int helper(int v)
{
  return v + 1;
}

suite Helpers
{
  test Values
  {
    check(helper(1) == 3);
    requireNonNegative(helper(-3));
  }
}
