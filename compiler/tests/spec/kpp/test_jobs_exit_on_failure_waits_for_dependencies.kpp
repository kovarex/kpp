// spec: under --jobs with --exit-on-failure a suite starts when its dependencies have finished, also through a suite left out, so that a failure in one stops the run before its dependents
// test: --jobs 2 --exit-on-failure --skip-suite Between
// exit: 0
auto started = std::SteadyClock::now();

suite Base
{
  test Waits { std::thisThread::sleepFor(std::Milliseconds(300)); }
}

suite Between depends Base
{
  test Skipped { }
}

suite Last depends Between
{
  test Ran { check(std::SteadyClock::now() - started >= std::Milliseconds(250)); }
}
