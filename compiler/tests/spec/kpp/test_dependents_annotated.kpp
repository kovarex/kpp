// spec: after a failure the run goes on, dependents included (Factorio's default); a failure after a failed dependency says so, and the summary names the root failures
// test:
// exit: 1
suite Belts
{
  test Moves { check(1 == 2); }
}

suite Splitters depends Belts
{
  test Splits { check(2 == 3); }
  test Merges { std::println("Splitters.Merges"); }
}
