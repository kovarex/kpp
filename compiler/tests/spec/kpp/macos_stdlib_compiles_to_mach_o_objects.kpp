// spec: a program of the standard library's threads, locks, condition variables, files, directories, the file system's space, clocks, a map and exceptions compiles for macos into Mach-O objects through the library's macOS layer (PlatformMac.kpp, CMac.kpp: macOS's pthread sizes and initializers, struct stat, statvfs and dirent, errno values) and links with ld64.lld against the SDK's libSystem.tbd (M3: every libSystem function the library calls there, by its macOS name)
// target: macos (a Mach-O program: built, not run, by run_spec.py --target macos)
// kpp: --target macos --sysroot {here}/macos_sdk_checked_before_the_build.sdk
int main()
{
  std::Mutex m;
  std::ConditionVariable cv;
  int counter = 0;
  std::Vector<std::Thread> threads;
  for (int i = 0; i < 4; ++i)
    threads.push_back(std::Thread([&]() { std::LockGuard<std::Mutex> g(m); ++counter; cv.notify_all(); }));
  for (std::Thread& t : threads)
    t.join();
  std::filesystem::path dir = std::filesystem::temp_directory_path() / "kpp-mac";
  std::filesystem::create_directories(dir);
  for (const std::filesystem::directory_entry& e : std::filesystem::directory_iterator(dir))
    std::println(e.path().string(), " ", e.is_regular_file());
  std::ErrorCode ec;
  std::println(std::filesystem::space(dir).capacity > 0, " ", std::filesystem::equivalent(dir, dir), " ", std::filesystem::hard_link_count(dir, ec));
  auto start = std::SteadyClock::now();
  std::thisThread::sleepFor(std::Milliseconds(1));
  std::HashMap<std::String, int> map;
  map["a"] = counter;
  try
  {
    throw std::RuntimeError("x");
  }
  catch (const std::Exception& e)
  {
    std::println(std::StringView(e.what()), " ", map["a"], " ", (std::SteadyClock::now() - start).count() > 0, " ", std::Thread::hardware_concurrency());
  }
  return 0;
}
