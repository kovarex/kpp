{
  std::println("stopped at line ", line, ", column ", column, ": ", std::StringView(text));
}

int main()
{
  int zero = 0;
  std::println(ratio(10, zero));
  return 0;
}
// a comment

int helper(int v)
{
  return v + 1;
}

