// spec: the runner calls testBeforeEach() before each test; a failure that ends it fails the test and leaves its body out, and testAfterEach still runs
// test:
// exit: 1
int runs = 0;

test void testBeforeEach()
{
  ++runs;
  std::println("before ", runs);
  require(runs != 2, "second");
}

void testAfterEach() { std::println("after ", runs); }

suite Hooks
{
  test First { std::println("first"); }
  test Second { std::println("not reached"); }
  test Third { std::println("third"); }
}
