  }
  T product(i32 times) const
  {
    T total = 1;
    for (i32 i = 0; i < times; ++i)
      total *= this.value;
    return total;
  }
};
int main()
{
  Box<i32> b{3};
  std::println(b.product(3));
  return 0;
}
// expect: 27
