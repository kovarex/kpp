// expect: 6 27
//--- step: neither called, the class still used
template<class T> struct Box
{
  T value;
  T sum(i32 times) const
  {
    T total = 0;
    for (i32 i = 0; i < times; ++i)
      total += this.value;
    return total;
  }
  T product(i32 times) const
  {
    T total = 1;
    for (i32 i = 0; i < times; ++i)
      total *= this.value;
    return total;
  }
};
int main()
{
  Box<i32> b{3};
  std::println(b.value);
  return 0;
}
// expect: 3
