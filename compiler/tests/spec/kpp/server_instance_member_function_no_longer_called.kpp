// spec: a compile server's build after an edit that stops calling a member function of a class template's instance, whose class the program still uses, is what a build from scratch gives: nothing names the member function, so a build from scratch does not make it ([temp.inst] 11), and the server's build drops the one it had made (codegen's rebuild: a function made on demand that no text reaches once the edited functions are emitted again goes, as a removed function does). Called again, it is made anew; with neither called both go and the class stays. Until 2026-11-25 the function stayed in the server's build, the program right and its code not a build from scratch's (--verify-incremental: "what it wrote differs"), found by the debug information's member function lists (b88217f64), whose class's list it changes too (docs/debugging.md, "Member functions")
//--- step: the program
template<class T> struct Box
{
  T value;
  T sum(i32 times) const
  {
    T total = 0;
    for (i32 i = 0; i < times; ++i)
      total += this.value;
    return total;
  }
  T product(i32 times) const
  {
    T total = 1;
    for (i32 i = 0; i < times; ++i)
      total *= this.value;
    return total;
  }
};
int main()
{
  Box<i32> b{3};
  std::println(b.sum(2), " ", b.product(3));
  return 0;
}
// expect: 6 27
//--- step: one of the two called no more
