// spec: a failing check prints its location, its text and a comparison's operand values, and the test goes on
// test:
// exit: 1
enum class Dir : u8 { { North, East } };
struct Opaque { int x; bool operator==(const Opaque& o) const { return x == o.x; } };

test "fails"
{
  int x = 2;
  check(x + 1 == 4);
  check(x < 1);
  String s("abc");
  check(s == "abd");
  check(Dir::North != Dir::North);
  check(Opaque{1} == Opaque{2});
  check(x == 2);
  bool ready = false;
  check(ready);
}

test "passes"
{
  check(true);
}
