// spec: assigning a temporary to a typed union's alternative of a fixed place (`target[a] = a.type(input)` with target a reference, a an alternative) builds the alternative in place from the constructor's arguments: no move, whatever C++17's order of the assignment's operands (the place does not depend on the right operand)
// factorio: DeserialiserHelper::loadSTDVariant (overrides) loading SegmentedUnitAI::AIState: Targeter's move constructor asserts the targeter is not being loaded, and the menu simulation vulcanus-punishment and the Simulations unit tests stopped there when the assignment's right operand was first made a temporary and moved from
struct Loaded
{
  int value = 0;
  Loaded(int v) : value(v) {}
  Loaded(Loaded&& other) : value(other.value) { println("moved"); }
  Loaded(const Loaded& other) : value(other.value) { println("copied"); }
};
union enum Slot : uint8_t
{
  { {int, Empty}, {Loaded, Full} }
};
template<class U>
void load(U& target, int input)
{
  for constexpr (auto a : alternatives(U))
    if (a.tag == U::Full)
      target[a] = a.type(input);
}
int main()
{
  Slot slot;
  load(slot, 7);
  println("{} {}", slot == Slot::Full, slot[Slot::Full].value);
  return 0;
}
