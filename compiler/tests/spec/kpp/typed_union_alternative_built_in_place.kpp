// spec: an alternative built where it stays, no move and no assignment: the union's destructor, then placement new from a tag and the value or the constructor's arguments, std::variant's emplace (the held one goes first: the arguments must not refer to it); `=` builds the value first and moves it to its place (design.md 8.5)
// factorio: DeserialiserHelper::loadSTDVariant (overrides) loading SegmentedUnitAI::AIState: Targeter's move constructor asserts the targeter is not being loaded, and the menu simulation vulcanus-punishment and the Simulations unit tests stopped there when the alternative was moved; the union's generated emplace<T> builds it so too
class Loaded
{
public:
  int value = 0;
  Loaded(int v) : value(v) {}
  Loaded(int v, int w) : value(v + w)
  {
    if (w < 0)
      throw std::RuntimeError("no");
  }
  Loaded(Loaded&& other) : value(other.value) { std::println("moved"); }
  Loaded(const Loaded& other) : value(other.value) { std::println("copied"); }
  Loaded& operator=(Loaded&& other)
  {
    this.value = other.value;
    std::println("assigned");
    return this;
  }
  ~Loaded() { std::println("destroyed ", this.value); }
};
union enum Slot : uint8_t
{
  { {int, Empty}, {Loaded, Full} }

  template<typename T, typename... Args>
  T& emplace(Args&&... args)
  {
    for constexpr (auto a : alternatives(Slot))
      if constexpr (std::isSame<a.type, T>)
      {
        this.~Slot();
        new (&this) Slot(a.tag, T(std::forward<Args>(args)...));
        return (this)[a];
      }
  }
};
template<class U>
void load(U& target, int input)
{
  for constexpr (auto a : alternatives(U))
    if (a.tag == U::Full)
    {
      target.~U();
      new (&target) U(a.tag, a.type(input));
    }
}
int main()
{
  Slot slot;
  load(slot, 7);
  std::println(slot == Slot::Full, " ", slot[Slot::Full].value);
  std::println("-- again, the same alternative: destroyed and built");
  load(slot, 8);
  std::println(slot[Slot::Full].value);
  std::println("-- from the constructor's arguments");
  slot.~Slot();
  new (&slot) Slot(Slot::Full, 4, 5);
  std::println(slot[Slot::Full].value);
  std::println("-- through a generated emplace");
  slot.emplace<Loaded>(1, 2);
  std::println(slot[Slot::Full].value);
  std::println("-- a constructor that throws leaves it holding none");
  try
  {
    slot.~Slot();
    new (&slot) Slot(Slot::Full, 1, -2);
  }
  catch (const std::RuntimeError& e)
  {
    std::println(std::StringView(e.what()), " ", slot.tag() == Slot::Tag::count);
  }
  std::println("-- assigned: the value first, then moved to its place");
  slot[Slot::Full] = Loaded(9);
  std::println(slot[Slot::Full].value);
  std::println("-- assigned the alternative held");
  slot[Slot::Full] = Loaded(10);
  std::println(slot[Slot::Full].value);
  std::println("-- end");
  return 0;
}
