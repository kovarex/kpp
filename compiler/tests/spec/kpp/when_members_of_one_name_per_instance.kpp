// spec: two `when` members of one name in a class template, on complementary conditions on T (design.md 19, as an #ifdef/#else pair), are one member in each instance, each instance's own: its type, its uses (through an object, and unqualified in the class's members, sizeof included) and its layout (`1234567890123 12 8 2`, `8 2 5 6`)
// factorio: the game's class templates under #ifdef DEBUG members with an #else of another type
struct Handle
{
  int id = 7;
  ~Handle() {}
};

template<typename T>
struct Store
{
  when (std::isTriviallyCopyable<T>) T copy;
  when (!std::isTriviallyCopyable<T>) short copy;
  int width() const { return int(sizeof(this.copy)); }
  void set(int v) { this.copy = v; }
};

int main()
{
  Store<long long> a;
  a.copy = 1234567890123;
  Store<Handle> b;
  b.copy = 12;
  std::println(a.copy, " ", b.copy, " ", sizeof(Store<long long>), " ", sizeof(Store<Handle>));
  a.set(5);
  b.set(6);
  std::println(a.width(), " ", b.width(), " ", a.copy, " ", b.copy);
  return 0;
}
