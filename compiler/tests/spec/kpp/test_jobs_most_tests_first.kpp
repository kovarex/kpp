// spec: under --jobs without --durations the suite with the most tests goes first: with one process what the tests print shows the order (the runner's own lines come in the suites' order)
// test: --jobs 1
// exit: 0
suite Few
{
  test Only { println("Few.Only"); }
}

suite Many
{
  test First { println("Many.First"); }
  test Second { println("Many.Second"); }
}
