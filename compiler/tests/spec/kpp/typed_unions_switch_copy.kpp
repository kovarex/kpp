// spec: typed unions: switch on the union, methods, copying and assignment carry the alternative, destruction follows the tag
// design.md 8.5
struct Tracked
{
  int id;
  Tracked(int id) : id(id) {}
  Tracked(const Tracked& other) : id(other.id) {}
  ~Tracked() { std::println("~", this.id); }
};
union enum Value : uint8_t
{
  { {Number, int}, {Text, std::String}, {Owned, Tracked} }
  std::String describe() const
  {
    switch (this)
    {
      case Tag::Number: return std::format("number {}", (this)[Number]);
      case Tag::Text: return std::format("text {}", (this)[Text]);
      case Tag::Owned: return std::format("owned {}", (this)[Owned].id);
    }
  }
};
int main()
{
  Tracked t(7);
  Value a;
  a[Value::Tag::Text] = std::String("hello");
  Value b = a;
  a[Value::Tag::Owned] = t;
  std::println(a.describe(), " | ", b.describe(), " | ", a != Value::Tag::Text);
  b = a;
  std::println(b.describe());
  a[Value::Tag::Number] = 1;
  std::println(a.describe());
  return 0;
}
