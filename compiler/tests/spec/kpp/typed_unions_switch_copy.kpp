// spec: typed unions: switch on the union, methods, copying and assignment carry the alternative, destruction follows the tag
// design.md 8.5
struct Tracked
{
  int id;
  Tracked(int id) : id(id) {}
  Tracked(const Tracked& other) : id(other.id) {}
  ~Tracked() { std::println("~", this.id); }
};
union enum Value : uint8_t
{
  { {int, Number}, {std::String, Text}, {Tracked, Owned} }
  std::String describe() const
  {
    switch (this)
    {
      case Number: return std::format("number {}", (this)[Number]);
      case Text: return std::format("text {}", (this)[Text]);
      case Owned: return std::format("owned {}", (this)[Owned].id);
    }
  }
};
int main()
{
  Tracked t(7);
  Value a;
  a[Value::Text] = std::String("hello");
  Value b = a;
  a[Value::Owned] = t;
  std::println(a.describe(), " | ", b.describe(), " | ", a != Value::Text);
  b = a;
  std::println(b.describe());
  a[Value::Number] = 1;
  std::println(a.describe());
  return 0;
}
