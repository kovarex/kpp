// spec: a config constant in a library's scope (build.kpp's library options: `--config zlib::debug=true`) is config::zlib::debug, read in an expression, in a declaration-scope if constexpr and in conditional(), apart from the program's own config::debug (`true 7 checked on fast`)
// kpp: --config zlib::debug=true --config zlib::level=7 --config zlib::mode=fast
conditional(config::zlib::debug) void trace() { println("on"); }
conditional(!config::zlib::debug) void trace() { println("off"); }
if constexpr (config::zlib::debug)
{
  const char* checks() { return "checked"; }
}
else
{
  const char* checks() { return "unchecked"; }
}
int main()
{
  print(config::zlib::debug, " ", config::zlib::level, " ", StringView(checks()), " ");
  trace();
  println(StringView(config::zlib::mode));
  return 0;
}
