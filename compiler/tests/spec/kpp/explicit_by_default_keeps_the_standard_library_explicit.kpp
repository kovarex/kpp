// spec: while --explicit-by-default is opt-in, the standard library's own `explicit` and `explicit(cond)` are no errors under it: they stay until the flip, with which K's 7d9fd9ac removes them (the coordinator's decision (a), 2026-11-08), so that a program builds with the flag beside the stdlib (C's converted game); the program's own constructors follow the flag (`Mine m(3)`, direct-initialization, takes the unmarked one), and its `explicit`s are still the error (kpp/explicit_by_default_marks_is_error) (`2`, `3`)
// kpp: --explicit-by-default
struct Mine
{
  int v;
  Mine(int v) : v(v) {}
};
int main()
{
  Vector<int> values{1, 2};
  Mine m(3);
  println(int(values.size()));
  println(m.v);
  return 0;
}
