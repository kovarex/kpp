// spec: two instances of one enumeration template are two types, and neither converts to the other without a cast (the game's NamedBool: a PlaySound is no DragBuild), as two enumerations do not; until 2026-11-22 kpp compared only their declaration, so passing, initializing, assigning one from the other and comparing them compiled; an instance still converts to itself and through a cast
// error: enum_template_instances_do_not_convert.kpp:18: error: a value of type PlaySound does not convert to the enumeration DragBuild without a cast
// error: enum_template_instances_do_not_convert.kpp:22: error: a value of type PlaySound does not convert to the enumeration DragBuild without a cast
// error: enum_template_instances_do_not_convert.kpp:27: error: a value of type PlaySound does not convert to the enumeration DragBuild without a cast
// error: enum_template_instances_do_not_convert.kpp:32: error: a comparison of a value of an enum class with another type (PlaySound and DragBuild): an enum class converts to a number only by a cast
template<class Tag>
enum class NamedBool : u8
{
  {False, True};
};
struct SoundTag {};
struct DragTag {};
using PlaySound = NamedBool<SoundTag>;
using DragBuild = NamedBool<DragTag>;
void take(DragBuild value) {}
void passes(PlaySound sound)
{
  take(sound);
}
void initializes()
{
  DragBuild drag = PlaySound::False;
  take(drag);
}
void assigns(PlaySound sound, DragBuild drag)
{
  drag = sound;
  take(drag);
}
bool compares(PlaySound sound, DragBuild drag)
{
  return sound == drag;
}
void allowed(PlaySound sound)
{
  DragBuild same = DragBuild::True;
  DragBuild cast = DragBuild(sound);
  take(same);
  take(cast);
  (void)(DragBuild::True == same);
}
