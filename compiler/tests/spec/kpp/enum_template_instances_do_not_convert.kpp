// spec: two instances of one enumeration template are two types, and neither converts to the other without a cast (the game's NamedBool: a PlaySound is no DragBuild), as two enumerations do not; until 2026-11-22 kpp compared only their declaration, so passing, initializing and assigning one from the other compiled; an instance still converts to itself and through a cast
// error: enum_template_instances_do_not_convert.kpp:17: error: a value of type PlaySound does not convert to the enumeration DragBuild without a cast
// error: enum_template_instances_do_not_convert.kpp:21: error: a value of type PlaySound does not convert to the enumeration DragBuild without a cast
// error: enum_template_instances_do_not_convert.kpp:26: error: a value of type PlaySound does not convert to the enumeration DragBuild without a cast
template<class Tag>
enum class NamedBool : u8
{
  {False, True};
};
struct SoundTag {};
struct DragTag {};
using PlaySound = NamedBool<SoundTag>;
using DragBuild = NamedBool<DragTag>;
void take(DragBuild value) {}
void passes(PlaySound sound)
{
  take(sound);
}
void initializes()
{
  DragBuild drag = PlaySound::False;
  take(drag);
}
void assigns(PlaySound sound, DragBuild drag)
{
  drag = sound;
  take(drag);
}
void allowed(PlaySound sound)
{
  DragBuild same = DragBuild::True;
  DragBuild cast = DragBuild(sound);
  take(same);
  take(cast);
}
