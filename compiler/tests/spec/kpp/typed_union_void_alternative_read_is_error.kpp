// spec: an alternative of type void carries no value (design.md 8.5): reading or setting it through `u[Name]` is a compile error; it is set from its tag
// error: typed_union_void_alternative_read_is_error.kpp:11: error: the alternative Stop of the typed union Action carries no value (its type is void): set it from its tag, `Action(Action::Tag::Stop)`
union enum class Action : u8
{
  { {int, Move}, {void, Stop} }
};

int main()
{
  Action action;
  action[Action::Tag::Stop];
  return 0;
}
