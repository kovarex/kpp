// spec: a compile server's builds after each edit are what a build from scratch gives (docs/compile-speed.md, "The compile server"): an error in a template instance kept from the build before has its instantiation notes at the lines the edits moved the requesting statements to
//--- step: the program
template<typename T>
int inner(T v)
{
  int* first = nullptr;
  int total = first;
  return total + v;
}
template<typename T>
int middle(T v)
{
  return inner(v) + 1;
}
int main()
{
  int a = 2;
  return middle(a);
}
// error: :5: error: a pointer (int32*) does not convert to int32 without a cast (in inner<int32>(int32), requested by middle<int32>(int32))
// error: :11: note: in instantiation of inner<int32>(int32) requested here
// error: :16: note: in instantiation of middle<int32>(int32) requested here
//--- step: lines added in main above the call
template<typename T>
int inner(T v)
{
  int* first = nullptr;
  int total = first;
  return total + v;
}
template<typename T>
int middle(T v)
{
  return inner(v) + 1;
}
int main()
{
  int a = 2;
  a += 1;
  a += 1;
  return middle(a);
}
// error: :5: error: a pointer (int32*) does not convert to int32 without a cast (in inner<int32>(int32), requested by middle<int32>(int32))
// error: :11: note: in instantiation of inner<int32>(int32) requested here
// error: :18: note: in instantiation of middle<int32>(int32) requested here
//--- step: lines added above middle's call
template<typename T>
int inner(T v)
{
  int* first = nullptr;
  int total = first;
  return total + v;
}
template<typename T>
int middle(T v)
{
  v += 1;
  return inner(v) + 1;
}
int main()
{
  int a = 2;
  a += 1;
  a += 1;
  return middle(a);
}
// error: :5: error: a pointer (int32*) does not convert to int32 without a cast (in inner<int32>(int32), requested by middle<int32>(int32))
// error: :12: note: in instantiation of inner<int32>(int32) requested here
// error: :19: note: in instantiation of middle<int32>(int32) requested here
