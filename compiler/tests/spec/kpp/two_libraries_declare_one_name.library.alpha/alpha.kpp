// The library alpha of two_libraries_declare_one_name.kpp.
int counter = 10;
int version() { return 1; }
struct Node
{
  int id() const;
  virtual int kind() const { return 100; }
};
int Node::id() const { return counter + version(); }
template<typename T> struct Box
{
  T value;
  T get() const { return value + T(version()); }
};
