// spec: config::platformName(PLATFORM) is the platform's short name (windows, linux, freebsd), as --target, the sysroots and build.kpp's systemLibrary(NAME, PLATFORM) spell it; one table in kpp gives it and config::platform's enumeration (target.hpp, platformNames)
// factorio: none; projectlib's Project.kpp names a platform's system libraries with it
int main()
{
  std::println(std::StringView(config::platformName(config::platform)), " ", std::StringView(config::platformName(Platform::FreeBSD)), " ", std::StringView(config::platformName(Platform::Mac)));
  return 0;
}
