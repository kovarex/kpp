// spec: a discarded `if constexpr (config::debug)` branch in a function body is not name-checked: it may name members, functions and types that only the debug configuration declares (at class and namespace scope, inside their own `if constexpr (config::debug)`), as the C++ preprocessor's `#ifdef DEBUG` lets it; the kept branch is checked as always
// factorio: kovarex 2026-11-02, "we need to have debug and release configuration working properly": the game's 392 DEBUG conditionals (273 in function bodies, 61 in class bodies, 57 at namespace scope) as `if constexpr (config::debug)`, TransportLine's debug-only referenceSet among them (design.md 12)
class Line
{
public:
  if constexpr (config::debug)
  {
    int references = 0;
    void check() const { println("checked ", this->references); }
  }
  void connect()
  {
    if constexpr (config::debug)
    {
      ++this->references;
      this->check();
      debugOnlyCount(this->references);
    }
    else
      println("release");
  }
};

if constexpr (config::debug)
{
  void debugOnlyCount(int count) { println("count ", count); }
}

int main()
{
  Line line;
  line.connect();
  if constexpr (!config::debug)
    println("release main");
  else
    println("debug main ", line.references);
  return 0;
}
