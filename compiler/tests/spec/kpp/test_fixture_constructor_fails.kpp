// spec: an exception while building a fixture fails the test without running its body; one while destroying it fails the test too
// test:
// exit: 1
class Refuses
{
public:
  Refuses() { throw std::RuntimeError("no map"); }
};

class Leaks
{
public:
  ~Leaks() noexcept(false) { throw std::RuntimeError("an entity leaked"); }
};

suite Fixtures
{
  test Building : Refuses { std::println("not reached"); }
  test Destroying : Leaks { std::println("body ran"); }
  test After { std::println("after"); }
}
