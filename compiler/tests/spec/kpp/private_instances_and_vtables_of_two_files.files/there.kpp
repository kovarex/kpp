// Private names of private_instances_and_vtables_of_two_files.kpp's, other entities.
private template<typename T> struct Box
{
  T value;
  T get() const { return this.value * 100; }
};
private template<typename T> T scale(T x) { return x * 1000; }
private class Shape
{
public:
  static int made;
  virtual int sides() const { return 40; }
};
int Shape::made = 70;
private int helper() { return 500; }
int fromThere()
{
  Box<int> b{10};
  Shape s;
  const Shape& r = s;
  return b.get() + scale(3) + r.sides() + Shape::made;
}
int viaOther() { return withHelper(1000) + helper(); }
