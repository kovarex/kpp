// spec: a --tag that no suite has is an error, nothing runs (it would run 0 tests and pass)
// test: --tag fast
// exit: 2
suite Parsing tags slow
{
  test Numbers { std::println("Parsing.Numbers"); }
}

suite Printing
{
  test Numbers { std::println("Printing.Numbers"); }
}

test alone { std::println("alone"); }
