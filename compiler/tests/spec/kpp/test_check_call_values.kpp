// spec: a failed check of a call (or of !call) shows its arguments' values as the function took them, as a comparison shows its operands'
// test:
// exit: 1
bool isClose(double a, double b, double tolerance) { return a - b <= tolerance && b - a <= tolerance; }
bool contains(std::StringView text, std::StringView part) { return text.find(part) != std::StringView::npos; }

class Opaque { public: int value = 0; };
class Text2
{
public:
  int size = 3;
  bool has(std::StringView part, int from = 0) const { return false; }
  std::String str() const { return std::String("text2"); }
};
bool isTrivial(int a) { return a == 0; }
bool takesOpaque(const Opaque& o, Opaque* p, const char* c) { return false; }
bool shortens(std::StringView text) { text = text.substr(1); return false; }
bool owns(std::String text) { text << "more"; return false; }
bool reference(const std::String& text, int& counter) { ++counter; return false; }
bool withDefault(int a, int b = 7) { return false; }
bool classValue(const Text2& t, bool flag, char letter) { return false; }
template<typename T> bool generic(T value) { return false; }
bool evaluatedOnce(int value) { return false; }
bool inList(std::InitializerList<int> list, int value) { return false; }
int calls = 0;
int counted() { return ++calls; }

suite Values
{
  test Calls
  {
    double x = 1.52;
    check(isClose(x, 1.5, 0.01));
    check(!contains("inserter", "sert"));
    check(isClose(x, 1.5, 0.1));
  }
  test Kinds
  {
    check(isTrivial(3));
    Opaque o;
    check(takesOpaque(o, nullptr, nullptr));
    check(shortens("value"));
    check(owns(std::String("owned")));
    int counter = 1;
    check(reference(std::String("temporary"), counter));
    check(withDefault(1));
    check(classValue(Text2(), true, 'c'));
    check(generic(5));
    check(generic(std::StringView("text")));
    Text2 t;
    check(t.has("part"));
    check(evaluatedOnce(counted()));
    check(calls == 1);
    check(inList({1, 2}, 3));
    check(isTrivial(4), "with a message");
    require(isTrivial(5));
  }
  test Nested
  {
    check(generic([]() { check(false, "inside"); return 1; }()));
    auto f = [](int a) { return false; };
    check(f(1));
    bool (*p)(int) = &isTrivial;
    check(p(1));
    check(isTrivial(1) || isTrivial(2));
    check(!!isTrivial(9));
  }
}
