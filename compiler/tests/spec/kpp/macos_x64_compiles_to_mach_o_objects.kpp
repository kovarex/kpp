// spec: a program for macOS x86-64 compiles into Mach-O objects and links as macos's does (macos_sdk_checked_before_the_build: the same SDK lists x86_64 too), into a Mach-O x86-64 executable (M3)
// target: macos-x64 (a Mach-O program: built, not run, by run_spec.py --target macos-x64)
// kpp: --no-std --target macos-x64 --sysroot {here}/macos_sdk_checked_before_the_build.sdk
extern "C" int printf(const char* format, ...);
template<class T> struct Box { T v; T twice() const { return v * 2; } };
class Shape { public: virtual int area() const { return 0; } virtual ~Shape() {} };
class Square : public Shape { public: int s = 3; int area() const override { return s * s; } };
thread_local int counter = 4;
int main()
{
  Box<int> b{21};
  Square q;
  const Shape& s = q;
  static int once = b.twice();
  try
  {
    throw 7;
  }
  catch (int e)
  {
    printf("%d %d %d %d\n", once, s.area(), counter, e);
  }
  return 0;
}
