// spec: the value assigned to a typed union may read what it holds through a reference or a pointer, which no check sees: the value comes first, so each line prints its text (design.md 8.5)
// found by thread B (2026-11-06): the alternative held was destroyed first, and these read the destroyed String: empty lines, exit 0
class Named
{
public:
  Named(const std::String& name) : name(name) {}
  std::String name;
};

class Both
{
public:
  Both(const char* first, const char* second) : first(first), second(std::String(second)) {}
  std::String first;
  Named second;
};

union enum Held : u8
{
  { {int, Count}, {std::String, Words}, {Named, Object}, {Both, Two} }
};

const char* text = "a text long enough to be held outside the object";
Held* current = nullptr;

Named reachedThroughAPointer() { return Named((*current)[Words]); }

int main()
{
  Held h;
  h[Words] = text;
  std::String& alias = h[Words];
  h[Object] = Named(alias);
  std::println(h[Object].name);

  Held whole;
  whole[Words] = text;
  std::String& wholeAlias = whole[Words];
  whole = Named(wholeAlias);
  std::println(whole[Object].name);

  Held same;
  same[Words] = text;
  std::String& self = same[Words];
  same = self;
  std::println(same[Words]);

  Held count;
  count[Count] = 4;
  count = count[Count] + 1;
  std::println(count[Count]);

  Held inside;
  inside[Two] = Both(text, "the second text, long enough to be held outside too");
  inside[Object] = inside[Two].second;
  std::println(inside[Object].name);

  Held first;
  first[Two] = Both(text, "second");
  first[Words] = first[Two].first;
  std::println(first[Words]);

  Held reached;
  reached[Words] = text;
  current = &reached;
  reached[Object] = reachedThroughAPointer();
  std::println(reached[Object].name);
  return 0;
}
