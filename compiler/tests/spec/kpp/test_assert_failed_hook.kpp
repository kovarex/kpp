// spec: a program's testAssertFailed replaces what a failing assert does in a test build (the game's throws, and its tests check that)
// test:
// exit: 0
void testAssertFailed([[maybe_unused]] const char* file, [[maybe_unused]] int line, [[maybe_unused]] int column, const char* text)
{
  throw std::RuntimeError(std::String(text));
}

test AssertThrows
{
  int x = 1;
  requireThrows<std::RuntimeError>(([&] { release_assert(x == 2); })());
  std::println("went on");
}
