// spec: `u[Other] = value` where the new class value reads the alternative held, as std::variant's `v = T(get<U>(v))`: the value comes first, then the held one goes and the value is moved to its place (design.md 8.5)
// until 2026-11-06 the value was built in the alternative's place, the held one destroyed before it: this stopped on the check that the union holds that alternative
class Named
{
public:
  Named(const String& name) : name(name) {}
  String name;
};

union enum Held : u8
{
  { {int, Count}, {String, Words}, {Named, Object} }
};

int main()
{
  Held h;
  h[Words] = "a text long enough to be held outside the object";
  h[Object] = Named(h[Words]);
  println(h[Object].name);
  return 0;
}
