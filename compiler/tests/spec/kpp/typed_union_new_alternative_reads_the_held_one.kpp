// spec: `u[Other] = value` where the new class value reads the alternative held: std::variant's `v = T(get<U>(v))` computes it first; kpp builds a new alternative in place (the game's loading needs no move: kpp/typed_union_alternative_built_in_place), and destroys the held one before, so reading it stops on the check that the union holds that alternative (it holds none by then): loud, but not what C++ does
// pending: the place is the alternative's own storage: the arguments would have to be evaluated before the held alternative goes, or the construction proved not to read the union (B, 2026-11-06)
class Named
{
public:
  Named(const String& name) : name(name) {}
  String name;
};

union enum Held : u8
{
  { {int, Count}, {String, Words}, {Named, Object} }
};

int main()
{
  Held h;
  h[Words] = "a text long enough to be held outside the object";
  h[Object] = Named(h[Words]);
  println(h[Object].name);
  return 0;
}
