// spec: a function or class declared test may use check and require; a failure names the check, then each test function's call up to the test
// test:
// exit: 1
test void requireNonNegative(int value)
{
  require(value >= 0, "value ", value);
}

test class Checker
{
public:
  void all(int a, int b)
  {
    requireNonNegative(a);
    requireNonNegative(b);
  }
};

suite Helpers
{
  test Values
  {
    Checker checker;
    checker.all(1, -2);
    std::println("not reached");
  }
}
