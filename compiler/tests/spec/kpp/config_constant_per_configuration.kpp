// spec: a constant whose value differs per configuration is one declaration whose initializer chooses by the configuration (design.md 19: `constexpr i32 ROW_STEP = config::debug ? 4 : 2;`): a constant expression in each, usable in static_assert, and the statements after it see the configuration's value, as C++'s `#ifdef DEBUG ... #else ... #endif` declared it
// factorio: FogShaderRenderLogic's `constexpr int32_t ROW_STEP` (4 under DEBUG, 2 otherwise) and TestNoisePerformance's `static constexpr uint32_t ITERATIONS` (16, 128), each used after its #endif (design.md 12, "The game's DEBUG as config::debug")
int main()
{
  constexpr int step = config::debug ? 4 : 2;
  static_assert(step > 0);
  int total = 0;
  for (int i = 0; i < 8; i += step)
    ++total;
  std::println(total);
  return 0;
}
