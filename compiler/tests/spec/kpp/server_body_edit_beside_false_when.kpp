// spec: a compile server's builds after each edit are what a build from scratch gives (docs/compile-speed.md, "The compile server"): a file with a false `when` (design.md 19) at namespace and class scope takes a body's edit as an edit of that body, the absent declarations' names still hiding outer ones; a use of one is still the error
// kpp: --config tracing=false
//--- step: the program
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
int shown() { return 2; }
int main()
{
  Stats s;
  println(shown() + s.hits);
  return 0;
}
// expect: 3
//--- step: a body edited, the when declarations above it untouched
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
int shown() { return 20; }
int main()
{
  Stats s;
  println(shown() + s.hits);
  return 0;
}
// expect: 21
//--- step: a body using the absent global
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
int shown() { return releaseCounter; }
int main()
{
  Stats s;
  println(shown() + s.hits);
  return 0;
}
// error: 'releaseCounter' exists only when
//--- step: a body using the absent member
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
int shown() { return 4; }
int main()
{
  Stats s;
  println(shown() + s.releaseHits);
  return 0;
}
// error: 'releaseHits' exists only when
//--- step: fixed again
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
int shown() { return 5; }
int main()
{
  Stats s;
  println(shown() + s.hits);
  return 0;
}
// expect: 6
//--- step: an error typed into a false condition
when (config::tracng) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
int shown() { return 5; }
int main()
{
  Stats s;
  println(shown() + s.hits);
  return 0;
}
// error: config::tracng is not declared
//--- step: a class template with a false member
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
template<class T> struct Box
{
  T value = 1;
  when (config::tracing) int extra = 0;
  int get() { return value + 1; }
};
int shown() { return 5; }
int main()
{
  Stats s;
  Box<int> b;
  println(shown() + s.hits + b.get());
  return 0;
}
// expect: 8
//--- step: the class template's member function's body edited
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
template<class T> struct Box
{
  T value = 1;
  when (config::tracing) int extra = 0;
  int get() { return value + 10; }
};
int shown() { return 5; }
int main()
{
  Stats s;
  Box<int> b;
  println(shown() + s.hits + b.get());
  return 0;
}
// expect: 17
//--- step: its absent member used through the instance
when (config::tracing) int releaseCounter = 0;
struct Stats
{
  int hits = 1;
  when (config::tracing) int releaseHits = 0;
};
template<class T> struct Box
{
  T value = 1;
  when (config::tracing) int extra = 0;
  int get() { return value + 10; }
};
int shown() { return 5; }
int main()
{
  Stats s;
  Box<int> b;
  println(shown() + s.hits + b.extra);
  return 0;
}
// error: 'extra' exists only when
