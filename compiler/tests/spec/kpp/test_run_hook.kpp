// spec: the program's testRun(run) wraps each test's fixture and body; it may catch the program's exception and call run again, which builds a new fixture; a failed require's TestEnded passes through
// test:
// exit: 1
struct Desync {};

class Fixture
{
public:
  Fixture() { std::println("built"); }
  ~Fixture() { std::println("destroyed"); }
};

bool reporting = false;

void testRun(std::Function<void()> run)
{
  try
  {
    run();
  }
  catch (const Desync&)
  {
    std::println("rerun");
    reporting = true;
    run();
  }
}

suite Rerun
{
  test Desyncs : Fixture
  {
    if (!reporting)
      throw Desync();
    std::println("second run");
    require(false, "reported");
  }

  test Plain { std::println("plain"); }
}
