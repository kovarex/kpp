//--- step: the struct given a member
struct Values
{
  int a = 3;
  int b = 4;
  int compute() const
  {
    struct Category
    {
      Category(int p) : potential(p), left(p) {}
      int used() const { return (this.potential - this.left) * this.scale; }
      int potential;
      int left;
      int scale = 3;
    };
    auto take = [](Category& c, int n) { c.left -= n; return c.left; };
    Category one(this.a);
    Category two(this.b);
    take(one, 1);
    take(one, 1);
    take(two, 2);
    std::Vector<Category> all;
    all.push_back(one);
    all.push_back(two);
    int sum = 0;
    for (const Category& c : all)
      sum = sum * 10 + c.used();
    return sum;
  }
};
int main()
{
  Values v;
  std::println(v.compute());
  return 0;
}
// expect: 66
