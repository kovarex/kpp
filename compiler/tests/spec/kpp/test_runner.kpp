// spec: `kpp --test file.kpp` builds the file's `test name { }` declarations with a runner in place of main and runs them all
// test:
// exit: 0
int square(int x) { return x * x; }
// Outside test code, check is an ordinary name; a test must not see one bare (kpp/test_check_hidden_name_is_error).
namespace math
{
  int check(int x) { return x + 1; }
  int checkTwice(int x) { return check(check(x)); }
}

test squareOfThree
{
  check(square(3) == 9);
}

test squareOfANegative
{
  check(square(-2) == 4);
  check(square(0) == 0);
  check(math::check(1) == 2);
  check(math::checkTwice(1) == 3);
}

int main()
{
  std::println("main is not part of a test build");
  return 3;
}
