// spec: Direction::fromStr returning an Optional
// design.md 8.4
enum class Direction : uint8_t
{
  { North, East, South, West }
};
int main()
{
  std::Optional<Direction> d = Direction::fromStr("South");
  std::Optional<Direction> none = Direction::fromStr("Up");
  std::println(d.hasValue() && *d == Direction::South, " ", none.hasValue());
  return 0;
}
