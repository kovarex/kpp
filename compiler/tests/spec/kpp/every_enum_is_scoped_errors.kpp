// spec: a kpp enum's enumerator outside it is named through it, and its value converts to no number without a cast (every enum is scoped, design.md 8.4, kovarex 2026-11-18)
// error: every_enum_is_scoped_errors.kpp:5: error: 'Green' is not declared
// error: every_enum_is_scoped_errors.kpp:6: error: a value of the enum Color does not convert to int32 without a cast
enum Color { Red, Green };
Color pick() { return Green; }
int number() { int n = Color::Red; return n; }
int main()
{
  return int(pick()) + number();
}
