{
  return v + 1;
}

int positionD()
{
  return lineOf();
}
//--- file: e.kpp
int editedE(int v)
{
  return v + 1;
}

int positionE()
{
  return lineOf();
}
//--- file: f.kpp
int editedF(int v)
{
  return v + 1;
}

int positionF()
{
  return lineOf();
}
//--- step: a line added to the first body of every file
int lineOf(std::CallerLocation here = caller)
{
  return int(here.line());
}

int main()
{
  std::println(editedA(1), " ", editedB(1), " ", editedC(1), " ", editedD(1), " ", editedE(1), " ", editedF(1));
  std::println(positionA(), " ", positionB(), " ", positionC(), " ", positionD(), " ", positionE(), " ", positionF());
  return 0;
}
