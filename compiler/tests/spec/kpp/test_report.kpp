// spec: the runner's --report FILE (- for stdout) writes one JSON object per test (a suite's with its suite) and a summary, for editors and test explorers; the text in it is escaped
// test: --report - --filter fails --filter Parsing.*
// exit: 1
test fails
{
  String s("a\"b");
  check(s == "a\"c");
}

suite Parsing
{
  test quotes
  {
    check(true);
  }
}
