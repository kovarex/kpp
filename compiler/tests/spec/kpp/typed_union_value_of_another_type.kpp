// spec: `u[Name] = x` with x of another type than the alternative's: the alternative held takes it by that class's operator= for x, as `get<T>(v) = x`, which need not mean what the constructor for x means; another alternative is destroyed once the class's value of x is built, and if that throws the union keeps what it holds (design.md 8.5)
// found by thread B (2026-11-06): x was always converted, and the conversion assigned
class Fixed
{
public:
  Fixed(int raw) : raw(raw)
  {
    if (raw < 0)
      throw std::RuntimeError("no");
    std::println("constructed ", raw);
  }
  Fixed(Fixed&& other) noexcept : raw(other.raw) { std::println("moved ", this.raw); }
  Fixed& operator=(Fixed&& other) noexcept
  {
    this.raw = other.raw;
    std::println("move assigned ", this.raw);
    return this;
  }
  Fixed& operator=(int whole)
  {
    this.raw = whole * 100;
    std::println("assigned ", whole);
    return this;
  }
  int raw;
};

union enum Held : u8
{
  { {std::String, Words}, {Fixed, Number} }
};

int twice(int value)
{
  std::println("evaluated once");
  return value * 2;
}

int main()
{
  Held h;
  h[Words] = "a text long enough to be held outside the object";
  std::println("-- another alternative");
  h[Number] = 5;
  std::println(h[Number].raw);
  std::println("-- the alternative held");
  h[Number] = twice(5);
  std::println(h[Number].raw);
  std::println("-- a value of its class");
  h[Number] = Fixed(7);
  std::println(h[Number].raw);
  std::println("-- the value throws, the union keeps what it holds");
  Held text;
  text[Words] = "a text long enough to be held outside the object";
  try
  {
    text[Number] = -1;
  }
  catch (const std::RuntimeError& e)
  {
    std::println(std::StringView(e.what()), " ", text[Words].size());
  }
  return 0;
}
