// spec: typed unions (`union enum`)
// design.md 8.5; replaces std::variant and the tagged unions of InputAction
union enum Property : uint8_t
{
  { {Integer, int}, {Double, double}, {Text, std::String} }
};
int main()
{
  Property p;
  p[Property::Tag::Integer] = 5;
  bool wasInt = p == Property::Tag::Integer;
  p[Property::Tag::Text] = std::String("t");
  std::println(wasInt, " ", p == Property::Tag::Text, " ", p[Property::Tag::Text]);
  return 0;
}
