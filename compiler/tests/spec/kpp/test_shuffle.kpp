// spec: --shuffle SEED prints the seed and keeps the dependency order: one seed gives one order on every target
// test: --shuffle 3
// exit: 0
suite Base
{
  test First { std::println("Base.First"); }
  test Second { std::println("Base.Second"); }
}

suite Middle depends Base
{
  test Only { std::println("Middle.Only"); }
}

suite Top depends Middle
{
  test Last { std::println("Top.Last"); }
}

suite Other
{
  test Alone { std::println("Other.Alone"); }
}
