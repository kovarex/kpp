// spec: VariantAlternative<I, U> of a typed union is the type of its I-th alternative, as std::variant_alternative_t is of a variant: in a static_assert, with an index given by a constant, in a declaration
// factorio: SegmentedUnitAI's five static_assert(isSame<VariantAlternative<PatrollingIndex, AIState>, SegmentedUnitAI::Patrolling>)
struct Walking
{
  int speed = 3;
};
struct Resting
{
  double hours = 1.5;
};
union enum State
{
  { {Walking, Walk}, {Resting, Rest} }
};
static constexpr size_t RestIndex = 1;
static_assert(std::isSame<std::VariantAlternative<0, State>, Walking>);
static_assert(std::isSame<std::VariantAlternative<RestIndex, State>, Resting>);
int main()
{
  std::VariantAlternative<0, State> w;
  std::println(w.speed, " ", sizeof(std::VariantAlternative<1, State>));
  return 0;
}
