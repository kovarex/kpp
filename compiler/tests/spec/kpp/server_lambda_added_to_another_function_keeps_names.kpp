// expect: 12 14
//--- step: the lambda and the struct taken out again
template<class F>
int applyTwice(F f, int v) { return f(f(v)); }

int first(int v)
{
  return v + 1;
}

int second(int v)
{
  struct Pair
  {
    int a;
    int b;
    int sum() const { return this.a * this.b; }
  };
  std::Function<int(int)> held = [](int x) { return x * 3; };
  auto generic = [](auto x) { return x + x; };
  Pair p{v, held(v)};
  return applyTwice([](int x) { return x - 1; }, p.sum()) + generic(v);
}

int main()
{
  std::println(first(1), " ", second(2));
  return 0;
}
// expect: 2 14
