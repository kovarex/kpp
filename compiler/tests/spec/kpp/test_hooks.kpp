// spec: the runner calls testsSetup(the arguments it does not know) before the first test, testAfterEach() after each and testsTeardown() after the last, when the program defines them
// test: --heavy --filter Hooks.*
// exit: 1
int leaked = 0;

void testsSetup(const std::Vector<std::String>& arguments)
{
  for (const std::String& argument : arguments)
    std::println("setup ", argument);
}

test void testAfterEach()
{
  std::println("after each");
  require(leaked == 0, "leaked ", leaked);
}

void testsTeardown() { std::println("teardown"); }

suite Hooks
{
  test Clean { std::println("clean"); }
  test Leaky { leaked = 1; }
}
