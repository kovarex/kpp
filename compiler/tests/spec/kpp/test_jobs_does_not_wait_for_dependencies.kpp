// spec: under --jobs (without --exit-on-failure) a suite does not wait for its dependencies, as Factorio's --fork: the processes share nothing, so Base and Last, 5 s each, end together; one after the other they take at least 10 s, whatever the load, and together 5 s and the workers' start
// test: --jobs 2
// exit: 0
auto started = SteadyClock::now();

suite Base
{
  test Sleeps { thisThread::sleepFor(Seconds(5)); }
}

suite Last depends Base
{
  test Sleeps { thisThread::sleepFor(Seconds(5)); }
}

// (the first process, once both workers have ended)
void testsTeardown()
{
  if (testWorker() == 0)
    println(StringView(SteadyClock::now() - started < Milliseconds(9500) ? "together" : "one after the other"));
}
