// spec: under --jobs (without --exit-on-failure) a suite does not wait for its dependencies, as Factorio's --fork: the processes share nothing, so Base and Last run at once. Each test marks its start and waits for the other's, so each sees the other start only when both run at once; one after the other, Base never sees Last's (it gives up after 60 s), whatever the load (2026-11-08: timed, 5 s each ending within 9.5 s, it failed at 99% load)
// test: --jobs 2
// exit: 0
if constexpr (config::platform == Platform::Windows)
{
  extern "C" int _putenv_s(const char* name, const char* value);
  extern "C" unsigned long GetCurrentProcessId();
  void setVariable(const char* name, const char* value) { _putenv_s(name, value); }
  u64 processId() { return GetCurrentProcessId(); }
}
else
{
  extern "C" int setenv(const char* name, const char* value, int overwrite);
  extern "C" int getpid();
  void setVariable(const char* name, const char* value) { setenv(name, value, 1); }
  u64 processId() { return u64(getpid()); }
}

// This run's name: the first process makes it before it starts the workers, which inherit it, so
// two runs of the snippet at once share no directory.
std::String nameThisRun()
{
  const char* variable = "KPP_SPEC_TEST_JOBS_DOES_NOT_WAIT";
  if (const char* inherited = std::getenv(variable); inherited && inherited[0] != 0)
    return std::String(inherited);
  std::String name;
  name << "kpp-spec-test-jobs-does-not-wait-" << processId() << "-" << std::SteadyClock::now().time_since_epoch().count();
  setVariable(variable, name.c_str());
  return name;
}

std::String runName = nameThisRun();

std::filesystem::path runDirectory() { return std::filesystem::temp_directory_path() / runName; }

// Marks this test's start, waits for the other's and marks that it saw it.
void meet(const char* self, const char* other)
{
  std::filesystem::create_directories(runDirectory() / (std::String(self) << ".started"));
  auto limit = std::SteadyClock::now() + std::Seconds(60);
  while (!std::filesystem::exists(runDirectory() / (std::String(other) << ".started")))
  {
    if (std::SteadyClock::now() > limit)
      return;
    std::thisThread::sleepFor(std::Milliseconds(10));
  }
  std::filesystem::create_directory(runDirectory() / (std::String(self) << ".saw"));
}

suite Base
{
  test Meets { meet("Base", "Last"); }
}

suite Last depends Base
{
  test Meets { meet("Last", "Base"); }
}

// (the first process, once both workers have ended)
void testsTeardown()
{
  if (testWorker() != 0)
    return;
  bool together = std::filesystem::exists(runDirectory() / "Base.saw") && std::filesystem::exists(runDirectory() / "Last.saw");
  std::filesystem::remove_all(runDirectory());
  std::println(std::StringView(together ? "together" : "one after the other"));
}
