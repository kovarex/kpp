// spec: the constant evaluation runs a kpp enum's methods, as it runs a class's: a const method of a constant (`Dir::East.turned()`), a method that changes the value it is called on (`d.turnTwice()` in a function evaluated at compile time), one that calls another on `this`, and a const one that reads `this` (thread B, 2026-11-12: each was "no constant")
enum class Dir : u8
{
  { North, East, South, West }
  void turn() { this = Dir((u8(this) + 1) & 3); }
  void turnTwice()
  {
    this.turn();
    this.turn();
  }
  Dir turned() const
  {
    Dir copy = this;
    copy.turn();
    return copy;
  }
  bool vertical() const { return this == North || this == South; }
};
constexpr Dir afterTwo(Dir d)
{
  d.turnTwice();
  return d;
}
constexpr Dir turnedEast = Dir::East.turned();
constexpr Dir fromNorth = afterTwo(Dir::North);
static_assert(turnedEast == Dir::South);
static_assert(fromNorth == Dir::South);
static_assert(Dir::North.vertical() && !Dir::East.vertical());
int main()
{
  std::println(turnedEast, " ", fromNorth, " ", Dir::West.vertical());
  return 0;
}
