template<typename T> i32 retry(const T& value)
{
  i32 tries = 0;
  if (value > 0)
    goto again;
  ++tries;
  if constexpr (std::isSame<T, f64>)
    return -1;
  ++tries;
  if (tries > 3)
  again:
    return tries;
  return tries + 1;
}
