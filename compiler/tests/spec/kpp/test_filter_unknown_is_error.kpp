// spec: a --filter that no test matches is an error, nothing runs (it would run 0 tests and pass)
// test: --filter Parsing.Number --filter Parsing.Nubmers
// exit: 2
suite Parsing tags slow
{
  test Numbers { println("Parsing.Numbers"); }
}

suite Printing
{
  test Numbers { println("Printing.Numbers"); }
}

test alone { println("alone"); }
