using ItemStackIndex = strong u16;
using InventoryIndex = strong u16;
using Flag = strong bool;
void take([[maybe_unused]] ItemStackIndex index) {}
ItemStackIndex fromLiteral() { ItemStackIndex i = 3; return i; }
ItemStackIndex fromOther() { ItemStackIndex i = InventoryIndex(3); return i; }
u16 toNumber() { u16 n = ItemStackIndex(3); return n; }
ItemStackIndex addOther() { return ItemStackIndex(1) + InventoryIndex(2); }
ItemStackIndex addNumber() { return ItemStackIndex(1) + 2; }
bool compareOther() { return ItemStackIndex(1) == InventoryIndex(1); }
bool compareNumber() { return ItemStackIndex(1) < 2; }
void passNumber() { take(1); }
void passOther() { take(InventoryIndex(1)); }
Flag flagArithmetic() { return Flag::True + Flag::True; }
bool flagCopy() { bool b = Flag::True; return b; }
int main()
{
  return 0;
}
