// spec: currentTestName() is the running test's full name, also in the hooks around it, and empty outside a test
// test:
// exit: 0
void testsSetup([[maybe_unused]] const std::Vector<std::String>& arguments) { std::println("setup [", currentTestName(), "]"); }
void testBeforeEach() { std::println("before ", currentTestName()); }
void testsTeardown() { std::println("teardown [", currentTestName(), "]"); }

suite Names
{
  test One { std::println("in ", currentTestName()); }
}
