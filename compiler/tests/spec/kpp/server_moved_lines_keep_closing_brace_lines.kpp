// expect: 116
//--- step: two lines taken out above
int counter = 0;
struct Guard
{
  ~Guard() { counter += 100; }
};

void first() { counter += 1; }

void second()
{
  {
    Guard g;
    counter += 2;
  }
  counter += 3;
}

int main()
{
  first();
  second();
  std::println(counter);
  return 0;
}
// expect: 106
