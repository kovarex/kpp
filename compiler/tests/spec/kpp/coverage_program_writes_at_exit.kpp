// spec: kpp --coverage without tests: the program writes its coverage at its exit, to KPP_COVERAGE_FILE (- for stdout) or else kpp-coverage.json, and says the summary and the file (here Windows' NUL: the test runner's snippets show the file's lines)
// target: windows (the snippet sets the variable with _putenv)
// kpp: --coverage
// run:
extern "C" int _putenv(const char* setting);

int pick(int x)
{
  if (x > 1)
    return 1;
  return 0;
}

int main()
{
  _putenv("KPP_COVERAGE_FILE=NUL");
  std::println(pick(1));
  return 0;
}
