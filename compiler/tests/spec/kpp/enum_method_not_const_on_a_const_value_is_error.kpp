// spec: a method of a kpp enum that is not const changes its value, so it is not called on a const one, as a class's is not on a const object (until 2026-11-11 it compiled and changed a copy)
// error: enum_method_not_const_on_a_const_value_is_error.kpp:12: error: the member function turn is not const, and its object is a const Dir
enum class Dir : u8
{
  { North, East, South, West }
  void turn() { this = Dir((u8(this) + 1) & 3); }
};

int main()
{
  const Dir d = Dir::East;
  d.turn();
  return 0;
}
