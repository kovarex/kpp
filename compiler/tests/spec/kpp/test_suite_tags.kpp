// test: --tag vanilla
// exit: 0
suite Common
{
  test Runs { println("Common.Runs"); }
}

suite Vanilla tags vanilla
{
  test Runs { println("Vanilla.Runs"); }
}

suite Both tags vanilla, space
{
  test Runs { println("Both.Runs"); }
}
