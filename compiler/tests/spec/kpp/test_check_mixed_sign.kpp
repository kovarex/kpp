// spec: inside check and require, a signed and an unsigned integer compare by value (std::cmp_equal's rule), as Factorio's CHECK_EQUAL does; outside a check the signed side converts
// test:
// exit: 1
suite Signs
{
  test Compare
  {
    int m = -1;
    unsigned u = 4294967295u;
    std::println("outside a check: ", m == u);
    check(u > m);
    check(m == u);
  }
}
