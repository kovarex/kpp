// spec: test Name : Fixture(arguments): the body is a member of a class derived from the fixture, built before the body and destroyed after it, also when the body fails
// test:
// exit: 1
class Counter
{
public:
  Counter(int start = 0) : value(start) { std::println("built ", this.value); }
  ~Counter() { std::println("destroyed ", this.value); }
protected:
  int value;
  void bump() { ++this.value; }
};

suite Counting
{
  test Plain : Counter
  {
    this.bump();
    require(this.value == 1);
  }

  test WithStart : Counter(10)
  {
    this.bump();
    require(this.value == 12);
    std::println("not reached");
  }
}
