// spec: test Name : Fixture(arguments): the body is a member of a class derived from the fixture, built before the body and destroyed after it, also when the body fails
// pending: suites, fixtures and the checks of design.md 8.7 are not implemented yet
// test:
// exit: 1
class Counter
{
public:
  Counter(int start = 0) : value(start) { println("built ", value); }
  ~Counter() { println("destroyed ", value); }
protected:
  int value;
  void bump() { ++value; }
};

suite Counting
{
  test Plain : Counter
  {
    bump();
    require(value == 1);
  }

  test WithStart : Counter(10)
  {
    bump();
    require(value == 12);
    println("not reached");
  }
}
