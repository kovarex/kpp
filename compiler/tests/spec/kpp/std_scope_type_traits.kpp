// spec: --std-scope: std::Conditional and the other built-in traits work qualified, and a program's own template of such a name is that template, never the trait (a silent wrong answer otherwise)
// factorio: none yet
// kpp: --std-scope
template<bool B, typename T, typename F> struct Conditional
{
  static constexpr int mine = 11;
};
template<typename T> struct Decay
{
  static constexpr int mine = 22;
};
std::Conditional<true, char, double> small = 'x';
enum class Flags : u16
{
  A
};
int main()
{
  std::println(sizeof(std::Conditional<true, char, double>), " ", sizeof(std::Conditional<false, char, double>), " ", sizeof(small));
  std::println(sizeof(std::Decay<const int&>), " ", std::isSame<std::RemoveConst<const int>, int>);
  std::println(Conditional<true, char, double>::mine, " ", Decay<int>::mine);
  std::println(sizeof(Conditional<true, char, double>));
  using UnderlyingType = UnderlyingType<Flags>;
  std::println(sizeof(UnderlyingType));
  return 0;
}
