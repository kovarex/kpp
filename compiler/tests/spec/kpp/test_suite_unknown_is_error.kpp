// spec: a --suite that names no suite is an error, nothing runs (it would run 0 tests and pass); names match case-insensitively
// test: --suite parsing --suite Parse
// exit: 2
suite Parsing tags slow
{
  test Numbers { std::println("Parsing.Numbers"); }
}

suite Printing
{
  test Numbers { std::println("Printing.Numbers"); }
}

test alone { std::println("alone"); }
