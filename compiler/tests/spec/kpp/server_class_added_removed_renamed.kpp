//--- step: a plain class added beside it, and a function using it
class Shape
{
public:
  virtual ~Shape() {}
  virtual i32 area() const = 0;
};
class Square : public Shape
{
public:
  Square(i32 side) : side(side) {}
  i32 area() const override { return this.side * this.side; }

private:
  i32 side = 0;
};
i32 areaOf(const Shape& shape)
{
  return shape.area();
}
class Disc : public Shape
{
public:
  Disc(i32 r) : r(r) {}
  i32 area() const override
  {
    i32 sum = 0;
    for (i32 i = 0; i < this.r; ++i)
      sum += 3 * this.r;
    return sum;
  }

private:
  i32 r = 0;
};
i32 roundArea()
{
  Disc c(2);
  return areaOf(c);
}
struct Extent
{
  i32 a = 1;
  i32 b = 2;
  i32 sum() const
  {
    i32 s = 0;
    for (i32 i = 0; i < 2; ++i)
      s += i == 0 ? this.a : this.b;
    return s;
  }
};
i32 extentSum()
{
  Extent p;
  return p.sum();
}
int main()
{
  Square a(3);
  std::println(areaOf(a), " ", roundArea(), " ", extentSum());
  return 0;
}
