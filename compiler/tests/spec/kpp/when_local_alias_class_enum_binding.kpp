// spec: `when` on a local alias (using and typedef), a local class, a local enumeration and a structured binding (design.md 19), as on a local variable: each exists only where its condition holds, two of one name stand for an #ifdef/#else pair
// factorio: Gui.cpp's debug-only `using MapType = HashMap<...>;` used by a later debug-only local, and DebugHelpers.hpp's `using ValueType = IteratorTraits<RandomIt>::value_type;`
struct Pair2
{
  int a;
  int b;
};
Pair2 make() { return {3, 4}; }

int main()
{
  when (config::debug) using Count = long long;
  when (!config::debug) using Count = int;
  Count c = 5;
  std::println((int)sizeof(Count), " ", (int)c);
  when (config::debug) typedef int DebugInt;
  when (config::debug) DebugInt extra = 7;
  when (config::debug) struct Probe
  {
    int v = 9;
  };
  when (config::debug) Probe probe;
  when (config::debug) enum class Level { low, high };
  when (config::debug) auto [x, y] = make();
  if constexpr (config::debug)
    std::println(extra, " ", probe.v, " ", x + y, " ", (int)Level::high);
  else
    println("release");
  return 0;
}
