// spec: check(expr, arguments...) and require(expr, arguments...) print the arguments after the failure, as println prints them (Factorio's CHECK_*_SIGNED)
// test:
// exit: 1
suite Messages
{
  test Items
  {
    int counts[3] = {4, 5, 7};
    for (int i = 0; i < 3; ++i)
      check(counts[i] < 6, "item ", i);
    require(counts[0] == 5, "first");
    std::println("not reached");
  }
}
