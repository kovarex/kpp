// spec: a condition (`if (pointer)`, `pointer ? 1 : 0`) of a class with an operator bool that converts only in a condition (unmarked: explicit by default; C++'s `explicit operator bool`) and an implicit conversion operator template takes the operator bool, the non-template, which overload resolution prefers to the template's bool where both convert equally well ([over.match.best] 2.4); clang's `1 1` (C++'s `explicit operator bool` beside `template<class T> operator T()`, as the game's tests' DynamicEntityPointer has them, there constrained to pointers; until 2026-11-08 codegen's "does not support a conversion from Pointer to bool" for either condition); language/copy_initialization_of_a_bool_takes_no_explicit_operator_bool has a copy's conversion beside them
struct Entity
{
  int id = 7;
};
struct Pointer
{
  operator bool() const { return this.entity != nullptr; }
  template<typename T>
  implicit operator T() const { return static_cast<T>(this.entity); }
  Entity* entity = nullptr;
};
int main()
{
  Entity entity;
  Pointer pointer;
  pointer.entity = &entity;
  int on = 0;
  if (pointer)
    on = 1;
  std::println(on, " ", pointer ? 1 : 0);
  return 0;
}
