// spec: with a good macOS SDK (11.3, with arm64's stubs) a program for macOS arm64 (a triple names it) compiles into Mach-O objects, no COMDATs in them (Mach-O has none: the shared definitions are weak and coalesced), a template instance, a vtable, a thread_local, a static local and a throw included, and links with ld64.lld against the SDK's libSystem.tbd into a Mach-O arm64 executable (M3; the personality's weak references to kpp_eh_offset and kpp_eh_terminate allowed undefined); built on the macos run, not run here (macOS runs on CI's macOS runners, M10): --no-std
// target: macos (a Mach-O program: built, not run, by run_spec.py --target macos)
// kpp: --no-std --target arm64-apple-macosx12.0 --sysroot {here}/macos_sdk_checked_before_the_build.sdk
extern "C" int printf(const char* format, ...);
template<class T> struct Box { T v; T twice() const { return this.v * 2; } };
class Shape { public: virtual int area() const { return 0; } virtual ~Shape() {} };
class Square : public Shape { public: int s = 3; int area() const override { return this.s * this.s; } };
thread_local int counter = 4;
int main()
{
  Box<int> b{21};
  Square q;
  const Shape& s = q;
  static int once = b.twice();
  try
  {
    throw 7;
  }
  catch (int e)
  {
    printf("%d %d %d %d\n", once, s.area(), counter, e);
  }
  return 0;
}
