// spec: docs/differences-from-cpp.md, "Compile-time loops and reflection": for constexpr over members(T) with m.name and object.[m]
struct Settings
{
  int width = 640;
  bool fullscreen = false;
};

template<class T> std::String describe(const T& object)
{
  std::String result;
  for constexpr (auto m : members(T))
    result << std::format("{}={} ", std::StringView(m.name), object.[m]);
  return result;
}

int main()
{
  std::println(describe(Settings()));
  return 0;
}
