// spec: docs/differences-from-cpp.md, "typename and template are not needed": a dependent type is named without typename
template<typename Container>
Container::value_type first(const Container& container) { return container[0]; }

int main()
{
  std::Vector<int> numbers;
  numbers.push_back(7);
  std::println(first(numbers));
  return 0;
}
