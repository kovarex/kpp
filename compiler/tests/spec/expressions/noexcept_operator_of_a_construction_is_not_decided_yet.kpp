// spec: what the noexcept operator does not decide yet is an error naming it, never a guess (GlobalScope::canThrow): a construction of a class (its constructor and destructor), a call with an argument of class type, a call through a pointer
// error: the noexcept operator does not decide a construction of a class yet
// error: the noexcept operator does not decide a call with an argument of class type yet
struct Box
{
  int v;
  Box(int x) : v(x) {}
};
int take(Box b) { return b.v; }
int main()
{
  Box box(1);
  bool a = noexcept(Box(2));
  bool b = noexcept(take(box));
  return a + b;
}
