// spec: `c ? both : alone` with lvalues of a class Both and of its second base Second (Both : First, Second) is an lvalue of Second: in the first branch, both's Second part, read and assigned through a `Second&` bound to the conditional; and `c ? none : undo` with an Optional<Undo> and an Undo lvalue is a new Optional<Undo>, the Undo converted to it (C++ [expr.cond] 4); a base never converts to the derived class through the derived's converting constructor: `c ? negated : plain` with Negated deriving from Expression and `implicit Negated(const Expression&)` is plain itself when c is false (NoiseExpressions::Folding::subtract)
// found with expressions/conditional_converts_pointer_operand_to_class: the conditional of two lvalues was the address of either, of whatever type
struct First
{
  int first = 1;
};
struct Second
{
  int second = 2;
};
struct Both : First, Second
{
  int own = 3;
};
struct Expression
{
  int value = 0;
};
struct Negated : Expression
{
  implicit Negated(const Expression& operand) { this.value = -operand.value; }
};
struct Undo
{
  int start = 0;
  int end = 0;
};
void show(const Second& s) { std::print("[", s.second, "] "); }
int main()
{
  Both both;
  both.second = 20;
  Second alone;
  alone.second = 30;
  bool yes = true, no = false;
  show(yes ? both : alone);
  show(no ? alone : both);
  Second& r = yes ? both : alone;
  r.second = 21;
  std::println(both.second, " ", alone.second);
  std::Optional<Undo> none;
  Undo undo{4, 5};
  std::Optional<Undo> chosen = yes ? none : undo;
  std::Optional<Undo> other = no ? none : undo;
  std::println(chosen.hasValue(), " ", other.hasValue() ? other->end : -1);
  Expression plain;
  plain.value = 7;
  Negated negated(plain);
  const Expression& first = yes ? negated : plain;
  const Expression& picked = no ? negated : plain;
  std::println(first.value, " ", picked.value, " ", &picked == &plain);
  return 0;
}
