// spec: matching a C ellipsis (`f(...)`, `f(int, ...)`) is worse than any standard or user-defined conversion ([over.ics.rank] 2): an int takes `f(FromInt)` (a converting constructor), `f(double)` and `f(const Base&)` for a Derived over `f(...)`; clang 19 prints `1 2 2 2`
// factorio: found by the templates thread comparing overload choices against clang 19 on generated calls: the ellipsis ranked as a standard conversion, so `f(...)` won against a user-defined one and tied with the others (silent and loud)
struct Base { int x = 1; };
struct Derived : Base { int y = 2; };
struct FromInt { implicit FromInt(int v) {} };
int a(FromInt v) { return 1; }
int a(...) { return 2; }
int b(...) { return 1; }
int b(double v) { return 2; }
int c(...) { return 1; }
int c(const Base& v) { return 2; }
int d(int first, ...) { return 1; }
int d(int first, double second) { return 2; }
int main()
{
  Derived derived;
  println(a(5), " ", b(5), " ", c(derived), " ", d(1, 2));
  return 0;
}
