// spec: the pointer conversions C++ makes without a cast ([conv.ptr], [conv.qual], [expr.type]/4): adding const, to `void*` and `const void*`, from a derived class to its base (moved to the base part), `T* const*` to `const T* const*`, an array and a function to a pointer, nullptr; a comparison of two pointers compares them as their composite pointer type (`this != &other`, a `const Derived*` against a `Base*`)
// factorio: the checks of expressions/pointer_of_other_type_is_error must keep every one of these (ChartRenderer's `const DisplayPanel* const* panels = displayPanels.data()`, LogisticNetwork's `&robot == avoid`); clang 19 prints `1 1 1 2 1 1 1 1`
struct Base { int a = 1; };
struct Other { int o = 0; };
struct Derived : Other, Base { int b = 2; };
int twice(int x) { return 2 * x; }
struct Text
{
  int same(const Text& other) const { return int(this == &other); }
};
int main()
{
  int x = 1;
  const int* c = &x;
  void* v = &x;
  const void* cv = c;
  Derived d;
  Base* base = &d;
  const Base* constBase = &d;
  int* row[2] = {&x, &x};
  int* const* rows = row;
  const int* const* constRows = rows;
  int array[2] = {1, 2};
  int* first = array;
  int (*f)(int) = twice;
  int* none = nullptr;
  const Derived* cd = &d;
  Text t;
  println("{} {} {} {} {} {} {} {}", int(cv == v), int(base->a), int(constBase == base), f(1), int(**constRows), int(first[0]), int(none == nullptr), int(cd == base) + t.same(t) - 1);
  return 0;
}
