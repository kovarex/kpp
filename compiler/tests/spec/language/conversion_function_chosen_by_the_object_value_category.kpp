// spec: a conversion function's implicit object parameter binds the object as its value category says ([over.match.funcs] 4, 5): `operator int() &` converts an lvalue and `operator int() &&` an rvalue (a temporary, `move(r)`, a call's result), in a copy-initialization, an argument, a built-in operator, a cast and a condition; a non-const `&` one converts no temporary, which takes `operator double() const` instead; of `operator long() const&` and `operator long() &&` a temporary takes the && one ([over.ics.rank] 3.2.3), and a non-const lvalue `operator bool() &` over `operator int() const` ([over.ics.rank] 3.2.6). clang's output (the C++ with no `implicit`)
// found by thread J's conversion generator (2026-11-08): `operator int() &` beside `operator int() &&` was "the conversion of R to int32 is ambiguous" everywhere, the value category not told
extern "C" int printf(const char* format, ...);
struct R
{
  int v = 1;
  implicit operator int() & { printf("R>int& "); return this.v; }
  implicit operator int() && { printf("R>int&& "); return this.v + 10; }
};
struct Q
{
  int v = 2;
  implicit operator int() & { printf("Q>int& "); return this.v; }
  implicit operator double() const { printf("Q>double "); return this.v + 0.5; }
};
struct P
{
  int v = 3;
  implicit operator long() const& { printf("P>long-c& "); return this.v; }
  implicit operator long() && { printf("P>long&& "); return this.v + 10; }
};
struct B
{
  int v = 4;
  implicit operator bool() & { printf("B>bool& "); return true; }
  implicit operator int() const { printf("B>int "); return 0; }
};
R make() { return R{}; }
void show(int v) { printf("i%d\n", v); }
void show(long v) { printf("l%ld\n", v); }
void show(double v) { printf("d%.2f\n", v); }
int takeInt(int x) { return x; }
double takeDouble(double x) { return x; }
int main()
{
  R r;
  int a = r;
  show(a);
  int b = R{};
  show(b);
  int c = move(r);
  show(c);
  int d = make();
  show(d);
  show(takeInt(r));
  show(takeInt(R{}));
  show(takeInt(static_cast<R&&>(r)));
  show(r + 1);
  show(R{} * 2);
  show(3 - make());
  show(static_cast<int>(r));
  show(static_cast<int>(R{}));
  Q q;
  double x = q;
  show(x);
  double y = Q{};
  show(y);
  show(takeDouble(q));
  show(takeDouble(Q{}));
  show(q + 0.25);
  show(Q{} + 0.25);
  P p;
  const P kp;
  long l1 = p;
  show(l1);
  long l2 = P{};
  show(l2);
  long l3 = kp;
  show(l3);
  long l4 = move(p);
  show(l4);
  B bb;
  if (bb)
    printf("yes\n");
  if (B{})
    printf("yes\n");
  else
    printf("no\n");
  show((int)!bb);
  show((int)!B{});
  return 0;
}
