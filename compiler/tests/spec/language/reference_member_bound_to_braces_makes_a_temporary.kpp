// spec: an aggregate's reference member given braces binds the temporary they make ([dcl.init.list] 3.10): an array named by its alias (`N n{Two{Noisy(1), Noisy(2)}, 3}`) or by the member's type alone (`{Noisy(4), Noisy(5)}`, `A b{{10, 11, 12}}`), and a class (`P p{{30, 31}, 32}` with `const Point& p`); it lives as long as the aggregate variable ([class.temporary] 6), nested in another aggregate too, a global's and a static local's to the program's end, and a temporary aggregate's to the end of its full-expression (`show(N{Two{...}, 12})`). clang's and g++'s output
// codegen refused each until 2026-11-08 ("does not support a temporary array ... other than for a reference to an array", "the expression kind BraceInitExpr"), found with language/temporary_array_outside_a_reference
struct Noisy
{
  int v;
  implicit Noisy(int v) : v(v) { std::println("make ", v); }
  ~Noisy() { std::println("drop ", this.v); }
};
struct Point
{
  int x;
  int y;
  ~Point() { std::println("drop point ", this.x); }
};
struct A { const int (&r)[3]; };
struct N { const Noisy (&r)[2]; int k; };
struct P { const Point& p; int n; };
struct Outer { N n; P q; };
using Three = const int[3];
using Two = const Noisy[2];
A global{Three{1, 2, 3}};
A globalBraces{{4, 5, 6}};
int sum(const A& a) { return a.r[0] + a.r[1] + a.r[2]; }
int show(const N& n) { std::println("show ", n.r[0].v + n.r[1].v + n.k); return 0; }
int fromStatic()
{
  static N kept{Two{Noisy(20), Noisy(21)}, 1};
  return kept.r[0].v + kept.r[1].v;
}
int main()
{
  std::println("globals ", sum(global), " ", sum(globalBraces));
  {
    A a{Three{7, 8, 9}};
    A b{{10, 11, 12}};
    std::println("locals ", sum(a), " ", sum(b));
  }
  {
    N n{Two{Noisy(1), Noisy(2)}, 3};
    std::println("held ", n.r[0].v + n.r[1].v + n.k);
  }
  std::println("named done");
  {
    N m{{Noisy(4), Noisy(5)}, 6};
    std::println("held ", m.r[0].v + m.r[1].v + m.k);
  }
  std::println("braces done");
  {
    P p{{30, 31}, 32};
    std::println("held ", p.p.x + p.p.y + p.n);
  }
  std::println("point done");
  {
    Outer o{{Two{Noisy(7), Noisy(8)}, 9}, {{40, 41}, 42}};
    std::println("held ", o.n.r[0].v + o.n.k + o.q.p.x + o.q.n);
  }
  std::println("outer done");
  show(N{Two{Noisy(10), Noisy(11)}, 12});
  std::println("argument done");
  std::println("static ", fromStatic());
  std::println("static ", fromStatic());
  return 0;
}
