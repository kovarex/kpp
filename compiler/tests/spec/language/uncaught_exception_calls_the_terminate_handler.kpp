// spec: an exception nobody catches ends the program through the terminate handler setTerminate installed (C++'s std::terminate, [except.terminate]), called from the search with the throw site still on the stack; kpp's report of the exception comes first, on stderr
// pending on windows: an exception nobody catches prints its report and aborts on Windows: @main's handler does not call the UCRT's terminate()
struct Boom : Exception { Boom() : Exception("boom") {} };
void onTerminate()
{
  println("terminate");
  fflush(nullptr);
  exit(0);
}
int main()
{
  setTerminate(onTerminate);
  throw Boom();
  return 0;
}
