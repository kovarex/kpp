// spec: a typedef of a function type, `typedef void WriteFunc(void* context, int size);`, is the alias `using WriteFunc = void(void* context, int size);`: a pointer to it declared, assigned a function and called, as a local and as a member
// factorio: stb_image_write (converted as C): `typedef void stbi_write_func(void *context, void *data, int size);` and stbi__write_context's `stbi_write_func *func`, called as `s->func(s->context, &c, 1)` in 12 places; the converter writes the using form until this passes
typedef void WriteFunc(void* context, int size);
struct Writer
{
  WriteFunc* func;
  void* context;
};
void record(void* context, int size) { *(int*)context += size; }
int main()
{
  int total = 0;
  WriteFunc* direct = record;
  direct(&total, 2);
  Writer w;
  w.func = record;
  w.context = &total;
  Writer* p = &w;
  p->func(p->context, 3);
  println("{} {}", total, sizeof(WriteFunc*) == sizeof(void*));
  return 0;
}
