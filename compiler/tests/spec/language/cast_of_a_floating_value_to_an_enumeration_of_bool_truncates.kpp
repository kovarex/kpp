// spec: a floating value cast to an enumeration converts it to the underlying type by [conv.fpint] (truncation) and then to the enumeration ([expr.static.cast] 10): `(B)0.5` with `enum class B : bool` is B(0), as clang and MSVC's STL target both give (`0 1`); 1.5 truncates to 1
// pending: kpp converts the double to bool by [conv.bool] (nonzero is true), so `(B)0.5` is B::yes: prints `1 1`, a silent wrong answer. Found by the differential tests (compiler/tests/differential, registry/en3), 2026-11-16; D
extern "C" int printf(const char* format, ...);
enum class B : bool
{
  no,
  yes
};
int main()
{
  volatile double half = 0.5;
  volatile double more = 1.5;
  B h = (B)half;
  B m = static_cast<B>(more);
  printf("%d %d\n", (int)h, (int)m);
  return 0;
}
