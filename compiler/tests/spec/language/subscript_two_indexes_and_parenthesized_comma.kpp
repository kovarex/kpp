// spec: an operator[] taking two indexes takes `m[1, 0]` (C++23's multidimensional subscript), and `arr[(0, 1)]` is the comma operator in brackets, arr[1] (`3 8`, clang -std=c++23's)
// beside language/subscript_given_more_indexes_than_taken_is_error (2026-11-10), whose errors these two forms do not meet
struct M
{
  int data[4] = {1, 2, 3, 4};
  int operator[](int r, int c) const { return this.data[r * 2 + c]; }
};

int main()
{
  M m;
  int arr[3] = {7, 8, 9};
  int both = m[1, 0];
  int second = arr[(0, 1)];
  std::println(both, " ", second);
  return 0;
}
