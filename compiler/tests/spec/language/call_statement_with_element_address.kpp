// spec: a statement calling a function whose first argument is the address of an element or an element through a pointer is a call, not a declaration with a parenthesised declarator: `memcpy(&image[i * 4], &color, 3);`, `Holder<int>::exchange(*items[0], *items[1]);`
// factorio: DXTDecompression's `memcpy(&image[pixel * 4], &finalColor, 3);`, YCoCgDXTCompression's `memcpy( &colorBlock[j*4*4], inPtr, 4*4 );`, DeconstructionItemGui's `ChooseButton<FilterType>::swapCallbacks(*buttons[from], *buttons[to]);`
extern "C" import "string.h";
template<typename T>
struct Holder
{
  static void exchange(T& a, T& b)
  {
    T t = a;
    a = b;
    b = t;
  }
};
int main()
{
  unsigned char image[8] = {};
  unsigned int color = 0x030201;
  int i = 1;
  memcpy(&image[i * 4], &color, 3);
  int first = 1, second = 2;
  int* items[2] = {&first, &second};
  Holder<int>::exchange(*items[0], *items[1]);
  std::println((int)image[4], " ", (int)image[6], " ", first, " ", second);
  return 0;
}
