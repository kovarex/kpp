// spec: an unnamed bit field (`int : 0;`, padding) takes no initializer of an aggregate at compile time: `{1, 2, 3}` gives the named members
// pending: the interpreter gave the second value to the unnamed field, so b read the third (a wrong constant)
struct Spaced
{
  int a : 3;
  int : 0;
  int b : 4;
  uint8_t : 2;
  uint8_t c;
};
constexpr Spaced spaced{1, 2, 3};
static_assert(spaced.a == 1 && spaced.b == 2 && spaced.c == 3);
template<int N>
struct Show
{
  static constexpr int value = N;
};
int main()
{
  println("{}", Show<spaced.a + spaced.b + spaced.c>::value);
  return 0;
}
