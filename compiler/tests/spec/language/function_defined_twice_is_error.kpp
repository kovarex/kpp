// spec: a function defined twice is an error at the second definition, as in C++ ([basic.def.odr]), never two bodies the code generator emits; `long` beside `int` and `signed char` beside `char` are other types, so those are two overloads (language/integer_types_are_distinct)
// factorio: found by the templates thread comparing overload choices against clang: `int f(int)` beside `int f(long)` reached clang as two definitions of `f(int32)` ("clang rejected module"), and two definitions of one signature likewise
// error: function_defined_twice_is_error.kpp:5: error: the function twice is defined twice (first at line 4)
int twice(int v) { return v; }
int twice(int v) { return v + 1; }
int wide([[maybe_unused]] int v) { return 1; }
int wide([[maybe_unused]] long v) { return 2; }
int narrow([[maybe_unused]] char v) { return 1; }
int narrow([[maybe_unused]] signed char v) { return 2; }
int declaredThenDefined(int v);
int declaredThenDefined(int v) { return v; }
int main()
{
  return twice(1) + wide(1) + narrow('a') + declaredThenDefined(1);
}
