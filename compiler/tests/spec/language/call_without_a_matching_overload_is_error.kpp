int k(int* p) { return *p; }
int k(double* p) { return 2; }
int pick(int a) { return a; }
int pick(double a) { return 2; }
namespace shapes
{
  struct Box { int w = 1; };
  int area(int side) { return side * side; }
  int area(double side) { return 3; }
  int describe(const Box& box) { return box.w; }
  int describe(const Box& box, const char* name) { return 2; }
}
