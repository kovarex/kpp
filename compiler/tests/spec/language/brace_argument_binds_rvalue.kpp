// spec: a brace-list argument is a temporary, so it binds to an rvalue-reference overload: `map.insert({key, makeUnique<T>()})` picks insert(Pair&&)
// factorio: converted code inserts move-only values this way (AsteroidCollectorNavMesh: Map<ChunkPosition, UniquePtr<...>>)
struct Box
{
  int copies = 0;
  int moves = 0;
  void take(const std::Pair<int, std::UniquePtr<int>>& entry) { ++this.copies; }
  void take(std::Pair<int, std::UniquePtr<int>>&& entry) { ++this.moves; }
};
int main()
{
  Box box;
  box.take(std::Pair<int, std::UniquePtr<int>>{1, std::makeUnique<int>(5)});
  std::println(box.copies, " ", box.moves);
  return 0;
}
