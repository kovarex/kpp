// spec: the enumerators of an `enum class` declared in a function stay in the enum's scope, as at namespace scope: `MapVersion(2, 31)` after `enum class Reason { None, MapVersion, Mods };` constructs the class MapVersion, and the enumerator is `Reason::MapVersion`
// factorio: Scenario::loadFactory's local `enum class PrototypeDataChangedReason {None, MapVersion, Mods, ...};` followed by `if (input->mapVersion < MapVersion(2, 0, 31, 2))`
struct MapVersion
{
  MapVersion(int major, int minor) : value(major * 100 + minor) {}
  bool operator<(const MapVersion& other) const { return this.value < other.value; }
  int value;
};
int load(MapVersion input)
{
  enum class Reason { None, MapVersion, Mods };
  Reason reason = Reason::None;
  if (input < MapVersion(2, 31))
    reason = Reason::MapVersion;
  return int(reason);
}
int main()
{
  println(load(MapVersion(1, 0)), " ", load(MapVersion(3, 0)));
  return 0;
}
