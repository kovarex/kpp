// spec: a read of a volatile object happens each time it is written, in an optimized build too ([intro.abstract] 6): through its name, a pointer, a reference, a member of a volatile object, an element, a volatile member. Each loop waits, without a limit, for the other thread's write, which comes once its loop has started (and 50 ms more), so a read moved out of the loop reads 0 for ever; a watchdog then ends the program after 60 s with `timeout` (2026-11-08: written all at once, the writes could come before the loops, and such reads see them; 2026-11-25: the loops' limit of 2,000,000,000 rounds ran out before a slow CI runner's writer thread got to write, a flake)
// kpp: --release
extern "C" int printf(const char* format, ...);
class Box
{
public:
  int n = 0;
  int other = 0;
};
class HasVolatile
{
public:
  volatile int n = 0;
};
volatile int named = 0;
volatile int pointed = 0;
volatile int referred = 0;
volatile Box box;
volatile int elements[3];
HasVolatile holder;
volatile int stage = 0;
std::Atomic<bool> done = false;
void awaitLoop(int loop)
{
  while (stage < loop)
  {
  }
  std::thisThread::sleepFor(std::Milliseconds(50));
}
int main()
{
  volatile int* pointer = &pointed;
  volatile int& reference = referred;
  // A read moved out of its loop never sees the write: the program would never end.
  std::Thread watchdog([]() {
    for (int tenths = 0; tenths < 600 && !done.load(); ++tenths)
      std::thisThread::sleepFor(std::Milliseconds(100));
    if (!done.load())
    {
      printf("timeout: a loop did not see its write (stage %d)\n", int(stage));
      fflush(nullptr);
      _Exit(1);
    }
  });
  std::Thread writer([]() {
    awaitLoop(1);
    named = 1;
    awaitLoop(2);
    pointed = 1;
    awaitLoop(3);
    referred = 1;
    awaitLoop(4);
    box.n = 1;
    awaitLoop(5);
    elements[2] = 1;
    awaitLoop(6);
    holder.n = 1;
  });
  stage = 1;
  while (named == 0)
  {
  }
  printf("named\n");
  stage = 2;
  while (*pointer == 0)
  {
  }
  printf("pointer\n");
  stage = 3;
  while (reference == 0)
  {
  }
  printf("reference\n");
  stage = 4;
  while (box.n == 0)
  {
  }
  printf("member of a volatile object\n");
  stage = 5;
  while (elements[2] == 0)
  {
  }
  printf("element\n");
  stage = 6;
  while (holder.n == 0)
  {
  }
  printf("volatile member\n");
  done.store(true);
  writer.join();
  watchdog.join();
  return 0;
}
