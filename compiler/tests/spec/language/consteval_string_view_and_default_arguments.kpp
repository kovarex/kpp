// spec: at compile time a StringView compares with a literal and with another StringView through its operators (memcmp over chars), an object compared with a pointer or an array uses the object's operator, and a call, a member function's too, leaves trailing parameters to their default arguments; each constant equals what the program computes (`true false 1 3 3`)
// factorio: build.kpp (docs/build.md, version 0): `configuration == "release"`, project.setting(name, otherwise) with defaults, which E worked around with "cannot evaluate yet"
constexpr StringView mode = "release";
constexpr const char* other = "debug";
constexpr int pick(StringView name, int fallback = 3) { return name == "debug" ? 1 : fallback; }
struct Settings
{
  int level = 2;
  constexpr int get(int add = 1) const { return this.level + add; }
};
static_assert(mode == "release" && mode != other && StringView("abc") == StringView("abc"));
static_assert(pick("debug") == 1 && pick("x") == 3 && Settings().get() == 3);
template<int N> struct Show { static constexpr int value = N; };
int main()
{
  println(mode == "release", " ", mode == other, " ", Show<pick("debug")>::value, " ", Show<pick("x")>::value, " ", Show<Settings().get()>::value);
  return 0;
}
