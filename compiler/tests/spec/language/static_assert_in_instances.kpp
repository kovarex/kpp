// spec: static_asserts are checked where their condition is known: at namespace scope, in classes and functions once, in templates per instance (class template instances the program names, function template instances it calls), not in the discarded branch of an instance's `if constexpr` (`static_assert(sizeof(T) == 0, ...)` there is the idiom for "no other T")
// factorio: 470 uses in 237 files
static_assert(1 + 1 == 2, "arithmetic");
enum class Color { Red, Green, Blue };
static_assert(static_cast<int>(Color::Blue) == 2);
struct Pair2 { int a; int b; static constexpr int count = 2; };
static_assert(Pair2::count == 2);
static_assert(sizeof(int32_t) == 4 && sizeof(void*) == 8);
template<class T>
struct Box
{
  static_assert(!isPointer<T>, "no pointers in a Box");
  T value{};
};
template<class T>
int describe()
{
  static_assert(sizeof(T) >= 1);
  if constexpr (isIntegral<T>)
    return 1;
  else if constexpr (isFloatingPoint<T>)
    return 2;
  else
    static_assert(sizeof(T) == 0, "describe needs a number");
}
int main()
{
  static_assert(isSame<int, int32_t>);
  Box<int> b;
  println(b.value, " ", describe<int>(), " ", describe<double>());
  return 0;
}
