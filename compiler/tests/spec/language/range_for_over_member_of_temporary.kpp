// spec: a range-for whose range is a member of a temporary (`for (const T& t : Duo{...}.a)`) keeps the temporary alive until the loop ends ([class.temporary]/6: the reference the range binds extends the whole temporary), so the loop reads live elements; clang 19 prints `T1 T2 it1 it2 ~T2 ~T1`, one per line
// factorio: TextRenderer's `for (const TextDrawSection& section : this->getTrimmedOverlappingSections(sections, line).sections)` (three loops) iterated a Vector already destroyed; found by the templates thread comparing object lifetimes against clang 19 (silent)
int moves = 0;
struct T
{
  int id;
  T(int v) : id(v) { std::println("T", this.id); }
  T(const T& o) : id(o.id * 10) { std::println("T", this.id, " copy"); }
  T(T&& o) : id(o.id * 100) { ++moves; std::println("T", this.id, " move"); }
  ~T() { std::println("~T", this.id); }
};
struct Duo { T a[2]; };
int main()
{
  for (const T& t : Duo{{T(1), T(2)}}.a)
    std::println("it", t.id);
  return 0;
}
