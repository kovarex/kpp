// spec: a namespace-scope variable of class type initialized with parentheses, `Box box(HeavyMode::Enabled);` (an enumerator, a value, not a type: so a variable, not a function declaration), is that variable defined and constructed from its arguments, also after an `extern Box box;`
// factorio: MainLoop's `Atomic<HeavyMode> globalHeavyMode(HeavyMode::Disabled);` and `Atomic<ProcessResult> shouldStop(ProcessResult::Success);` after their extern declarations: unresolved externals of the link
enum class HeavyMode { Disabled, Enabled };
struct Box
{
  HeavyMode mode;
  int count = 0;
  explicit Box(HeavyMode mode) : mode(mode) {}
  Box(HeavyMode mode, int count) : mode(mode), count(count) {}
};
namespace MainLoop
{
  extern Box box;
}
namespace MainLoop
{
  Box box(HeavyMode::Enabled);
  Box other(HeavyMode::Disabled, 4);
}
int main()
{
  println("{} {} {}", int(MainLoop::box.mode), int(MainLoop::other.mode), MainLoop::other.count);
  return 0;
}
