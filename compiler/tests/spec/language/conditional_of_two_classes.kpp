// spec: `c ? a : b` of two different classes has the type the other branch converts to (C++ tries each way): a value and an Optional of it is the Optional, a derived and a base object is the base, whichever branch is first
// factorio: UndoItem::mergeRailPlannerUndos's `return first && second ? UndoItem::NonGameStateRailPlannerUndo(first->start, second->end) : first ? first : second;` with first and second const Optional<NonGameStateRailPlannerUndo>&
struct Location { int x = 0; };
struct Undo
{
  Undo(Location start, Location end) : start(start), end(end) {}
  Location start;
  Location end;
};
struct Shape { int sides = 3; };
struct Square : Shape { Square() { this->sides = 4; } };
static Optional<Undo> merge(const Optional<Undo>& first, const Optional<Undo>& second)
{
  return first && second ? Undo(first->start, second->end) : first ? first : second;
}
int main()
{
  Optional<Undo> a = Undo(Location{1}, Location{2});
  Optional<Undo> b = Undo(Location{3}, Location{4});
  Optional<Undo> none;
  Optional<Undo> both = merge(a, b);
  Optional<Undo> one = merge(none, b);
  Square square;
  Shape shape;
  bool on = true;
  const Shape& picked = on ? square : shape;
  static_assert(isSame<decltype(on ? Undo(Location{}, Location{}) : a), Optional<Undo>>);
  static_assert(isSame<decltype(on ? a : Undo(Location{}, Location{})), Optional<Undo>>);
  println("{} {} {} {} {}", both->start.x, both->end.x, one->start.x, merge(none, none).hasValue(), picked.sides);
  return 0;
}
