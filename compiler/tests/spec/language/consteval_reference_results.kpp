// spec: writing through a member function's reference result at compile time: `result[i] = x` through Array's operator[], `result[2].b = 9`, `front().a = 7`, `back().a += 2`, a loop filling a table
// factorio: Util's spreadBits table (Array<uint64_t, 256>), Base64's decode table, KeyIndex's LogiKeyIndex table, RenderLayer's Array<bool, 256>
struct Cell
{
  int a = 0;
  int b = 0;
};
constexpr Array<uint64_t, 8> squares()
{
  Array<uint64_t, 8> result = {};
  for (int i = 0; i < result.size(); ++i)
    result[i] = uint64_t(i * i);
  return result;
}
constexpr Array<Cell, 3> cells()
{
  Array<Cell, 3> result = {};
  result[1] = {4, 5};
  result[2].b = 9;
  result.front().a = 7;
  result.back().a += 2;
  return result;
}
constexpr auto table = squares();
constexpr auto grid = cells();
static_assert(table[7] == 49 && table[3] == 9);
static_assert(grid[0].a == 7 && grid[1].b == 5 && grid[2].b == 9 && grid[2].a == 2);
int main()
{
  println(table[5], " ", grid[1].a, " ", grid[2].b, " ", grid[2].a);
  return 0;
}
