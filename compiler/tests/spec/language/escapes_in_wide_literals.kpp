// spec: in a wide literal a hex or octal escape is one code unit (`L"\xA9"` is the unit 0xA9, `L"\101"` is A), a character of the UTF-8 source is its code point (`L"é"`, `L'é'` are 0xE9), and an octal escape stops at three digits or at a digit that is not octal (`"\08"` is a zero byte and the character 8, `"\1010"` is A and 0)
// factorio: the escapes of universal_character_names_in_literals in their wide forms: StringUtil's tables write code units as escapes, and a character literal is folded by the constant evaluator, not by the string decoder (which took its first byte: `L'é'` was 0xC3)
int main()
{
  WString hex = L"\xA9\x263A";
  WString octal = L"\101\7";
  WString source = L"é";
  wchar_t letter = L'é';
  const char narrow[] = "\08\1010";
  println(hex.size(), " ", (int)hex[0], " ", (int)hex[1], " | ", octal.size(), " ", (int)octal[0], " ", (int)octal[1], " | ", (int)source[0], " ", (int)letter, " | ", int(sizeof(narrow)), " ", (int)narrow[0], " ", (int)narrow[1], " ", (int)narrow[2], " ", (int)narrow[3]);
  return 0;
}
