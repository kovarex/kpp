// spec: the noexcept operator reads a destructor's exception specification ([except.spec] 8): a specifier when it has one, defaulted too, else what its bases and members say, a union's and an anonymous union's members among them, pointers, references and statics not; so does delete, with a deallocation function that says otherwise, and a call returning a class by value; clang's output
template <typename T> T&& dv() noexcept;
struct Plain { ~Plain() {} };
struct Throwing { ~Throwing() noexcept(false) {} };
struct ThrowingMember { Throwing t; };
struct ThrowingMemberWritten { Throwing t; ~ThrowingMemberWritten() {} };
struct ThrowingBase : Throwing { };
struct ThrowingBaseWritten : Throwing { ~ThrowingBaseWritten() {} };
struct ArrayOf { Throwing t[2]; };
struct Pointer { Throwing* t; Throwing& r; };
struct Declared { Throwing t; ~Declared() noexcept; };
Declared::~Declared() noexcept {}
struct Yes { ~Yes() noexcept(true) {} };
class Virtual { public: virtual ~Virtual() {} };
class VirtualFalse { public: virtual ~VirtualFalse() noexcept(false) {} };
class FromVirtualFalse : public VirtualFalse { };
struct DefaultedMember { Throwing t; ~DefaultedMember() = default; };
struct DefaultedNoexcept { Throwing t; ~DefaultedNoexcept() noexcept = default; };
struct DefaultedFalse { ~DefaultedFalse() noexcept(false) = default; };
template <typename T> struct Holder { T t; };
template <typename T> struct HolderWritten { T t; ~HolderWritten() {} };
template <bool B> struct Cond { ~Cond() noexcept(B) {} };
template <typename... T> struct Bases : T... { };
union U { Throwing t; int i; U() {} ~U() {} };
struct AnonymousUnion { union { Throwing t; int i; }; AnonymousUnion() {} ~AnonymousUnion() {} };
struct Static { static Throwing t; };
struct OwnDelete { static void operator delete(void* p) noexcept(false) { free(p); } };
struct OwnDeleteDefault { static void operator delete(void* p) { free(p); } };
struct OwnDeleteNoexcept { static void operator delete(void* p) noexcept { free(p); } };
class Base { public: virtual ~Base() noexcept(false) {} };
class Derived : public Base { public: ~Derived() noexcept {} };
Plain makePlain() noexcept;
Throwing makeThrowing() noexcept;
Plain makePlainMayThrow();
template <typename T> void pseudo(T* p) { println(noexcept(p->~T())); }
int main()
{
  println(noexcept(dv<Plain&>().~Plain()));
  println(noexcept(dv<Throwing&>().~Throwing()));
  println(noexcept(dv<ThrowingMember&>().~ThrowingMember()));
  println(noexcept(dv<ThrowingMemberWritten&>().~ThrowingMemberWritten()));
  println(noexcept(dv<ThrowingBase&>().~ThrowingBase()));
  println(noexcept(dv<ThrowingBaseWritten&>().~ThrowingBaseWritten()));
  println(noexcept(dv<ArrayOf&>().~ArrayOf()));
  println(noexcept(dv<Pointer&>().~Pointer()));
  println(noexcept(dv<Declared&>().~Declared()));
  println(noexcept(dv<Yes&>().~Yes()));
  println(noexcept(dv<Virtual&>().~Virtual()));
  println(noexcept(dv<VirtualFalse&>().~VirtualFalse()));
  println(noexcept(dv<FromVirtualFalse&>().~FromVirtualFalse()));
  println(noexcept(dv<DefaultedMember&>().~DefaultedMember()));
  println(noexcept(dv<DefaultedNoexcept&>().~DefaultedNoexcept()));
  println(noexcept(dv<DefaultedFalse&>().~DefaultedFalse()));
  println(noexcept(dv<Holder<Throwing>&>().~Holder<Throwing>()));
  println(noexcept(dv<Holder<int>&>().~Holder<int>()));
  println(noexcept(dv<HolderWritten<Throwing>&>().~HolderWritten<Throwing>()));
  println(noexcept(dv<HolderWritten<int>&>().~HolderWritten<int>()));
  println(noexcept(dv<Cond<true>&>().~Cond<true>()));
  println(noexcept(dv<Cond<false>&>().~Cond<false>()));
  println(noexcept(dv<Bases<Plain, Yes>&>().~Bases<Plain, Yes>()));
  println(noexcept(dv<Bases<Plain, Throwing>&>().~Bases<Plain, Throwing>()));
  println(noexcept(dv<U&>().~U()));
  println(noexcept(dv<AnonymousUnion&>().~AnonymousUnion()));
  println(noexcept(dv<Static&>().~Static()));
  Plain* a = nullptr;
  Throwing* b = nullptr;
  int* i = nullptr;
  OwnDelete* c = nullptr;
  OwnDeleteDefault* d = nullptr;
  OwnDeleteNoexcept* e = nullptr;
  Base* f = nullptr;
  Derived* g = nullptr;
  println(noexcept(delete a));
  println(noexcept(delete b));
  println(noexcept(delete i));
  println(noexcept(delete[] i));
  println(noexcept(delete[] a));
  println(noexcept(delete[] b));
  println(noexcept(delete c));
  println(noexcept(delete d));
  println(noexcept(delete e));
  println(noexcept(delete f));
  println(noexcept(delete g));
  println(noexcept(g->~Derived()));
  println(noexcept(g->Base::~Base()));
  println(noexcept(a->~Plain()));
  println(noexcept(b->~Throwing()));
  println(noexcept(makePlain()));
  println(noexcept(makeThrowing()));
  println(noexcept(makePlainMayThrow()));
  pseudo(i);
  pseudo(a);
  pseudo(b);
  return 0;
}
