// spec: a range-for over tuple-like elements with a structured binding works inside a lambda, as outside one (`9`)
extern "C" int printf(const char* format, ...);
int main()
{
  std::Vector<std::Tuple<int, int>> values;
  values.push_back(std::Tuple<int, int>(1, 4));
  values.push_back(std::Tuple<int, int>(2, 5));
  int sum = 0;
  auto run = [&]
  {
    for (auto& [key, value] : values)
      sum += value;
  };
  run();
  printf("%d\n", sum);
  return 0;
}
