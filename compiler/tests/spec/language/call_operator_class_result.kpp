// spec: a variable initialised from a call of an object's operator() that returns a class (`Chunk c = maker(3);`) holds the returned value, as with a named method or a lambda
// factorio: function objects across the game (comparators, hashers, ToChunk-style mappers), Function<R(Args)> calls returning classes, the library's views
struct Chunk { int x, y; };
struct Maker
{
  int w;
  Chunk operator()(int i) const { return Chunk{i % this.w, i / this.w}; }
};
int main()
{
  Maker maker{2};
  Chunk viaCall = maker.operator()(3);
  Chunk viaOperator = maker(5);
  Chunk assigned;
  assigned = maker(7);
  println(viaCall.x, viaCall.y, " ", viaOperator.x, viaOperator.y, " ", assigned.x, assigned.y);
  return 0;
}
