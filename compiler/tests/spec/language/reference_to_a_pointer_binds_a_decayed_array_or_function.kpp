// spec: a const or rvalue reference to a pointer given an array or a function binds a temporary holding the pointer, in a body, at namespace scope and for a static local
// found by thread A's comparison with clang (2026-11-06): the reference bound the array or function itself, and a read through it took their first bytes for the pointer (silent wrong answer: a crash)
int twice(int x) { return x * 2; }
int thrice(int x) { return x * 3; }
int block[2] = {5, 6};
int* const& g = block;
int (*const& gf)(int) = thrice;
struct H { int (*const& f)(int) = twice; };
int main()
{
  int local[2] = {7, 8};
  int* const& p = local;
  int*&& q = local;
  const int* const& c = local;
  int (*const& f)(int) = thrice;
  int (*&& h)(int) = twice;
  println(*p, " ", q[1], " ", *c, " ", f(2), " ", h(2), " ", *g, " ", gf(3));
  q = block;
  println(*q, " ", *p);
  for (int i = 0; i < 2; ++i)
  {
    int (*const& each)(int) = i ? twice : thrice;
    println(each(1));
  }
  static int* const& s = block;
  println(s[1]);
  return 0;
}
