// spec: an exception passes through functions that have nothing to destroy and no try (no landing pad of their own) to the handler in their caller's caller: off Windows each such frame needs its unwind table (design.md, "Targets and hosts", stage 3)
class Boom : public std::Exception { public: int depth; Boom(int depth) : Exception("boom"), depth(depth) {} };
int thrower(int n)
{
  if (n > 0)
    throw Boom(n);
  return n;
}
int plain(int n) { return thrower(n) + 1; }
int plainer(int n) { return plain(n * 2) + 2; }
int main()
{
  std::println(plainer(0));
  try
  {
    std::println(plainer(3));
  }
  catch (const Boom& e)
  {
    std::println("caught at depth ", e.depth);
  }
  return 0;
}
