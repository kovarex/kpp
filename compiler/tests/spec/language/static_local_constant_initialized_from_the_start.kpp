// spec: a static local whose initializer is a constant expression is constant-initialized, as C++'s [basic.start.static] has it, const or not: it holds its value from the program's start, so a goto past its declaration reads 5 and a case label past one reads 7, and it is written as any variable (`8 8`); one whose initializer is no constant (a non-const global's value, a call with a side effect) is initialized when its declaration first runs, from the values then (`21`, `101`); clang prints the same
// found by thread B (2026-11-05), comparing kpp with clang: a non-const one was zero until its declaration ran (`0 0 8 8`), with a guard checked on every pass
int skipStatic(int x)
{
  if (x)
    goto after;
  static int counter = 5;
  ++counter;
after:
  return counter;
}
int inSwitch(int x)
{
  switch (x)
  {
    case 0:
      static int c = 7;
      ++c;
      return c;
    case 1:
      return c;
  }
  return -1;
}
int base = 10;
int calls = 0;
int next() { return ++calls; }
int constFromGlobal()
{
  static const int x = base + 1;
  return x;
}
int fromCall()
{
  static int id = next();
  return id;
}
int main()
{
  println(skipStatic(1), " ", inSwitch(1), " ", inSwitch(0), " ", inSwitch(1));
  base = 20;
  calls = 100;
  int first = constFromGlobal();
  int id = fromCall();
  println(first, " ", id, " ", calls);
  return 0;
}
