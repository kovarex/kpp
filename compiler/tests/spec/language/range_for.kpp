// spec: range-based for
// factorio: 8577 uses in 1333 files
// Over arrays, Vector, by reference (modifying), const reference, and a brace list.
int main()
{
  int values[] = {3, 1, 4};
  int sum = 0;
  for (int v : values)
    sum += v;
  std::Vector<std::String> names;
  names.push_back(std::String("a"));
  names.push_back(std::String("b"));
  for (std::String& n : names)
    n << "!";
  std::String joined;
  for (const std::String& n : names)
    joined << n;
  int count = 0;
  for (int v : {10, 20, 30})
    count += v;
  std::println(sum, " ", joined, " ", count);
  return 0;
}
