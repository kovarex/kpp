// spec: a decltype(auto) return type keeps the reference the returned expression has: returning `f(x)` where f returns int& returns int&, so the call can be assigned to and bound to a reference
// factorio: the library's views (a transform yielding `const Territory&` in TerritoryManager::getAllTerritories), generic forwarding wrappers
struct Box { int v; };
template<typename F, typename T>
decltype(auto) call(F f, T& x) { return f(x); }
int main()
{
  Box b{5};
  auto getter = [](Box& x) -> int& { return x.v; };
  call(getter, b) = 7;
  int& r = call(getter, b);
  r += 1;
  std::println(b.v);
  return 0;
}
