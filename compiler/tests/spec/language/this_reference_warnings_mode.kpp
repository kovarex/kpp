// spec: --this-reference-warnings (design.md 23d): each use of `this` that changes once it is a reference is a warning in the editor's fix form: `this->` (write `this.`), `*this` (write `this`, noting a class whose operator* `*this` will call), its address passed, returned, compared or deleted (write `&this`), a `[this]` capture (write `&this`), a `[=]` lambda that uses the object, and a null test, which has no fix to write
// kpp: --this-reference-warnings
// warning: this_reference_warnings_mode.kpp:19: warning: this is a reference (the object's address): write `&this`, not `this`
// warning: this_reference_warnings_mode.kpp:20: warning: this is a reference: write `this.`, not `this->`
// warning: this_reference_warnings_mode.kpp:21: warning: this is a reference: write `this`, not `*this`
// warning: this_reference_warnings_mode.kpp:22: warning: this is a reference (a comparison of the object's address): write `&this`, not `this`
// warning: this_reference_warnings_mode.kpp:23: warning: this is a reference, never null (design.md 23d)
// warning: this_reference_warnings_mode.kpp:26: warning: this is a reference, never null (design.md 23d)
// warning: this_reference_warnings_mode.kpp:30: warning: this is a reference (the object's address): write `&this`, not `this`
// warning: this_reference_warnings_mode.kpp:33: warning: this is a reference (a capture by reference): write `&this`, not `this`
// warning: this_reference_warnings_mode.kpp:38: warning: [=] will not capture the object (design.md 23d): write `=, &this`, not `=`
// warning: this_reference_warnings_mode.kpp:41: warning: this is a reference (delete takes its address): write `&this`, not `this`
// warning: this_reference_warnings_mode.kpp:48: warning: this is a reference (its class has an operator*, which `*this` will call): write `this`, not `*this`
class Node
{
public:
  int value = 1;
  Node* next = nullptr;
  Node* self() { return this; }
  int get() const { return this->value; }
  Node& ref() { return *this; }
  bool same(const Node* other) const { return this == other; }
  bool valid() const { return this != nullptr; }
  bool alive() const
  {
    if (this)
      return true;
    return false;
  }
  void link(Node* n) { n->next = this; }
  int later() const
  {
    auto f = [this]() { return 2; };
    return f();
  }
  int copied() const
  {
    auto f = [=]() { return value; };
    return f();
  }
  void drop() { delete this; }
};
class Iter
{
public:
  int at = 3;
  int operator*() const { return at; }
  Iter& me() { return *this; }
};
int main()
{
  Node a;
  Node b;
  b.link(&a);
  Node* heap = new Node();
  heap->drop();
  Iter it;
  println(a.get(), " ", a.self() == &a, " ", a.ref().value, " ", a.same(&b), " ", a.valid(), " ", a.alive(), " ", a.next == &b, " ", a.later(), " ", a.copied(), " ", *it.me());
  return 0;
}
