// spec: list-initialization tries the initializer-list constructor first and the other constructors when that one is not viable: `Vector<int*> v{set.begin(), set.end()}` with iterators that are no int* is the iterator-range constructor, while `Vector<int> w{3, 5}` is the two elements
// factorio: LuaEntity's exportSetOfEntities, `std::vector<EntityType*> vectorOfEntities { setOfEntities.begin(), setOfEntities.end() };` (3 instances)
int main()
{
  int a = 1;
  int b = 2;
  Set<int*> set = {&a, &b};
  Vector<int*> v{set.begin(), set.end()};
  Vector<int> w{3, 5};
  println("{} {} {}", v.size(), w.size(), w[1]);
  return 0;
}
