// spec: an implicit conversion through a converting constructor whose parameter is a const reference of another type (`Constant(const double&)` given an int) binds the reference to a converted temporary, as a function's const reference parameter does (`byRef(two)`; `ref` would name the library's std::ref)
// factorio: NoiseFunctionParameter's `{"output_scale", 1}` through `NoiseFunctionParameter(String&&, NoiseExpressionConstant&&)`, and every class built from a number its constructor takes as `const double&`
class Constant
{
public:
  implicit Constant(const double& value) : value(value) {}
  double value;
};
static double get(Constant c) { return c.value; }
static double byRef(const double& d) { return d; }
int main()
{
  int two = 2;
  Constant c = two;
  println(get(2), " ", get(two), " ", c.value, " ", byRef(two));
  return 0;
}
