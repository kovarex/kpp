// spec: references: lvalue, const binding a temporary, rvalue references and move
struct Buffer
{
  std::Vector<int> data;
  Buffer() {}
  Buffer(Buffer&& other) : data(std::move(other.data)) {}
};
int length(const std::String& s) { return s.size(); }
int main()
{
  int x = 1, y = 2;
  y = 20;
  int& rx = x;
  rx += 5;
  Buffer a;
  a.data.push_back(7);
  Buffer b(std::move(a));
  int&& r = x + 1;
  r += 1;
  std::println(x, " ", y, " ", length(std::String("abc") + "d"), " ", b.data.size(), " ", a.data.size(), " ", r);
  return 0;
}
