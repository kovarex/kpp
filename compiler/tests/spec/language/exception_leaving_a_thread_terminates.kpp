// spec: an exception that leaves a thread's function ends the program through the terminate handler, as C++'s std::thread does (std::terminate), from the search with the throw site on the stack: nothing between the throw and the thread's function is destroyed, and the program never ends without a word
class Boom : public std::Exception { public: Boom() : Exception("boom") {} };
struct Noisy { ~Noisy() { std::println("destroyed before the terminate handler"); } };
void work()
{
  Noisy n;
  throw Boom();
}
void onTerminate()
{
  std::println("terminate");
  fflush(nullptr);
  exit(0);
}
int main()
{
  std::setTerminate(onTerminate);
  std::Thread thread(work);
  thread.join();
  std::println("joined");
  return 0;
}
