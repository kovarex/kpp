// spec: a constructor marked explicit(cond) converts implicitly at compile time where cond is false, as the walk lets it (`Fixed<int, false> three = 3;`)
// factorio: static inline MapPosition::CoordinateType size = 0; (FixedPointNumberTemplate's explicit(Explicit) constructors, Explicit = false)
template<class T, bool Explicit>
struct Fixed
{
  implicit(!Explicit) constexpr Fixed(int n) : raw(T(n * 256)) {}
  T raw;
};
constexpr Fixed<int, false> three = 3;
static_assert(three.raw == 768);
constexpr int raw(Fixed<int, false> f) { return f.raw; }
static_assert(raw(2) == 512);
int main()
{
  std::println(raw(1));
  return 0;
}
