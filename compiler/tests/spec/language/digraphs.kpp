// spec: `<:` `:>` `<%` `%>` are `[` `]` `{` `}`, in a lambda's capture too ([lex.digraph]); `%:` is a `#`, and a directive an error: language/preprocessor_directive_is_error
// found by thread A's comparison with clang (2026-11-06): "expected declaration"
struct Kept <% int v = 2; %>;
struct S <% int a<:2:>; %>;
template<class T> struct V <% T x; %>;
int main()
<%
  S s;
  s.a<:0:> = 3;
  s.a<:1:> = 4;
  auto f = <:&s:>(int i) <% return s.a<:i:>; %>;
  int (*row)<:2:> = &s.a;
  V<S> v;
  println(s.a<:0:> + s.a<:1:>, " ", f(1), " ", (*row)<:0:>, " ", sizeof(v), " ", Kept().v);
  return 0;
%>
