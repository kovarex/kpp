// spec: a functional cast whose type is a dependent alias (`C(m)` with `using C = typename X<M>::Type;`, `MakeUnsigned<T>(x)`) folds in constant evaluation as static_cast to the same type does (`3 5 / 3 5`)
// pending: a functional cast through a dependent alias does not fold at compile time ("static assertion whose condition the compiler cannot evaluate yet"); the stdlib's gcd writes static_cast instead (D)
extern "C" int printf(const char* format, ...);
template<typename M> struct Same { using Type = M; };
template<typename M> constexpr M viaLocalAlias(M m) { using C = typename Same<M>::Type; return C(m); }
template<typename T> constexpr MakeUnsigned<T> viaAliasTemplate(T value) { return MakeUnsigned<T>(value); }
static_assert(viaLocalAlias(3) == 3);
static_assert(viaAliasTemplate<i64>(5) == 5);
int main()
{
  printf("%d %d / %d %d\n", viaLocalAlias(3), (int)viaAliasTemplate<i64>(5), viaLocalAlias(3), (int)viaAliasTemplate<i64>(5));
  return 0;
}
