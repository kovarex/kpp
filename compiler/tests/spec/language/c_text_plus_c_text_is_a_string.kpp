// spec: `a + b` of two C texts (string literals, char arrays, char pointers, either side) is a new String of both texts, to each one's first zero (kovarex, 2026-11-17, design.md 14; C++ adds no two pointers, so nothing C++ compiles changes meaning): a literal and an enumeration's str(), two pointers, a pointer and a literal, an array, two literals, a chain, an argument taking a String, and a constant (`names.Beta|xy|y!|yb|lit|a.b.c|key=Beta|5`)
extern "C" import "stdio.h";
enum class Kind : u8
{
  { Alpha, Beta }
};
std::String localise(const std::String& key) { return key; }
consteval int constantSize()
{
  const char* p = "abc";
  return int(("de" + p).size());
}
int main()
{
  Kind k = Kind::Beta;
  const char* x = "x";
  char yz[3] = {'y', 0, 'z'};
  char* y = yz;
  std::String a = "names." + k.str();
  std::String b = x + y;
  std::String c = y + "!";
  std::String d = "a" + yz + "";
  std::String e = "l" "i" + "t";
  std::String f = "a." + x + "b." + "c";
  printf("%s|%s|%s|%s|%s|%s|%s|%d\n", a.c_str(), b.c_str(), c.c_str(), (yz + "b").c_str(), e.c_str(), ("a." + std::StringView("b.") + "c").c_str(),
         localise("key=" + k.str()).c_str(), constantSize());
  return int(d.size() + f.size()) - 8;
}
