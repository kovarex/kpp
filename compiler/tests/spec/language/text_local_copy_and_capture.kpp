// spec: a Text may be copied into a local and captured by a lambda that does not outlive the call (called there, or passed down to a function), since both end before the call does (`[a1][a1][a1]`)
extern "C" import "stdio.h";
struct Digit
{
  int d = 0;
  void appendTo(String& out) const { out << char('0' + d); }
};
void show(Text text)
{
  String s;
  text.appendTo(s);
  printf("[%s]", s.c_str());
}
template<typename F>
void call(F f) { f(); }
void each(Text text)
{
  Text copy = text;
  auto twice = [&] { show(copy); show(text); };
  twice();
  call([=] { show(text); });
}
int main()
{
  each("a", Digit{1});
  printf("\n");
  return 0;
}
