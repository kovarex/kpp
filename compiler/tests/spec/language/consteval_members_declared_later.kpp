// spec: a compile-time call into a class declared further down: its member functions read the object's members (`this->width`, `height` alone) though nothing has typed their bodies yet
// factorio: static_assert(BoundingBox::emptyValue().isZeroSize()) in CameraWidgetUndoRedo.kpp, walked before BoundingBox.kpp
static_assert(Box(1, 1).isSquare());
static_assert(Box(2, 3).area() == 6);
int main()
{
  static_assert(!Box(2, 3).isSquare());
  println(Box(2, 3).area());
  return 0;
}
struct Box
{
  int width = 0;
  int height = 0;
  constexpr Box(int w, int h) : width(w), height(h) {}
  constexpr bool isSquare() const { return this->width == this->height; }
  constexpr int area() const { return width * height; }
};
