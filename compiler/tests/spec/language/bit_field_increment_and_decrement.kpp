// spec: ++ and --, prefix and postfix, on a bit-field change that field alone: its value plus or minus one, wrapped to the field's width, written back into the field's own bits; a postfix one's value is the field's old value and a prefix one's the new
// factorio: Tree::damageByPollution's `this->treeData.greyProgress++` (Tree::TreeData's `uint8_t color : 4; uint8_t greyProgress : 4;`) added one to the whole byte, which is color's bits: a tree that pollution greys changed its color instead, and menu-simulation-lab's checksum left the C++ build's at its 45th tick (the save's one differing byte is that tree's, 0x13 where C++ writes 0x22)
struct TreeData
{
  uint8_t treeVariation : 4;
  uint8_t progress : 4;
  uint8_t color : 4;
  uint8_t greyProgress : 4;
};
struct Wide
{
  unsigned low : 3;
  unsigned middle : 10;
  unsigned high : 19;
};
class Tree
{
public:
  TreeData treeData;
  void grey() { this->treeData.greyProgress++; }
  void progressUp() { ++this->treeData.progress; }
  void colorDown() { this->treeData.color--; }
};
void show(const char* what, const TreeData& data)
{
  println("{}: {} {} {} {}", what, (int)data.treeVariation, (int)data.progress, (int)data.color, (int)data.greyProgress);
}
int main()
{
  TreeData data;
  data.treeVariation = 9;
  data.progress = 0;
  data.color = 2;
  data.greyProgress = 1;
  data.greyProgress++;
  show("postfix ++", data);
  ++data.greyProgress;
  show("prefix ++", data);
  data.progress++;
  show("postfix ++ of a byte's high field", data);
  data.greyProgress--;
  show("postfix --", data);
  --data.color;
  show("prefix --", data);
  int old = data.greyProgress++;
  println("postfix value: {} then {}", old, (int)data.greyProgress);
  int now = ++data.progress;
  println("prefix value: {} then {}", now, (int)data.progress);
  data.greyProgress = 15;
  data.greyProgress++;
  show("wraps above", data);
  data.treeVariation = 0;
  data.treeVariation--;
  show("wraps below", data);

  Tree tree;
  tree.treeData.treeVariation = 9;
  tree.treeData.progress = 0;
  tree.treeData.color = 2;
  tree.treeData.greyProgress = 1;
  tree.grey();
  tree.progressUp();
  tree.colorDown();
  show("through this->", tree.treeData);

  Wide wide;
  wide.low = 5;
  wide.middle = 1000;
  wide.high = 300000;
  wide.middle++;
  --wide.high;
  wide.low++;
  println("wide: {} {} {}", (int)wide.low, (int)wide.middle, (int)wide.high);
  return 0;
}
