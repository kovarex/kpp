// spec: a case that can reach the next label says what it means: `fallthrough;` or `break;`. The first step of no implicit fallthrough (design.md): what a section's end does is written everywhere before `switch` changes, so the change alters nothing
// error: switch_case_running_on_is_error.kpp:13: error: the case before this one runs on into it
// error: switch_case_running_on_is_error.kpp:15: error: the case before this one runs on into it
// error: switch_case_running_on_is_error.kpp:18: error: the case before this one runs on into it
// error: switch_case_running_on_is_error.kpp:21: error: the case before this one runs on into it
int run(int n)
{
  int acc = 0;
  switch (n)
  {
    case 0:
      acc += 1;
    case 1:
      if (n > 5) break;
    case 2:
      if (n > 5) return 1;
      else acc += 2;
    case 3:
      for (int i = 0; i < 3; ++i)
        ++acc;
    default:
      break;
  }
  return acc;
}
int main() { return run(0); }
