// spec: a lambda whose return type is deduced from returns inside a `for constexpr` (one per element, in a switch over a
// typed union's alternatives), in a function that is no template, returns their type, not void; until 2026-11-25 void (codegen's re-typing of the function walked no element of the loop)
union enum class U : u8
{
  { {A, int}, {B, int} }
};

int main()
{
  U u(U::Tag::B, 7);
  auto read = [&]() {
    switch (u.tag())
    {
      for constexpr (auto a : alternatives(U))
        case a.tag: return u[a];
    }
  };
  int value = read();
  std::println(value);
  return 0;
}
