// spec: at compile time a constructor's parameters bind their arguments as a function's do: a by-value one is copied by its class's copy constructor (moved from an xvalue) and destroyed when the constructor returns; a reference given a prvalue refers to a temporary of the full expression, which a move empties and that end destroys; a `const String&` given a StringView refers to the String converted from it. Copy-initialization through a converting constructor binds the initializer by its category: `Optional<String> o = s;` copies s, `Optional<String> p = String("fg");` moves from the temporary. Alike at compile time and at run time
// found by thread D (2026-11-05), comparing Optional<String> at compile time and run time: a constructor bound an argument without a place as a value nothing destroyed (a moved-from String's block: "memory allocated at String.kpp:657 is never freed"), a by-value parameter given an lvalue shared its block ("memory freed twice"), and `Optional<String> o = s;` moved from s; so every Optional<String> made from a String, and any constructor given a String temporary, was no constant
struct ByValue
{
  std::String s;
  ByValue(std::String v) : s(std::move(v)) {}
};
struct ByRvalue
{
  std::String s;
  ByRvalue(std::String&& v) : s(std::move(v)) {}
};
struct ByConstRef
{
  std::String s;
  ByConstRef(const std::String& v) : s(v) {}
};
struct Converting
{
  std::String s;
  int from = 0;
  implicit Converting(const std::String& v) : s(v), from(1) {}
  implicit Converting(std::String&& v) : s(std::move(v)), from(2) {}
};
constexpr long long byValue()
{
  std::String s = "abc";
  ByValue copied(s);          // a copy: s keeps its text
  ByValue moved(std::move(s));     // moved: s is left empty
  ByValue made(std::String("de")); // a temporary
  return (long long)copied.s.size() * 1000 + (long long)s.size() * 100 + (long long)moved.s.size() * 10 + (long long)made.s.size();
}
constexpr long long references()
{
  ByRvalue a(std::String("abc"));
  ByConstRef b(std::String("de"));
  ByConstRef c(std::StringView("f"));
  return (long long)a.s.size() * 100 + (long long)b.s.size() * 10 + (long long)c.s.size();
}
constexpr long long converting()
{
  std::String s = "abc";
  Converting copied = s;             // const String&: s keeps its text
  Converting made = std::String("de");    // String&&: the temporary
  std::Optional<std::String> o = s;            // Optional(const T&): a copy
  std::Optional<std::String> p = std::String("fg"); // Optional(T&&): moved from the temporary
  std::Optional<std::String> q(std::String("h"));
  return copied.from * 10000 + made.from * 1000 + (long long)s.size() * 100 + (long long)(*o).size() * 10 + (long long)((*p).size() + (*q).size());
}
int main()
{
  constexpr long long a = byValue();
  constexpr long long b = references();
  constexpr long long c = converting();
  std::println(a, " ", byValue(), " ", b, " ", references(), " ", c, " ", converting());
  return 0;
}
