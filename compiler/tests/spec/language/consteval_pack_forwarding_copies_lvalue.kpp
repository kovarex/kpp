// spec: at compile time an lvalue that a pack forwards is copied, never moved, wherever the pack takes it: `m.emplace(1, c)` of a Map (Args deduced by the expansion's value categories), `new (p) E(1, c)` of a Pair (a placement new chooses the constructor by them), `v.emplace_back(c)`, and a String key `names.emplace(k, 2)`; an rvalue (`move(c)`) is moved
// found by thread D (2026-11-05): an expansion's elements were deduced by their values' types alone, as rvalues, so the Map's node moved from c at compile time only (100 where the program gives 1), and `names.emplace(k, 2)` emptied the String k
struct C
{
  int n = 0;
  C() {}
  C(const C& o) : n(o.n + 1) {}
  C(C&& o) : n(o.n + 100) {}
};
constexpr int lvalues()
{
  C c;
  std::Map<int, C> m;
  m.emplace(1, c);
  using E = std::Pair<const int, C>;
  E* p = (E*)std::malloc(sizeof(E));
  new (p) E(1, c);
  int placed = p->second.n;
  p->~E();
  std::free(p);
  std::Vector<C> v;
  v.emplace_back(c);
  std::String k("b");
  std::Map<std::String, int> names;
  names.emplace(k, 2);
  return m[1].n * 1000 + placed * 100 + v[0].n * 10 + int(k.size());
}
constexpr int rvalues()
{
  C c;
  std::Map<int, C> m;
  m.emplace(1, std::move(c));
  return m[1].n;
}
constexpr int l = lvalues();
constexpr int r = rvalues();
int main()
{
  std::println(l, " ", lvalues(), " ", r, " ", rvalues());
  return 0;
}
