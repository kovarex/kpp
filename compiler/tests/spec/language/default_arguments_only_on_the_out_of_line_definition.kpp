// spec: a default argument written only on a member's out-of-line definition serves calls, a member's, a static's and a constructor's
// found by thread A's comparison with clang (2026-11-06): "a call that did not resolve"
struct S { int m(int a); static int s(int a); S(int z, int a); int v; };
int S::m(int a = 3) { return a + v; }
int S::s(int a = 4) { return a; }
S::S(int z, int a = 5) : v(a + z) { }
int main() { S x(1); println(x.m(), " ", S::s(), " ", x.v); return 0; }
