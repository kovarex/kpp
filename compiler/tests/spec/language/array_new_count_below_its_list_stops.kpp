// spec: new[] of a count known only at run time that is below its initializer list's length stops with a message rather than write past its block (C++ throws bad_array_new_length; kpp stops, as for a failed dynamic_cast to a reference), and so does a negative count; in a test the stop fails that test and the run goes on, and a count that fits builds the list and zeroes the rest (`3 4 5 0`)
// found by thread B (2026-11-05), comparing with clang: `new int[n]{1, 2, 3}` with n = 2 wrote the third element past its block
// test:
// exit: 1
int elements = 2;

test "below the list"
{
  int* p = new int[elements]{1, 2, 3};
  println("not reached ", p[2]);
}

test "negative"
{
  int n = -elements;
  int* p = new int[n];
  println("not reached either ", p == nullptr ? 1 : 0);
}

test "fits"
{
  int* p = new int[elements + 2]{3, 4, 5};
  println(p[0], " ", p[1], " ", p[2], " ", p[3]);
  delete[] p;
}
