// spec: packing arguments into a Text parameter ranks as C's `...` does, below every standard and user-defined conversion: an overload that takes the arguments as they are wins, and the Text one takes what no other does (`int Point Text Text Text Wrapped`)
extern "C" import "stdio.h";
struct Point
{
  int x = 0;
  void appendTo(std::String& out) const { out << "p"; }
};
struct Wrapped
{
  implicit Wrapped(int value) {}
};
void f([[maybe_unused]] int value) { printf("int "); }
void f([[maybe_unused]] std::Text text) { printf("Text "); }
void g([[maybe_unused]] const Point& p) { printf("Point "); }
void g([[maybe_unused]] std::Text text) { printf("Text "); }
void h([[maybe_unused]] Wrapped w) { printf("Wrapped "); }
void h([[maybe_unused]] std::Text text) { printf("Text "); }
int main()
{
  Point p;
  f(1);
  g(p);
  f(p);
  f(p, p);
  g();
  h(1);
  printf("\n");
  return 0;
}
