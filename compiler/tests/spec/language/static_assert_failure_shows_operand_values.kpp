static_assert(sizeof(Big) <= 128);
static_assert(sizeof(Big) <= limit, "Big fits a cache line pair");
static_assert(alignof(Big) == 4 && true);
static_assert(sizeof(Bits) != 4);
static_assert(1 == 2);
static_assert(limit * 2 < 100u);
template<class T>
