// spec: `?->`'s result is a value: a class result is an Optional of a copy, empty and with nothing built when the object is not set; a function giving T& gives an Optional of a copy; a pointer result is nullptr, a bool false, a float an Optional; a String is an Optional<String> (design.md 23a)
class Tag
{
public:
  int id = 9;
  Tag() { std::println("made"); }
  Tag(const Tag& other) : id(other.id + 1) { std::println("copied"); }
  ~Tag() { std::println("gone ", this.id); }
};
class Holder
{
public:
  Tag tag;
  int number = 3;
  bool flag = true;
  double ratio = 0.5;
  std::String name = "engine";
  Holder* self = nullptr;
  Tag& ref() { return this.tag; }
  int& count() { return this.number; }
};
int main()
{
  Holder h;
  Holder* none = nullptr;
  Holder* set = &h;
  {
    std::Optional<Tag> a = none?->tag;
    std::println(bool(a));
    std::Optional<Tag> b = set?->ref();
    std::println(b->id);
  }
  std::println(set?->count() ?: 0, " ", none?->count() ?: 0, " ", none?->flag, " ", set?->flag, " ", none?->ratio ?: 0.0, " ", set?->ratio ?: 0.0, " ", none?->self == nullptr);
  std::Optional<std::String> name = set?->name;
  std::println(*name, " ", none?->name ?: std::String("none"));
  std::println("end");
  return 0;
}
