// spec: `?->`'s result is a value: a class result is a copy, its default a default-constructed one; a function giving T& gives a T; a pointer's default is nullptr, a bool's false, a float's 0
class Tag
{
public:
  int id = 9;
  Tag() { println("made"); }
  Tag(const Tag& other) : id(other.id + 1) { println("copied"); }
  ~Tag() { println("gone ", this->id); }
};
class Holder
{
public:
  Tag tag;
  int number = 3;
  bool flag = true;
  double ratio = 0.5;
  Holder* self = nullptr;
  Tag& ref() { return this->tag; }
  int& count() { return this->number; }
};
int main()
{
  Holder h;
  Holder* none = nullptr;
  Holder* set = &h;
  {
    Tag a = none?->tag;
    println(a.id);
    Tag b = set?->ref();
    println(b.id);
  }
  println(set?->count(), " ", none?->count(), " ", none?->flag, " ", set?->flag, " ", none?->ratio, " ", set?->ratio, " ", none?->self == nullptr);
  println("end");
  return 0;
}
