// spec: a `const auto` global whose initializer names `const auto` globals declared after it is typed from theirs, in any order (symbols are order-independent): `const auto FULL = (CONTROL | INTEGER);` before CONTROL and INTEGER
// factorio: StackWalker's `CONTEXT_FULL`, which the C import writes as `const auto CONTEXT_FULL = (CONTEXT_CONTROL | CONTEXT_INTEGER | CONTEXT_FLOATING_POINT);` among the header's macro constants in name order, so before CONTEXT_INTEGER
const auto FULL = (CONTROL | INTEGER | FLOATING_POINT);
const long long AMD64 = 0x00100000L;
const auto CONTROL = (AMD64 | 0x00000001L);
const auto FLOATING_POINT = (AMD64 | 0x00000008L);
const auto INTEGER = (AMD64 | 0x00000002L);

int main()
{
  println("{} {} {}", unsigned(CONTROL), unsigned(INTEGER), unsigned(FULL));
  return 0;
}
