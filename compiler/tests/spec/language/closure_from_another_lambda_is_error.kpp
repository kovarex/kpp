// spec: a lambda's closure is never initialised from another lambda's, which C++ rejects (each lambda's closure is a type of its own, with no conversion to another's): `decltype(l1) f = l2;` is an error. kppc took l2's bytes for l1's closure and called l1's body on them: f() gave 2, where l2's body gives 12
// error: closure_from_another_lambda_is_error.kpp:8: error: a closure initialised from another lambda's closure
extern "C" int printf(const char* format, ...);
int fromDecltype(int a, int b)
{
  auto l1 = [a]() { return a; };
  auto l2 = [b]() { return b + 10; };
  decltype(l1) f = l2;
  return f();
}
int main(int argc, char** argv)
{
  printf("%d\n", fromDecltype(1, 2));
  return 0;
}
