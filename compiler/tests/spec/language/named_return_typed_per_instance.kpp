// spec: named return elision (design.md 23) where only an instance knows the types: a generic lambda's local of a type its parameter decides, a function template's, and a function whose return type is deduced (auto); the local and the caller's object are one object, with no copy and no move
// factorio: none yet; the rule is the resolver's (GlobalScope::namedReturnVariable), which codegen asks with the body and the result type it emits, an instance's own
int copies = 0;
int moves = 0;
const void* built = nullptr;
struct Tracked
{
  int value = 0;
  Tracked() { built = &this; }
  Tracked(const Tracked& o) : value(o.value) { ++copies; }
  Tracked(Tracked&& o) : value(o.value) { ++moves; }
};
template<typename T>
struct Box
{
  T inner{};
  Box() { built = &this; }
  Box(const Box& o) : inner(o.inner) { ++copies; }
  Box(Box&& o) : inner(o.inner) { ++moves; }
};
auto makeAuto(int v)
{
  Tracked t;
  t.value = v;
  return t;
}
template<typename T>
auto boxOf(T v)
{
  Box<T> b;
  b.inner = v;
  return b;
}
int main()
{
  Tracked a = makeAuto(1);
  bool sameA = built == &a;
  auto generic = [](auto v) { Box<decltype(v)> b; b.inner = v; return b; };
  Box<int> b = generic(2);
  bool sameB = built == &b;
  Box<double> c = generic(2.5);
  bool sameC = built == &c;
  Box<int> d = boxOf(4);
  bool sameD = built == &d;
  std::println(a.value, " ", b.inner, " ", c.inner, " ", d.inner);
  std::println(copies, " copies, ", moves, " moves");
  std::println(sameA, " ", sameB, " ", sameC, " ", sameD);
  return 0;
}
