// spec: kpp requires nullptr for a null pointer (kovarex, 2026-11-04; design.md 4, which replaced C++'s literal 0 as a null pointer constant): `Entity* none = nullptr`, `none == nullptr`; a literal 0 is an int, so `take(0)` is take(int) and never take(Entity*) (the error spec zero_literal_as_pointer_is_error has the 0s that would be pointers)
// found in the converted game: `CoInitializeEx(0, COINIT_MULTITHREADED)` and the like passed 0 for pointers; the converter writes nullptr (C, 6f248ebe)
struct Entity { int id = 5; };
int pick(Entity* e) { return e ? e->id : -1; }
int take(int value) { return value + 1; }
int take(Entity* e) { return e ? 50 : 60; }
int main()
{
  Entity* none = nullptr;
  Entity one;
  println(pick(none), " ", take(0), " ", take(none), " ", none == nullptr ? 1 : 0, " ", pick(&one));
  return 0;
}
