// spec: brace elision reaches every subaggregate ([dcl.init.aggr] 16): a value that does not initialize an aggregate member, base or array element whole (a number for an aggregate) starts that element's own values, and it takes only as many as it has elements: `In arr[2] = {1, 2, 3, 4}` is {1, 2}, {3, 4}; `Out o{1, 2}` over `In in; int c;` gives in {1, 2} and c 0; `WithArr{1, 2, 3}` over `In pts[2]; int n;` is pts {1, 2}, {3, 0} and n 0; `Der2{1, 2, 3}` gives its base 1 and 2; arrays of arrays and of aggregates of arrays alike, the elements left out value-initialized (`WithQ{Q{1}, Q{2}}`: q[2] Q's 42); a value of the member's own class initializes it whole (`Out{In{5, 6}, 7}`); an array of unknown bound has an element for each run of values (`In unk[] = {1, 2, 3}`: two, `int mm[][2] = {1, 2, 3}`: two, `In loc[] = {x, y}` of two int locals: one), and a new[]'s elements too (`new In[2]{1, 2, 3}`: {1, 2}, {3, 0}); a string literal is a whole array of characters (`char names[][4] = {"ab", "cd", "ef"}`: three); at run time and at compile time alike (clang gives the same numbers)
// found by thread D (2026-11-06, comparing kpp with clang on aggregates): codegen elided only an array member's braces, each of its elements taking one value: `In arr[2] = {1, 2, 3, 4}` gave {1, 0}, {2, 0} and dropped 3 and 4, `Out o{1, 2}` in {1, 0} and c 2, `WithArr{1, 2, 3}` pts {1, 0}, {2, 0} and n 3; `int m[2][2] = {1, 2, 3, 4}`, an array of aggregates with arrays a base's elided braces and `new In[2]{1, 2, 3}` were refused; the checker counted `In a[] = {1, 2, 3, 4}` four elements; the compile-time evaluator had the values right
struct In { int a; int b; };
struct Out { In in; int c; };
struct WithArr { In pts[2]; int n; };
struct P { int x[2]; };
struct Arr2 { In e[2]; };
struct Base2 { int u; int v; };
struct Der2 : Base2 { int w; };
struct Q { int v = 42; };
struct WithQ { Q q[3]; int n; };
constexpr int code(Out o) { return o.in.a * 100 + o.in.b * 10 + o.c; }
constexpr In carr[] = {1, 2, 3, 4};

int main()
{
  In arr[2] = {1, 2, 3, 4};
  WithArr w{1, 2, 3};
  int m[2][2] = {1, 2, 3, 4};
  P parr[2] = {1, 2, 3, 4};
  Arr2 a2 = {1, 2, 3};
  Der2 d{1, 2, 3};
  Out o{1, 2};
  Out whole{In{5, 6}, 7};
  WithQ wq{Q{1}, Q{2}};
  std::println(arr[0].a, " ", arr[0].b, " ", arr[1].a, " ", arr[1].b, " ",
          w.pts[0].a, " ", w.pts[0].b, " ", w.pts[1].a, " ", w.pts[1].b, " ", w.n);
  std::println(m[0][0], " ", m[0][1], " ", m[1][0], " ", m[1][1], " ",
          parr[0].x[0], " ", parr[0].x[1], " ", parr[1].x[0], " ", parr[1].x[1]);
  std::println(a2.e[0].a, " ", a2.e[0].b, " ", a2.e[1].a, " ", a2.e[1].b, " ",
          d.u, " ", d.v, " ", d.w, " ", o.in.a, " ", o.in.b, " ", o.c);
  std::println(whole.in.a, " ", whole.in.b, " ", whole.c, " ", wq.q[0].v, " ", wq.q[1].v, " ", wq.q[2].v, " ", wq.n);
  constexpr int k = code(Out{1, 2});
  static_assert(code(Out{1, 2}) == 120);
  std::println(k, " ", code(o));
  In unk[] = {1, 2, 3};
  int mm[][2] = {1, 2, 3};
  std::println(int(sizeof(unk) / sizeof(In)), " ", int(sizeof(mm) / sizeof(mm[0])), " ", int(sizeof(carr) / sizeof(In)), " ",
          unk[1].a, " ", unk[1].b, " ", carr[1].b);
  int x = 5;
  int y = 6;
  In loc[] = {x, y};
  std::println(int(sizeof(loc) / sizeof(In)), " ", loc[0].a, " ", loc[0].b);
  In* p = new In[2]{1, 2, 3};
  int n = 3;
  In* q = new In[n]{4, 5, 6};
  std::println(p[0].a, " ", p[0].b, " ", p[1].a, " ", p[1].b, " ", q[0].b, " ", q[1].a, " ", q[1].b, " ", q[2].a);
  delete[] p;
  delete[] q;
  char names[][4] = {"ab", "cd", "ef"};
  std::println(int(sizeof(names) / sizeof(names[0])), " ", names[1][0], " ", names[2][1]);
  return 0;
}
