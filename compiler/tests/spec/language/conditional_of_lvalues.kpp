// spec: `c ? a : b` of two lvalues of one type is an lvalue (assignable, forwarded as `const T&` when they are const members), and a const scalar prvalue binds an `Args&&` (a prvalue of a scalar type is never const)
// factorio: DrawQueue's `create<SpriteDrawOrder>(..., shadow ? shift.second : shift.first, ...)` and Animation's `stripes.emplace_back(fileName, parameters.lineLength != 0 ? parameters.lineLength : parameters.frameCount, ...)` with const parameters
struct Vec2
{
  double x = 0;
  double y = 0;
  Vec2() = default;
  Vec2(double x, double y) : x(x), y(y) {}
};
struct Order
{
  Vec2 shift;
  int tag;
  Order(const Vec2& shift, int tag) : shift(shift), tag(tag) {}
};
template<class T, class... Args>
T* create(Args&&... values)
{
  return new T(std::forward<Args>(values)...);
}
double pick(bool shadow, const std::Pair<Vec2, Vec2>& shift)
{
  Order* o = create<Order>(shadow ? shift.second : shift.first, 5);
  double r = o->shift.x + o->tag;
  delete o;
  return r;
}
struct Params
{
  uint32_t lineLength = 0;
  uint32_t frameCount = 7;
};
uint32_t widths(const Params& p)
{
  std::Vector<uint32_t> out;
  out.emplace_back(p.lineLength != 0 ? p.lineLength : p.frameCount);
  return out[0];
}
int main()
{
  std::Pair<Vec2, Vec2> s{Vec2(1, 2), Vec2(3, 4)};
  int a = 1;
  int b = 2;
  bool first = true;
  (first ? a : b) = 10;
  Params p;
  std::println(pick(true, s), " ", pick(false, s), " ", a, " ", b, " ", widths(p));
  return 0;
}
