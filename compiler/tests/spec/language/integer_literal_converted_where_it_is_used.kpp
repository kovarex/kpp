// spec: an integer literal converted to another integer type where it is used (an argument, an operand beside a wider or narrower one, an initializer, a return) has the value the conversion gives a variable of the literal's type: widened by the literal's own sign, narrowed to the target's bits
// factorio: 140,909 of the game's 10.7 million instructions converted an integer literal (`sext i32 1 to i64` for `size + 1`), 1.3% of them (2026-11-23); the literal is now written converted, and this checks its value
i64 wide(i64 v) { return v; }
u64 wideUnsigned(u64 v) { return v; }
i16 narrow(i16 v) { return v; }
u16 narrowUnsigned(u16 v) { return v; }
i8 tiny(i8 v) { return v; }
u8 tinyUnsigned(u8 v) { return v; }
i64 minusOne() { return -1; }
u64 thousand() { return 1000; }
i8 minusEight() { return -8; }
u8 twoHundred() { return 200; }
// (values the compiler cannot know)
i64 opaque(i64 v) { return std::getenv("KPP_SPEC_NEVER_SET") ? 0 : v; }
int main()
{
  // arguments
  std::println(wide(-1), " ", wide(2147483647), " ", wide(-2147483647 - 1), " ", wideUnsigned(7), " ", wideUnsigned(2147483647));
  std::println(narrow(-32768), " ", narrow(32767), " ", narrowUnsigned(65535), " ", narrowUnsigned(0));
  std::println((int)tiny(-128), " ", (int)tiny(127), " ", (int)tinyUnsigned(255), " ", (int)tinyUnsigned(128));
  // returns
  std::println(minusOne(), " ", thousand(), " ", (int)minusEight(), " ", (int)twoHundred());
  // operands beside a wider one
  i64 a = opaque(5000000000);
  u64 b = (u64)opaque(5000000000);
  std::println(a + 1, " ", a - 1, " ", a + -1, " ", a * 2, " ", a / -2, " ", a % 7, " ", b + 1, " ", b - 1, " ", b * 3, " ", b / 2, " ", b % 7);
  std::println(a > 1, " ", a < -1, " ", a == 5000000000, " ", b > 1, " ", b != 0);
  // operands beside a narrower one
  u8 c = (u8)opaque(250);
  i8 d = (i8)opaque(-100);
  u16 e = (u16)opaque(65000);
  i16 f = (i16)opaque(-30000);
  std::println(c + 10, " ", c - 251, " ", d + 300, " ", d - 100, " ", e + 1000, " ", f - 10000, " ", c * 2, " ", d * -3);
  std::println(c == 250, " ", d == -100, " ", e > 64999, " ", f < -29999);
  // initializers
  i64 g = -5;
  u64 h = 5;
  i16 i = -5;
  u16 j = 60000;
  i8 k = -5;
  u8 l = 250;
  std::println(g + opaque(0), " ", h + (u64)opaque(0), " ", i + (int)opaque(0), " ", j + (int)opaque(0), " ", k + (int)opaque(0), " ", l + (int)opaque(0));
  // characters and booleans
  char m = (char)opaque(65);
  std::println((i64)m + 1, " ", m + 1, " ", (int)(m == 65), " ", wide('a'), " ", wide(true) + wide(false));
  // shifts and bit operations with a literal of another width
  std::println(a << 3, " ", a >> 1, " ", b >> 60, " ", a & 255, " ", a | 1, " ", a ^ -1, " ", b & 65535, " ", (i64)(c >> 1), " ", (int)(c & 15));
  return 0;
}
