struct Deleted
{
  Deleted() = delete;
  Deleted(i32 v) : v(v) {}
  i32 v;
};
struct Holder
{
  i32& target;
};
struct Fixed
{
  const i32 limit;
};
struct Outer
{
  Deleted inner;
};
struct Statics { static Deleted shared; };
Deleted global;
Deleted Statics::shared;
int main()
{
  Deleted local;
  Holder h;
  Fixed f;
  Outer all[2];
  (void)local, (void)h, (void)f, (void)all;
  return 0;
}
