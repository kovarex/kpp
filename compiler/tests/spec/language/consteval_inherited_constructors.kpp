// spec: a constructor inherited by `using Base::Base;` at compile time: `Vec2D(0, -1)` builds the base part with the base's constructor
// factorio: constexpr Vector2D UNIT_VECTOR = Vector2D(0, -1); (Vector2D : Vector2<double, Vector2D>, using Vector2::Vector2), BlueprintBook's preview offset
template<class T, class Derived>
struct Vec2
{
  constexpr Vec2() = default;
  constexpr Vec2(T x, T y) : x(x), y(y) {}
  T x = 0;
  T y = 0;
};
struct Vec2D : Vec2<double, Vec2D>
{
  using Vec2::Vec2;
  static constexpr double epsilon = 1e-9;
};
constexpr Vec2D unit = Vec2D(0, -1);
static_assert(unit.x == 0 && unit.y == -1);
int main()
{
  println("{}", int(unit.y));
  return 0;
}
