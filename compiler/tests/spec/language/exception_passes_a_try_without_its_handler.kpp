// spec: a try none of whose handlers takes the exception is passed over: the search goes on to the try around it, the inner handler's body never runs, and the objects of both scopes are destroyed innermost first before the outer handler runs (C++'s two-phase search finds the handler before unwinding: design.md, "Targets and hosts", stage 3)
class Boom : public std::Exception { public: Boom() : Exception("boom") {} };
class Other : public std::Exception { public: Other() : Exception("other") {} };
struct Note { const char* text; Note(const char* t) : text(t) {} ~Note() { std::println("~", std::StringView(this.text)); } };
void inner()
{
  Note n("inner local");
  try
  {
    Note m("inner try local");
    throw Boom();
  }
  catch (const Other&)
  {
    std::println("wrong handler");
  }
  std::println("not reached");
}
int main()
{
  try
  {
    Note o("outer try local");
    inner();
  }
  catch (const Boom& e)
  {
    std::println("caught ", std::StringView(e.what()));
  }
  return 0;
}
