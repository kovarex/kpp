// spec: `decltype(x)::member` names the member of the class decltype gives (a nested type, a member alias, a constant): `decltype(Definition::migrations)::const_iterator it;` as a member, `using mapped_type = decltype(this->inventories)::mapped_type;` in a member function, `decltype(this->deviation)::CoordinateType::FractionalBits` as a constant; the name is not looked up outside that class
// factorio: MigrationHelpers' `decltype(PrototypeMigrationListDefinition::migrations)::const_iterator it`, LinkedInventories' mapped_type, SmokeSource's and TrivialSmoke's FractionalBits
struct Fixed
{
  using CoordinateType = Fixed;
  static constexpr int FractionalBits = 8;
  int raw = 0;
};
struct Definition
{
  Vector<int> migrations;
};
using mapped_type = double; // not the one `decltype(...)::mapped_type` names
struct Holder
{
  Map<int, String> inventories;
  Fixed deviation;
  decltype(Definition::migrations)::const_iterator it = nullptr;
  int size() const
  {
    using mapped_type = decltype(this.inventories)::mapped_type;
    mapped_type result = "abc";
    return int(result.size()) + decltype(this.deviation)::CoordinateType::FractionalBits;
  }
};
int main()
{
  Holder h;
  Vector<int> v;
  v.push_back(7);
  h.it = v.begin();
  println(h.size(), " ", *h.it);
  return 0;
}
