// spec: functions run at compile time: bodies of returns, if, if constexpr and constant locals (Limits<T>::max()), a library template (max), a member function of a class instance (Array::size on a local array), a scoped enumerator converted to an integer
// factorio: Bitset<Limits<DamageTypeID::IndexType>::max() + 1>, static_assert(layers.size() == size_t(TileSpriteLayer::Count))
enum class Layer { Ground, Object, Air, Count };
template<typename T>
T clampTo(T value, T low, T high)
{
  if (value < low)
    return low;
  const T limited = value > high ? high : value;
  return limited;
}
template<size_t N>
struct Count
{
  static constexpr size_t value = N;
};
int main()
{
  std::Array layers = {Layer::Ground, Layer::Object, Layer::Air};
  static_assert(layers.size() == size_t(Layer::Count));
  static_assert(std::Limits<uint8_t>::max() == 255 && std::Limits<int16_t>::max() == 32767 && std::Limits<int32_t>::min() == -2147483647 - 1);
  std::println(Count<std::Limits<uint8_t>::max() + 1>::value);
  std::println(Count<std::max(sizeof(int), sizeof(double))>::value);
  std::println(Count<clampTo(17, 0, 10)>::value);
  std::println(Count<static_cast<size_t>(Layer::Air)>::value);
  std::println(Count<layers.size()>::value);
  return 0;
}
