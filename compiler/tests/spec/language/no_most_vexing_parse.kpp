// spec: no most vexing parse (design.md, Kpp v0 rules 2 and 4): at namespace scope `Type(args)` and `Type{args}` inside a declarator's parentheses are expressions, so `Widget copied(Size(base));` and `Widget fresh(Size());` are variables; parameter lists still declare functions, a parenthesised declarator among them only when a parameter list or an array bound follows (`int (*f)(int)`)
// factorio: the direct-initialised constants in headers (language/direct_init_functional_cast) next to the function declarations there
struct Size { int w; };
struct Widget
{
  int w;
  Widget(Size s) : w(s.w) {}
};
Size base{6};
Widget copied(Size(base));
Widget fresh(Size());
const Size* NOWHERE(nullptr);
int counter(int(7.9));
int twice(int x);
int apply(int (*f)(int), int v);
int noArgs();
int twice(int x) { return 2 * x; }
int apply(int (*f)(int), int v) { return f(v); }
int noArgs() { return 11; }
int main()
{
  println(copied.w, " ", fresh.w, " ", NOWHERE == nullptr, " ", counter, " ", apply(twice, 4), " ", noArgs());
  return 0;
}
