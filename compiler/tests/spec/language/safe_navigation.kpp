// spec: `a?->b?->foo()` calls foo only when a and a->b are set; a number's result is an Optional, empty when one is not, which `?:` unwraps; a pointer result is null then; a void call does nothing; a is evaluated once (design.md 23a)
class Leaf
{
public:
  int value = 7;
  int twice() { return this->value * 2; }
  void touch() { println("touched"); }
};
class Node
{
public:
  Leaf* leaf = nullptr;
  Node* next = nullptr;
  Leaf* get() { return this->leaf; }
};
int evaluated = 0;
Node* once(Node* n)
{
  ++evaluated;
  return n;
}
int main()
{
  Leaf leaf;
  Node full;
  full.leaf = &leaf;
  Node empty;
  Node* none = nullptr;
  Node* set = &full;
  println(none?->leaf?->twice() ?: 0, " ", set?->leaf?->twice() ?: 0, " ", empty.leaf?->value ?: 0, " ", set?->leaf?->value ?: 0);
  Optional<int> missing = none?->leaf?->value;
  Optional<int> found = set?->leaf?->value;
  println(bool(missing), " ", bool(found), " ", *found);
  println(none?->leaf == nullptr, " ", set?->leaf == &leaf);
  println(set?->get()?->value ?: -1, " ", none?->get()?->value ?: -1);
  none?->leaf?->touch();
  set?->leaf?->touch();
  println(once(set)?->leaf?->value ?: 0, " ", evaluated);
  println(once(none)?->leaf?->value ?: 0, " ", evaluated);
  int total = (set?->leaf?->value ?: 0) + 1;
  println(total);
  return 0;
}
