// spec: a noexcept destructor ends the program when a member's destructor throws after its body, as it is the destructor's own exception ([except.spec] 5)
void onTerminate()
{
  std::println("terminate");
  fflush(nullptr);
  exit(0);
}
struct T { ~T() noexcept(false) { std::println("member"); throw 1; } };
struct S { T t; ~S() noexcept { std::println("body"); } };
void scope() { S s; }
int main()
{
  std::setTerminate(onTerminate);
  try
  {
    scope();
  }
  catch (int)
  {
    std::println("caught past the destructor");
  }
  return 0;
}
