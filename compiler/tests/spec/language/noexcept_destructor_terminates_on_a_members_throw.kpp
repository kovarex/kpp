// spec: a noexcept destructor ends the program when a member's destructor throws after its body, as it is the destructor's own exception ([except.spec] 5)
void onTerminate()
{
  println("terminate");
  fflush(nullptr);
  exit(0);
}
struct T { ~T() noexcept(false) { println("member"); throw 1; } };
struct S { T t; ~S() noexcept { println("body"); } };
void scope() { S s; }
int main()
{
  setTerminate(onTerminate);
  try
  {
    scope();
  }
  catch (int)
  {
    println("caught past the destructor");
  }
  return 0;
}
