// spec: an empty brace list for a class with a default constructor value-initializes it (C++'s list-initialization rule for `{}`), also when the class has an InitializerList constructor: `Vector<Reference> references = {}` as a default argument and `Cache dummy({}, {})` for const Vector& parameters make empty vectors without the InitializerList constructor, which copies, so move-only elements are fine
// factorio: CommandProcessor's `std::vector<SavedSpecialItemReference> specialItemsInMessage = {}` (a default argument) and LightningGenerator's dummy constructor, `priorityCache({}, {})` for LightningPriorityCache(const std::vector<LightningPriorityRule>&, const std::vector<LightningRuleBase>&): both element types delete their copy constructors
struct Reference
{
  Reference(int id) : id(id) {}
  Reference(const Reference&) = delete;
  Reference(Reference&&) = default;
  int id;
};
int countOf(const std::String& text, std::Vector<Reference> references = {})
{
  return int(references.size()) + int(text.size());
}
struct Cache
{
  Cache(const std::Vector<Reference>& rules, const std::Vector<int>& exemptions) : count(rules.size() + exemptions.size()) {}
  int count;
};
int main()
{
  Cache dummy(std::Vector<Reference>{}, std::Vector<int>{});
  std::Vector<Reference> some;
  some.push_back(Reference(1));
  std::println(countOf("ab"), " ", countOf("abc", std::move(some)), " ", dummy.count);
  return 0;
}
