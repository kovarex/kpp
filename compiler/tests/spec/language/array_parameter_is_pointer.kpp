// spec: a parameter declared as an array is a pointer to its element (C's and C++'s adjustment): `void f(unsigned rep[3])` is `void f(unsigned* rep)`, so a pointer is an argument for it; and in a function pointer type too: `unsigned (*)(unsigned rep[3])` is `unsigned (*)(unsigned*)`
// factorio: zstd (converted as C): ZSTD_blockCompressor's `U32 rep[ZSTD_REP_NUM]` parameter, with the functions of that pointer type taking `U32 rep[ZSTD_REP_NUM]` and called with `zc->blockState.nextCBlock->rep` decayed; the converter writes `U32* rep` until this passes
typedef unsigned (*Summer)(unsigned rep[3]);

unsigned sum(unsigned rep[3])
{
  return rep[0] + rep[1] + rep[2];
}

int main()
{
  unsigned values[4] = {1, 2, 3, 4};
  unsigned* tail = values + 1;
  unsigned (*f)(unsigned*) = sum;
  Summer g = sum;
  std::println(sum(values), " ", f(tail), " ", g(tail));
  return 0;
}
