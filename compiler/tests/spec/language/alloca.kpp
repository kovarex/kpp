// spec: alloca (<malloc.h>, MSVC's _alloca): a block of a run-time size on the stack of the calling function, distinct per call and aligned to 16 bytes, which stays valid until that function returns, also when the call is in a loop or in a block that has ended; the function's return frees all of them, so calling it again and again does not grow the stack
// factorio: libraries\vorbis (63 uses in 13 files: block.c's `float *lpc=alloca(order*sizeof(*lpc));`), libraries\opus (USE_ALLOCA: celt and silk's ALLOC), libraries\imgui (10)
extern "C" import "malloc.h";

// Fills `count` blocks of `size` ints, each allocated in its own loop iteration and block, and
// checks every one after the loop: none was freed or overlapped while the function runs.
int fillAndCheck(int count, int size)
{
  int* blocks[8];
  for (int b = 0; b < count; ++b)
  {
    {
      int* block = (int*)alloca(size * sizeof(int));
      for (int i = 0; i < size; ++i)
        block[i] = b * 1000 + i;
      blocks[b] = block;
    }
  }
  int sum = 0;
  bool aligned = true;
  for (int b = 0; b < count; ++b)
  {
    aligned = aligned && (unsigned long long)blocks[b] % 16 == 0;
    for (int i = 0; i < size; ++i)
    {
      if (blocks[b][i] != b * 1000 + i)
        return -1;
      sum += blocks[b][i];
    }
  }
  return aligned ? sum : -2;
}

// 64 KB per call: a million calls overflow the 1 MB stack unless each return frees its block.
int touch(int value)
{
  char* block = (char*)_alloca(65536);
  block[0] = (char)value;
  block[65535] = (char)(value + 1);
  return block[0] + block[65535];
}

int main()
{
  println("{}", fillAndCheck(8, 100));
  println("{}", fillAndCheck(1, 1));
  long long total = 0;
  for (int i = 0; i < 1000000; ++i)
    total += touch(i % 50);
  println("{}", total);
  return 0;
}
