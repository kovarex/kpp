// spec: alignas on a class template and alignof of an instantiation (raw storage for a T: what Optional, Variant and small-buffer containers need)
// factorio: the library's Optional (docs/stdlib-conformance.md), and the game's own aligned buffers
template<size_t Size, size_t Align>
struct alignas(Align) AlignedBytes { unsigned char bytes[Size]; };
struct Pair4 { int a; char b; };
int main()
{
  std::println(alignof(AlignedBytes<3, 16>), " ", alignof(Pair4));
  return 0;
}
