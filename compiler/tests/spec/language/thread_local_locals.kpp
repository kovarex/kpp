// spec: a `thread_local` local (without `static`) has thread storage: one object per thread, built on the thread's first pass and kept between calls, so a function may return a reference to it (`thread_local Cache cache; cache.clear(); return cache;`)
// factorio: MathExpressions::Evaluator::getVariablesCache's `thread_local EvaluatorParameters cache;`: it was an automatic local, the reference returned dangled, and `--dump-data` crashed in UtilityConstants' verifyExpression (also SelectorCombinatorControlBehavior, LocaleStringReplacer, WaitConditionCounts)
struct Cache
{
  Vector<int> values;
  int builds = 0;
  Cache() { this.builds = 1; }
};
Cache& cacheOf()
{
  thread_local Cache cache;
  cache.values.clear();
  return cache;
}
int fill(int count)
{
  Cache& c = cacheOf();
  for (int i = 0; i < count; ++i)
    c.values.push_back(i);
  int size = int(c.values.size());
  return cacheOf().builds * 100 + size; // built once: builds stays 1
}
int counter()
{
  thread_local int calls = 0;
  return ++calls;
}
int main()
{
  int a = fill(3);
  int b = fill(5);
  counter();
  counter();
  int inThread = 0;
  Thread worker([&]() { inThread = counter(); });
  worker.join();
  println(a, " ", b, " ", counter(), " ", inThread);
  return 0;
}
