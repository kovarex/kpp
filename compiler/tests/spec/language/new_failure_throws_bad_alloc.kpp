// spec: new throws BadAlloc when the memory cannot be had, as C++'s new throws std::bad_alloc: when malloc fails (new returns no null pointer and constructs nothing), and for new T[n] whose n * sizeof(T) does not fit in a size_t (never a wrapped, smaller block)
// factorio: every new and new[] of the converted game and of the library's UniqueArray; found with the containers' size limits (library/size_limits_vector)
// until 2026-11-06 new returned null when malloc failed, and new int[2^62 + 1] allocated the 4 bytes its wrapped size asked for (B): now BadAlloc, the library's throwBadAlloc, for both
struct Page
{
  char bytes[4096];
  Page() { this.bytes[0] = 'p'; std::println("constructed"); } // (the block written and read below: an optimizer may not drop an unused one)
};

int main(int argc, char** argv)
{
  long long count = (1LL << 48) - argc + 1; // 2^60 bytes of pages: more than any address space has, so no malloc gives them
  try
  {
    Page* pages = new Page[count];
    std::println("allocated ", pages != nullptr, " ", pages[count - 1].bytes[0]);
  }
  catch (const std::BadAlloc& e)
  {
    std::println("pages: ", std::StringView(e.what()));
  }
  long long wrapping = 0x4000000000000000LL + argc; // 2^62 + 1 ints: 4 * that wraps to 4 bytes
  try
  {
    int* ints = new int[wrapping];
    std::println("allocated ", ints != nullptr);
  }
  catch (const std::BadAlloc& e)
  {
    std::println("ints: ", std::StringView(e.what()));
  }
  return 0;
}
