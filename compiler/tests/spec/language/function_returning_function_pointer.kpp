// spec: a function whose result is a pointer to a function, written in C's declarator form `int (*choose(bool up))(int)` (its own parameters inside the parentheses, its result's after them), declared and defined, beside the trailing-return form; until 2026-11-06 a parse error ("expected ')' in declarator")
int inc(int x) { return x + 1; }
int dec(int x) { return x - 1; }
int (*choose(bool up))(int);
int (*choose(bool up))(int) { return up ? inc : dec; }
auto chooseToo(bool up) -> int (*)(int) { return up ? inc : dec; }
int main()
{
  println(choose(true)(5), " ", choose(false)(5), " ", chooseToo(true)(1));
  return 0;
}
