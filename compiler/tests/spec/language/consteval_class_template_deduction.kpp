// spec: class template argument deduction in constants: `constexpr Array named = {Pair{"first", Mode::A}, ...}`, `constexpr auto infos = Array{Info{...}, ...}`, read at compile time
// factorio: SpriteFlagHelpers::flagsList, allCraftingMachinePrototypeFlags, entityPrototypeFlagMapping, ModPortal's sortAttributes, DebugVisualizationRenderer's colorList
enum class Mode { A, B, C };
struct Info
{
  const char* name;
  Mode mode;
  bool shown;
};
constexpr std::Array named =
{
  std::Pair { "first", Mode::A },
  std::Pair { "second", Mode::C },
};
constexpr auto infos = std::Array {
  Info { "x", Mode::B, true },
  Info { "y", Mode::C, false },
  Info { "z", Mode::A, true },
};
constexpr auto words = std::Array { "relevancy", "downloads" };
static_assert(named.size() == 2 && named[1].second == Mode::C);
static_assert(infos[2].mode == Mode::A && !infos[1].shown && infos.size() == 3);
static_assert(words[1][0] == 'd');
int main()
{
  std::println(std::StringView(named[0].first), " ", std::StringView(infos[1].name), " ", std::StringView(words[0]));
  return 0;
}
