// spec: an enumeration without a fixed underlying type holds its enumerators off Windows: its type is the first of int, unsigned, long, unsigned long that does ([dcl.enum] 7), as g++ and clang have it; on Windows it is int, as MSVC's is
extern "C" int printf(const char* format, ...);
enum Unsig { u0, uBig = 0xFFFFFFFFu };
enum Big { b0, bBig = 0x100000000LL };
enum BigNeg { bn = -0x100000000LL };
int main()
{
  printf("%d %d %d\n", (int)sizeof(Unsig), (int)sizeof(Big), (int)sizeof(BigNeg));
  printf("%d %lld %lld\n", uBig > 0, (long long)bBig, (long long)bn);
  return 0;
}
