// spec: offsetof(T, member), the byte offset of a member in its class (C's and C++'s, from <cstddef>), a constant: of a struct member after an array, and of an unnamed union member in a struct named with `struct`
// factorio: Lua's lstate.c (`(LX *)((lu_byte *)(L) - offsetof(LX, l))`, the thread's block from its state, three uses) and lstrlib.c's `offsetof(struct cD, u)` (string.pack's maximum alignment); the game's PropertyTree logs three offsets
struct State
{
  int status = 0;
  void* stack = nullptr;
};
struct LX
{
  char extra[8];
  State l;
};
struct cD
{
  char c;
  union
  {
    double d;
    void* p;
    long long l;
  } u;
};
int main()
{
  LX block;
  State* l = &block.l;
  LX* back = (LX*)((char*)l - offsetof(LX, l));
  const int maxalign = int(offsetof(struct cD, u));
  std::println(int(offsetof(LX, l)), " ", back == &block, " ", maxalign);
  return 0;
}
