// spec: an operator on an enumeration operand calls the operator function declared for it ([over.match.oper]: the non-member candidates of an enum operand), unary (`!`, `~`, `-`, prefix and postfix `++`, `--`), binary (`+`) and compound assignments (`|=`) alike, at run time and at compile time; the built-in operator only where none is declared. clang gives `true 2 101 0 30 3 1000 7` for both lines
// found by thread D (2026-11-05): the unary ones were the built-in operator at run time and at compile time (`false -2 -1 4 34 -1 1000`), and the interpreter took the built-in `+` and `|=` too (3, 3); the game's PathFindFlags and TargeterFlags declare an operator! that agrees with the built-in one
enum class Flags : unsigned { None = 0, A = 1, B = 2, All = 3 };
constexpr bool operator!(Flags f) { return f == Flags::All; }
constexpr Flags operator~(Flags f) { return Flags(~unsigned(f) & 3u); }
enum Plain { P0, P1, P2 };
constexpr int operator-(Plain p) { return 100 + int(p); }
constexpr int operator+(Plain a, Plain b) { return 1000; }
enum class Dir { N, E, S, W };
constexpr Dir& operator++(Dir& d)
{
  d = d == Dir::W ? Dir::N : Dir(int(d) + 1);
  return d;
}
constexpr Dir operator++(Dir& d, int)
{
  Dir old = d;
  ++d;
  return old;
}
constexpr Dir& operator--(Dir& d)
{
  d = d == Dir::N ? Dir::W : Dir(int(d) - 1);
  return d;
}
constexpr Flags& operator|=(Flags& a, Flags b)
{
  a = Flags(unsigned(a) | unsigned(b) | 4u);
  return a;
}
constexpr int prefixed()
{
  Dir d = Dir::W;
  ++d;
  return int(d);
}
constexpr int postfixed()
{
  Dir e = Dir::W;
  Dir old = e++;
  return int(old) * 10 + int(e);
}
constexpr int decremented()
{
  Dir f = Dir::N;
  --f;
  return int(f);
}
constexpr int compound()
{
  Flags x = Flags::A;
  x |= Flags::B;
  return int(x);
}
constexpr bool ca = !Flags::All;
constexpr int cb = int(~Flags::A);
constexpr int cc = -P1;
constexpr int cd = prefixed();
constexpr int ce = postfixed();
constexpr int cf = decremented();
constexpr int cg = P1 + P2;
constexpr int ch = compound();
int main()
{
  Flags all = Flags::All;
  Flags a = Flags::A;
  Plain one = P1, two = P2;
  println(!all, " ", int(~a), " ", -one, " ", prefixed(), " ", postfixed(), " ", decremented(), " ", one + two, " ", compound());
  println(ca, " ", cb, " ", cc, " ", cd, " ", ce, " ", cf, " ", cg, " ", ch);
  return 0;
}
