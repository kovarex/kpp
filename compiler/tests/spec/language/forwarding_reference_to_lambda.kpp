// spec: a local `auto&&` bound to a lambda (a temporary whose lifetime the reference extends), then called
// factorio: the std::visit rewrite and generic code that holds a callable as `auto&& f = ...`
int main()
{
  int base = 40;
  auto&& add = [&](int x) { return base + x; };
  std::println(add(2));
  return 0;
}
