// spec: left of `?->` a class with operator-> and a bool conversion is set when its bool says so: T^, Optional, one of the program's; a temporary lives to the end of the full expression; such a class as the result (SharedPtr) is empty when the object is not set, no Optional of it (design.md 23a)
class Item
{
public:
  int v = 3;
  int get() const { return this.v; }
};
class Owner
{
public:
  std::SharedPtr<Item> shared = std::makeShared<Item>();
};
class Handle
{
public:
  Item* item;
  Handle(Item* i) : item(i) {}
  ~Handle() { std::println("handle gone"); }
  Item* operator->() const { return this.item; }
  operator bool() const { return this.item != nullptr; }
};
Handle make(Item* i)
{
  return Handle(i);
}
int main()
{
  Item item;
  Item^ owned = std::makeUnique<Item>();
  Item^ empty;
  std::Optional<Item> some = Item();
  std::Optional<Item> nothing;
  std::println(owned?->get() ?: 0, " ", empty?->get() ?: 0, " ", some?->v ?: 0, " ", nothing?->v ?: 0);
  std::println(make(&item)?->get() ?: 0);
  std::println(make(nullptr)?->get() ?: 0);
  Owner owner;
  Owner* set = &owner;
  Owner* none = nullptr;
  std::SharedPtr<Item> got = set?->shared;
  std::SharedPtr<Item> lost = none?->shared;
  std::println(bool(got), " ", bool(lost), " ", got->v);
  return 0;
}
