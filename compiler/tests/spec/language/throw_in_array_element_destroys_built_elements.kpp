// spec: an exception thrown while an array's elements are initialised destroys the elements already built, in reverse order, before the handler runs ([except.ctor]/3); clang 19 prints `E1 E2 ~E2 ~E1 caught 3`, one per line
// factorio: found by the templates thread comparing object lifetimes against clang 19: the built elements were never destroyed (silent: their destructors' effects lost)
struct E
{
  int id;
  E(int i) : id(i) { if (i == 3) throw i; std::println("E", i); }
  ~E() { std::println("~E", this.id); }
};
int main()
{
  try
  {
    E arr[4] = {1, 2, 3, 4};
  }
  catch (int e)
  {
    std::println("caught ", e);
  }
  return 0;
}
