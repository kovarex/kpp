// spec: if constexpr on type traits
// factorio: 411 uses in 107 files
template<typename T>
std::String describe(const T& value)
{
  if constexpr (std::isSame<T, int>)
    return std::format("int {}", value);
  else if constexpr (std::isPointer<T>)
    return std::String("pointer");
  else
    return std::String("other");
}
int main()
{
  int n = 3;
  std::println(describe(n), " / ", describe(&n), " / ", describe(2.5));
  return 0;
}
