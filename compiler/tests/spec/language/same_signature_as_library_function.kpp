// spec: a program's free function with the parameters of a standard library function of the same name (`String toString(int)`, which Format.kpp has) is that function defined twice in the one global scope: a compile error naming both, not a clash in the generated code; declaring it again (`int printf(const char*, ...);`) and an overload with other parameters are fine
// error: error: 'toString' with these parameters is defined here and in the standard library
String toString(int value)
{
  String text;
  text << "#" << (i64)value;
  return text;
}
String toString(int value, int base) { return toString(value + base); }
int main()
{
  println(toString(12), " ", toString(4, 6));
  return 0;
}
