// spec: a program's free function with the parameters of a standard library function of the same name (`String toString(int)`) is the program's: the library's is std::toString (it was a clash while the library's names were global)
std::String toString(int value)
{
  std::String text;
  text << "#" << (i64)value;
  return text;
}
std::String toString(int value, int base) { return toString(value + base); }
int main()
{
  std::println(toString(12), " ", toString(4, 6));
  return 0;
}
