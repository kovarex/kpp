// spec: an object with vtable pointers given by a constexpr constructor is constant initialization too ([basic.start.static] 2): a global initialized before it in the file calls its virtual functions and reads its members (before: zeros, and a call through a null vtable pointer). clang's output
// found comparing kpp with clang (thread I's battery si3)
extern "C" int printf(const char* format, ...);
int say(const char* what, int v) { printf("init %s = %d\n", what, v); return v; }
class V
{
public:
  constexpr V(int x) : value(x) {}
  virtual int f() const { return 1; }
  int value;
};
class W : public V
{
public:
  constexpr W() : V(5) {}
  int f() const override { return 2; }
};
struct Holder { int a = 3; W w; };
extern const W w;
extern W defaulted;
extern Holder holder;
const V* vp = &w;
int viaVirtual = say("viaVirtual", vp->f());
int viaMember = say("viaMember", w.value);
int viaDefaulted = say("viaDefaulted", defaulted.f() + defaulted.value);
int viaHolder = say("viaHolder", holder.w.f() + holder.a);
const W w;
W defaulted;
Holder holder;
int main()
{
  printf("%d %d %d %d\n", viaVirtual, viaMember, viaDefaulted, viaHolder);
  return 0;
}
