// spec: a bit-field whose width is a class template's argument (`uint32_t a : N` of Bits<3>) promotes by its instance's width, as C++'s [conv.prom] 5 has it: `x.a - 4` is the int -3 through the instance, through a derived instance (Wrapped<3>, the base's field), in the instance's member function (`auto d = a - 4;`, `a - 4 < 0`) and at compile time; clang prints the same
// beside language/bit_field_promotes_as_cpp (kovarex 2026-11-05: follow the standard): the checker evaluates the width with the instance's arguments, codegen reads its layout's
template<int N>
struct Bits
{
  uint32_t a : N;
  uint32_t b : 32 - N;
  int64_t below() const
  {
    auto d = a - 4;
    return d;
  }
  bool negative() const { return a - 4 < 0; }
};
template<int N>
struct Wrapped : Bits<N>
{
  int tag = N;
};
constexpr int64_t viaConstant()
{
  Bits<3> t{};
  t.a = 1;
  return t.a - 4;
}
static_assert(viaConstant() == -3);
int main()
{
  Bits<3> x{};
  x.a = 1;
  auto v = x.a - 4;
  Wrapped<3> w;
  w.a = 1;
  auto wv = w.a - 4;
  println(v, " ", x.below(), " ", x.negative(), " ", isSame<decltype(x.a - 4), int>, " ", wv, " ", viaConstant());
  return 0;
}
