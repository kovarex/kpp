// spec: what ends a case without a word: labels side by side share their statements, `break`, `return`, `continue`, a `throw`, `goto`, `fallthrough;` and `[[fallthrough]];`, a block or both branches of an `if` ending so, a statement after a closed case's block that is empty; clang's output for the same program without `fallthrough;`
int run(int n)
{
  int acc = 0;
  for (int i = 0; i < 2; ++i)
    switch (n)
    {
      case 0:
      case 1:
        acc += 1;
        break;
      case 2:
        acc += 2;
        fallthrough;
      case 3:
        acc += 3;
        [[fallthrough]];
      case 4:
        {
          acc += 4;
          break;
        };
      case 5:
        if (acc > 0)
          return acc;
        else
          continue;
      case 6:
        return 60;
      case 7:
        throw 7;
      case 8:
        goto done;
      default:
        acc += 100;
    }
done:
  return acc;
}
int main()
{
  for (int n = 0; n < 7; ++n)
    println(n, " ", run(n));
  println(run(8), " ", run(9));
  try { run(7); }
  catch (int e) { println("caught ", e); }
  return 0;
}
