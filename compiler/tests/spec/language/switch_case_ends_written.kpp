// spec: what ends a case under no implicit fallthrough, kpp's rule (design.md "No implicit fallthrough"; until its flip this snippet showed step 1's, C++'s meaning with every case's end written): its end reached (an implicit break), a block ending so, `return`, `continue`, a `throw`, `goto`; `fallthrough;` runs on into the next, also after a block; one label of two values shares their statements; a statement after a case's block that is empty; clang's output for the same program written in C++, `case 0: case 1:` and each case's `break;`
int run(int n)
{
  int acc = 0;
  for (int i = 0; i < 2; ++i)
    switch (n)
    {
      case 0, 1:
        acc += 1;
      case 2:
        acc += 2;
        fallthrough;
      case 3:
        acc += 3;
        fallthrough;
      case 4:
        {
          acc += 4;
        };
      case 5:
        if (acc > 0)
          return acc;
        else
          continue;
      case 6:
        return 60;
      case 7:
        throw 7;
      case 8:
        goto done;
      default:
        acc += 100;
    }
done:
  return acc;
}
int main()
{
  for (int n = 0; n < 7; ++n)
    println(n, " ", run(n));
  println(run(8), " ", run(9));
  try { run(7); }
  catch (int e) { println("caught ", e); }
  return 0;
}
