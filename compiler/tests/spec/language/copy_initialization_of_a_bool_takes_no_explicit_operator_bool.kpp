// spec: a class converting to bool by an operator bool that converts only where C++ takes an explicit one (unmarked: explicit by default) and by an implicit operator int: a copy-initialization of a bool (`bool b = f;`, an argument, a return, an assignment, a branch of `?:` beside a bool) takes the operator int, whose 5 converts to true; a condition (`if`, `while`, `!`, `&&`, `||`, `?:`) and a direct-initialization (`bool b(f)`, `bool b{f}`, `bool(f)`, `static_cast<bool>(f)`) take the operator bool ([over.match.copy] 1.2, [over.match.conv] 1.1, [conv] 4); a constant evaluation the same (`bool b{f}` in a constexpr function); beside a conversion template the same: a copy takes the template's bool, a condition the operator bool, which [over.match.best] 2.4 prefers where both are candidates; clang's output (until 2026-11-08 kpp took the operator bool everywhere, `0 0 0 0` on the first line, and Pointer's conversions were codegen's "a conversion from Pointer to bool")
struct Flag
{
  constexpr operator bool() const { return false; }
  constexpr implicit operator int() const { return 5; }
};
bool take(bool b) { return b; }
bool give(const Flag& f) { return f; }
struct Pointer
{
  operator bool() const { return false; }
  template<typename T>
  implicit operator T() const { return T(1); }
};
bool takePointer(bool b) { return b; }
bool givePointer(const Pointer& p) { return p; }
constexpr bool listedEarly()
{
  Flag f;
  bool b{f};
  return b;
}
constexpr bool copiedEarly()
{
  Flag f;
  bool b = f;
  return b;
}
int main()
{
  Flag f;
  bool copied = f;
  bool assigned = false;
  assigned = f;
  println(copied ? 1 : 0, " ", take(f) ? 1 : 0, " ", give(f) ? 1 : 0, " ", assigned ? 1 : 0);
  bool direct(f);
  bool listed{f};
  println(direct ? 1 : 0, " ", listed ? 1 : 0, " ", bool(f) ? 1 : 0, " ", static_cast<bool>(f) ? 1 : 0);
  int on = 0;
  if (f)
    on = 1;
  int loops = 0;
  while (f && loops < 3)
    ++loops;
  println(on, " ", loops, " ", !f ? 1 : 0, " ", f || false ? 1 : 0, " ", f ? 1 : 0);
  Pointer p;
  bool pointerCopied = p;
  println(pointerCopied ? 1 : 0, " ", takePointer(p) ? 1 : 0, " ", givePointer(p) ? 1 : 0);
  bool pointerDirect(p);
  bool pointerListed{p};
  int pointerOn = 0;
  if (p)
    pointerOn = 1;
  println(pointerDirect ? 1 : 0, " ", pointerListed ? 1 : 0, " ", pointerOn, " ", !p ? 1 : 0, " ", p && true ? 1 : 0, " ", p ? 1 : 0);
  println((on == 0 ? f : false) ? 1 : 0, " ", (on == 0 ? p : false) ? 1 : 0);
  constexpr bool listedConstant = listedEarly();
  constexpr bool copiedConstant = copiedEarly();
  println(listedConstant ? 1 : 0, " ", copiedConstant ? 1 : 0);
  return 0;
}
