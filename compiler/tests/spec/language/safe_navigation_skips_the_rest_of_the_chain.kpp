// spec: what follows a `?->` in the postfix chain runs only when it was set: members, calls, subscripts and their arguments (`a?->b->c`, `a?->f(g())`, `a?->items[i()]`); parentheses end the chain
class Inner
{
public:
  int v = 4;
};
class Outer
{
public:
  Inner* inner = nullptr;
  int items[2] = {5, 6};
  int add(int x) { return x + 1; }
  Outer* self() { return this; }
};
int argument()
{
  println("argument");
  return 2;
}
int index()
{
  println("index");
  return 1;
}
int main()
{
  Inner in;
  Outer o;
  o.inner = &in;
  Outer* none = nullptr;
  Outer* set = &o;
  println(none?->inner->v, " ", set?->inner->v);
  println(none?->add(argument()), " ", set?->add(argument()));
  println(none?->items[index()], " ", set?->items[index()]);
  println(none?->self()->self()->add(1), " ", set?->self()->self()->add(1));
  return 0;
}
