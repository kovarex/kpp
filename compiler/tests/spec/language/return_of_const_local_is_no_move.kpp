// spec: `return t;` of a const local (or one converted to the result's class) never moves from it: the implicit move's `const T&&` binds the copy constructor ([class.copy.elision]/3), whether or not the copy is elided (NRVO, which C++ leaves to the compiler; kpp elides `same`'s, design.md 23, and copies `converted`'s); the moves counted are 0 either way (clang 19 prints `0 0 7`)
// factorio: InputActionList::tryDemangleName's `const String normal = name; ... return normal;`, WireAddedUndoAction::getWire's `const Wire wire(...)` returned as an Optional<Wire>: moved from (found by the templates thread comparing object lifetimes against clang 19)
int moves = 0;
struct Tracked
{
  int value = 7;
  Tracked() {}
  Tracked(const Tracked& o) : value(o.value) {}
  Tracked(Tracked&& o) : value(o.value) { o.value = -1; ++moves; }
};
struct Wrapper
{
  Tracked held;
  implicit Wrapper(const Tracked& t) : held(t) {}
  implicit Wrapper(Tracked&& t) : held(static_cast<Tracked&&>(t)) {}
};
Tracked same()
{
  const Tracked t;
  return t;
}
Wrapper converted()
{
  const Tracked t;
  return t;
}
int main()
{
  Tracked a = same();
  int afterSame = moves;
  Wrapper w = converted();
  println(afterSame, " ", moves, " ", w.held.value);
  return 0;
}
