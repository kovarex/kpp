// spec: exceptions: throw, catch by reference and base, rethrow, cleanup of locals
// factorio: 3118 throw sites in 853 files, 457 try blocks
struct Note { const char* text; Note(const char* t) : text(t) {} ~Note() { std::println("~", std::StringView(this.text)); } };
class Failure : public std::Exception { public: int code; Failure(int code) : Exception(std::String("failed")), code(code) {} };
int risky(int n)
{
  Note note("local");
  if (n > 2)
    throw Failure(n);
  return n;
}
int main()
{
  try
  {
    risky(1);
    risky(3);
    std::println("not reached");
  }
  catch (const std::Exception& e)
  {
    std::println("caught ", std::StringView(e.what()));
  }
  try
  {
    try { throw std::RuntimeError(std::String("inner")); }
    catch (const std::RuntimeError&) { std::println("rethrowing"); throw; }
  }
  catch (const std::Exception& e) { std::println("outer ", std::StringView(e.what())); }
  return 0;
}
