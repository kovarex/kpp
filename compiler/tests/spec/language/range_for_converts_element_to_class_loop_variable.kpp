// spec: a range-for's loop variable of a class type is initialized from each element by conversion, as a declaration with that initializer would be: `for (String name : {"stone-wall", "transport-belt"})`, over a Vector<const char*>, and a `const String&` bound to the converted temporary
// factorio: the tests' `for (std::string blockingEntity : {"stone-wall", "transport-belt"})` (TestDragBuilding), `for (std::string entityName : {"assembling-machine-3", ...})` (TestInventory) and the like: each name came out empty, "Unknown entity name: " and "Unknown item name: " (13 failed checks)
int main()
{
  std::String joined;
  for (std::String name : {"stone-wall", "transport-belt"})
    joined << name + ";";
  std::Vector<const char*> list = {"a", "bb"};
  for (std::String name : list)
    joined << name + ";";
  for (const std::String& name : {"ref"})
    joined << name;
  std::println(joined);
  return 0;
}
