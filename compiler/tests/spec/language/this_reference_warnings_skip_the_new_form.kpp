// spec: --this-reference-warnings says nothing of a `this.x` already written the new way (by required `this.`'s fix, or an earlier pass of these): a fix of it, `&this.x`, would be wrong; without --this-reference the old meaning's `this.x` stays codegen's error
// kpp: --this-reference-warnings
// error: this_reference_warnings_skip_the_new_form.kpp:12: error:
// no-warning: this_reference_warnings_skip_the_new_form.kpp:12: warning
// no-warning: this_reference_warnings_skip_the_new_form.kpp:13: warning
// warning: this_reference_warnings_skip_the_new_form.kpp:14: warning: this is a reference: write `this.`, not `this->`
class Node
{
public:
  int value = 1;
  int twice() const { return 2; }
  int get() const { return this.value; }
  int call() const { return this.twice(); }
  int old() const { return this->value; }
};
int main()
{
  Node n;
  return n.get();
}
