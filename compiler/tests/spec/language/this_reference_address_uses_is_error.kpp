extern "C" import "stdio.h";
class Base
{
public:
  int b = 3;
  virtual ~Base() {}
};
void take(const Base* p) {}
class Node : public Base
{
public:
  int x = 5;
  Node* returned() { return this; }
  void stored() { Node* p = this; (void)p; }
  void passed() const { take(this); }
  void printed() const { printf("%p\n", this); }
  const Base* cast() const { return static_cast<const Base*>(this); }
  void* plainCast() { return (void*)this; }
  bool compared(const Node& o) const { return this == &o; }
  bool ordered(const Node* o) const { return this < o; }
  void assigned(Node*& owner) { owner = this; }
  void destroyed() { delete this; }
  void replaced() { new (this) Node(); }
  const Node* constCast() const { return const_cast<const Node*>(this); }
  Base* dynamic() { return dynamic_cast<Base*>(this); }
  Node& object() { return this; }
  bool address(const Node& o) const { return &this == &o; }
};
template<class T> class Box
{
public:
  T value{};
  Box* self() { return this; }
  void show() const { printf("%p\n", this); }
};
int main()
{
  Node n;
  Box<int> b;
  b.self();
  b.show();
  return n.x;
}
