// spec: another lambda's closure is never passed for a closure parameter, bound by a reference to a closure nor returned as one, which C++ rejects (each lambda's closure is a type of its own, with no conversion to another's): `take(l2)` with `take(decltype(l1))` (an lvalue and a temporary) or `takeReference(const decltype(l1)&)`, `const decltype(l1)& r = l2;`, `return l2;` from a function returning `const decltype(l1)&`, and a `const decltype(l1)&` member given l2 (by a brace list and by a constructor) are errors. kpp passed, bound or returned l2's closure as l1's, so l1's body ran: 1 where l2's gives 12. Each is the checker's error (since 2026-11-08, B's note for D), codegen's refusal (Emitter::requireSameClosure) behind it
// error: closure_of_another_lambda_as_parameter_or_reference_is_error.kpp:17: error: a closure initialised from another lambda's closure
// error: closure_of_another_lambda_as_parameter_or_reference_is_error.kpp:18: error: a closure initialised from another lambda's closure
// error: closure_of_another_lambda_as_parameter_or_reference_is_error.kpp:19: error: a reference to a closure bound to another lambda's closure
// error: closure_of_another_lambda_as_parameter_or_reference_is_error.kpp:20: error: a reference to a closure bound to another lambda's closure
// error: closure_of_another_lambda_as_parameter_or_reference_is_error.kpp:14: error: a reference to a closure bound to another lambda's closure
// error: closure_of_another_lambda_as_parameter_or_reference_is_error.kpp:21: error: a reference to a closure bound to another lambda's closure
// error: closure_of_another_lambda_as_parameter_or_reference_is_error.kpp:16: error: a reference to a closure bound to another lambda's closure
extern "C" int printf(const char* format, ...);
auto l1 = []() { return 1; };
auto l2 = []() { return 12; };
int take(decltype(l1) f) { return f(); }
int takeReference(const decltype(l1)& f) { return f(); }
const decltype(l1)& returned() { return l2; }
struct Holder { const decltype(l1)& f; };
struct Built { const decltype(l1)& f; Built() : f(l2) {} };
int byValue() { return take(l2); }
int byValueTemporary() { return take([]() { return 13; }); }
int byReferenceParameter() { return takeReference(l2); }
int byReferenceVariable() { const decltype(l1)& r = l2; return r(); }
int byMember() { Holder h{l2}; return h.f(); }
int main(int argc, char** argv)
{
  Built b;
  printf("%d %d %d %d %d %d %d\n", byValue(), byValueTemporary(), byReferenceParameter(), byReferenceVariable(), returned()(), byMember(), b.f());
  return 0;
}
