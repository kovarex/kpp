// spec: a namespace-scope object constructed with parenthesized arguments whose first is a name and a later one a brace list (`Adder added(currentSuite, { "vanilla" });`): a brace list is no parameter, so the declaration is an object, as in C++ (since design.md 22 (2026-11-04) such an object at namespace scope is written with braces, as here: there `T x(...)` declares a function)
// factorio: UnitTest++'s `#define SUITE_MODPACKS(...) UnitTest::SuiteModpackAdder environmentsAdded(currentSuite, { __VA_ARGS__ })`, used by the tests' TestSuiteModpacks, TestVanilla, TestVanillaRocketSilo and TestVanillaTechnology (the modpacks a suite runs in)
namespace UnitTest
{
  struct SuiteModpackAdder
  {
    int total = 0;
    SuiteModpackAdder(int suite, std::InitializerList<const char*> modpacks) { this.total = suite + int(modpacks.size()); }
  };
}
namespace SuiteVanilla
{
  int currentSuite = 40;
}
namespace SuiteVanilla
{
  UnitTest::SuiteModpackAdder environmentsAdded{currentSuite, { "vanilla", "space-age" }}; // (braces at namespace scope: design.md 22)
}
int main()
{
  std::println(SuiteVanilla::environmentsAdded.total);
  return 0;
}
