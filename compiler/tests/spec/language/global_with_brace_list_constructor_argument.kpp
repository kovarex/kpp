// spec: a namespace-scope object constructed with parenthesized arguments whose first is a name and a later one a brace list (`Adder added(currentSuite, { "vanilla" });`): a brace list is no parameter, so the declaration is an object, as in C++
// factorio: UnitTest++'s `#define SUITE_MODPACKS(...) UnitTest::SuiteModpackAdder environmentsAdded(currentSuite, { __VA_ARGS__ })`, used by the tests' TestSuiteModpacks, TestVanilla, TestVanillaRocketSilo and TestVanillaTechnology (the modpacks a suite runs in)
namespace UnitTest
{
  struct SuiteModpackAdder
  {
    int total = 0;
    SuiteModpackAdder(int suite, InitializerList<const char*> modpacks) { this->total = suite + int(modpacks.size()); }
  };
}
namespace SuiteVanilla
{
  int currentSuite = 40;
}
namespace SuiteVanilla
{
  UnitTest::SuiteModpackAdder environmentsAdded(currentSuite, { "vanilla", "space-age" });
}
int main()
{
  println(SuiteVanilla::environmentsAdded.total);
  return 0;
}
