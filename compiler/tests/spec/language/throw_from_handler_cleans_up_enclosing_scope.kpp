// spec: exceptions: an exception thrown inside a handler, out of a scope with locals to destroy, destroys the locals around the try too
// factorio: ExportResultGui::loadAndAttachInternal (a handler's calls in a scope of their own, a FloatingGuiWindow local around the try)
// kpp: --debug-info
// (LLVM's verifier rejects a handler's cleanup that unwinds elsewhere than its catchswitch only in a module with debug info.)
struct Note { const char* text; Note(const char* t) : text(t) {} ~Note() { std::println("~", std::StringView(this.text)); } };
void fail(const char* what) { throw std::RuntimeError(std::String(what)); }
void handle()
{
  Note outer("outer");
  try
  {
    fail("first");
  }
  catch (const std::RuntimeError& e)
  {
    Note inner("inner");
    std::println("caught ", std::StringView(e.what()));
    fail("second");
  }
  std::println("not reached");
}
void nested()
{
  try
  {
    Note middle("middle");
    try
    {
      fail("third");
    }
    catch (const std::RuntimeError&)
    {
      Note inner("inner2");
      fail("fourth");
    }
  }
  catch (const std::RuntimeError& e)
  {
    std::println("nested caught ", std::StringView(e.what()));
  }
}
int main()
{
  try
  {
    handle();
  }
  catch (const std::Exception& e)
  {
    std::println("main caught ", std::StringView(e.what()));
  }
  nested();
  return 0;
}
