// spec: a u8 string literal in a constant evaluation is the array of its UTF-8 code units, char8_t's (`u8"ab"[1]`, a hash of `u8"UE::IoStore" u8"Unknown"` as Unreal's UnifiedError computes one at compile time): `98 11 18`
// found by thread UE (2026-11-21): the evaluator read the u8 prefix as part of the text and the literal was no constant (84 errors in Unreal's IoStatusError.h)
constexpr int length(const char8_t* s) { int n = 0; while (s[n]) ++n; return n; }
static_assert(u8"ab"[1] == 98);
static_assert(length(u8"UE::IoStore") == 11);

int main()
{
  constexpr int b = u8"ab"[1];
  constexpr int n = length(u8"UE::IoStore");
  constexpr int m = length(u8"UE::IoStore" u8"Unknown");
  std::println(b, " ", n, " ", m);
  return 0;
}
