int take(const Tracked& a, const Tracked& b, int value)
{
  if (value == throwAt)
    throw value;
  return a.id + b.id + value;
}
bool seen(const Tracked& t) { return t.id > 0; }
// Fifteen locals and two temporaries of the statement: seventeen objects alive at the call that throws.
int temporaries()
{
  Tracked b1(1);
  Tracked b2(2);
  Tracked b3(3);
  Tracked b4(4);
  Tracked b5(5);
  Tracked b6(6);
  Tracked b7(7);
  Tracked b8(8);
  Tracked b9(9);
  Tracked b10(10);
  Tracked b11(11);
  Tracked b12(12);
  Tracked b13(13);
  Tracked b14(14);
  Tracked b15(15);
  return take(Tracked(101), Tracked(102), 300);
}
// Seven locals and a temporary that is built only when `build` is set: eight objects in the chain either way.
int whenBuilt(bool build)
{
  Tracked c1(1);
  Tracked c2(2);
  Tracked c3(3);
  Tracked c4(4);
  Tracked c5(5);
  Tracked c6(6);
  Tracked c7(7);
  bool was = build && seen(Tracked(201));
  int sum = (build && seen(Tracked(202)) ? 1 : 0) + take(c1, c2, 400);
  return sum + (was ? 1 : 0);
}
// Ten objects outside a try block and nine inside it: the handler runs after the nine, the ten wait.
int nested()
{
  Tracked o1(1);
  Tracked o2(2);
  Tracked o3(3);
  Tracked o4(4);
  Tracked o5(5);
  Tracked o6(6);
  Tracked o7(7);
  Tracked o8(8);
  Tracked o9(9);
  Tracked o10(10);
  int inHandler = -1;
  try
  {
    Tracked i11(11);
    Tracked i12(12);
    Tracked i13(13);
    Tracked i14(14);
    Tracked i15(15);
    Tracked i16(16);
    Tracked i17(17);
    Tracked i18(18);
    Tracked i19(19);
    take(o1, o2, 500);
  }
  catch (int)
  {
    inHandler = destroyed;
  }
  return inHandler;
}
int main()
{
  int wrong = 0;
  for (int at = 1; at <= 76; ++at)
  {
    destroyed = 0;
    throwAt = at;
    try { locals(); } catch (int) {}
    if (destroyed != at - 1 || !descending(0, at - 1, 1))
    {
      printf("locals, throw at %d: %d destroyed\n", at, destroyed);
      ++wrong;
    }
  }
  printf("locals: %d wrong\n", wrong);
  wrong = 0;
  for (int at = 1; at <= 71; ++at)
  {
    destroyed = 0;
    throwAt = at;
    try { Many many; } catch (int) {}
    if (destroyed != at - 1 || !descending(0, at - 1, 1))
    {
      printf("members, throw at %d: %d destroyed\n", at, destroyed);
      ++wrong;
    }
  }
  printf("members: %d wrong\n", wrong);
  destroyed = 0;
  throwAt = 300;
  try { temporaries(); } catch (int) {}
  // (the two temporaries first, in either order, then the locals)
  printf("temporaries: %d destroyed, the temporaries first %d, the locals in order %d\n", destroyed, order[0] + order[1] == 203 ? 1 : 0, descending(2, 15, 1) ? 1 : 0);
  destroyed = 0;
  throwAt = 400;
  try { whenBuilt(true); } catch (int) {}
  printf("conditional, built: %d destroyed, the temporaries first %d, the locals in order %d\n", destroyed, order[0] + order[1] == 403 ? 1 : 0, descending(2, 7, 1) ? 1 : 0);
  destroyed = 0;
  try { whenBuilt(false); } catch (int) {}
  printf("conditional, not built: %d destroyed, the locals in order %d\n", destroyed, descending(0, 7, 1) ? 1 : 0);
  destroyed = 0;
  throwAt = 500;
  int inHandler = nested();
  printf("nested: %d destroyed before the handler, in order %d; %d in all, in order %d\n", inHandler, descending(0, 19, 11) ? 1 : 0, destroyed, descending(9, 10, 1) ? 1 : 0);
  return 0;
}
