// spec: when an exception leaves a function, a constructor or a try block with many objects alive, each of them is destroyed exactly once, the last built first, whatever their number: 75 locals with the throw at each place among them, 70 members with the throw at each place among them and in the body, temporaries of the statement before the locals, a temporary that was not built left alone, and a try block's objects before its handler while the ones outside wait for the function's end
// on Windows a cleanup pad destroys the outermost objects of a chain 64 or 8 at a time (Emitter::cleanupChain, 2026-11-25: a scope table has an entry for each invoke and each pad on its way out, so a pad per object made the tables grow with the square of the objects alive); the counts here cross those sizes, and a pad of eight holds the temporary that may not be built
extern "C" import "stdio.h";
int order[512];
int destroyed = 0;
int throwAt = 0;
struct Tracked
{
  int id;
  Tracked(int i) : id(i)
  {
    if (i == throwAt)
      throw i;
  }
  ~Tracked()
  {
    order[destroyed] = this.id;
    ++destroyed;
  }
};
// The ids from `first` down to `last` were destroyed in that order, after `skip` others.
bool descending(int skip, int first, int last)
{
  for (int id = first; id >= last; --id)
    if (order[skip + first - id] != id)
      return false;
  return true;
}
void locals()
{
  Tracked a1(1);
  Tracked a2(2);
  Tracked a3(3);
  Tracked a4(4);
  Tracked a5(5);
  Tracked a6(6);
  Tracked a7(7);
  Tracked a8(8);
  Tracked a9(9);
