  if (isSame<long, long long>) println("long = long long");
  if (isSame<long, unsigned long>) println("long = unsigned long");
  if (isSame<long, unsigned long long>) println("long = unsigned long long");
  if (isSame<long, int8_t>) println("long = int8_t");
