// spec: the integer types are C++'s: char, signed char and unsigned char are three types (int8_t and __int8 are signed char and char, uint8_t unsigned char), int, long and long long are three (long a type of its own, 32 bits on Windows, as wide as C's long on the target), so overloads, template arguments and isSame tell them apart; literals take long from an L suffix ([lex.icon]); a short or a char promotes to int, never to long; the usual arithmetic conversions rank long between int and long long (1u + 1L is unsigned long on LLP64); the expected output is clang's and MSVC's for the same program in C++
// factorio: kovarex 2026-11-01, "Distinct fixed types, deprecate long" (design.md, "Types"); found by the templates thread comparing overload choices against clang (81 differences, all of long and the char types); in the game, toStr(int8_t) (Util/ToStr.hpp's std::to_string of a signed char) took toString(char) and wrote a character where C++ writes the number (`text((int8_t)1)` below)
const char* kind(char) { return "char"; }
const char* kind(signed char) { return "signed char"; }
const char* kind(unsigned char) { return "unsigned char"; }
const char* kind(short) { return "short"; }
const char* kind(unsigned short) { return "unsigned short"; }
const char* kind(int) { return "int"; }
const char* kind(unsigned) { return "unsigned"; }
const char* kind(long) { return "long"; }
const char* kind(unsigned long) { return "unsigned long"; }
const char* kind(long long) { return "long long"; }
const char* kind(unsigned long long) { return "unsigned long long"; }
int widen(int) { return 1; }
int widen(long) { return 2; }
int text(char) { return 1; }
int text(int) { return 2; }
template<typename T> const char* deduced(T) { return kind(T()); }
template<typename T> struct Box { T value; };
int main()
{
  println("'a'", ": ", StringView(kind('a')));
  println("(signed char)1", ": ", StringView(kind((signed char)1)));
  println("(unsigned char)1", ": ", StringView(kind((unsigned char)1)));
  println("(int8_t)1", ": ", StringView(kind((int8_t)1)));
  println("(uint8_t)1", ": ", StringView(kind((uint8_t)1)));
  println("(__int8)1", ": ", StringView(kind((__int8)1)));
  println("(unsigned __int8)1", ": ", StringView(kind((unsigned __int8)1)));
  println("(short)1", ": ", StringView(kind((short)1)));
  println("(int16_t)1", ": ", StringView(kind((int16_t)1)));
  println("1", ": ", StringView(kind(1)));
  println("1u", ": ", StringView(kind(1u)));
  println("(int32_t)1", ": ", StringView(kind((int32_t)1)));
  println("(uint32_t)1", ": ", StringView(kind((uint32_t)1)));
  println("1L", ": ", StringView(kind(1L)));
  println("1l", ": ", StringView(kind(1l)));
  println("1UL", ": ", StringView(kind(1UL)));
  println("1LL", ": ", StringView(kind(1LL)));
  println("1ULL", ": ", StringView(kind(1ULL)));
  println("(int64_t)1", ": ", StringView(kind((int64_t)1)));
  println("(uint64_t)1", ": ", StringView(kind((uint64_t)1)));
  println("(size_t)1", ": ", StringView(kind((size_t)1)));
  println("(ptrdiff_t)1", ": ", StringView(kind((ptrdiff_t)1)));
  println("(__int64)1", ": ", StringView(kind((__int64)1)));
  println("2147483648", ": ", StringView(kind(2147483648)));
  println("0x80000000", ": ", StringView(kind(0x80000000)));
  println("0xFFFFFFFFL", ": ", StringView(kind(0xFFFFFFFFL)));
  println("1 + 1L", ": ", StringView(kind(1 + 1L)));
  println("1u + 1L", ": ", StringView(kind(1u + 1L)));
  println("1L + 1LL", ": ", StringView(kind(1L + 1LL)));
  println("1UL + 1LL", ": ", StringView(kind(1UL + 1LL)));
  println("1u + 1UL", ": ", StringView(kind(1u + 1UL)));
  println("(short)1 + (short)1", ": ", StringView(kind((short)1 + (short)1)));
  println("'a' + 'b'", ": ", StringView(kind('a' + 'b')));
  println("(unsigned char)1 * 2", ": ", StringView(kind((unsigned char)1 * 2)));
  println("1L << 2", ": ", StringView(kind(1L << 2)));
  println("-1L", ": ", StringView(kind(-1L)));
  println("~1UL", ": ", StringView(kind(~1UL)));
  println("true ? 1 : 1L", ": ", StringView(kind(true ? 1 : 1L)));
  println(widen((short)1), " ", widen('a'), " ", widen(1L), " ", StringView(deduced(1L)), " ", StringView(deduced((unsigned char)1)), " ", (int)sizeof(long), " ", (int)isSame<Box<int>, Box<long>>);
  println(text((int8_t)1), " ", text((uint8_t)1), " ", text('a'));
  if (isSame<char, signed char>) println("char = signed char");
  if (isSame<char, unsigned char>) println("char = unsigned char");
  if (isSame<char, short>) println("char = short");
  if (isSame<char, int>) println("char = int");
  if (isSame<char, long>) println("char = long");
  if (isSame<char, long long>) println("char = long long");
  if (isSame<char, unsigned long>) println("char = unsigned long");
  if (isSame<char, unsigned long long>) println("char = unsigned long long");
  if (isSame<char, int8_t>) println("char = int8_t");
  if (isSame<char, uint8_t>) println("char = uint8_t");
  if (isSame<char, int16_t>) println("char = int16_t");
  if (isSame<char, int32_t>) println("char = int32_t");
  if (isSame<char, uint32_t>) println("char = uint32_t");
  if (isSame<char, int64_t>) println("char = int64_t");
  if (isSame<char, uint64_t>) println("char = uint64_t");
  if (isSame<char, size_t>) println("char = size_t");
  if (isSame<char, ptrdiff_t>) println("char = ptrdiff_t");
  if (isSame<char, __int8>) println("char = __int8");
  if (isSame<char, __int64>) println("char = __int64");
  if (isSame<signed char, unsigned char>) println("signed char = unsigned char");
  if (isSame<signed char, short>) println("signed char = short");
  if (isSame<signed char, int>) println("signed char = int");
  if (isSame<signed char, long>) println("signed char = long");
  if (isSame<signed char, long long>) println("signed char = long long");
  if (isSame<signed char, unsigned long>) println("signed char = unsigned long");
  if (isSame<signed char, unsigned long long>) println("signed char = unsigned long long");
  if (isSame<signed char, int8_t>) println("signed char = int8_t");
