  if (isSame<int, long>) println("int = long");
  if (isSame<int, long long>) println("int = long long");
  if (isSame<int, unsigned long>) println("int = unsigned long");
  if (isSame<int, unsigned long long>) println("int = unsigned long long");
  if (isSame<int, int8_t>) println("int = int8_t");
