  if (isSame<unsigned char, __int8>) println("unsigned char = __int8");
  if (isSame<unsigned char, __int64>) println("unsigned char = __int64");
  if (isSame<short, int>) println("short = int");
  if (isSame<short, long>) println("short = long");
  if (isSame<short, long long>) println("short = long long");
  if (isSame<short, unsigned long>) println("short = unsigned long");
