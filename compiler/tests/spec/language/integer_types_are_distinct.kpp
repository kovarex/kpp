  if (isSame<signed char, ptrdiff_t>) println("signed char = ptrdiff_t");
  if (isSame<signed char, __int8>) println("signed char = __int8");
  if (isSame<signed char, __int64>) println("signed char = __int64");
  if (isSame<unsigned char, short>) println("unsigned char = short");
  if (isSame<unsigned char, int>) println("unsigned char = int");
  if (isSame<unsigned char, long>) println("unsigned char = long");
  if (isSame<unsigned char, long long>) println("unsigned char = long long");
  if (isSame<unsigned char, unsigned long>) println("unsigned char = unsigned long");
  if (isSame<unsigned char, unsigned long long>) println("unsigned char = unsigned long long");
  if (isSame<unsigned char, int8_t>) println("unsigned char = int8_t");
  if (isSame<unsigned char, uint8_t>) println("unsigned char = uint8_t");
  if (isSame<unsigned char, int16_t>) println("unsigned char = int16_t");
  if (isSame<unsigned char, int32_t>) println("unsigned char = int32_t");
  if (isSame<unsigned char, uint32_t>) println("unsigned char = uint32_t");
  if (isSame<unsigned char, int64_t>) println("unsigned char = int64_t");
  if (isSame<unsigned char, uint64_t>) println("unsigned char = uint64_t");
  if (isSame<unsigned char, size_t>) println("unsigned char = size_t");
