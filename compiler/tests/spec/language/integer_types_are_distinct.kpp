  if (isSame<int, int16_t>) println("int = int16_t");
  if (isSame<int, int32_t>) println("int = int32_t");
  if (isSame<int, uint32_t>) println("int = uint32_t");
  if (isSame<int, int64_t>) println("int = int64_t");
