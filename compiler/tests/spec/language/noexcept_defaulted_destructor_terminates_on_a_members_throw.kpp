// spec: a defaulted noexcept destructor, which has no body of its own, ends the program when a member's throws, also where a class holding it destroys it
void onTerminate()
{
  println("terminate");
  fflush(nullptr);
  exit(0);
}
struct T { ~T() noexcept(false) { println("member"); throw 1; } };
struct S { T t; ~S() noexcept = default; };
struct H { S s; int x = 3; };
void scope() { H h; }
int main()
{
  setTerminate(onTerminate);
  try
  {
    scope();
  }
  catch (int)
  {
    println("caught past the destructor");
  }
  return 0;
}
