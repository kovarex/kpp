// spec: a function's name passed to a pointer to function picks, from its overload set, the function whose type the target needs, a function template among them or not ([over.over]): here the plain function, whose type the pointer names (`5`)
// pending: codegen does not support taking the address of a function template without all its arguments: the template is taken for the address. Found with the library's sample(first, last, out, n, g) beside the imgui smoke test's own `static float sample(void*, int)` (K, 2026-11-07); D
template<typename InIt, typename OutIt, typename G>
OutIt pick([[maybe_unused]] InIt first, [[maybe_unused]] InIt last, OutIt out, [[maybe_unused]] i64 n, [[maybe_unused]] G&& g) { return out; }

static float pick(void* data, int index) { return ((float*)data)[index] * 2.0f; }

float call(float (*f)(void*, int), void* data) { return f(data, 1); }

int main()
{
  float values[2] = {1.0f, 2.5f};
  std::println(call(pick, values));
  return 0;
}
