// spec: a signed overflow or a division by zero in a constant the program needs is a compile error with its reason, as in C++ (unsigned arithmetic wraps and is no error)
// error: consteval_signed_overflow.kpp:6: error: static assertion whose condition is no constant: signed overflow in int32 (addition)
// error: consteval_signed_overflow.kpp:7: error: static assertion whose condition is no constant: a division by zero
constexpr int big = 2147483647;
constexpr unsigned ubig = 4294967295u;
static_assert(big + 1 > 0);
static_assert(10 / (big - big) == 0);
static_assert(ubig + 1u == 0u);
int main()
{
  return 0;
}
