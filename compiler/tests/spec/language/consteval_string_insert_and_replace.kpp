// spec: at compile time a String's insert and replace run as at run time: inserting another string's text, inserting part of the string into itself, and replace (erase, then insert) give the run-time results. Its aliasing test orders pointers into different objects, which constant evaluation refuses (as clang does), so a compile-time insert copies the text first (`aXYb aaabbc a--d / 4 6 4`)
extern "C" int printf(const char* format, ...);
consteval int inserted()
{
  String s("ab");
  String t("XY");
  s.insert(1, t);
  return s == "aXYb" ? int(s.size()) : -1;
}
consteval int insertedIntoItself()
{
  String s("abc");
  s.insert(1, s.data(), 2);
  s.insert(0, "a");
  return s == "aaabbc" ? int(s.size()) : -1;
}
consteval int replaced()
{
  String s("abcd");
  s.replace(1, 2, "--");
  return s == "a--d" ? int(s.size()) : -1;
}
static_assert(inserted() == 4);
static_assert(insertedIntoItself() == 6);
static_assert(replaced() == 4);
int main()
{
  String a("ab");
  a.insert(1, String("XY"));
  String b("abc");
  b.insert(1, b.data(), 2);
  b.insert(0, "a");
  String c("abcd");
  c.replace(1, 2, "--");
  printf("%s %s %s / %d %d %d\n", a.c_str(), b.c_str(), c.c_str(), inserted(), insertedIntoItself(), replaced());
  return 0;
}
