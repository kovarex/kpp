// spec: an enum whose enumerators each double the one before (31 of them, C's flag pattern) is evaluated in steps proportional to its enumerators: its last one, and another enumerator of the enum used as an array's bound, are constants
// factorio: trio (converted as C): trio.c's anonymous enum, FLAGS_SPACE = 2 * FLAGS_STICKY ... FLAGS_FIXED_SIZE (28 of them), then MAX_PARAMETERS = 64, the bound of its arrays
// pending: "the bound of the array table is no constant: an evaluation of more than a million steps" (D)
enum
{
  F0 = 1,
  F1 = 2 * F0,
  F2 = 2 * F1,
  F3 = 2 * F2,
  F4 = 2 * F3,
  F5 = 2 * F4,
  F6 = 2 * F5,
  F7 = 2 * F6,
  F8 = 2 * F7,
  F9 = 2 * F8,
  F10 = 2 * F9,
  F11 = 2 * F10,
  F12 = 2 * F11,
  F13 = 2 * F12,
  F14 = 2 * F13,
  F15 = 2 * F14,
  F16 = 2 * F15,
  F17 = 2 * F16,
  F18 = 2 * F17,
  F19 = 2 * F18,
  F20 = 2 * F19,
  F21 = 2 * F20,
  F22 = 2 * F21,
  F23 = 2 * F22,
  F24 = 2 * F23,
  F25 = 2 * F24,
  F26 = 2 * F25,
  F27 = 2 * F26,
  F28 = 2 * F27,
  F29 = 2 * F28,
  F30 = 2 * F29,
  LIMIT = 64
};

int main()
{
  int table[LIMIT];
  table[0] = 7;
  println("{} {} {}", (int)F20, (int)F30, table[0] + (int)LIMIT);
  return 0;
}
