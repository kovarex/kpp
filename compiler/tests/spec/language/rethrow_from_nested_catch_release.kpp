// spec: a rethrow from a nested try's handler reaches the enclosing try's handler, in a release build too
// kppc: --release
int main()
{
  try
  {
    try { throw RuntimeError(String("inner")); }
    catch (const RuntimeError&) { println("rethrowing"); throw; }
  }
  catch (const Exception& e) { println("outer {}", e.what()); }
  return 0;
}
