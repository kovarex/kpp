// spec: a rethrow from a nested try's handler reaches the enclosing try's handler, in a release build too
// kpp: --release
int main()
{
  try
  {
    try { throw std::RuntimeError(std::String("inner")); }
    catch (const std::RuntimeError&) { std::println("rethrowing"); throw; }
  }
  catch (const std::Exception& e) { std::println("outer ", std::StringView(e.what())); }
  return 0;
}
