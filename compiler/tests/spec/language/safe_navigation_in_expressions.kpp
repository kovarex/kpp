// spec: `?->` and `?:` in conditions, operands, arguments, an initializer's capture, a loop, a template's body (a void result too), sizeof, and constants; a static member and an enumerator's result, Optionals of them; `auto` takes the Optional; a temporary to the end of the full expression
// checked by hand against the rule (design.md 23a); clang has no `?->`
class Leaf
{
public:
  int value = 7;
  int items[3] = {1, 2, 3};
  static constexpr int fixed = 11;
  enum class Kind { Small, Big };
  Kind kind = Kind::Big;
  bool ok() const { return this.value > 0; }
  int add(int x) const { return this.value + x; }
  const int& ref() const { return this.value; }
  Leaf* me() { return &this; }
};
class Tag
{
public:
  int id = 1;
  ~Tag() { std::println("tag gone"); }
  Tag& self() { return this; }
  int get() { return this.id; }
};
Tag makeTag() { return Tag(); }
template<class T> auto call(T* p) { return p?->ok(); }
template<class T> void poke(T* p) { p?->me(); }
template<class T> T pick(T a, T b) { return a ?: b; }
constexpr int choose(int a) { return a ?: 3; }
static_assert(choose(0) == 3);
static_assert(choose(4) == 4);
int main()
{
  Leaf leaf;
  Leaf* set = &leaf;
  Leaf* none = nullptr;
  Leaf*& alias = set;
  if (set?->ok())
    std::println("ok");
  if (!none?->ok())
    std::println("not ok");
  std::println(alias?->value ?: 0);
  std::println(none?->fixed ?: 0, " ", set?->fixed ?: 0);
  std::println((none?->kind ?: Leaf::Kind::Small) == Leaf::Kind::Small, " ", (set?->kind ?: Leaf::Kind::Small) == Leaf::Kind::Big);
  std::println(none?->items == nullptr, " ", set?->items != nullptr);
  auto copy = set?->value;
  copy = 9;
  std::println(*copy, " ", leaf.value);
  std::println(sizeof(set?->value), " ", sizeof(set?->kind));
  int fromRef = set?->ref() ?: 0;
  std::println(fromRef);
  std::println(set?->add(none?->value ?: 0) ?: 0, " ", none?->add(set?->value ?: 0) ?: 0);
  std::println(set?->me()?->me()?->value ?: 0);
  std::println(makeTag().self().get(), " ", (&leaf)?->value ?: 0);
  std::println(call(set), " ", call(none));
  poke(none);
  std::println(pick(0, 4), " ", pick(5, 4));
  std::println(choose(0), " ", choose(4));
  auto f = [p = set]() { return p?->value; };
  std::println(f() ?: 0);
  int total = 0;
  for (Leaf* p : {set, none, set})
    total += p?->value ?: 100;
  std::println(total);
  std::println((set?->value ?: 0) + (none?->value ?: 0) * 2);
  bool both = set?->ok() && none?->ok();
  std::println(both);
  int picked = set ? set?->value ?: 0 : 0;
  std::println(picked);
  return 0;
}
