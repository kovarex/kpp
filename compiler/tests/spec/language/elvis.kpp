// spec: `a ?: b` is `a ? a : b` with a evaluated once, an lvalue when both are, of a class by its bool conversion; `c ?::x : y` stays a conditional; clang's output
int calls = 0;
int counted(int v) { ++calls; return v; }
int fallback() { std::println("fallback"); return 9; }
namespace n { int x = 3; }
struct B { int v; operator bool() const { return this.v != 0; } };
B make(int v) { ++calls; return B{v}; }
int main()
{
  int zero = 0;
  int five = 5;
  std::println(zero ?: 2, " ", five ?: 2, " ", zero ?: five ?: 7);
  std::println(counted(4) ?: 1, " ", calls);
  std::println(counted(0) ?: 1, " ", calls);
  std::println(five ?: fallback());
  std::println(zero ?: fallback());
  int* none = nullptr;
  int* some = &five;
  std::println(*(none ?: some), " ", (some ?: nullptr) == some);
  (zero ?: five) = 6;
  std::println(five);
  (five ?: zero) = 8;
  std::println(five);
  double d = zero ?: 2.5;
  std::println(d);
  bool yes = true;
  std::println(yes ?::n::x : 4);
  std::println((make(0) ?: make(2)).v, " ", (make(3) ?: make(4)).v, " ", calls);
  B a{0};
  B b{7};
  std::println((a ?: b).v);
  (a ?: b).v = 8;
  std::println(b.v);
  const char* s = nullptr;
  std::println((s ?: "text")[1]);
  return 0;
}
