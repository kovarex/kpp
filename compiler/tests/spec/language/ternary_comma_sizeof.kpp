// spec: conditional operator with objects, comma operator, sizeof of expressions
struct Named { std::String name; Named(const char* n) : name(n) {} };
int main()
{
  Named a("a"), b("b");
  bool pick = true;
  const Named& chosen = pick ? a : b;
  int i = 0, j = 0;
  for (; i < 3; ++i, j += 2) {}
  std::println(chosen.name, " ", i, " ", j, " ", (int)sizeof(a.name) == (int)sizeof(std::String));
  return 0;
}
