// spec: a conditional whose branches are prvalues of the variable's class initializes the variable directly ([expr.cond]/7, [dcl.init]/17.6.1: guaranteed copy elision), no temporary moved from; clang 19 prints `T1`, `~T1`, `0`
// factorio: found by the templates thread comparing object lifetimes against clang 19 (an extra move constructor call and destructor, observable where they have effects)
int moves = 0;
struct T
{
  int id;
  T(int v) : id(v) { std::println("T", this.id); }
  T(const T& o) : id(o.id * 10) { std::println("T", this.id, " copy"); }
  T(T&& o) : id(o.id * 100) { ++moves; std::println("T", this.id, " move"); }
  ~T() { std::println("~T", this.id); }
};
int main()
{
  bool c = true;
  {
    T a = c ? T(1) : T(2);
  }
  std::println(moves);
  return 0;
}
