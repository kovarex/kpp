// spec: a member function that returns the reference a free function got from Deque::emplace_back, with a member function called on it in the same expression (p.use("a").config("x")), works at compile time as at run time (`1 1`)
// factorio: build.kpp (design.md 12): projectlib's project.use("zlib").config("debug", true), a library option
extern "C" import "stdio.h";
struct Dep
{
  std::String name;
  std::Vector<std::String> configs;
  Dep& config(std::StringView n)
  {
    std::String s = n;
    this.configs.push_back(s);
    return this;
  }
};
Dep& add(std::Deque<Dep>& to, std::StringView name)
{
  Dep& d = to.emplace_back();
  d.name = name;
  return d;
}
struct Uses
{
  std::Deque<Dep> uses;
  Dep& use(std::StringView name) { return add(this.uses, name); }
};
int chained()
{
  Uses p;
  p.use("a").config("x");
  return int(p.uses[0].configs.size());
}
constexpr int atCompileTime()
{
  Uses p;
  p.use("a").config("x");
  return int(p.uses[0].configs.size());
}
static_assert(atCompileTime() == 1);
int main()
{
  printf("%d %d\n", atCompileTime(), chained());
  return 0;
}
