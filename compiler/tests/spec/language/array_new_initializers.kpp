// spec: new T[n] with a list builds the first elements from it and value-initializes the rest; new T[0] and its delete[] touch nothing; the elements of a class aligned to 16 are aligned; new T[n][4]() zeroes rows; UniqueArray takes over new T[n] and destroys all of it
// found with language/array_new_and_delete (new T[n] built one element): the count stored before the elements (when T needs destroying) is what delete[] destroys
// arch: x86_64 (x86's SSE: intrin.h's __m128, which another processor's C headers refuse)
extern "C" import "intrin.h";
struct Item
{
  int value = 7;
  ~Item() { println("drop ", this.value); }
};
struct Wide
{
  __m128 v;
  int tag = 5;
  ~Wide() { println("wide ", this.tag); }
};
int main()
{
  int n = 4;
  int* partial = new int[n]{1, 2};
  println(partial[0], " ", partial[1], " ", partial[2], " ", partial[3]);
  delete[] partial;
  Item* empty = new Item[0];
  delete[] empty;
  Wide* wides = new Wide[2];
  println("aligned ", ((uintptr_t)wides % 16) == 0);
  wides[1].tag = 9;
  delete[] wides;
  auto grid = new int[n][4]();
  grid[3][2] = 42;
  println(grid[0][0], " ", grid[3][2]);
  delete[] grid;
  {
    UniqueArray<Item> owned(new Item[3]);
    owned[1].value = 11;
  }
  Item* listed = new Item[3]{Item(), Item()};
  listed[2].value = 33;
  delete[] listed;
  return 0;
}
