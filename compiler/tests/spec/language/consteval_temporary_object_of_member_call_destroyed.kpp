// spec: a temporary that is the object of a member call (`name() + "/include"`, String::operator+ on the String name() returns) or an argument written as a functional cast (`path + String(view)`) is destroyed at the end of the full-expression in a compile-time evaluation as at run time, so the String it allocated is freed; the constants equal what the program computes (`39 42`)
// factorio: build.kpp (design.md 12): `project.cInclude(project.setting("ROOT", "C:/x") + "/include")`, projectlib's `String("-l") + name`
// pending: neither temporary is destroyed: "memory allocated at String.kpp:653 is never freed"
extern "C" import "stdio.h";
String name() { return String("abcdefghijklmnopqrstuvwxyz0123456789"); }
constexpr int joined()
{
  String path = name() + "/in";
  return path.size();
}
constexpr int argument()
{
  String path = name();
  StringView tail = "/in";
  String joined = path + String(tail);
  return joined.size() + 3;
}
static_assert(joined() == 39);
static_assert(argument() == 42);
int main()
{
  printf("%d %d\n", joined(), argument());
  return 0;
}
