// spec: a type name declared nowhere is a compile error where it is written (a member, a base, a local, a sizeof), never an empty class that compiles, and the code generator's layouts that need the type add no errors of their own
// error: undeclared_type_name.kpp:8: error: 'Missing' is not declared
// error: undeclared_type_name.kpp:11: error: 'Unknown' is not declared
// error: undeclared_type_name.kpp:28: error: 'Undeclared' is not declared
// error: undeclared_type_name.kpp:33: error: 'Nowhere' is not declared
struct Settings
{
  Missing first;
  int count;
};
struct Derived : Unknown
{
  int value;
};
int settings()
{
  Settings s;
  s.count = 2;
  return s.count;
}
int derived()
{
  Derived d;
  return 1;
}
int local()
{
  Undeclared u;
  return 2;
}
size_t size()
{
  return sizeof(Nowhere);
}
int main()
{
  println("{} {} {} {}", settings(), derived(), local(), size());
  return 0;
}
