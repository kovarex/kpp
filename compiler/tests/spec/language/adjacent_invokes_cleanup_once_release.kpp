// spec: a call that throws runs only its own scope's cleanups, even when the next call's scope starts at its return address (release)
// kppc: --release
// pending: two invokes laid out back to back share an address in the __C_specific_handler scope table (the first ends at its return address + 1, the next begins there), so a throw from the first runs both entries' cleanups: `before` is destroyed twice and the temporary make() never built once; found in the release unit tests (LuaHelper::parseLocalisedString, a double free) (codegen)
struct Item
{
  int id;
  Item(int id) : id(id) {}
  Item(Item&& other) : id(other.id) { other.id = 0; }
  ~Item() { println("~Item {}", this->id); }
};
// Recursive, not in tail position, to a depth -O2 cannot know: both calls stay out of line.
Item make(int depth, bool fail)
{
  if (depth == 0)
  {
    if (fail)
      throw RuntimeError(String("no item"));
    return Item(1);
  }
  Item item = make(depth - 1, fail);
  item.id = item.id * 10 + depth;
  return item;
}
int sink(int depth, Item&& item)
{
  if (depth == 0)
    return item.id;
  int result = sink(depth - 1, ::move(item));
  println("sink {}", depth);
  return result + depth;
}
int use(int depth, bool fail)
{
  Item before(5);
  return sink(depth, make(depth, fail));
}
int main()
{
  int depth = getenv("KPP_SPEC_NEVER_SET") ? 1 : 3;
  try { println("{}", use(depth, true)); }
  catch (const Exception& e) { println("caught {}", e.what()); }
  println("{}", use(depth, false));
  return 0;
}
