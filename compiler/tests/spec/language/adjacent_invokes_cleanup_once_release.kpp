// spec: a call that throws runs only its own scope's cleanups, even when the next call's scope starts at its return address (release)
// kpp: --release
struct Item
{
  int id;
  Item(int id) : id(id) {}
  Item(Item&& other) : id(other.id) { other.id = 0; }
  ~Item() { std::println("~Item ", this.id); }
};
// Recursive, not in tail position, to a depth -O2 cannot know: both calls stay out of line.
Item make(int depth, bool fail)
{
  if (depth == 0)
  {
    if (fail)
      throw std::RuntimeError(std::String("no item"));
    return Item(1);
  }
  Item item = make(depth - 1, fail);
  item.id = item.id * 10 + depth;
  return item;
}
int sink(int depth, Item&& item)
{
  if (depth == 0)
    return item.id;
  int result = sink(depth - 1, std::move(item));
  std::println("sink ", depth);
  return result + depth;
}
int use(int depth, bool fail)
{
  Item before(5);
  return sink(depth, make(depth, fail));
}
int main()
{
  int depth = std::getenv("KPP_SPEC_NEVER_SET") ? 1 : 3;
  try { std::println(use(depth, true)); }
  catch (const std::Exception& e) { std::println("caught ", std::StringView(e.what())); }
  std::println(use(depth, false));
  return 0;
}
