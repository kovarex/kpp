// spec: kpp requires nullptr (kovarex, 2026-11-04: "writing 0 instead of nullptr is not nice"; design.md 4): a literal 0 that would be a pointer or member pointer without a cast is an error at the 0 token itself (its column with --diagnostic-columns, inside parentheses too): an initializer, a parenthesised one, a member pointer, an argument, a comparison, a template's return (once, however many instances); nullptr is none; imported C keeps C's rule
// kpp: --diagnostic-columns
// error: zero_literal_as_pointer_is_error.kpp:15:41: error: the literal 0 is no pointer: write nullptr (design.md 4)
// error: zero_literal_as_pointer_is_error.kpp:18:13: error: the literal 0 is no pointer: write nullptr (design.md 4)
// error: zero_literal_as_pointer_is_error.kpp:19:14: error: the literal 0 is no pointer: write nullptr (design.md 4)
// error: zero_literal_as_pointer_is_error.kpp:21:19: error: the literal 0 is no pointer: write nullptr (design.md 4)
// error: zero_literal_as_pointer_is_error.kpp:22:17: error: the literal 0 is no pointer: write nullptr (design.md 4)
// error: zero_literal_as_pointer_is_error.kpp:23:20: error: the literal 0 is no pointer: write nullptr (design.md 4)
struct Node
{
  int value;
  int Node::* member;
};
int count(Node* n) { return n ? n->value : -1; }
template<typename T> T* none() { return 0; }
int main()
{
  Node* a = 0;
  Node* b = (0);
  Node* c = nullptr;
  int Node::* m = 0;
  int x = count(0) + count(c);
  bool same = a == 0;
  int* p = none<int>();
  long* q = none<long>();
  std::println(x, " ", same, " ", b == nullptr, " ", m == nullptr, " ", p == nullptr, " ", q == nullptr);
  return 0;
}
