// spec: writing through a reference parameter at compile time changes the caller's object: a reference refers to its place, never to a copy
constexpr void bump(int& x)
{
  ++x;
}
constexpr int bumped()
{
  int a = 1;
  bump(a);
  bump(a);
  return a;
}
template<int N>
struct Show
{
  static constexpr int value = N;
};
static_assert(bumped() == 3);
int main()
{
  println(Show<bumped()>::value);
  return 0;
}
