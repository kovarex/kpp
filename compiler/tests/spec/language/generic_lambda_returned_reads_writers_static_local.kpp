// spec: a generic lambda a function returns names that function's static local, and the function's caller calls it first (the call operator emitted with that caller, before the function itself is): the operator reads and writes the function's one static, whichever is emitted first and whichever module each is in, and two such statics of one name are two (each its function's), in a build of 64 modules (and the release suite's) (`9011 140160`)
// factorio: none known; found fixing language/generic_lambda_reads_writers_static_local
// kpp: --modules 64
// The functions returning a generic lambda that names their own static local.
auto makeA()
{
  static int calls = 5;
  calls = calls + 1;
  return [](auto x) { calls = calls + x; return calls; };
}

auto makeB()
{
  static int calls = 100;
  calls = calls + 10;
  return [](auto x) { calls = calls + x; return calls; };
}

// Each calls the lambda its maker returns (whose operator its emission makes, before the maker's,
// which these call): twice, the maker updating its static before each.
int runA()
{
  auto g = makeA();
  int first = g(3);
  int second = makeA()(1);
  return first * 1000 + second;
}

int runB()
{
  auto g = makeB();
  int first = g(30);
  int second = makeB()(10);
  return first * 1000 + second;
}

int main()
{
  int a = runA();
  int b = runB();
  std::println(a, " ", b);
  return 0;
}
