// error: declaration_without_a_declarator_is_error.kpp:17: error: the declaration declares nothing
struct Buf { int x; };
Buf;
const Buf*;
namespace Storage
{
  Buf;
}
struct Holder
{
  int y;
  Buf;
};
struct Later;
struct Later { int z; };
