// spec: `throw;` in a function a catch handler calls raises the exception that handler holds (the exception dispatcher: `try { throw; } catch (const Error& e) ... catch (...)`)
// found in the converted game: Exceptions.kpp's `throw; // Rethrow the current exception so that we can catch it here.` and ModManager::enterMinimalMode ("`throw;` outside a catch handler")
class Error : public Exception { public: int code; Error(int c) : Exception("error"), code(c) {} };
class Other : public Exception { public: Other() : Exception("other") {} };
int classify()
{
  try
  {
    throw;
  }
  catch (const Error& e)
  {
    return e.code;
  }
  catch (...)
  {
    return -1;
  }
}
int main()
{
  int a = 0, b = 0;
  try
  {
    throw Error(7);
  }
  catch (...)
  {
    a = classify();
  }
  try
  {
    throw Other();
  }
  catch (...)
  {
    b = classify();
  }
  println("{} {}", a, b);
  return 0;
}