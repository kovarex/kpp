// spec: the reference Vector::emplace_back() returns, passed straight to a function's reference parameter, is the new element at compile time as at run time: fill(v.emplace_back()) writes into v[0] (`0 0`)
// factorio: build.kpp (design.md 12): projectlib's describe() resolved each configuration into resolved.emplace_back()
extern "C" import "stdio.h";
struct Item
{
  String name;
  Optional<bool> flag;
};
void fill(Item& item)
{
  item.flag = false;
  item.name = "x";
}
constexpr int direct()
{
  Vector<Item> v;
  fill(v.emplace_back());
  return v[0].flag.value_or(true) ? 1 : 0;
}
static_assert(direct() == 0);
constexpr int results[] = {direct()};
int main()
{
  Vector<Item> v;
  fill(v.emplace_back());
  printf("%d %d\n", results[0], v[0].flag.value_or(true) ? 1 : 0);
  return 0;
}
