// spec: exit() destroys objects of static storage and the calling thread's thread_locals first of all, never its automatic objects ([basic.start.main], [basic.start.term]); atexit's function is ordered with them. clang's and g++'s output
// pending on windows-gnu: the main thread's thread_locals go after the statics (their fiber-local slot, design.md)
extern "C" int printf(const char* format, ...);
extern "C" int atexit(void (*f)());
extern "C" void exit(int code);
struct Tr
{
  const char* n;
  Tr(const char* name) : n(name) { printf("ctor %s\n", this.n); }
  ~Tr() { printf("dtor %s\n", this.n); }
};
Tr g1{"g1"};
Tr& fnStatic() { static Tr t("fn static"); return t; }
Tr g2{"g2"};
void deep(int n)
{
  Tr local("local not destroyed by exit");
  fnStatic();
  if (n == 0)
  {
    printf("exit\n");
    exit(1);
  }
  deep(n - 1);
}
void handler() { printf("handler\n"); }
int main()
{
  atexit(handler);
  thread_local Tr perThread("thread local of main");
  printf("%s\n", perThread.n);
  deep(1);
  return 0;
}
