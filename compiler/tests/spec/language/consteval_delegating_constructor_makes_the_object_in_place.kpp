// spec: at compile time a delegating constructor makes the object where it lives, as at run time (C++ [class.base.init] 6: the target constructor initializes this object): a pointer the target constructor stores to `this` points at the local the delegating one makes, so `self == this` holds after it (`5 6`, clang's)
// pending: the evaluation makes the delegated object elsewhere: "a comparison of an object of the evaluation, whose lifetime ended". Found by K (2026-11-09): List's constructors could not delegate to List() for their exception safety, its sentinel pointing at itself (they build in a local List instead); D
extern "C" import "stdio.h";
struct Ring
{
  Ring* self;
  i32 v = 0;
  constexpr Ring() : self(this) {}
  constexpr Ring(i32 v) : Ring() { this->v = v; }
  constexpr i32 check() const { return this->self == this ? this->v : -1; }
};
constexpr i32 made()
{
  Ring r(5);
  return r.check();
}
constexpr i32 result = made();
int main()
{
  Ring r(6);
  printf("%d %d\n", result, r.check());
  return 0;
}
