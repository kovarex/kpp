// spec: `Target t = make();` where make() returns another class and Target has a converting constructor from it: the constructor runs
// factorio: SharedPtr<T> p = makeUnique<T>(...), and every copy-initialisation from a returned object of another class
struct Source { int v = 5; };
Source make() { return Source(); }
struct Target
{
  int tag = 0;
  int v = 0;
  Target() {}
  implicit Target(Source&& s) : tag(1), v(s.v) {}
};
int main()
{
  Target a = make();
  Source s;
  Target b = move(s);
  println("{} {} {} {}", a.tag, a.v, b.tag, b.v);
  return 0;
}
