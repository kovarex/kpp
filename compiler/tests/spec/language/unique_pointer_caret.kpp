// spec: `T^` is the library's UniquePtr<T> written short, sugar and not a type of its own (kovarex, 2026-11-04): a declarator beside `*` and `&` (a local, a parameter, a return type, a member, a template argument as in Vector<Item^>, a pointer to one); `const Item^` owns a const Item and `Item^ const&` is a const owner, as with `*`; it is the same type as UniquePtr<Item> (one type, one overload); `^` between two operands stays exclusive or, in a template argument too
struct Item
{
  int value;
  Item(int v) : value(v) {}
};
struct Holder
{
  Item^ item;
};
static_assert(std::isSame<Item^, std::UniquePtr<Item>>);
static_assert(std::isSame<const Item^, std::UniquePtr<const Item>>);
static_assert(std::isSame<Item^ const&, const std::UniquePtr<Item>&>);
static_assert(std::isSame<std::Vector<Item^>, std::Vector<std::UniquePtr<Item>>>);
constexpr int six = 6, three = 3;
static_assert(sizeof(std::Array<int, six ^ three>) == 5 * sizeof(int)); // (exclusive or in a template argument)
Item^ make(int v) { return std::makeUnique<Item>(v); }
int read(Item^ const& p) { return p->value; }
int readLong(const std::UniquePtr<Item>& p) { return p->value; }
int readConst(const Item^ p) { return p->value; }
int main()
{
  Item^ a = make(3);
  std::Vector<Item^> items;
  items.push_back(make(4));
  items.emplace_back(new Item(5));
  Holder h{make(6)};
  Item^* to = &a;
  const Item^ c = std::UniquePtr<const Item>(new Item(7));
  int x = 6, y = 3;
  int z = x ^ y;
  z = z ^ (x);
  std::println(read(a), " ", readLong(items[0]), " ", items[1]->value, " ", h.item->value, " ", (*to)->value, " ", c->value, " ",
          readConst(make(8)), " ", z);
  return 0;
}
