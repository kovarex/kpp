// spec: structured bindings
// factorio: 459 uses in 204 files
struct Size { int width; int height; };
std::Pair<std::String, int> entry() { return std::makePair(std::String("key"), 5); }
int main()
{
  auto [name, value] = entry();
  Size s{40, 30};
  auto& [w, h] = s;
  w += 2;
  std::println(name, " ", value, " ", s.width, " ", h);
  return 0;
}
