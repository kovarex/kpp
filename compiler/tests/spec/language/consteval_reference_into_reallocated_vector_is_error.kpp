// spec: a reference to a Vector's element that a later push_back reallocated away refers to freed storage; a write through it in a compile-time evaluation is an error (C++20: such an evaluation is no constant), never a silent write into the freed block
// factorio: build.kpp (design.md 12): projectlib's `Executable& a = project.executable(...)` held across a second executable()
// error: consteval_reference_into_reallocated_vector_is_error.kpp:18: error: static assertion whose condition is no constant
struct Entry
{
  int value = 0;
};
constexpr int stale()
{
  std::Vector<Entry> entries;
  entries.push_back(Entry{});
  Entry& first = entries.back();
  for (int i = 0; i < 8; ++i)
    entries.push_back(Entry{});
  first.value = 5;
  return entries[0].value;
}
static_assert(stale() == 0);
int main()
{
  return 0;
}
