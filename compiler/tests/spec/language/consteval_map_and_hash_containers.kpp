// spec: the library's Map (operator[], through its red-black tree's nodes and iterators) and HashMap and HashSet (their slots, raw bytes holding entries or pointers to them) work at compile time as at run time (`3 1 2`)
// factorio: build.kpp (design.md 12): a Map or a HashMap in a build description
// pending: Map::operator[] and HashMap's and HashSet's insertion are no constants yet (Map::insert and the other containers work: language/consteval_container_iterators)
extern "C" import "stdio.h";
constexpr int map() { Map<int, int> m; m[3] = 30; m[1] = 10; m[2] = 20; int t = 0; for (const auto& [k, v] : m) t = t * 10 + k; return t == 123 ? 3 : 0; }
constexpr int hashMap() { HashMap<int, int> m; m[3] = 30; return m.size(); }
constexpr int hashSet() { HashSet<int> s; s.insert(5); s.insert(2); return s.size(); }
constexpr int results[] = {map(), hashMap(), hashSet()};
int main()
{
  printf("%d %d %d\n", results[0], results[1], results[2]);
  return 0;
}
