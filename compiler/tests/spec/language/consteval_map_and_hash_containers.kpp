// spec: the library's HashMap and HashSet (their slots, raw bytes holding entries or pointers to them) work at compile time as at run time (`1 2`); Map (operator[], through its red-black tree's nodes and iterators) is language/consteval_node_containers's (pending)
// factorio: build.kpp (design.md 12): a Map or a HashMap in a build description
extern "C" import "stdio.h";
constexpr int hashMap() { HashMap<int, int> m; m[3] = 30; return m.size(); }
constexpr int hashSet() { HashSet<int> s; s.insert(5); s.insert(2); return s.size(); }
constexpr int results[] = {hashMap(), hashSet()};
int main()
{
  printf("%d %d\n", results[0], results[1]);
  return 0;
}
