// spec: a using-declaration in a block brings another namespace's type in for that block (`using Graphics::IntelGPUArchitecture;`): its name and its enumerators resolve there
// factorio: GraphicsSettings::determinePreset's `using Graphics::IntelGPUArchitecture;` before `IntelGPUArchitecture intelGPUArch = ...`
namespace Graphics
{
  enum class Architecture
  {
    Unknown = 0,
    Legacy = 1,
    SandyBridge = 0xC,
    IvyBridge
  };
  Architecture architectureOf(int id) { return id == 1 ? Architecture::IvyBridge : Architecture::Legacy; }
}

int describe(int id)
{
  using Graphics::Architecture;
  Architecture architecture = id > 0 ? Graphics::architectureOf(id) : Architecture::Unknown;
  return int(architecture);
}

int main()
{
  println(describe(0), " ", describe(1), " ", describe(2));
  return 0;
}
