// spec: after a member function took the address of a member Vector (Holder::add returns a handle holding &items), a member function called on a member of the element operator[] returns (h.items[0].names.push_back(s), s an lvalue String) works at compile time as at run time (`1 1`)
// factorio: build.kpp (design.md 12): projectlib's use(...).config(...) added a value to a Dependency in project.uses
// pending: at compile time it is "a condition the compiler cannot evaluate yet"; with the element first bound to a reference (Item& i = h.items[0]; i.names.push_back(s);) it works (D)
extern "C" import "stdio.h";
struct Item
{
  String name;
  Vector<String> names;
};
struct Handle
{
  Vector<Item>* items;
  u64 index;
};
struct Holder
{
  Vector<Item> items;
  Handle add()
  {
    Item& i = items.emplace_back();
    i.name = "a";
    return Handle{&items, items.size() - 1};
  }
};
int added()
{
  Holder h;
  h.add();
  String s("x");
  h.items[0].names.push_back(s);
  return int(h.items[0].names.size());
}
constexpr int atCompileTime()
{
  Holder h;
  h.add();
  String s("x");
  h.items[0].names.push_back(s);
  return int(h.items[0].names.size());
}
static_assert(atCompileTime() == 1);
int main()
{
  printf("%d %d\n", atCompileTime(), added());
  return 0;
}
