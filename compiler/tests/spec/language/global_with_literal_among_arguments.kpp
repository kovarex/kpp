// spec: a namespace-scope variable initialized with parentheses whose first argument is a name and a later one a literal, `Box other(HeavyMode::Disabled, 4);`, is a variable (no parameter starts with a literal), also when the first name could be a type
// factorio: the second constructor argument of MainLoop's globals; read as a function, the parse failed at the literal
enum class Mode { Off, On };
struct Box
{
  Mode mode;
  int count = 0;
  Box(Mode mode, int count) : mode(mode), count(count) {}
};
struct Grid
{
  int cells = 0;
  Grid(Mode, int cells) : cells(cells) {}
};
Box box(Mode::On, 4);
Grid grid(Mode::Off, 9);
Array<int, 2> pair;
int main()
{
  println(int(box.mode), " ", box.count, " ", grid.cells, " ", pair.size());
  return 0;
}
