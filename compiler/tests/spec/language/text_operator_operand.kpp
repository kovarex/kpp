// spec: an operator whose right operand is a Text packs that operand, so `out << a << " = " << b` appends piece by piece through one operator<<, compiled once (`(1) = red`)
extern "C" import "stdio.h";
struct Point
{
  int x = 0;
  void appendTo(std::String& out) const
  {
    out << "(";
    out << char('0' + this.x);
    out << ")";
  }
};
struct Color
{
  bool green = false;
  void appendTo(std::String& out) const { out << std::StringView(this.green ? "green" : "red"); }
};
struct Out
{
  std::String text;
};
Out& operator<<(Out& out, std::Text text)
{
  text.appendTo(out.text);
  return out;
}
int main()
{
  Out out;
  out << Point{1} << " = " << Color{false};
  printf("%s\n", out.text.c_str());
  return 0;
}
