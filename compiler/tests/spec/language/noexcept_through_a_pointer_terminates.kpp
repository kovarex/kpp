// spec: a noexcept function called through a noexcept pointer ends the program
extern "C" import "stdio.h";
extern "C" import "stdlib.h";
void onTerminate()
{
  printf("terminate\n");
  fflush(stdout);
  exit(0);
}
void thrower() noexcept { throw 1; }
struct T { void m() noexcept { throw 2; } };
int main()
{
  std::setTerminate(onTerminate);
  try
  {
    void (*p)() noexcept = thrower;
    p();
  }
  catch (...)
  {
    printf("caught\n");
  }
  return 0;
}
