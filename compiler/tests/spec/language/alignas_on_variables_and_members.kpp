// spec: alignas on a variable or a data member: a global, a static and a local start at a multiple of the alignment, and a member does within its class, whose alignment it raises; a class's raw storage `AlignedBytes<sizeof(T), alignof(T)>` for an over-aligned T has T's alignment
// factorio: Atlas.cpp's `alignas(16) uint32_t b[4]` (read with _mm_load_si128, which faults when misaligned), YCoCgDXTCompression's 15 `alignas(16) static dword SIMD_SSE2_...[4]` constants, the library's raw storage for Optional<T>
alignas(64) static unsigned short table[8] = {1, 2, 3, 4, 5, 6, 7, 8};
struct Plain
{
  alignas(8) unsigned char raw[4];
  bool flag;
};
template<size_t Size, size_t Align>
struct alignas(Align) AlignedBytes { unsigned char bytes[Size]; };
struct alignas(16) Wide { float v[4]; };
template<typename T>
struct Holder
{
  AlignedBytes<sizeof(T), alignof(T)> storage;
  bool present = false;
};
int main()
{
  char pad = 1;
  alignas(32) unsigned int local[4] = {0, 0, 0, 0};
  Holder<Wide> h;
  println(((size_t)table) % 64, " ", ((size_t)local) % 32, " ", alignof(Plain), " ", sizeof(Plain));
  println(alignof(Holder<Wide>), " ", sizeof(Holder<Wide>), " ", ((size_t)&h.storage) % 16);
  return pad - 1;
}
