// spec: a signed overflow in the initializer of a static constexpr member of a template's instance is a compile error with its reason, as in a constexpr variable outside a template (design.md: a required constant fails with its reason; C++ [expr.const]: the initializer is no constant expression)
// error: signed overflow in int64 (multiplication)
template<i64 A, i64 B>
struct Product
{
  static constexpr i64 value = A * B;
};
int main()
{
  std::println(Product<4000000000000000000ll, 3>::value);
  return 0;
}
