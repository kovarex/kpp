// spec: `new T[n]` makes n elements (a class's each by its default constructor, in order; a scalar uninitialized, zero with `new T[n]()`), `delete[] p` destroys all of them, the last first, then frees the block; delete[] of null does nothing
// factorio: 37 `new T[n]` and 10 `delete[]` (UniqueArray<T>(new T[n]) for std::unique_ptr<T[]>: Inventory's `new ItemStack[newCapacity]`, Noise, PropertyTree, ZipPackage, MemoryBitmapData; ImmutableString's `new char[len + 1]`, InfiniteVector)
struct Item
{
  int value = 7;
  Item() { println("make"); }
  ~Item() { println("drop ", this.value); }
};
int main()
{
  int n = 3;
  int* numbers = new int[n]();
  int sum = numbers[0] + numbers[1] + numbers[2];
  for (int i = 0; i < n; ++i)
    numbers[i] = i * 10;
  println(sum, " ", numbers[1], " ", numbers[2]);
  delete[] numbers;
  Item* items = new Item[n];
  items[0].value = 1;
  items[2].value = 3;
  delete[] items;
  Item* none = nullptr;
  delete[] none;
  return 0;
}
