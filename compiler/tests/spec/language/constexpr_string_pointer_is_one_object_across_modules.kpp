// spec: a constexpr pointer to a string literal has one value in the whole program: read in one module and through a pointer to the variable in another, it is the same address (the literal is one object, not a private copy per module)
// factorio: TestLatencyCarWhiteBox's `this->prototypeName == SuiteLatencyCar::TANK_WITH_GRID_NAME`, false in the debug build (the tank's grid never filled), its CRCs other than the C++ build's
// kpp: --modules 4
// (The variable is defined in every module, linkonce_odr, pointing at the literal; clang at -O0 folds
// a load of it in a function with exception handling to its own module's definition. With the literal
// a private constant of each module, that was another object than the one the kept definition names.)
struct Names
{
  static constexpr const char* TANK = "tank-with-grid";
};
const char* const* where() { return &Names::TANK; }
void mayThrow(int n)
{
  if (n > 5)
    throw n;
}
int main()
{
  const char* stored = nullptr;
  try
  {
    mayThrow(1);
    stored = Names::TANK;
  }
  catch (int)
  {
  }
  std::println(stored == *where());
  return 0;
}
