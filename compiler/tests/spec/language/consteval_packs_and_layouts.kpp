// pending: fold expressions, sizeof of a variable and type parameters as conversions were no constants, and the code generator ran no if constexpr body
struct Area { int32_t x, y, w, h; };
template<typename... Ts>
int countFundamental()
{
  static_assert((isFundamental<RemoveReference<Ts>> && ...));
  return sizeof...(Ts);
}
template<int... Ns>
struct Sum
{
  static constexpr int value = (Ns + ... + 0);
  static constexpr int leftDifference = (... - Ns);
};
template<typename U>
U twice(U limit)
{
  static_assert(U(2 * 100) != 0);
  return U(2 * limit);
}
int main()
{
  uint16_t grid[3][3] = {};
  static_assert(sizeof(grid) == 9 * 2 && sizeof(Area) == 16);
  static_assert(sizeof(Area) <= Limits<uint16_t>::max());
  println("{}", countFundamental<int, const double&, char>());
  println("{} {}", Sum<1, 2, 3, 4>::value, Sum<10, 3, 2>::leftDifference);
  println("{} {}", int(twice<uint8_t>(200)), grid[1][1]);
  return 0;
}
