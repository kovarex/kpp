// spec: a printf-like call whose format matches its arguments compiles under --format-errors: `%d %u %x %c` take an int (a char, a bool, an unscoped enum promoted), `%zu %lld %I64d` 64 bits, `%ld` 32 (LLP64), `%s` a char pointer or array, `%p` any pointer, `%f %g` a float or double, `*` an int, `%%` nothing; clang 19 prints `1 2 ff a 3 4 5 6 x y 2.50 3 7%0`
// factorio: what the game's ssprintf, Logging and C library calls pass (language/printf_format_must_match_arguments for the mismatches)
// kppc: --format-errors
extern "C" int printf(const char* format, ...);
enum Kind { First, Second };
int main()
{
  unsigned u = 2;
  size_t size = 3;
  long long big = 4;
  unsigned long long wide = 5;
  int narrow = 6;
  char name[] = "x";
  const char* text = "y";
  float half = 2.5f;
  printf("%d %u %x %c %zu %lld %I64u %ld %s %s %.2f %g %d%%%*d\n", true, u, 255, 'a', size, big, wide, narrow, name, text, half, 3.0, int(Second) + 6, 0, 0);
  return 0;
}
