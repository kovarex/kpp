// spec: a variable template whose value is floating (`Numbers::pi_v<double>`, `T(0.5)` for a float T) used at run time: the value for these arguments, of their type
// factorio: Numbers::pi_v<double> (2 headline lines)
// pending: the code generator took only integer values of a variable template
template<typename T>
constexpr T half_v = T(0.5);
template<typename T>
constexpr T three_v = T(3);
int main()
{
  double pi = Numbers::pi_v<double>;
  float half = half_v<float>;
  int three = three_v<int>;
  static_assert(half_v<double> == 0.5 && three_v<int> == 3);
  println("{} {} {}", int(pi * 1000), int(half * 10), three);
  return 0;
}
