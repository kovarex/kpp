// spec: of two conversions of a derived class (its pointer, a reference to it) to bases, the one to the nearer base is better, and one to a base better than one to void*, whatever const and volatile each target adds ([over.ics.rank] 4.4): pick(const D*) over pick(B*), pick(D&) over pick(const B&), pick(D*) over pick(const B* const&), pick(const B*) over pick(void*), and a class taken by value as one by reference: m(D&) over m(B), m(D) over m(B). clang's and g++'s output
// found by thread J's overload generator (2026-11-07): each call was ambiguous
extern "C" int printf(const char* format, ...);
class B
{
public:
  int v = 1;
};
class D : public B
{
};
class DD : public D
{
};
int p1([[maybe_unused]] const D* a) { return 1; }
int p1([[maybe_unused]] B* a) { return 2; }
int p2([[maybe_unused]] D* a) { return 1; }
int p2([[maybe_unused]] const B* a) { return 2; }
int r1([[maybe_unused]] const D& a) { return 1; }
int r1([[maybe_unused]] B& a) { return 2; }
int r2([[maybe_unused]] D& a) { return 1; }
int r2([[maybe_unused]] const B& a) { return 2; }
int p3([[maybe_unused]] D* a) { return 1; }
int p3([[maybe_unused]] const B* const& a) { return 2; }
int v1([[maybe_unused]] const volatile D* a) { return 1; }
int v1([[maybe_unused]] B* a) { return 2; }
int w1([[maybe_unused]] const B* a) { return 1; }
int w1([[maybe_unused]] void* a) { return 2; }
int w2([[maybe_unused]] B* a) { return 1; }
int w2([[maybe_unused]] const void* a) { return 2; }
int m1([[maybe_unused]] B a) { return 1; }
int m1([[maybe_unused]] D& a) { return 2; }
int m2([[maybe_unused]] D a) { return 1; }
int m2([[maybe_unused]] const B& a) { return 2; }
int m3([[maybe_unused]] B a) { return 1; }
int m3([[maybe_unused]] const D& a) { return 2; }
int m4([[maybe_unused]] D a) { return 1; }
int m4([[maybe_unused]] B& a) { return 2; }
int m5([[maybe_unused]] B a) { return 1; }
int m5([[maybe_unused]] D a) { return 2; }
int same1([[maybe_unused]] const D* a) { return 1; }
int same1([[maybe_unused]] D* a) { return 2; }
int main()
{
  DD dd;
  DD* pdd = &dd;
  D d;
  D* pd = &d;
  printf("%d %d %d %d %d %d\n", p1(pdd), p2(pdd), r1(dd), r2(dd), p3(pdd), v1(pdd));
  printf("%d %d %d\n", w1(pd), w2(pd), same1(pdd));
  printf("%d %d %d %d %d\n", m1(dd), m2(dd), m3(dd), m4(dd), m5(dd));
  return 0;
}
