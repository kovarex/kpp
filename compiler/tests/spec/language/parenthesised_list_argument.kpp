// spec: `T({...})`, a class named with one brace list in parentheses, passes the list to a constructor as its argument (`Widths({{120, 0}})` builds the Vector<Item> parameter from the list), where `T{...}` is the class's own list (`Vector<Pair<int, int>>{{1, 2}}` holds one pair)
// factorio: ModInfoPane's `this->modInfoTable.style.setColumnWidths((agui::TableStyle::Widths({{int(GuiConstants::getScaled(120)), 0}})));`
class Widths
{
public:
  struct Item { int minimalWidth = 0, maximalWidth = 0; };
  Widths() = default;
  implicit Widths(const std::Vector<Item>& data) : data(data) {}
  std::Vector<Item> data;
};
static int first(const Widths& w) { return w.data[0].minimalWidth; }
int main()
{
  Widths parenthesised = Widths(std::Vector<Widths::Item>{{120, 0}});
  std::Vector<std::Pair<int, int>> pairs{{1, 2}};
  std::Optional<std::Pair<int, int>> wrapped{{3, 4}};
  std::println(first(Widths(std::Vector<Widths::Item>{{120, 0}})), " ", parenthesised.data.size(), " ", pairs.size(), " ", pairs[0].second, " ", wrapped->first);
  return 0;
}
