// spec: a noexcept condition of a class template's member that names a member through `this` is decided for the instance, as the bare name's is (clang 19 for `this->v = x`: 1 0)
template <typename T> struct Box { T v; void set(const T& x) noexcept(noexcept(this.v = x)) { this.v = x; } };
struct Loud { Loud& operator=(const Loud&) { return this; } };
int main()
{
  Box<int> a;
  Box<Loud> b;
  Loud l;
  std::println(noexcept(a.set(1)) ? 1 : 0, " ", noexcept(b.set(l)) ? 1 : 0);
  return 0;
}
