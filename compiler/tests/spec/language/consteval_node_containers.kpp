// spec: the library's node-based containers (List, ForwardList, Set, FastMap, Map: nodes from allocateBytes, linked by pointers, walked by iterator objects) work at compile time as at run time, through a range-for, `auto&` and `const auto& [k, v]` too; each constant equals what the program computes (`6 5 259 45 3`)
// factorio: build.kpp (design.md 12): projectlib's describe() walks Project's containers; a Map in a build description
extern "C" import "stdio.h";
constexpr int list() { std::List<int> l; l.push_back(1); l.push_back(2); l.push_back(3); int t = 0; for (int v : l) t += v; return t; }
constexpr int forward() { std::ForwardList<int> l; l.push_front(1); l.push_front(4); int t = 0; for (int v : l) t += v; return t; }
constexpr int set() { std::Set<int> s; s.insert(5); s.insert(2); s.insert(9); int t = 0; for (int v : s) t = t * 10 + v; return t; }
constexpr int fastMap() { std::FastMap<int, int> m; m[2] = 5; m[1] = 4; int t = 0; for (const auto& [k, v] : m) t = t * 10 + v; return t; }
constexpr int map() { std::Map<int, int> m; m[3] = 30; m[1] = 10; m[2] = 20; int t = 0; for (const auto& [k, v] : m) t = t * 10 + k; return t == 123 ? 3 : 0; }
constexpr int results[] = {list(), forward(), set(), fastMap(), map()};
int main()
{
  printf("%d %d %d %d %d\n", results[0], results[1], results[2], results[3], results[4]);
  return 0;
}
