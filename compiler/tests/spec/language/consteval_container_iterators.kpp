// spec: a range-for at compile time over the library's containers whose iterators are objects (List, ForwardList, Set, FastMap, Deque) runs their begin(), end(), !=, * and ++ as the program does, also writing through `auto&`; a member object called (Hash's operator()) and `it->second` through an iterator's operator-> work too; each constant equals what the program computes (`6 5 259 45 2010 4`)
// factorio: build.kpp (design.md 12): projectlib's describe() walks Project's containers
extern "C" import "stdio.h";
constexpr int list() { List<int> l; l.push_back(1); l.push_back(2); l.push_back(3); int t = 0; for (int v : l) t += v; return t; }
constexpr int forward() { ForwardList<int> l; l.push_front(1); l.push_front(4); int t = 0; for (int v : l) t += v; return t; }
constexpr int set() { Set<int> s; s.insert(5); s.insert(2); s.insert(9); int t = 0; for (int v : s) t = t * 10 + v; return t; }
constexpr int fastMap() { FastMap<int, int> m; m[2] = 5; m[1] = 4; int t = 0; for (const auto& [k, v] : m) t = t * 10 + v; return t; }
constexpr int deque() { Deque<int> d; d.push_back(1); d.push_front(2); for (int& v : d) v *= 10; int t = 0; for (int v : d) t = t * 100 + v; return t; }
struct Hashing { Hash<int> hasher; constexpr int low() const { return (int)(this->hasher(5) & 3); } };
constexpr int hashed() { Hashing h; return h.low() == (int)(hashOf(5) & 3) ? 4 : 0; }
constexpr int results[] = {list(), forward(), set(), fastMap(), deque(), hashed()};
int main()
{
  printf("%d %d %d %d %d %d\n", results[0], results[1], results[2], results[3], results[4], results[5]);
  return 0;
}
