// spec: empty braces for a class with a default constructor value-initialise it (C++ [dcl.init.list] 3.5), also where the class has an InitializerList constructor: `Vector<Reference> items = {}` of a move-only Reference, as a declaration and as a default argument
// factorio: CommandProcessor's `Vector<SavedSpecialItemReference> specialItemsInMessage = {}` default argument chose Vector's InitializerList constructor, whose body copies the elements: "copying SavedSpecialItemReference, whose copy constructor is deleted"
class Reference
{
public:
  Reference(int id) : id(id) {}
  Reference(const Reference&) = delete;
  Reference(Reference&&) = default;
  Reference& operator=(Reference&&) = default;
  int id;
};
int count(std::Vector<Reference> items = {}) { return int(items.size()); }
int main()
{
  std::Vector<Reference> one;
  one.push_back(Reference(4));
  std::Vector<Reference> none = {};
  std::println(count(), " ", count(std::move(one)), " ", int(none.size()));
  return 0;
}
