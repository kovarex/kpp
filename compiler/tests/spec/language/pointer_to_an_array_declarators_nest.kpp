// spec: parentheses nest in a declarator of an array's pointer or reference: `int (*(*p))[3]`, `int (**p)[3]`, `int (*&p)[3]`, `int (&(r))[3]`, `int (*(t[2]))[3]`
// found by thread A's comparison with clang (2026-11-06): parse errors
int main()
{
  int arr[3] = {1, 2, 3};
  int (*ap)[3] = &arr;
  int (*(*app))[3] = &ap;
  int (**app2)[3] = &ap;
  int (*&apr)[3] = ap;
  std::println((**app)[1], " ", (**app2)[2], " ", (*apr)[0]);
  int (&(ar))[3] = arr;
  std::println(ar[2], " ", sizeof(ar));
  int (*(tab[2]))[3] = {&arr, &arr};
  std::println((*tab[1])[1], " ", sizeof(tab) / sizeof(tab[0]));
  return 0;
}
