// spec: --zero-null-warnings with --check prints the warnings at the literal 0s beside the checker's errors (convert.cmd's nullptr pass reads them for fix-null.py): a check that stops before code generation still says them
// found by thread UE (2026-11-22): they were printed after code generation only, so a check of a program with errors printed none, and the nullptr pass of Unreal Engine's conversion (2,382 errors) rewrote no 0 (38 `p == 0` left)
// kpp: --check --zero-null-warnings --diagnostic-columns
// error: zero_null_warnings_beside_an_error.kpp:11:3: error: 'undeclaredName' is not declared
// error: zero_null_warnings_beside_an_error.kpp:12:12: warning: the literal 0 is no pointer: write nullptr (design.md 4)
int main()
{
  int x = 0;
  int* p = &x;
  [[maybe_unused]] int y = 0;
  undeclaredName = 3;
  if (p == 0)
    return 1;
  return 0;
}
