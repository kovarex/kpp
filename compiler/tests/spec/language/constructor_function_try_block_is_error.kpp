// spec: a constructor's or destructor's function-try-block is an error until codegen does what C++ does with it (its handler also takes what the member initializers throw, after their subobjects are destroyed, and rethrows at its end), never one whose handlers are skipped
// error: constructor_function_try_block_is_error.kpp:6: error: a function-try-block of a constructor or destructor is not supported yet
struct Widget
{
  int v;
  Widget(int x) try : v(x) { if (x < 0) throw x; } catch (int) { println("constructor caught"); }
};
int main()
{
  Widget w(1);
  return w.v;
}
