// spec: --override-warnings: a function that overrides a virtual one and does not say so is a warning at its name, in a class and in an instance whose base is its parameter, as is an instance's `override` of nothing (a mixin over a plain base), at the declaration and never on an out-of-line definition, which cannot say it; a destructor, `final`, `override`, a hiding non-virtual and a new function are not
// kppc: --override-warnings
// warning: override_warnings_mode.kpp:22: warning: f overrides a virtual function: write override
// warning: override_warnings_mode.kpp:31: warning: g overrides a virtual function: write override
// warning: override_warnings_mode.kpp:37: warning: g overrides a virtual function: write override
// no-warning: override_warnings_mode.kpp:39:
// no-warning: override_warnings_mode.kpp:40:
// warning: override_warnings_mode.kpp:49: warning: g says override and overrides nothing in Mixin<Bare>
class Base
{
public:
  virtual ~Base() {}
  virtual void f() {}
  virtual int g() const { return 1; }
  virtual void h() {}
  void plain() {}
};
class Derived : public Base
{
public:
  ~Derived() {}
  void f() {}
  int g() const override { return 2; }
  void h() final {}
  void plain() {}
  void other() {}
};
template<class T> class Over : public T
{
public:
  int g() const { return 3; }
};
class Outside : public Base
{
public:
  void f() override;
  int g() const;
};
void Outside::f() {}
int Outside::g() const { return 4; }
class Bare
{
public:
  int g() const { return 5; }
};
template<class T> class Mixin : public T
{
public:
  int g() const override { return 6; }
};
int main()
{
  Derived d;
  Mixin<Base> withVirtual;
  Mixin<Bare> withPlain;
  Over<Base> o;
  Base* b = &o;
  println(d.g(), " ", b->g());
  return 0;
}
