// spec: a range-for over a const object calls its class's const begin() and end(), over a non-const one the non-const ones
// factorio: every `for (const T& x : constVector)`: codegen called Vector's non-const begin() and end() on the const vector, found by codegen's cross-check against the checker's recorded choices (design.md 24)
struct Triple
{
  int values[3] = {1, 2, 3};
  mutable int constCalls = 0;
  int mutableCalls = 0;
  int* begin() { ++this.mutableCalls; return this.values; }
  int* end() { ++this.mutableCalls; return this.values + 3; }
  const int* begin() const { ++this.constCalls; return this.values; }
  const int* end() const { ++this.constCalls; return this.values + 3; }
};
int sumOf(const Triple& numbers)
{
  int total = 0;
  for (int v : numbers)
    total += v;
  return total;
}
int main()
{
  Triple n;
  int a = sumOf(n);
  for (int& v : n)
    v *= 2;
  int b = sumOf(n);
  std::println(a, " ", n.constCalls, " ", n.mutableCalls, " ", b);
  return 0;
}
