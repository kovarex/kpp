int main()
{
  int a0 = counted0();
  int b0 = counted0();
  int a1 = counted1();
  int b1 = counted1();
  int a2 = counted2();
  int b2 = counted2();
  int a3 = counted3();
  int b3 = counted3();
  int a4 = counted4();
  int b4 = counted4();
  int a5 = counted5();
  int b5 = counted5();
  println(a0, " ", b0, " ", a1, " ", b1, " ", a2, " ", b2, " ", a3, " ", b3, " ", a4, " ", b4, " ", a5, " ", b5);
  return 0;
}
