// spec: a printf-like call (a C-variadic function whose last named parameter is a `const char*`: the printf family, ssprintf, the game's FORMAT_STRING functions) with a string literal format takes, for every conversion, an argument of its type and size (LLP64: `%ld` 32 bits, `%lld`, `%zu`, `%I64d` 64), and as many arguments as conversions; each mismatch is an error (design.md)
// factorio: `%zu` given a 32-bit container size passes 32 bits where printf reads 64 (garbage in the upper half), and `%u` given a UnitNumber (uint64_t) in the tests; found by the templates thread
// error: printf_format_must_match_arguments.kpp:11: error: the format of printf takes a 64-bit integer for "%zu", given int32
// error: printf_format_must_match_arguments.kpp:12: error: the format of printf takes an int for "%d", given int32*
// error: printf_format_must_match_arguments.kpp:13: error: the format of printf has more conversions than arguments: none for "%d"
// error: printf_format_must_match_arguments.kpp:14: error: the format of printf has fewer conversions than arguments: 1 more
// error: printf_format_must_match_arguments.kpp:15: error: the format of printf takes a string (a `const char*`) for "%s", given int32
// error: printf_format_must_match_arguments.kpp:16: error: the format of printf takes an int for "%u", given uint64
extern "C" int printf(const char* format, ...);
extern "C" int snprintf(char* buffer, size_t size, const char* format, ...);
int sizeWithInt() { int n = 3; return printf("%zu\n", n); }
int intWithPointer() { int n = 3; return printf("%d\n", &n); }
int tooFew() { return printf("%d %d\n", 1); }
int tooMany() { return printf("%d\n", 1, 2); }
int stringWithInt() { return printf("%s\n", 5); }
int wideWithNarrow() { unsigned long long id = 7; return printf("%u\n", id); }
int main()
{
  return sizeWithInt() + intWithPointer() + tooFew() + tooMany() + stringWithInt() + wideWithNarrow();
}
