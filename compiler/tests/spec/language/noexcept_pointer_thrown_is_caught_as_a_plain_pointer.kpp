// spec: a handler of `void (*)()` takes a thrown `void (*)() noexcept`, a function pointer conversion ([except.handle] 3.3), g++'s output (clang for MSVC targets does not)
// pending: the catch compares the two types' identities (B)
extern "C" import "stdio.h";
void nf() noexcept {}
int main()
{
  void (*q)() noexcept = nf;
  try
  {
    throw q;
  }
  catch (void (*got)())
  {
    printf("caught plain\n");
  }
  catch (...)
  {
    printf("other\n");
  }
  return 0;
}
