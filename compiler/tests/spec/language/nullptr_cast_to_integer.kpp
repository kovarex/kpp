// spec: a C-style cast of nullptr to an integer type is 0 (the cast is a reinterpret_cast, which converts nullptr_t to an integral type as it would (void*)0), also of a conditional whose both sides are nullptr
// factorio: stb_image (converted as C): stbi__errpuc's `((unsigned char *)(size_t) (stbi__err(x,y)?NULL:NULL))`, the return of 25 failure paths (NULL written nullptr)
int main()
{
  unsigned long long a = (unsigned long long)nullptr;
  unsigned long long b = (unsigned long long)(a > 2 ? nullptr : nullptr);
  unsigned char* p = (unsigned char*)(unsigned long long)(a == 0 ? nullptr : nullptr);
  std::println(a, " ", b, " ", p == nullptr);
  return 0;
}
