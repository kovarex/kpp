struct Flag
{
  bool on;
  operator int() const { return on ? 1 : 2; }
};
struct Level
{
  int n;
  implicit operator int() const { return n; }
};
int main()
{
  Flag f{true};
  Level l{1};
  int r = 0;
  switch (f)
  {
    case 1:
      r = 1;
      break;
  }
  switch (l)
  {
    case 1:
      r += 2;
      break;
  }
  switch (int(f))
  {
    case 1:
      r += 4;
      break;
  }
  return r;
}
