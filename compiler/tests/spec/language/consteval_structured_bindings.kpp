// spec: structured bindings work at compile time as at run time: `auto [a, b] = p;` copies the object, `auto& [a, b]` refers into it (an assignment through a name changes it), `const auto&` reads it, over a C array's elements too, in a range-for (`for (const auto& [a, b] : pairs)`, a FastMap's and a Map's entries), and a tuple-like class's names are its get<i>() results (a reference result follows the object); each constant equals what the program computes (`34 74 34 14 56 45 123 815 605` both)
// found with the library's node containers at compile time (language/consteval_node_containers): a structured binding declaration was no constant
struct Two
{
  int a = 0;
  int b = 0;
  template<size_t I>
  const int& get() const { return I == 0 ? this.a : this.b; }
};
template<>
struct std::TupleSize<Two>
{
  static constexpr size_t value = 2;
};
constexpr int copied()
{
  std::Pair<int, int> p{3, 4};
  auto [a, b] = p;
  p.first = 9;
  return a * 10 + b;
}
constexpr int referred()
{
  std::Pair<int, int> p{3, 4};
  auto& [a, b] = p;
  a = 7;
  return p.first * 10 + b;
}
constexpr int read()
{
  std::Pair<int, int> p{3, 4};
  const auto& [a, b] = p;
  return a * 10 + b;
}
constexpr int looped()
{
  std::Vector<std::Pair<int, int>> v;
  v.push_back(std::Pair<i32, i32>{1, 2});
  v.push_back(std::Pair<i32, i32>{3, 4});
  int t = 0;
  for (const auto& [a, b] : v)
    t += a * b;
  return t;
}
constexpr int elements()
{
  int arr[2] = {5, 6};
  auto& [x, y] = arr;
  return x * 10 + y;
}
constexpr int fastMap()
{
  std::FastMap<int, int> m;
  m[2] = 5;
  m[1] = 4;
  int t = 0;
  for (const auto& [k, v] : m)
    t = t * 10 + v;
  return t;
}
constexpr int map()
{
  std::Map<int, int> m;
  m[3] = 30;
  m[1] = 10;
  m[2] = 20;
  int t = 0;
  for (const auto& [k, v] : m)
    t = t * 10 + k;
  return t;
}
constexpr int tupleLike()
{
  Two t;
  t.a = 8;
  t.b = 15;
  auto [x, y] = t;
  return x * 100 + y;
}
constexpr int tupleLikeReferred()
{
  Two t;
  t.a = 4;
  t.b = 5;
  const auto& [x, y] = t;
  t.a = 6;
  return x * 100 + y;
}
constexpr int results[] = {copied(), referred(), read(), looped(), elements(), fastMap(), map(), tupleLike(), tupleLikeReferred()};
int main()
{
  std::println(copied(), " ", referred(), " ", read(), " ", looped(), " ", elements(), " ", fastMap(), " ", map(), " ", tupleLike(), " ", tupleLikeReferred());
  std::println(results[0], " ", results[1], " ", results[2], " ", results[3], " ", results[4], " ", results[5], " ", results[6], " ", results[7], " ", results[8]);
  return 0;
}
