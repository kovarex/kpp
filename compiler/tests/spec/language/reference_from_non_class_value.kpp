// spec: a const reference to a class initialised from a value that is no class (`const String& s = "text";`) binds to a temporary the converting constructor makes, which lives as long as the reference
// found with language/reference_to_converted_temporary: the reference was bound to the literal's chars as if they were a String (`s.size()` read -1), silently
int main()
{
  const std::String& s = "text";
  const std::String& t = s;
  std::println(s.size(), " ", s, " ", t.size());
  return 0;
}
