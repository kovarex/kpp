// spec: a declaration that is the whole body of an if, else, for or while (no braces) is in a block of its own (C++ [stmt.pre]): its object is built and destroyed in that branch or iteration, and nothing is destroyed for a branch that did not run
// factorio: TargeterBase::save's `if (entity) Serialiser::TagWriter _(output, "targeter", ...); else if (this->target) Serialiser::TagWriter _(output, "non-entity-targeter"); else ...`: the tags' destructors ran at the end of the function for every branch, the ones never built reading their garbage Serialiser reference; desync reports save maps for humans, so LatencyInputFixture's DesyncingTestFailsControlledly faulted in TagWriter's destructor (its 5 tests pass with the branches in braces)
struct Noisy
{
  int id = 0;
  bool built = false;
  explicit Noisy(int id) : id(id), built(true) { print("+{} ", id); }
  ~Noisy() { print("-{}{} ", this->id, this->built ? "" : "(never built)"); }
};
void choose(int which)
{
  if (which == 1)
    Noisy a(1);
  else if (which == 2)
    Noisy b(2);
  else
    Noisy c(3);
  print("| ");
}
int main()
{
  choose(1);
  choose(3);
  for (int i = 0; i < 2; ++i)
    Noisy d(10 + i);
  while (false)
    Noisy e(20);
  println("end");
  return 0;
}
