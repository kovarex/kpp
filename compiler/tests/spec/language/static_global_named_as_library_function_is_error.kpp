// spec: a static global, or one in an unnamed namespace, named as one of the standard library's functions is an error: local to its file in C++, but kppc gives every top-level name one entity (not local to its file yet), so the name was the library's function, which the global's uses then took
// factorio: from D's value corpus (a global named `empty`); the clash check passed over names local to their file
// error: static_global_named_as_library_function_is_error.kpp:6: error: 'empty' is declared here and in the standard library
// error: static_global_named_as_library_function_is_error.kpp:7: error: 'size' is declared here and in the standard library
// error: a name local to its file (static, or in an unnamed namespace) is not supported yet
static int empty = 3;
namespace { int size = 4; }
int main()
{
  println("{} {}", empty, size);
  return 0;
}
