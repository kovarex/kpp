// spec: a const pointer to a function, `int (*const fixed)(int) = twice;`, a local, a global and a member, and a const pointer to an array, `int (*const row)[3] = grid;`, declare (a local was read as an expression until 2026-11-06: "unexpected keyword in expression"); the pointer is const: assigning it is an error (const_pointer_to_function_assigned_is_error)
int twice(int x) { return x * 2; }
int thrice(int x) { return x * 3; }
int (*const globalFixed)(int) = thrice;
struct Table { int (*const pick)(int); };
int main()
{
  int (*const fixed)(int) = twice;
  int (* volatile changing)(int) = twice;
  changing = thrice;
  int grid[2][3] = { { 1, 2, 3 }, { 4, 5, 6 } };
  int (*const row)[3] = grid + 1;
  Table t{twice};
  println(fixed(5), " ", changing(5), " ", globalFixed(2), " ", t.pick(7), " ", (*row)[1]);
  return 0;
}
