// spec: --this-warnings: an unqualified name that finds a data member or a member function is a warning, in a body, a lambda in it, an out-of-line member, a member initializer's argument, a default member initializer and a default argument, a static member's fix `This::x`, a member beside a global of its spelling says so; a dependent base's member is no bare name's (the global here); `this->x`, `C::x`, a local, an enumerator, a type, a member initializer's name and a parameter's or data member's type are not
// kppc: --this-warnings
// warning: this_warnings_mode.kpp:28: warning: value is a data member: write `this.value`, not `value`
// no-warning: this_warnings_mode.kpp:31:
// warning: this_warnings_mode.kpp:32: warning: created is a static member: write `This::created`, not `created`
// warning: this_warnings_mode.kpp:33: warning: value is a data member: write `this.value`, not `value`
// warning: this_warnings_mode.kpp:34: warning: current is a member function: write `this.current`, not `current`
// no-warning: this_warnings_mode.kpp:35:
// no-warning: this_warnings_mode.kpp:36:
// no-warning: this_warnings_mode.kpp:37:
// warning: this_warnings_mode.kpp:38: warning: value is a data member: write `this.value`, not `value`
// warning: this_warnings_mode.kpp:39: warning: created is a static member: write `This::created`, not `created`
// warning: this_warnings_mode.kpp:43: warning: created is a static member: write `This::created`, not `created`
// no-warning: this_warnings_mode.kpp:44:
// no-warning: this_warnings_mode.kpp:45:
// warning: this_warnings_mode.kpp:49: warning: value is a data member: write `this.value`, not `value`
// no-warning: this_warnings_mode.kpp:57:
// warning: this_warnings_mode.kpp:42: warning: levelOf is a member function (a bare levelOf will be the one around the class): write `this.levelOf`, not `levelOf`
// warning: this_warnings_mode.kpp:63: warning: operator= is a member function: write `this.operator=`, not `operator=`
// warning: this_warnings_mode.kpp:66: warning: fromPlain is a member function: write `this.fromPlain`, not `fromPlain`
int shadeOf() { return 9; }
int levelOf() { return 7; }
class Counter
{
public:
  static int created;
  int value = 1;
  int doubled = value * 2;
  enum { Limit = 5 };
  using Number = int;
  Counter() : value(2) {}
  Counter(int start) : value(start + created) {}
  int current() const { return value; }
  int twice() const { return current() * 2; }
  int spelled() const { return this->value + this->current() + Counter::created; }
  int local(int value) const { return value; }
  int limit() const { Number n = Limit; return n; }
  int lambda() const { auto f = [this] { return value; }; return f(); }
  static int make() { return created; }
  int outside() const;
  int levelOf() const { return 8; }
  int level() const { return levelOf(); }
  int defaulted(int extra = created) const { return extra; }
  decltype(value) copy = 0;
  int sized[Limit];
  static_assert(sizeof(value) == 4);
};
int Counter::created = 3;
int Counter::outside() const { return value + 1; }
template<class T> struct Base
{
  int shadeOf() const { return 4; }
  int ownOnly() const { return 5; }
};
template<class T> struct Derived : Base<T>
{
  int both() const { return shadeOf(); }
};
struct Copied
{
  int x = 1;
  Copied& operator=(const Copied& o) { this->x = o.x; return *this; }
  void copyFrom(const Copied& o) { operator=(o); }
};
struct Plain { int fromPlain() const { return 6; } };
struct Mid : Plain { int mid() const { return fromPlain(); } };
int main()
{
  Counter c;
  Derived<int> d;
  Mid m;
  println(c.twice(), " ", c.lambda(), " ", Counter::make(), " ", c.outside(), " ", m.mid(), " ", c.doubled, " ", c.defaulted(), " ", c.level());
  return 0;
}
