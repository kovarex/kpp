// spec: a function that throws after building the local it returns by name (built in the caller's result: named return elision, design.md 23) destroys that object once, where it was built, and the caller's object is never made; returned, the object is destroyed once, by the caller
int destroyed = 0;
struct Resource
{
  int id = 0;
  Resource() {}
  Resource(const Resource& o) : id(o.id) { std::println("copied"); }
  Resource(Resource&& o) : id(o.id) { std::println("moved"); }
  ~Resource()
  {
    ++destroyed;
    std::println("destroyed ", this.id);
  }
};
Resource open(bool fail)
{
  Resource r;
  r.id = 4;
  if (fail)
    throw 1;
  r.id = 5;
  return r;
}
int main()
{
  try
  {
    Resource ok = open(false);
    std::println("opened ", ok.id);
  }
  catch (int)
  {
    std::println("not thrown");
  }
  try
  {
    Resource bad = open(true);
    std::println("not reached ", bad.id);
  }
  catch (int e)
  {
    std::println("caught ", e);
  }
  std::println("destroyed ", destroyed, " times");
  return 0;
}
