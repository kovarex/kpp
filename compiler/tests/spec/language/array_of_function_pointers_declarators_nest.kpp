// spec: `int (*(a[2]))(int)`, `int (*(*p)[2])(int)`, `int (*(&r)[2])(int)`, `int (&(f))(int)`, `int (*(x))(int)`, `int ((*y))(int)`
// found by thread A's comparison with clang (2026-11-06): parse errors
int twice(int x) { return x * 2; }
int thrice(int x) { return x * 3; }
int main()
{
  int (*(arrp[2]))(int) = {twice, thrice};
  println(arrp[1](2));
  int (*(*parr)[2])(int) = &arrp;
  println((*parr)[0](2));
  int (*(&rarr)[2])(int) = arrp;
  println(rarr[1](3), " ", sizeof(rarr) / sizeof(rarr[0]));
  int (&(rf))(int) = twice;
  println(rf(9));
  int (*(x))(int) = thrice;
  println(x(1));
  int ((*y))(int) = twice;
  println(y(1));
  return 0;
}
