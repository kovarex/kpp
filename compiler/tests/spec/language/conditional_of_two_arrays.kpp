// spec: a conditional whose both arms are arrays of one type, `y != 0 ? mapping : firstmap`, is that array (an lvalue, as in C++), and it decays to a pointer to its first element where one is wanted: a pointer initialized from it points into the array chosen; also arrays of one element type and different lengths, which decay in the arms (a pointer)
// factorio: stb_image_write (converted as C): stbiw__encode_png_line's `int *mymap = (y != 0) ? mapping : firstmap;` of two `static int[5]`, the PNG filter of each row
int pick(int y, int i)
{
  static int mapping[] = {0, 1, 2, 3, 4};
  static int firstmap[] = {0, 1, 0, 5, 6};
  int* mymap = (y != 0) ? mapping : firstmap;
  return mymap[i];
}
int main()
{
  int shorter[3] = {7, 8, 9};
  int longer[4] = {1, 2, 3, 4};
  int* p = shorter[0] > 5 ? shorter : longer;
  std::println(pick(0, 3), " ", pick(1, 3), " ", pick(0, 2), " ", p[2]);
  return 0;
}
