// spec: `cond ? "text" : someString` has the class type when one branch converts to the other's class
// found in src/Util (ToStr: `value == UNDEFINED ? "_" : toStr(uint32_t(value))`)
std::String name(int value) { return value < 0 ? "_" : std::toString(value); }
std::String other(int value) { return value < 0 ? std::String("neg") : "pos"; }
int main()
{
  std::println(name(-1), " ", name(42), " ", other(-1), " ", other(1));
  return 0;
}
