// spec: a variable template's id followed by an arithmetic operator (`pi_v<float> * x`, `two_v<int> - 1`): a template argument that can only be a type makes the `<` a template's, whatever follows the `>`
// factorio: Numbers::pi_v<float> * x (Attenuation)
template<typename T>
constexpr T two_v = T(2);
static_assert(two_v<int> * 2 == 4);
int lengths[two_v<int> * 3];
float scale(float x) { return Numbers::pi_v<float> * x; }
int main()
{
  println(two_v<int> - 1, " ", int(sizeof(lengths) / sizeof(int)), " ", int(scale(1000.0f)));
  return 0;
}
