// spec: a constant template parameter passed to a reference parameter (`take(K)` with `take(Args&&...)`, `one(K)` with `one(const T&)`) binds a temporary holding its value, as an enumerator does; also inside a lambda in the template
// found in the game's NoiseExpressionParser: `getOrCreate<VoronoiNoiseWrapper>(..., TYPE)` in `template<VoronoiType TYPE> create`, once overload resolution chose that create
enum class Kind { A, B, C };

template<class... Args> int take(Args&&... args) { return (int(args) + ...); }
template<class T> int one(const T& v) { return int(v); }

template<Kind K> int f() { return take(K) + one(K); }
template<int N> int g() { auto l = []() { return take(N); }; return l(); }

int main()
{
  println(f<Kind::C>(), " ", g<7>());
  return 0;
}
