// spec: enable_if-style overload selection
// factorio: 1 use (Factorio uses requires clauses instead)
template<typename T, typename = EnableIf<isIntegral<T>>> const char* kind(T) { return "integral"; }
template<typename T, typename = EnableIf<isFloatingPoint<T>>, typename = void> const char* kind(T) { return "floating"; }
int main()
{
  println(StringView(kind(1)), " ", StringView(kind(1.0)));
  return 0;
}
