// spec: enable_if-style overload selection
// factorio: 1 use (Factorio uses requires clauses instead)
template<typename T, typename = std::EnableIf<std::isIntegral<T>>> const char* kind(T) { return "integral"; }
template<typename T, typename = std::EnableIf<std::isFloatingPoint<T>>, typename = void> const char* kind(T) { return "floating"; }
int main()
{
  std::println(std::StringView(kind(1)), " ", std::StringView(kind(1.0)));
  return 0;
}
