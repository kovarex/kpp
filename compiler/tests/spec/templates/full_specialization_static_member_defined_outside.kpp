// spec: a static data member of a full specialisation defined outside the class (`int Flag<true>::counter = 100;`, no `template<>` in front, as C++ writes it) takes that definition's initializer
template<bool B>
struct Flag
{
  static int counter;
};
template<>
struct Flag<true>
{
  static int counter;
};
template<>
struct Flag<false>
{
  static int counter;
};
int Flag<true>::counter = 100;
int Flag<false>::counter = 200;

int main()
{
  Flag<true>::counter += 1;
  std::println(Flag<true>::counter, " ", Flag<false>::counter);
  return 0;
}