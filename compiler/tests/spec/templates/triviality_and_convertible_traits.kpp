// spec: isTriviallyCopyable, isTriviallyDestructible, isTriviallyDefaultConstructible through members and bases, and isConvertible through converting constructors and conversion operators
// factorio: is_memcpy_saveable and the serialiser's memcpy paths ask isTriviallyCopyable of every saved type; requires-clauses and enable-ifs ask isConvertible
struct Plain { int a; float b; };
struct WithString { int a; String s; };
struct WithInit { int a = 5; };
struct UserCopy { int a; UserCopy() {} UserCopy(const UserCopy& o) : a(o.a) {} };
struct UserDtor { int a; ~UserDtor() {} };
struct Derived : Plain { int c; };
struct HoldsUserDtor { UserDtor inner; };
struct Virtual { virtual void f() {} };
struct FromInt { int v; implicit FromInt(int v) : v(v) {} };
struct ToInt { int v; implicit operator int() const { return this->v; } };
enum class Scoped { A };

template<typename T> bool copyable() { return isTriviallyCopyable<T>; }

int main()
{
  println("copyable ", copyable<int>(), " ", copyable<Plain>(), " ", copyable<WithString>(), " ", copyable<WithInit>(), " ", copyable<UserCopy>(), " ", copyable<UserDtor>(), " ", copyable<Derived>(), " ", copyable<HoldsUserDtor>(), " ", copyable<Virtual>());
  println("destructible ", isTriviallyDestructible<Plain>, " ", isTriviallyDestructible<WithString>, " ", isTriviallyDestructible<HoldsUserDtor>);
  println("default ", isTriviallyDefaultConstructible<Plain>, " ", isTriviallyDefaultConstructible<WithInit>, " ", isTriviallyDefaultConstructible<WithString>);
  println("convertible ", isConvertible<int, FromInt>, " ", isConvertible<ToInt, int>, " ", isConvertible<const char*, String>, " ", isConvertible<Scoped, int>, " ", isConvertible<Derived*, Plain*>, " ", isConvertible<int, int&>);
  return 0;
}
