// spec: a static constexpr member of a class template whose initializer depends on the template argument (sizeof(T), a trait of T), used as a template argument: `Array<ForceID, Limits<uint64_t>::digits + 1>`
// factorio: Surface/CloneAreaParameters (`std::array<ForceID, std::numeric_limits<uint64_t>::digits + 1>`), any size computed from a type
template<typename T>
struct Bits
{
  static constexpr int count = int(sizeof(T)) * 8;
  static constexpr int valueBits = std::isSigned<T> ? This::count - 1 : This::count;
};
int main()
{
  std::Array<int, Bits<uint64_t>::valueBits + 1> forces;
  std::Array<int, Bits<int16_t>::valueBits> shorts;
  std::println(forces.size(), " ", shorts.size());
  return 0;
}
