// spec: a pack expansion whose pattern is a member type of a template instance, `Types<typename Unwrapped<Args>::Type...>` or through an alias of one (`UnwrapRefDecay<Args>...`), is the instance of each element's member type: `Types<int, double>` for Args = int, double
// factorio: the library's makeTuple, `Tuple<UnwrapRefDecay<Args>...>` (std::make_tuple's unwrap_ref_decay_t), whose result was another Tuple than Tuple<int, double>: `return makeTuple(i, d);` from a function returning Tuple<int, double> found no constructor (PerformanceLogger's 5 statistics, InfiniteBitset, ...)
template<typename T>
struct Unwrapped { using Type = T; };
template<typename T>
using UnwrappedOf = typename Unwrapped<T>::Type;
template<typename... T>
struct Types { static constexpr int count = int(sizeof...(T)); };
template<typename... Args>
Types<typename Unwrapped<Args>::Type...> viaMember(Args... args) { return Types<typename Unwrapped<Args>::Type...>(); }
template<typename... Args>
Types<UnwrappedOf<Args>...> viaAlias(Args... args) { return Types<UnwrappedOf<Args>...>(); }
int main()
{
  static_assert(isSame<Types<typename Unwrapped<int>::Type, typename Unwrapped<double>::Type>, Types<int, double>>);
  static_assert(isSame<decltype(viaMember(1, 2.5)), Types<int, double>>);
  static_assert(isSame<decltype(viaAlias(1, 2.5)), Types<int, double>>);
  Types<int, double> both = viaAlias(1, 2.5);
  println(both.count, " ", viaMember('a').count);
  return 0;
}
