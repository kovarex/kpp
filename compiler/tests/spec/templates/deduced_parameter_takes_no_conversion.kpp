// spec: a parameter that deduction reads takes its template's instantiations only: `operator==(const B&, const Opt<B>&)` is no candidate for `Direction != Direction::Enum` (kpp's `!` of `==`) through Opt's converting constructor (C++ converts no argument to make it deducible)
// found in the game's Optional (the converter's namespace-scope `BaseClass != GameOptional<BaseClass>` operators): with conversions allowed, 120 comparisons of directions, versions and IDs picked them
struct Direction
{
  enum Enum { North, East };
  Enum value;
  Direction() : value(North) {}
  implicit Direction(Enum v) : value(v) {}
  bool operator==(const Direction& o) const { return this.value == o.value; }
};

template<class B>
struct Opt
{
  B base;
  Opt() {}
  implicit Opt(const B& b) : base(b) {}
  bool operator==(const B& rhs) const { return this.base == rhs; }
};

template<class B>
bool operator==(const B& lhs, const Opt<B>& rhs) { return lhs == rhs.base; }

struct Derived : Opt<int> {};

template<class T>
int fromOpt([[maybe_unused]] const Opt<T>& o) { return 1; }
int fromOpt([[maybe_unused]] double d) { return 2; }

int main()
{
  Direction d;
  Opt<Direction> o(Direction::North);
  Derived derived;
  std::println(d != Direction::East, " ", o != d, " ", d != o);
  std::println(fromOpt(o), " ", fromOpt(derived), " ", fromOpt(3));
  return 0;
}
