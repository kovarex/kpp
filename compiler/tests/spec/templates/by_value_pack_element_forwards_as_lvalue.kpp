// spec: an element of a pack of parameters taken by value (`Args... args`) is an lvalue, so a forwarding reference given it deduces an lvalue reference and forward<> copies it, as C++ does: makeUnique<Holder>(args...) calls Holder's copy constructor, of a forwarding pack's element bound to a temporary too (a named rvalue reference is an lvalue), `copy copy copy copy [hello] [world]` as g++ prints
// found by thread B (2026-11-05): kpp deduced the element's own type (String, not String&), so the forwarding reference was an rvalue reference bound to the lvalue and forward<> moved from it: `copy move copy`; the game's RemoteCommandProcessor::addInterface (`Args... args` to makeUnique<InterfaceT>(nextID++, args...)) and LoadedSource::update move their arguments this way
class Holder
{
public:
  std::String text;
  Holder(const std::String& t) : text(t) { std::print("copy "); }
  Holder(std::String&& t) : text(std::move(t)) { std::print("move "); }
};
template<typename... Args>
void relayMake(Args&&... args)
{
  std::UniquePtr<Holder> h = std::makeUnique<Holder>(args...);
}
template<typename... Args>
void relayByValue(Args... args)
{
  std::UniquePtr<Holder> h = std::makeUnique<Holder>(args...);
}
int main()
{
  std::String s = "hello";
  relayMake(s);
  relayMake(std::String("temporary"));
  std::String t = "world";
  relayByValue(t);
  std::UniquePtr<Holder> direct = std::makeUnique<Holder>(s);
  std::println("[", s, "] [", t, "]");
  return 0;
}
