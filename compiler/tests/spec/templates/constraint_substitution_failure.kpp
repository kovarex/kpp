// spec: a constraint whose trait arguments do not form for the deduced arguments (`decltype(declval<T>().str())` for a T without str()) is not satisfied, as C++ has it (a substitution failure), and `isInvocable<P, int>` is false for a pointer to data; in both cases the next overload is taken
// found in the game's toStr (`requires (isSame<RemoveConst<RemoveReference<decltype(declval<T>().str())>>, String> || ...)`) and EntitySearch's predicate constructor (`requires isInvocable<PredicateType, EntityT*>` given a LatencyState*), which the checker could not evaluate
struct Base {};
struct WithStr : Base { std::String str() const { return "with"; } };
struct Plain : Base {};
template<class T> requires ((std::isSame<std::RemoveConst<std::RemoveReference<decltype(std::declval<T>().str())>>, std::String>) && std::isClass<T>)
const char* describe([[maybe_unused]] const T& value) { return "str"; }
const char* describe([[maybe_unused]] const Base& value) { return "base"; }
template<class P> requires std::isInvocable<P, int>
const char* call([[maybe_unused]] P p) { return "callable"; }
const char* call([[maybe_unused]] const int* p) { return "not callable"; }
int f(int x) { return x; }
int main()
{
  int data = 0;
  std::println(std::StringView(describe(WithStr())), " ", std::StringView(describe(Plain())), " ", std::StringView(call(&f)), " ", std::StringView(call(&data)));
  return 0;
}
