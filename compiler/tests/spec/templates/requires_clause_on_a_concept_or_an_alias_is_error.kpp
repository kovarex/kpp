// spec: a requires clause on a concept is an error, as C++ has it ([temp.concept] 4), and on an alias template an error until kpp supports it: neither is dropped
// found by D (2026-11-10): the parser dropped a template header's requires clause on a concept, on an alias template and on a variable template (which keeps it now), silently
// error: requires_clause_on_a_concept_or_an_alias_is_error.kpp:8: error: a concept has no requires clause
// error: requires_clause_on_a_concept_or_an_alias_is_error.kpp:11: error: a requires clause on an alias template is not supported yet
template<typename T>
concept Big = sizeof(T) >= 4;
template<typename T>
  requires Big<T>
concept Bigger = sizeof(T) >= 8;
template<typename T>
  requires Big<T>
using Same = T;
int main()
{
  return 0;
}
