// spec: a call with a brace list of brace lists, `map.insert({{"y", 2}, {"z", 3}})`, chooses insert(InitializerList<Pair<K, V>>): insert(const Pair<K, V>&) is not viable, as {"z", 3} is no int
// found writing Set's and Map's insert({...}) for the tests' TestPlanetGeneration (`missing.insert({"small-demolisher", ...})` on a std::set, which passes); std::map's insert({{k, v}, ...}) is the same call on a map
int main()
{
  std::Map<std::String, int> map;
  map.insert({{"y", 2}, {"z", 3}});
  std::MultiMap<int, int> multi;
  multi.insert({{1, 10}, {1, 11}});
  std::println(map.size(), " ", map["z"], " ", multi.count(1));
  return 0;
}
