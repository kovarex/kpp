// spec: a converting constructor template whose parameter the argument cannot deduce (`UniquePtr(UniquePtr<U, E>&&)` given a const char*) is no candidate, so it makes no conversion and the overload whose parameter the argument does convert to is chosen
// factorio: ValueToWidget's `makeCollapsibleValue(value.loaded() ? "..." : "<empty>", ::move(table))` beside makeCollapsibleValue(UniquePtr<Widget>, UniquePtr<Widget>) and makeCollapsibleValue(String&&, UniquePtr<Widget>)
class Widget
{
public:
  virtual ~Widget() {}
  int id = 0;
};
static int collapsible([[maybe_unused]] std::UniquePtr<Widget> collapsed, [[maybe_unused]] std::UniquePtr<Widget> expanded) { return 1; }
static int collapsible([[maybe_unused]] std::UniquePtr<Widget> expanded) { return 2; }
static int collapsible([[maybe_unused]] const std::String& collapsed, [[maybe_unused]] std::UniquePtr<Widget> expanded) { return 3; }
static int collapsible([[maybe_unused]] std::String&& collapsed, [[maybe_unused]] std::UniquePtr<Widget> expanded) { return 4; }
int main()
{
  bool loaded = true;
  std::UniquePtr<Widget> table = std::makeUnique<Widget>();
  std::UniquePtr<Widget> other = std::makeUnique<Widget>();
  std::println(collapsible(loaded ? "..." : "<empty>", std::move(table)), " ", collapsible(std::move(other)));
  return 0;
}
