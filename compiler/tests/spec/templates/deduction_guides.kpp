// spec: deduction guides and the overload-set idiom: `template<typename... Ts> Overload(Ts...) -> Overload<Ts...>;` with `using Ts::operator()...;`
// found in src/Util (Util.hpp make_overload, used with std::visit)
// pending: the arguments are deduced (Overload<L1, L2>, through the guide or as an aggregate), but a call through the lambda bases (`using Ts::operator()...`) is not typed yet, and the code generator lays out no pack of bases
template<typename... Ts> struct Overload : Ts... { using Ts::operator()...; };
template<typename... Ts> Overload(Ts...) -> Overload<Ts...>;
int main()
{
  Overload o{[](int x) { return x + 1; }, [](const char* s) { return (int)strlen(s); }};
  println("{} {}", o(41), o("abc"));
  return 0;
}
