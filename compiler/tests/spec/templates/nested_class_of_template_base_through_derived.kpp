// spec: a nested class of a class template named through a derived class (`Surface::const_iterator(surface)` with `class Surface : public InfiniteRectangle<Chunk*>` and the iterator declared in InfiniteRectangle<T>): the nested class with the base's arguments
// factorio: `for (auto chunkIterator = Surface::const_iterator(this->surface); ...)` in ExpansionPlanner and Surface
template<typename T>
class Grid
{
public:
  class const_iterator
  {
  public:
    implicit const_iterator(const Grid& grid) : grid(&grid) {}
    const T& value() const { return this.grid->cells[this.index]; }
    bool ended() const { return this.index >= 3; }
    const_iterator& operator++() { ++this.index; return this; }
    const Grid* grid;
    int index = 0;
  };
  T cells[3];
};

class Board : public Grid<int>
{
};

int main()
{
  Board board;
  board.cells[0] = 1;
  board.cells[1] = 2;
  board.cells[2] = 4;
  int sum = 0;
  for (auto it = Board::const_iterator(board); !it.ended(); ++it)
    sum += it.value();
  println(sum);
  return 0;
}
