// spec: overload resolution between pointer (and reference) conversions of one rank takes C++'s tie-breakers: a Spider* picks pick(Entity*) over pick(const Entity*) (a qualification more), nearer(Unit*) over nearer(Entity*) (the nearer base), and a Spider lvalue byRef(Entity&) over byRef(const Entity&)
// factorio: ItemRequestProxy::getProxyForEntity(const Entity*) / (Entity*) given a SpiderVehicle* (the tests' `Targeter<ItemRequestProxy> proxy(ItemRequestProxy::getProxyForEntity(spiderVehicle))`), and the game's push, get, sizeOf and iterator_to overloads (15 choices in the full source)
class Entity { public: virtual ~Entity() = default; };
class Unit : public Entity { public:};
class Spider : public Unit { public:};
int pick([[maybe_unused]] const Entity* e) { return 1; }
int pick([[maybe_unused]] Entity* e) { return 2; }
int nearer([[maybe_unused]] Entity* e) { return 3; }
int nearer([[maybe_unused]] Unit* u) { return 4; }
int byRef([[maybe_unused]] const Entity& e) { return 5; }
int byRef([[maybe_unused]] Entity& e) { return 6; }
int main()
{
  Spider spider;
  Spider* s = &spider;
  const Spider* cs = &spider;
  std::println(pick(s), " ", pick(cs), " ", nearer(s), " ", byRef(spider), " ", byRef(*cs));
  return 0;
}
