struct Entity { virtual ~Entity() = default; };
struct Unit : Entity {};
struct Spider : Unit {};
int pick(const Entity* e) { return 1; }
int pick(Entity* e) { return 2; }
int nearer(Entity* e) { return 3; }
int nearer(Unit* u) { return 4; }
int byRef(const Entity& e) { return 5; }
int byRef(Entity& e) { return 6; }
