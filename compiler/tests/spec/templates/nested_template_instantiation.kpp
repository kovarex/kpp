// spec: a class template instantiated with another instantiation of itself (MyStack<MyStack<int>>) through a variadic push
template<typename T>
struct MyStack
{
  std::Vector<T> items;
  template<typename... Args> T& push(Args&&... args) { return this.items.emplace_back(std::forward<Args>(args)...); }
};
int main()
{
  MyStack<MyStack<int>> nested;
  MyStack<int>& inner = nested.push();
  int seven = 7;
  inner.push(seven);
  std::println(nested.items.size(), " ", nested.items[0].items[0]);
  return 0;
}
