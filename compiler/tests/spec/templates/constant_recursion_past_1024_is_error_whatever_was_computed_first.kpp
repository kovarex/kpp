int f40() { constexpr int v = Sum<1000>::value; return v % 1000; }
int f41() { constexpr int v = Sum<1025>::value; return v % 1000; }
int f42() { constexpr int v = Sum<1050>::value; return v % 1000; }
int f43() { constexpr int v = Sum<1075>::value; return v % 1000; }
int f44() { constexpr int v = Sum<1100>::value; return v % 1000; }
