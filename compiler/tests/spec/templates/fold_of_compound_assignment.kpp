// spec: a fold of a compound assignment operator ([expr.prim.fold] fold-operator: += -= *= /= %= ^= &= |= <<= >>= =): a left fold with init `(r += ... += a)` assigns each element to r in turn, a right fold `(a *= ...)` assigns from the last element back, its value the first element; at run time and at compile time
extern "C" int printf(const char* format, ...);
template<typename... Ts> constexpr int addAll(int r, Ts... a) { return (r += ... += a); }
template<typename... Ts> constexpr int shifted(int r, Ts... a) { return (r <<= ... <<= a); }
template<typename... Ts> constexpr int products(Ts... a) { (a *= ...); return (0 + ... + a); }
template<typename... Ts> constexpr double divided(double r, Ts... a) { return (r /= ... /= a); }
int main()
{
  constexpr int c = addAll(1, 2, 3.5, 4);
  printf("%d %d\n", c, addAll(1, 2, 3.5, 4));
  printf("%d %d\n", shifted(1, 1, 2, 3), products(2, 3, 4));
  printf("%g\n", divided(100.0, 2, 4));
  return 0;
}
