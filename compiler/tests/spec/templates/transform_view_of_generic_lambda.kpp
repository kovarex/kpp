// spec: a transform view over a generic lambda with init-captures, returned from a function and iterated by its caller: the view's iterator's `auto operator*()` returns what the lambda returns for the element
// found in src/Map/ChunkLineByLineScan.kpp: chunkLineByLineScan's `iotaView(...) | transformView([leftTop, width = ...](const auto& index) { ... })`, iterated by ChartRenderer, SegmentedUnitController and others (with TerritoryManager::getAllTerritories, 13 errors)
struct Chunk { int x, y; Chunk operator+(const Chunk& o) const { return Chunk{this.x + o.x, this.y + o.y}; } };
inline auto lineByLine(const Chunk& leftTop, const Chunk& rightBottom)
{
  return iotaView(0, (rightBottom.y + 1 - leftTop.y) * (rightBottom.x + 1 - leftTop.x))
    | transformView([leftTop, width = rightBottom.x + 1 - leftTop.x](const auto& index) { return leftTop + Chunk{index % width, index / width}; });
}
int main()
{
  int sum = 0;
  for (const Chunk& c : lineByLine(Chunk{1, 1}, Chunk{2, 2}))
    sum += c.x * 10 + c.y;
  println(sum);
  return 0;
}
