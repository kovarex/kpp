// spec: two function templates whose parameters deduce from each other both ways, one by value and one a reference (`f(T)` beside `f(T&)`, `f(T&&)` or `f(const T&)`), are ordered by neither partial ordering nor the reference rules ([temp.deduct.partial] 5-9: the reference tie-breakers need two references), so a call both take equally is ambiguous, an error; `f(T&)` beside `f(T&&)` for an lvalue is ordered (the lvalue reference)
// factorio: found by the templates thread comparing overload choices against clang 19 on generated calls: the tie was never reported for templates (their types are dependent), and codegen called the first declared (silent)
// error: unordered_function_templates_are_ambiguous.kpp:12: error: the call of byValueOrRef with (int32&) is ambiguous
// error: unordered_function_templates_are_ambiguous.kpp:13: error: the call of byValueOrConstRef with (int32) is ambiguous
template<typename T> int byValueOrRef(T v) { return 1; }
template<typename T> int byValueOrRef(T& v) { return 2; }
template<typename T> int byValueOrConstRef(T v) { return 1; }
template<typename T> int byValueOrConstRef(const T& v) { return 2; }
template<typename T> int refOrForwarding(T& v) { return 1; }
template<typename T> int refOrForwarding(T&& v) { return 2; }
int lvalue() { int i = 1; return refOrForwarding(i); }
int ref() { int i = 1; return byValueOrRef(i); }
int constRef() { return byValueOrConstRef(1); }
int main()
{
  return lvalue() + ref() + constRef();
}
