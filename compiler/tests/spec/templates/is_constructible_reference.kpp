// spec: isConstructible<T&, Arg> (std::is_constructible) asks whether the reference binds declval<Arg>(), an lvalue for a reference Arg and an xvalue otherwise: an array reference binds an array lvalue, `int&` binds no rvalue, `const int&` and `int&&` bind one, a base reference a derived object; so forwardAsTuple of an array builds a Tuple holding a reference to it (`xyz 2`)
// found while making a string literal deduce an array: Tuple's forwarding constructor requires isConstructible<H, UH&&>, which was false for H = char (&)[4] (the reference stripped, then an array asked to convert to an array), so `forwardAsTuple(buffer, 2)` had no constructor (also before that change)
extern "C" import "stdio.h";
using A4 = char[4];
struct Base {};
struct Derived : Base {};
static_assert(std::isConstructible<A4&, A4&>);
static_assert(std::isConstructible<const A4&, A4&>);
static_assert(!std::isConstructible<A4&, const A4&>);
static_assert(std::isConstructible<int&, int&>);
static_assert(!std::isConstructible<int&, int>);
static_assert(!std::isConstructible<int&, int&&>);
static_assert(std::isConstructible<const int&, int>);
static_assert(std::isConstructible<int&&, int>);
static_assert(!std::isConstructible<int&&, int&>);
static_assert(std::isConstructible<Base&, Derived&>);
static_assert(!std::isConstructible<Derived&, Base&>);
static_assert(std::isConstructible<const std::String&, const char*>);
int main()
{
  char buffer[4] = "xyz";
  auto t = std::forwardAsTuple(buffer, 2);
  printf("%s %d\n", std::get<0>(t), std::get<1>(t));
  return 0;
}
