// spec: a pack of base classes (`template<typename... Ts> struct Overload : Ts... { using Ts::operator()...; };`, the overload-set idiom) is an error where a class is laid out, until it is supported; its deduction guide deduces the arguments (Overload<L1, L2>), the layout and the call through the lambda bases are what is missing
// factorio: Util.hpp's make_overload, whose one user (visitVariant, around std::visit) goes with the Variant mapping (library/variant): decided 2026-10-31 to be an error until something needs it
// error: pack_of_base_classes_is_not_supported_yet.kpp:8: error: codegen does not support the layout of Overload<__lambda_57_0, __lambda_57_1>: a pack of base classes (`: Ts...`) yet
template<typename... Ts> struct Overload : Ts... { using Ts::operator()...; };
template<typename... Ts> Overload(Ts...) -> Overload<Ts...>;
int main()
{
  Overload o{[](int x) { return x + 1; }, [](const char* s) { return (int)strlen(s); }};
  println("{} {}", o(41), o("abc"));
  return 0;
}
