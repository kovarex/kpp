// spec: a conversion operator template without a constraint (`template<class T> implicit operator T() const`) converts to each type wanted, a class with only an explicit constructor from int among them: `Strict s = value;` takes `operator Strict()`, as C++ does ([over.match.copy]), while asking whether value converts to that constructor's int
// found in the converted game: checking copy-initialization for explicit constructors crashed kpp on such a template, whose missing requires clause the constraint check read
struct Value
{
  int stored = 3;
  template<class T>
  implicit operator T() const { return T(this->stored * 2); }
};
struct Strict
{
  int v;
  Strict(int x) : v(x + 100) {}
};
int main()
{
  Value value;
  int i = value;
  long long l = value;
  Strict s = value;
  println(i, " ", l, " ", s.v);
  return 0;
}
