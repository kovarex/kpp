// spec: a function passed by name to a forwarding reference: `F&&` binds to the function itself (F is its function type), `forward<F>(f)(args...)` calls it, and `Decay<F>` is its pointer type
// factorio: std::thread's constructor with a function (ParallelScenarioLoader's `std::thread(ParallelScenarioLoader::doLoad, mapInterface, loader, ...)`), std::invoke, the game's own `F&&` wrappers
static int add(int a, int b) { return a + b; }
template<typename F, typename... Args>
decltype(auto) call(F&& f, Args&&... args) { return std::forward<F>(f)(std::forward<Args>(args)...); }
template<typename F>
std::Decay<F> keep(F&& f) { return f; }
int main()
{
  std::println(call(add, 2, 3), " ", keep(add)(4, 5));
  return 0;
}
