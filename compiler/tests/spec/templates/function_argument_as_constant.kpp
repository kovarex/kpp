// spec: a function given as a template argument is that function's address at compile time: `static constexpr auto FOLD = fold;` compares equal to `&add` and calls it (constant data can hold it as the function)
// factorio: the code generator's constant data (a static member holding a function template argument), spec templates/static_auto_member_of_instance
constexpr int add(int a, int b) { return a + b; }
constexpr int mul(int a, int b) { return a * b; }
template<int (*fold)(int, int), int Scale>
struct Expr
{
  static constexpr auto FOLD = fold;
  static constexpr int apply(int a, int b) { return FOLD(a, b) * Scale; }
};
static_assert(Expr<add, 3>::FOLD == &add && Expr<mul, 1>::FOLD != &add);
static_assert(Expr<add, 3>::apply(2, 3) == 15 && Expr<mul, 2>::apply(2, 3) == 12);
template<int N>
struct Show
{
  static constexpr int value = N;
};
int main()
{
  println(Show<Expr<add, 3>::apply(1, 1)>::value, " ", Expr<mul, 1>::FOLD(4, 5));
  return 0;
}
