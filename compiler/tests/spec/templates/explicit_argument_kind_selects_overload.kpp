// spec: an explicit template argument picks the overloads whose parameter is of its kind: a type for `template<class Expression>`, a constant for `template<Mode M>`
// found in the game's NoiseExpressionParser: `NamedFunction::create<Abs>({"value"})` next to `template<VoronoiType TYPE> create`, which tied with it and took whichever came first
enum class Mode { Cell, Distance };
struct Abs {};

struct Fn
{
  template<class Expression>
  static int create([[maybe_unused]] std::Vector<const char*>&& names) { return 1; }

  template<Mode M>
  static int create([[maybe_unused]] std::Vector<const char*>&& names) { return M == Mode::Cell ? 2 : 3; }
};

int main()
{
  std::println(Fn::create<Mode::Cell>(std::Vector<const char*>{"value"}), " ", Fn::create<Abs>(std::Vector<const char*>{"value"}), " ", Fn::create<Mode::Distance>(std::Vector<const char*>{"x", "y"}));
  return 0;
}
