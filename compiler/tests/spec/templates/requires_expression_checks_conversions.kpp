// spec: a requirement that converts (`bool(instance)`) holds only when the conversion exists: a class without an operator bool fails `requires (T instance) { bool(instance); }`
// found in the game's IDIndexedData::load (`if constexpr (requires(T instance) { bool(instance); })`), which took the branch for VisibleInstanceValue and then failed converting it
class NoBool
{
public:
  int x = 0;
};
struct WithBool
{
  operator bool() const { return true; }
};

template<class T>
int test(T v)
{
  if constexpr (requires(T instance) { bool(instance); })
    return 1;
  return 2;
}

int main()
{
  println(test(NoBool{}), " ", test(WithBool{}), " ", test(5));
  return 0;
}
