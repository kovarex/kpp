// spec: an enum declared in a class template is a type of each instance (`Flag<A>::Enum` is not `Flag<B>::Enum`), so overloads on two instances tell their enumerators apart, also through a fold over a forwarded pack
// factorio: NamedBool<Tag>'s `enum class Enum`: ActionData::BuildParameters's `(this->loadArg(args), ...)` with `loadArg(BeltPowerReplace)`, `loadArg(SkipFogOfWar)`, ... called with `BeltPowerReplace::False`
template<class Tag>
class Flag
{
public:
  enum class Enum : uint8_t { False, True };
  static constexpr Enum True = Enum::True;
  static constexpr Enum False = Enum::False;
  constexpr Flag() = default;
  implicit constexpr Flag(Enum value) : value(value == Enum::True) {}
  bool value = false;
};
using Fast = Flag<class FastTag>;
using Loud = Flag<class LoudTag>;
static int pick(Fast) { return 1; }
static int pick(Loud) { return 2; }
struct Settings
{
  template<typename... Args>
  Settings(Args&&... args) { (this.load(args), ...); }
  void load(Fast fast) { this.fast = fast.value; }
  void load(Loud loud) { this.loud = loud.value; }
  bool fast = false;
  bool loud = false;
};
int main()
{
  static_assert(!std::isSame<Fast::Enum, Loud::Enum>);
  static_assert(std::isSame<std::Decay<decltype(Fast::True)>, Fast::Enum> && !std::isSame<std::Decay<decltype(Loud::True)>, Fast::Enum>);
  Settings settings(Fast::True, Loud::False);
  Fast::Enum e = Fast::Enum::True;
  std::println(pick(Fast::True), " ", pick(Loud::False), " ", settings.fast, " ", settings.loud, " ", pick(e));
  return 0;
}
