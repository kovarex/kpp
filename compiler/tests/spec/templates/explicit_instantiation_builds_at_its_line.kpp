// spec: an explicit instantiation's static data members are built where the explicit instantiation is written, among the file's other globals in definition order (design.md section 2), and an instance's members in the order of their definitions
// factorio: the Lua bindings' `template class LuaStruct<MapSettings>;` and the others, each registering its metatable from `LuaStruct<T>::loaded`
Vector<int> order;
template<class T>
struct Registry
{
  static bool loaded;
  static bool second;
  static bool record(int id) { order.push_back(id); return true; }
};
template<class T>
bool Registry<T>::loaded = Registry<T>::record(T::id);
template<class T>
bool Registry<T>::second = Registry<T>::record(T::id * 10);
struct Zeta { static const int id = 1; };
struct Alpha { static const int id = 2; };
template struct Registry<Zeta>;
bool between = Registry<Zeta>::record(3);
template struct Registry<Alpha>;
int main()
{
  for (int id : order)
    print("{} ", id);
  println("");
  return 0;
}
