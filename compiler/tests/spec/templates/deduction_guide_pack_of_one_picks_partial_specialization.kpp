// spec: class template argument deduction through a deduction guide with a pack (`template<typename... M> Box(M&...) -> Box<M...>;`) deduces Box<A> from one argument, and the object is the partial specialization Box<M> where one matches, as it is Box<A, B> of the primary template from two (`1 2`)
// factorio: E's ScopedLock (2026-11-06, std::scoped_lock's guides): `ScopedLock lock(a, b)` deduced, `ScopedLock lock(a)` did not: "codegen does not support a local of unknown type (lock) yet"
extern "C" import "stdio.h";
template <typename... M>
struct Box
{
  Box(M&... values) {}
  int count() const { return (int)sizeof...(M); }
};
template <typename M>
struct Box<M>
{
  Box(M& value) {}
  int count() const { return 1; }
};
template <typename... M>
Box(M&...) -> Box<M...>;
int main()
{
  int a = 0, b = 0;
  Box one(a);
  Box two(a, b);
  printf("%d %d\n", one.count(), two.count());
  return 0;
}
