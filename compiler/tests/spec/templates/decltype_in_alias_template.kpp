// spec: decltype of an expression over a template's parameters, in an alias template (`using Sum = decltype(A() + B());`) and as a function template's return type (`decltype(A() + B()) add(A, B)`), is that expression's type for the arguments
// factorio: std::common_type and decltype-computed types (the rep of the common duration of two durations, `decltype(std::declval<T>() + ...)` in Util)
template<typename A, typename B>
using Sum = decltype(A() + B());
template<typename A, typename B>
decltype(A() + B()) add(A a, B b) { return a + b; }
int main()
{
  Sum<int, double> s = 2.5;
  auto x = add(1, 2.5);
  println("{} {}", s, x);
  return 0;
}
