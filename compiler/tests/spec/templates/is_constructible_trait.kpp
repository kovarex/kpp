// spec: `isConstructible<T, Args...>` is true when T can be built from Args (what std::is_constructible_v converts to), in `if constexpr` and in variable templates
// found in src/Util (DeserialiserHelper: `inline constexpr bool should_construct = is_constructible_v<T, Args...> && !is_optional<T>::value`)
struct Point
{
  int x, y;
  Point(int x, int y) : x(x), y(y) {}
};
template<typename T, typename... Args>
inline constexpr bool canBuild = std::isConstructible<T, Args...>;
template<typename T, typename... Args>
int build(Args... args)
{
  if constexpr (std::isConstructible<T, Args...>)
    return sizeof(T(args...));
  else
    return 0;
}
int main()
{
  std::println(std::isConstructible<Point, int, int>, " ", std::isConstructible<Point, int>, " ", canBuild<std::String, const char*>, " ", std::isConstructible<int, double>);
  std::println(build<Point>(1, 2), " ", build<Point>(1));
  return 0;
}
