// spec: a local alias of a dependent member type as a variable template's argument, `using T = VectorType::value_type; if constexpr (is_memcpy_loadable<T>)`
// found in the game's SerialiserHelper::saveVector and DeserialiserHelper::loadVector (~210 instantiations): codegen saw no type for the local alias
template<class T>
inline constexpr bool is_memcpy_loadable = std::isFundamental<T> && !std::isPointer<T> && !std::isNullPointer<T>;

struct Point { int x; int y; };

template<class VectorType>
int loadVector(const VectorType& target)
{
  using T = VectorType::value_type;
  if constexpr (is_memcpy_loadable<T>)
    return 1;
  else
    return 2;
}

int main()
{
  std::Vector<int> numbers;
  std::Vector<Point> points;
  std::Vector<int*> pointers;
  std::println(loadVector(numbers), " ", loadVector(points), " ", loadVector(pointers));
  return 0;
}
