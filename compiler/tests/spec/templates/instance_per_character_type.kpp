// spec: char16_t, char32_t and wchar_t are three types, each with instances of its own, also where wchar_t has char16_t's size and sign (Windows) or char32_t's size (Linux, FreeBSD): a template instantiated for each answers for each (`char16_t char32_t wchar_t`)
// factorio: E's comparison battery against C++ (lm1, 2026-11-06): on Linux Limits<char32_t> after Limits<wchar_t> gave wchar_t's values (signed, max 2147483647); on Windows which<char16_t>() answered "wchar_t"
extern "C" import "stdio.h";
template <typename T> const char* which()
{
  if constexpr (std::isSame<T, wchar_t>)
    return "wchar_t";
  else if constexpr (std::isSame<T, char16_t>)
    return "char16_t";
  else if constexpr (std::isSame<T, char32_t>)
    return "char32_t";
  else
    return "other";
}
int main()
{
  printf("%s %s %s\n", which<char16_t>(), which<char32_t>(), which<wchar_t>());
  return 0;
}
