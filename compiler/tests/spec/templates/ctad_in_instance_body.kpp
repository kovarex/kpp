// spec: class template argument deduction in a class template's member function: `if (Failed result = this->canSet(i))` deduces Failed<Result> in each instance's body, and the declaration's uses there (its contextual conversion to bool) see Failed<Result>
// factorio: SelectListGui<IDType>'s `if (Failed result = this->canSet(id))` (10 instances) and FilterSelectGui (3)
class Result
{
public:
  enum class Enum { Undefined, Success, Fail };
  using enum Enum;
  Result() : result(Undefined) {}
  implicit Result(Enum result) : result(result) {}
  bool failed() const { return this.result == Fail; }
private:
  Enum result;
};
template<typename T = Result>
class Failed
{
public:
  implicit Failed(T&& result) : result(::move(result)) {}
  operator bool() const { return this.result.failed(); }
  implicit operator T() { return this.result; }
  T result;
};
template<class IDType>
class SelectList
{
public:
  Function<Result(IDType)> canSet;
  SelectList(Function<Result(IDType)> canSet) : canSet(canSet) {}
  int count(IDType n)
  {
    int failures = 0;
    for (IDType i = 0; i < n; ++i)
      if (Failed result = this.canSet(i))
        ++failures;
    return failures;
  }
};
int main()
{
  SelectList<int> list([](int id) -> Result { return id > 2 ? Result::Fail : Result::Success; });
  println(list.count(5));
  return 0;
}
