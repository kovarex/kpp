// spec: a constructor template's `explicit(cond)` is decided with its template arguments deduced from the argument: Optional's `explicit(!isConvertible<U, T>) Optional(U&& v)` converts a NamedBool's enumerator to an Optional<NamedBool> parameter implicitly (U = const Enum&, which converts to the NamedBool), and is explicit for a type T takes only explicitly, which then leaves the other overload
// found in the converted game: BuildingRenderer::drawEntityToBeBuilt(gameView, player, params, TooFar::False, ...) with an `Optional<TooFar> tooFar` parameter, TooFar a NamedBool (5 calls in BuildingRenderer, CliffEditor, EditorBase, ResourceEditor did not resolve)
template<class Tag>
class NamedBool
{
public:
  enum class Enum : uint8_t { False, True };
  static constexpr Enum True = Enum::True;
  static constexpr Enum False = Enum::False;
  constexpr NamedBool() = default;
  implicit constexpr NamedBool(Enum value) : value(value == Enum::True) {}
  constexpr operator bool() const { return this->value; }
private:
  bool value = false;
};
using TooFar = NamedBool<class TooFarTag>;
struct Strict
{
  int v;
  Strict(int v) : v(v) {}
};
template<typename T>
struct Opt
{
  bool set = false;
  Opt() {}
  template<typename U = T>
  implicit(isConvertible<U, T>) Opt(U&& v) requires(!isSame<RemoveCvRef<U>, T> && isConstructible<T, U>) { this->set = true; }
};
int take(Optional<TooFar> t) { return t.hasValue() ? (bool(*t) ? 2 : 1) : 0; }
int pick(Opt<Strict> o) { return o.set ? 10 : 11; }
int pick(long l) { return 20; }
int main()
{
  const TooFar::Enum e = TooFar::True;
  println(take(TooFar::False), " ", take(e), " ", pick(5), " ", pick(Opt<Strict>(5)));
  return 0;
}
