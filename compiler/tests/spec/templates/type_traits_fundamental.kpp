// spec: isFundamental, isTriviallyDestructible, isTriviallyCopyAssignable, isTriviallyDefaultConstructible
// factorio: is_fundamental_v, is_trivially_destructible_v used in Serialiser/Container code
class Simple { int x; };
class NonTrivial { ~NonTrivial() { } };
class WithCtor { WithCtor(int x) { } };

int main()
{
  // isFundamental
  static_assert(std::isFundamental<int>);
  static_assert(std::isFundamental<float>);
  static_assert(std::isFundamental<bool>);
  static_assert(!std::isFundamental<Simple>);

  // isTriviallyDestructible
  static_assert(std::isTriviallyDestructible<int>);
  static_assert(std::isTriviallyDestructible<Simple>);
  static_assert(!std::isTriviallyDestructible<NonTrivial>);

  // isTriviallyCopyAssignable (uses isTriviallyCopyable under the hood)
  static_assert(std::isTriviallyCopyAssignable<int>);
  static_assert(std::isTriviallyCopyAssignable<Simple>);

  // isTriviallyDefaultConstructible
  static_assert(std::isTriviallyDefaultConstructible<int>);
  static_assert(std::isTriviallyDefaultConstructible<Simple>);

  std::println("type traits: ok");
  return 0;
}
