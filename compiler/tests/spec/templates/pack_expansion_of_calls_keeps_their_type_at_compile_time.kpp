// spec: a pack expansion whose pattern is a call, `sumAll((sumAll(args, 1))...)`, gives each call's own type at compile time as at run time: with args a double 4.75, sumAll(4.75, 1) is the double 5.75 and the outer sum 5.75, and with (short 1, 4.75, 9u) 17.75 (clang's)
// pending: the constant evaluation gives 5 and 17: each expanded call's double result is taken as an int (run time gives 5.75 and 17.75). A silent wrong answer, found by the differential tests' genpack.py seed 5 (compiler/tests/differential), 2026-11-16; seed 7's `pat3` makes it an error instead ("a floating value out of the range of int32"); D
extern "C" int printf(const char* format, ...);
template <typename... Ts> constexpr auto sumAll(Ts... a)
{
  return (0 + ... + a);
}
template <typename... Ts> constexpr auto pat(Ts... args)
{
  return sumAll((sumAll(args, 1))...);
}
int main()
{
  constexpr auto one = pat(4.75);
  constexpr auto three = pat((short)1, 4.75, 9u);
  volatile int zero = 0;
  printf("%g %g | %g %g\n", (double)one, (double)three, (double)pat(4.75 + zero), (double)pat((short)1, 4.75 + zero, 9u));
  return 0;
}
