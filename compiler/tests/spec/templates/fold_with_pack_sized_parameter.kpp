// spec: a fold expression over a class template's pack (`(OrderList::update<Ts>(lists[OrderList::getIndex<Ts>()], sum), ...)`) in a member whose parameter's type depends on the pack's size (`Array<Entry, size>&` with `static constexpr size_t size = sizeof...(Ts)`): the parameter keeps its type in every element of the expansion
// factorio: EntityOrderHelpers::EntityOrderList<LogisticRobot, ConstructionRobot, Inserter, ...>::update and getTimes (Surface/ActiveEntitiesOrder.hpp, the order in which active entities update)
// pending: without the fold the call works; inside it the parameter's type is re-made where the pack has one element ("the layout of Array<Entry, <unknown>>: the argument for N is a constant the compiler could not evaluate"), also with sizeof...(Ts) written in the parameter; owner: the templates thread (pack expansion)
struct Entry
{
  int value = 0;
};
namespace Helpers
{
  template <typename... >
  struct index;
  template <typename T, typename... R>
  struct index<T, T, R...> : IntegralConstant<size_t, 0> {};
  template <typename T, typename F, typename... R>
  struct index<T, F, R...> : IntegralConstant<size_t, 1 + index<T, R...>::value> {};

  template<class... Ts>
  struct OrderList
  {
    static constexpr size_t size = sizeof...(Ts);
    template<class T>
    static constexpr size_t getIndex() { return index<T, Ts...>::value; }
    template<class T>
    static void update(Entry& entry, int& sum) { sum = sum * 10 + entry.value; }
    static void update(Array<Entry, size>& lists, int& sum)
    {
      (OrderList::update<Ts>(lists[OrderList::getIndex<Ts>()], sum), ...);
    }
  };
}
struct A {};
struct B {};
struct C {};
using Order = Helpers::OrderList<A, B, C>;
int main()
{
  Array<Entry, 3> lists;
  lists[0].value = 1;
  lists[1].value = 2;
  lists[2].value = 3;
  int sum = 0;
  Order::update(lists, sum);
  println("{} {}", sum, int(Order::getIndex<C>()));
  return 0;
}
