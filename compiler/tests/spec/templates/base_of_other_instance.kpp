// spec: an instance of a class template is no base of another instance of it, nor of a class derived from another instance (isBaseOf<Flag<A>, Flag<B>> is false), so neither converts to the other as derived to base
// factorio: found tracing ActionData's loadArg overloads on NamedBool<Tag> instances (BeltPowerReplace, SkipFogOfWar, ...): the trait and derived-to-base checks matched any two instances of one template
template<class Tag>
class Flag
{
public:
  bool value = false;
};
struct DragTag {};
struct BeltTag {};
template<class T>
struct Holder : Flag<T> {};
struct Shape {};
struct Square : Shape {};
static int pick(const Flag<DragTag>*) { return 1; }
static int pick(const Flag<BeltTag>*) { return 2; }
int main()
{
  static_assert(!isBaseOf<Flag<BeltTag>, Flag<DragTag>>);
  static_assert(isBaseOf<Flag<BeltTag>, Flag<BeltTag>>);
  static_assert(isBaseOf<Flag<BeltTag>, Holder<BeltTag>>);
  static_assert(!isBaseOf<Flag<BeltTag>, Holder<DragTag>>);
  static_assert(isBaseOf<Shape, Square> && !isBaseOf<Square, Shape>);
  Holder<DragTag> drag;
  Holder<BeltTag> belt;
  println("{} {}", pick(&drag), pick(&belt));
  return 0;
}
