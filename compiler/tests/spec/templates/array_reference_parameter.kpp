// spec: a function template parameter that is a reference to an array, its element type and bound deduced: `template<typename T, size_t N> size_t size(const T (&array)[N])`
// factorio: std::size, std::begin and std::end of built-in arrays (SelectorCombinatorGui's modeOfOperationMapping, lookup tables)
template<typename T, size_t N>
constexpr size_t countOf(const T (&array)[N]) { return N; }
template<typename T, size_t N>
T* firstOf(T (&array)[N]) { return array; }
int main()
{
  int values[5] = {1, 2, 3, 4, 5};
  const char* names[] = {"a", "b"};
  println(countOf(values), " ", *firstOf(values), " ", countOf(names));
  return 0;
}
