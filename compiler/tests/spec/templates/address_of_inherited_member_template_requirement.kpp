// spec: `requires() { &T::f; }` where T's f is only a member template it inherits is not satisfied (`&T::f` names a template with no arguments and no target type to deduce them from, so it is no expression), and the `else` of an `if constexpr` on it is the branch taken, as in C++; a T with a plain member f satisfies it
// factorio: LuaBinder<T>::registerCommonMetaMethods's `if constexpr (requires() { &T::luaDebugChildren; })`, whose else takes &LuaBindableObject::luaDebugChildren<LuaBinder<T>> (61 errors in the tests build of 4c178a5b915: `@LuaBindableObject::luaDebugChildren<?>` undefined)
class Bindable
{
public:
  template<class Binder>
  int debugChildren(int x) { return Binder::scale * x; }
};
class Plain : public Bindable
{
};
class Own : public Bindable
{
public:
  int debugChildren(int x) { return x + 1; }
};
template<class T>
struct Binder
{
  static constexpr int scale = 10;
  static int call(T& object)
  {
    if constexpr (requires() { &T::debugChildren; })
      return (object.*(&T::debugChildren))(3);
    else
      return (object.*(&Bindable::debugChildren<Binder<T>>))(3) + 1000;
  }
};
int main()
{
  Plain plain;
  Own own;
  println(Binder<Plain>::call(plain), " ", Binder<Own>::call(own));
  return 0;
}
