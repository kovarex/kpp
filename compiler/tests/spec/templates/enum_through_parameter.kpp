// spec: a kpp enum reached through a template parameter: E::values, E::count, value.str()
enum class Dir : uint8_t
{
  { A, B, C }
};
template<typename E> std::String joined()
{
  std::String all;
  for (E v : E::values)
    all << std::StringView(v.str());
  return all;
}
template<typename E> int countOf() { return E::count; }
int main()
{
  std::println(joined<Dir>(), " ", countOf<Dir>());
  return 0;
}
