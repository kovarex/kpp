// spec: a fold of assignments whose operands have side effects at compile time: `(r += ... += next(i, a))` evaluates them from the last one back, `(place(a) *= ...)` assigns through a call
// pending: the evaluator takes only a pack named alone or a side-effect-free pattern (constFoldOfAssignments): "no constant", an error, never another order; the run-time form is right (fold_of_assignments_order_and_result)
extern "C" int printf(const char* format, ...);
constexpr int next(int& i, int v) { i = i * 10 + v; return v; }
constexpr int& place(int& v) { return v; }
template<typename... Ts> constexpr int order(Ts... a) { int i = 0; int r = 0; (r += ... += next(i, a)); return i; }
template<typename... Ts> constexpr int through(Ts... a) { (place(a) *= ...); return (0 + ... + a); }
constexpr int o = order(1, 2, 3);
constexpr int t = through(2, 3, 4);
int main()
{
  printf("%d %d\n", o, t);
  return 0;
}
