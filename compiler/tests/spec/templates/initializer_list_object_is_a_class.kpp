// spec: an InitializerList object is a class like any other: it converts to what has a constructor taking it, and to nothing else; only a braced list converts through its elements (overload ranking treated the object as the list, so isConvertible said true of a StringView, and a call chose such an overload); as C++ has std::initializer_list
class P { };
struct Takes { Takes(std::InitializerList<int> l) : n(int(l.size())) {} int n; };
struct Implicit { implicit Implicit(std::InitializerList<int> l) : n(int(l.size())) {} int n; };
int count(std::InitializerList<int> l) { return int(l.size()); }
int pick(std::StringView) { return 1; }
int pick(std::InitializerList<int>) { return 2; }
int pick2(std::StringView) { return 1; }
int pick2(...) { return 3; }
int main()
{
  std::println(std::isConvertible<const std::InitializerList<P*>&, std::StringView>);
  std::println(std::isConvertible<const std::InitializerList<int>&, std::StringView>);
  std::println(std::isConvertible<std::InitializerList<int>, int>);
  std::println(std::isConvertible<std::InitializerList<int>, std::Vector<int>>);
  std::println(std::isConvertible<std::InitializerList<int>, std::Vector<char>>);
  std::println(std::isConvertible<std::InitializerList<int>, Implicit>);
  std::println(std::isConvertible<std::InitializerList<int>, std::InitializerList<int>>);
  std::InitializerList<int> l = {1, 2, 3};
  std::println(count(l), " ", count({1, 2}), " ", pick(l), " ", pick2(l));
  auto both = {4, 5};
  std::println(count(both));
  std::Vector<int> v = l;
  std::Vector<int> w(both);
  Implicit i = l;
  std::println(v.size(), " ", w.size(), " ", i.n);
  Takes t(l);
  std::println(t.n);
  return 0;
}
