// found by thread J's template generator (2026-11-07): only a name's last qualifier outside a call was checked, so a call's callee took the first declared silently (S<const int, int*>::v() was 1)
template<class T, class U> struct S { static int v() { return 0; } struct Inner { static int w() { return 0; } }; };
template<class T, class U> struct S<const T, U> { static int v() { return 1; } struct Inner { static int w() { return 1; } }; };
template<class T, class U> struct S<T, U*> { static int v() { return 2; } struct Inner { static int w() { return 2; } }; };
template<class T> int g() { return S<const T, T*>::v(); }
int main()
{
  int a = S<const int, int*>::v();
  int b = S<const char, char*>::Inner::w();
  int (*f)() = &S<const int, char*>::v;
  [[maybe_unused]] S<const long, long*>::Inner x;
  return a + b + f() + g<int>();
}
