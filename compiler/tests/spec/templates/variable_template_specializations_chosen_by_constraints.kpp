// spec: a variable template's partial specializations are chosen by their constraints too ([temp.spec.partial.match] 2, [temp.func.order] 6.2.2): `template<Integral T> constexpr int kind<T>` matches only an integral T, `template<typename T> requires Integral<T> && Big<T> constexpr int kind<T>` is the more constrained of the two, and a requires clause on `pointee<T*>` limits it to the pointers it holds for; a constrained primary takes what satisfies it (clang's output)
// found by D's concepts battery against clang (2026-11-10): the parser dropped a variable template's requires clause and the resolver never checked its parameters' constraints, so `kind<double>` was 1 with one constrained specialization, silently, and "not a constant yet" with two
template<typename T>
concept Integral = std::IsSame<T, int>::value || std::IsSame<T, long>::value || std::IsSame<T, char>::value;
template<typename T>
concept Big = sizeof(T) >= 4;
template<typename T>
constexpr int kind = 0;
template<Integral T>
constexpr int kind<T> = 1;
template<typename T>
  requires Integral<T> && Big<T>
constexpr int kind<T> = 2;
template<typename T>
constexpr int pointee = 0;
template<typename T>
  requires(sizeof(T) >= 8)
constexpr int pointee<T*> = 8;
template<typename T>
  requires Big<T>
constexpr int size = int(sizeof(T));

int main()
{
  std::println(kind<double>, " ", kind<char>, " ", kind<long>, " ", kind<int>);
  std::println(pointee<char*>, " ", pointee<double*>, " ", pointee<int>, " ", size<int>, " ", size<double>);
  return 0;
}
