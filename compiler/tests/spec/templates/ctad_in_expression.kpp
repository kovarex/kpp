// spec: class template argument deduction in an expression, not only a declaration: `Pair(a, b)` as a call argument, `Span(p, n)` in a return
// found in src/Util (MathExpressions/Tokenizer: `second.find(Pair(firstChar, nextChar))`, Evaluator: Span of the last arguments)
int sumPair(const std::Pair<int, int>& p) { return p.first + p.second; }
std::Span<int> tail(std::Vector<int>& v, int n) { return std::Span(v.end() - n, n); }
int main()
{
  std::Vector<int> v;
  v.push_back(1);
  v.push_back(2);
  v.push_back(3);
  std::Span<int> last = tail(v, 2);
  std::println(sumPair(std::Pair(3, 4)), " ", last.size(), " ", last[1]);
  return 0;
}
