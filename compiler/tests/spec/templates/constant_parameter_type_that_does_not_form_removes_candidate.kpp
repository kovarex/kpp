// spec: a constant template parameter whose type does not form for the arguments takes its template out of the overloads, a defaulted one too ([temp.deduct] 7, 8): two overloads `template<typename T, EnableIfT<cond, int> = 0>` with opposite conditions choose by sizeof(T), and a `TypeOf<T> = 0` parameter of a T without the member gives way to the ellipsis (clang's output)
// found by A's batteries (2026-11-10, the pending templates/enable_if_constant_parameter_removes_candidate) and D's: both overloads stayed candidates, "ambiguous", as the parameter's type was never typed under the arguments
template<bool B, typename T = void>
struct EnableIf
{
};
template<typename T>
struct EnableIf<true, T>
{
  using type = T;
};
template<bool B, typename T = void>
using EnableIfT = typename EnableIf<B, T>::type;
template<typename T, EnableIfT<(sizeof(T) > 2), int> = 0>
int size(T) { return 1; }
template<typename T, EnableIfT<(sizeof(T) <= 2), int> = 0>
int size(T) { return 2; }
template<typename T>
using TypeOf = typename T::type;
struct WithType
{
  using type = int;
};
template<typename T, TypeOf<T> = 0>
int member(T) { return 1; }
int member(...) { return 2; }

int main()
{
  std::println(size(5), " ", size('c'), " ", size(5.0), " ", member(WithType()), " ", member(5));
  return 0;
}
