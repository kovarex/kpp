// spec: a lambda with a template parameter list called through `.operator()<T>(...)` (or `->operator()<T>(...)`) takes the written template arguments, the rest deduced from the call's arguments; each set of arguments is its own instance, also when no parameter mentions the template parameter
// found in tests/TestDeconstruction (`auto runTest = []<class T>(const char* name) { ... }`, called `runTest.operator()<CraftingMachine>("electric-furnace")` and three more)
struct A { int v = 1; static const char* kind() { return "A"; } };
struct B { int v = 20; static const char* kind() { return "B"; } };
int main()
{
  int total = 0;
  auto runTest = [&]<class T>(const char* name)
  {
    T t;
    total += t.v;
    println("{} {}", name, T::kind());
  };
  runTest.operator()<A>("first");
  runTest.operator()<B>("second");
  auto* pointer = &runTest;
  pointer->operator()<A>("third");
  auto scaled = []<class T, class U>(U factor) { T t; return t.v * factor; };
  println("{} {} {}", total, scaled.operator()<B>(2), scaled.operator()<A, double>(1.5));
  return 0;
}
