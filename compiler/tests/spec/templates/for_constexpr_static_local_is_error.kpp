// spec: a `static` or `thread_local` variable in a `for constexpr` body is an error for now: the body is instantiated once per element, so each element has its own, and one variable shared by the elements was a silent wrong answer
// found by D's review of 54bf0d81 (2026-11-09)
// error: for_constexpr_static_local_is_error.kpp:11: error: a static or thread_local variable in a `for constexpr` body: one variable per element is not built yet
// error: for_constexpr_static_local_is_error.kpp:13: error: a static or thread_local variable in a `for constexpr` body: one variable per element is not built yet
// error: for_constexpr_static_local_is_error.kpp:22: error: a static or thread_local variable in a `for constexpr` body: one variable per element is not built yet
int plainFunction()
{
  int total = 0;
  for constexpr (int v : {1, 2})
  {
    static int count = 0;
    count += v;
    thread_local int other = 0;
    total += count + other;
  }
  return total;
}
template<typename... Ts>
int instance()
{
  for constexpr (typename E : types<Ts...>)
    static E held{};
  return 0;
}
int main()
{
  return plainFunction() + instance<int, double>();
}
