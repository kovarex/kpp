// spec: `typename Container::mapped_type` of a class that inherits it from Map (`template<class T> struct Const : T` over a Map) is Map's mapped_type, in the return type and in an expression
// factorio: EntityPrototype::postLoadSetup's `Util::getMapOrDefault(UtilityConstants::instance().defaultAlertIconShiftByType, this->getType())`, the constant a Const<std::map<std::string, Vector>> (UtilityConstants::Const derives from a non-arithmetic T), getMapOrDefault returning `typename Container::mapped_type`
template<class T, bool exclude = false>
struct Const : T
{
  Const(T value) : T(std::move(value)) {}
};
template<typename Container, typename Key>
typename Container::mapped_type getMapOrDefault(const Container& theMap, const Key& keyToFind)
{
  auto it = theMap.find(keyToFind);
  if (it == theMap.end())
    return typename Container::mapped_type();
  return it->second;
}
int main()
{
  Const<std::Map<std::String, int>> shifts(std::Map<std::String, int>{{"inserter", 4}});
  int shift = 0;
  shift = getMapOrDefault(shifts, "inserter");
  std::println(shift);
  return 0;
}
