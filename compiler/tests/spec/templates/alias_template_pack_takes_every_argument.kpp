// spec: an alias template's parameter pack takes every argument from its place on, none when none is written: `template<typename... T> using Same = Count<T...>` makes Same<char, short> Count<char, short> and Same<> Count<>, `using PlusOne = Count<int, T...>` and `using PlusEnd = Count<T..., int>` add one; a pack expanded into it (`Same<U...>`) is spliced, and the type is the class template's instance itself (a specialisation for it is picked, a function deduces from it). Before, the pack took the first argument alone (Same<char, short> was Count<char>, Same<> Count<T> with T unbound): a silent wrong answer. clang prints the same
// found comparing kpp with clang (thread I's battery i8)
template<typename... T> struct Count { static constexpr int value = sizeof...(T); };
template<typename... T> using Same = Count<T...>;
template<typename... T> using PlusOne = Count<int, T...>;
template<typename... T> using PlusEnd = Count<T..., int>;
template<typename A, typename... T> using AfterFirst = Count<T...>;
template<typename T> struct Is { static constexpr int value = 0; };
template<> struct Is<Count<int, char, short>> { static constexpr int value = 1; };
template<typename... T> int countOf(Count<T...>) { return sizeof...(T); }
template<typename... U> int forwarded() { return Same<U...>::value * 10 + PlusOne<U...>::value; }
int main()
{
  println(Same<>::value, " ", Same<char, short>::value, " ", PlusOne<>::value, " ", PlusOne<char>::value, " ", PlusOne<char, short>::value);
  println(PlusEnd<>::value, " ", PlusEnd<char, short>::value, " ", AfterFirst<char>::value, " ", AfterFirst<char, short, int>::value);
  println(Is<PlusOne<char, short>>::value, " ", countOf(PlusOne<char, short>()), " ", forwarded<>(), " ", forwarded<char, short, int>());
  return 0;
}
