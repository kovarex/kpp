// spec: a comma fold over a class with an operator, of its own has the type of the chain's last call, as C++ instantiates `E0 , (E1 , E2)`: here Mark, whose member the result is read through (`(args , ...).v`); clang's output
extern "C" int printf(const char* format, ...);
void event(char kind, int v) { printf("%c%d,", kind, v); }
struct Part { int v; };
struct Mark { int v; };
Mark operator,(Part a, Part b) { event('a', a.v * 10 + b.v); return Mark{a.v + b.v}; }
Mark operator,(Mark a, Part b) { event('b', a.v * 10 + b.v); return Mark{a.v + b.v}; }
Mark operator,(Part a, Mark b) { event('c', a.v * 10 + b.v); return Mark{a.v + b.v}; }
template<typename... Args> int rightComma(Args... args) { return (args , ...).v; }
template<typename... Args> int leftComma(Args... args) { return (... , args).v; }

int main()
{
  int r = rightComma(Part{1}, Part{2}, Part{3});
  printf(" %d\n", r);
  int l = leftComma(Part{1}, Part{2}, Part{3});
  printf(" %d\n", l);
  return 0;
}
