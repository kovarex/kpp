// spec: forwarding a string literal through a variadic member template into a String constructor (emplace_back("x"))
template<typename T>
struct MyStack
{
  std::Vector<T> items;
  template<typename... Args> T& push(Args&&... args) { return this.items.emplace_back(std::forward<Args>(args)...); }
};
int main()
{
  MyStack<std::String> names;
  names.push("a");
  std::Vector<std::String> direct;
  direct.emplace_back("bc");
  std::println(names.items[0], " ", direct[0]);
  return 0;
}
