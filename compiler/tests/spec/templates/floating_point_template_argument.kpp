// spec: a floating-point value as a template argument (C++20: `template<double D>` given 1.25, `template<float F>` given 0.5f, `template<auto A>` given 2.5): the instance's constant, its type's size. clang's and g++'s output (until 2026-11-08 codegen's "a template parameter whose value is not known here": the argument was none; templates/floating_point_template_argument_identity has which arguments are one instance)
extern "C" int printf(const char* format, ...);
template<auto A> int sizeOfAuto() { return (int)sizeof(A); }
template<double D> double twice() { return D * 2; }
template<float F> struct Scaled { static float apply(float x) { return x * F; } };
int main()
{
  printf("%d %.2f %.2f\n", sizeOfAuto<2.5>(), twice<1.25>(), (double)Scaled<0.5f>::apply(3.0f));
  return 0;
}
