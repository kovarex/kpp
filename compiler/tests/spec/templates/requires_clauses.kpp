// spec: constrained templates (requires clauses)
// factorio: 1274 requires/concept uses in 609 files
template<typename T> requires std::isIntegral<T>
T twice(T v) { return v * 2; }
template<typename T> requires (!std::isIntegral<T>)
std::String twice([[maybe_unused]] T v) { return std::String("not integral"); }
int main()
{
  std::println(twice(21), " ", twice(1.5));
  return 0;
}
