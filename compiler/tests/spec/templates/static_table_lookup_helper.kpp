// spec: a class's static const table keyed by StringView with a nested value struct, defined out of line from a brace list, read through a helper template with an `auto*` return
// found in src/Util (MathExpressions/Evaluator::NAMED_FUNCTIONS and Util::getMapOrNull)
namespace Util
{
  template<typename Container, typename Key>
  auto* getMapOrNull(Container& theMap, const Key& keyToFind)
  {
    auto it = theMap.find(keyToFind);
    return it == theMap.end() ? nullptr : &it->second;
  }
}
struct Table
{
  struct Entry
  {
    int weight;
  };
  static const std::Map<std::StringView, Entry> ENTRIES;
  int lookup(std::StringView name) const
  {
    if (const Entry* e = Util::getMapOrNull(This::ENTRIES, name))
      return e->weight;
    return -1;
  }
};
const std::Map<std::StringView, Table::Entry> Table::ENTRIES = {{"abs", Entry{1}}, {"log", Entry{2}}};
int main()
{
  Table t;
  std::println(t.lookup("abs"), " ", t.lookup("log"), " ", t.lookup("sin"));
  return 0;
}
