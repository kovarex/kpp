// spec: a generic lambda's operators are looked up from where the lambda is written (and by argument-dependent lookup), not from the template that first calls it: `a | b` on a scoped enum calls the operator| of the lambda's namespace (not the built-in bitwise or), and `a == b` on a struct finds the lambda's namespace's operator==, though a function template in another namespace instantiates the lambda
// factorio: generic lambdas passed to algorithm templates (std::sort, forEach) whose bodies use the enclosing namespace's operators
namespace Flags
{
  enum class Bits : int { None = 0, A = 1, B = 2 };
}
namespace Shapes
{
  struct Point { int x; int y; };
}
namespace Usage
{
  // Neither is in its operands' namespace: found from Usage only, not by argument-dependent lookup.
  // operator| answers 40, not the bitwise or's 3, so a call that skips it shows.
  Flags::Bits operator|(Flags::Bits x, Flags::Bits y) { return Flags::Bits(40); }
  bool operator==(const Shapes::Point& a, const Shapes::Point& b) { return a.x == b.x; }
}
namespace Algorithms
{
  // Not trivial (a loop), so it is no inlined call: it emits the lambda's instance itself.
  template<typename F, typename T> int callTwice(F f, T a, T b)
  {
    int total = 0;
    for (int i = 0; i < 2; ++i)
      total += int(f(a, b));
    return total / 2;
  }
}
namespace Usage
{
  int combined() { return Algorithms::callTwice([](auto a, auto b) { return a | b; }, Flags::Bits::A, Flags::Bits::B); }
  int sameX() { return Algorithms::callTwice([](auto a, auto b) { return a == b; }, Shapes::Point{1, 2}, Shapes::Point{1, 3}); }
}
int main()
{
  println("{} {}", Usage::combined(), Usage::sameX());
  return 0;
}
