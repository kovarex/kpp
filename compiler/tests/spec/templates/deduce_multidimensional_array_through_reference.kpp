// spec: a template's `const T&` parameter given a multidimensional built-in array deduces T as the whole array type (`Point[16][2]`, `Vector<int>[4][3][2]`), as for a one-dimensional one, so sizeof(T) is the array's size
// factorio: the prototype explorer's SKIP_VALUE(connectionPoints) in RailPrototype::addValues (`RailConnectionPoint connectionPoints[Direction::COUNT][2]`) and SKIP_VALUE(extensions) in RailPlannerPrototype::addValues (`std::vector<CandidateExtension> extensions[Direction::COUNT][RailLayer::LAYERS_COUNT][ALIGN_N]`), through Values::recordValue(const T& value, ...)
struct Point
{
  int x = 0;
  int y = 0;
};
struct Recorder
{
  static int record([[maybe_unused]] const char* address, [[maybe_unused]] const std::String& name, uint64_t size, [[maybe_unused]] uint64_t align) { return int(size); }
  template<class T>
  static int record(const T& value, const std::String& name) { return Recorder::record((const char*)(const void*)&value, name, sizeof(T), alignof(T)); }
};
int main()
{
  Point points[16][2];
  std::Vector<int> lists[4][3][2];
  int single[5] = {};
  std::println(Recorder::record(points, "points") == int(sizeof(points)), " ", Recorder::record(lists, "lists") == int(sizeof(lists)), " ", Recorder::record(single, "single"));
  return 0;
}
