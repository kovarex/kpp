// spec: direct-initialization takes a class's explicit conversion operators: isConstructible<const Expr*, Parsed> holds for `explicit operator const Expr*()`, so Pair's converting constructor (which requires it of its members) takes `emplace_back(&reg, Parsed())`, and its member initializer `second(forward<U2>(second))` converts through the operator
// factorio: tests/TestNoisePerformance.cpp's `Vector<Pair<NoiseRegisterIndex*, const NoiseExpression*>>::emplace_back(register, parsedExpression)` with ParsedNoiseExpression's `explicit operator const NoiseExpression*()`
struct Reg { int index = 0; };
struct Expr { int v = 0; };
Expr theExpr;
struct Parsed
{
  explicit operator const Expr*() const { return &theExpr; }
};
int main()
{
  Reg reg;
  reg.index = 3;
  theExpr.v = 7;
  Vector<Pair<Reg*, const Expr*>> pairs;
  pairs.emplace_back(&reg, Parsed());
  println(pairs[0].first->index, " ", pairs[0].second->v);
  return 0;
}
