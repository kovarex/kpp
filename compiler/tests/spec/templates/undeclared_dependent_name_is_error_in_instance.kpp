// spec: a call whose argument depends on a template parameter is looked up in each instance, argument-dependent lookup with the instance's types: describeIt<shapes::Circle> finds shapes::describe, describeIt<Square> finds nothing, an error at the name for that instance (C++ [temp.dep.candidate]; clang: "use of undeclared identifier 'describe'", in instantiation of describeIt<Square>)
// error: undeclared_dependent_name_is_error_in_instance.kpp:6: error: 'describe' is not declared (in T = Square
namespace shapes { struct Circle {}; int describe(Circle) { return 1; } }
struct Square {};
template<class T>
int describeIt(T value) { return describe(value); }
