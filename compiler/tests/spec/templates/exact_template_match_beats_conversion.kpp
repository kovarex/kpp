// spec: an exact match of a function template beats a non-template that needs a conversion (`template<class T> int pick(T&)` takes an int lvalue over `int pick(double)`); the non-template wins only when the two conversions tie
template<class T> int pick(T& value) { return 1; }
int pick(double value) { return 2; }

template<class T> int same(const T& value) { return 1; }
int same(const int& value) { return 2; }

int main()
{
  int i = 3;
  double l = 4;
  println(pick(i), " ", pick(l), " ", same(i));
  return 0;
}