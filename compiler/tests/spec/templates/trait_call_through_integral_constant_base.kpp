// spec: a trait read by constructing it, `HasSize<T>()` or `HasSize<T>{}` (its conversion to bool), is a constant when the trait's value comes from a base that is an instance of a class template (`struct HasSize : Constant<bool, false>`, `static constexpr T value = V; constexpr operator T() const`), directly or through an alias, so that `if constexpr` discards the other branch
// factorio: `is_std_variant<T>()`, `is_optional<T>()` and the game's other traits written as `trait<T>()` in DeserialiserHelper's if constexpr chains, once TrueType/FalseType are IntegralConstant<bool, ...> as in C++ (std::true_type): with them the discarded branches are compiled (+550 lines)
template<typename T, T V>
struct Constant
{
  static constexpr T value = V;
  constexpr operator T() const { return V; }
};
using No = Constant<bool, false>;
template<typename T> struct HasSize : No {};
template<typename T> struct HasSize<std::Vector<T>> : Constant<bool, true> {};
template<typename T>
int sizeOf(const T& value)
{
  if constexpr (HasSize<T>())
    return value.size();
  else
    return -1;
}
template<typename T>
int sizeOfBraces(const T& value)
{
  if constexpr (HasSize<T>{})
    return value.size();
  else
    return -2;
}
int main()
{
  std::Vector<int> v = {1, 2, 3};
  std::println(sizeOf(v), " ", sizeOf(2.5), " ", sizeOfBraces(v), " ", sizeOfBraces(2.5), " ", HasSize<char>::value);
  return 0;
}
