// spec: isInvocable and isInvocableR of a pointer to a member function take the object first (`isInvocableR<bool, bool (Widget::*)(int), Widget&, int>`), as std::is_invocable_r_v does, and are constants
// factorio: ActionsTriggeredByInputs::invokeMember since Factorio df1c9d1cd3c, `if constexpr (std::is_invocable_r_v<bool, MethodPtr, ClassType&, const Event&, ControlBinding, Args...>)` (22 headline errors)
struct Widget
{
  bool click(int x) { return x > 0; }
  bool press(int x, const String& s) { return x > 0 && !s.empty(); }
};
template<class ClassType, class MethodPtr, class... Args>
int invoke(MethodPtr method, ClassType* object, Args&&... args)
{
  if constexpr (isInvocableR<bool, MethodPtr, ClassType&, int, Args...>)
    return (object->*method)(1, forward<Args>(args)...) ? 2 : 1;
  else
    return 0;
}
int main()
{
  Widget w;
  String s = "x";
  println(invoke<Widget>(&Widget::click, &w), " ", invoke<Widget>(&Widget::press, &w, s));
  println(isInvocable<bool (Widget::*)(int), Widget&, int>, " ", isInvocableR<bool, bool (Widget::*)(int), Widget&, int>, " ", isInvocableR<bool, bool (Widget::*)(int), Widget&>, " ", isInvocable<bool (Widget::*)(int), int>);
  return 0;
}
