// spec: a requires-expression's compound requirement checks its result's type-constraint (`{ t.size() } -> Integral;` is Integral<decltype((t.size()))>), and a nested requirement (`requires sizeof(T) <= 2;`) must evaluate to true, not merely be well-formed ([expr.prim.req.compound], [expr.prim.req.nested]); so do the concepts made of them, in overloads, in if constexpr and as values
// factorio: thread J's concepts battery against clang (2026-11-06): the parser skipped `-> Constraint` and took a nested requirement for a simple one, so `HasSize<SizedWrong>` and `Small<int>` were true; clang's output
template<typename T>
struct IsInt
{
  static constexpr bool value = false;
};
template<>
struct IsInt<int>
{
  static constexpr bool value = true;
};
template<>
struct IsInt<char>
{
  static constexpr bool value = true;
};
template<typename T>
concept Integral = IsInt<T>::value;
template<typename T, typename U>
concept Same = IsSame<T, U>::value;
template<typename T>
concept HasSize = requires(const T& t) {
  t.size();
  { t.size() } -> Integral;
};
template<typename T>
concept SizeIsInt = requires(const T& t) {
  { t.size() } noexcept -> Same<int>;
};
template<typename T>
concept Small = requires { requires sizeof(T) <= 2; };
template<typename T>
concept SmallAndSized = HasSize<T> && requires { requires sizeof(T) <= 4; };
struct Sized
{
  int n;
  int size() const noexcept { return n; }
};
struct SizedWrong
{
  const char* size() const { return "no"; }
};
struct SizedChar
{
  char size() const { return 'c'; }
};
template<typename T>
int sizeOrZero(const T& t)
{
  if constexpr (HasSize<T>)
    return (int)t.size();
  else
    return -1;
}
template<typename T>
  requires Small<T>
int pick(T) { return 1; }
template<typename T>
int pick(T) { return 2; }
int main()
{
  println(HasSize<Sized>, " ", HasSize<SizedWrong>, " ", HasSize<SizedChar>, " ", HasSize<int>);
  println(SizeIsInt<Sized>, " ", SizeIsInt<SizedChar>);
  println(Small<char>, " ", Small<short>, " ", Small<int>, " ", SmallAndSized<Sized>, " ", SmallAndSized<SizedChar>);
  println(sizeOrZero(Sized{7}), " ", sizeOrZero(SizedWrong{}));
  println(pick('a'), " ", pick(1));
  return 0;
}
