// spec: function templates that differ only in a parameter that is not deduced rank by that parameter's conversion: `d * 2` takes `operator*(const D<R, P>&, int)` over the double one, `d * 1.5` the double one
// factorio: the library's Duration (duration times int or double), and any generic code overloaded on scalar types
template<typename R, typename P>
struct D4 { R t; };
template<typename R, typename P>
D4<R, P> operator*(const D4<R, P>& d, int f) { return D4<R, P>{d.t * f}; }
template<typename R, typename P>
D4<double, P> operator*(const D4<R, P>& d, double f) { return D4<double, P>{d.t * f}; }
int main()
{
  D4<long long, int> a{5};
  auto b = a * 2;
  auto c = a * 1.5;
  std::println(b.t, " ", c.t);
  return 0;
}
