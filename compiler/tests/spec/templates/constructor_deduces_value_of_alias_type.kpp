// spec: a constructor template's value parameter whose type is written as an alias (`template<Size N> View(T (&a)[N])`, Size naming unsigned through a class template's member type; `u32` fails the same way) is deduced from the bound of the array argument, as it is when the type is written `unsigned` or `int`
// factorio: the library's Span(T (&)[N]) and Span's Extent, whose type is the size (stdlib/core/Sizes.kpp's ContainerSize, an alias of u64); library/array_span's `Span<const int, 2> fixedRaw = raw;`. Span writes them `unsigned long long` until this passes
// pending: the constructor is not deduced: "codegen does not support a constructor of View taking 1 arguments yet" (D)
template<bool B, typename T, typename F>
struct Choose { using Type = T; };
template<typename T, typename F>
struct Choose<false, T, F> { using Type = F; };
using Size = typename Choose<true, unsigned, unsigned long long>::Type;

template<typename T, Size N>
Size countOf(T (&array)[N]) { return N; }

template<typename T>
struct View
{
  const T* items;
  Size length;
  template<Size N>
  implicit View(T (&a)[N]) : items(a), length(N) {}
};

int main()
{
  int raw[3] = {1, 2, 3};
  View<int> view = raw;
  println(countOf(raw), " ", view.length, " ", view.items[2]);
  return 0;
}
