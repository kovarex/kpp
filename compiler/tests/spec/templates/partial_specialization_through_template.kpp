// spec: a class template's partial specialization for its default argument (`struct Owner<T, Del<T>>`, with `template<class T, class D = Del<T>> struct Owner`) is one type wherever `Owner<int>` is reached: written directly, or returned by a function template as `Owner<T>`
// factorio: std::unique_ptr<T, D> with a std::default_delete specialization that stays one pointer (the library's UniquePtr was written to call stateless deleters instead, since Kpp has no empty-base optimization)
// pending: the value returned by make<T>() does not initialize an `Owner<int>` (codegen: a constructor of Owner taking 1 arguments), as if the two were different classes
template<typename T>
struct Del
{
};
template<typename T, typename D = Del<T>>
struct Owner
{
  T* pointer = nullptr;
  D deleter;
  explicit Owner(T* object) : pointer(object) {}
  int which() const { return 1; }
};
template<typename T>
struct Owner<T, Del<T>>
{
  T* pointer = nullptr;
  explicit Owner(T* object) : pointer(object) {}
  Owner(Owner<T>&& other) : pointer(other.pointer) { other.pointer = nullptr; }
  int which() const { return 2; }
};
template<typename T>
Owner<T> make(T* p) { return Owner<T>(p); }
int main()
{
  int value = 7;
  Owner<int> direct(&value);
  Owner<int> made = make(&value);
  println("{} {} {} {}", direct.which(), made.which(), make(&value).which(), *made.pointer);
  return 0;
}
