// spec: a converting constructor template whose requires-clause does not hold is no conversion in overload resolution: with overloads taking a String and a Wrapper that converts from anything but a pointer, a string literal takes the String one and a number the Wrapper one
// factorio: Function's converting constructor takes only callables, as std::function's (library/function_takes_only_callables): a string literal passed where overloads take a String and a std::function<void()>
struct Wrapper
{
  int kind = 0;
  template<typename F>
  implicit Wrapper(F f) requires(!isPointer<F>) : kind(1) {}
};
void take(const String& text) { println("string {}", text); }
void take(Wrapper wrapper) { println("wrapper {}", wrapper.kind); }
int main()
{
  take("text");
  take(5);
  return 0;
}
