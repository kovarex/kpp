// spec: a member type of a class whose base is a type trait (`struct Const : Conditional<isIntegral<T>, Value<T>, T>`) is the member of the class the trait picks (`Const<Map<String, int>>::mapped_type` is the Map's), as written and as a template parameter's member (`Container::mapped_type` with Container = Const<Map<String, int>>)
// factorio: UtilityConstants::Const<T> over a Map (Util::getMapOrDefault<Const<Map<String, TinyVector>>, const char*> in EntityPrototype::postLoadSetup)
template <class T>
struct Value
{
  T storage;
};
template <class T>
struct Const : std::Conditional<std::isIntegral<T>, Value<T>, T>
{
};
struct Plain : std::Conditional<false, int, std::Map<std::String, int>>
{
};
template <typename Container, typename Key, typename V>
V getOr(const Container& m, const Key& key, const V& def)
{
  auto it = m.find(key);
  return it == m.end() ? def : it->second;
}
template <typename Container, typename Key>
Container::mapped_type getOr(const Container& m, const Key& key)
{
  using V = Container::mapped_type;
  return getOr(m, key, V{});
}
int main()
{
  Const<std::Map<std::String, int>> c;
  c["a"] = 5;
  Const<std::Map<std::String, int>>::mapped_type x = 3;
  Plain::mapped_type y = 4;
  const char* a = "a";
  const char* b = "b";
  std::println(x, " ", y, " ", getOr(c, a), " ", getOr(c, b));
  return 0;
}
