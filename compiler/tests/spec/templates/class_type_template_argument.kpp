// factorio: thread J's constexpr battery against clang (2026-11-06); clang's output
struct Fixed
{
  int whole;
  int fraction;
};
template<Fixed F>
int scaled() { return F.whole * 100 + F.fraction; }
template<Fixed F>
struct Tagged
{
  static int count() { return F.whole + F.fraction; }
};
constexpr Fixed twoTen{2, 10};
int main()
{
  println(scaled<Fixed{3, 14}>(), " ", scaled<twoTen>(), " ", Tagged<Fixed{2, 10}>::count());
  return 0;
}
