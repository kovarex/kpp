// spec: a static member function of a class template, named in an instance's member, binds to a reference parameter (`const auto& pred`, `const Pred& pred`) as that instance's function, as in C++
// factorio: SetupModifiersBaseValue<...>'s `Util::stableSort(modifiersOfType, technologyDepthOrder)` since Factorio df1c9d1cd3c (5 headline errors)
template<class Value>
void sortWith(Vector<Value>& container, const auto& pred)
{
  stableSort(container.begin(), container.end(), pred);
}
template<typename Tag>
class Tech
{
public:
  struct Location
  {
    int depth;
  };
  static bool depthOrder(const Location& a, const Location& b) { return a.depth < b.depth; }
  static void sortAll(Vector<Location>& all) { sortWith(all, depthOrder); }
};
struct AmmoTag;
int main()
{
  Vector<Tech<AmmoTag>::Location> all = {{3}, {1}, {2}};
  Tech<AmmoTag>::sortAll(all);
  println(all[0].depth, " ", all[1].depth, " ", all[2].depth);
  return 0;
}
