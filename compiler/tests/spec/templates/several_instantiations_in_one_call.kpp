// spec: three instantiations of one function template as arguments of a single variadic call
struct Big { int v = 2; };
template<typename T> const char* describe(const T&) { if constexpr (std::isPointer<T>) return "pointer"; else if constexpr (std::isSame<T, Big>) return "big"; else return "value"; }
int main()
{
  Big b;
  std::println(std::StringView(describe(&b)), " ", std::StringView(describe(b)), " ", std::StringView(describe(1)));
  return 0;
}
