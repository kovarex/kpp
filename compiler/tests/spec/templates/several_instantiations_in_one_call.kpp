// spec: three instantiations of one function template as arguments of a single variadic call
struct Big { int v = 2; };
template<typename T> const char* describe(const T&) { if constexpr (isPointer<T>) return "pointer"; else if constexpr (isSame<T, Big>) return "big"; else return "value"; }
int main()
{
  Big b;
  println(StringView(describe(&b)), " ", StringView(describe(b)), " ", StringView(describe(1)));
  return 0;
}
