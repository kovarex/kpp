// spec: a `for constexpr` in a lambda written in a function, a template's instance or a plain one: the loop's body is typed once per element in the lambda as in the function itself; an instantiation is emitted from a private copy, whose lambda the loop retypes (the instantiation's own copy, which other threads read, was retyped in place: retypedPerElement looked at statements, not into lambdas), a plain function's own nodes are retyped in place as before
struct A { int v; };
struct B { int v; };
inline void show(int x) { std::println(x); }
inline void show(const A& a) { std::println("A", a.v); }
inline void show(const B& b) { std::println("B", b.v); }

template<typename T>
void typesInLambda()
{
  auto g = [&]() { for constexpr (typename E : types<A, T, B>) show(E{4}); };
  g();
}

int plain()
{
  int sum = 0;
  auto g = [&]() { for constexpr (int v : {1, 5, 9}) sum += v; };
  g();
  return sum;
}

int main()
{
  typesInLambda<int>();
  std::println(plain());
  return 0;
}
