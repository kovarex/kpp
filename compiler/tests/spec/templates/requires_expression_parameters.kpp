// spec: a requires-expression with a parameter list (`requires (T& t) { t.begin(); }`) is true exactly when its requirements are valid for T, and a requires clause using it removes the overload otherwise
// factorio: the library's free begin/end/size (std::begin...), which must step aside for the game's own free begin(ReversionWrapperByReference<T>) overloads; concept-style checks across Util
template<typename T>
constexpr bool hasBegin = requires (T& t) { t.begin(); };
template<typename T>
struct Reversed { T* iterable; };
template<typename C> requires hasBegin<C>
int which([[maybe_unused]] C& c) { return 1; }
template<typename T>
int which([[maybe_unused]] Reversed<T> w) { return 2; }
int main()
{
  std::Vector<int> v;
  Reversed<std::Vector<int>> r{&v};
  std::println(hasBegin<std::Vector<int>>, " ", hasBegin<int>, " ", which(v), " ", which(r));
  return 0;
}
