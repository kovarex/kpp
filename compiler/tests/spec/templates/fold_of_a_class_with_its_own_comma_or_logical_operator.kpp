// spec: a fold over `,`, `&&` or `||` of a class with such an operator of its own is the chain of its calls, as C++ writes it: `(args , ...)` is E0 , (E1 , E2), `(... && args)` is (E0 && E1) && E2
// pending: codegen's fold takes these three operators as the built-in ones: a class's operator is never called ("a conversion from Flag to bool", and silently where the class converts to bool or the comma's value is not used), found comparing folds with clang (thread B, 2026-11-09); clang's output
extern "C" int printf(const char* format, ...);
void event(char kind, int v) { printf("%c%d,", kind, v); }
struct Part { int v; };
struct Mark { int v; };
Mark operator,(Part a, Part b) { event('a', a.v * 10 + b.v); return Mark{a.v + b.v}; }
Mark operator,(Mark a, Part b) { event('b', a.v * 10 + b.v); return Mark{a.v + b.v}; }
Mark operator,(Part a, Mark b) { event('c', a.v * 10 + b.v); return Mark{a.v + b.v}; }
template<typename... Args> int rightComma(Args... args) { return (args , ...).v; }
struct Flag { int v; };
Flag operator&&(Flag a, Flag b) { event('n', a.v * 10 + b.v); return Flag{a.v * b.v}; }
Flag operator||(Flag a, Flag b) { event('o', a.v * 10 + b.v); return Flag{a.v + b.v}; }
template<typename... Args> int leftAnd(Args... args) { return (... && args).v; }
template<typename... Args> int rightAnd(Args... args) { return (args && ...).v; }
template<typename... Args> int leftOr(Flag init, Args... args) { return (init || ... || args).v; }
template<typename... Args> int rightOr(Flag init, Args... args) { return (args || ... || init).v; }

class Truth
{
public:
  int v;
  Truth(int v) : v(v) {}
  operator bool() const { event('t', this.v); return this.v != 0; }
};

template<typename... Args> bool builtinAnd(Args... args) { return (args && ...); }
template<typename... Args> bool builtinOr(Args... args) { return (args || ...); }

class Mem
{
public:
  int a = 1;
  int b = 2;
};

template<typename... Args> int dotStar(Mem& m, Args... members) { return (... + (m.*members)); }
enum class Color { Red = 1, Green = 2, Blue = 4 };
Color operator|(Color a, Color b) { return Color(int(a) * 10 + int(b)); }
int operator+(Color a, int b) { return int(a) * 10 + b; }
int operator+(int b, Color a) { return b * 10 + int(a); }
template<typename... Args> int enumBits(Args... args) { return int((args | ...)); }
template<typename... Args> int enumLeft(Args... args) { return int((... | args)); }
template<typename... Args> int enumInit(Args... args) { return (0 + ... + args); }

int main()
{
  int v2 = rightComma(Part{1}, Part{2}, Part{3});
  printf(" %d\n", v2);
  int v3 = leftAnd(Flag{1}, Flag{2}, Flag{3});
  printf(" %d\n", v3);
  int v4 = rightAnd(Flag{1}, Flag{2}, Flag{3});
  printf(" %d\n", v4);
  int v5 = leftOr(Flag{9}, Flag{1}, Flag{2});
  printf(" %d\n", v5);
  int v6 = rightOr(Flag{9}, Flag{1}, Flag{2});
  printf(" %d\n", v6);
  bool b1 = builtinAnd(Truth(1), Truth(0), Truth(2));
  printf(" %d\n", b1);
  bool b2 = builtinOr(Truth(0), Truth(3), Truth(4));
  printf(" %d\n", b2);
  Mem m;
  printf("%d\n", dotStar(m, &Mem::a, &Mem::b));
  printf("%d %d %d\n", enumBits(Color::Red, Color::Green, Color::Blue), enumLeft(Color::Red, Color::Green, Color::Blue), enumInit(Color::Red, Color::Green));
  return 0;
}
