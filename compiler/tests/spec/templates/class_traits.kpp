// spec: the traits that read a class's members: isClass, isPolymorphic, isAbstract, isFinal, isMove/CopyConstructible, isMove/CopyAssignable (plain, Trivially, Nothrow), isInvocable, isInvocableR
// factorio: static_assert(isMoveConstructible<T>) on 20 message types, FlatMap's requires (isClass<K>), if constexpr (isInvocable<F, Args>) in SaveLoadHelper and PtreeUtil, isPolymorphic in the prototype explorer
struct Plain { int x; double y; };
class Shape { public: virtual ~Shape() {} virtual double area() const = 0; };
class Square : public Shape { public: double side = 1; double area() const override { return this.side * this.side; } };
class Flat final : public Square { public:};
template<typename T> class Source { public: virtual T next(T seed) = 0; };
class Counter : public Source<int> { public: int next(int seed) override { return seed + 1; } };
class Half : public Source<int> { public: double next(double seed) { return seed / 2; } }; // overloads, does not override
struct NoMove { NoMove() {} NoMove(NoMove&&) = delete; };
struct CopyOnly { CopyOnly() {} CopyOnly(const CopyOnly&) {} }; // no implicit move: the copy constructor moves
struct Holder { NoMove inner; };
struct Logged { Logged() {} ~Logged() {} Logged(Logged&&) noexcept {} Logged& operator=(Logged&&) { return this; } };
struct WithRef { int& r; };
struct WithConst { const int c = 1; };
struct Adder { int operator()(int a, int b) const { return a + b; } };
int twice(int x) { return 2 * x; }
int main()
{
  std::println("class: ", std::isClass<int>, " ", std::isClass<Plain>, " ", std::isClass<Plain*>);
  std::println("polymorphic: ", std::isPolymorphic<Plain>, " ", std::isPolymorphic<Shape>, " ", std::isPolymorphic<Flat>, " ", std::isPolymorphic<int>);
  std::println("abstract: ", std::isAbstract<Shape>, " ", std::isAbstract<Square>, " ", std::isAbstract<Counter>, " ", std::isAbstract<Half>, " ", std::isAbstract<Plain>);
  std::println("final: ", std::isFinal<Flat>, " ", std::isFinal<Square>);
  std::println("move constructible: ", std::isMoveConstructible<Plain>, " ", std::isMoveConstructible<NoMove>, " ", std::isMoveConstructible<CopyOnly>, " ", std::isMoveConstructible<Holder>, " ", std::isMoveConstructible<Shape>, " ", std::isMoveConstructible<int&>);
  std::println("copy constructible: ", std::isCopyConstructible<Plain>, " ", std::isCopyConstructible<Logged>);
  std::println("move assignable: ", std::isMoveAssignable<Plain>, " ", std::isMoveAssignable<WithRef>, " ", std::isMoveAssignable<WithConst>, " ", std::isMoveAssignable<const int>);
  std::println("trivially: ", std::isTriviallyMoveConstructible<Plain>, " ", std::isTriviallyMoveConstructible<Logged>, " ", std::isTriviallyMoveAssignable<Plain>, " ", std::isTriviallyMoveConstructible<Square>);
  std::println("nothrow: ", std::isNothrowMoveConstructible<Logged>, " ", std::isNothrowMoveAssignable<Logged>, " ", std::isNothrowMoveConstructible<CopyOnly>);
  auto add = [](int a, int b) { return a + b; };
  auto any = [](const auto& v) { return v; };
  std::println("invocable: ", std::isInvocable<decltype(add), int, int>, " ", std::isInvocable<decltype(add), int>, " ", std::isInvocable<decltype(any), Plain&>, " ", std::isInvocable<int (*)(int), long>, " ", std::isInvocable<Adder, int, int>, " ", std::isInvocable<Adder, Plain&, int>);
  std::println("invocable r: ", std::isInvocableR<long, int (*)(int), int>, " ", std::isInvocableR<Plain, Adder, int, int>);
  static_assert(std::isMoveConstructible<Plain> && !std::isMoveConstructible<NoMove> && !std::isClass<int>);
  return twice(0);
}
