// spec: the traits that read a class's members: isClass, isPolymorphic, isAbstract, isFinal, isMove/CopyConstructible, isMove/CopyAssignable (plain, Trivially, Nothrow), isInvocable, isInvocableR
// factorio: static_assert(isMoveConstructible<T>) on 20 message types, FlatMap's requires (isClass<K>), if constexpr (isInvocable<F, Args>) in SaveLoadHelper and PtreeUtil, isPolymorphic in the prototype explorer
struct Plain { int x; double y; };
class Shape { public: virtual ~Shape() {} virtual double area() const = 0; };
class Square : public Shape { public: double side = 1; double area() const override { return this.side * this.side; } };
class Flat final : public Square { public:};
template<typename T> class Source { public: virtual T next(T seed) = 0; };
class Counter : public Source<int> { public: int next(int seed) override { return seed + 1; } };
class Half : public Source<int> { public: double next(double seed) { return seed / 2; } }; // overloads, does not override
struct NoMove { NoMove() {} NoMove(NoMove&&) = delete; };
struct CopyOnly { CopyOnly() {} CopyOnly(const CopyOnly&) {} }; // no implicit move: the copy constructor moves
struct Holder { NoMove inner; };
struct Logged { Logged() {} ~Logged() {} Logged(Logged&&) noexcept {} Logged& operator=(Logged&&) { return this; } };
struct WithRef { int& r; };
struct WithConst { const int c = 1; };
struct Adder { int operator()(int a, int b) const { return a + b; } };
int twice(int x) { return 2 * x; }
int main()
{
  println("class: ", isClass<int>, " ", isClass<Plain>, " ", isClass<Plain*>);
  println("polymorphic: ", isPolymorphic<Plain>, " ", isPolymorphic<Shape>, " ", isPolymorphic<Flat>, " ", isPolymorphic<int>);
  println("abstract: ", isAbstract<Shape>, " ", isAbstract<Square>, " ", isAbstract<Counter>, " ", isAbstract<Half>, " ", isAbstract<Plain>);
  println("final: ", isFinal<Flat>, " ", isFinal<Square>);
  println("move constructible: ", isMoveConstructible<Plain>, " ", isMoveConstructible<NoMove>, " ", isMoveConstructible<CopyOnly>, " ", isMoveConstructible<Holder>, " ", isMoveConstructible<Shape>, " ", isMoveConstructible<int&>);
  println("copy constructible: ", isCopyConstructible<Plain>, " ", isCopyConstructible<Logged>);
  println("move assignable: ", isMoveAssignable<Plain>, " ", isMoveAssignable<WithRef>, " ", isMoveAssignable<WithConst>, " ", isMoveAssignable<const int>);
  println("trivially: ", isTriviallyMoveConstructible<Plain>, " ", isTriviallyMoveConstructible<Logged>, " ", isTriviallyMoveAssignable<Plain>, " ", isTriviallyMoveConstructible<Square>);
  println("nothrow: ", isNothrowMoveConstructible<Logged>, " ", isNothrowMoveAssignable<Logged>, " ", isNothrowMoveConstructible<CopyOnly>);
  auto add = [](int a, int b) { return a + b; };
  auto any = [](const auto& v) { return v; };
  println("invocable: ", isInvocable<decltype(add), int, int>, " ", isInvocable<decltype(add), int>, " ", isInvocable<decltype(any), Plain&>, " ", isInvocable<int (*)(int), long>, " ", isInvocable<Adder, int, int>, " ", isInvocable<Adder, Plain&, int>);
  println("invocable r: ", isInvocableR<long, int (*)(int), int>, " ", isInvocableR<Plain, Adder, int, int>);
  static_assert(isMoveConstructible<Plain> && !isMoveConstructible<NoMove> && !isClass<int>);
  return twice(0);
}
