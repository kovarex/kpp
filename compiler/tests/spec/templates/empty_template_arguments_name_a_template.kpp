// spec: `f<>(1)` is a call of a template, its arguments deduced, past a plain function f the call alone would prefer; a member's too
// found by thread A's comparison with clang (2026-11-06): it took the plain function, silently
extern "C" int printf(const char* format, ...);
int f(int) { return 1; }
template<class T> int f(T) { return 2; }
struct S
{
  int g(int) { return 1; }
  template<class T> int g(T) { return 2; }
};
int main()
{
  S s;
  printf("%d %d %d\n", f(1), f<>(1), f<int>(1));
  printf("%d %d\n", s.g(1), s.g<>(1));
  return 0;
}
