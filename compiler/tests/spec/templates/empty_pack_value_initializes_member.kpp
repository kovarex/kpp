// spec: a member initializer whose arguments end in a pack expansion of no elements: with nothing before it the member is value-initialized (`value(forward<Args>(args)...)` with Args empty is `value()`, zero for an int and null for a pointer), with arguments before it they are all there is (`value(first, forward<Args>(args)...)` is `value(first)`)
// factorio: the library's Pair(inPlaceSecond, key, args...), which builds the entry of map[key] and of try_emplace(key, value) (Map<ChunkPosition, uint32>, HashMap<String, int>, ... all over the game) and now has overloads of its own for no argument and one
template<typename T>
struct Holder
{
  T value;
  template<typename... Args>
  Holder(int, Args&&... args) : value(forward<Args>(args)...) {}
};
template<typename T>
struct Leading
{
  T value;
  template<typename... Args>
  Leading(T first, Args&&... args) : value(first, forward<Args>(args)...) {}
};
int main()
{
  Holder<int> a(0);
  Holder<int*> b(0);
  Holder<int> c(0, 5);
  Leading<int> d(7);
  println("{} {} {} {}", a.value, b.value == nullptr, c.value, d.value);
  return 0;
}
