// spec: a class template whose only parameter is a pack, instantiated with no arguments (`Signal<>`)
// factorio: Signal<> members (ConfigItemBase::onChanged, GlobalModSettings::onChanged, CraftingQueue::ChangedSignal), 11 layouts
template<typename... Args>
struct Sig
{
  std::Vector<std::Function<void(Args...)>> handlers;
  void connect(std::Function<void(Args...)> f) { this.handlers.push_back(std::move(f)); }
  void operator()(Args... args) { for (auto& f : this.handlers) f(args...); }
};
struct Holder
{
  Sig<> changed;
  Sig<int> valued;
};
int main()
{
  Holder h;
  h.changed.connect([]() { std::println("changed"); });
  h.valued.connect([](int v) { std::println("value ", v); });
  h.changed();
  h.valued(4);
  return 0;
}
