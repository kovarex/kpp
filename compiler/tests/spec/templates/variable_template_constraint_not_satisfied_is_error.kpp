// spec: naming a variable template for arguments its constraints do not hold for is an error, as C++ has it ([temp.names] 8): `size<char>` of `template<typename T> requires Big<T> constexpr int size`
// found by D's concepts battery against clang (2026-11-10): the parser dropped a variable template's requires clause, so size<char> was 1, silently
// error: variable_template_constraint_not_satisfied_is_error.kpp:11: error: the constraints of size are not satisfied for T = char
template<typename T>
concept Big = sizeof(T) >= 4;
template<typename T>
  requires Big<T>
constexpr int size = int(sizeof(T));
int main()
{
  return size<int> + size<char>;
}
