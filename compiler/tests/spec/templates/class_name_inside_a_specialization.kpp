// spec: in a partial or an explicit specialization the class's own name, no arguments written, is that specialization (lookup found the primary: `Spec s; return s;` was an error of the named return, `sizeof(Spec)` none at all), while `Spec<int>` there still means the template; clang's output
extern "C" int printf(const char* format, ...);
template <typename T> struct Spec { int v = 1; int kind() { return 0; } };
template <typename T> struct Spec<T*>
{
  int v = 3;
  Spec* self() { return &this; }
  Spec copy() { Spec s; s.v = 4; return s; }
  int kind() { Spec other = this; return other.v * 100 + this.copy().v * 10 + this.self()->v; }
  static int size() { return sizeof(Spec); }
  int other() { Spec<int> primary; return primary.v; }
};
template <> struct Spec<int&>
{
  int v = 5;
  Spec* self() { return &this; }
  Spec copy() { Spec s; s.v = 6; return s; }
  int kind() { Spec other = this; return other.v * 100 + this.copy().v * 10 + this.self()->v; }
  int other() { Spec<int> primary; return primary.v; }
};
int main()
{
  Spec<int*> a;
  Spec<int&> b;
  printf("%d %d %d %d %d\n", a.kind(), b.kind(), Spec<char*>::size(), a.other(), b.other());
  return 0;
}
