// spec: a static array member of a class template takes a pack's elements in its initializer, constexpr or not, beside other values, the rest of the array zero
// found by thread A's comparison with clang (2026-11-06): kppc crashed
extern "C" int printf(const char* format, ...);
template<class... T> struct S
{
  static constexpr int sizes[sizeof...(T) + 2] = {sizeof(T)..., 9};
  static inline int kept[3] = {sizeof(T)...};
};
int main()
{
  printf("%d %d %d %d\n", S<int, char>::sizes[0], S<int, char>::sizes[1], S<int, char>::sizes[2], S<int, char>::sizes[3]);
  printf("%d %d %d\n", S<double, int>::kept[0], S<double, int>::kept[1], S<double, int>::kept[2]);
  return 0;
}
