// spec: a member function template returning `auto*`, declared in its class and defined after it (`template<bool ForLogistics> auto* Net::maybeGet(int) const {...}`), has the return type its definition's body deduces for each instance, called directly and from a lambda in another member template
// found in the converted game: LogisticNetwork::maybeGetRobotsEstimatedToFinishOnChunk<ForLogistics>, called by findBestBusyRobot's checkChunk lambda (5 "a local of unknown type (robotList)")
struct Net
{
  int a = 1;
  double b = 2.5;
  template<bool ForLogistics>
  auto* maybeGet(int x) const;
  template<bool ForLogistics>
  double find() const
  {
    double sum = 0;
    auto check = [&](int p)
    {
      auto* list = this->maybeGet<ForLogistics>(p);
      if (list)
        sum += *list;
    };
    check(1);
    return sum;
  }
};
template<bool ForLogistics>
auto* Net::maybeGet(int x) const
{
  if constexpr (ForLogistics)
    return &this->a;
  else
    return &this->b;
}
int main()
{
  Net n;
  auto* direct = n.maybeGet<false>(3);
  println("{} {} {}", n.find<true>(), n.find<false>(), *direct);
  return 0;
}
