// spec: an InitializerList object converts to no class that has no constructor taking it: only a braced list converts through its elements
class P { };
int main()
{
  std::println(std::isConvertible<const std::InitializerList<P*>&, std::StringView>);
  std::println(std::isConvertible<const std::InitializerList<int>&, std::StringView>);
  return 0;
}
