// spec: a parameter `T&` of a function template takes no prvalue: T deduces from the argument, but a non-const lvalue reference does not bind a temporary, so an overload that takes the argument by value or by const reference (through a conversion if need be) is chosen
// found in the game's WikiTypeInfoHelper::tryDownloadTypes (`this->tryDownloadTypes([=](...) {...})` inside `template<class T> void tryDownloadTypes(T& gui)`): the template took its own lambda instead of the `Function` overload, instantiating itself 64 levels deep
struct Gui
{
  int filled = 0;
  void fill(int v) { this.filled = v; }
};

template<class T>
struct Targeter
{
  T* target;
  Targeter(T* t) : target(t) {}
  operator bool() const { return this.target != nullptr; }
  T* operator->() const { return this.target; }
};

struct Helper
{
  using Request = Function<void(const Helper&)>;
  int value = 7;
  template<class T>
  void tryDownload(T& gui)
  {
    Targeter<T> targeter(&gui);
    this.tryDownload([=](const Helper& helper) mutable
    {
      if (targeter)
        targeter->fill(helper.value);
    });
  }
  void tryDownload(Request request) { request(this); }
};

struct Point
{
  int x = 0;
};

struct Callable
{
  int operator()() const { return 5; }
};

template<class T> int pick(T& value) { return 1; }
int pick(long value) { return 2; }
int pick(const Point& value) { return 3; }
int pick(Function<int()> f) { return 4; }

Point makePoint() { return Point(); }

int main()
{
  Gui gui;
  Helper helper;
  helper.tryDownload(gui);
  println(gui.filled, " ", pick(3), " ", pick(makePoint()));
  println(pick(Callable()), " ", pick([]() { return 1; }));
  return 0;
}