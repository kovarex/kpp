// spec: a member function template of a class template converting its argument to T (names.add("a") into MyStack<String>)
template<typename T>
struct MyStack
{
  std::Vector<T> items;
  template<typename U> void add(const U& u) { this.items.push_back(T(u)); }
};
int main()
{
  MyStack<std::String> names;
  names.add("a");
  names.add(std::StringView("bc"));
  std::println(names.items.size(), " ", names.items[1]);
  return 0;
}
