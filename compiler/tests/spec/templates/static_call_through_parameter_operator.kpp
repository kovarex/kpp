// spec: an operator between class-typed results of static member calls through a template parameter: `KeyOf::of(a) < KeyOf::of(b)`
// found in the stdlib B-tree (Map.kpp compares keys this way; it binds the left side to a reference first as a workaround)
// pass
template<typename T>
struct Identity
{
  static const T& of(const T& value) { return value; }
};

template<typename T, typename KeyOf>
bool lessVia(const T& a, const T& b) { return KeyOf::of(a) < KeyOf::of(b); }

int main()
{
  std::String a("apple"), b("banana");
  std::println(lessVia<std::String, Identity<std::String>>(a, b) ? 1 : 0, " ", lessVia<std::String, Identity<std::String>>(b, a) ? 1 : 0);
  return 0;
}
