// spec: a pack expansion over a non-type template parameter pack, `int... I` deduced from `Seq<I...>`: `sum3(values[I]...)` in a function, `p(values[I]...)` in a constructor's member initializer, the index-sequence idiom
// factorio: the library's Pair piecewise constructor (std::pair's, `first(get<I1>(move(firstArgs))...)` over MakeIndexSequence), which LatencyState's `upgradeTargets.emplace_back(std::piecewise_construct, std::tuple{entity}, std::tuple{target})` reaches
template<int... I>
struct Seq {};
int sum3(int a, int b, int c) { return a + b + c; }
template<int... I>
int sumOf(const std::Array<int, 3>& values, Seq<I...>) { return sum3(values[I]...); }
struct Point
{
  int x = 0;
  int y = 0;
  Point(int x, int y) : x(x), y(y) {}
};
struct Holder
{
  Point p;
  template<int... I>
  Holder(const std::Array<int, 2>& values, Seq<I...>) : p(values[I]...) {}
};
template<int... I>
int count(Seq<I...>) { return int(sizeof...(I)); }
int main()
{
  std::Array<int, 3> values = {1, 2, 3};
  std::Array<int, 2> two = {4, 5};
  Holder h(two, Seq<1, 0>());
  std::println(sumOf(values, Seq<0, 1, 2>()), " ", h.p.x, " ", h.p.y, " ", count(Seq<4, 5, 6, 7>()));
  return 0;
}
