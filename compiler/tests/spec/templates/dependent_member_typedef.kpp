// spec: a member typedef of a dependent instantiation as a return type (typename Vector<T>::iterator)
template<typename T>
struct MyStack
{
  std::Vector<T> items;
  typename std::Vector<T>::iterator first() { return this.items.begin(); }
};
int main()
{
  MyStack<std::String> names;
  names.items.push_back(std::String("a"));
  std::println(*names.first());
  return 0;
}
