// spec: a variable template (`template<typename T> inline constexpr int bytes = sizeof(T)`) is a constant per set of arguments, packs and traits included
// found in src/Util (DeserialiserHelper: `inline constexpr bool should_construct = is_constructible_v<T, Args...> && !is_optional<T>::value`)
template<typename T> inline constexpr int bytes = sizeof(T);
template<typename T> inline constexpr bool isInt = std::isSame<T, int>;
template<typename T, typename... Args> inline constexpr bool canBuild = std::isConstructible<T, Args...>;
template<typename T>
void describe()
{
  if constexpr (isInt<T>)
    std::println("int of ", bytes<T>, " bytes");
  else
    std::println("other of ", bytes<T>, " bytes");
}
int main()
{
  std::println(bytes<double>, " ", isInt<int>, " ", isInt<double>);
  std::println(canBuild<std::String, const char*>, " ", canBuild<int, std::String>);
  describe<int>();
  describe<char>();
  return 0;
}
