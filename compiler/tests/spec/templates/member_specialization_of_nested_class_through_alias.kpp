// spec: explicit specializations of a member of a class nested in a class template, declared with the instance's arguments and defined through an alias of the instance (`template<> int FrameBuffer::Checker::add(int Item::* member, const Item& item) {...}`, Item the class's `using Item = T;`), each define that instance's member: the parameter types read for the instance they specialize
// found in src/Info/TimeStatistics.kpp: TimeStatisticsBuffer<T>::TimeChecker::addTime and subtractTime, declared as `template<> void TimeStatisticsBuffer<UpdateTimeStatistics::Item>::TimeChecker::addTime(Nanoseconds Item::* value, Nanoseconds time);` and defined through `UpdateBuffer::TimeChecker::addTime` and `FrameBuffer::...`
struct Update { int a = 1; };
struct Frame { int a = 2; };
template<class T>
struct Buffer
{
  using Item = T;
  class Checker
  {
  public:
    static int add(int Item::* member, const Item& item);
  };
};
using UpdateBuffer = Buffer<Update>;
using FrameBuffer = Buffer<Frame>;
template<>
int Buffer<Update>::Checker::add(int Item::* member, const Item& item);
template<>
int Buffer<Frame>::Checker::add(int Item::* member, const Item& item);
template<>
int UpdateBuffer::Checker::add(int Item::* member, const Item& item) { return item.*member + 100; }
template<>
int FrameBuffer::Checker::add(int Item::* member, const Item& item) { return item.*member + 200; }
int main()
{
  Update u;
  Frame f;
  std::println(UpdateBuffer::Checker::add(&Update::a, u), " ", FrameBuffer::Checker::add(&Frame::a, f));
  return 0;
}
