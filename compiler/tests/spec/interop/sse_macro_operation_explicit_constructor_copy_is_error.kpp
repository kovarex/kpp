// spec: a class made of an SSE operation clang's intrin.h has as a macro (_mm_shuffle_ps) by copy-initialisation takes an implicit constructor only, as any value does in C++: `T x = op`, a parameter by value and by const reference, a return value and an assignment by an explicit one are errors (direct initialisation by one is right: interop/sse_macro_operation_made_into_class)
// factorio: none (float32x4's constructor from __m128 is implicit)
// pending: the checker takes an explicit constructor in copy-initialisation of any value (`Strict s = 5;` compiles too: thread D's, 2026-11-05), and the walker types these macros (interop/sse_macro_operation_deduces_template_argument); codegen's own check (constructFromVector) sees only an operation the walker does not type
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:16: error:
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:17: error:
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:18: error:
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:19: error:
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:20: error:
extern "C" import "intrin.h";
struct Strict { explicit Strict(__m128 v) : value(v) {} __m128 value; };
__m128 a = _mm_setr_ps(1.0f, 2.0f, 3.0f, 4.0f);
float lane0(Strict s) { return _mm_cvtss_f32(s.value); }
float lane0OfRef(const Strict& s) { return _mm_cvtss_f32(s.value); }

// copy-initialisation, each an error of its own:
float initialised() { Strict s = _mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3)); return _mm_cvtss_f32(s.value); }
float byValue() { return lane0(_mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3))); }
float byReference() { return lane0OfRef(_mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3))); }
Strict returned() { return _mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3)); }
float assigned() { Strict s(a); s = _mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3)); return _mm_cvtss_f32(s.value); }

int main()
{
  println(initialised(), byValue(), byReference(), _mm_cvtss_f32(returned().value), assigned());
  return 0;
}
