// spec: an SSE operation clang's intrin.h has as a macro (_mm_shuffle_ps), whose name the checker leaves to the code generator, copy-initialises a class that wraps its vector only by an implicit constructor, as C++ has it: `T x = op`, a parameter by value and by const reference, a return value and an assignment by an explicit one are errors (direct initialisation by an explicit one is right: interop/sse_macro_operation_made_into_class)
// factorio: none (float32x4's constructor from __m128 is implicit)
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:15: error: copy-initialising Strict from a vector (__m128) by its explicit constructor (in initialised())
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:16: error: copy-initialising Strict from a vector (__m128) by its explicit constructor (in byValue())
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:17: error: copy-initialising Strict from a vector (__m128) by its explicit constructor (in byReference())
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:18: error: copy-initialising Strict from a vector (__m128) by its explicit constructor (in returned())
// error: sse_macro_operation_explicit_constructor_copy_is_error.kpp:19: error: copy-initialising Strict from a vector (__m128) by its explicit constructor (in assigned())
extern "C" import "intrin.h";
struct Strict { explicit Strict(__m128 v) : value(v) {} __m128 value; };
__m128 a = _mm_setr_ps(1.0f, 2.0f, 3.0f, 4.0f);
float lane0(Strict s) { return _mm_cvtss_f32(s.value); }
float lane0OfRef(const Strict& s) { return _mm_cvtss_f32(s.value); }

// copy-initialisation, each an error of its own:
float initialised() { Strict s = _mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3)); return _mm_cvtss_f32(s.value); }
float byValue() { return lane0(_mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3))); }
float byReference() { return lane0OfRef(_mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3))); }
Strict returned() { return _mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3)); }
float assigned() { Strict s(a); s = _mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3)); return _mm_cvtss_f32(s.value); }

int main()
{
  println(initialised(), byValue(), byReference(), _mm_cvtss_f32(returned().value), assigned());
  return 0;
}
