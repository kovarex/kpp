// spec: off Windows a program that imports pthread.h uses the standard library's Thread, Mutex, SharedMutex and ConditionVariable beside the import's own pthread functions: the library's declarations of pthread_create, pthread_join, pthread_mutex_lock and the rest (stdlib/platform/PlatformPosix.kpp) are the same C functions as the import's, and a Thread's id is its pthread_t
// factorio: none: the game runs on Windows; kpp.net's server for FreeBSD, which imports C headers beside the library's threads
// target: linux (glibc's pthread.h)
extern "C" import "pthread.h";

Mutex mutex;
ConditionVariable ready;
SharedMutex shared;
int counter = 0;
bool started = false;

void work(int times)
{
  {
    UniqueLock<Mutex> lock(mutex);
    started = true;
    ready.notifyAll();
  }
  for (int i = 0; i < times; ++i)
  {
    LockGuard<Mutex> lock(mutex);
    ++counter;
  }
  shared.lockShared();
  shared.unlockShared();
}

int main()
{
  pthread_mutex_t own;
  pthread_mutex_init(&own, nullptr);
  pthread_mutex_lock(&own);
  pthread_mutex_unlock(&own);
  pthread_mutex_destroy(&own);
  Thread a(work, 1000);
  {
    UniqueLock<Mutex> lock(mutex);
    ready.wait(lock, []() { return started; });
  }
  Thread b(work, 1000);
  println(a.getId() != b.getId(), " ", a.getId() != thisThread::getId());
  a.join();
  b.join();
  println(counter);
  println(Thread::Id((unsigned long)pthread_self()) == thisThread::getId());
  return 0;
}
