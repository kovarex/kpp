// spec: cpuid.h's __get_cpuid_max, __get_cpuid and __get_cpuid_count, inline functions whose bodies are inline asm (`__asm("cpuid" : "=a"(...) ...)`), are the code generator's cpuid instruction, as MSVC's __cpuid is: the highest basic and extended leaves, leaf 0 answered (its eax the highest leaf, with or without a subleaf), and a leaf above the highest refused with 0, the four values left as they were (`true true true true true true`)
// factorio: SystemUtil's cpuid and getCpuidExtendedMaxInputValue on Linux (`#include <cpuid.h>`, MSVC's __cpuid on Windows): "codegen does not support the statement kind AsmStmt yet (in __get_cpuid(...))"
// arch: x86_64 (x86's cpuid instruction: cpuid.h, which another processor's C headers refuse)
extern "C" import "cpuid.h";

int main()
{
  u32 vendor = 0;
  u32 highest = __get_cpuid_max(0, &vendor);
  u32 extended = __get_cpuid_max(0x80000000u, nullptr);
  u32 a = 0, b = 0, c = 0, d = 0;
  int answered = __get_cpuid(0, &a, &b, &c, &d);
  u32 a2 = 0, b2 = 0, c2 = 0, d2 = 0;
  int answeredWithSubleaf = __get_cpuid_count(0, 0, &a2, &b2, &c2, &d2);
  u32 w = 77, x = 77, y = 77, z = 77;
  int refused = __get_cpuid(highest + 1, &w, &x, &y, &z);
  std::println(highest >= 1, " ", extended >= 0x80000000u, " ", answered == 1 && a == highest && b == vendor, " ", answeredWithSubleaf == 1 && a2 == highest,
          " ", refused == 0 && w == 77 && x == 77 && y == 77 && z == 77, " ", b != 0 && c != 0 && d != 0);
  return 0;
}
