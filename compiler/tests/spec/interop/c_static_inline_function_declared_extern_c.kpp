// spec: a C function a header defines static inline and Kpp declares extern "C" with its parameters is one function (C11 6.2.2p4: an extern declaration after a visible static one takes its linkage), not two overloads whose calls are ambiguous; the stdlib's CTime.kpp declares time, localtime, gmtime and mktime so, which MSVC 14.44's time.h defines static inline
// factorio: Lua's lstate.kpp `time(nullptr)`, PerformanceLogger's `::time(nullptr)` and localtime, minizip's mktime: "ambiguous between int64(int64*) (stdlib\clib\CTime.kpp:18) and int64(int64*) (<imported C headers>)" (headline 15) whenever the C imports read MSVC 14.44's headers (a VsDevCmd environment)
extern "C" import "c_static_inline_function_declared_extern_c.h";
extern "C" long long specClock(long long* out);
int main()
{
  long long written = 0;
  long long result = specClock(&written);
  time_t now = time(nullptr);
  time_t again = 0;
  time(&again);
  tm* local = localtime(&now);
  time_t back = mktime(local);
  tm* utc = gmtime(&now); // (localtime's tm, which it reuses)
  println(result, " ", written, " ", specClock(nullptr), " ", now > 0 && again >= now, " ", utc != nullptr && utc->tm_year > 100, " ", back == now);
  return 0;
}
