// spec: a C-callable function defined in kpp (extern "C") takes and returns structs by value as its target's C passes them, as C calls it (c_callable_structs_by_value.c): MS x64 a struct of 1, 2, 4 or 8 bytes in a register and any other through memory; SysV x86-64 up to 16 bytes in INTEGER or SSE registers by its eightbytes, others on the stack (`byval`), on the stack whole when its registers ran out, a result in registers or through the caller's slot (`sret`); kpp's own calls of them alike (the C side's checks are numbered: 0 when all hold)
// factorio: on Linux, fontstash.kpp's renderer callbacks that take a struct by value (2 functions): "a C-callable function (extern "C") defined in kpp that takes or returns a struct by value"
struct S1 { char a; };
struct S3 { char a, b, c; };
struct S8 { int a, b; };
struct F2 { float x, y; };
struct D1 { double x; };
struct S12 { int a, b, c; };
struct DI { double x; int y; };
struct F3 { float x, y, z; };
struct D2 { double x, y; };
struct IF { int a; float b; };
struct S24 { long long a, b, c; };

extern "C" int kppTakeS1(S1 s) { return s.a; }
extern "C" int kppTakeS3(S3 s) { return s.a * 10000 + s.b * 100 + s.c; }
extern "C" int kppTakeS8(S8 s) { return s.a * 10 + s.b; }
extern "C" double kppTakeF2(F2 s) { return s.x + s.y; }
extern "C" double kppTakeD1(D1 s) { return s.x; }
extern "C" int kppTakeS12(S12 s) { return s.a * 100 + s.b * 10 + s.c; }
extern "C" double kppTakeDI(DI s) { return s.x + s.y; }
extern "C" double kppTakeF3(F3 s) { return s.x + s.y + s.z; }
extern "C" double kppTakeD2(D2 s) { return s.x + s.y; }
extern "C" double kppTakeIF(IF s) { return s.a + s.b; }
extern "C" long long kppTakeS24(S24 s) { return s.a * 100 + s.b * 10 + s.c; }
extern "C" long long kppAfterFive(int a, int b, int c, int d, int e, S12 s, int f) { return a + b + c + d + e + s.a * 100 + s.b * 10 + s.c + f; }
extern "C" double kppAfterSeven(double a, double b, double c, double d, double e, double f, double g, D2 s) { return a + b + c + d + e + f + g + s.x * 10 + s.y; }
extern "C" double kppMixed(int a, DI s, float b, S8 t) { return a + s.x + s.y + b + t.a * 10 + t.b; }
extern "C" S1 kppMakeS1(int a) { S1 s; s.a = char(a); return s; }
extern "C" S3 kppMakeS3(int a) { S3 s; s.a = char(a); s.b = char(a + 1); s.c = char(a + 2); return s; }
extern "C" S8 kppMakeS8(int a) { S8 s; s.a = a; s.b = a + 1; return s; }
extern "C" F2 kppMakeF2(float x) { F2 s; s.x = x; s.y = x + 1; return s; }
extern "C" S12 kppMakeS12(int a) { S12 s; s.a = a; s.b = a + 1; s.c = a + 2; return s; }
extern "C" DI kppMakeDI(double x) { DI s; s.x = x; s.y = 3; return s; }
extern "C" F3 kppMakeF3(float x) { F3 s; s.x = x; s.y = x + 1; s.z = x + 2; return s; }
extern "C" D2 kppMakeD2(double x) { D2 s; s.x = x; s.y = x + 1; return s; }
extern "C" S24 kppMakeS24(long long a) { S24 s; s.a = a; s.b = a + 1; s.c = a + 2; return s; }

extern "C" int checkKppCallables();

int main()
{
  std::println(checkKppCallables());
  S12 s12;
  s12.a = 1;
  s12.b = 2;
  s12.c = 3;
  D2 d2 = kppMakeD2(0.5);
  std::println(kppTakeS12(s12), " ", int(kppTakeD2(d2) * 10), " ", int(kppMakeS3(4).c), " ", kppMakeS24(7).c);
  return 0;
}
