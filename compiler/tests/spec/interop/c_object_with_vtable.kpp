// spec: a single-inheritance class's vtable is laid out as MSVC's and COM's: the object's first word points at the first virtual function's slot, the slots follow in declaration order, `this` is the first argument; so Kpp calls a C object's table of functions through a class declaring the same virtual functions, and C calls a Kpp object's through its table
// asked for by the converter thread (DirectX: ID3D11Device and the other COM interfaces as Kpp classes); Kpp's table had the class descriptor in slot 0 and the functions after it
extern "C" import "c_object_with_vtable.h";
class Counter
{
public:
  virtual int add(int n) = 0;
  virtual int get() = 0;
};
class Twice : public Counter
{
public:
  int value = 0;
  int add(int n) override
  {
    this->value += 2 * n;
    return this->value;
  }
  int get() override { return this->value; }
};
int main()
{
  Counter* fromC = reinterpret_cast<Counter*>(specMakeCounter(3));
  fromC->add(4);
  Twice t;
  int added = specCallAdd(reinterpret_cast<SpecCounter*>(&t), 5);
  println("{} {} {} {}", fromC->get(), added, specCallGet(reinterpret_cast<SpecCounter*>(&t)), t.get());
  return 0;
}
