// spec: an `extern "C"` variable declared in Kpp source without an initializer refers to the C library's or the linker's (`extern "C" const IID IID_IDXGIDevice;`, here the linker's __ImageBase, the image's DOS header)
// factorio: the IIDs __uuidof names (IID_ID3D11Device, IID_IDXGIFactory1, ...), defined in dxguid.lib, declared by the Kpp COM interfaces
// pending: codegen defines the variable itself, zero-initialized (linkonce_odr), so it reads zeros instead of "MZ"
extern "C" const char __ImageBase;

int main()
{
  const char* image = &__ImageBase;
  println("{}{}", image[0], image[1]);
  return 0;
}
