// spec: a byte shift of a whole register by 16 or more gives zero, its count the instruction's byte (clang's output)
// target: windows (MSVC's intrin.h)
extern "C" import "intrin.h";
int low(__m128i v) { return _mm_cvtsi128_si32(v); }
int main()
{
  __m128i a = _mm_setr_epi32(1, 2, 3, 4);
  println(low(_mm_srli_si128(a, 4)), " ", low(_mm_srli_si128(a, 12)));
  println(low(_mm_srli_si128(a, 16)), " ", low(_mm_srli_si128(a, 17)), " ", low(_mm_srli_si128(a, 255)));
  println(low(_mm_srli_si128(a, 256 + 4)));
  println(low(_mm_slli_si128(a, 16)), " ", low(_mm_slli_si128(a, 20)), " ", low(_mm_slli_si128(a, 256)));
  return 0;
}
