// spec: a program importing the C library's math.h calls the stdlib's isinf, isnan and isfinite (bool, the C++ standard's), not a C library's own functions of those names: glibc's math.h also declares the obsolete BSD `int isinf(double)` and `int isnan(double)`, which an import must not set against the stdlib's (`true false true true 2.5`)
// factorio: the game's Lua and libraries import math.h on Linux and FreeBSD targets (thread B, 2026-11-05: every Linux program importing math.h failed)
extern "C" import "math.h";

int main()
{
  double big = 1e308;
  println(isinf(big * 10.0), " ", isinf(1.0), " ", isnan((big * 10.0) - (big * 10.0)), " ", isfinite(1.0), " ", fabs(-2.5));
  return 0;
}
