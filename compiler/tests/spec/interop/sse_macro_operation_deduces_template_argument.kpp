// spec: an SSE operation clang's intrin.h has as a macro (_mm_shuffle_ps, _mm_shuffle_epi32) as a function template's argument deduces the operation's vector type (__m128, __m128i), as a typed vector does
// factorio: none known (a template given such an operation directly)
// pending: the checker leaves the macro's name to the code generator, untyped, so nothing is deduced from it: "codegen does not support a call to lane0Of whose template arguments could not be deduced yet" (the class it is made into is right: interop/sse_macro_operation_made_into_class)
extern "C" import "intrin.h";

float lane0(__m128 v) { return _mm_cvtss_f32(v); }
int lane0(__m128i v) { return _mm_cvtsi128_si32(v); }

template<class T>
auto lane0Of(T v) { return lane0(v); }

int main()
{
  __m128 a = _mm_setr_ps(1.0f, 2.0f, 3.0f, 4.0f);
  println(lane0Of(_mm_shuffle_ps(a, a, _MM_SHUFFLE(0, 1, 2, 3))), " ", lane0Of(_mm_shuffle_epi32(_mm_setr_epi32(5, 6, 7, 8), _MM_SHUFFLE(0, 1, 2, 2))));
  return 0;
}
