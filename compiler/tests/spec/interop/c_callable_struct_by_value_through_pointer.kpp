// spec: a C-callable function defined in kpp that takes a struct by value, called through a function pointer in kpp: the call passes the struct as the function takes it (as its target's C does), the pointer's type being the function's own, of C's calling convention (`auto`, decltype), as a call through a pointer to a C library's function does (interop/c_function_pointer_struct_by_value)
// factorio: none; until 2026-11-05 a call through a function pointer passed a struct as kpp does, and a function pointer's type did not say whose calling convention its function has: it read the registers of whatever came before (45 -1336165242 on Windows), and taking the address of such a function was refused (thread D's 088b6d2e) until function types of C's convention (thread B)
struct S8 { int a, b; };
extern "C" int kppTakeS8(S8 s) { return s.a * 10 + s.b; }

int main()
{
  auto pointer = &kppTakeS8;
  decltype(&kppTakeS8) other = kppTakeS8;
  S8 s;
  s.a = 4;
  s.b = 5;
  println(kppTakeS8(s), " ", pointer(s), " ", other(s));
  return 0;
}
