// spec: a Kpp declaration of a name an imported C header declares too (a type, a constant, an enumerator; not the header's own entity: a function it declares or an overload of it, a definition of its extern variable, an alias of its type) is a clash: the two are other entities (other layouts), and neither silently takes the other's place in any file
// factorio: fontstash (converted as C): stb_truetype.h's fallback rect packer (its own stbrp_context, stbrp_node, stbrp_rect, stbrp_init_target, stbrp_pack_rects, private to fontstash.cpp) took the place of stb_rect_pack.h's, which TextureProcessor imports: TextureProcessor's stbrp_context was stb_truetype's 20 bytes, not stb_rect_pack's
// not an error: a Kpp function of the header's function's name, specPackInit, which is the header's function when its parameters are the header's and an overload of it otherwise (it cannot stand for the header's: a caller of the header's links to that one's definition, or fails to link)
// error: kpp_declaration_of_an_imported_c_name.kpp:11: error: 'SpecPackContext' is declared here and in the imported C headers
extern "C" import "kpp_declaration_of_an_imported_c_name.h";
int usesTheHeader()
{
  SpecPackContext context;
  return int(sizeof(context));
}
typedef struct { int width, height, x, y, bottom; } SpecPackContext;
void specPackInit(SpecPackContext* context, int width, int height) { context->width = width; context->height = height; context->bottom = -1; }
int main()
{
  println(usesTheHeader());
  return 0;
}
