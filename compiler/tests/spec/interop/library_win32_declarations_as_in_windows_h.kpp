// spec: the library's Win32 functions (namespace win32) have windows.h's types: each is the same C
// function as windows.h declares, declared the same way
// factorio: the game imports windows.h beside the library (its threads, clocks and file system)
// target: windows (windows.h)
extern "C" import "windows.h";
static_assert(std::isSame<decltype(&std::win32::AcquireSRWLockExclusive), decltype(&::AcquireSRWLockExclusive)>, "AcquireSRWLockExclusive");
static_assert(std::isSame<decltype(&std::win32::AcquireSRWLockShared), decltype(&::AcquireSRWLockShared)>, "AcquireSRWLockShared");
static_assert(std::isSame<decltype(&std::win32::CloseHandle), decltype(&::CloseHandle)>, "CloseHandle");
static_assert(std::isSame<decltype(&std::win32::CopyFileW), decltype(&::CopyFileW)>, "CopyFileW");
static_assert(std::isSame<decltype(&std::win32::CreateDirectoryW), decltype(&::CreateDirectoryW)>, "CreateDirectoryW");
static_assert(std::isSame<decltype(&std::win32::CreateFileW), decltype(&::CreateFileW)>, "CreateFileW");
static_assert(std::isSame<decltype(&std::win32::CreateThread), decltype(&::CreateThread)>, "CreateThread");
static_assert(std::isSame<decltype(&std::win32::DeleteFileW), decltype(&::DeleteFileW)>, "DeleteFileW");
static_assert(std::isSame<decltype(&std::win32::FindClose), decltype(&::FindClose)>, "FindClose");
static_assert(std::isSame<decltype(&std::win32::FindFirstFileW), decltype(&::FindFirstFileW)>, "FindFirstFileW");
static_assert(std::isSame<decltype(&std::win32::FindNextFileW), decltype(&::FindNextFileW)>, "FindNextFileW");
static_assert(std::isSame<decltype(&std::win32::FormatMessageW), decltype(&::FormatMessageW)>, "FormatMessageW");
static_assert(std::isSame<decltype(&std::win32::GetActiveProcessorCount), decltype(&::GetActiveProcessorCount)>, "GetActiveProcessorCount");
static_assert(std::isSame<decltype(&std::win32::GetCurrentDirectoryW), decltype(&::GetCurrentDirectoryW)>, "GetCurrentDirectoryW");
static_assert(std::isSame<decltype(&std::win32::GetCurrentThreadId), decltype(&::GetCurrentThreadId)>, "GetCurrentThreadId");
static_assert(std::isSame<decltype(&std::win32::GetDiskFreeSpaceExW), decltype(&::GetDiskFreeSpaceExW)>, "GetDiskFreeSpaceExW");
static_assert(std::isSame<decltype(&std::win32::GetFileAttributesExW), decltype(&::GetFileAttributesExW)>, "GetFileAttributesExW");
static_assert(std::isSame<decltype(&std::win32::GetFileAttributesW), decltype(&::GetFileAttributesW)>, "GetFileAttributesW");
static_assert(std::isSame<decltype(&std::win32::GetFileInformationByHandle), decltype(&::GetFileInformationByHandle)>, "GetFileInformationByHandle");
static_assert(std::isSame<decltype(&std::win32::GetFinalPathNameByHandleW), decltype(&::GetFinalPathNameByHandleW)>, "GetFinalPathNameByHandleW");
static_assert(std::isSame<decltype(&std::win32::GetFullPathNameW), decltype(&::GetFullPathNameW)>, "GetFullPathNameW");
static_assert(std::isSame<decltype(&std::win32::GetLastError), decltype(&::GetLastError)>, "GetLastError");
static_assert(std::isSame<decltype(&std::win32::GetSystemTimePreciseAsFileTime), decltype(&::GetSystemTimePreciseAsFileTime)>, "GetSystemTimePreciseAsFileTime");
static_assert(std::isSame<decltype(&std::win32::GetTempPathW), decltype(&::GetTempPathW)>, "GetTempPathW");
static_assert(std::isSame<decltype(&std::win32::MoveFileExW), decltype(&::MoveFileExW)>, "MoveFileExW");
static_assert(std::isSame<decltype(&std::win32::MultiByteToWideChar), decltype(&::MultiByteToWideChar)>, "MultiByteToWideChar");
static_assert(std::isSame<decltype(&std::win32::QueryPerformanceCounter), decltype(&::QueryPerformanceCounter)>, "QueryPerformanceCounter");
static_assert(std::isSame<decltype(&std::win32::QueryPerformanceFrequency), decltype(&::QueryPerformanceFrequency)>, "QueryPerformanceFrequency");
static_assert(std::isSame<decltype(&std::win32::ReleaseSRWLockExclusive), decltype(&::ReleaseSRWLockExclusive)>, "ReleaseSRWLockExclusive");
static_assert(std::isSame<decltype(&std::win32::ReleaseSRWLockShared), decltype(&::ReleaseSRWLockShared)>, "ReleaseSRWLockShared");
static_assert(std::isSame<decltype(&std::win32::RemoveDirectoryW), decltype(&::RemoveDirectoryW)>, "RemoveDirectoryW");
static_assert(std::isSame<decltype(&std::win32::SetCurrentDirectoryW), decltype(&::SetCurrentDirectoryW)>, "SetCurrentDirectoryW");
static_assert(std::isSame<decltype(&std::win32::SetFileAttributesW), decltype(&::SetFileAttributesW)>, "SetFileAttributesW");
static_assert(std::isSame<decltype(&std::win32::Sleep), decltype(&::Sleep)>, "Sleep");
static_assert(std::isSame<decltype(&std::win32::SleepConditionVariableSRW), decltype(&::SleepConditionVariableSRW)>, "SleepConditionVariableSRW");
static_assert(std::isSame<decltype(&std::win32::SwitchToThread), decltype(&::SwitchToThread)>, "SwitchToThread");
static_assert(std::isSame<decltype(&std::win32::TryAcquireSRWLockExclusive), decltype(&::TryAcquireSRWLockExclusive)>, "TryAcquireSRWLockExclusive");
static_assert(std::isSame<decltype(&std::win32::TryAcquireSRWLockShared), decltype(&::TryAcquireSRWLockShared)>, "TryAcquireSRWLockShared");
static_assert(std::isSame<decltype(&std::win32::WaitForSingleObject), decltype(&::WaitForSingleObject)>, "WaitForSingleObject");
static_assert(std::isSame<decltype(&std::win32::WakeAllConditionVariable), decltype(&::WakeAllConditionVariable)>, "WakeAllConditionVariable");
static_assert(std::isSame<decltype(&std::win32::WakeConditionVariable), decltype(&::WakeConditionVariable)>, "WakeConditionVariable");
static_assert(std::isSame<decltype(&std::win32::WideCharToMultiByte), decltype(&::WideCharToMultiByte)>, "WideCharToMultiByte");
int main()
{
  LARGE_INTEGER count;
  std::win32::QueryPerformanceCounter(&count);
  SRWLOCK lock = {};
  std::win32::AcquireSRWLockExclusive(&lock);
  std::win32::ReleaseSRWLockExclusive(&lock);
  std::println(count.QuadPart > 0, " ", lock.Ptr == nullptr);
  return 0;
}
