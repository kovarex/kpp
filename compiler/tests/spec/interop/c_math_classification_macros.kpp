// spec: math.h's classification macros are usable through the C import as C uses them: fpclassify, signbit, isnan, isinf, and the FP_* constants the UCRT defines (FP_NORMAL is (-1), FP_SUBNORMAL (-2))
// factorio: trio (converted as C): trionan.c's c99_fpclassify_and_signbit, which its `#if defined(PREDEF_STANDARD_C99) && defined(fpclassify)` selects in the C build, `switch (fpclassify(number)) { case FP_NAN: ... case FP_SUBNORMAL: ... }`
// pending: "'fpclassify' is not declared", "'FP_NORMAL' is not declared", "'FP_SUBNORMAL' is not declared" (signbit, isnan, isinf and FP_NAN, FP_INFINITE, FP_ZERO import) (B)
extern "C" import "math.h";
int main()
{
  double z = -0.0, one = 1.0, sub = 4.9e-324, inf = 1e308 * 10.0;
  println("{} {} {} {}", signbit(z) != 0, signbit(one) != 0, isnan(inf - inf) != 0, isinf(inf) != 0);
  println("{} {} {} {} {}", FP_NAN, FP_INFINITE, FP_ZERO, FP_NORMAL, FP_SUBNORMAL);
  println("{} {} {} {}", fpclassify(z), fpclassify(one), fpclassify(sub), fpclassify(inf));
  return 0;
}
