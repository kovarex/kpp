// spec: MSVC's interlocked intrinsics (_InterlockedExchangeAdd, _InterlockedExchange, _InterlockedCompareExchange, _InterlockedIncrement, _InterlockedDecrement, _InterlockedAnd, _InterlockedOr, _InterlockedXor, each in 8, 16, 32 (long) and 64 bits, the Pointer forms of Exchange and CompareExchange) and _ReadWriteBarrier are each an instruction, as MSVC and clang-cl give them, not a call of a function no library has; and _tzcnt_u64 and _tzcnt_u32, clang's `#define _tzcnt_u64 __tzcnt_u64` of a function declared after an attribute, are declared
// for Unreal Engine's WindowsPlatformAtomics and lz4hc.c; the expected output is MSVC's and clang-cl's for the same program written in C++
// target: windows (MSVC's intrinsics)
extern "C" import "intrin.h";
int main()
{
  char c = 5;
  short s = 100;
  long l = 1000;
  long long q = 1LL << 40;
  std::println(int(_InterlockedExchangeAdd8(&c, 3)), " ", _InterlockedExchangeAdd16(&s, -1), " ", _InterlockedExchangeAdd(&l, 24), " ",
               _InterlockedExchangeAdd64(&q, 1), " ", int(c), " ", s, " ", l, " ", q);
  std::println(int(_InterlockedExchange8(&c, 1)), " ", _InterlockedExchange16(&s, 2), " ", _InterlockedExchange(&l, 3), " ",
               _InterlockedExchange64(&q, 4), " ", int(c), " ", s, " ", l, " ", q);
  std::println(int(_InterlockedCompareExchange8(&c, 9, 1)), " ", int(_InterlockedCompareExchange8(&c, 7, 1)), " ",
               _InterlockedCompareExchange16(&s, 9, 2), " ", _InterlockedCompareExchange(&l, 9, 0), " ", _InterlockedCompareExchange64(&q, 9, 4), " ",
               int(c), " ", s, " ", l, " ", q);
  std::println(_InterlockedIncrement16(&s), " ", _InterlockedIncrement(&l), " ", _InterlockedIncrement64(&q), " ", _InterlockedDecrement16(&s), " ",
               _InterlockedDecrement(&l), " ", _InterlockedDecrement64(&q));
  long bits = 0b1100;
  std::println(_InterlockedAnd(&bits, 0b1010), " ", _InterlockedOr(&bits, 0b0001), " ", _InterlockedXor(&bits, 0b1111), " ", bits, " ",
               int(_InterlockedAnd8(&c, 1)), " ", _InterlockedOr16(&s, 0x100), " ", _InterlockedXor64(&q, 1), " ", int(c), " ", s, " ", q);
  int first = 1, second = 2;
  void* slot = &first;
  void* was = _InterlockedExchangePointer(&slot, &second);
  void* kept = _InterlockedCompareExchangePointer(&slot, &first, &first);
  std::println(was == &first, " ", kept == &second, " ", slot == &second);
  _ReadWriteBarrier();
  std::println(_tzcnt_u64(0x100ULL), " ", _tzcnt_u32(8u), " ", _tzcnt_u64(0ULL));
  return 0;
}
