// spec: structs of floats by value to and from C as the target's C passes them (c_structs_by_value_float_aggregates.c, clang's): AAPCS64's homogeneous float aggregates in vector registers (4 floats, 3 doubles: 24 bytes, in registers there and in memory on SysV), 5 floats through memory, a union of floats, a 16-aligned struct (i128), float aggregates past the eight vector registers onto the stack, and kpp's C-callable functions C calls with them
struct F4 { float a, b, c, d; };
struct D3 { double a, b, c; };
struct F5 { float a[5]; };
union U1 { float f; float g; };
struct alignas(16) A16 { long long a, b; };
struct F2 { float x, y; };
extern "C" F4 specF4(F4 v);
extern "C" D3 specD3(D3 v);
extern "C" F5 specF5(F5 v);
extern "C" U1 specU1(U1 v);
extern "C" A16 specA16(A16 v);
extern "C" double specManyF2(F2 a, F2 b, F2 c, F2 d, F2 e, double f);
extern "C" int specCallsBack();
extern "C" F4 kppF4(F4 v) { return F4{v.a * 10, v.b * 10, v.c * 10, v.d * 10}; }
extern "C" D3 kppD3(D3 v) { return D3{v.c, v.b, v.a}; }
int main()
{
  F4 f4 = specF4(F4{1, 2, 3, 4});
  println(f4.a, " ", f4.b, " ", f4.c, " ", f4.d);
  D3 d3 = specD3(D3{1, 2, 4});
  println(d3.a, " ", d3.b, " ", d3.c);
  F5 f5 = specF5(F5{{1, 2, 3, 4, 5}});
  println(f5.a[0], " ", f5.a[1], " ", f5.a[2], " ", f5.a[3], " ", f5.a[4]);
  U1 u;
  u.f = 2;
  println(specU1(u).f);
  A16 a = specA16(A16{5, 7});
  println(a.a, " ", a.b);
  println(specManyF2(F2{1, 9}, F2{9, 2}, F2{3, 9}, F2{9, 4}, F2{5, 6}, 7));
  println(specCallsBack());
  return 0;
}
