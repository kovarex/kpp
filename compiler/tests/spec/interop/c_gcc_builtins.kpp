// spec: GCC's builtins that C code calls are the code generator's own, as MSVC's intrinsics are (msvcBuiltin), wherever C headers are imported: __builtin_clz and __builtin_ctz (unsigned int), the l forms (unsigned long, the target's C long), the ll forms (64 bits), __builtin_popcount (l, ll), __builtin_bswap16, 32 and 64, __builtin_expect (its first argument), __builtin_prefetch (one to three arguments) and __builtin_alloca (stack memory for the rest of the function) (`8 20 23 40 4 1 3 0 8`, `13330 2018915346 578437695752307201 7 42`)
// factorio: the game's Linux branches (`#ifdef __GNUC__`): __builtin_clz/ctz/clzll/ctzll in the bit utilities, __builtin_bswap32/64 in the serialiser, __builtin_prefetch and __builtin_alloca, which MSVC's _BitScanReverse, _byteswap_*, _mm_prefetch and _alloca are on Windows ("'__builtin_clz' is not declared")
extern "C" import "stdint.h";

int sum(int count)
{
  int* values = static_cast<int*>(__builtin_alloca(count * sizeof(int)));
  for (int i = 0; i < count; ++i)
    values[i] = i + 3;
  int total = 0;
  for (int i = 0; i < count; ++i)
    total += values[i];
  return total;
}

int main()
{
  u32 a = 0x00F00000u;
  u64 b = 0x0000010000000000ull;
  std::println(__builtin_clz(a), " ", __builtin_ctz(a), " ", __builtin_clzll(b), " ", __builtin_ctzll(b), " ", __builtin_popcount(a), " ",
          __builtin_popcountll(b), " ", __builtin_ctzl(8ul), " ", int(sizeof(long)) * 8 - 1 - __builtin_clzl(1ul), " ", __builtin_popcountl(0xFFul));
  __builtin_prefetch(&a);
  __builtin_prefetch(&b, 0);
  __builtin_prefetch(&b, 1, 3);
  long likely = __builtin_expect(7, 1);
  std::println(__builtin_bswap16(u16(0x1234)), " ", __builtin_bswap32(0x12345678u), " ", __builtin_bswap64(0x0102030405060708ull), " ", likely, " ", sum(4) + 24);
  return 0;
}
