// spec: Thread, Mutex, LockGuard, Atomic (std::thread, std::mutex, std::atomic), thisThread::yield and sleepFor (std::this_thread), Thread::hardwareConcurrency (std::thread::hardware_concurrency)
// factorio: 78 std::thread, 479 mutex/lock_guard, 47 std::atomic
int main()
{
  Atomic<int> counter(0);
  Mutex m;
  Vector<Thread> threads;
  for (int i = 0; i < 4; ++i)
    threads.emplace_back([&]() { thisThread::yield(); LockGuard<Mutex> lock(m); counter += 1; });
  for (Thread& t : threads)
    t.join();
  thisThread::sleepFor(Milliseconds(1));
  println("{} {}", counter.load(), Thread::hardwareConcurrency() >= 1);
  return 0;
}
