// spec: Thread, Mutex, LockGuard, Atomic (std::thread, std::mutex, std::atomic), thisThread::yield and sleepFor (std::this_thread), Thread::hardwareConcurrency (std::thread::hardware_concurrency)
// factorio: 78 std::thread, 479 mutex/lock_guard, 47 std::atomic
int main()
{
  std::Atomic<int> counter(0);
  std::Mutex m;
  std::Vector<std::Thread> threads;
  for (int i = 0; i < 4; ++i)
    threads.emplace_back([&]() { std::thisThread::yield(); std::LockGuard<std::Mutex> lock(m); counter += 1; });
  for (std::Thread& t : threads)
    t.join();
  std::thisThread::sleepFor(std::Milliseconds(1));
  std::println(counter.load(), " ", std::Thread::hardwareConcurrency() >= 1);
  return 0;
}
