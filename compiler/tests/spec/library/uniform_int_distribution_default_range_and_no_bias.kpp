// spec: UniformIntDistribution<T>() ranges from 0 to T's greatest value (std::uniform_int_distribution's default b is numeric_limits<T>::max()), and every value of [a, b] is equally likely however wide the range ([rand.dist.uni.int]: P(i) = 1 / (b - a + 1)): over [0, 3 * 2^62) a third of the draws are below 2^62 (`0 2147483647 1 1`)
// factorio: E's <random> battery against C++ (ra1, 2026-11-06): the default distribution gave b 0 (every draw 0); over [0, 3 * 2^62) half the draws were below 2^62 (raw % range doubles the low third), with std::uniform_int_distribution a third
extern "C" import "stdio.h";
int main()
{
  std::UniformIntDistribution<int> d;
  std::UniformIntDistribution<u64> du;
  std::DefaultRandomEngine e(12345);
  std::UniformIntDistribution<u64> wide(0, 3ull * 4611686018427387904ull - 1);
  int low = 0;
  for (int i = 0; i < 300000; ++i)
    low += wide(e) < 4611686018427387904ull;
  printf("%d %d %d %d\n", d.a(), d.b(), (int)(du.b() == 18446744073709551615ull), (int)(low > 98000 && low < 102000));
  return 0;
}
