// spec: the formatting pieces of design.md 14, each a value with appendTo: hex and hexUpper (C's %x and %X, the bits of the value's own type, zero-padded to digits), octal (%o), fixed (%.Nf), significant (%.Ng), scientific (%.Ne), withSign (the '+' flag), alignRight and alignLeft (a width with a fill; a longer text is not cut; any piece inside), zeroPadded (the '0' flag, after the sign), address (MSVC's %p); infinities and NaN as toString writes them
// factorio: what the converted printf specifiers become (the game's 8,173 conversions: %s, %u, %f, %d, %g, %x, %02x, %016llx, %.2f, %3u, %03d, %+.1f, %-*s, %X, %o, %e, %p ...)
template<typename T>
std::String text(const T& piece)
{
  std::String out;
  piece.appendTo(out);
  return out;
}

int main()
{
  double zero = 0.0;
  std::println(text(std::hex(255)) + " " + text(std::hex(-1)) + " " + text(std::hex(-1LL)) + " " + text(std::hex(10, 4)) + " " + text(std::hex((unsigned char)200)) + " " +
          text(std::hex((short)-2)) + " " + text(std::hex(0xDEADBEEFull, 16)) + " " + text(std::hexUpper(0xBEEF, 8)) + " " + text(std::octal(0644)) + " " +
          text(std::octal(8, 3)));
  std::println(text(std::fixed(3.14159, 2)) + " " + text(std::fixed(2.5, 0)) + " " + text(std::fixed(3.5, 0)) + " " + text(std::fixed(-0.001, 2)) + " " +
          text(std::fixed(1.0 / zero, 2)) + " " + text(std::fixed(1e20, 1)) + " " + text(std::fixed(0.1, 20)));
  std::println(text(std::significant(1234567.0, 6)) + " " + text(std::significant(0.0001234, 6)) + " " + text(std::significant(100.0, 6)) + " " +
          text(std::significant(2.0 / 3, 4)) + " " + text(std::significant(-zero / zero, 6)) + " " + text(std::scientific(1234.5, 2)) + " " +
          text(std::scientific(0.000123, 5)) + " " + text(std::scientific(-1.0 / zero, 3)));
  std::println(text(std::withSign(std::fixed(1.25, 1))) + " " + text(std::withSign(std::fixed(-1.25, 1))) + " " + text(std::withSign(std::significant(0.5, 6))) + " " +
          text(std::withSign(42)));
  std::println("[" + text(std::alignRight(42, 5)) + "] [" + text(std::alignLeft("ab", 5)) + "] [" + text(std::alignRight("ab", 4, '.')) + "] [" +
          text(std::alignRight(12345, 3)) + "] [" + text(std::alignLeft(std::fixed(1.5, 1), 6, '_')) + "] [" + text(std::alignRight(true, 6)) + "] [" +
          text(std::alignRight(std::hex(255), 6)) + "]");
  std::println("[" + text(std::zeroPadded(-5, 4)) + "] [" + text(std::zeroPadded(7, 3)) + "] [" + text(std::zeroPadded(std::withSign(3), 4)) + "] [" +
          text(std::zeroPadded(std::fixed(-1.5, 2), 8)) + "] [" + text(std::zeroPadded(std::hex(255), 6)) + "] [" + text(std::zeroPadded(123456, 3)) + "]");
  std::println(text(std::address(nullptr)) + " " + text(std::address((const void*)0x1234abcd)));
  return 0;
}
