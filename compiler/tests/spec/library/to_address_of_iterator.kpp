// spec: toAddress (std::to_address) gives the address an iterator or fancy pointer points at: a raw pointer (a Vector's iterator) as it is, a class through its operator->, recursively; `*it` reads what both kinds point at. The converter writes C++'s explicit `it.operator*()` as `*it` and `it.operator->()` as `toAddress(it)`, which a Vector's pointer iterator has no member call for
// factorio: agui::Widget::visible_iterator's `this->position.operator*()` and `this->position.operator->()` on a std::vector<Widget*>::iterator (Agui/Widget.hpp, 4c178a5b915)
struct Holder
{
  int* value;
  int* operator->() const { return this->value; }
  int& operator*() const { return *this->value; }
};
struct Outer
{
  Holder inner;
  Holder operator->() const { return this->inner; }
};
int main()
{
  Vector<int> list;
  list.push_back(7);
  list.push_back(9);
  Vector<int>::iterator it = list.begin();
  int* fromVector = toAddress(it);
  int number = 11;
  Holder holder{&number};
  int* fromClass = toAddress(holder);
  Outer outer{holder};
  int* fromChain = toAddress(outer);
  println(*fromVector, " ", *(it + 1), " ", *fromClass, " ", *fromChain, " ", *holder);
  return 0;
}
