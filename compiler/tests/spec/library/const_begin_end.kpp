// spec: every container, String, StringView and Span has cbegin() and cend(), begin() and end() of it as const (and crbegin(), crend() where it has rbegin()); a const String is iterated by range-for
// factorio: CommonUtil's containsNonEmpty, allNonEmpty and countNonEmpty call any_of/all_of/count_if on container.cbegin(), container.cend() of an Array, a Deque, a Vector
int main()
{
  const std::Array<int, 3> a = {1, 0, 2};
  std::Deque<int> d;
  d.push_back(5);
  d.push_back(0);
  const std::Deque<int>& cd = d;
  std::Map<int, int> m;
  m[1] = 10;
  m[2] = 20;
  std::Set<int> s = {3, 4};
  std::HashMap<int, int> h;
  h[7] = 70;
  std::List<int> l = {8, 9};
  const std::String text("abc");
  std::StringView view("xy");
  int sum = 0;
  for (char c : text)
    sum += c - 'a';
  std::println(std::countIf(a.cbegin(), a.cend(), [](int x) { return x != 0; }), " ", std::anyOf(cd.cbegin(), cd.cend(), [](int x) { return x == 0; }), " ", m.cbegin()->second, " ", m.crbegin()->first, " ", *s.crbegin(), " ", h.cbegin()->second, " ", *l.crbegin(), " ", *(text.cend() - 1), " ", sum + (view.cend() - view.cbegin()));
  return 0;
}
