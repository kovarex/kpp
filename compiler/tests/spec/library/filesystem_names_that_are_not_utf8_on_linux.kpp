// spec: on Linux a file name is bytes, UTF-8 or not, and a path that directory_iterator gives names that file: exists, file_size and remove reach it, and filename().string() is its bytes, as libstdc++'s std::filesystem::path (a POSIX path is its native bytes); two names that are not UTF-8 (`\xff\xfe.txt`, `a\xc0\xafb`) and a UTF-8 one (`3 3 3 3 0 61c0af62 c5be2e747874 fffe2e747874`)
// factorio: E's text encoding battery against C++ (en2, 2026-11-06): kpp listed `a\xc0\xafb` as `a\xef\xbf\xbd\xef\xbf\xbdb` and `\xed\xa0\x80` as three U+FFFDs; exists, file_size and remove failed for the 3 names that are not UTF-8 of 5, and they stayed in the directory
// target: linux (Linux's byte names; on Windows a name is UTF-16 and the path keeps it as it is)
extern "C" import "stdio.h";
extern "C" import "unistd.h";
int main()
{
  char base[64];
  snprintf(base, 64, "/tmp/kpp-spec-not-utf8-%d", (int)getpid());
  std::filesystem::path directory(base);
  std::ErrorCode error;
  std::filesystem::remove_all(directory, error);
  std::filesystem::create_directory(directory);
  const char* names[] = {"/\xff\xfe.txt", "/a\xc0\xaf" "b", "/\xc5\xbe.txt"};
  for (const char* n : names)
  {
    char full[128];
    snprintf(full, 128, "%s%s", base, n);
    FILE* f = fopen(full, "wb");
    fwrite("abc", 1, 3, f);
    fclose(f);
  }
  std::Vector<std::filesystem::path> listed;
  for (const auto& entry : std::filesystem::directory_iterator(directory))
    listed.push_back(entry.path());
  int found = 0, sized = 0, removed = 0;
  std::Vector<std::String> texts;
  for (const auto& p : listed)
  {
    found += std::filesystem::exists(p, error) ? 1 : 0;
    sized += std::filesystem::file_size(p, error) == 3 ? 1 : 0;
    std::String t;
    for (char c : p.filename().string())
    {
      char hex[4];
      snprintf(hex, 4, "%02x", (unsigned char)c);
      t.append(hex);
    }
    texts.push_back(t);
  }
  for (const auto& p : listed)
    removed += std::filesystem::remove(p, error) ? 1 : 0;
  int left = 0;
  for (const auto& entry : std::filesystem::directory_iterator(directory, error))
    ++left;
  std::filesystem::remove_all(directory, error);
  std::sort(texts.begin(), texts.end());
  printf("%d %d %d %d %d", (int)listed.size(), found, sized, removed, left);
  for (const std::String& t : texts)
    printf(" %s", t.c_str());
  printf("\n");
  return 0;
}
