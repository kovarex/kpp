// spec: String(other, pos, count) and String(other, pos), std::string's substring constructors: up to count bytes of other from pos (all the rest without count or when count runs past the end), OutOfRange when pos > other.size(), pos == size() an empty string, as MSVC's STL gives for the same C++ (`cde de abcdef [] / out of range`)
int main()
{
  std::String s("abcdef");
  std::String a(s, 2, 3);
  std::String b(s, 3, 2);
  std::String c(s, 0, 100);
  std::String d(s, 6);
  std::print(a, " ", b, " ", c, " [", d, "] / ");
  try
  {
    std::String e(s, 7);
    std::println("constructed ", e);
  }
  catch (const std::OutOfRange&)
  {
    std::println("out of range");
  }
  return 0;
}
