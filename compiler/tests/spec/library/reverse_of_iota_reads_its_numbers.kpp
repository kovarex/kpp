// spec: a reverseView of an iotaView gives its numbers: *it of a ReverseIterator goes through a copy of the iterator, whose value must outlive it
// kpp: --release
int main()
{
  auto numbers = std::iotaView(1, 4);
  for (auto&& x : std::reverseView(numbers))
    std::println((int)x);
  return 0;
}
