// spec: an empty Optional holds no T: no constructor has run for it (T needs no default constructor) and no destructor will; giving the value up destroys it at once; copies and moves construct, assign or destroy as the two Optionals hold values; emplace destroys the old value first; an over-aligned T keeps its alignment; an Optional is trivially copyable or destructible when T is
// factorio: PrototypeMigrationListDefinition's Optional<ParsedMigrations<ID<...>>> (ParsedMigrations has no default constructor; 42 instances); GameViewAction's `static_assert(std::is_trivially_destructible_v<PlaySoundSpecification>)` over its std::optional members
struct alignas(16) Wide { float v[4]; };
static int alive = 0;
struct Counted
{
  int value;
  Counted(int value) : value(value) { ++alive; }
  Counted(const Counted& other) : value(other.value) { ++alive; }
  Counted& operator=(const Counted& other)
  {
    this.value = other.value * 10;
    return this;
  }
  ~Counted() { --alive; }
};
int main()
{
  std::Optional<Counted> a;
  std::Optional<Counted> b(std::nullopt);
  std::println(alive, " ", a.has_value(), " ", a == std::nullopt);
  a = Counted(5);
  std::Optional<Counted> c = a;
  std::println(alive, " ", c->value, " ", a->value == c.value().value);
  c = a;
  std::println(alive, " ", c->value);
  a.reset();
  std::println(alive, " ", !a);
  c = b;
  std::println(alive, " ", c.has_value());
  c.emplace(7);
  c.emplace(8);
  std::println(alive, " ", c.value().value);
  {
    std::Optional<Counted> d(std::inPlace, 3);
    std::println(alive);
  }
  std::Optional<Wide> wide;
  wide = Wide{{1, 2, 3, 4}};
  std::println(alive, " ", alignof(std::Optional<Wide>), " ", ((size_t)&*wide) % 16);
  std::println(std::isTriviallyCopyable<std::Optional<float>>, " ", std::isTriviallyDestructible<std::Optional<float>>, " ", std::isTriviallyCopyable<std::Optional<Counted>>, " ", std::isTriviallyDestructible<std::Optional<Counted>>);
  return 0;
}
