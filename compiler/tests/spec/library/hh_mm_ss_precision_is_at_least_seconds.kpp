// spec: HoursMinutesSeconds<D>'s precision is std::chrono::hh_mm_ss's ([time.hms.overview]): seconds for a D coarser than a second, and for a D whose period is no power of ten the decimal fraction of fractional_width digits (6 for thirds of a second); subseconds() and to_duration() are in it: 90 minutes back is 5400 seconds, and 7/3 s has 333333 microseconds below its 2 seconds
// pending: Time.kpp's HoursMinutesSeconds keeps D as its precision: 90 minutes back is 90 (minutes), 7/3 s has subseconds 1 (a third) and back 7 (battery tm1 against MSVC's and libstdc++'s hh_mm_ss)
extern "C" int printf(const char* format, ...);
int main()
{
  HoursMinutesSeconds<Minutes> a(Minutes(90));
  printf("90 min: %lld h %lld min, back %lld\n", (long long)a.hours().count(), (long long)a.minutes().count(), (long long)a.to_duration().count());
  HoursMinutesSeconds<Hours> b(Hours(-25));
  printf("-25 h: negative %d, back %lld\n", (int)b.is_negative(), (long long)b.to_duration().count());
  HoursMinutesSeconds<Duration<i64, Ratio<1, 3>>> c(Duration<i64, Ratio<1, 3>>(7));
  printf("7/3 s: %lld s, subseconds %lld, back %lld\n", (long long)c.seconds().count(), (long long)c.subseconds().count(), (long long)c.to_duration().count());
  return 0;
}
