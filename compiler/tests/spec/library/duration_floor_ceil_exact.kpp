// spec: floor, ceil and round of a duration (std::chrono's) are exact for any count: compared in the two durations' common duration, a remainder of 1 ns past 2^53 ns (about 104 days) still rounds down or up; round goes to the nearest, a tie to the even count. Before, floor and ceil compared in double nanoseconds and lost it (floor<Microseconds>(Nanoseconds(-100000000000000001)) was -100000000000000 where std gives ...001), a silent wrong answer, and there was no round. clang (MSVC's std::chrono) prints the same
// found comparing kpp with std::chrono (thread I's time battery)
int main()
{
  std::Nanoseconds far(-100000000000000001);
  std::Nanoseconds farUp(100000000000000001);
  std::println(std::floor<std::Microseconds>(far).count(), " ", std::ceil<std::Microseconds>(far).count(), " ", std::floor<std::Seconds>(farUp).count(), " ", std::ceil<std::Seconds>(farUp).count());
  std::println(std::floor<std::Seconds>(std::Nanoseconds(-1)).count(), " ", std::ceil<std::Seconds>(std::Nanoseconds(-1)).count(), " ", std::floor<std::Seconds>(std::Milliseconds(1500)).count(), " ", std::ceil<std::Seconds>(std::Milliseconds(-1500)).count());
  std::println(std::round<std::Seconds>(std::Milliseconds(2500)).count(), " ", std::round<std::Seconds>(std::Milliseconds(3500)).count(), " ", std::round<std::Seconds>(std::Milliseconds(-2500)).count(), " ", std::round<std::Seconds>(std::Milliseconds(2501)).count(), " ",
          std::round<std::Milliseconds>(std::Nanoseconds(-1500000)).count(), " ", std::round<std::Seconds>(farUp).count());
  return 0;
}
