// spec: async with Launch::async (a thread) and Launch::deferred (runs on get), returning Future<R> for the callable's result R
// factorio: 10 std::async(std::launch::async, ...) in AppManagerStates, 1 deferred in SpotNoiseCache
int main()
{
  std::Future<int> now = std::async(std::Launch::async, []() -> int { return 6; });
  int ran = 0;
  std::Future<int> later = std::async(std::Launch::deferred, [&ran]() -> int { ++ran; return 7; });
  std::println("before get: ", ran);
  std::println(now.get(), " ", later.get(), " ", ran);
  return 0;
}
