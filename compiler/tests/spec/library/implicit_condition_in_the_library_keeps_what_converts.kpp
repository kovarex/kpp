// spec: the library's `implicit(cond)` constructors convert exactly where their `explicit(!cond)` did: Optional<T> from a U and Pair<A, B> from two values or another Pair convert only when the members convert, so isConvertible gives what std's gives and copy-initialization from a value whose member takes it only explicitly does not compile
// factorio: explicit by default (design.md), the stdlib's marks (C's handover to K, 2026-11-07)
struct OnlyExplicit
{
  int value;
  implicit(false) OnlyExplicit(int value) : value(value) {}
};

struct Converts
{
  int value;
  implicit Converts(int value) : value(value) {}
};

int main()
{
  std::println(std::isConvertible<int, std::Optional<Converts>>, " ", std::isConvertible<int, std::Optional<OnlyExplicit>>);
  std::println(std::isConvertible<std::Pair<int, int>, std::Pair<Converts, long>>, " ", std::isConvertible<std::Pair<int, int>, std::Pair<OnlyExplicit, long>>);
  std::println(std::isConstructible<std::Optional<OnlyExplicit>, int>, " ", std::isConstructible<std::Pair<OnlyExplicit, long>, std::Pair<int, int>>);
  std::Optional<Converts> a = 5;
  std::Optional<OnlyExplicit> b(6);
  std::Pair<Converts, long> c = std::Pair<int, int>(7, 8);
  std::Pair<OnlyExplicit, long> d(std::Pair<int, int>(9, 10));
  std::println(a->value, " ", b->value, " ", c.first.value, " ", d.first.value);
  return 0;
}
