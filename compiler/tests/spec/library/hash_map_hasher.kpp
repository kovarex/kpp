// spec: HashMap and HashSet with a hasher and a key equality argument (std::unordered_map<K, V, Hash, KeyEqual>), the default Hash<K> through hashOf for doubles, enums and SharedPtr keys, and FastHashMap with the same parameters
// factorio: 6 unordered containers with a hasher (RailLocation::Hasher, CoordinateHash, NoiseRegisterIndexHash), keys of type double, enum and shared_ptr
struct Point { int x, y; bool operator==(const Point& o) const { return this.x == o.x && this.y == o.y; } };
struct PointHash { size_t operator()(const Point& p) const { return (size_t)(p.x * 1000 + p.y); } };
struct SameX { bool operator()(const Point& a, const Point& b) const { return a.x == b.x; } };
enum class Color { Red, Green };
int main()
{
  std::HashMap<Point, int, PointHash> grid;
  grid[Point{1, 2}] = 12;
  grid[Point{3, 4}] = 34;
  std::HashSet<Point, PointHash, SameX> columns;
  columns.insert(Point{1, 1});
  [[maybe_unused]] std::HashSet<Point, std::Hash<int>, SameX>* unused = nullptr;
  std::HashMap<double, int> byDouble;
  byDouble[0.5] = 1;
  byDouble[-0.0] = 2;
  std::HashMap<Color, int> byColor;
  byColor[Color::Green] = 7;
  std::HashMap<std::SharedPtr<int>, int> byPointer;
  std::SharedPtr<int> p = std::makeShared<int>(3);
  byPointer[p] = 9;
  std::FastHashMap<Point, int, PointHash> fast;
  fast[Point{5, 6}] = 56;
  std::println(grid[Point{1, 2}], " ", grid.size(), " ", grid.contains(Point{3, 4}), " ", byDouble[0.0], " ", byColor[Color::Green], " ", byPointer[p], " ", fast[Point{5, 6}], " ", std::Hash<int>()(5) == std::hashOf(5));
  return 0;
}
