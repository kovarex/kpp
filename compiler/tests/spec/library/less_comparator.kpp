// spec: Less<T> and the transparent Less<> (std::less<>) as comparator objects; `Name<>` written with empty brackets takes every default
// found in src/Util (FlatMap<K, V, Comp = std::less<>>)
template<typename T, typename Comp = std::Less<>>
struct Ordered
{
  T a;
  T b;
  Comp comp;
  bool ordered() const { return this.comp(this.a, this.b); }
};
int main()
{
  Ordered<int> p{1, 2};
  Ordered<int, std::Greater<int>> q{1, 2};
  std::Less<std::String> byString;
  std::println(p.ordered(), " ", q.ordered(), " ", byString(std::String("a"), std::String("b")), " ", std::Less<>()(3, 2));
  return 0;
}
