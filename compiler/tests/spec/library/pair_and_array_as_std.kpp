// spec: Pair is std::pair and Array std::array: value-initialized by default, reference members, converting construction and assignment, swap, get by index and by type, comparisons, move-only members; Array's members, Array<T, 0>, toArray; the output is what libstdc++ and MSVC's STL print for the same program
// factorio: unspecified until K's battery pa1: a Pair() left its numbers unset, Pair<int&, int&> did not construct, Pair::swap, get<T>, TupleSize<Pair>, Array::max_size and toArray did not exist
extern "C" int printf(const char* format, ...);
extern "C" import "string.h";
struct Moved
{
  int value;
  Moved(int v) : value(v) {}
  Moved(const Moved& other) : value(other.value) { printf("copy\n"); }
  Moved(Moved&& other) noexcept : value(other.value) { other.value = -1; printf("move\n"); }
  Moved& operator=(const Moved& other) { this.value = other.value; printf("copy=\n"); return this; }
  Moved& operator=(Moved&& other) noexcept { this.value = other.value; other.value = -1; printf("move=\n"); return this; }
};

struct Base
{
  int x = 1;
};

struct Derived : Base
{
};

int main()
{
  char scribble[sizeof(std::Pair<int, double>)];
  memset(scribble, 0x55, sizeof(scribble));
  std::Pair<int, double>* p = new (scribble) std::Pair<int, double>();
  printf("default %d %g\n", p->first, p->second);
  std::Pair<int, double> q(1, 2.5);
  printf("values %d %g\n", q.first, q.second);
  std::Pair<long long, float> widened(q);
  printf("converting copy %lld %g\n", widened.first, widened.second);
  std::Pair<long long, float> assigned;
  assigned = q;
  printf("converting assign %lld %g\n", assigned.first, assigned.second);
  auto made = std::makePair(3, 'c');
  printf("makePair %d %c\n", made.first, made.second);
  std::Pair deduced(4, 2.0);
  printf("deduced %d %g\n", deduced.first, deduced.second);
  std::Pair<int, int> braced = {5, 6};
  printf("braced %d %d\n", braced.first, braced.second);
  std::Pair<int, int> a(1, 2);
  std::Pair<int, int> b(1, 3);
  printf("== %d %d\n", (int)(a == a), (int)(a == b));
  printf("!= %d\n", (int)(a != b));
  printf("< %d %d\n", (int)(a < b), (int)(b < a));
  printf("> <= >= %d %d %d\n", (int)(a > b), (int)(a <= b), (int)(a >= b));
  printf("<=> %d\n", (int)((a <=> b) < 0));
  a.swap(b);
  printf("swap %d %d\n", a.second, b.second);
  std::swap(a, b);
  printf("free swap %d %d\n", a.second, b.second);
  printf("get %d %d\n", std::get<0>(a), std::get<1>(a));
  std::get<1>(a) = 9;
  printf("get writes %d\n", a.second);
  printf("get by type %d\n", std::get<int>(made));
  auto [one, two] = a;
  printf("structured %d %d\n", one, two);
  auto& [refOne, refTwo] = a;
  refOne = 7;
  printf("structured reference %d\n", a.first);
  int left = 1;
  int right = 2;
  std::Pair<int&, int&> refs(left, right);
  refs.first = 10;
  printf("reference members %d\n", left);
  std::Pair<int&, int&> other(right, left);
  refs = std::Pair<int, int>(20, 30);
  printf("assign through references %d %d\n", left, right);
  std::Pair<std::String, std::String> s("first", "second");
  std::Pair<std::String, std::String> t = std::move(s);
  printf("moved %s %s %d\n", t.first.c_str(), t.second.c_str(), (int)s.first.empty());
  std::Pair<std::UniquePtr<int>, int> owner(std::UniquePtr<int>(new int(5)), 1);
  std::Pair<std::UniquePtr<int>, int> taken = std::move(owner);
  printf("move only %d %d\n", *taken.first, (int)(owner.first == nullptr));
  Moved value(1);
  std::Pair<Moved, int> byCopy(value, 1);
  std::Pair<Moved, int> byMove(std::move(value), 1);
  std::Pair<Moved, int> again(2, 3);
  again = byCopy;
  again = std::move(byMove);
  std::Pair<Base*, int> upcast = std::Pair<Derived*, int>(nullptr, 2);
  printf("pointer conversion %d\n", upcast.second);

  std::Array<int, 4> r = {1, 2, 3, 4};
  std::Array<int, 4> z = {};
  std::Array<int, 3> partly = {7};
  printf("sizes %d %d %d\n", (int)r.size(), (int)r.max_size(), (int)r.empty());
  printf("zeroed %d %d\n", z[0], z[3]);
  printf("partly %d %d %d\n", partly[0], partly[1], partly[2]);
  printf("front back %d %d\n", r.front(), r.back());
  r.front() = 5;
  r.back() = 8;
  printf("writes %d %d\n", r[0], r[3]);
  printf("at %d\n", r.at(1));
  try
  {
    r.at(4);
    printf("no throw\n");
  }
  catch (const std::OutOfRange&)
  {
    printf("at past the end throws\n");
  }
  printf("data %d\n", (int)(r.data() == &r[0]));
  printf("iterators %d %d\n", (int)(r.end() - r.begin()), *r.begin());
  printf("const iterators %d\n", (int)(r.cend() - r.cbegin()));
  printf("reverse %d %d\n", *r.rbegin(), *(r.rend() - 1));
  printf("const reverse %d\n", *r.crbegin());
  const std::Array<int, 4>& constant = r;
  printf("const access %d %d %d %d\n", constant[1], constant.front(), constant.back(), constant.at(2));
  printf("const data %d\n", *constant.data());
  int sum = 0;
  for (int x : r)
    sum += x;
  printf("sum %d\n", sum);
  r.fill(3);
  printf("fill %d %d\n", r[0], r[3]);
  std::Array<int, 4> w = {1, 2, 3, 4};
  r.swap(w);
  printf("swap %d %d\n", r[0], w[0]);
  std::swap(r, w);
  printf("free swap %d %d\n", r[0], w[0]);
  std::Array<int, 4> c = {3, 3, 3, 4};
  printf("== %d %d\n", (int)(r == r), (int)(r == c));
  printf("!= %d\n", (int)(r != c));
  printf("< %d\n", (int)(r < c));
  printf("<=> %d\n", (int)((r <=> c) == 0));
  printf("get %d\n", std::get<2>(c));
  std::get<2>(c) = 6;
  printf("get writes %d\n", c[2]);
  printf("tuple_size %d\n", (int)std::TupleSize<std::Array<int, 4>>::value);
  auto [e0, e1, e2, e3] = c;
  printf("structured %d %d\n", e0, e3);
  std::Array<int, 0> nothing;
  printf("empty %d %d %d\n", (int)nothing.size(), (int)nothing.empty(), (int)(nothing.begin() == nothing.end()));
  std::Array<int, 0> nothing2;
  printf("empty == %d\n", (int)(nothing == nothing2));
  std::Array<std::String, 2> texts = {"a", "b"};
  std::Array<std::String, 2> copied = texts;
  copied[0] = "c";
  printf("copy %s %s\n", texts[0].c_str(), copied[0].c_str());
  std::Array<std::String, 2> movedTexts = std::move(texts);
  printf("move %s\n", movedTexts[1].c_str());
  std::Array deducedArray = {1, 2, 3};
  printf("deduced %d\n", (int)deducedArray.size());
  auto fromC = std::toArray({1, 2, 3});
  printf("toArray %d\n", (int)fromC.size());
  int cArray[] = {4, 5};
  auto fromCArray = std::toArray(cArray);
  printf("toArray of an array %d\n", fromCArray[1]);
  std::Array<std::Pair<int, int>, 2> pairs = {{{1, 2}, {3, 4}}};
  printf("nested %d\n", pairs[1].second);
  std::sort(c.begin(), c.end());
  printf("sort %d %d\n", c[0], c[3]);
  return 0;
}
