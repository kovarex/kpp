// spec: a constructor taking InitializerList, called with a brace list
struct Poly { std::Vector<int> xs; Poly(std::InitializerList<int> list) { for (int v : list) this.xs.push_back(v); } };
int main()
{
  Poly p({1, 2, 3, 4});
  Poly q = {5, 6};
  std::println(p.xs.size(), " ", q.xs[1]);
  return 0;
}
