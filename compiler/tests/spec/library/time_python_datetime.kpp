// spec: calendar time against Python's datetime: 600 random instants over the years 1 to 9999 (microsecond fractions), each formatted as RFC 3339 with 6 fraction digits and as an HTTP date (the weekday from Python), parsed back to the same instant, and taken apart into its civil fields
// factorio: none; the kpp.net site and registry need dates (thread G); the rows come from Python 3's datetime, seed 20261101
struct PythonInstant
{
  long long microseconds; // since 1970-01-01T00:00:00Z
  const char* rfc3339;
  const char* httpDate;
};

