int main()
{
  int differ = 0;
  for (const PythonInstant& p : pythonInstants)
  {
    TimePoint<SystemClock> t(Duration<long long, Ratio<1, 10000000>>(p.microseconds * 10));
    String rfc = formatRfc3339(t, 6);
    String http = formatHttpDate(t);
    Optional<TimePoint<SystemClock>> rfcBack = parseRfc3339(p.rfc3339);
    Optional<TimePoint<SystemClock>> httpBack = parseHttpDate(p.httpDate);
    TimePoint<SystemClock> whole = SystemClock::from_time_t(SystemClock::to_time_t(t));
    bool same = rfc == p.rfc3339 && http == p.httpDate && rfcBack.hasValue() && rfcBack.value() == t && httpBack.hasValue() && httpBack.value() == whole;
    if (!same)
    {
      ++differ;
      println("{}: {} {}", p.rfc3339, rfc, http);
    }
  }
  println("{} instants, {} differ", int(sizeof(pythonInstants) / sizeof(pythonInstants[0])), differ);
  return 0;
}
