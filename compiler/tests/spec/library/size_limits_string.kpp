// spec: a String holds at most maxContainerSize (2^64 - 2) bytes, its sizes being ContainerSize: an append, insert or construction that would make it longer (a length plus a count that would wrap past 2^64 included) throws LengthError("string too long") before it copies a byte, as std::string throws length_error past max_size(), and leaves the string as it was; a byte range that runs backwards (last before first) does too
// factorio: none known; the guarantee that a size past the size's range is an error, not a wrapped length and a write past the block (String's append compared length + count, which wrapped, with the capacity: negative with int sizes, past 2^64 with u64)
int main()
{
  String text = "a heap string, longer than twenty-two bytes";
  const char* bytes = text.data();
  ContainerSize before = text.size();
  try
  {
    text.append(bytes, maxContainerSize);
    println("appended");
  }
  catch (const LengthError& e)
  {
    println("append: {}, size {}", e.what(), text.size() == before);
  }
  try
  {
    text.append(maxContainerSize - 10, 'x');
    println("appended");
  }
  catch (const LengthError& e)
  {
    println("append count: {}, size {}", e.what(), text.size() == before);
  }
  try
  {
    text.insert(3, bytes, maxContainerSize);
    println("inserted");
  }
  catch (const LengthError& e)
  {
    println("insert: {}, size {}", e.what(), text.size() == before);
  }
  // A range that runs backwards: its length is negative, checked before a byte is read.
  try
  {
    String range(bytes + 3, bytes);
    println("constructed {}", range.size());
  }
  catch (const LengthError& e)
  {
    println("range: {}", e.what());
  }
  println("{}", text);
  return 0;
}
