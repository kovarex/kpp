// spec: filesystem::equivalent(a, b): whether two paths name the same file or directory, links followed, whatever their spelling; with an ErrorCode, false and the error when either does not resolve, else it throws filesystem_error
// factorio: the debug adapter's BreakpointSource::isSameSource since Factorio df1c9d1cd3c, `Filesystem::equivalent(other.path, this->path, ec)`
int main()
{
  std::filesystem::path dir = std::filesystem::temp_directory_path() / "kpp-spec-equivalent";
  std::filesystem::create_directories(dir / "sub");
  {
    std::OutFileStream out((dir / "a.txt").string());
    out << "a";
  }
  {
    std::OutFileStream out((dir / "b.txt").string());
    out << "b";
  }
  std::ErrorCode ec;
  bool same = std::filesystem::equivalent(dir / "a.txt", dir / "sub" / ".." / "a.txt", ec);
  bool other = std::filesystem::equivalent(dir / "a.txt", dir / "b.txt", ec);
  bool directory = std::filesystem::equivalent(dir / "sub", dir / "sub" / ".", ec);
  bool missing = std::filesystem::equivalent(dir / "a.txt", dir / "none.txt", ec);
  bool reported = (bool)ec;
  bool thrown = false;
  try
  {
    std::filesystem::equivalent(dir / "none.txt", dir / "a.txt");
  }
  catch (const std::filesystem::filesystem_error&)
  {
    thrown = true;
  }
  std::filesystem::remove_all(dir);
  std::println(same, " ", other, " ", directory, " ", missing, " ", reported, " ", thrown);
  return 0;
}
