// spec: filesystem::equivalent(a, b): whether two paths name the same file or directory, links followed, whatever their spelling; with an ErrorCode, false and the error when either does not resolve, else it throws filesystem_error
// factorio: the debug adapter's BreakpointSource::isSameSource since Factorio df1c9d1cd3c, `Filesystem::equivalent(other.path, this->path, ec)`
int main()
{
  filesystem::path dir = filesystem::temp_directory_path() / "kpp-spec-equivalent";
  filesystem::create_directories(dir / "sub");
  {
    OutFileStream out((dir / "a.txt").string());
    out << "a";
  }
  {
    OutFileStream out((dir / "b.txt").string());
    out << "b";
  }
  ErrorCode ec;
  bool same = filesystem::equivalent(dir / "a.txt", dir / "sub" / ".." / "a.txt", ec);
  bool other = filesystem::equivalent(dir / "a.txt", dir / "b.txt", ec);
  bool directory = filesystem::equivalent(dir / "sub", dir / "sub" / ".", ec);
  bool missing = filesystem::equivalent(dir / "a.txt", dir / "none.txt", ec);
  bool reported = (bool)ec;
  bool thrown = false;
  try
  {
    filesystem::equivalent(dir / "none.txt", dir / "a.txt");
  }
  catch (const filesystem::filesystem_error&)
  {
    thrown = true;
  }
  filesystem::remove_all(dir);
  println("{} {} {} {} {} {}", same, other, directory, missing, reported, thrown);
  return 0;
}
