// spec: C++20's <bit> under kpp's names, as std's (MSVC's STL and libstdc++ print the same for the C++ of this program): rotl and rotr for every unsigned type (a count modulo the width, a negative one rotating the other way), popcount, countlZero, countlOne, countrZero, countrOne, bitWidth, bitCeil, bitFloor, hasSingleBit and byteswap (of a signed type too); each folds at compile time
extern "C" int printf(const char* format, ...);
static_assert(rotl((u8)0x81, 1) == 3 && popcount(0xFFull) == 8 && countlZero(1u) == 31 && bitCeil(5u) == 8 && byteswap((u16)0x1234) == 0x3412);

int main()
{
  printf("rotl %u %u %u %llu\n", (unsigned)rotl((u8)0x81, 1), (unsigned)rotl((u16)0x8001, 4), (unsigned)rotl(0x80000001u, -1), (unsigned long long)rotl(0x8000000000000001ull, 65));
  printf("rotr %u %u %u %llu\n", (unsigned)rotr((u8)0x81, 1), (unsigned)rotr((u16)0x8001, 4), (unsigned)rotr(0x80000001u, 0), (unsigned long long)rotr(0x8000000000000001ull, -3));
  printf("popcount %d %d %d %d\n", popcount((u8)0xFF), popcount((u16)0x0F0F), popcount(0u), popcount(0xFFFFFFFFFFFFFFFFull));
  printf("countl %d %d %d %d %d %d\n", countlZero((u8)1), countlZero(0u), countlZero(0x00FF0000u), countlOne((u8)0xF0), countlOne(0xFFFFFFFFu), countlOne(1ull));
  printf("countr %d %d %d %d %d\n", countrZero((u16)8), countrZero(0ull), countrZero(0x80000000u), countrOne((u8)0x0F), countrOne(0xFFFFu));
  printf("width %d %d %d %d\n", bitWidth(0u), bitWidth(1u), bitWidth((u8)255), bitWidth(0x80000000u));
  printf("ceil %u %u %u %u %llu\n", (unsigned)bitCeil(0u), (unsigned)bitCeil(1u), (unsigned)bitCeil(5u), (unsigned)bitCeil((u8)100), (unsigned long long)bitCeil(0x8000000000000000ull));
  printf("floor %u %u %u %u\n", (unsigned)bitFloor(0u), (unsigned)bitFloor(1u), (unsigned)bitFloor(5u), (unsigned)bitFloor((u8)255));
  printf("single %d %d %d %d\n", (int)hasSingleBit(0u), (int)hasSingleBit(64u), (int)hasSingleBit(65u), (int)hasSingleBit((u8)128));
  printf("byteswap %x %x %llx %x\n", (unsigned)byteswap((u16)0x1234), (unsigned)byteswap(0x11223344u), (unsigned long long)byteswap(0x1122334455667788ull), (unsigned)byteswap((int)0x11223344));
  return 0;
}
