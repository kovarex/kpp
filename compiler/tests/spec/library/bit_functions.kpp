// spec: C++20's <bit> under kpp's names, as std's (MSVC's STL and libstdc++ print the same for the C++ of this program): rotl and rotr for every unsigned type (a count modulo the width, a negative one rotating the other way), popcount, countlZero, countlOne, countrZero, countrOne, bitWidth, bitCeil, bitFloor, hasSingleBit and byteswap (of a signed type too); each folds at compile time
extern "C" int printf(const char* format, ...);
static_assert(std::rotl((u8)0x81, 1) == 3 && std::popcount(0xFFull) == 8 && std::countlZero(1u) == 31 && std::bitCeil(5u) == 8 && std::byteswap((u16)0x1234) == 0x3412);

int main()
{
  printf("rotl %u %u %u %llu\n", (unsigned)std::rotl((u8)0x81, 1), (unsigned)std::rotl((u16)0x8001, 4), (unsigned)std::rotl(0x80000001u, -1), (unsigned long long)std::rotl(0x8000000000000001ull, 65));
  printf("rotr %u %u %u %llu\n", (unsigned)std::rotr((u8)0x81, 1), (unsigned)std::rotr((u16)0x8001, 4), (unsigned)std::rotr(0x80000001u, 0), (unsigned long long)std::rotr(0x8000000000000001ull, -3));
  printf("popcount %d %d %d %d\n", std::popcount((u8)0xFF), std::popcount((u16)0x0F0F), std::popcount(0u), std::popcount(0xFFFFFFFFFFFFFFFFull));
  printf("countl %d %d %d %d %d %d\n", std::countlZero((u8)1), std::countlZero(0u), std::countlZero(0x00FF0000u), std::countlOne((u8)0xF0), std::countlOne(0xFFFFFFFFu), std::countlOne(1ull));
  printf("countr %d %d %d %d %d\n", std::countrZero((u16)8), std::countrZero(0ull), std::countrZero(0x80000000u), std::countrOne((u8)0x0F), std::countrOne(0xFFFFu));
  printf("width %d %d %d %d\n", std::bitWidth(0u), std::bitWidth(1u), std::bitWidth((u8)255), std::bitWidth(0x80000000u));
  printf("ceil %u %u %u %u %llu\n", (unsigned)std::bitCeil(0u), (unsigned)std::bitCeil(1u), (unsigned)std::bitCeil(5u), (unsigned)std::bitCeil((u8)100), (unsigned long long)std::bitCeil(0x8000000000000000ull));
  printf("floor %u %u %u %u\n", (unsigned)std::bitFloor(0u), (unsigned)std::bitFloor(1u), (unsigned)std::bitFloor(5u), (unsigned)std::bitFloor((u8)255));
  printf("single %d %d %d %d\n", (int)std::hasSingleBit(0u), (int)std::hasSingleBit(64u), (int)std::hasSingleBit(65u), (int)std::hasSingleBit((u8)128));
  printf("byteswap %x %x %llx %x\n", (unsigned)std::byteswap((u16)0x1234), (unsigned)std::byteswap(0x11223344u), (unsigned long long)std::byteswap(0x1122334455667788ull), (unsigned)std::byteswap((int)0x11223344));
  return 0;
}
