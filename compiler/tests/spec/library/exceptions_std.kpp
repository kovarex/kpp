// spec: the standard exception classes (Exception, RuntimeError, LogicError, OutOfRange, InvalidArgument)
// factorio: 410 std::exception / runtime_error uses in 216 files
void check(int i)
{
  if (i < 0) throw std::InvalidArgument(std::String("negative"));
  if (i > 9) throw std::OutOfRange(std::String("too big"));
}
int main()
{
  std::String log;
  for (int i : {-1, 5, 10})
  {
    try { check(i); log << "ok "; }
    catch (const std::OutOfRange& e) { log << "range:"; log << std::StringView(e.what()); log << ' '; }
    catch (const std::Exception& e) { log << "other:"; log << std::StringView(e.what()); log << ' '; }
  }
  std::println(log);
  return 0;
}
