// spec: isConstructible of an array, by C++20's parentheses: as many values as elements at most, each converting to an element (narrowing allowed, no braces elided), the rest value-initialized (an element with no default constructor needs every value), an array of no known bound none; clang's output
extern "C" int printf(const char* format, ...);
struct Agg { int a; double b; };
struct NoDefault { implicit NoDefault(int) {} };
int main()
{
  printf("%d%d%d%d %d%d%d%d %d%d%d\n", std::isConstructible<int[3], int>, std::isConstructible<int[3], int, int, int>, std::isConstructible<int[3], int, int, int, int>, std::isConstructible<int[3]>,
         std::isConstructible<int[], int>, std::isConstructible<int[2], const char*>, std::isConstructible<Agg[2], Agg>, std::isConstructible<int[3], double>,
         std::isConstructible<NoDefault[2], int>, std::isConstructible<NoDefault[2], int, int>, std::isConstructible<int[2][2], int>);
  return 0;
}
