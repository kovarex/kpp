// spec: HashMap's and HashSet's emplace(args...) build the entry in its node, as std's: no copy or move of it, so a value that can be neither copied nor moved is emplaced; an entry built for a key that is there already is destroyed, the old one kept
// factorio: K's ranking of the stdlib gaps (2026-11-06): emplace built the entry and then moved it into its node (docs/stdlib-conformance.md)
struct Fixed
{
  static int built, destroyed;
  int value;
  Fixed(int value) : value(value) { This::built++; }
  Fixed(const Fixed&) = delete;
  Fixed(Fixed&&) = delete;
  ~Fixed() { This::destroyed++; }
};

int Fixed::built = 0;
int Fixed::destroyed = 0;

struct Key
{
  static int moved;
  int id;
  Key(int id) : id(id) {}
  Key(const Key& other) : id(other.id) {}
  Key(Key&& other) : id(other.id) { This::moved++; }
  bool operator==(const Key& other) const { return this.id == other.id; }
};

int Key::moved = 0;
usize hashOf(const Key& key) { return std::hashOf(key.id); }

int main()
{
  std::HashMap<int, Fixed> map;
  for (int i = 0; i < 20; ++i)
    map.emplace(std::piecewiseConstruct, std::forwardAsTuple(i), std::forwardAsTuple(i * 10));
  auto [it, created] = map.emplace(std::piecewiseConstruct, std::forwardAsTuple(3), std::forwardAsTuple(99));
  std::println(map.size(), " ", created, " ", it->second.value, " ", Fixed::built, " built ", Fixed::destroyed, " destroyed");
  std::println(map.at(19).value);
  std::HashSet<Key> keys;
  auto [where, added] = keys.emplace(7);
  auto [again, addedAgain] = keys.emplace(7);
  std::println(keys.size(), " ", added, " ", addedAgain, " ", where->id, " ", where == again, " moved ", Key::moved);
  auto hinted = map.emplace_hint(map.begin(), std::piecewiseConstruct, std::forwardAsTuple(40), std::forwardAsTuple(4));
  std::println(hinted->first, " ", hinted->second.value, " ", map.size());
  return 0;
}
