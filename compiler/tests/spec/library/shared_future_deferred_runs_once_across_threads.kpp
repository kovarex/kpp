// spec: a deferred async's function runs exactly once, on the first get() or wait(), when several threads call get() on SharedFutures of it at once; the others wait for its result, as in C++
// factorio: ThreadSafeSpotNoiseCache's deferred spots, gotten from map generation's worker threads (PlanetGeneration/NauvisIslandMapGeneration stopped on an empty Function about 1 run in 10)
int main()
{
  const int rounds = 300;
  const int threads = 8;
  Atomic<int> runs = 0;
  Atomic<int> wrong = 0;
  Atomic<int> thrown = 0;
  for (int round = 0; round < rounds; ++round)
  {
    SharedFuture<int> shared(async(Launch::deferred, [&runs]() -> int { runs.fetch_add(1); return 42; }));
    // A gate the threads block on until all of them have started, then call get() together. (Not a
    // spin: on CI's 2 CPUs, 8 spinners took 61 s of the program's 60, and yielding ones still timed
    // out in the release build, the thread still to start waiting for a CPU behind them.)
    Mutex gateMutex;
    ConditionVariable gate;
    int started = 0;
    Vector<Thread> workers;
    for (int i = 0; i < threads; ++i)
      workers.push_back(Thread([shared, &gateMutex, &gate, &started, &wrong, &thrown]() {
        {
          UniqueLock<Mutex> lock(gateMutex);
          if (++started == threads)
            gate.notifyAll();
          else
            gate.wait(lock, [&started]() -> bool { return started == threads; });
        }
        try
        {
          if (shared.get() != 42)
            wrong.fetch_add(1);
        }
        catch (...)
        {
          thrown.fetch_add(1);
        }
      }));
    for (Thread& worker : workers)
      worker.join();
  }
  println(runs.load() == rounds, " ", wrong.load(), " ", thrown.load());
  return 0;
}
