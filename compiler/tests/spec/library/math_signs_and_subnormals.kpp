// spec: abs of a floating value is its magnitude without a sign, as fabs and std::abs: abs(-0.0) is +0 (1 / abs(-0.0) is inf) and a NaN's sign bit is cleared; isnormal is false for a subnormal (4.9e-324, 1e-45f) as for zero, infinity and NaN; signbit reads the sign bit, a negative NaN's too (0.0 / 0.0 is one on x86-64). Before, abs(-0.0) was -0, isnormal of a subnormal true, and signbit of every NaN false: silent wrong answers. clang (MSVC's runtime) prints the same
// found comparing kpp with clang (thread I's math battery)
int main()
{
  volatile double zero = 0;
  double nz = -zero;
  float nzf = float(-zero);
  double nan = zero / zero;
  double sub = 4.9e-324 * (1 + zero);
  float subf = 1e-45f * float(1 + zero);
  std::println(1 / std::abs(nz), " ", 1 / double(std::abs(nzf)), " ", std::signbit(std::abs(nan)), " ", std::signbit(std::abs(-nan)), " ", std::abs(-2.5), " ", std::abs(-1.5f));
  std::println(isnormal(sub), " ", isnormal(subf), " ", isnormal(2.2250738585072014e-308 * (1 + zero)), " ", isnormal(1.0), " ", isnormal(0.0), " ", isnormal(nan));
  std::println(std::signbit(-nan) != std::signbit(nan), " ", std::signbit(-0.0), " ", std::signbit(0.0), " ", std::signbit(-1e-300), " ", std::signbit(-0.0f));
  return 0;
}
