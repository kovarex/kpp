// spec: a Span iterates backwards through rbegin() and rend() (std::span's), so the free rbegin and rend and a reversing wrapper over a Span work: `for (int x : reverseOf(Span<int>(data, 3)))` visits 3, 2, 1
// found in the converted game: CommonUtil's `Util::reverse(span)`, whose ReversionWrapperByValue's `auto begin(...) { return rbegin(w.iterable); }` found no rbegin of a Span (Inserter, Inventory, InventoryWithFilters: 9 "the type auto of FunctionDecl")
template <typename T>
struct ByValue { T iterable; };
template <typename T>
auto begin(ByValue<T> w) { return rbegin(w.iterable); }
template <typename T>
auto end(ByValue<T> w) { return rend(w.iterable); }
template <typename T>
ByValue<T> reverseOf(T&& iterable) { return { ::move(iterable) }; }
int main()
{
  int data[3] = {1, 2, 3};
  Span<int> s(data, 3);
  int sum = 0;
  int weight = 1;
  for (int x : reverseOf(Span<int>(data, 3)))
  {
    sum += x * weight;
    weight *= 10;
  }
  println("{} {}", sum, *rbegin(s));
  return 0;
}
