// spec: Optional's value() on empty throws BadOptionalAccess, reset() and emplace() destroy at once, nullopt and < comparisons; calling an empty Function throws BadFunctionCall
// factorio: 1,675 std::optional uses, 1,576 std::function
struct Loud
{
  int id = 0;
  Loud() {}
  Loud(int id) : id(id) {}
  ~Loud() { if (this.id) std::println("-", this.id); }
};
int main()
{
  std::Optional<Loud> o;
  o.emplace(5);
  o.emplace(6);
  o.reset();
  std::println("reset: ", o.has_value());
  std::Optional<std::UniquePtr<int>> p = std::makeUnique<int>(4);
  std::println("move-only: ", **p, " ", p == std::nullopt);
  std::Optional<int> empty;
  bool threw = false;
  try { empty.value(); } catch (const std::BadOptionalAccess& e) { threw = true; }
  std::Optional<int> one = 1;
  std::println("value() throws ", threw, ", order ", empty < one, " ", one < empty);
  std::Function<int(int)> f;
  bool called = false;
  try { f(3); } catch (const std::BadFunctionCall& e) { called = true; }
  std::println("empty call throws ", called);
  return 0;
}
