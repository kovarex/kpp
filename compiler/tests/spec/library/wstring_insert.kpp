// spec: WString's insert before an index of a WString, a zero-terminated text, count copies of a unit and part of itself, as std::wstring inserts them; an index past the end throws OutOfRange
// factorio: the tests' ForkTask.cpp, `params.insert(0, executablePath + L" ")` on the command line it hands CreateProcessW
std::String narrow(const std::WString& text)
{
  std::String out;
  for (int i = 0; i < text.size(); ++i)
    out.push_back(char(text[i]));
  return out;
}
int main()
{
  std::WString params = L"--run-test x";
  std::WString exe = L"C:\\factorio.exe";
  params.insert(0, exe + L" ");
  std::println(narrow(params), " ", params.size());
  params.insert(params.size(), L" 2>&1");
  params.insert(3, 2, L'_');
  std::println(narrow(params));
  std::WString self = L"abc";
  self.insert(1, self);
  std::println(narrow(self), " ", self.size());
  std::WString empty;
  empty.insert(0, L"");
  empty.insert(0, L"z");
  std::println(narrow(empty));
  try
  {
    self.insert(99, L"x");
  }
  catch (const std::OutOfRange&)
  {
    std::println("out of range");
  }
  return 0;
}
