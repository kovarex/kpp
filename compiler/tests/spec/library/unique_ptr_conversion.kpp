// spec: UniquePtr<Base> from UniquePtr<Derived> (constructor, assignment, argument), and from nullptr
// factorio: Agui hands derived widgets over as UniquePtr<Widget> (ValueToWidget::makeCollapsibleValue(move(table)), 335 calls)
class Widget { public: virtual ~Widget() { std::println("~Widget"); } int w = 1; };
class Table : public Widget { public: ~Table() override { std::println("~Table"); } };
int describe(std::UniquePtr<Widget> widget) { return widget->w; }
int main()
{
  std::UniquePtr<Table> table = std::makeUnique<Table>();
  int w = describe(std::move(table));
  std::println("passed ", w, " ", table.get() == nullptr);
  std::UniquePtr<Widget> holder;
  holder = std::makeUnique<Table>();
  std::UniquePtr<Widget> empty = nullptr;
  std::println("assigned ", holder->w, " ", empty.get() == nullptr);
  return 0;
}
