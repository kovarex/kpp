// spec: filesystem::path (std::filesystem::path): its parts (root name and directory, filename, stem, extension, parent), its elements, `/` and its rules, lexically_normal and lexically_relative, and element-wise comparison; ErrorCode against Errc
// factorio: Filesystem::Path over std::filesystem::path (1,221 uses), Package::normalizedPath's loop over the elements, FileUtil's isSubdir
std::String show(const std::filesystem::path& p) { return "[" + p.generic_string() + "]"; }

void parts(const char* text)
{
  std::filesystem::path p(text);
  std::String elements;
  for (const std::filesystem::path& e : p)
    elements << show(e);
  std::println(show(p.root_name()), " ", show(p.root_directory()), " ", show(p.parent_path()), " ", show(p.filename()), " ", show(p.stem()), " ", show(p.extension()), " ", p.is_absolute(), " | ", elements);
}

int main()
{
  parts("C:\\a\\b.txt");
  parts("a/b/");
  parts("C:x");
  parts("\\\\server\\share\\f");
  parts(".profile");
  std::println(show(std::filesystem::path("C:") / "a"), " ", show(std::filesystem::path("a/") / "b"), " ", show(std::filesystem::path("a") / "C:\\abs"), " ", show(std::filesystem::path("a/b/c") / "\\d"));
  std::println(show(std::filesystem::path("a/./b/../c").lexically_normal()), " ", show(std::filesystem::path("a/b/..").lexically_normal()), " ", show(std::filesystem::path("a/..").lexically_normal()), " ", show(std::filesystem::path("C:/../x").lexically_normal()));
  std::println(show(std::filesystem::path("a/b/c").lexically_relative("a/d")), " ", show(std::filesystem::path("a/b").lexically_relative("a/b")));
  std::filesystem::path file = "dir/file.tar.gz";
  file.replace_extension(".png");
  std::println(show(file), " ", std::filesystem::path("a/b") == std::filesystem::path("a\\b"), " ", std::filesystem::path("a/b") < std::filesystem::path("a-b"));
  std::ErrorCode notFound(2, std::systemCategory());
  std::println(notFound == std::Errc::no_such_file_or_directory, " ", std::make_error_code(std::Errc::file_exists) == std::Errc::file_exists, " ", (bool)std::ErrorCode());
  return 0;
}
