// spec: copy(dest, count, pos) of a StringView and a String (std::string_view::copy, std::string::copy): up to count bytes from pos into dest, as many as there are, and that number back; pos == size() copies none, pos > size() throws OutOfRange
// factorio: StringViewReadStream::read's `this->data.copy(buffer, size, this->pos)` on a std::string_view (4c178a5b915)
int main()
{
  std::StringView text = "converted";
  char buffer[8] = {};
  uint64_t first = text.copy(buffer, 4, 0);
  uint64_t rest = text.copy(buffer + 4, 100, 6);
  uint64_t none = text.copy(buffer, 3, 9);
  std::String owned = "kpp";
  char more[4] = {};
  uint64_t fromString = owned.copy(more, 2, 1);
  bool threw = false;
  try
  {
    text.copy(buffer, 1, 10);
  }
  catch (const std::OutOfRange&)
  {
    threw = true;
  }
  bool stringThrew = false;
  try
  {
    owned.copy(more, 1, 4);
  }
  catch (const std::OutOfRange&)
  {
    stringThrew = true;
  }
  std::println(first, " ", rest, " ", none, " ", std::StringView(buffer, 7), " ", fromString, " ", std::StringView(more, 2), " ", threw, " ", stringThrew);
  return 0;
}
