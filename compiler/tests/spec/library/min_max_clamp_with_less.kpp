// spec: min, max and clamp take a less as std's do: min(a, b, less) and max(a, b, less) give a reference to a when the two are equivalent, clamp(value, low, high, less) a reference to the bound value passed, min and max of a brace list (without a less) the first least (greatest) one
// factorio: K's ranking of the stdlib gaps (2026-11-06): only the forms without a less were there
struct Item
{
  int weight;
  char name;
};

bool lighter(const Item& a, const Item& b) { return a.weight < b.weight; }

int main()
{
  Item a{2, 'a'};
  Item b{2, 'b'};
  Item c{5, 'c'};
  std::println(std::min(a, b, lighter).name, std::max(a, b, lighter).name, std::min(c, a, lighter).name, std::max(a, c, lighter).name);
  Item low{1, 'l'};
  Item high{3, 'h'};
  std::println(std::clamp(c, low, high, lighter).name, std::clamp(Item{0, 'z'}, low, high, lighter).name, std::clamp(a, low, high, lighter).name);
  std::println(&std::clamp(a, low, high, lighter) == &a);
  std::println(std::min({3, 1, 2}), " ", std::max({3, 1, 2}), " ", std::clamp(7, 9, 1, std::Greater<>()));
  return 0;
}
