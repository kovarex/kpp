// spec: ExceptionPtr (std::make_exception_ptr) set on a Promise and thrown again by Future::get
// factorio: SteamContext hands "Couldn't get Steam auth ticket" errors to the waiting thread this way
int main()
{
  std::Promise<int> p;
  std::Future<int> f = p.getFuture();
  p.set_exception(std::makeExceptionPtr(std::RuntimeError(std::String("no ticket"))));
  try { f.get(); } catch (const std::RuntimeError& e) { std::println("caught ", std::StringView(e.what())); }
  std::Promise<int> q;
  std::Future<int> g = q.getFuture();
  q.setValue(5);
  std::ExceptionPtr empty;
  std::println(g.get(), " ", (bool)empty);
  return 0;
}
