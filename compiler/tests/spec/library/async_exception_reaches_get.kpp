// spec: an exception that leaves async's function is stored in its Future and thrown again by get() (std::async, [futures.async] 4: the result or the exception goes to the shared state), on the thread that calls get, not the end of the program (`5 6`)
// factorio: E's concurrency battery against C++ (cc1, 2026-11-06): the program ended with "exception of type int32 thrown through a noexcept function", on Windows and Linux
extern "C" import "stdio.h";
int main()
{
  std::Future<int> failing = std::async([]() -> int { throw 5; });
  std::Future<int> later = std::async(std::Launch::deferred, []() -> int { throw 6; });
  try
  {
    failing.get();
  }
  catch (int code)
  {
    printf("%d ", code);
  }
  try
  {
    later.get();
  }
  catch (int code)
  {
    printf("%d\n", code);
  }
  return 0;
}
