// spec: the uninitialized storage algorithms take iterators and return the end of what they built, as std's: uninitializedCopy(N), uninitializedMove(N), uninitializedFill(N), uninitializedDefaultConstructN, uninitializedValueConstruct(N), destroy, destroyN, constructAt, destroyAt
// factorio: E's battery un1 (2026-11-06): they took pointers only and returned nothing
struct Named
{
  static int live;
  std::String text;
  Named() : text("-") { This::live++; }
  implicit Named(const char* text) : text(text) { This::live++; }
  Named(const Named& other) : text(other.text) { This::live++; }
  Named(Named&& other) : text(std::move(other.text)) { This::live++; }
  ~Named() { This::live--; }
};

int Named::live = 0;

long long storage[64];

void show(std::StringView what, Named* first, Named* last)
{
  std::print(what, ":");
  for (; first != last; ++first)
    std::print(" ", first->text);
  std::println(" (", Named::live, " live)");
}

int main()
{
  Named* room = (Named*)storage;
  std::List<Named> source = {"a", "b", "c"};
  Named* end = std::uninitializedCopy(source.begin(), source.end(), room);
  show("copy", room, end);
  std::destroy(room, end);
  end = std::uninitializedCopyN(source.begin(), 2, room);
  show("copyN", room, end);
  std::println(std::destroyN(room, 2) == end);
  end = std::uninitializedMove(source.begin(), source.end(), room);
  show("move", room, end);
  std::println("source after move: '", source.front().text, "'");
  std::destroy(room, end);
  std::Deque<Named> more = {"x", "y", "z"};
  std::Pair<std::Deque<Named>::iterator, Named*> moved = std::uninitializedMoveN(more.begin(), 2, room);
  show("moveN", room, moved.second);
  std::println("source left at ", moved.first->text);
  std::destroy(room, moved.second);
  std::uninitializedFill(room, room + 2, Named("f"));
  show("fill", room, room + 2);
  std::destroy(room, room + 2);
  end = std::uninitializedFillN(room, 3, Named("g"));
  show("fillN", room, end);
  std::destroy(room, end);
  end = std::uninitializedValueConstructN(room, 2);
  show("valueN", room, end);
  std::destroy(room, end);
  end = std::uninitializedDefaultConstructN(room, 1);
  show("defaultN", room, end);
  std::destroyAt(room);
  Named* built = std::constructAt(room, "c");
  show("constructAt", built, built + 1);
  std::destroyAt(built);
  std::Vector<int> numbers = {1, 2, 3};
  int intRoom[3];
  int* ints = (int*)intRoom;
  int* intsEnd = std::uninitializedCopy(numbers.begin(), numbers.end(), ints);
  std::println(intsEnd - ints, " ", ints[0] + ints[1] + ints[2]);
  std::uninitializedValueConstruct(ints, ints + 3);
  std::println(ints[0] + ints[1] + ints[2]);
  std::println(Named::live - (int)source.size() - (int)more.size());
  return 0;
}
