// spec: the uninitialized storage algorithms take iterators and return the end of what they built, as std's: uninitializedCopy(N), uninitializedMove(N), uninitializedFill(N), uninitializedDefaultConstructN, uninitializedValueConstruct(N), destroy, destroyN, constructAt, destroyAt
// factorio: E's battery un1 (2026-11-06): they took pointers only and returned nothing
struct Named
{
  static int live;
  String text;
  Named() : text("-") { This::live++; }
  implicit Named(const char* text) : text(text) { This::live++; }
  Named(const Named& other) : text(other.text) { This::live++; }
  Named(Named&& other) : text(move(other.text)) { This::live++; }
  ~Named() { This::live--; }
};

int Named::live = 0;

long long storage[64];

void show(StringView what, Named* first, Named* last)
{
  print(what, ":");
  for (; first != last; ++first)
    print(" ", first->text);
  println(" (", Named::live, " live)");
}

int main()
{
  Named* room = (Named*)storage;
  List<Named> source = {"a", "b", "c"};
  Named* end = uninitializedCopy(source.begin(), source.end(), room);
  show("copy", room, end);
  destroy(room, end);
  end = uninitializedCopyN(source.begin(), 2, room);
  show("copyN", room, end);
  println(destroyN(room, 2) == end);
  end = uninitializedMove(source.begin(), source.end(), room);
  show("move", room, end);
  println("source after move: '", source.front().text, "'");
  destroy(room, end);
  Deque<Named> more = {"x", "y", "z"};
  Pair<Deque<Named>::iterator, Named*> moved = uninitializedMoveN(more.begin(), 2, room);
  show("moveN", room, moved.second);
  println("source left at ", moved.first->text);
  destroy(room, moved.second);
  uninitializedFill(room, room + 2, Named("f"));
  show("fill", room, room + 2);
  destroy(room, room + 2);
  end = uninitializedFillN(room, 3, Named("g"));
  show("fillN", room, end);
  destroy(room, end);
  end = uninitializedValueConstructN(room, 2);
  show("valueN", room, end);
  destroy(room, end);
  end = uninitializedDefaultConstructN(room, 1);
  show("defaultN", room, end);
  destroyAt(room);
  Named* built = constructAt(room, "c");
  show("constructAt", built, built + 1);
  destroyAt(built);
  Vector<int> numbers = {1, 2, 3};
  int intRoom[3];
  int* ints = (int*)intRoom;
  int* intsEnd = uninitializedCopy(numbers.begin(), numbers.end(), ints);
  println(intsEnd - ints, " ", ints[0] + ints[1] + ints[2]);
  uninitializedValueConstruct(ints, ints + 3);
  println(ints[0] + ints[1] + ints[2]);
  println(Named::live - (int)source.size() - (int)more.size());
  return 0;
}
