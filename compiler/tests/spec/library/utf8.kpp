// spec: UTF-8 (docs/stdlib/utf8.md): decoding gives U+FFFD for each maximal subpart of bytes that are not UTF-8, as the Unicode Standard's table 3-8 shows (61 F1 80 80 E1 80 C2 62 80 63 80 BF 64 is a, three U+FFFD, b, U+FFFD, c, two U+FFFD, d); overlong forms, surrogates, code points past U+10FFFF and a sequence cut short are not UTF-8; decoding backwards meets the code points decoding forwards does; encoding writes the shortest form and throws InvalidArgument for a code point that is no scalar value; isUtf8, utf8InvalidAt and utf8Length agree with the decoding
// factorio: none; json, html, markdown and url (libraries/), which each had a copy
std::String hexOf(u32 value)
{
  char buffer[16];
  std::snprintf(buffer, sizeof(buffer), "%X", value);
  return std::String(buffer);
}

// Every code point forwards ("!" after one that replaced bytes), then backwards from the end.
void show(std::StringView text)
{
  std::String forward;
  for (std::Utf8CodePointIterator it = std::utf8CodePoints(text).begin(); it != std::utf8CodePoints(text).end(); ++it)
    forward << hexOf(*it) + (it.valid() ? " " : "! ");
  std::String backward;
  for (std::ContainerSize at = text.size(); at > 0;)
  {
    std::Utf8Decoded decoded = std::utf8DecodeBefore(text, at);
    backward = hexOf(decoded.codePoint) + (decoded.valid ? " " : "! ") + backward;
    at -= decoded.length;
  }
  std::println(forward, "| ", forward == backward, " ", std::utf8Length(text), " ", std::isUtf8(text), " ", std::utf8InvalidAt(text) == std::StringView::npos ? std::String("-") : std::toString(std::utf8InvalidAt(text)));
}

int main()
{
  show(std::StringView("\x61\xF1\x80\x80\xE1\x80\xC2\x62\x80\x63\x80\xBF\x64"));
  show(std::StringView("a\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80")); // a, U+00E9, U+20AC, U+1F600
  show(std::StringView("\xC0\xAF"));                                // an overlong '/'
  show(std::StringView("\xE0\x80\x80"));                            // an overlong U+0000
  show(std::StringView("\xED\xA0\x80"));                            // the surrogate U+D800
  show(std::StringView("\xF4\x90\x80\x80"));                        // U+110000
  show(std::StringView("a\xE2\x82"));                               // cut short
  show(std::StringView("\xEF\xBF\xBD"));                            // a U+FFFD the text spells: valid
  std::Utf8Decoded decoded = std::utf8Decode(std::StringView("x\xE2\x82\xAC"), 1);
  std::println(hexOf(decoded.codePoint), " ", decoded.length, " ", decoded.valid);
  std::String encoded;
  for (u32 c : {0x24u, 0xA2u, 0x20ACu, 0x10348u})
    std::appendUtf8(encoded, c);
  std::String bytes;
  for (char c : encoded)
    bytes << hexOf((uint8_t)c) + " ";
  std::println(bytes);
  for (u32 bad : {0xD800u, 0x110000u})
  {
    try
    {
      char out[4];
      std::utf8Encode(bad, out);
      std::println("encoded");
    }
    catch (const std::InvalidArgument& e)
    {
      std::println(hexOf(bad), ": ", std::StringView(e.what()));
    }
  }
  std::println(std::isScalarValue(0x10FFFF), " ", std::isScalarValue(0xDFFF), " ", std::isScalarValue(0xE000), " ", std::isScalarValue(0x110000));
  return 0;
}
