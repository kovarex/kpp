// spec: Function's converting constructor takes only something that can be called (std::function's needs a callable): with overloads for a String and for a Function, a string literal or a number takes the String's or another, and a lambda or a function pointer the Function's
// factorio: a string literal passed where overloads take a String and a std::function<void()> instantiated FunctionImpl<void>'s constructor from a const char*, which cannot be called
void use(const String& text) { println("text {}", text); }
void use(Function<void()> callback) { callback(); }
void count(long long n) { println("number {}", n); }
void count(Function<void()> callback) { callback(); }
void hello() { println("hello"); }
int main()
{
  use("literal");
  use([]() { println("lambda"); });
  use(&hello);
  count(3);
  count(hello);
  return 0;
}
