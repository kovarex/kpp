// spec: a const container hands out no mutable element (C++'s const_iterator): begin(), find() and the other positions of a const Map, MultiMap, HashMap, FastMap, Deque or List are const_iterators, whose *it is const; the same calls on a mutable one give iterators, which write the element and convert to const_iterators (compared with them, passed to erase); a Set's, MultiSet's, HashSet's and FastSet's positions are const either way (its elements are its keys)
// factorio: thread D's const-object check: a const std::map's find() handed out a mutable entry, as every node container's const begin() and find() did (no const_iterator type)
template<typename T>
const char* which(T&) { return "mutable"; }
template<typename T>
const char* which(const T&) { return "const"; }

template<typename C>
void probe(const char* name, C& c, const typename C::key_type& key)
{
  const C& constant = c;
  std::println(std::StringView(name), ": ", std::StringView(which(*c.begin())), " ", std::StringView(which(*constant.begin())), " ", std::StringView(which(*c.find(key))), " ", std::StringView(which(*constant.find(key))));
  typename C::const_iterator position = c.find(key); // an iterator converts to a const_iterator
  std::println(std::StringView(name), ": equal ", position == c.find(key), " erased ", c.erase(position) == c.end());
}

template<typename C>
void probeSequence(const char* name, C& c)
{
  const C& constant = c;
  std::println(std::StringView(name), ": ", std::StringView(which(*c.begin())), " ", std::StringView(which(*constant.begin())), " ", std::StringView(which(c.front())), " ", std::StringView(which(constant.front())), " ", std::StringView(which(*c.rbegin())), " ", std::StringView(which(*constant.rbegin())));
  typename C::const_iterator position = c.begin();
  std::println(std::StringView(name), ": equal ", position == c.begin(), " erased ", *c.erase(position));
}

int main()
{
  std::Map<int, int> map = {{1, 10}};
  map.find(1)->second = 11; // a mutable Map's entry is written through its iterator
  std::println("map value ", map.at(1));
  probe("Map", map, 1);
  std::MultiMap<int, int> multiMap;
  multiMap.insert(1, 10);
  probe("MultiMap", multiMap, 1);
  std::Set<int> set = {1};
  probe("Set", set, 1);
  std::MultiSet<int> multiSet;
  multiSet.insert(1);
  probe("MultiSet", multiSet, 1);
  std::HashMap<int, int> hashMap = {{1, 10}};
  probe("HashMap", hashMap, 1);
  std::HashSet<int> hashSet = {1};
  probe("HashSet", hashSet, 1);
  std::FastMap<int, int> fastMap = {{1, 10}};
  probe("FastMap", fastMap, 1);
  std::FastSet<int> fastSet = {1};
  probe("FastSet", fastSet, 1);
  std::Deque<int> deque = {1, 2};
  probeSequence("Deque", deque);
  const std::Deque<int>& constDeque = deque;
  std::println("Deque: [] ", std::StringView(which(deque[0])), " ", std::StringView(which(constDeque[0])), " at ", std::StringView(which(constDeque.at(0))), " back ", std::StringView(which(constDeque.back())));
  std::List<int> list = {1, 2};
  probeSequence("List", list);
  // extract takes the position begin() gives, a set's const one included (ForkLogic's
  // `entries.extract(entries.begin())` of a std::set).
  std::Set<int> extracting = {4, 5};
  auto setNode = extracting.extract(extracting.begin());
  std::MultiSet<int> multiExtracting = {6};
  auto multiSetNode = multiExtracting.extract(multiExtracting.begin());
  std::Map<int, int> mapExtracting = {{7, 70}};
  auto mapNode = mapExtracting.extract(mapExtracting.begin());
  std::println("extract: ", setNode.value(), " ", extracting.size(), " ", multiSetNode.value(), " ", mapNode.key(), " ", mapNode.mapped());
  return 0;
}
