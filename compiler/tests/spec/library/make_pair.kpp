// spec: makePair (std::make_pair) makes a Pair of its arguments' types without reference and const (a string literal as a pointer), moving rvalues in (a move-only value) and copying lvalues; for a ReferenceWrapper argument (ref(x)) the member is a reference (the type is checked here; writing through such a member is templates/reference_type_argument_member)
// factorio: ProcessionGraphicCatalogue's animationCatalogue.emplace(std::make_pair(index, Animation(...))) and spriteCatalogue.emplace(std::make_pair(index, UniquePointer<Sprite>(new Sprite(...)))), whose values can only be moved
int main()
{
  std::UniquePtr<int> p(new int(4));
  std::Pair<int, std::UniquePtr<int>> a = std::makePair(1, std::move(p));
  std::String s("text");
  std::Pair<std::String, const char*> b = std::makePair(s, "literal");
  int x = 1;
  static_assert(std::isSame<decltype(std::makePair(std::ref(x), 2)), std::Pair<int&, int>>);
  std::println(a.first, " ", *a.second, " ", p == nullptr, " ", b.first, " ", std::StringView(b.second), " ", s);
  return 0;
}
