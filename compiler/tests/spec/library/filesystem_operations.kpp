// spec: the filesystem operations behave alike on every target (Windows' Win32 calls, POSIX's elsewhere, docs/design.md "Targets and hosts" stage 4): create_directory (false for one already there), status and its types, file_size (an error for a directory), a directory's listing, copy_file (file_exists without overwrite_existing), rename, remove (false for a missing path), permissions (a file with no write bit, then writable again), current_path, canonical, absolute, space, is_empty
// factorio: Filesystem's wrappers over std::filesystem in the game's save, mod and log handling (create_directories, copy_file, rename, remove, directory iteration)
std::String names(const std::filesystem::path& dir)
{
  std::Vector<std::String> found;
  for (const std::filesystem::directory_entry& entry : std::filesystem::directory_iterator(dir))
    found.push_back(entry.path().filename().string() + (entry.is_directory() ? "/" : ":" + std::toString(entry.file_size())));
  std::sort(found.begin(), found.end());
  std::String result;
  for (const std::String& name : found)
    result << name << " ";
  return result;
}

int main()
{
  std::filesystem::path dir = std::filesystem::temp_directory_path() / "kpp-spec-operations";
  std::filesystem::remove_all(dir);
  std::println(std::filesystem::create_directory(dir), " ", std::filesystem::create_directory(dir), " ", std::filesystem::is_empty(dir));
  std::filesystem::create_directory(dir / "sub");
  {
    std::OutFileStream out((dir / "a.txt").string());
    out << "hello";
  }
  std::println(std::filesystem::is_regular_file(dir / "a.txt"), " ", std::filesystem::is_directory(dir / "sub"), " ", std::filesystem::exists(dir / "none"), " ",
          std::filesystem::file_size(dir / "a.txt"), " ", std::filesystem::symlink_status(dir / "a.txt").type() == std::filesystem::file_type::regular);
  std::ErrorCode ec;
  std::filesystem::file_size(dir / "sub", ec);
  std::println("file_size of a directory: ", ec == std::Errc::is_a_directory);
  std::filesystem::copy_file(dir / "a.txt", dir / "b.txt");
  std::filesystem::copy_file(dir / "a.txt", dir / "b.txt", ec);
  std::println("copy over b.txt: ", ec == std::Errc::file_exists, " ", std::filesystem::copy_file(dir / "a.txt", dir / "b.txt", std::filesystem::copy_options::overwrite_existing));
  std::filesystem::rename(dir / "b.txt", dir / "sub" / "c.txt");
  std::println(names(dir), "| ", names(dir / "sub"));
  std::filesystem::permissions(dir / "a.txt", std::filesystem::perms::owner_write | std::filesystem::perms::group_write | std::filesystem::perms::others_write, std::filesystem::perm_options::remove);
  bool readOnly = (std::filesystem::status(dir / "a.txt").permissions() & std::filesystem::perms::owner_write) == std::filesystem::perms::none;
  std::filesystem::permissions(dir / "a.txt", std::filesystem::perms::owner_write, std::filesystem::perm_options::add);
  bool writable = (std::filesystem::status(dir / "a.txt").permissions() & std::filesystem::perms::owner_write) != std::filesystem::perms::none;
  std::println("read-only, then writable: ", readOnly, " ", writable);
  std::filesystem::path before = std::filesystem::current_path();
  std::filesystem::current_path(dir);
  bool relative = std::filesystem::exists("a.txt") && std::filesystem::equivalent(std::filesystem::current_path(), dir);
  std::filesystem::current_path(before);
  std::println("current_path: ", relative, " ", std::filesystem::current_path() == before);
  std::println("canonical: ", std::filesystem::canonical(dir / "sub" / "..") == std::filesystem::canonical(dir), " ", std::filesystem::absolute("x").is_absolute(), " ", std::filesystem::space(dir).capacity > 0);
  std::println(std::filesystem::remove(dir / "a.txt"), " ", std::filesystem::remove(dir / "a.txt"), " ", std::filesystem::remove_all(dir), " ", std::filesystem::exists(dir));
  return 0;
}
