// spec: isNothrowDefaultConstructible, isNothrowCopyConstructible and isNothrowCopyAssignable answer as clang's std::is_nothrow_* do: a declared default constructor by its noexcept and its default arguments, the implicit one by the bases and members it builds and the default member initializers (constants, value-initializations, a conversion written as a call (`u16(-1)`), a call of a function that is or is not noexcept, a class member built by a constructor that is or is not noexcept, an aggregate from a list), a class template's by its arguments, the copies by the copy constructor and assignment C++ chooses, and a destructor that may throw makes no nothrow construction; clang's output (g++ 13 answers 1 for DefaultedThrows, whose `noexcept(false) = default` C++20 keeps)
// the stdlib's Vector and Deque take their direct paths, which set up no exception guard, where these say nothing throws (K, 2026-11-08)
extern "C" int printf(const char* format, ...);

enum class Color { Red, Green };
constexpr int base = 4;
int compute() { return 3; }
int computeNoexcept() noexcept { return 3; }

struct Plain { int x; int y = 3; float z = 1.5f * 2; Color c = Color::Green; const char* s = "hi"; int w = base + 1; int* p = nullptr; };
struct UserCtor { UserCtor() {} };
struct NoexceptCtor { NoexceptCtor() noexcept {} };
struct HoldsUser { UserCtor u; };
struct CopyThrows
{
  CopyThrows() = default;
  CopyThrows(const CopyThrows&) {}
  CopyThrows& operator=(const CopyThrows&) { return *this; }
};
struct HoldsCopyThrows { CopyThrows c; int n = 2; };
struct NoexceptCopy
{
  NoexceptCopy() = default;
  NoexceptCopy(const NoexceptCopy&) noexcept {}
  NoexceptCopy& operator=(const NoexceptCopy&) noexcept { return *this; }
};
struct ThrowingDestructor { ~ThrowingDestructor() noexcept(false) {} };
struct NoDefault { NoDefault(int) {} };
struct DefaultArgument { DefaultArgument(int v = 3) noexcept {} };
struct DefaultArgumentCalls { DefaultArgumentCalls(int v = compute()) noexcept {} };
struct DefaultedThrows { DefaultedThrows() noexcept(false) = default; };
struct DerivedUser : UserCtor {};
struct DerivedNoexcept : NoexceptCtor { int k = 1; };
struct Inner { int a; int b; };
struct ValueInits { Inner i{}; Inner j = Inner(); Inner k = {1, 2}; int n{}; int m[3] = {1, 2, 3}; };
struct Converts { u16 frame = u16(-1); i64 big = i64(3) * 2; };
struct CallsFunction { int n = compute(); };
struct CallsNoexcept { int n = computeNoexcept() + 1; };
struct Label { Label(const char* s) {} };
struct HoldsLabel { Label t{"x"}; };
struct Number { Number(int v) noexcept {} };
struct HoldsNumber { Number a{5}; Number b = Number(6); };
template<typename T> struct Box { T value{}; int count = 0; };

template<typename T>
void show(const char* name)
{
  printf("%s %d%d%d\n", name, isNothrowDefaultConstructible<T>, isNothrowCopyConstructible<T>, isNothrowCopyAssignable<T>);
}

int main()
{
  show<int>("int");
  show<int&>("int&");
  show<int[3]>("int[3]");
  show<Plain>("Plain");
  show<UserCtor>("UserCtor");
  show<NoexceptCtor>("NoexceptCtor");
  show<HoldsUser>("HoldsUser");
  show<CopyThrows>("CopyThrows");
  show<HoldsCopyThrows>("HoldsCopyThrows");
  show<NoexceptCopy>("NoexceptCopy");
  show<ThrowingDestructor>("ThrowingDestructor");
  show<NoDefault>("NoDefault");
  show<DefaultArgument>("DefaultArgument");
  show<DefaultArgumentCalls>("DefaultArgumentCalls");
  show<DefaultedThrows>("DefaultedThrows");
  show<DerivedUser>("DerivedUser");
  show<DerivedNoexcept>("DerivedNoexcept");
  show<ValueInits>("ValueInits");
  show<Converts>("Converts");
  show<CallsFunction>("CallsFunction");
  show<CallsNoexcept>("CallsNoexcept");
  show<HoldsLabel>("HoldsLabel");
  show<HoldsNumber>("HoldsNumber");
  show<Box<int>>("Box<int>");
  show<Box<UserCtor>>("Box<UserCtor>");
  show<Box<CopyThrows>>("Box<CopyThrows>");
  show<Box<Inner>>("Box<Inner>");
  return 0;
}
