// spec: Optional (std::optional): value, hasValue, nullopt, assignment, comparison, valueOr, makeOptional of a value and makeOptional<T>(args...) building T in place (T without a default constructor)
// factorio: 1587 uses in 658 files
struct Built
{
  int a;
  std::String b;
  Built(int a, const char* b) : a(a), b(b) {}
};
std::Optional<int> parse(const char* s) { return s[0] == 'x' ? std::Optional<int>() : std::Optional<int>(s[0] - '0'); }
int main()
{
  std::Optional<int> a = parse("7"), b = parse("x");
  std::Optional<std::String> name;
  name = std::String("n");
  int sum = a.valueOr(0) + b.valueOr(100);
  if (a)
    sum += *a;
  bool cleared = (b = std::nullopt, !b.hasValue());
  std::println(a.hasValue(), " ", b.hasValue(), " ", sum, " ", name->size(), " ", a == 7, " ", cleared, " ", name.value());
  std::Optional<Built> built = std::makeOptional<Built>(3, "x");
  std::Optional<int> seven = std::makeOptional(7);
  std::println(built->a, " ", built->b, " ", *seven, " ", *std::makeOptional<uint32_t>(5000000000ll / 10));
  return 0;
}
