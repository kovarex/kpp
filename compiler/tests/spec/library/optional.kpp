// spec: Optional (std::optional): value, hasValue, nullopt, assignment, comparison, valueOr, makeOptional of a value and makeOptional<T>(args...) building T in place (T without a default constructor)
// factorio: 1587 uses in 658 files
struct Built
{
  int a;
  String b;
  Built(int a, const char* b) : a(a), b(b) {}
};
Optional<int> parse(const char* s) { return s[0] == 'x' ? Optional<int>() : Optional<int>(s[0] - '0'); }
int main()
{
  Optional<int> a = parse("7"), b = parse("x");
  Optional<String> name;
  name = String("n");
  int sum = a.valueOr(0) + b.valueOr(100);
  if (a)
    sum += *a;
  bool cleared = (b = nullopt, !b.hasValue());
  println("{} {} {} {} {} {} {}", a.hasValue(), b.hasValue(), sum, name->size(), a == 7, cleared, name.value());
  Optional<Built> built = makeOptional<Built>(3, "x");
  Optional<int> seven = makeOptional(7);
  println("{} {} {} {}", built->a, built->b, *seven, *makeOptional<uint32_t>(5000000000ll / 10));
  return 0;
}
