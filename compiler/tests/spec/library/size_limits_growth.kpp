// spec: the containers' growth past the size's range: doubling a capacity stops at maxContainerSize (2^64 - 2) instead of wrapping negative; a size sum past maxContainerSize, HashMap's and HashSet's reserve of more than their slots can count and WString's growth there throw LengthError (MSVC's messages: "unordered_map/set too long", "string too long") instead of wrapping (WString's reserve of 2^31 - 1 returned without reserving when sizes were int: needed + 1 wrapped negative; and its reserve of npos when they became u64: needed + 1 wrapped to 0)
// factorio: none known; sizeSum and grownCapacity are what every container's growth path uses (core/Sizes.kpp)
int main()
{
  std::println(std::grownCapacity(0, 1, 4), " ", std::grownCapacity(100, 101, 4), " ", std::grownCapacity(100, 500, 4));
  std::println(std::grownCapacity(std::maxContainerSize / 2 + 2, std::maxContainerSize / 2 + 3, 4) == std::maxContainerSize, " ", std::grownCapacity(std::maxContainerSize - 1, std::maxContainerSize, 4) == std::maxContainerSize);
  std::println(std::sizeSum(std::maxContainerSize - 1, 1, "sum") == std::maxContainerSize);
  try
  {
    std::println(std::sizeSum(std::maxContainerSize, 1, "sum too long"));
  }
  catch (const std::LengthError& e)
  {
    std::println("sum: ", std::StringView(e.what()));
  }
  try
  {
    std::println(std::grownCapacity(std::maxContainerSize, std::maxContainerSize + 1, 4));
  }
  catch (const std::LengthError& e)
  {
    std::println("grow: ", std::StringView(e.what()));
  }
  std::HashMap<int, int> map;
  try
  {
    map.reserve(std::maxContainerSize);
    std::println("reserved");
  }
  catch (const std::LengthError& e)
  {
    std::println("hash map: ", std::StringView(e.what()), ", ", map.size());
  }
  std::HashSet<int> set;
  try
  {
    set.reserve(0x7000000000000000); // more than 3/4 of 2^63 slots
    std::println("reserved");
  }
  catch (const std::LengthError& e)
  {
    std::println("hash set: ", std::StringView(e.what()));
  }
  std::WString wide = L"wide";
  try
  {
    wide.reserve(std::maxContainerSize);
    std::println("reserved");
  }
  catch (const std::LengthError& e)
  {
    std::println("wstring: ", std::StringView(e.what()), ", ", wide.size());
  }
  try
  {
    wide.reserve(std::WString::npos);
    std::println("reserved");
  }
  catch (const std::LengthError& e)
  {
    std::println("wstring npos: ", std::StringView(e.what()), ", ", wide.size());
  }
  return 0;
}
