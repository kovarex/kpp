// spec: the containers, String, Optional, Pair and Tuple compare as in C++20: == element by element, <=> lexicographically by the elements' <=> (or their < where they have none), which gives <, >, <= and >=, so a class with a defaulted <=> can hold them; a const char* compares with a String on either side; an Optional compares with a value of another type, empty before every value; the hash containers compare with == in any order
// factorio: about 30 comparisons: defaulted <=> over String, Vector, Optional and Array members (AmbientPool::SurfaceIdentification, UpgradeData, BlueprintRecordLocation, Furnace), Map == and != (EntityTags, MapGenSettings, PlayerAccessList, ItemWithTags), Set != (FluidBox, Description, RecipeToolTip), Optional<Targeter<Entity>> == const Entity* (GameView), Optional<double> <= 0 (RollingStockPrototype), String > and >= (EntityMapGenerationTask), a Map<String, ...> found by a const char* through Less<void>, Tuple keys of a Map
struct OnlyLess
{
  int v = 0;
  bool operator<(const OnlyLess& o) const { return this->v < o.v; }
  bool operator==(const OnlyLess& o) const { return this->v == o.v; }
};
struct Record
{
  String name;
  Vector<int> values;
  Optional<int> extra;
  Array<int, 2> pair;
  strong_ordering operator<=>(const Record&) const = default;
};
struct Target
{
  const int* p = nullptr;
  bool operator==(const int* other) const { return this->p == other; }
};
int main()
{
  Vector<int> a = {1, 2, 3}, b = {1, 2, 4}, c = {1, 2};
  Vector<OnlyLess> d = {OnlyLess{1}}, e = {OnlyLess{2}};
  println(a < b, " ", c < a, " ", a == a, " ", a != b, " ", b >= a, " ", d < e);

  Deque<int> da, db;
  da.push_back(1);
  db.push_back(2);
  List<int> la = {1, 2}, lb = {1, 3};
  ForwardList<int> fa, fb;
  fa.push_front(1);
  fb.push_front(1);
  println(da == db, " ", da < db, " ", la < lb, " ", la != lb, " ", fa == fb);

  Map<String, int> ma, mb;
  ma[String("x")] = 1;
  mb[String("x")] = 1;
  Set<int> sa = {1, 2}, sb = {1, 3};
  MultiSet<int> msa, msb;
  msa.insert(1);
  msb.insert(1);
  msb.insert(1);
  println(ma == mb, " ", ma != mb, " ", sa != sb, " ", sa < sb, " ", msa < msb);

  HashMap<int, int> ha, hb;
  for (int i = 0; i < 20; ++i)
  {
    ha[i] = i * 2;
    hb[19 - i] = (19 - i) * 2;
  }
  HashSet<int> hs1, hs2;
  hs1.insert(5);
  hs2.insert(6);
  bool hashEqual = ha == hb;
  hb[3] = 0;
  println(hashEqual, " ", ha == hb, " ", hs1 == hs2);

  String s("beta");
  StringView v1("alpha"), v2("beta");
  println(s > String("alpha"), " ", s >= "beta", " ", "alpha" < s, " ", "gamma" >= s, " ", s <= "c", " ", v1 < v2);

  Optional<int> none, three(3);
  Optional<double> speed(0.0);
  int x = 0;
  Optional<Target> source(Target{&x});
  println(none < three, " ", three > 2, " ", speed <= 0, " ", source == &x, " ", none == 3, " ", three <= three);

  Pair<int, String> p1(1, String("a")), p2(1, String("b"));
  Tuple<int, char, char> t1(1, 'a', 'b'), t2(1, 'a', 'c');
  println(p1 < p2, " ", p1 >= p2, " ", t1 < t2, " ", t1 != t2);

  Record r1{String("n"), {1, 2}, Optional<int>(), {1, 2}};
  Record r2{String("n"), {1, 2}, Optional<int>(4), {1, 2}};
  Record r3{String("n"), {1, 3}, Optional<int>(), {0, 0}};
  println(r1 < r2, " ", r2 < r3, " ", r1 == r1, " ", r3 > r1);
  return 0;
}
