// spec: two Vectors are equal when they have the same length and equal elements (`==` and `!=`)
// found in src/Util (LocalisedString::operator==: `this->parameters == other.parameters`)
int main()
{
  std::Vector<int> a = {1, 2, 3}, b = {1, 2, 3}, c = {1, 2};
  std::Vector<std::String> s = {"x", "y"}, t = {"x", "z"};
  std::println(a == b, " ", a == c, " ", a != c, " ", s == t, " ", s != t);
  return 0;
}
