// spec: HashMap and HashSet (std::unordered_map/set): insert, find, operator[], erase, iteration, custom key hash
// factorio: 47 unordered_map, 19 unordered_set (and 827 std::map, 641 std::set)
struct Key { int a, b; bool operator==(const Key& o) const { return this.a == o.a && this.b == o.b; } };
size_t hashOf(const Key& k) { return std::hashOf(k.a * 31 + k.b); }
int main()
{
  std::HashMap<std::String, int> counts;
  counts[std::String("x")] += 2;
  counts[std::String("y")] = 5;
  counts.insert(std::String("z"), 1);
  counts.erase(std::String("z"));
  int* found = &counts.find(std::String("y"))->second;
  int total = 0;
  counts.forEach([&](const std::String& k, int v) { total += v; });
  std::HashSet<int> seen;
  seen.insert(3);
  seen.insert(3);
  seen.insert(4);
  std::HashMap<Key, const char*> byKey;
  byKey[Key{1, 2}] = "one-two";
  std::println(counts.size(), " ", *found, " ", counts.contains(std::String("z")), " ", total, " ", seen.size(), " ", seen.contains(4), " ", std::StringView(byKey[Key{1, 2}]));
  return 0;
}
