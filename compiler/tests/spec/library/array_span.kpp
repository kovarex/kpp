// spec: Array<T, N> and Span<T, Extent> (std::array, std::span): spans of any length and of a fixed extent, from an Array, a Vector (const or not), a plain array, a Subrange of pointers and each other
// factorio: 372 std::array uses in 193 files, 147 std::span (8 of a fixed extent: the noise operations' `std::span<const NoiseExpressionConstant, CONSTANT_COUNT>`)
int total(Span<const int> values) { int s = 0; for (int v : values) s += v; return s; }
int three(const Span<const int, 3>& values) { return values[0] + values[1] + values[2]; }
int main()
{
  Array<int, 3> a = {1, 2, 3};
  Vector<int> v;
  v.push_back(4);
  v.push_back(5);
  println(a.size(), " ", a[2], " ", total(a), " ", total(v));
  v.push_back(6);
  Span<int> all = v;
  all[0] = 10;
  Span<const int, 3> fixed = a;
  Span<const int, 3> fromVector(v);
  Subrange<const int*> tail(v.data() + 1, v.data() + 3);
  Span<const int> fromSub = tail;
  Span<const int> widened = fixed;
  int raw[2] = {7, 8};
  Span<const int, 2> fixedRaw = raw;
  println(three(fixed), " ", three(fromVector), " ", total(fromSub), " ", total(widened), " ", fixedRaw.size() + total(fixedRaw), " ", Span<const int, 3>::extent == 3 && Span<int>::extent == dynamicExtent);
  return 0;
}
