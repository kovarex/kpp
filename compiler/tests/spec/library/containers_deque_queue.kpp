// spec: Deque and Queue (std::deque, std::queue): push at both ends, pop, front/back
// factorio: 116 deque uses in 68 files
int main()
{
  std::Deque<int> d;
  d.push_back(2);
  d.push_front(1);
  d.push_back(3);
  int front = d.front();
  d.pop_front();
  std::Queue<std::String> q;
  q.push(std::String("first"));
  q.push(std::String("second"));
  std::String head = q.front();
  q.pop();
  std::println(front, " ", d.size(), " ", d.back(), " ", head, " ", q.size(), " ", q.front());
  return 0;
}
