// spec: the time types (std::chrono): durations of every period with lossless implicit conversions and durationCast, comparisons across periods, arithmetic of any two durations and of time points in their common duration (std::common_type: Seconds + Milliseconds is Milliseconds, Ratio<1, 2> and Ratio<1, 3> count in sixths), SteadyClock and SystemClock time points, time_t conversion, floor
// factorio: 394 chrono uses in 97 files (nanoseconds 144, steady_clock 91, system_clock 37, duration_cast 31, milliseconds 26, ...), 30 literals like 10ms
int main()
{
  std::Milliseconds ms(1500);
  std::Seconds two(2);
  std::Nanoseconds ns = ms;
  std::Seconds whole = std::durationCast<std::Seconds>(ms);
  std::Duration<double> asSeconds = ms;
  std::Milliseconds sum = ms + std::Milliseconds(two);
  std::SteadyClock::time_point start = std::SteadyClock::now();
  auto later = std::SteadyClock::now();
  std::Nanoseconds elapsed = later - start;
  long long elapsedMs = std::durationCast<std::Milliseconds>(later - start).count();
  bool ordered = two > ms && ms < two && ms == std::Microseconds(1500000) && std::Minutes(1) == std::Seconds(60);
  std::Duration<double, std::Milli> fraction = std::Duration<double>(0.25);
  auto now = std::SystemClock::now();
  long long epochSeconds = std::SystemClock::to_time_t(now);
  auto back = std::SystemClock::from_time_t(epochSeconds);
  std::Hours day(24);
  std::println(ns.count(), " ", whole.count(), " ", asSeconds.count(), " ", sum.count(), " ", elapsed >= std::Nanoseconds::zero());
  std::println(elapsedMs >= 0, " ", ordered, " ", fraction.count(), " ", epochSeconds > 1700000000, " ", back <= now);
  std::println(std::durationCast<std::Minutes>(day).count(), " ", std::Milliseconds(two) / ms, " ", (ms * 2).count(), " ", (ms * 0.5).count(), " ", std::floor<std::Seconds>(std::Milliseconds(-1500)).count());
  std::println((3 * ms).count(), " ", (0.5 * two).count());
  auto mixed = two + ms;
  auto sixths = std::Duration<int, std::Ratio<1, 2>>(3) + std::Duration<int, std::Ratio<1, 3>>(2);
  std::TimePoint<std::SystemClock, std::Seconds> second = std::timePointCast<std::Seconds>(now);
  auto plus = second + ms;
  std::println(mixed.count(), " ", (ms - two).count(), " ", sixths.count(), " ", std::Minutes(1) / ms, " ", (plus - second).count(), " ", (std::Minutes(1) % std::Seconds(7)).count());
  std::println(std::isSame<decltype(mixed), std::Milliseconds>, " ", std::isSame<decltype(sixths), std::Duration<int, std::Ratio<1, 6>>>, " ", std::isSame<decltype(plus), std::TimePoint<std::SystemClock, std::Milliseconds>>, " ", std::isSame<decltype(start + ms), std::TimePoint<std::SteadyClock, std::Nanoseconds>>);
  std::println(std::Ratio<2, -4>::num, " ", std::Ratio<2, -4>::den, " ", std::Duration<int, std::Ratio<1, 2>>(1) < std::Duration<int, std::Ratio<1, 3>>(2));
  std::thisThread::sleepFor(std::Milliseconds(1));
  return 0;
}
