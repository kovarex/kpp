// spec: a path holding a lone surrogate has no UTF-8 form, so string(), u8string() and generic_string() throw SystemError (kovarex 2026-11-06; MSVC's path::string() throws system_error with ERROR_NO_UNICODE_TRANSLATION, libstdc++ refuses such a path with illegal_byte_sequence), where they gave U+FFFD: text naming another file. wstring() keeps it, and a filesystem_error about the path can still be made (its message replaces what it cannot show, as MSVC's)
// factorio: E's process battery (2026-11-06), the path half of the lone surrogate question main's argv raised
void show(std::StringView what, const std::filesystem::path& p)
{
  try
  {
    std::String text = p.string();
    std::println(what, ": ", text.size(), " bytes");
  }
  catch (const std::SystemError& e)
  {
    std::println(what, ": SystemError, an error code: ", (bool)e.code());
  }
}

int main()
{
  std::WString lone = L"a";
  lone.push_back((wchar_t)0xD800);
  lone.push_back(L'b');
  std::filesystem::path bad(lone);
  show("lone", bad);
  show("good", std::filesystem::path(L"až"));
  bool threw = false;
  try { bad.u8string(); } catch (const std::SystemError&) { threw = true; }
  std::println("u8string: ", threw);
  threw = false;
  try { bad.generic_string(); } catch (const std::SystemError&) { threw = true; }
  std::println("generic_string: ", threw);
  threw = false;
  try { bad.generic_u8string(); } catch (const std::SystemError&) { threw = true; }
  std::println("generic_u8string: ", threw);
  std::println("wstring: ", bad.wstring() == lone);
  std::filesystem::filesystem_error one("one", bad, std::ErrorCode(2, std::systemCategory()));
  std::filesystem::filesystem_error two("two", bad, bad, std::ErrorCode(2, std::systemCategory()));
  std::println("error: ", std::String(one.what()).size() > 0, " ", std::String(two.what()).size() > 0, " ", one.path1().wstring() == lone);
  return 0;
}
