// spec: String::insert at an index past the end throws OutOfRange and leaves the string as it was, as std::string::insert throws out_of_range when index > size(); inserting at size() appends (`abcX / insert: String::insert: index out of range, abc / fill: String::insert: index out of range, abc`)
int main()
{
  std::String s("abc");
  std::String t = s;
  t.insert(3, "X");
  std::print(t, " / ");
  try
  {
    s.insert(4, "X");
    std::print("inserted ", s, " / ");
  }
  catch (const std::OutOfRange& e)
  {
    std::print("insert: ", std::StringView(e.what()), ", ", s, " / ");
  }
  try
  {
    s.insert(9, 2, '-');
    std::println("inserted ", s);
  }
  catch (const std::OutOfRange& e)
  {
    std::println("fill: ", std::StringView(e.what()), ", ", s);
  }
  return 0;
}
