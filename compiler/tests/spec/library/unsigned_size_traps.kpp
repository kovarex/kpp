// spec: the library's sizes are unsigned (ContainerSize), and its loops and subtractions are right at the edges where a signed size went below 0: a backward search that reaches index 0 (and stops there, or on an empty text), a needle longer than the text (no length - count that wraps), npos as "to the end" in substr and erase, the iterator difference of a Deque that is negative, Deque's erase of a range at the front, a heap of 0, 1 and 2 elements, a comparison result that is negative, an extension at a name's first character
// factorio: every container and string the game uses; the traps of docs/stdlib-conformance.md, "Sizes are unsigned"
int main()
{
  // Backward searches down to 0, and on nothing.
  std::String text = "abcab";
  std::String empty;
  std::println(text.rfind('a'), " ", text.rfind('a', 2), " ", text.rfind("ab", 0), " ", empty.rfind('a') == std::String::npos);
  std::println(text.find_last_of("a"), " ", text.find_last_not_of('b'), " ", std::String("aaa").find_last_not_of('a') == std::String::npos);
  std::StringView view = "xyzx";
  std::println(view.rfind('x', 2), " ", view.rfind(std::StringView("xy"), 3), " ", std::StringView().rfind('x') == std::StringView::npos);
  std::WString wide = L"axa";
  std::println(wide.rfind(L'a', 1), " ", wide.find_last_of(L"a"), " ", std::WString().rfind(L'a') == std::WString::npos);
  // A needle longer than the text: npos, no wrapped length - count.
  std::println(text.find("abcabc") == std::String::npos, " ", view.find(std::StringView("xyzxx")) == std::StringView::npos, " ", wide.find(L"axaa") == std::WString::npos);
  // npos, or any count past the end, as "to the end".
  std::String phrase = "hello world";
  std::println(phrase.substr(6), "|", phrase.substr(6, std::String::npos), "|", phrase.substr(11));
  std::String erased = phrase;
  erased.erase(5);
  std::String front = phrase;
  front.erase(0, 6);
  std::println(erased, "|", front);
  // A Deque: negative iterator differences, a range erased at the front, an empty range.
  std::Deque<int> deque;
  for (int i = 0; i < 6; ++i)
    deque.push_back(i);
  std::println(deque.begin() - deque.end(), " ", (deque.end() - 2) - deque.begin());
  deque.erase(deque.begin() + 1, deque.begin() + 3);
  deque.erase(deque.begin() + 2, deque.begin() + 2);
  std::println(deque.size(), " ", deque[0], " ", deque[1], " ", deque[3]);
  // Heaps of 0, 1 and 2 elements (heapify counts down from size / 2 - 1).
  std::PriorityQueue<int> none;
  std::PriorityQueue<int> one;
  one.push(4);
  std::PriorityQueue<int> two;
  two.push(1);
  two.push(9);
  std::println(none.empty(), " ", one.top(), " ", two.top());
  // Comparison results stay signed.
  std::println(std::String("a").compare(std::String("b")) < 0, " ", std::WString(L"a") < std::WString(L"b"), " ", std::String("b") > std::String("a"));
  // An extension at the name's first character is none.
  std::println(std::filesystem::path(".hidden").extension().string().size(), " ", std::filesystem::path("a.txt").extension().string());
  return 0;
}
