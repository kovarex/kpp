// spec: StringView::substr(pos, count) throws OutOfRange when pos > size(), as String::substr and std::string_view::substr; pos == size() is an empty view, a count past the end is cut; find and find_first_of from past the end are npos
// found by comparing with MSVC's STL and libstdc++ (thread G, 2026-11-05): kpp's StringView gave an empty view
int main()
{
  std::StringView v = "hello world";
  std::println("[", v.substr(6), "] [", v.substr(11), "] [", v.substr(4, 100), "]");
  bool threw = false;
  try
  {
    v.substr(12);
  }
  catch (const std::OutOfRange&)
  {
    threw = true;
  }
  std::println(threw, " ", v.find("o", 20) == std::StringView::npos, " ", v.find("", 12) == std::StringView::npos, " ", v.find("", 11), " ",
          v.find_first_of(std::StringView("od"), 30) == std::StringView::npos);
  return 0;
}
