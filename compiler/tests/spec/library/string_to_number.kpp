// spec: stoi, stol, stoul, stoll, stoull, stof, stod and stold with std's parameters: the index of the first character not converted through a size_t* (null leaves it), then the base; no conversion throws InvalidArgument, a value the type cannot hold OutOfRange
// factorio: InputState.cpp's `std::stoi(keycodeStr, &pos)` (a "keycode-N" key name, rejected unless every character converts), SteamContext.cpp's `std::stoul(idStr, &processed)` and `std::stoull(idStr, &processed)` (the lobby to join), DebugTools.cpp's stof and the tests' stod
int main()
{
  size_t pos = 99;
  int scancode = stoi("42", &pos);
  println("{} {}", scancode, pos);
  println("{} {}", stoi(" -17abc", &pos), pos);
  println("{} {} {}", stoi("ff", nullptr, 16), stol("-0x10", nullptr, 16), stoi("777", nullptr, 8));
  size_t processed = 0;
  unsigned long id = stoul("4000000000 rest", &processed);
  println("{} {}", id, processed);
  unsigned long long steamId = stoull("76561198000000000", &processed);
  println("{} {}", steamId, processed);
  println("{} {}", stoll("-9000000000"), stoi("12", nullptr));
  println("{} {} {}", stof("2.5"), stod("1e3x", &pos), pos);
  println("{}", double(stold("0.125")));
  try
  {
    stoi("keycode", &pos);
  }
  catch (const InvalidArgument& e)
  {
    println("InvalidArgument: {} (pos still {})", e.what(), pos);
  }
  try
  {
    stoi("99999999999");
  }
  catch (const OutOfRange& e)
  {
    println("OutOfRange: {}", e.what());
  }
  try
  {
    stod("1e999");
  }
  catch (const OutOfRange& e)
  {
    println("OutOfRange: {}", e.what());
  }
  return 0;
}
