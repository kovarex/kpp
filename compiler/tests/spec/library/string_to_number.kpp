// spec: stoi, stol, stoul, stoll, stoull, stof, stod and stold with std's parameters: the index of the first character not converted through a size_t* (null leaves it), then the base; no conversion throws InvalidArgument, a value the type cannot hold OutOfRange
// factorio: InputState.cpp's `std::stoi(keycodeStr, &pos)` (a "keycode-N" key name, rejected unless every character converts), SteamContext.cpp's `std::stoul(idStr, &processed)` and `std::stoull(idStr, &processed)` (the lobby to join), DebugTools.cpp's stof and the tests' stod
int main()
{
  size_t pos = 99;
  int scancode = std::stoi("42", &pos);
  std::println(scancode, " ", pos);
  std::println(std::stoi(" -17abc", &pos), " ", pos);
  std::println(std::stoi("ff", nullptr, 16), " ", std::stol("-0x10", nullptr, 16), " ", std::stoi("777", nullptr, 8));
  size_t processed = 0;
  unsigned long id = std::stoul("4000000000 rest", &processed);
  std::println(id, " ", processed);
  unsigned long long steamId = std::stoull("76561198000000000", &processed);
  std::println(steamId, " ", processed);
  std::println(std::stoll("-9000000000"), " ", std::stoi("12", nullptr));
  std::println(std::stof("2.5"), " ", std::stod("1e3x", &pos), " ", pos);
  std::println(double(std::stold("0.125")));
  try
  {
    std::stoi("keycode", &pos);
  }
  catch (const std::InvalidArgument& e)
  {
    std::println("InvalidArgument: ", std::StringView(e.what()), " (pos still ", pos, ")");
  }
  try
  {
    std::stoi("99999999999");
  }
  catch (const std::OutOfRange& e)
  {
    std::println("OutOfRange: ", std::StringView(e.what()));
  }
  try
  {
    std::stod("1e999");
  }
  catch (const std::OutOfRange& e)
  {
    std::println("OutOfRange: ", std::StringView(e.what()));
  }
  return 0;
}
