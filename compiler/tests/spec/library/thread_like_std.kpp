// spec: Thread as std::thread: Thread(f, args...) runs invoke(f, args...) on copies (a function with arguments, a member function with its object's pointer, a move-only argument), Thread::Id (Id() is no thread's; ordered, hashable, what thisThread::getId gives the thread itself), join and detach throwing SystemError when not joinable; UniqueLock's defer/try/adopt locks; ConditionVariable's timed waits with CvStatus and predicates; sleepFor sleeping at least its time
// factorio: 13 `std::thread(&Class::loop, this)` and `std::thread(Class::doLoad, ...)` (WorkerThread, ParallelScenarioLoader with 7 arguments, SoundLibrary, TransferSource, ...); RaceChecker's Atomic<std::thread::id>; TaskManager's wait_until, the LED controllers' wait_for
struct Worker
{
  int base = 10;
  std::Atomic<int> result;
  void loop(int a, int b) { this.result.store(this.base + a + b); }
};
std::Atomic<int> sum;
std::Atomic<std::Thread::Id> seen;
void add(int a, int b, int c, int d, int e, int f, int g) { sum.store(a + b + c + d + e + f + g); }
void consume(std::UniquePtr<int> value, int* out)
{
  *out = *value;
  seen.store(std::thisThread::getId());
}
int main()
{
  std::Thread none;
  std::println(none.joinable(), " ", none.getId() == std::Thread::Id());
  std::Thread t1(add, 1, 2, 3, 4, 5, 6, 7);
  t1.join();
  Worker worker;
  std::Thread t2(&Worker::loop, &worker, 3, 4);
  t2.join();
  int out = 0;
  std::Thread t3(consume, std::makeUnique<int>(42), &out); // (ref(out) for an int&: classes/reference_bound_through_conversion_operator)
  std::Thread::Id id3 = t3.get_id();
  t3.join();
  std::println(sum.load(), " ", worker.result.load(), " ", out, " ", seen.load() == id3, " ", id3 != std::thisThread::get_id());
  std::println(t3.joinable(), " ", t3.getId() == std::Thread::id());
  std::HashSet<std::Thread::Id> ids;
  ids.insert(std::thisThread::getId());
  ids.insert(id3);
  ids.insert(std::thisThread::getId());
  std::println(ids.size(), " ", (id3 < std::thisThread::getId()) != (std::thisThread::getId() < id3));
  try
  {
    t3.join();
  }
  catch (const std::SystemError& e)
  {
    std::println("join: ", e.code() == std::Errc::invalid_argument);
  }
  std::Mutex m;
  std::UniqueLock<std::Mutex> deferred(m, std::deferLock);
  std::println(deferred.owns_lock());
  deferred.lock();
  std::UniqueLock<std::Mutex> tried(m, std::tryToLock);
  std::println(deferred.owns_lock(), " ", tried.owns_lock());
  try
  {
    tried.unlock();
  }
  catch (const std::SystemError& e)
  {
    std::println("unlock: ", e.code() == std::Errc::operation_not_permitted);
  }
  std::Mutex* released = deferred.release();
  std::UniqueLock<std::Mutex> adopted(*released, std::adoptLock);
  std::println(deferred.owns_lock(), " ", adopted.owns_lock(), " ", adopted.mutex() == &m);
  std::ConditionVariable cv;
  std::CvStatus status = cv.wait_for(adopted, std::Milliseconds(5));
  bool ready = false;
  std::Thread t4([&]() { std::LockGuard<std::Mutex> lock(m); ready = true; cv.notify_all(); });
  bool woken = cv.wait_until(adopted, std::SteadyClock::now() + std::Seconds(10), [&]() { return ready; });
  adopted.unlock();
  t4.join();
  std::println(status == std::CvStatus::timeout, " ", woken);
  auto start = std::SteadyClock::now();
  std::thisThread::sleep_for(std::Milliseconds(3));
  std::println(std::SteadyClock::now() - start >= std::Milliseconds(3));
  return 0;
}
