// spec: Thread as std::thread: Thread(f, args...) runs invoke(f, args...) on copies (a function with arguments, a member function with its object's pointer, a move-only argument), Thread::Id (Id() is no thread's; ordered, hashable, what thisThread::getId gives the thread itself), join and detach throwing SystemError when not joinable; UniqueLock's defer/try/adopt locks; ConditionVariable's timed waits with CvStatus and predicates; sleepFor sleeping at least its time
// factorio: 13 `std::thread(&Class::loop, this)` and `std::thread(Class::doLoad, ...)` (WorkerThread, ParallelScenarioLoader with 7 arguments, SoundLibrary, TransferSource, ...); RaceChecker's Atomic<std::thread::id>; TaskManager's wait_until, the LED controllers' wait_for
struct Worker
{
  int base = 10;
  Atomic<int> result;
  void loop(int a, int b) { this.result.store(this.base + a + b); }
};
Atomic<int> sum;
Atomic<Thread::Id> seen;
void add(int a, int b, int c, int d, int e, int f, int g) { sum.store(a + b + c + d + e + f + g); }
void consume(UniquePtr<int> value, int* out)
{
  *out = *value;
  seen.store(thisThread::getId());
}
int main()
{
  Thread none;
  println(none.joinable(), " ", none.getId() == Thread::Id());
  Thread t1(add, 1, 2, 3, 4, 5, 6, 7);
  t1.join();
  Worker worker;
  Thread t2(&Worker::loop, &worker, 3, 4);
  t2.join();
  int out = 0;
  Thread t3(consume, makeUnique<int>(42), &out); // (ref(out) for an int&: classes/reference_bound_through_conversion_operator)
  Thread::Id id3 = t3.get_id();
  t3.join();
  println(sum.load(), " ", worker.result.load(), " ", out, " ", seen.load() == id3, " ", id3 != thisThread::get_id());
  println(t3.joinable(), " ", t3.getId() == Thread::id());
  HashSet<Thread::Id> ids;
  ids.insert(thisThread::getId());
  ids.insert(id3);
  ids.insert(thisThread::getId());
  println(ids.size(), " ", (id3 < thisThread::getId()) != (thisThread::getId() < id3));
  try
  {
    t3.join();
  }
  catch (const SystemError& e)
  {
    println("join: ", e.code() == Errc::invalid_argument);
  }
  Mutex m;
  UniqueLock<Mutex> deferred(m, deferLock);
  println(deferred.owns_lock());
  deferred.lock();
  UniqueLock<Mutex> tried(m, tryToLock);
  println(deferred.owns_lock(), " ", tried.owns_lock());
  try
  {
    tried.unlock();
  }
  catch (const SystemError& e)
  {
    println("unlock: ", e.code() == Errc::operation_not_permitted);
  }
  Mutex* released = deferred.release();
  UniqueLock<Mutex> adopted(*released, adoptLock);
  println(deferred.owns_lock(), " ", adopted.owns_lock(), " ", adopted.mutex() == &m);
  ConditionVariable cv;
  CvStatus status = cv.wait_for(adopted, Milliseconds(5));
  bool ready = false;
  Thread t4([&]() { LockGuard<Mutex> lock(m); ready = true; cv.notify_all(); });
  bool woken = cv.wait_until(adopted, SteadyClock::now() + Seconds(10), [&]() { return ready; });
  adopted.unlock();
  t4.join();
  println(status == CvStatus::timeout, " ", woken);
  auto start = SteadyClock::now();
  thisThread::sleep_for(Milliseconds(3));
  println(SteadyClock::now() - start >= Milliseconds(3));
  return 0;
}
