// spec: durationCast of a duration whose unsigned count is past i64's range converts the count as an unsigned number, as std::chrono::duration_cast computes in the common type of the reps and intmax_t ([time.duration.cast]: unsigned long long for an unsigned long long rep)
int main()
{
  using U64Micro = std::Duration<u64, std::Micro>;
  std::println(std::durationCast<std::Duration<u64, std::Milli>>(U64Micro(18446744073709551615ull)).count());
  std::println(std::durationCast<std::Duration<u64>>(U64Micro(9223372036854775808ull)).count());
  std::println(std::durationCast<std::Duration<u64, std::Ratio<1, 7>>>(std::Duration<u64, std::Ratio<1, 3>>(2000000000000000000ull)).count());
  return 0;
}
