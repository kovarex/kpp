// spec: uninitializedCopy, uninitializedMove, uninitializedDefaultConstruct and uninitializedValueConstruct destroy the objects they built when a construction throws ([specialized.algorithms])
struct Tracked
{
  static int live, ticks, throwAt;
  static void tick()
  {
    if (++This::ticks == This::throwAt)
      throw 42;
  }
  int value = 0;
  Tracked() { This::tick(); This::live++; }
  Tracked(const Tracked& other) : value(other.value) { This::tick(); This::live++; }
  Tracked(Tracked&& other) : value(other.value) { This::tick(); This::live++; }
  ~Tracked() { This::live--; }
};
int Tracked::live = 0;
int Tracked::ticks = 0;
int Tracked::throwAt = 0;

long long storage[16];

template<typename F>
void throwing(StringView name, F call)
{
  int before = Tracked::live;
  Tracked::ticks = 0;
  Tracked::throwAt = 3;
  try
  {
    call();
    println(name, " did not throw");
  }
  catch (int)
  {
    println(name, " left ", Tracked::live - before);
  }
  Tracked::throwAt = 0;
}

int main()
{
  Tracked source[4];
  Tracked* room = (Tracked*)storage;
  throwing("copy", [&] { uninitializedCopy(source, source + 4, room); });
  throwing("move", [&] { uninitializedMove(source, source + 4, room); });
  throwing("default", [&] { uninitializedDefaultConstruct(room, room + 4); });
  throwing("value", [&] { uninitializedValueConstruct(room, room + 4); });
  return 0;
}
