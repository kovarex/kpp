// spec: IstreambufIterator<char> (std::istreambuf_iterator<char>) reads an InFileStream's characters as an input iterator, a default-constructed one (`{}`) being the end: copied into a String through backInserter, and counted with distance
// factorio: the tests' ForkLogic.cpp reads a fork's XML report whole: `std::copy(std::istreambuf_iterator<char>(in), {}, std::back_inserter(buffer));`
int main()
{
  const char* temp = std::getenv("TEMP");
  std::String path = std::String(temp ? temp : ".") + "/kpp_istreambuf_iterator.txt";
  {
    std::OutFileStream out(path);
    out << "<report tests=\"6\"/>";
  }
  std::String buffer;
  {
    std::InFileStream in(path);
    std::copy(std::IstreambufIterator<char>(in), {}, std::backInserter(buffer));
  }
  std::InFileStream again(path);
  ptrdiff_t count = std::distance(std::IstreambufIterator<>(again), std::IstreambufIterator<>());
  again.close();
  remove(path.c_str());
  std::println(buffer, " ", buffer.size(), " ", count);
  return 0;
}
