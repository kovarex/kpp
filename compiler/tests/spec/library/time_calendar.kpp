// spec: calendar time in UTC: civil fields from and to SystemClock time points (proleptic Gregorian, Hinnant's algorithms), RFC 3339 timestamps (its section 5.8 examples; a leap second, a space for 'T', a day the month lacks and other malformed text are rejected with an empty Optional) and HTTP dates (RFC 9110 5.6.7: IMF-fixdate written, all three forms read, a two-digit year as the RFC says, a weekday that does not match the date rejected)
// factorio: none; the kpp.net site and registry need dates (thread G)
std::String show(const std::Optional<std::TimePoint<std::SystemClock>>& t) { return t.hasValue() ? std::formatRfc3339(t.value(), 7) : std::String("rejected"); }

int main()
{
  // Civil fields.
  std::TimePoint<std::SystemClock> moonLanding = std::SystemClock::from_time_t(-14182940);
  std::CivilTime c = std::toCivilTime(moonLanding);
  std::println(c.year, "-", c.month, "-", c.day, " ", c.hour, ":", c.minute, ":", c.second, " weekday ", c.weekday);
  std::println(std::formatRfc3339(std::fromCivilTime(c).value()));
  std::CivilTime bad = c;
  bad.month = 2;
  bad.day = 30;
  std::println("Feb 30: ", std::StringView(std::fromCivilTime(bad).hasValue() ? "accepted" : "rejected"));
  std::println("days ", std::daysFromCivil(1970, 1, 1), " ", std::daysFromCivil(2000, 3, 1), " ", std::daysFromCivil(1, 1, 1));
  std::println("leap ", std::isLeapYear(2000), " ", std::isLeapYear(1900), " ", std::isLeapYear(2024), " ", std::daysInMonth(2023, 2));
  // Every day from year 1 to 9999 and back.
  long long first = std::daysFromCivil(1, 1, 1);
  long long last = std::daysFromCivil(9999, 12, 31);
  int wrong = 0;
  for (long long d = first; d <= last; ++d)
  {
    std::CivilTime day = std::toCivilTime(std::SystemClock::from_time_t(d * 86400));
    if (std::daysFromCivil(day.year, day.month, day.day) != d || day.day < 1 || day.day > std::daysInMonth(day.year, day.month))
      ++wrong;
  }
  std::println(last - first + 1, " days, ", wrong, " wrong");

  // RFC 3339 5.8.
  for (const char* text : {"1985-04-12T23:20:50.52Z", "1996-12-19T16:39:57-08:00", "1990-12-31T23:59:60Z", "1990-12-31T15:59:60-08:00",
                           "1937-01-01T12:00:27.87+00:20"})
    std::println(std::StringView(text), " -> ", show(std::parseRfc3339(text)));
  // Accepted and rejected forms.
  for (const char* text : {"2026-11-01t10:31:07z", "2026-11-01T10:31:07-00:00", "2026-11-01T10:31:07.123456789Z", "2024-02-29T00:00:00Z",
                           "2023-02-29T00:00:00Z", "2026-11-01 10:31:07Z", "2026-11-01T10:31:07", "2026-11-01T24:00:00Z",
                           "2026-13-01T00:00:00Z", "2026-11-01T10:31:07.Z", "2026-11-01T10:31:07+24:00", "26-11-01T10:31:07Z",
                           "2026-11-01T10:31:07Zjunk"})
    std::println(std::StringView(text), " -> ", show(std::parseRfc3339(text)));
  std::TimePoint<std::SystemClock> t = std::parseRfc3339("2026-11-01T10:31:07.1234567Z").value();
  std::println(std::formatRfc3339(t), " | ", std::formatRfc3339(t, 3), " | ", std::formatRfc3339(t, 7), " | ", std::formatHttpDate(t));
  std::println(std::formatRfc3339(std::SystemClock::from_time_t(-62135596800)));

  // RFC 9110 5.6.7: one instant in the three forms; a two-digit year is read relative to now.
  std::TimePoint<std::SystemClock> now = std::parseRfc3339("2026-11-01T00:00:00Z").value();
  for (const char* text : {"Sun, 06 Nov 1994 08:49:37 GMT", "Sunday, 06-Nov-94 08:49:37 GMT", "Sun Nov  6 08:49:37 1994", "Wednesday, 01-Jan-70 00:00:00 GMT", "Thursday, 01-Jan-70 00:00:00 GMT",
                           "Saturday, 06-Nov-76 08:49:37 GMT", "Sunday, 06-Nov-76 08:49:37 GMT", "Mon, 06 Nov 1994 08:49:37 GMT", "Sun, 6 Nov 1994 08:49:37 GMT",
                           "Sun, 06 Nov 1994 08:49:37 UTC", "Sun, 06 Nov 1994 08:49:60 GMT", "sun, 06 nov 1994 08:49:37 GMT", "Sun Nov 06 08:49:37 1994"})
    std::println(std::StringView(text), " -> ", show(std::parseHttpDate(text, now)));
  return 0;
}
