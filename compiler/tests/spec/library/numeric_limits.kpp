// spec: Limits<T> (std::numeric_limits) for integer, character, bool and floating-point types: min, max, lowest, epsilon, digits, digits10, is_signed in constant expressions and through a template's parameters, infinity and NaN; unsigned 64-bit values print in full
// factorio: 604 numeric_limits uses (max 502, min 77, infinity 23, lowest 18, digits 3, is_signed 2 in cxxopts' integer parser)
enum class Color { Red };
template<typename T>
void parse(const char* text)
{
  using US = MakeUnsigned<T>;
  constexpr auto umax = Limits<US>::max();
  constexpr bool is_signed = Limits<T>::is_signed;
  println("{} {} {}", (unsigned long long)umax, is_signed, Limits<T>::digits);
}
int main()
{
  static_assert(Limits<double>::digits == 53);
  static_assert(Limits<uint64_t>::digits + 1 == 65);
  Array<int, 9> bits;
  parse<int16_t>("1");
  parse<uint32_t>("1");
  parse<long long>("1");
  println("{} {} {} {} {}", Limits<int>::min(), Limits<int>::max(), Limits<int8_t>::min(), (int)Limits<char>::max(), (int)Limits<unsigned char>::max());
  println("{} {} {} {}", Limits<unsigned long long>::max(), Limits<long long>::min(), Limits<bool>::max(), Limits<bool>::digits);
  println("{} {} {} {}", Limits<float>::max(), Limits<double>::lowest(), Limits<float>::epsilon(), Limits<double>::min());
  double inf = Limits<double>::infinity();
  double nan = Limits<double>::quiet_NaN();
  println("{} {} {} {} {}", inf > Limits<double>::max(), nan != nan, Limits<float>::digits10, Limits<int>::digits10, Limits<Color>::is_specialized);
  println("{} {} {}", bits.size(), Limits<wchar_t>::max(), Limits<char32_t>::is_signed);
  return 0;
}
