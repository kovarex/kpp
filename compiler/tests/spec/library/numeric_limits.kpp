// spec: Limits<T> (std::numeric_limits) for integer, character, bool and floating-point types: min, max, lowest, epsilon, digits, digits10, is_signed in constant expressions and through a template's parameters, infinity and NaN; unsigned 64-bit values print in full
// factorio: 604 numeric_limits uses (max 502, min 77, infinity 23, lowest 18, digits 3, is_signed 2 in cxxopts' integer parser)
enum class Color { Red };
template<typename T>
void parse([[maybe_unused]] const char* text)
{
  using US = std::MakeUnsigned<T>;
  constexpr auto umax = std::Limits<US>::max();
  constexpr bool is_signed = std::Limits<T>::is_signed;
  std::println((unsigned long long)umax, " ", is_signed, " ", std::Limits<T>::digits);
}
int main()
{
  static_assert(std::Limits<double>::digits == 53);
  static_assert(std::Limits<uint64_t>::digits + 1 == 65);
  std::Array<int, 9> bits;
  parse<int16_t>("1");
  parse<uint32_t>("1");
  parse<long long>("1");
  std::println(std::Limits<int>::min(), " ", std::Limits<int>::max(), " ", std::Limits<int8_t>::min(), " ", (int)std::Limits<char>::max(), " ", (int)std::Limits<unsigned char>::max());
  std::println(std::Limits<unsigned long long>::max(), " ", std::Limits<long long>::min(), " ", std::Limits<bool>::max(), " ", std::Limits<bool>::digits);
  std::println(std::Limits<float>::max(), " ", std::Limits<double>::lowest(), " ", std::Limits<float>::epsilon(), " ", std::Limits<double>::min());
  double inf = std::Limits<double>::infinity();
  double nan = std::Limits<double>::quiet_NaN();
  std::println(inf > std::Limits<double>::max(), " ", nan != nan, " ", std::Limits<float>::digits10, " ", std::Limits<int>::digits10, " ", std::Limits<Color>::is_specialized);
  std::println(bits.size(), " ", (unsigned)(unsigned)std::Limits<wchar_t>::max(), " ", std::Limits<char32_t>::is_signed);
  return 0;
}
