// spec: format, print, println, toString for the common types
int main()
{
  std::String s = std::format("{} + {} = {}", 1, 2, 1 + 2);
  std::String mixed = std::format("{} {} {} {}", true, 'c', std::String("str"), "lit");
  std::println(s, "|", mixed, "|", std::toString(-7));
  std::print("no newline ");
  std::println("then one");
  std::println(std::toString(2.5), " ", std::toString(100000000000ll));
  return 0;
}
