// spec: StringView's rfind of a text and of a char from a position: the last occurrence starting at or before it (anywhere without one, or with npos), npos (the largest size) when there is none; an empty text is found where the search starts
// factorio: DebugTools.cpp's preset loading, `line.rfind("ghostShimmerConfig.tint", 0) == 0` on a std::string_view line (a prefix test), 30 uses through its macros
int main()
{
  std::StringView line = "ghostShimmerConfig.tint: 1:2:3:4";
  std::println(line.rfind("ghostShimmerConfig.tint", 0), " ", line.rfind("tint", 0));
  std::println(line.rfind(":"), " ", line.rfind(":", 26), " ", line.rfind(':', 26));
  std::println(line.rfind("missing"), " ", line.rfind("", 5), " ", line.rfind(std::String("Config")));
  std::StringView empty;
  std::println(empty.rfind("x"), " ", empty.rfind(""), " ", empty.rfind('x', 3));
  return 0;
}
