// spec: try_emplace with an rvalue key moves the key into the new entry instead of copying it (Map, HashMap, FastMap, with and without a hint), and Vector::emplace at the end builds the element in place, as emplace_back does, instead of moving a temporary in
// factorio: the map deserialiser's `target.try_emplace(move(index), ...)` copied each key (MapDeserialiser SaveLoadMap: a copy where none is expected), and FlatMap's `data.emplace(it, key, mapped_type{})` at the end moved the value twice (SaveLoadFlatMap: at most one move); before: `Map: 2 false 2; HashMap: 2 false 2; FastMap: 2 false 2; Vector at the end: 0 404`
int copies = 0;
int moves = 0;
struct Key
{
  int v = 0;
  explicit Key(int v) : v(v) {}
  Key(const Key& other) : v(other.v) { copies += 1; }
  Key(Key&& other) : v(other.v) { moves += 1; }
  bool operator<(const Key& other) const { return this->v < other.v; }
  bool operator==(const Key& other) const { return this->v == other.v; }
};
size_t hashOf(const Key& key) { return hashOf(key.v); }
struct Value
{
  int v = 0;
  Value() {}
  explicit Value(int v) : v(v) {}
  Value(const Value& other) : v(other.v) { copies += 100; }
  Value(Value&& other) : v(other.v) { moves += 100; }
};
template<typename M>
void tryEmplace(const char* name)
{
  copies = 0;
  moves = 0;
  M m;
  Key a(1);
  m.try_emplace(move(a), 5);
  Key b(2);
  m.try_emplace(m.end(), move(b), 6);
  Key c(1);
  bool inserted = m.try_emplace(move(c), 7).second;
  print("{}: {} {} {}; ", name, copies, inserted, m.size());
}
int main()
{
  tryEmplace<Map<Key, Value>>("Map");
  tryEmplace<HashMap<Key, Value>>("HashMap");
  tryEmplace<FastMap<Key, Value>>("FastMap");
  Vector<Pair<Key, Value>> entries;
  entries.reserve(2);
  copies = 0;
  moves = 0;
  entries.emplace(entries.end(), Key(1), Value());
  entries.emplace(entries.end(), Key(3), Value());
  print("Vector at the end: {} {}; ", copies, moves);
  copies = 0;
  entries.emplace(entries.begin() + 1, Key(2), Value());
  println("before another: {} {}{}{}", copies, entries[0].first.v, entries[1].first.v, entries[2].first.v);
  return 0;
}
