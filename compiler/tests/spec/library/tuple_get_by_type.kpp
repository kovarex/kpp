// spec: get<T>(tuple) gives the element of type T, which is the type of exactly one element, as get<I> gives it: a reference from an lvalue, const from a const one, moved from an rvalue (std::get<T>)
// factorio: K's ranking of the stdlib gaps (2026-11-06): there was get<T> of a Pair only
int main()
{
  std::Tuple<int, std::String, double> t(1, "two", 3.5);
  std::get<int>(t) = 4;
  std::get<std::String>(t) << "!";
  std::println(std::get<0>(t), " ", std::get<std::String>(t), " ", std::get<double>(t));
  const std::Tuple<int, std::String, double>& same = t;
  std::println(std::get<double>(same) * 2);
  std::String taken = std::get<std::String>(std::move(t));
  std::println(taken, " '", std::get<1>(t), "'");
  int x = 5;
  std::Tuple<int&, char> refs(x, 'c');
  std::get<int&>(refs) = 6;
  std::println(x, " ", std::get<char>(refs));
  std::Tuple<int, int, char> twice(1, 2, 'z');
  std::println(std::get<char>(twice));
  return 0;
}
