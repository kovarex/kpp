// spec: the library's C runtime declarations have the types of the UCRT headers' prototypes (FILE*
// for streams, char* from strchr, strrchr and strstr, a handler from signal), so that a program's import
// of those headers declares the same C functions the same way (top-level const on a parameter dropped).
// factorio: the game imports the UCRT headers and windows.h beside the library
// (The variadic ones, printf, fprintf, snprintf, sprintf and sscanf: language/variadic_function_pointer_type.)
// target: windows (the UCRT's declarations: __acrt_iob_func, _errno)
static_assert(std::isSame<decltype(&::_Exit), void (*)(int)>, "_Exit");
static_assert(std::isSame<decltype(&::__acrt_iob_func), FILE* (*)(unsigned)>, "__acrt_iob_func");
static_assert(std::isSame<decltype(&std::_errno), int* (*)()>, "_errno");
static_assert(std::isSame<decltype(&::abort), void (*)()>, "abort");
static_assert(std::isSame<decltype(&::acos), double (*)(double)>, "acos");
static_assert(std::isSame<decltype(&::asin), double (*)(double)>, "asin");
static_assert(std::isSame<decltype(&::atan), double (*)(double)>, "atan");
static_assert(std::isSame<decltype(&std::atan2), double (*)(double, double)>, "atan2");
static_assert(std::isSame<decltype(&::atexit), int (*)(void (*)())>, "atexit");
static_assert(std::isSame<decltype(&::atof), double (*)(const char*)>, "atof");
static_assert(std::isSame<decltype(&::atoi), int (*)(const char*)>, "atoi");
static_assert(std::isSame<decltype(&::bsearch), void* (*)(const void*, const void*, size_t, size_t, int (*)(const void*, const void*))>, "bsearch");
static_assert(std::isSame<decltype(&::cbrt), double (*)(double)>, "cbrt");
static_assert(std::isSame<decltype(&std::ceil), double (*)(double)>, "ceil");
static_assert(std::isSame<decltype(&::copysign), double (*)(double, double)>, "copysign");
static_assert(std::isSame<decltype(&std::cos), double (*)(double)>, "cos");
static_assert(std::isSame<decltype(&::cosh), double (*)(double)>, "cosh");
static_assert(std::isSame<decltype(&::difftime), double (*)(time_t, time_t)>, "difftime");
static_assert(std::isSame<decltype(&::exit), void (*)(int)>, "exit");
static_assert(std::isSame<decltype(&std::exp), double (*)(double)>, "exp");
static_assert(std::isSame<decltype(&std::fabs), double (*)(double)>, "fabs");
static_assert(std::isSame<decltype(&::fclose), int (*)(FILE*)>, "fclose");
static_assert(std::isSame<decltype(&::feof), int (*)(FILE*)>, "feof");
static_assert(std::isSame<decltype(&::ferror), int (*)(FILE*)>, "ferror");
static_assert(std::isSame<decltype(&::fflush), int (*)(FILE*)>, "fflush");
static_assert(std::isSame<decltype(&::fgetc), int (*)(FILE*)>, "fgetc");
static_assert(std::isSame<decltype(&::fgets), char* (*)(char*, int, FILE*)>, "fgets");
static_assert(std::isSame<decltype(&std::floor), double (*)(double)>, "floor");
static_assert(std::isSame<decltype(&std::fmod), double (*)(double, double)>, "fmod");
static_assert(std::isSame<decltype(&std::fmodf), float (*)(float, float)>, "fmodf");
static_assert(std::isSame<decltype(&::fopen), FILE* (*)(const char*, const char*)>, "fopen");
static_assert(std::isSame<decltype(&::fputc), int (*)(int, FILE*)>, "fputc");
static_assert(std::isSame<decltype(&::fputs), int (*)(const char*, FILE*)>, "fputs");
static_assert(std::isSame<decltype(&::fread), size_t (*)(void*, size_t, size_t, FILE*)>, "fread");
static_assert(std::isSame<decltype(&std::free), void (*)(void*)>, "free");
static_assert(std::isSame<decltype(&::frexp), double (*)(double, int*)>, "frexp");
static_assert(std::isSame<decltype(&::fseek), int (*)(FILE*, long, int)>, "fseek");
static_assert(std::isSame<decltype(&::ftell), long (*)(FILE*)>, "ftell");
static_assert(std::isSame<decltype(&::fwrite), size_t (*)(const void*, size_t, size_t, FILE*)>, "fwrite");
static_assert(std::isSame<decltype(&std::getenv), char* (*)(const char*)>, "getenv");
static_assert(std::isSame<decltype(&::gmtime), tm* (*)(const time_t*)>, "gmtime");
static_assert(std::isSame<decltype(&::hypot), double (*)(double, double)>, "hypot");
static_assert(std::isSame<decltype(&::isalnum), int (*)(int)>, "isalnum");
static_assert(std::isSame<decltype(&::isalpha), int (*)(int)>, "isalpha");
static_assert(std::isSame<decltype(&::isdigit), int (*)(int)>, "isdigit");
static_assert(std::isSame<decltype(&::islower), int (*)(int)>, "islower");
static_assert(std::isSame<decltype(&::isprint), int (*)(int)>, "isprint");
static_assert(std::isSame<decltype(&::ispunct), int (*)(int)>, "ispunct");
static_assert(std::isSame<decltype(&::isspace), int (*)(int)>, "isspace");
static_assert(std::isSame<decltype(&::isupper), int (*)(int)>, "isupper");
static_assert(std::isSame<decltype(&::isxdigit), int (*)(int)>, "isxdigit");
static_assert(std::isSame<decltype(&::ldexp), double (*)(double, int)>, "ldexp");
static_assert(std::isSame<decltype(&::localtime), tm* (*)(const time_t*)>, "localtime");
static_assert(std::isSame<decltype(&std::log), double (*)(double)>, "log");
static_assert(std::isSame<decltype(&::log10), double (*)(double)>, "log10");
static_assert(std::isSame<decltype(&::log2), double (*)(double)>, "log2");
static_assert(std::isSame<decltype(&std::lround), long (*)(double)>, "lround");
static_assert(std::isSame<decltype(&std::malloc), void* (*)(size_t)>, "malloc");
static_assert(std::isSame<decltype(&std::memchr), void* (*)(const void*, int, size_t)>, "memchr");
static_assert(std::isSame<decltype(&std::memcmp), int (*)(const void*, const void*, size_t)>, "memcmp");
static_assert(std::isSame<decltype(&std::memcpy), void* (*)(void*, const void*, size_t)>, "memcpy");
static_assert(std::isSame<decltype(&std::memmove), void* (*)(void*, const void*, size_t)>, "memmove");
static_assert(std::isSame<decltype(&std::memset), void* (*)(void*, int, size_t)>, "memset");
static_assert(std::isSame<decltype(&::mktime), time_t (*)(tm*)>, "mktime");
static_assert(std::isSame<decltype(&::modf), double (*)(double, double*)>, "modf");
static_assert(std::isSame<decltype(&std::nextafter), double (*)(double, double)>, "nextafter");
static_assert(std::isSame<decltype(&std::nextafterf), float (*)(float, float)>, "nextafterf");
static_assert(std::isSame<decltype(&std::pow), double (*)(double, double)>, "pow");
static_assert(std::isSame<decltype(&::puts), int (*)(const char*)>, "puts");
static_assert(std::isSame<decltype(&::qsort), void (*)(void*, size_t, size_t, int (*)(const void*, const void*))>, "qsort");
static_assert(std::isSame<decltype(&::raise), int (*)(int)>, "raise");
static_assert(std::isSame<decltype(&::remainder), double (*)(double, double)>, "remainder");
static_assert(std::isSame<decltype(&::remove), int (*)(const char*)>, "remove");
static_assert(std::isSame<decltype(&::rename), int (*)(const char*, const char*)>, "rename");
static_assert(std::isSame<decltype(&std::round), double (*)(double)>, "round");
static_assert(std::isSame<decltype(&::signal), SignalHandler (*)(int, SignalHandler)>, "signal");
static_assert(std::isSame<decltype(&std::sin), double (*)(double)>, "sin");
static_assert(std::isSame<decltype(&::sinh), double (*)(double)>, "sinh");
static_assert(std::isSame<decltype(&std::sqrt), double (*)(double)>, "sqrt");
static_assert(std::isSame<decltype(&::strcat), char* (*)(char*, const char*)>, "strcat");
static_assert(std::isSame<decltype(&::strchr), char* (*)(const char*, int)>, "strchr");
static_assert(std::isSame<decltype(&std::strcmp), int (*)(const char*, const char*)>, "strcmp");
static_assert(std::isSame<decltype(&::strcpy), char* (*)(char*, const char*)>, "strcpy");
static_assert(std::isSame<decltype(&::strcspn), size_t (*)(const char*, const char*)>, "strcspn");
static_assert(std::isSame<decltype(&::strdup), char* (*)(const char*)>, "strdup");
static_assert(std::isSame<decltype(&::strerror), char* (*)(int)>, "strerror");
static_assert(std::isSame<decltype(&::strftime), size_t (*)(char*, size_t, const char*, const tm*)>, "strftime");
static_assert(std::isSame<decltype(&std::strlen), size_t (*)(const char*)>, "strlen");
static_assert(std::isSame<decltype(&::strncat), char* (*)(char*, const char*, size_t)>, "strncat");
static_assert(std::isSame<decltype(&::strncmp), int (*)(const char*, const char*, size_t)>, "strncmp");
static_assert(std::isSame<decltype(&::strncpy), char* (*)(char*, const char*, size_t)>, "strncpy");
static_assert(std::isSame<decltype(&::strrchr), char* (*)(const char*, int)>, "strrchr");
static_assert(std::isSame<decltype(&::strspn), size_t (*)(const char*, const char*)>, "strspn");
static_assert(std::isSame<decltype(&::strstr), char* (*)(const char*, const char*)>, "strstr");
static_assert(std::isSame<decltype(&::strtod), double (*)(const char*, char**)>, "strtod");
static_assert(std::isSame<decltype(&::strtof), float (*)(const char*, char**)>, "strtof");
static_assert(std::isSame<decltype(&::strtol), long (*)(const char*, char**, int)>, "strtol");
static_assert(std::isSame<decltype(&::strtold), long double (*)(const char*, char**)>, "strtold");
static_assert(std::isSame<decltype(&::strtoll), long long (*)(const char*, char**, int)>, "strtoll");
static_assert(std::isSame<decltype(&::strtoul), unsigned long (*)(const char*, char**, int)>, "strtoul");
static_assert(std::isSame<decltype(&::strtoull), unsigned long long (*)(const char*, char**, int)>, "strtoull");
static_assert(std::isSame<decltype(&::system), int (*)(const char*)>, "system");
static_assert(std::isSame<decltype(&::tan), double (*)(double)>, "tan");
static_assert(std::isSame<decltype(&::tanh), double (*)(double)>, "tanh");
static_assert(std::isSame<decltype(&::time), time_t (*)(time_t*)>, "time");
static_assert(std::isSame<decltype(&::tmpfile), FILE* (*)()>, "tmpfile");
static_assert(std::isSame<decltype(&::tolower), int (*)(int)>, "tolower");
static_assert(std::isSame<decltype(&::toupper), int (*)(int)>, "toupper");
static_assert(std::isSame<decltype(&std::trunc), double (*)(double)>, "trunc");
int main()
{
  std::println("ok");
  return 0;
}
