// spec: currentException() in a handler captures the exception being handled, of whatever type, and rethrowException throws that same object again, as many times as asked (std::current_exception, std::rethrow_exception, [propagation]): a SharedFuture's get() throws the one stored exception each time, a captured exception outlives its handler while an ExceptionPtr refers to it, and the object is destroyed once, when the last reference goes; outside a handler it is empty
// factorio: E's concurrency battery (async_exception_reaches_get) needed it: kpp had no current_exception (thread J, 2026-11-06); C++'s semantics
int made = 0;
int destroyed = 0;

class Failure
{
public:
  int code;
  Failure(int c) : code(c) { ++made; }
  Failure(const Failure& o) : code(o.code) { ++made; }
  ~Failure() { ++destroyed; }
};

int main()
{
  {
    std::SharedFuture<int> shared(std::async([]() -> int { throw Failure(7); }));
    for (int i = 0; i < 3; ++i)
    {
      try { shared.get(); }
      catch (const Failure& f) { std::println("caught ", f.code); }
    }
  }
  std::ExceptionPtr kept;
  try { throw Failure(9); }
  catch (...) { kept = std::currentException(); }
  std::println("outside ", made - destroyed);
  try { std::rethrowException(kept); }
  catch (Failure& f) { std::println("again ", f.code); }
  kept = nullptr;
  std::ExceptionPtr none = std::currentException();
  std::println(made - destroyed, " ", (bool)none);
  try { throw 5; }
  catch (int v)
  {
    std::ExceptionPtr inner = std::currentException();
    try { std::rethrowException(inner); }
    catch (int w) { std::println("int ", v, " ", w); }
  }
  return 0;
}
