// spec: swapping a full Optional with an empty one builds the value in the empty one with one move and destroys the old value ([optional.swap])
struct Counted
{
  static int moved, destroyed;
  int value;
  explicit Counted(int value) : value(value) {}
  Counted(Counted&& other) : value(other.value) { moved++; }
  Counted& operator=(Counted&& other)
  {
    this->value = other.value;
    return *this;
  }
  ~Counted() { destroyed++; }
};
int Counted::moved = 0;
int Counted::destroyed = 0;

int main()
{
  Optional<Counted> full(inPlace, 3);
  Optional<Counted> empty;
  full.swap(empty);
  println((bool)full, " ", (bool)empty, " ", empty->value);
  println(Counted::moved, " moved, ", Counted::destroyed, " destroyed");
  return 0;
}
