// spec: swapping a full Optional with an empty one builds the value in the empty one with one move and destroys the old value ([optional.swap])
struct Counted
{
  static int moved, destroyed;
  int value;
  Counted(int value) : value(value) {}
  Counted(Counted&& other) : value(other.value) { This::moved++; }
  Counted& operator=(Counted&& other)
  {
    this.value = other.value;
    return this;
  }
  ~Counted() { This::destroyed++; }
};
int Counted::moved = 0;
int Counted::destroyed = 0;

int main()
{
  std::Optional<Counted> full(std::inPlace, 3);
  std::Optional<Counted> empty;
  full.swap(empty);
  std::println((bool)full, " ", (bool)empty, " ", empty->value);
  std::println(Counted::moved, " moved, ", Counted::destroyed, " destroyed");
  return 0;
}
