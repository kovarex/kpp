// spec: on Windows a system ErrorCode equals the Errc that MSVC's std::system_category maps its Windows error to, for each error from 1 to 19999 that maps to a condition kpp's Errc names (each line is the error and the condition's place in `conditions`, what clang with MSVC's STL prints for the same program): ERROR_INVALID_DRIVE (15) is no_such_device, ERROR_BAD_PATHNAME (161) none, ERROR_DIRECTORY (267) invalid_argument
// kovarex, 2026-11-10 ("ok follow"): until then those three were no_such_file_or_directory, no_such_file_or_directory and not_a_directory, as docs/stdlib/filesystem.md had them
// target: windows (the table of Windows errors)
// found by thread I's battery er1 (2026-11-09): errcOfWindowsError, written to be std's table, lacked 30 of MSVC's entries (Winsock's errors, ERROR_SEM_TIMEOUT, WAIT_TIMEOUT, ERROR_NOT_READY...), which equalled no condition
extern "C" int printf(const char* format, ...);
std::Errc conditions[26] = {
  std::Errc::operation_not_permitted, std::Errc::no_such_file_or_directory, std::Errc::no_such_process, std::Errc::interrupted, std::Errc::io_error,
  std::Errc::resource_unavailable_try_again, std::Errc::illegal_byte_sequence, std::Errc::permission_denied, std::Errc::device_or_resource_busy,
  std::Errc::file_exists, std::Errc::cross_device_link, std::Errc::no_such_device, std::Errc::not_a_directory, std::Errc::is_a_directory,
  std::Errc::invalid_argument, std::Errc::too_many_files_open, std::Errc::file_too_large, std::Errc::no_space_on_device, std::Errc::read_only_file_system,
  std::Errc::resource_deadlock_would_occur, std::Errc::filename_too_long, std::Errc::function_not_supported, std::Errc::directory_not_empty,
  std::Errc::not_supported, std::Errc::operation_not_supported, std::Errc::timed_out};
int main()
{
  for (int e = 1; e < 20000; ++e)
  {
    std::ErrorCode ec(e, std::systemCategory());
    int found = -1;
    for (int i = 0; i < 26; ++i)
      if (ec == conditions[i])
        found = i;
    if (found >= 0)
      printf("%d %d\n", e, found);
  }
  return 0;
}
