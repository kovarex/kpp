// spec: UniformIntDistribution works with any engine ([rand.dist.uni.int] takes a uniform random bit generator of any min() and max()): from an engine of 16 random bits, the range 0 to 2^20 - 1 is covered, and the full range of u64 is
// pending: Random.kpp's operator() takes engine() as 64 random bits: with 16 bits every value is below 65536 (silent wrong answers), and for a range whose 2^64 mod range is 65536 or more (0 to 10^6) its rejection loop never ends (battery ra2 against MSVC's and libstdc++'s uniform_int_distribution)
struct Small
{
  using result_type = u32;
  u32 state = 12345;
  static constexpr u32 min() { return 0; }
  static constexpr u32 max() { return 0xFFFF; }
  u32 operator()()
  {
    this->state = this->state * 1103515245u + 12345u;
    return (this->state >> 8) & 0xFFFF;
  }
};
int main()
{
  Small engine;
  UniformIntDistribution<i32> wide(0, 1048575);
  i32 most = 0;
  for (i32 i = 0; i < 100000; ++i)
  {
    i32 v = wide(engine);
    if (v > most)
      most = v;
  }
  println("0 to 2^20 - 1, the largest drawn above 1000000: ", most > 1000000);
  UniformIntDistribution<u64> all(0, 18446744073709551615ull);
  i32 top = 0;
  for (i32 i = 0; i < 100000; ++i)
    if (all(engine) >= 9223372036854775808ull)
      ++top;
  println("full u64, the top half about half the draws: ", top > 45000 && top < 55000);
  return 0;
}
