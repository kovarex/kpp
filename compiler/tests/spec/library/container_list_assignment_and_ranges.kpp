// spec: every container takes `= {...}`, which replaces its contents with the listed elements (Vector, Deque, List, the ordered and hashed sets and maps, FastSet), and Vector and Deque are built from a range of any input iterators (a HashSet's, a Set's, a Vector's, a plain array's), while `Vector(3, 5)` stays three fives
// factorio: AsteroidCollectorNavmesh's `raycastSettings.selfIndex = { vertex.myID };` and AsteroidNavmeshUtil's `touchingChunks = { ChunkPosition(tilePosition) };` (sets), TransportLineManager's `Vector<TransportLine*> sortedLines(allLines.begin(), allLines.end())` from an unordered_set, RailChainSignal's `std::deque` from a vector's range
struct Chunk
{
  int x = 0;
  Chunk(int x) : x(x) {}
  bool operator<(const Chunk& other) const { return this.x < other.x; }
};
int main()
{
  Set<unsigned> ids = {1, 2};
  unsigned id = 7;
  ids = { id };
  Set<Chunk> chunks;
  chunks = { Chunk(3) };
  Vector<int> v = {9};
  v = { 1, 2, 3 };
  Map<int, String> names;
  names = { {1, String("a")}, {2, String("b")} };
  HashSet<int> seen;
  seen = { 4, 5, 4 };
  HashMap<int, int> counts;
  counts = { {1, 10} };
  Deque<int> d;
  d = { 6, 7 };
  List<int> l;
  l = { 8 };
  FastSet<int> fs;
  fs = { 3, 1 };
  println(ids.size(), " ", *ids.begin(), " ", chunks.begin()->x, " ", v.size(), " ", names.size(), " ", seen.size(), " ", counts.size(), " ", d.size(), " ", l.size());
  HashSet<int> pool = {5, 6, 7};
  Vector<int> sorted(pool.begin(), pool.end());
  Vector<int> base = {1, 2, 3, 4};
  Deque<int> queue(base.begin(), base.end());
  Set<int> ordered = {3, 1, 2};
  Vector<int> fromSet(ordered.begin(), ordered.end());
  Vector<int> counted(3, 5);
  int raw[3] = {7, 8, 9};
  Vector<int> fromArray(raw, raw + 3);
  println(sorted.size(), " ", queue.size(), " ", queue.back(), " ", fromSet[0], " ", fromSet[2], " ", counted[2], " ", fromArray[1]);
  return 0;
}
