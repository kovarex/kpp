// spec: String (std::string): building, comparison, search, substrings, c_str, iteration
// factorio: 11491 uses in 2434 files
int main()
{
  std::String s = "hello";
  s << ' ';
  s << std::String("world");
  std::String t = s + "!";
  int spaces = 0;
  for (char c : t)
    if (c == ' ')
      ++spaces;
  std::String sub(t.c_str() + 6, 5);
  std::println(t, " ", t.size(), " ", t.find("world"), " ", s == "hello world", " ", sub, " ", spaces);
  std::println(t.endsWith(std::String("!")), " ", std::String("b") < std::String("c"), " ", t[0], " ", std::toString(42) + "x");
  return 0;
}
