// spec: RecursiveMutex (std::recursive_mutex): the owning thread locks it again without blocking, each lock needs an unlock, and another thread waits until the last one
// factorio: the library's guarantee for converted code that re-enters a locked section (std::recursive_mutex)
std::RecursiveMutex m;
int depthSeen = 0;
void nested(int level)
{
  std::LockGuard<std::RecursiveMutex> lock(m);
  depthSeen = level;
  if (level < 3)
    nested(level + 1);
}
int main()
{
  nested(1);
  m.lock();
  bool again = m.tryLock();
  m.unlock();
  m.unlock();
  std::Atomic<int> counter(0);
  std::Vector<std::Thread> threads;
  for (int i = 0; i < 4; ++i)
    threads.emplace_back([&]() { for (int k = 0; k < 1000; ++k) { std::LockGuard<std::RecursiveMutex> outer(m); std::LockGuard<std::RecursiveMutex> inner(m); counter += 1; } });
  for (std::Thread& t : threads)
    t.join();
  std::println(depthSeen, " ", again, " ", counter.load());
  return 0;
}
