// spec: UniquePtr (std::unique_ptr): makeUnique, move, release/reset, polymorphic delete, a custom deleter called on the object (never on null, not on release; moved and swapped with it), UniqueArray, makeUniqueArrayForOverwrite (std::make_unique_for_overwrite<T[]>)
// factorio: 3820 uses in 1049 files
static int alive = 0;
class Res { public: int id; Res(int id) : id(id) { ++alive; } virtual ~Res() { --alive; } };
class Sub : public Res { public: Sub() : Res(9) {} };
static int closed = 0;
struct Closer
{
  int* counter = &closed;
  void operator()(Res* r) const
  {
    ++*this.counter;
    delete r;
  }
};
std::UniquePtr<Res> make(bool sub) { if (sub) return std::UniquePtr<Res>(new Sub()); return std::makeUnique<Res>(1); }
int main()
{
  std::UniquePtr<Res> a = make(false);
  std::UniquePtr<Res> b = make(true);
  std::UniquePtr<Res> c = std::move(a);
  int ids = b->id + c->id;
  b.reset();
  std::UniqueArray<int> arr(3);
  arr[2] = 7;
  std::println(ids, " ", a == nullptr, " ", alive, " ", (bool)c, " ", arr[2]);
  c = nullptr;
  std::println(alive);
  std::UniqueArray<char> buffer = std::makeUniqueArrayForOverwrite<char>(16);
  buffer[15] = 'z';
  std::UniqueArray<std::String> names = std::makeUniqueArrayForOverwrite<std::String>(2);
  std::println(int(sizeof(std::UniqueArray<char>)), " ", buffer[15], " ", names[1].size());
  {
    std::UniquePtr<Res, Closer> d(new Res(1));
    std::UniquePtr<Res, Closer> e = std::move(d);
    e.reset(new Res(2));
    Res* raw = e.release();
    delete raw;
    std::UniquePtr<Res, Closer> f(new Res(3));
    f.swap(e);
    std::UniquePtr<Res, Closer> empty;
  }
  std::println(closed, " ", alive, " ", sizeof(std::UniquePtr<Res>));
  return 0;
}
