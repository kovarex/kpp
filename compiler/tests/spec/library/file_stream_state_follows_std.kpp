// spec: InFileStream's and OutFileStream's state follows std::ifstream's and std::ofstream's: `if (in)` is !fail(), so a stream that has only reached the end (a getline of a last line without its newline, an ignore that reaches the end) is true while good() is false; getline of a stream that cannot read leaves the string as it was ([string.io]); a get or read past the end fails and sets the end; seekg clears the end but not a failure, after which nothing reads until the state is cleared (by opening here; clear() in library/in_file_stream_fail_and_clear_follow_std); tellg of a stream that is not good fails and gives -1; a stream closed or default-constructed stays good until an operation fails, so `out.close(); if (!out)` reports no failure; open of a stream already open and close of one not open fail; a failed stream writes nothing; writing to a stream with no file fails; and IstreambufIterator, as std::istreambuf_iterator, reads past the stream's state and leaves it alone. Every line is what clang with MSVC's STL and g++ with libstdc++ print (the C++ with std::ifstream and std::ofstream in binary mode)
// found by thread I's battery io2 (2026-11-09), which compared the streams' truth value with std's after each operation: kpp's was good(), and a stream's state came from the file's (feof, and whether a file was open), so a closed OutFileStream was false, and `out.close(); if (!out)` reported a write that had worked as failed
extern "C" import "stdio.h";
void writeFile(const char* path, const char* data, int count)
{
  FILE* f = fopen(path, "wb");
  fwrite(data, 1, count, f);
  fclose(f);
}

void state(const char* label, std::InFileStream& in)
{
  bool asBool = false;
  if (in)
    asBool = true;
  printf("%-36s bool %d not %d good %d eof %d\n", label, (int)asBool, (int)!in, (int)in.good(), (int)in.eof());
}

void outState(const char* label, std::OutFileStream& out)
{
  bool asBool = false;
  if (out)
    asBool = true;
  printf("%-36s bool %d good %d open %d\n", label, (int)asBool, (int)out.good(), (int)out.is_open());
}

void showLine(const char* label, bool ok, const std::String& line)
{
  printf("%-36s result %d line [%s]\n", label, (int)ok, line.c_str());
}

const char* path = "file_stream_state_follows_std.bin";

void missing()
{
  std::InFileStream in("file_stream_state_follows_std_missing.bin");
  state("missing: after open", in);
  std::String line = "kept";
  bool ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("missing: getline", ok, line);
  int c = in.get();
  printf("missing: get %d\n", c);
  state("missing: after get", in);
  printf("missing: open %d\n", (int)in.is_open());
}

void lines()
{
  writeFile(path, "ab\ncd", 5);
  std::InFileStream in(path);
  std::String line = "start";
  bool ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("no last newline: getline 1", ok, line);
  state("no last newline: after 1", in);
  ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("no last newline: getline 2", ok, line);
  state("no last newline: after 2", in);
  ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("no last newline: getline 3 (at end)", ok, line);
  state("no last newline: after 3", in);
  ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("no last newline: getline 4", ok, line);
}

void linesNewline()
{
  writeFile(path, "ab\n", 3);
  std::InFileStream in(path);
  std::String line = "start";
  bool ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("last newline: getline 1", ok, line);
  state("last newline: after 1", in);
  ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("last newline: getline 2 (at end)", ok, line);
  state("last newline: after 2", in);
  ok = false;
  if (std::getline(in, line))
    ok = true;
  showLine("last newline: getline 3", ok, line);
  state("last newline: after 3", in);
}

void getsToEnd()
{
  writeFile(path, "xy", 2);
  std::InFileStream in(path);
  int a = in.get();
  state("get: after 1", in);
  int b = in.get();
  state("get: after 2 (last)", in);
  int c = in.get();
  state("get: after 3 (past the end)", in);
  int d = in.get();
  state("get: after 4", in);
  printf("get: %d %d %d %d\n", a, b, c, d);
}

void ignores()
{
  writeFile(path, "abcde", 5);
  {
    std::InFileStream in(path);
    in.ignore(100);
    state("ignore past the end", in);
    int c = in.get();
    printf("ignore past the end: next %d\n", c);
    state("ignore past the end: after get", in);
  }
  {
    std::InFileStream in(path);
    in.ignore(5);
    state("ignore to the last byte", in);
    int c = in.get();
    printf("ignore to the last byte: next %d\n", c);
    state("ignore to the last byte: after get", in);
  }
  {
    std::InFileStream in(path);
    in.ignore(100, 'c');
    state("ignore through a delimiter", in);
    int c = in.get();
    printf("ignore through a delimiter: next %c\n", (char)c);
    in.ignore(100, 'z');
    state("ignore, no such delimiter", in);
  }
  {
    std::InFileStream in(path);
    in.ignore();
    int c = in.get();
    printf("ignore one: next %c\n", (char)c);
  }
}

void reads()
{
  writeFile(path, "abcde", 5);
  char buffer[16];
  {
    std::InFileStream in(path);
    in.read(buffer, 5);
    state("read all exactly", in);
    in.read(buffer, 1);
    state("read past the end", in);
  }
  {
    std::InFileStream in(path);
    for (int i = 0; i < 16; ++i)
      buffer[i] = '.';
    in.read(buffer, 10);
    state("read short", in);
    buffer[10] = 0;
    printf("read short: [%s]\n", buffer);
    in.read(buffer, 1);
    state("read after a short read", in);
  }
  {
    std::InFileStream in(path);
    in.read(buffer, 0);
    state("read nothing", in);
  }
}

void seeks()
{
  writeFile(path, "abcde", 5);
  {
    std::InFileStream in(path);
    in.seekg(3);
    state("seekg 3", in);
    int at = (int)in.tellg();
    char following = (char)in.get();
    printf("seekg 3: tellg %d, next %c\n", at, following);
  }
  {
    std::InFileStream in(path);
    in.ignore(100);
    state("seekg after eof alone: before", in);
    in.seekg(1);
    state("seekg after eof alone: after", in);
    int c = in.get();
    printf("seekg after eof alone: next %d\n", c);
  }
  {
    std::InFileStream in(path);
    while (in.get() != -1)
    {
    }
    state("seekg after a failed get: before", in);
    in.seekg(1);
    state("seekg after a failed get: after", in);
    int c = in.get();
    printf("seekg after a failed get: next %d\n", c);
    state("seekg after a failed get: end", in);
  }
  {
    std::InFileStream in(path);
    in.ignore(100);
    int t = (int)in.tellg();
    printf("tellg at eof alone: %d\n", t);
    state("tellg at eof alone: after", in);
  }
  {
    std::InFileStream in(path);
    while (in.get() != -1)
    {
    }
    int t = (int)in.tellg();
    printf("tellg after a failed get: %d\n", t);
  }
}

void closes()
{
  writeFile(path, "ab", 2);
  {
    std::InFileStream in(path);
    state("input: open", in);
    in.close();
    state("input: closed", in);
    printf("input: open %d\n", (int)in.is_open());
    int c = in.get();
    printf("input: get after close %d\n", c);
    state("input: after that get", in);
    in.open(path);
    state("input: opened again", in);
    printf("input: next %c\n", (char)in.get());
  }
  {
    std::OutFileStream out("file_stream_state_follows_std_out.bin");
    outState("output: open", out);
    out.close();
    outState("output: closed", out);
    out.open("file_stream_state_follows_std_out.bin");
    outState("output: opened again", out);
    out.close();
    outState("output: closed again", out);
  }
  {
    std::OutFileStream out("file_stream_state_follows_std_no_directory/x.bin");
    outState("output: cannot open", out);
  }
}

void defaults()
{
  std::InFileStream in;
  state("default input", in);
  printf("default input: open %d\n", (int)in.is_open());
  int c = in.get();
  printf("default input: get %d\n", c);
  state("default input: after get", in);
  std::InFileStream closing;
  closing.close();
  state("default input: closed", closing);
  std::OutFileStream out;
  outState("default output", out);
  out << "x";
  outState("default output: after a write", out);
  std::OutFileStream writing;
  writing.write("ab", 2);
  outState("default output: after write()", writing);
  std::OutFileStream shutting;
  shutting.close();
  outState("default output: closed", shutting);
}

void iterators()
{
  writeFile(path, "abc", 3);
  std::InFileStream in(path);
  std::String all;
  std::copy(std::IstreambufIterator<char>(in), std::IstreambufIterator<char>(), std::backInserter(all));
  printf("iterator: read [%s]\n", all.c_str());
  state("iterator: after reading all", in);
  int c = in.get();
  printf("iterator: get after it %d\n", c);
  state("iterator: after that get", in);
}

void reopened()
{
  writeFile(path, "ab", 2);
  writeFile("file_stream_state_follows_std_other.bin", "xy", 2);
  std::InFileStream in(path);
  in.open("file_stream_state_follows_std_other.bin");
  state("open while open", in);
  printf("open while open: file open %d\n", (int)in.is_open());
  int c = in.get();
  printf("open while open: get %d\n", c);
  in.close();
  state("open while open: closed", in);
  in.open("file_stream_state_follows_std_other.bin");
  state("open while open: opened again", in);
  c = in.get();
  printf("open while open: next %c\n", (char)c);
  in.close();
  in.close();
  state("closed twice", in);
  remove("file_stream_state_follows_std_other.bin");
}

void outputs()
{
  {
    std::OutFileStream out("file_stream_state_follows_std_out.bin");
    out << "text";
    out.close();
    outState("write then close", out);
    if (!out)
      printf("write then close: the write looks failed\n");
    else
      printf("write then close: the write looks fine\n");
    out << "more";
    outState("write after close", out);
    out.open("file_stream_state_follows_std_out.bin");
    outState("opened after that", out);
    out.close();
    out.close();
    outState("closed twice", out);
  }
  {
    std::OutFileStream out("file_stream_state_follows_std_out.bin");
    out.open("file_stream_state_follows_std_out2.bin");
    outState("output: open while open", out);
    out << "lost";
    out.close();
    outState("output: closed after that", out);
    std::InFileStream written("file_stream_state_follows_std_out.bin");
    int c = written.get();
    printf("output: first byte %d\n", c);
  }
  remove("file_stream_state_follows_std_out2.bin");
}

int main()
{
  defaults();
  iterators();
  reopened();
  outputs();
  missing();
  lines();
  linesNewline();
  getsToEnd();
  ignores();
  reads();
  seeks();
  closes();
  remove(path);
  remove("file_stream_state_follows_std_out.bin");
  return 0;
}
