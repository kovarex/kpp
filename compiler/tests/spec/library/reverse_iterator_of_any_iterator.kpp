// spec: ReverseIterator<It> (std::reverse_iterator) of any bidirectional iterator, a class's own as well as a pointer: built from an iterator, base(), *, ->, ++ and -- reversed; for a random-access It, +, -, [], the distance and the orderings reversed; a const reverse iterator from a non-const one; makeReverseIterator
// factorio: CompactDeque's `reverse_iterator rbegin() { return reverse_iterator(iterator(this, this->size())); }` and SmallVector's `using reverse_iterator = std::reverse_iterator<iterator>;`
struct Steps
{
  using value_type = int;
  using difference_type = ptrdiff_t;
  using pointer = int*;
  using reference = int&;
  using iterator_category = BidirectionalIteratorTag;

  int* at = nullptr;
  Steps() {}
  Steps(int* at) : at(at) {}
  int& operator*() const { return *this.at; }
  int* operator->() const { return this.at; }
  Steps& operator++()
  {
    ++this.at;
    return this;
  }
  Steps& operator--()
  {
    --this.at;
    return this;
  }
  bool operator==(const Steps& other) const { return this.at == other.at; }
  bool operator!=(const Steps& other) const { return this.at != other.at; }
};
struct Point
{
  int x = 0;
};
int main()
{
  int values[4] = {1, 2, 3, 4};
  using Back = ReverseIterator<Steps>;
  String walked;
  for (Back it = Back(Steps(values + 4)); it != Back(Steps(values)); ++it)
    walked << toString(*it);
  Back last(Steps(values + 4));
  *last = 40;
  Back second = last;
  ++second;
  --second;
  println(walked, " ", values[3], " ", second == last && second.base() == Steps(values + 4));
  Vector<int> v = {5, 6, 7, 8};
  Vector<int>::reverse_iterator r = v.rbegin();
  Vector<int>::const_reverse_iterator cr = r;
  println(*r, " ", r[1], " ", *(r + 2), " ", v.rend() - r, " ", r < r + 1, " ", cr == r);
  Vector<Point> points = {Point{3}, Point{9}};
  println(points.rbegin()->x, " ", makeReverseIterator(points.end())->x);
  Deque<int> d = {1, 2, 3};
  auto dr = d.rbegin();
  println(*dr, " ", dr[2], " ", d.rend() - d.rbegin());
  List<int> l = {7, 8, 9};
  String back;
  for (auto it = l.rbegin(); it != l.rend(); ++it)
    back << toString(*it);
  println(back);
  return 0;
}
