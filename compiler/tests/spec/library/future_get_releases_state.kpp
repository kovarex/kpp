// spec: Future::get() releases the future's state, as std::future::get does: valid() is false after it, for Future<T> and Future<void> alike
// factorio: ThreadedBufferedReadStream::stopReadWorker's `if (this->worker.valid()) this->worker.get();` and its destructor's `assert(!this->worker.valid())`: the worker stayed valid after get(), and the normal start stopped at that assertion once the main menu's map was loaded
int main()
{
  std::Future<int> f = std::async(std::Launch::async, []() { return 7; });
  bool before = f.valid();
  int value = f.get();
  std::Future<void> g = std::async(std::Launch::deferred, []() {});
  g.get();
  std::println(before, " ", value, " ", f.valid(), " ", g.valid());
  return 0;
}
