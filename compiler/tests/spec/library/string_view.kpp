// spec: StringView (std::string_view): from literals and Strings, substr, find, prefix/suffix, comparison
// factorio: 1744 uses in 527 files
int countWords(std::StringView text)
{
  int words = 0;
  while (!text.empty())
  {
    int space = text.find(' ');
    if (space == std::StringView::npos) { ++words; break; }
    if (space > 0) ++words;
    text = text.substr(space + 1);
  }
  return words;
}
int main()
{
  std::String owner = "key=value";
  std::StringView view = owner;
  int eq = view.find('=');
  std::StringView key = view.substr(0, eq), value = view.substr(eq + 1);
  std::println(key, " ", value, " ", key == "key", " ", view.startsWith("ke"), " ", view.endsWith(std::StringView("lue")), " ", countWords("a bb  ccc"));
  return 0;
}
