// spec: Tuple (std::tuple) of any number of elements: get<I> (a reference, const from a const tuple, an rvalue reference from an rvalue tuple), structured bindings through TupleSize, makeTuple, tie assigning from a Pair or a Tuple, forwardAsTuple, deduction (`Tuple(1, 2.5)`), converting construction and assignment, a move-only element, comparisons in lexicographic order and a Tuple as a Map key; Array is tuple-like too (get<I>, bindings, tupleSize)
// factorio: 51 std::tuple uses: PerformanceLogger's statistics of 5 (`auto [min, max, median, avg, stdDev] = ...`), FramebufferDX11's (width, height, format), GraphicsInterfaceDX11's Map keyed by (driver, version) and (path, entryPoint, target), SpiderUnit's `std::tie(movementSpeed, stretchForce) = calculate(...)`, TurretRangeListDrawOrder's std::tuple_size_v of an array
std::Pair<double, double> speedAndForce(double s) { return std::Pair<double, double>(s * 2, s * 3); }
std::Tuple<int, double> times(int i) { return std::makeTuple(i, i * 0.5); }
std::Tuple<double, double, double, double, double> statistics() { return std::makeTuple(1.0, 9.0, 4.0, 4.5, 2.25); }

int main()
{
  std::Tuple<int, std::String, double> t(1, std::String("two"), 3.0);
  std::get<0>(t) += 10;
  auto [x, y, z] = t;
  auto& [rx, ry, rz] = t;
  rx = 5;
  const auto& [cx, cy, cz] = t;
  std::println(x, " ", y, " ", z, " ", std::get<0>(t), " ", cx + int(cz), " ", cy.size());

  double speed = 0;
  double force = 0;
  std::tie(speed, force) = speedAndForce(1.5);
  int count = 0;
  double half = 0;
  std::tie(count, half) = times(4);
  std::println(speed, " ", force, " ", count, " ", half);

  std::Tuple<std::UniquePtr<int>, int> owning = std::makeTuple(std::makeUnique<int>(7), 3);
  std::Tuple<std::UniquePtr<int>, int> moved = std::move(owning);
  std::UniquePtr<int> taken = std::get<0>(std::move(moved));
  std::println(*taken, " ", std::get<1>(moved), " ", std::get<0>(owning) == nullptr);

  std::Tuple<int, char, char> t1(1, 'a', 'b');
  std::Tuple<int, char, char> t2(1, 'a', 'c');
  auto deduced = std::Tuple(1, 2.5);
  std::Tuple<int, double> fromPair = std::Pair<int, double>(3, 4.5);
  std::Tuple<long long, double> widened = deduced;
  std::println(t1 == t2, " ", t1 < t2, " ", t2 > t1, " ", (t1 <=> t1) == 0, " | ", std::get<1>(deduced), " ", std::get<0>(fromPair), " ", std::get<1>(fromPair), " ", std::get<0>(widened));

  int a = 1;
  int b = 2;
  auto references = std::forwardAsTuple(a, b);
  std::get<0>(references) = 9;
  auto [mn, mx, median, average, deviation] = statistics();
  std::println(a, " ", std::get<1>(references), " | ", mn, " ", mx, " ", median, " ", average, " ", deviation);

  static_assert(std::TupleSize<std::Tuple<int, char, std::String>>::value == 3);
  static_assert(std::isSame<std::TupleElement<1, std::Tuple<int, char, std::String>>::Type, char>);
  static_assert(std::tupleSize<std::Array<float, 4>> == 4);
  std::Array<int, 3> array = {4, 5, 6};
  auto [p, q, r] = array;
  std::Map<std::Tuple<std::String, uint64_t>, std::Vector<int>> drivers;
  drivers[std::makeTuple(std::String("nv"), uint64_t(3))].push_back(1);
  drivers[std::makeTuple(std::String("nv"), uint64_t(3))].push_back(2);
  drivers[std::makeTuple(std::String("amd"), uint64_t(1))].push_back(3);
  std::println(p, " ", q, " ", r, " ", std::get<2>(array));
  for (const auto& [key, list] : drivers)
    std::println(std::get<0>(key), " ", std::get<1>(key), " ", list.size());
  return 0;
}
