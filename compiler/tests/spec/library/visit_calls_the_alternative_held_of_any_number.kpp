// spec: visit(visitor, variant) calls the visitor with the alternative the variant holds, as std::visit of one variant ([variant.visit]), for a class with index(), get<I>() and its number of alternatives as the constant `size`: any number of them (1, 2, 3, 7, 8, 9, 12, 20, 64). The visitor can change the alternative; the variant's value category reaches the alternative (a const variant's is const, an rvalue variant's an rvalue, so a by-value visitor copies from an lvalue and moves from an rvalue); the visitor is not copied; the result can be a reference or a class; a variant holding none of its alternatives throws BadVariantAccess without calling the visitor; an exception of the visitor passes through. Every line is what clang with MSVC's STL and g++ with libstdc++ print with std::variant
// found by thread I (2026-11-09): visit had a case for each of the indexes 0 to 7. A variant of 9 or more alternatives holding the ninth called the visitor with alternative 0, printing its value for std's, with no error; one of fewer than 8 did not compile
extern "C" int printf(const char* format, ...);
template<typename... Ts>
struct Shape
{
  static constexpr i32 size = sizeof...(Ts);
  i32 held = 0;
  Tuple<Ts...> all;
  i32 index() const { return this.held; }
  template<i32 I>
  decltype(auto) get() & { return this.all.template get<I>(); }
  template<i32 I>
  decltype(auto) get() const& { return this.all.template get<I>(); }
  template<i32 I>
  decltype(auto) get() && { return this.all.template getRvalue<I>(); }
};
// As many alternatives as asked for: get<I> makes the alternative, with no nesting.
template<i32 I>
struct Alt;
template<i32 N>
struct Many
{
  static constexpr i32 size = N;
  i32 held = 0;
  i32 index() const { return this.held; }
  template<i32 I>
  Alt<I> get() { return Alt<I>(); }
};
template<int I, typename V>
void hold(V& v)
{
  v.held = I;
}
template<typename V>
void makeValueless(V& v)
{
  v.held = -1;
}
template<int I>
struct Alt
{
  int value = I * 10;
};

int copies = 0;
int moves = 0;
struct Counted
{
  int value = 1;
  Counted() {}
  Counted(const Counted& other) : value(other.value) { ++copies; }
  Counted(Counted&& other) : value(other.value) { ++moves; }
};

bool armed = false;
struct Thrower
{
  int value = 2;
  Thrower()
  {
    if (armed)
      throw 1;
  }
  // (Not trivially copyable: libstdc++ builds a trivially copyable alternative apart, and stays as it was.)
  Thrower(const Thrower& other) : value(other.value) {}
};

template<int I, typename V>
void showOne(V& v)
{
  hold<I>(v);
  int got = visit([](const auto& x) { return x.value; }, v);
  printf(" %d", got);
}

void sizes()
{
  Shape<Alt<0>> a1;
  printf("1:");
  showOne<0>(a1);
  printf("\n");
  Shape<Alt<0>, Alt<1>> a2;
  printf("2:");
  showOne<0>(a2);
  showOne<1>(a2);
  printf("\n");
  Shape<Alt<0>, Alt<1>, Alt<2>> a3;
  printf("3:");
  showOne<0>(a3);
  showOne<1>(a3);
  showOne<2>(a3);
  printf("\n");
  Shape<Alt<0>, Alt<1>, Alt<2>, Alt<3>, Alt<4>, Alt<5>, Alt<6>> a7;
  printf("7:");
  showOne<0>(a7);
  showOne<3>(a7);
  showOne<6>(a7);
  printf("\n");
  Shape<Alt<0>, Alt<1>, Alt<2>, Alt<3>, Alt<4>, Alt<5>, Alt<6>, Alt<7>> a8;
  printf("8:");
  showOne<0>(a8);
  showOne<3>(a8);
  showOne<7>(a8);
  printf("\n");
  Shape<Alt<0>, Alt<1>, Alt<2>, Alt<3>, Alt<4>, Alt<5>, Alt<6>, Alt<7>, Alt<8>> a9;
  printf("9:");
  showOne<0>(a9);
  showOne<7>(a9);
  showOne<8>(a9);
  printf("\n");
  Shape<Alt<0>, Alt<1>, Alt<2>, Alt<3>, Alt<4>, Alt<5>, Alt<6>, Alt<7>, Alt<8>, Alt<9>, Alt<10>, Alt<11>> a12;
  printf("12:");
  showOne<8>(a12);
  showOne<9>(a12);
  showOne<10>(a12);
  showOne<11>(a12);
  printf("\n");
  Many<20> a20;
  printf("20:");
  showOne<0>(a20);
  showOne<8>(a20);
  showOne<15>(a20);
  showOne<16>(a20);
  showOne<19>(a20);
  printf("\n");
  Many<64> a64;
  printf("64:");
  showOne<0>(a64);
  showOne<31>(a64);
  showOne<63>(a64);
  printf("\n");
}

using Two = Shape<Alt<0>, Alt<1>>;

void changesTheAlternative()
{
  Shape<Alt<0>, Alt<1>, Alt<2>> v;
  hold<2>(v);
  visit([](auto& x) { x.value = -5; }, v);
  int got = visit([](auto& x) { return x.value; }, v);
  printf("changed %d\n", got);
}

struct WhichAlternative
{
  const char* operator()(Alt<0>&) { return "0 lvalue"; }
  const char* operator()(const Alt<0>&) { return "0 const lvalue"; }
  const char* operator()(Alt<0>&&) { return "0 rvalue"; }
  const char* operator()(const Alt<0>&&) { return "0 const rvalue"; }
  const char* operator()(Alt<1>&) { return "1 lvalue"; }
  const char* operator()(const Alt<1>&) { return "1 const lvalue"; }
  const char* operator()(Alt<1>&&) { return "1 rvalue"; }
  const char* operator()(const Alt<1>&&) { return "1 const rvalue"; }
};

void alternativeCategories()
{
  Two v;
  const Two& c = v;
  printf("%s\n", visit(WhichAlternative(), v));
  printf("%s\n", visit(WhichAlternative(), c));
  printf("%s\n", visit(WhichAlternative(), move(v)));
  Two w;
  hold<1>(w);
  const Two& d = w;
  printf("%s\n", visit(WhichAlternative(), w));
  printf("%s\n", visit(WhichAlternative(), d));
  printf("%s\n", visit(WhichAlternative(), move(w)));
}

struct WhichVisitor
{
  int operator()(Alt<0>&) & { return 1; }
  int operator()(Alt<0>&) const& { return 2; }
  int operator()(Alt<1>&) & { return 11; }
  int operator()(Alt<1>&) const& { return 12; }
};

void visitorCategories()
{
  Two v;
  WhichVisitor f;
  const WhichVisitor g;
  printf("visitor %d\n", visit(f, v));
  printf("visitor %d\n", visit(g, v));
  hold<1>(v);
  printf("visitor %d\n", visit(f, v));
  printf("visitor %d\n", visit(g, v));
}

struct NoCopy
{
  int calls = 0;
  NoCopy() {}
  NoCopy(const NoCopy&) = delete;
  int operator()(Alt<0>& a)
  {
    ++this.calls;
    return a.value;
  }
  int operator()(Alt<1>& a)
  {
    ++this.calls;
    return a.value;
  }
};

void visitorIsNotCopied()
{
  Two v;
  NoCopy f;
  visit(f, v);
  hold<1>(v);
  visit(f, v);
  printf("calls %d\n", f.calls);
}

void referenceResult()
{
  Two v;
  hold<1>(v);
  int& r = visit([](auto& x) -> int& { return x.value; }, v);
  r = 77;
  visit([](auto& x) -> int& { return x.value; }, v) += 1;
  int got = visit([](auto& x) { return x.value; }, v);
  printf("reference %d\n", got);
}

struct Named
{
  int id = 0;
  Named(int i) : id(i) {}
};

void classResult()
{
  Two v;
  hold<1>(v);
  Named n = visit([](auto& x) { return Named(x.value + 1); }, v);
  printf("named %d\n", n.id);
}

void copiesAndMoves()
{
  Shape<Counted, Alt<1>> v;
  copies = 0;
  moves = 0;
  int got = visit([](auto x) { return x.value; }, v);
  printf("lvalue: %d copies %d moves %d\n", got, copies, moves);
  copies = 0;
  moves = 0;
  got = visit([](auto x) { return x.value; }, move(v));
  printf("rvalue: %d copies %d moves %d\n", got, copies, moves);
}

void holdingNone()
{
  Shape<Alt<0>, Thrower> v;
  makeValueless(v);
  int calls = 0;
  try
  {
    visit([&](auto& x) { ++calls; return x.value; }, v);
    printf("no exception\n");
  }
  catch (const BadVariantAccess&)
  {
    printf("caught, calls %d\n", calls);
  }
}

void visitorThrows()
{
  Two v;
  try
  {
    visit([](auto& x) -> int { throw x.value + 1; }, v);
  }
  catch (int e)
  {
    printf("visitor threw %d\n", e);
  }
}

int main()
{
  sizes();
  changesTheAlternative();
  alternativeCategories();
  visitorCategories();
  visitorIsNotCopied();
  referenceResult();
  classResult();
  copiesAndMoves();
  holdingNone();
  visitorThrows();
  return 0;
}
