// spec: `get<I>(tuple)` reads element I of a Tuple (what std::get converts to), including as an index or an argument
// found in src/Util (InfiniteBitset: `this->data[get<0>(indexOffset)]` with `auto indexOffset = this->getIndexAndOffset(index)`)
std::Tuple<int, unsigned> split(unsigned long long index) { return std::makeTuple(int(index / 64), unsigned(index % 64)); }
int main()
{
  std::Vector<int> words = {10, 20, 30};
  auto indexOffset = split(130);
  std::println(std::get<0>(indexOffset), " ", std::get<1>(indexOffset), " ", words[std::get<0>(indexOffset)]);
  std::get<1>(indexOffset) += 1;
  std::println(std::get<1>(indexOffset));
  return 0;
}
