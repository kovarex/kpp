// spec: Vector::erase destroys the erased elements once each and move-assigns the ones after them down, as [vector.modifiers] has it (one destructor call per erased element, one move assignment per element after them): erasing the second of four elements is 2 move assignments and 1 destructor call, with no move construction, as MSVC's STL counts it; a type without move assignment is relocated instead (a kpp addition) (`0 2 1 / 0 3 2 / [0 2 3] [1 3]`)
extern "C" int printf(const char* format, ...);
int constructions = 0, assignments = 0, destructions = 0;
class Counted
{
public:
  Counted(int v) : value(v) {}
  Counted(const Counted& other) : value(other.value) {}
  Counted(Counted&& other) noexcept : value(other.value) { ++constructions; }
  Counted& operator=(Counted&& other) noexcept
  {
    this.value = other.value;
    ++assignments;
    return this;
  }
  Counted& operator=(const Counted& other) = default;
  ~Counted() { ++destructions; }
  int value;
};
class Fixed
{
public:
  Fixed(int v) : value(v) {}
  Fixed(Fixed&& other) noexcept : value(other.value) {}
  Fixed& operator=(Fixed&&) = delete;
  const int value;
};
int main()
{
  std::Vector<Counted> v;
  v.reserve(8);
  for (int i = 0; i < 4; ++i)
    v.emplace_back(i);
  constructions = assignments = destructions = 0;
  v.erase(v.begin() + 1);
  printf("%d %d %d / ", constructions, assignments, destructions);
  std::Vector<Counted> w;
  w.reserve(8);
  for (int i = 0; i < 6; ++i)
    w.emplace_back(i);
  constructions = assignments = destructions = 0;
  w.erase(w.begin() + 1, w.begin() + 3);
  printf("%d %d %d / [", constructions, assignments, destructions);
  for (const Counted& c : v)
    printf(&c == v.begin() ? "%d" : " %d", c.value);
  std::Vector<Fixed> f;
  for (int i = 0; i < 4; ++i)
    f.emplace_back(i);
  f.erase(f.begin() + 2);
  f.erase(f.begin());
  printf("] [%d %d]\n", f[0].value, f[1].value);
  return 0;
}
