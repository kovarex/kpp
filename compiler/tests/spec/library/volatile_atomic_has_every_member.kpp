// spec: a volatile Atomic has every member a plain one has, as std::atomic's volatile overloads: load, store, exchange, the compare-exchanges, the fetch operations, ++, --, the compound assignments, the conversion to T, assignment from T, is_lock_free, wait and notify; for an integer, a bool, a pointer and a floating-point T; clang's output with MSVC's STL
// found by H (2026-11-09): the game's src/ChildProcessAgent.kpp:113 (POSIX only, so no Windows gate built it) has `volatile Atomic<::sig_atomic_t> signalOccured` (C++ `volatile std::atomic<std::sig_atomic_t>`) and calls exchange(bool) on it, "no overload of Atomic<int32>::exchange takes (bool)" since volatile objects need volatile member functions (8c3a1243); Atomic had none (K)
extern "C" int printf(const char* format, ...);

volatile Atomic<i32> signalled = false;

void handler() { signalled = true; }

int main()
{
  handler();
  i32 was = signalled.exchange(false);
  printf("%d %d\n", was, (i32)signalled.load());

  volatile Atomic<i32> v = 5;
  v.store(7);
  v.store(8, MemoryOrder::seq_cst);
  i32 a = v.load();
  i32 b = v.load(MemoryOrder::seq_cst);
  i32 c = v.exchange(9);
  i32 d = v.exchange(10, MemoryOrder::seq_cst);
  i32 expected = 10;
  bool e = v.compare_exchange_strong(expected, 11);
  expected = 3;
  bool f = v.compare_exchange_strong(expected, 12);
  i32 g = expected;
  expected = 11;
  bool h = v.compare_exchange_weak(expected, 13, MemoryOrder::seq_cst);
  expected = 13;
  bool i = v.compare_exchange_strong(expected, 14, MemoryOrder::seq_cst, MemoryOrder::seq_cst);
  printf("%d %d %d %d %d %d %d %d %d %d\n", a, b, c, d, (i32)e, (i32)f, g, (i32)h, (i32)i, (i32)v);

  i32 j = v.fetch_add(6);
  i32 k = v.fetch_sub(4);
  i32 l = v.fetch_and(0xF);
  i32 m = v.fetch_or(0x30);
  i32 n = v.fetch_xor(0x5);
  i32 o = ++v;
  i32 p = v++;
  i32 q = --v;
  i32 r = v--;
  i32 s = (v += 100);
  i32 t = (v -= 50);
  i32 u = (v &= 0xFF);
  i32 w = (v |= 0x100);
  i32 x = (v ^= 0x3);
  i32 y = (v = 77);
  printf("%d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d\n", j, k, l, m, n, o, p, q, r, s, t, u, w, x, y, (i32)v.load());

  volatile Atomic<bool> flag = false;
  bool before = flag.exchange(true);
  printf("%d %d %d\n", (i32)before, (i32)flag.load(), (i32)flag.is_lock_free());

  i32 cells[4] = {10, 20, 30, 40};
  volatile Atomic<i32*> at = cells;
  i32* first = at.fetch_add(2);
  i32* third = at.load();
  i32* back = (at -= 1);
  ++at;
  at--;
  printf("%d %d %d %d\n", *first, *third, *back, *at.load());

  volatile Atomic<double> real = 1.5;
  double before2 = real.fetch_add(2.25);
  real += 0.25;
  printf("%.2f %.2f\n", before2, real.load());

  v.wait(1);
  v.notify_one();
  v.notify_all();
  printf("%d\n", (i32)(v == 77));
  return 0;
}
