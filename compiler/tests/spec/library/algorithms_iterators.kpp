// spec: the algorithms over iterators of every category: sort, removeIf, stableSort on a Deque (random access, not pointers); find, count, reverse, rotate, merge on a List (bidirectional); lowerBound, upperBound, accumulate, setDifference on a Set; transform from a Map into a backInserter; upperBound over reverse iterators with Greater; unique, nextPermutation, isSorted, equal, maxElement with a comparator
// factorio: 108 sort, 74 find, 49 distance, 47 find_if, 37 stable_sort, 32 remove_if, 29 lower_bound, 22 is_sorted, ...; BlueprintLibrary's remove_if over a deque, GameSpeed's upper_bound over rbegin/rend with greater<double>, cxxopts' transform over a map
struct Entry { int key; std::String name; };
int main()
{
  // Random access iterators that are not pointers: a Deque.
  std::Deque<int> deque;
  for (int x : {5, 3, 9, 1, 7, 3})
    deque.push_back(x);
  std::sort(deque.begin(), deque.end());
  auto removedFrom = std::removeIf(deque.begin(), deque.end(), [](int x) { return x == 3; });
  int kept = int(std::distance(deque.begin(), removedFrom));
  // Bidirectional and forward iterators: List, Set, Map, HashSet.
  std::List<int> list;
  for (int x : {4, 1, 3, 1, 2})
    list.push_back(x);
  std::reverse(list.begin(), list.end());
  auto found = std::find(list.begin(), list.end(), 3);
  int ones = int(std::count(list.begin(), list.end(), 1));
  std::Set<int> set = {10, 20, 30, 40};
  auto atLeast25 = std::lowerBound(set.begin(), set.end(), 25);
  auto after30 = std::upperBound(set.begin(), set.end(), 30);
  std::Map<std::String, int> map = {{"a", 1}, {"b", 2}, {"c", 3}};
  std::Vector<std::String> keys;
  std::transform(map.begin(), map.end(), std::backInserter(keys), [](const std::Pair<std::String, int>& entry) { return entry.first; });
  int total = std::accumulate(set.begin(), set.end(), 0);
  // A reverse range searched with a descending order (GameSpeed's upper_bound with greater<double>).
  std::Vector<double> speeds = {0.5, 1.0, 2.0, 4.0};
  auto faster = std::upperBound(speeds.rbegin(), speeds.rend(), 1.5, std::Greater<double>());
  // Rotating, permuting, merging, deduplicating, checking order.
  std::Vector<int> digits = {1, 2, 3, 4, 5};
  std::rotate(digits.begin(), digits.begin() + 2, digits.end());
  std::List<int> rotated;
  for (int x : {1, 2, 3, 4, 5})
    rotated.push_back(x);
  auto newFirst = std::rotate(rotated.begin(), std::next(rotated.begin(), 3), rotated.end());
  std::Vector<int> perm = {1, 2, 3};
  std::nextPermutation(perm.begin(), perm.end());
  std::List<int> odd, even;
  for (int x : {1, 3, 5})
    odd.push_back(x);
  for (int x : {2, 4})
    even.push_back(x);
  std::Vector<int> merged;
  std::merge(odd.begin(), odd.end(), even.begin(), even.end(), std::backInserter(merged));
  std::Vector<int> repeats = {1, 1, 2, 2, 2, 3};
  repeats.erase(std::unique(repeats.begin(), repeats.end()), repeats.end());
  std::Set<int> small = {20, 40};
  std::Vector<int> difference;
  std::setDifference(set.begin(), set.end(), small.begin(), small.end(), std::backInserter(difference));
  std::Deque<Entry> entries;
  entries.push_back(Entry{2, "b1"});
  entries.push_back(Entry{1, "a"});
  entries.push_back(Entry{2, "b2"});
  std::stableSort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.key < b.key; });
  auto biggest = std::maxElement(map.begin(), map.end(), [](const std::Pair<std::String, int>& a, const std::Pair<std::String, int>& b) { return a.second < b.second; });
  std::String text;
  for (int x : digits)
    text << std::toString(x);
  std::println(deque[0], " ", kept, " ", *found, " ", ones, " ", *atLeast25, " ", *after30, " ", keys.size());
  std::println(total, " ", *faster, " ", text, " ", *newFirst, " ", *rotated.begin(), " ", perm[1]);
  std::println(merged.size(), " ", merged[1], " ", repeats.size(), " ", difference.size(), " ", entries[1].name, " ", biggest->first);
  std::println(std::isSorted(merged.begin(), merged.end()), " ", std::isSorted(list.begin(), list.end()), " ", std::equal(odd.begin(), odd.end(), merged.begin()));
  return 0;
}
