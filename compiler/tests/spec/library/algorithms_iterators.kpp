// spec: the algorithms over iterators of every category: sort, removeIf, stableSort on a Deque (random access, not pointers); find, count, reverse, rotate, merge on a List (bidirectional); lowerBound, upperBound, accumulate, setDifference on a Set; transform from a Map into a backInserter; upperBound over reverse iterators with Greater; unique, nextPermutation, isSorted, equal, maxElement with a comparator
// factorio: 108 sort, 74 find, 49 distance, 47 find_if, 37 stable_sort, 32 remove_if, 29 lower_bound, 22 is_sorted, ...; BlueprintLibrary's remove_if over a deque, GameSpeed's upper_bound over rbegin/rend with greater<double>, cxxopts' transform over a map
struct Entry { int key; String name; };
int main()
{
  // Random access iterators that are not pointers: a Deque.
  Deque<int> deque;
  for (int x : {5, 3, 9, 1, 7, 3})
    deque.push_back(x);
  sort(deque.begin(), deque.end());
  auto removedFrom = removeIf(deque.begin(), deque.end(), [](int x) { return x == 3; });
  int kept = int(distance(deque.begin(), removedFrom));
  // Bidirectional and forward iterators: List, Set, Map, HashSet.
  List<int> list;
  for (int x : {4, 1, 3, 1, 2})
    list.push_back(x);
  reverse(list.begin(), list.end());
  auto found = find(list.begin(), list.end(), 3);
  int ones = int(count(list.begin(), list.end(), 1));
  Set<int> set = {10, 20, 30, 40};
  auto atLeast25 = lowerBound(set.begin(), set.end(), 25);
  auto after30 = upperBound(set.begin(), set.end(), 30);
  Map<String, int> map = {{"a", 1}, {"b", 2}, {"c", 3}};
  Vector<String> keys;
  transform(map.begin(), map.end(), backInserter(keys), [](const Pair<String, int>& entry) { return entry.first; });
  int total = accumulate(set.begin(), set.end(), 0);
  // A reverse range searched with a descending order (GameSpeed's upper_bound with greater<double>).
  Vector<double> speeds = {0.5, 1.0, 2.0, 4.0};
  auto faster = upperBound(speeds.rbegin(), speeds.rend(), 1.5, Greater<double>());
  // Rotating, permuting, merging, deduplicating, checking order.
  Vector<int> digits = {1, 2, 3, 4, 5};
  rotate(digits.begin(), digits.begin() + 2, digits.end());
  List<int> rotated;
  for (int x : {1, 2, 3, 4, 5})
    rotated.push_back(x);
  auto newFirst = rotate(rotated.begin(), next(rotated.begin(), 3), rotated.end());
  Vector<int> perm = {1, 2, 3};
  nextPermutation(perm.begin(), perm.end());
  List<int> odd, even;
  for (int x : {1, 3, 5})
    odd.push_back(x);
  for (int x : {2, 4})
    even.push_back(x);
  Vector<int> merged;
  merge(odd.begin(), odd.end(), even.begin(), even.end(), backInserter(merged));
  Vector<int> repeats = {1, 1, 2, 2, 2, 3};
  repeats.erase(unique(repeats.begin(), repeats.end()), repeats.end());
  Set<int> small = {20, 40};
  Vector<int> difference;
  setDifference(set.begin(), set.end(), small.begin(), small.end(), backInserter(difference));
  Deque<Entry> entries;
  entries.push_back(Entry{2, "b1"});
  entries.push_back(Entry{1, "a"});
  entries.push_back(Entry{2, "b2"});
  stableSort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.key < b.key; });
  auto biggest = maxElement(map.begin(), map.end(), [](const Pair<String, int>& a, const Pair<String, int>& b) { return a.second < b.second; });
  String text;
  for (int x : digits)
    text << toString(x);
  println(deque[0], " ", kept, " ", *found, " ", ones, " ", *atLeast25, " ", *after30, " ", keys.size());
  println(total, " ", *faster, " ", text, " ", *newFirst, " ", *rotated.begin(), " ", perm[1]);
  println(merged.size(), " ", merged[1], " ", repeats.size(), " ", difference.size(), " ", entries[1].name, " ", biggest->first);
  println(isSorted(merged.begin(), merged.end()), " ", isSorted(list.begin(), list.end()), " ", equal(odd.begin(), odd.end(), merged.begin()));
  return 0;
}
