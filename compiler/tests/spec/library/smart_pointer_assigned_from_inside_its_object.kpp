// spec: assigning a UniquePtr, SharedPtr or WeakPtr-locked SharedPtr from a pointer that lives inside the object it gives up (walking a list: `head = move(head->next)`, `head = head->next`) takes the new value before the old object is destroyed, as std's do (unique_ptr: reset(r.release()); shared_ptr: a copy swapped in, then the old owner released) (`2 2 3, 2 2 3 1, 1 3 1, 1 4 1`)
// factorio: E's comparison battery against C++ (sp1, 2026-11-06): UniquePtr's `head = move(head->next)` deleted all three nodes (the old head deleted its next, still set) and then wrote into the freed node; SharedPtr's `head = head->next` released the old head first and then read the freed node's next: null, then a crash on Linux
extern "C" import "stdio.h";
int alive = 0;
struct UNode
{
  int v;
  UniquePtr<UNode> next;
  UNode(int x) : v(x) { ++alive; }
  ~UNode() { --alive; }
};
struct SNode
{
  int v;
  SharedPtr<SNode> next;
  SNode(int x) : v(x) { ++alive; }
  ~SNode() { --alive; }
};
int main()
{
  {
    UniquePtr<UNode> head = makeUnique<UNode>(1);
    head->next = makeUnique<UNode>(2);
    head->next->next = makeUnique<UNode>(3);
    head = move(head->next);
    printf("%d %d %d,", alive, head->v, head->next->v);
  }
  {
    SharedPtr<SNode> head = makeShared<SNode>(1);
    head->next = makeShared<SNode>(2);
    head->next->next = makeShared<SNode>(3);
    head = head->next;
    printf(" %d %d %d %d,", alive, head->v, head->next->v, (int)head.use_count());
    head = move(head->next);
    printf(" %d %d %d,", alive, head->v, (int)head.use_count());
    WeakPtr<SNode> weak = head;
    head->next = makeShared<SNode>(4);
    weak = head->next;
    head = weak.lock();
    printf(" %d %d %d\n", alive, head->v, (int)weak.use_count());
  }
  return 0;
}
