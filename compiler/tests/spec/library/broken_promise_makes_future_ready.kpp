// spec: a Promise destroyed before it set a value or an exception makes its Future ready with an error (std::promise's destructor stores future_error(broken_promise), [futures.promise] 9), so waiting returns at once and get() throws, never blocking forever (`ready throws`)
// factorio: E's concurrency battery against C++ (cc1, 2026-11-06): get() on the Future of a destroyed Promise blocked forever, on Windows and Linux
extern "C" import "stdio.h";
int main()
{
  std::Future<int> orphan;
  {
    std::Promise<int> broken;
    orphan = broken.get_future();
  }
  if (orphan.wait_for(std::Milliseconds(0)) != std::FutureStatus::ready)
  {
    printf("not ready\n");
    return 0;
  }
  try
  {
    orphan.get();
    printf("ready returns\n");
  }
  catch (...)
  {
    printf("ready throws\n");
  }
  return 0;
}
