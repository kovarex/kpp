// List (List.kpp) against a Vector as the reference, references surviving every other change,
// splice, sort (stable), merge, unique, reverse, remove.
extern "C" int printf(const char* format, ...);

uint64_t state = 777;
int nextInt(int range)
{
  state ^= state << 13;
  state ^= state >> 7;
  state ^= state << 17;
  return int(state % (uint64_t)range);
}

int main()
{
  List<String> list;
  Vector<String> reference;
  list.push_back(String("anchor that stays where it is"));
  reference.push_back(String("anchor that stays where it is"));
  String* anchor = &list.front();
  int errors = 0;
  for (int step = 0; step < 5000; ++step)
  {
    String value = toString(step);
    int action = nextInt(4);
    if (action == 0)
    {
      list.push_back(value);
      reference.push_back(value);
    }
    else if (action == 1)
    {
      list.push_front(value);
      reference.insert(0, value);
    }
    else if (action == 2)
    {
      int at = nextInt(reference.size() + 1);
      auto it = list.begin();
      for (int i = 0; i < at; ++i)
        ++it;
      list.insert(it, value);
      reference.insert(at, value);
    }
    else if (reference.size() > 1)
    {
      int at = nextInt(reference.size());
      if (reference[at] == String("anchor that stays where it is"))
        continue;
      auto it = list.begin();
      for (int i = 0; i < at; ++i)
        ++it;
      list.erase(it);
      reference.erase(at);
    }
  }
  int i = 0;
  for (String& s : list)
    errors += s == reference[i++] ? 0 : 1;
  int backwards = 0;
  for (auto it = list.end(); it != list.begin();)
  {
    --it;
    ++backwards;
  }
  bool anchorKept = *anchor == String("anchor that stays where it is");

  // Stable sort by the first digit only; elements keep their addresses.
  List<int> numbers = {35, 12, 31, 17, 22, 19, 38};
  int* thirtyFive = &numbers.front();
  numbers.sort([](int a, int b) { return a / 10 < b / 10; });
  for (int n : numbers)
    printf("%d ", n);
  List<int> more = {11, 20, 33};
  numbers.sort();
  numbers.merge(more);
  numbers.push_back(38);
  numbers.unique();
  numbers.remove(20);
  numbers.reverse();
  for (int n : numbers)
    printf("%d ", n);
  List<int> spliced = {1, 2};
  List<int> source = {3, 4, 5};
  spliced.splice(spliced.end(), source, ++source.begin());
  spliced.splice(spliced.begin(), source);
  for (int n : spliced)
    printf("%d ", n);
  List<int> movedList = move(spliced);
  printf("| %d %d %d %d %d %zu %zu %zu\n", errors, list.size() == reference.size() ? 1 : 0, backwards == list.size() ? 1 : 0, anchorKept ? 1 : 0,
         *thirtyFive, source.size(), spliced.size(), movedList.size());
  return 0;
}
