// Builtin type traits: compile-time booleans and type functions, no partial specialisation.

struct Base { int x; };
struct Derived : Base { int y; };
enum class Color : uint8_t { { Red, Green } };

template<typename T>
const char* describe()
{
  if constexpr (std::isPointer<T>)
    return "pointer";
  else if constexpr (std::isEnum<T>)
    return "enum";
  else if constexpr (std::isFloatingPoint<T>)
    return "float";
  else if constexpr (std::isIntegral<T>)
    return std::isSigned<T> ? "signed" : "unsigned";
  else if constexpr (std::isClass<T>)
    return "class";
  else
    return "?";
}

template<typename T>
int widthOf()
{
  std::RemoveReference<std::RemoveConst<T>> value;
  return sizeof(value);
}

int main()
{
  std::println(std::StringView(describe<int>()), " ", std::StringView(describe<char*>()), " ", std::StringView(describe<Color>()), " ", std::StringView(describe<double>()), " ", std::StringView(describe<unsigned int>()), " ", std::StringView(describe<Base>()));
  std::println(widthOf<const long long&>(), " ", widthOf<Derived>());
  std::println(std::isSame<std::RemoveConst<const int>, int>, " ", std::isSame<std::RemoveReference<Base&>, Base>, " ", std::isSame<int, long long>);
  std::println(std::isBaseOf<Base, Derived>, " ", std::isBaseOf<Derived, Base>, " ", std::isConvertible<Derived*, Base*>);
  std::println(std::isSame<std::UnderlyingType<Color>, uint8_t>, " ", std::isNullPointer<nullptr_t>);
  return 0;
}
