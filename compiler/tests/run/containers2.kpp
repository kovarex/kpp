// The container internals behind the performance work (docs/stdlib-performance.md): String's
// small/large switch, arguments that point into the container being changed, sort and stableSort,
// HashMap/HashSet rehashing, deleted entries and copies, and that elements move through their
// move constructors (an object that points to itself stays valid).
extern "C" int printf(const char* format, ...);

uint64_t state = 12345;
int nextInt(int range)
{
  state ^= state << 13;
  state ^= state >> 7;
  state ^= state << 17;
  return int(state % (uint64_t)range);
}

// Keeps its own address, which only constructors that set it again keep right.
struct SelfAware
{
  SelfAware* self;
  int value;

  SelfAware() : self(this), value(0) {}
  SelfAware(int value) : self(this), value(value) {}
  SelfAware(const SelfAware& other) : self(this), value(other.value) {}
  SelfAware(SelfAware&& other) : self(this), value(other.value) {}
  SelfAware& operator=(const SelfAware& other)
  {
    this->value = other.value;
    return *this;
  }
  SelfAware& operator=(SelfAware&& other)
  {
    this->value = other.value;
    return *this;
  }
  bool operator<(const SelfAware& other) const { return this->value < other.value; }
  bool valid() const { return this->self == this; }
};

void moves()
{
  Vector<SelfAware> values;
  for (int i = 0; i < 100; ++i)
    values.push_back(SelfAware(nextInt(10)));
  values.insert(0, SelfAware(5));
  values.erase(10);
  values.erase(values.begin() + 20, values.begin() + 30);
  stableSort(values.begin(), values.end());
  HashMap<int, SelfAware> map;
  for (int i = 0; i < 100; ++i)
    map[i] = SelfAware(i);
  int valid = 0;
  for (SelfAware& v : values)
    valid += v.valid() ? 1 : 0;
  map.forEach([&](const int& key, SelfAware& v) { valid += v.valid() && v.value == key ? 1 : 0; });
  printf("%d %d\n", values.size(), valid);
}

void strings()
{
  // Growing across the 22-character small capacity one character at a time.
  String text;
  for (int i = 0; i < 30; ++i)
    text.push_back(char('a' + i % 26));
  printf("%d %d %s\n", text.size(), text.isLarge() ? 1 : 0, text.c_str());
  String small("exactly-22-characters!");
  String large("exactly-23-characters!!");
  printf("%d %d %d %d\n", small.size(), small.isLarge() ? 1 : 0, large.size(), large.isLarge() ? 1 : 0);

  // Appending and inserting a string into itself, small and large.
  String twice("abc");
  twice.append(twice);
  twice.append(twice);
  twice.append(twice);
  twice.append(twice);
  printf("%d %s\n", twice.size(), twice.c_str());
  String inner("0123456789");
  inner.insert(5, inner.c_str() + 2, 6);
  printf("%s\n", inner.c_str());

  // Copies and moves keep their own characters.
  String a = large;
  String b = small;
  String moved = move(a);
  a = b;
  b.append("+more");
  printf("%s|%s|%s|%d\n", a.c_str(), b.c_str(), moved.c_str(), a == small ? 1 : 0);
  String assigned("short");
  assigned = large;
  assigned = String("x");
  printf("%s %d\n", assigned.c_str(), assigned.size());

  // Searching.
  String haystack("the needle and the other needle");
  printf("%d %d %d %d %d %d\n", haystack.find("needle"), haystack.find("needle", 5), haystack.find("pin"), haystack.find('o'),
         haystack.find("", 3), haystack.find(String("the"), 1));
  printf("%s|%s|%s\n", haystack.substr(4, 6).c_str(), haystack.substr(26).c_str(), haystack.substr(26, -1).c_str());

  // Editing.
  String edit("hello world");
  edit.erase(5, 6);
  edit.resize(8, '!');
  edit.insert(0, 2, '>');
  printf("%s %d\n", edit.c_str(), edit.size());
  edit.clear();
  printf("[%s] %d %d\n", edit.c_str(), edit.size(), edit.empty() ? 1 : 0);
  String joined = String("left") + "+" + large + 'X';
  printf("%s %d\n", joined.c_str(), String("abc") < String("abd") ? 1 : 0);
}

void vectors()
{
  // push_back of an element of the vector itself while it grows.
  Vector<String> words;
  words.push_back(String("first word that is long enough to live on the heap"));
  for (int i = 0; i < 20; ++i)
    words.push_back(words[0]);
  words.insert(0, words[words.size() - 1]);
  printf("%d %s\n", words.size(), words[20].c_str());

  Vector<int> numbers;
  for (int i = 0; i < 4; ++i)
    numbers.push_back(i);
  numbers.push_back(numbers[3]);
  numbers.resize(8);
  numbers.resize(10, numbers[1]);
  int extra[3] = {7, 8, 9};
  numbers.insert(numbers.begin() + 2, extra, extra + 3);
  for (int n : numbers)
    printf("%d ", n);
  printf("\n");

  Vector<String> copy = words;
  copy.resize(2);
  copy.resize(3);
  printf("%d %d [%s]\n", copy.size(), words.size(), copy[2].c_str());
}

void sorting()
{
  Vector<int> values;
  for (int i = 0; i < 5000; ++i)
    values.push_back(nextInt(1000));
  sort(values.begin(), values.end(), [](int a, int b) { return a > b; });
  bool descending = true;
  for (int i = 1; i < values.size(); ++i)
    if (values[i - 1] < values[i])
      descending = false;
  Vector<int> heap;
  for (int i = 0; i < 300; ++i)
    heap.push_back(nextInt(50));
  auto less = [](int a, int b) { return a < b; };
  heapSort(heap.begin(), heap.end(), less);
  bool ascending = true;
  for (int i = 1; i < heap.size(); ++i)
    if (heap[i] < heap[i - 1])
      ascending = false;
  printf("%d %d %d %d\n", descending ? 1 : 0, ascending ? 1 : 0, values[0], heap[0]);

  Vector<String> names;
  for (int i = 0; i < 200; ++i)
    names.push_back(toString(nextInt(100000)) + String(i % 3 == 0 ? " and a tail long enough to allocate" : ""));
  sort(names.begin(), names.end());
  bool sorted = true;
  for (int i = 1; i < names.size(); ++i)
    if (names[i] < names[i - 1])
      sorted = false;
  printf("%d\n", sorted ? 1 : 0);

  // stableSort keeps the original order of equal keys.
  Vector<Pair<int, int>> pairs;
  for (int i = 0; i < 1000; ++i)
    pairs.push_back(Pair<int, int>(nextInt(10), i));
  stableSort(pairs.begin(), pairs.end(), [](const Pair<int, int>& a, const Pair<int, int>& b) { return a.first < b.first; });
  bool stable = true;
  for (int i = 1; i < pairs.size(); ++i)
    if (pairs[i].first < pairs[i - 1].first || (pairs[i].first == pairs[i - 1].first && pairs[i].second < pairs[i - 1].second))
      stable = false;
  printf("%d %d %d\n", stable ? 1 : 0, pairs[0].first, pairs[999].first);
}

void hashing()
{
  // Insert and erase over and over: deleted entries must not grow the table without bound.
  HashMap<int, int> churn;
  for (int round = 0; round < 200; ++round)
  {
    for (int i = 0; i < 100; ++i)
      churn[round * 1000 + i] = i;
    for (int i = 0; i < 100; ++i)
      churn.erase(round * 1000 + i);
  }
  printf("%d %d\n", churn.size(), churn.capacity <= 256 ? 1 : 0);

  // A copy keeps the deleted markers that later keys' probe paths run through.
  HashMap<String, int> map;
  for (int i = 0; i < 1000; ++i)
    map[toString(i)] = i;
  for (int i = 0; i < 1000; i += 3)
    map.erase(toString(i));
  HashMap<String, int> copy = map;
  int found = 0;
  for (int i = 0; i < 1000; ++i)
    if (copy.find(toString(i)))
      found += *copy.find(toString(i)) == i ? 1 : 100000;
  HashMap<String, int> moved = move(copy);
  map.insert(String("1"), 11);
  printf("%d %d %d %d %d\n", found, moved.size(), copy.size(), *map.find(String("1")), map.contains(String("3")) ? 1 : 0);

  // Aligned pointers as keys.
  Vector<int*> blocks;
  HashSet<int*> pointers;
  for (int i = 0; i < 500; ++i)
  {
    int* block = (int*)malloc(64);
    blocks.push_back(block);
    pointers.insert(block);
  }
  int present = 0;
  for (int* block : blocks)
    present += pointers.contains(block) ? 1 : 0;
  for (int i = 0; i < 500; i += 2)
    pointers.erase(blocks[i]);
  HashSet<int*> pointersCopy = pointers;
  printf("%d %d %d\n", present, pointers.size(), pointersCopy.contains(blocks[1]) ? 1 : 0);
  for (int* block : blocks)
    free(block);
}

int main()
{
  strings();
  vectors();
  sorting();
  hashing();
  moves();
  return 0;
}
