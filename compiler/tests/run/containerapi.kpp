// The rest of the container interface (docs/stdlib/): one line of output per container.
extern "C" int printf(const char* format, ...);

void vectors()
{
  Vector<int> values(3, 7);
  int raw[4] = {1, 2, 3, 4};
  Vector<int> range(raw, raw + 4);
  values.insert(values.begin() + 1, 2, values[0]);
  values.reserve(100);
  int before = values.capacity();
  values.shrink_to_fit();
  values.swap(range);
  const Vector<int>& view = values;
  range.assign(2, 9);
  Vector<int> listed;
  listed.assign({5, 6});
  printf("%d %zu %d %d %d %zu %d %d %zu\n", before, range.capacity(), view[0], view.front(), view.back(), range.size(), range[1], listed[1],
         values.size());
}

void strings()
{
  String text("one two one three");
  String other("short");
  text.swap(other);
  printf("%zu %zu %zu %zu %zu %d %d %d %s %s\n", other.rfind("one"), other.rfind(String("one"), 7), other.rfind('e', 5), other.rfind("zzz"),
         other.find_last_of("wt"), String("abc").compare(String("abd")) < 0 ? 1 : 0, String("b").compare("a") > 0 ? 1 : 0,
         String("x").compare(String("x")), text.c_str(), other.substr(0, 3).c_str());
}

void maps()
{
  Map<int, String> map;
  for (int i = 0; i < 10; ++i)
    map.insert(map.end(), Pair<int, String>(i * 2, toString(i))); // hint at the end: appending in order
  auto hinted = map.emplace_hint(map.find(4), 3, String("three"));
  map.emplace_hint(map.begin(), 100, String("hint far off"));
  int reversed = 0;
  for (auto it = map.rbegin(); it != map.rend(); ++it)
    reversed = reversed * 10 % 100000 + it->first % 10;
  String* address = &map.find(6)->second;
  auto handle = map.extract(6);
  bool kept = &handle.mapped() == address;
  Map<int, String> other = {{5, String("five")}, {7, String("seven")}};
  auto back = other.insert(move(handle));
  auto again = map.extract(8);
  again.key() = 7;
  auto refused = other.insert(move(again));
  Vector<Pair<int, String>> more = {{50, String("fifty")}, {2, String("not two")}};
  map.insert(more.begin(), more.end());
  Map<int, String> merged = {{1, String("one")}, {2, String("other two")}};
  map.merge(merged);
  map.swap(other);
  printf("%zu %s %d %d %d %d %s %zu %s %zu %d %s %s\n", map.size(), hinted->second.c_str(), reversed, kept ? 1 : 0, back.inserted ? 1 : 0,
         refused.inserted ? 1 : 0, refused.node.mapped().c_str(), other.size(), other.find(2)->second.c_str(), merged.size(),
         other.contains(1) ? 1 : 0, map.find(6)->second.c_str(), &map.find(6)->second == address ? "same" : "moved");

  MultiMap<int, int> multi = {{1, 10}, {1, 11}, {2, 20}};
  multi.insert(multi.end(), Pair<int, int>(1, 12));
  MultiMap<int, int> otherMulti = {{1, 13}};
  multi.merge(otherMulti);
  auto node = multi.extract(2);
  multi.insert(move(node));
  Set<String> set = {String("b"), String("a")};
  Set<String> otherSet = {String("a"), String("c")};
  set.merge(otherSet);
  MultiSet<int> bag = {1, 2};
  bag.insert(bag.begin(), 0);
  for (auto it = multi.rbegin(); it != multi.rend(); ++it)
    printf("%d ", it->second);
  printf("| %zu %zu %s %d %zu\n", set.size(), otherSet.size(), (*set.rbegin()).c_str(), *bag.begin(), bag.size());

  FastMap<int, int> fast = {{1, 1}, {3, 3}};
  FastMap<int, int> fastOther = {{2, 2}, {3, 30}};
  fast.merge(fastOther);
  fast.emplace_hint(fast.end(), 4, 4);
  int fastSum = 0;
  for (auto it = fast.rbegin(); it != fast.rend(); ++it)
    fastSum = fastSum * 10 + it->second;
  printf("%d %zu %d\n", fastSum, fastOther.size(), fastOther.find(3)->second);
}

void hashes()
{
  HashMap<int, String> map = {{1, String("one")}, {2, String("two")}};
  String* one = &map.find(1)->second;
  HashMap<int, String> other = {{2, String("other two")}, {3, String("three")}};
  String* three = &other.find(3)->second;
  map.merge(other);
  map.emplace_hint(map.end(), 4, String("four"));
  Vector<Pair<int, String>> more = {{5, String("five")}};
  map.insert(more.begin(), more.end());
  FastHashSet<int> fast = {1, 2};
  FastHashSet<int> fastOther = {2, 3};
  fast.merge(fastOther);
  HashMap<int, String> swapped;
  swapped.swap(map);
  printf("%zu %zu %s %d %d %zu %zu %zu\n", swapped.size(), other.size(), other.find(2)->second.c_str(), &swapped.find(3)->second == three ? 1 : 0,
         &swapped.find(1)->second == one ? 1 : 0, map.size(), fast.size(), fastOther.size());
}

void lists()
{
  ForwardList<int> forward = {1, 2, 4};
  auto second = ++forward.begin();
  forward.insert_after(second, 3);
  forward.emplace_front(0);
  forward.erase_after(forward.begin());
  forward.push_front(9);
  forward.pop_front();
  forward.reverse();
  for (int v : forward)
    printf("%d ", v);
  List<int> list = {1, 2, 3};
  Deque<int> deque = {4, 5, 6};
  int reversed = 0;
  for (auto it = list.rbegin(); it != list.rend(); ++it)
    reversed = reversed * 10 + *it;
  for (auto it = deque.rbegin(); it != deque.rend(); ++it)
    reversed = reversed * 10 + *it;
  PriorityQueue<String> queue;
  queue.emplace("b");
  queue.push(String("c"));
  queue.emplace(3, 'a');
  printf("| %d %s %zu\n", reversed, queue.top().c_str(), queue.size());
}

int main()
{
  vectors();
  strings();
  maps();
  hashes();
  lists();
  return 0;
}
