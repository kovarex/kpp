// The small macro replacements: assert statements, caller locations, conditional functions,
// if constexpr on config constants at both scopes, `_` locals and attributes.

struct Guard
{
  const char* name;
  Guard(const char* name) : name(name) { std::println("enter ", std::StringView(name)); }
  ~Guard() { std::println("leave ", std::StringView(this->name)); }
};

void note(const char* text, std::CallerLocation here = caller)
{
  std::println(std::StringView(text), " at line ", int(here.line()), " column ", int(here.column()), " in ", std::StringView(here.function_name()));
}

conditional(config::debug) void debugOnly(const char* text) { std::println("debug: ", std::StringView(text)); }
conditional(!config::debug) void releaseOnly(const char* text) { std::println("release: ", std::StringView(text)); }

if constexpr (config::debug)
{
  int buildKind() { return 1; }
}
else
{
  int buildKind() { return 2; }
}

[[noinline]] int twice(int x) { return x * 2; }

int main()
{
  int x = twice(21);
  assert(x == 42);
  release_assert(x > 0);
  note("first");
  note("second");
  debugOnly("shown");
  releaseOnly("hidden");
  if constexpr (config::platform == Platform::Windows)
    std::println("windows");
  else
    println("elsewhere");
  std::println("build kind ", buildKind());
  {
    Guard _("a");
    Guard _("b");
    std::println("inside");
  }
  return 0;
}
