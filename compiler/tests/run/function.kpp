// Function<R(Args...)>: callables of any kind behind one type: function pointers, lambdas with
// captures, functors; passed by value, copied, moved, reset, checked for emptiness, called.
extern "C" int printf(const char* format, ...);

struct Counter
{
  int count = 0;
  void operator()(int by) { this->count += by; }
};

int twice(int x) { return x * 2; }

int apply(std::Function<int(int)> f, int x) { return f(x); }

void each(const std::Vector<int>& values, std::Function<void(int)> f)
{
  for (int x : values)
    f(x);
}

struct Button
{
  std::Function<void()> onClick;
  void click()
  {
    if (this->onClick)
      this->onClick();
  }
};

int main()
{
  std::Function<int(int)> f = &twice;
  int base = 10;
  std::Function<int(int)> g = [base](int x) { return x + base; };
  printf("%d %d %d\n", f(4), g(5), apply(g, 6));
  std::Vector<int> values;
  values.push_back(1);
  values.push_back(2);
  values.push_back(3);
  int sum = 0;
  each(values, [&sum](int x) { sum += x; });
  std::Function<void()> none;
  std::Function<int(int)> h = f;
  f = nullptr;
  printf("%d %d %d %d\n", sum, none ? 1 : 0, !f ? 1 : 0, h(7));
  Counter counter;
  std::Function<void(int)> count = [&counter](int by) { counter(by); };
  count(3);
  count(4);
  Button button;
  button.click();
  int clicks = 0;
  button.onClick = [&clicks]() { ++clicks; };
  button.click();
  button.click();
  printf("%d %d\n", counter.count, clicks);
  return 0;
}
