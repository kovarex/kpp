// Variadic templates: format/println with a parameter pack, sizeof..., folds over arithmetic.
template<typename... Args>
int countArgs(Args... args)
{
  return (int)sizeof...(args);
}

template<typename... Args>
long long sumAll(Args... args)
{
  return (args + ...);
}

template<typename T, typename... Rest>
std::String joinWith(const char* separator, T first, Rest... rest)
{
  std::String result = std::toString(first);
  ((result.append(separator), result.append(std::toString(rest))), ...);
  return result;
}

int main()
{
  std::println(2, " + ", 3, " = ", 2 + 3);
  std::println("name=", std::String("kpp"), " pi=", 3.25, " ok=", true, " ch=", 'x');
  std::println("count=", countArgs(1, 2.0, "three"), " sum=", sumAll(1, 2, 3, 4));
  std::println(joinWith(", ", 1, 2, 3));
  std::println(std::format("{}{}", "no", " args") + std::String("!"));
  std::println("plain string without arguments");
  return 0;
}
