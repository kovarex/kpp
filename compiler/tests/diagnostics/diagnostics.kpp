// Diagnostics (docs/build.md, "Visual Studio"): every one is labelled error, warning or note, a
// code generator's gap too, at path:line, or at path(line) with --msvc-diagnostics.
static_assert(1 == 2, "one is not two");
int gap()
{
  return undefinedThing + 1;
}
// An undeclared type: the checker's error at the name; the body, whose member access cannot be
// generated, adds no error of the code generator's (nor does gap's undeclared name).
int built(Project& p) { return p.count; }
int main()
{
  int x = "s";
  return x + gap();
}
// A call of an undeclared name, and a call given one: the checker's errors alone, never the code
// generator's failure on the calls that hold them (an editor showed both).
int called() { undefinedCall(1); return 0; }
int given() { std::println("x ", missingValue); return 0; }
