// battery i36: C++20 forms: designated initializers (with members skipped, defaulted ones, nested),
// a defaulted <=> and == on a class of mixed members compared member by member, <=> results tested
// with < 0 and == 0, `using enum`, consteval with a template, a lambda with a template parameter list,
// abbreviated function templates (`auto` parameters), concepts in a requires clause of a lambda, and
// [[likely]]/[[unlikely]] attributes that change nothing.
struct Options
{
  int width = 80;
  int height = 25;
  bool color = true;
  const char* name = "term";
};
struct Outer
{
  Options options;
  int depth = 1;
};
struct Version
{
  int major;
  int minor;
  double patch;
  auto operator<=>(const Version&) const = default;
  bool operator==(const Version&) const = default;
};
enum class Suit { clubs, diamonds, hearts, spades };
int value(Suit s)
{
  using enum Suit;
  switch (s)
  {
    case clubs: return 1;
    case diamonds: return 2;
    case hearts: [[likely]] return 3;
    case spades: [[unlikely]] return 4;
  }
  return 0;
}
template <int N> consteval int square() { return N * N; }
int describe(auto x) { return (int)sizeof(x); }
int total(auto... xs) { return (0 + ... + (int)xs); }
template <typename T> concept Numeric = requires(T a) { a + a; a * a; };
int main()
{
  Options o{.height = 50, .name = "x"};
  Outer w{.options = {.width = 120}, .depth = 3};
  printf("designated %d %d %d %s | %d %d %d %d\n", o.width, o.height, (int)o.color, o.name, w.options.width, w.options.height, (int)w.options.color, w.depth);
  Version a{1, 2, 3.5}, b{1, 2, 4.0}, c{1, 3, 0.0};
  printf("spaceship %d %d %d %d %d %d\n", (int)((a <=> b) < 0), (int)((c <=> a) > 0), (int)(a == a), (int)(a != b), (int)(a < c), (int)((a <=> a) == 0));
  printf("enum %d %d %d\n", value(Suit::clubs), value(Suit::hearts), value(Suit::spades));
  printf("consteval %d %d\n", square<7>(), square<-3>());
  auto pick = []<typename T>(T a, T b) { return a < b ? b : a; };
  auto num = []<Numeric T>(T x) { return x * x; };
  printf("lambdas %d %g %d %g\n", pick(3, 9), pick(2.5, 1.5), num(7), num(1.5));
  printf("abbreviated %d %d %d %d\n", describe('a'), describe(1.0), total(), total(1, 2.9, 'a'));
  return 0;
}
