// battery i20: the compile-time interpreter on lambdas and templates: a constexpr lambda called in a
// constant expression, one returned by a constexpr function and called, captures by copy and by
// reference at compile time, a generic lambda instantiated twice, recursion through a lambda passed
// to itself, requires-expressions in if constexpr, templates' static constexpr members computed from
// constexpr functions, a fold over a lambda's results, std-like accumulate with a lambda.
template <typename F> constexpr int applyTwice(F f, int x) { return f(f(x)); }
constexpr auto adder(int k) { return [k](int x) { return x + k; }; }
constexpr int byRef()
{
  int total = 0;
  auto add = [&total](int v) { total += v; };
  for (int i = 1; i <= 5; ++i)
    add(i * i);
  return total;
}
constexpr int generic()
{
  auto twice = [](auto v) { return v + v; };
  return twice(21) * 10 + (int)twice(2.25);
}
constexpr int fact()
{
  auto f = [](auto self, int n) -> int { return n <= 1 ? 1 : n * self(self, n - 1); };
  return f(f, 6);
}
template <typename T> constexpr int describe()
{
  if constexpr (requires(T t) { t.size(); })
    return 1;
  else if constexpr (requires(T t) { t + t; })
    return 2;
  else
    return 3;
}
struct Sized { int size() const { return 4; } };
struct Opaque {};
constexpr int squareSum(int n) { int s = 0; for (int i = 1; i <= n; ++i) s += i * i; return s; }
template <int N> struct Table { static constexpr int value = squareSum(N); static constexpr int twice = value * 2; };
template <typename... F> constexpr int sumOf(int x, F... f) { return (f(x) + ... + 0); }
constexpr int c1 = applyTwice([](int x) { return x * 3 + 1; }, 2);
constexpr int c2 = adder(10)(5);
constexpr int c3 = byRef(), c4 = generic(), c5 = fact();
constexpr int c6 = describe<Sized>() * 100 + describe<int>() * 10 + describe<Opaque>();
constexpr int c7 = Table<10>::twice;
constexpr int c8 = sumOf(3, [](int x) { return x; }, [](int x) { return x * x; }, adder(100));
int main(int argc, char**)
{
  int z = argc - 1;
  printf("lambdas %d %d %d %d %d\n", c1, c2, c3, c4, c5);
  printf("runtime %d %d %d %d %d\n", applyTwice([](int x) { return x * 3 + 1; }, 2 + z), adder(10 + z)(5), byRef(), generic(), fact());
  printf("templates %d %d %d %d\n", c6, c7, c8, sumOf(3 + z, [](int x) { return x; }, [](int x) { return x * x; }, adder(100)));
  return 0;
}
