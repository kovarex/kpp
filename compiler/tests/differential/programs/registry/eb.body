enum class Color : signed char { red = -2, green = 1 };
enum class Big : long long { neg = -3, pos = 2 };
enum Plain { minus = -1, zero = 0, plus = 1 };
enum class Small : unsigned char { x = 5 };
struct S { Color c : 3; Big g : 4; Plain p : 2; Small s : 3; };
int main()
{
  S v{};
  v.c = Color::red;
  v.g = Big::neg;
  v.p = minus;
  v.s = Small::x;
  printf("%d %d %d %d %d %d\n", (int)v.c, (int)v.g, (int)v.p, (int)v.s, (int)(v.c == Color::red), (int)(v.p == minus));
  return 0;
}
