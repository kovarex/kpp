int say(const char* what, int v) { printf("init %s = %d\n", what, v); return v; }
struct B1 { int a = 1; };
struct B2 { int b = 2; constexpr B2() {} int get() const { return b; } };
struct D : B1, B2 { int c = 3; constexpr D() {} };
extern D d;
B2* bp = &d;
const B2& br = d;
int viaBase = say("viaBase", bp->get() + br.b);
D d;
class V { public: constexpr V() {} virtual int f() const { return 1; } };
class W : public V { public: constexpr W() {} int f() const override { return 2; } };
extern const W w;
const V* vp = &w;
int viaVirtual = say("viaVirtual", vp->f());
const W w;
int fn(int x) { return x + 1; }
int (*fp)(int) = fn;
int viaFn = say("viaFn", fp(1));
struct M { int x; int y; int get() const { return y; } };
int M::* mp = &M::y;
int (M::* mfp)() const = &M::get;
M gm = {1, 2};
int viaMp = say("viaMp", gm.*mp + (gm.*mfp)());
char buf[] = "abc";
char buf8[8] = "ab";
char* bp1 = buf + 1;
const char* lit = &"hello"[1];
int garr[3][2] = {{1, 2}, {3}};
int* inner = &garr[1][1];
int* inner2 = garr[2];
long addrDiff = (long)(inner2 - inner);
int* mem = &gm.y;
int sz = sizeof(garr) / sizeof(garr[0]);
const int ci = 7;
const int* cip = &ci;
enum Col { red = 3, blue };
Col gc = blue;
Col gz;
int unset;
double dset = 1.5 * 2;
float fset = 1.0f / 3;
unsigned char uc = 300;
signed char sc = (signed char)200;
bool gb = 5;
long long ll = 1LL << 40;
const char* const names[] = {"a", "b"};
const char* const* np = &names[1];
struct S { int a; const char* s; int arr[2]; };
S ss[2] = {{1, "x", {1, 2}}, {.a = 2, .arr = {5}}};
union U { int i; char c[4]; float f; };
U gu = {0x01020304};
U gu2 = {.f = 1.0f};
struct Bits { unsigned a : 3; int b : 4; unsigned c : 9; };
Bits gbits = {5, -3, 300};
struct Def { int x = 5; int y = x + 1; const char* p = "d"; int z; };
Def gdef;
Def gdef2 = {.y = 3};
Def gdefArr[2] = {{1}};
constexpr int sq(int x) { return x * x; }
int dependsOnConst = sq(ci);
const double pi2 = 3.14 * 2;
struct Self { Self* me; int v; };
Self self = {&self, 4};
struct Node { Node* next; int v; };
extern Node n2;
Node n1 = {&n2, 1};
Node n2 = {&n1, 2};
int viaNode = say("viaNode", n1.next->v + n1.next->next->v);
int selfRef = selfRef + 1;
int* selfAddr = (int*)&selfAddr;
int sized = sizeof(sized);
int main()
{
  printf("%d %d %d %d\n", viaBase, viaVirtual, viaFn, viaMp);
  printf("%s %s %s %s %d\n", buf, buf8, bp1, lit, (int)sizeof(buf));
  printf("%d %d %d %d %ld %d %d\n", garr[1][0], garr[1][1], garr[2][0], *inner, addrDiff, *mem, sz);
  printf("%d %d %d %d %g %g\n", *cip, gc, gz, unset, dset, (double)fset);
  printf("%d %d %d %lld\n", uc, sc, gb, ll);
  printf("%s %s %d %d %d %d\n", *np, ss[0].s, ss[1].a, ss[1].arr[0], ss[1].arr[1], ss[1].s == nullptr);
  printf("%d %d %d\n", gu.c[0], gu.c[3], gu2.i);
  printf("%d %d %d\n", gbits.a, gbits.b, gbits.c);
  printf("%d %d %s %d %d %d\n", gdef.x, gdef.y, gdef.p, gdef.z, gdef2.x, gdef2.y);
  printf("%d %d %d %d\n", gdefArr[0].x, gdefArr[0].y, gdefArr[1].x, gdefArr[1].y);
  printf("%d %g %d %d %d %d %d %d\n", dependsOnConst, pi2, self.me->v, viaNode, selfRef, selfAddr == (int*)&selfAddr, sized, (int)(sizeof(self)));
  return 0;
}
