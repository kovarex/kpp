
enum { Tag = 'ABCD' };
const int inConstant = 'ab' + 1;
int main()
{
  printf("%d\n", 'ab');
  printf("%d\n", 'abc');
  printf("%d\n", 'abcd');
  printf("%d\n", (int)Tag);
  printf("%d\n", (int)sizeof('ab'));
  printf("%d\n", (int)sizeof('a'));
  printf("%d\n", '\x01\x02');
  printf("%d\n", 'a\n');
  printf("%d\n", '\377\377\377\377');
  printf("%d\n", '\\\'');
  printf("%d\n", 'ab' == 0x6162);
  printf("%d\n", inConstant);
  switch (0x41424344) { case 'ABCD': printf("hit\n"); break; default: printf("miss\n"); }
  return 0;
}
