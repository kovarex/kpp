struct Tr
{
  const char* n;
  Tr(const char* name) : n(name) { printf("ctor %s\n", n); }
  ~Tr() { printf("dtor %s\n", n); }
};
struct Throws
{
  ~Throws() noexcept(false) { printf("throwing\n"); throw 5; }
};
Tr first{"first"};
Throws t;
Tr last{"last"};
int main()
{
  printf("main\n");
  return 0;
}
