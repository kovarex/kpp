// compound assignment, increments, shifts, the conditional operator, comparisons, precedence
int g = 0;
int bump() { return ++g; }
int& ref() { return g; }
int main()
{
  unsigned char x = 200; x += 100; printf("D1 %d\n", x);
  signed char y = 100; y *= 3; printf("D2 %d\n", y);
  unsigned char z = 200; z /= -2; printf("D3 %d\n", z);
  int i = 7; i /= 2.5; printf("D4 %d\n", i);
  int j = 10; j *= 0.55; printf("D5 %d\n", j);
  char ch = 'A'; ch += 1.5; printf("D6 %d\n", ch);
  short sh = 1; sh <<= 20; printf("D8 %d\n", sh);
  unsigned u = 1; u -= 2; printf("D9 %u\n", u);
  unsigned short us2 = 65535; us2++; printf("D10 %d", us2); us2--; printf(" %d\n", us2);
  int k = 5; k %= -3; printf("D11 %d\n", k);
  unsigned uu = 10; uu *= -1; printf("D12 %u\n", uu);
  double dd = 1; dd += double(1 / 3); printf("D13 %.17g\n", dd);
  unsigned char sh2 = 1; sh2 <<= 8; printf("D14 %d", sh2); sh2 = 128; sh2 >>= 1; printf(" %d\n", sh2);
  signed char sc3 = -128; sc3 >>= 1; printf("D15 %d", sc3); sc3 = -128; sc3 /= -1; printf(" %d\n", sc3);
  long long q = 5; q += 0.7; printf("D16 %lld\n", q);
  float fz = 0.1f; fz += 0.2; printf("D17 %.17g\n", (double)fz);
  unsigned char uz = 10; uz -= 20; printf("D18 %d\n", uz);
  short ss = 30000; ss += 30000; printf("D19 %d\n", ss);
  unsigned short sm = 3; sm *= 65535; printf("D20 %d\n", sm);
  int ishift = 1; ishift <<= 33ll % 32; printf("D21 %d\n", ishift);
  unsigned long long big = 1; big <<= 63; printf("D22 %llu\n", big);
  long long sl = -1; sl >>= 60; printf("D23 %lld\n", sl);
  int ia = 17; ia &= 0x0Fu; printf("D24 %d\n", ia);
  int ib = -1; ib ^= 0xFFull; printf("D25 %d\n", ib);
  unsigned char ord = 0x0F; ord |= 0x1F0; printf("D26 %d\n", ord);
  double dmod = 7.5; dmod -= 10u; printf("D27 %.17g\n", dmod);
  int neg = -7; neg /= 2u; printf("D28 %d\n", neg);
  int sum = 0; sum += sum += 1; printf("D29 %d\n", sum);
  int a1 = 5; int r1 = (a1 += 2) * 10; printf("D30 %d %d\n", a1, r1);
  int a2 = 5; (a2 += 2) += 3; printf("D31 %d\n", a2);
  ref() += 5; ref() *= 2; printf("D32 %d\n", g);

  unsigned char e1 = 255; e1++; printf("E1 %d", e1); ++e1; printf(" %d\n", e1);
  int arr[5] = {1, 2, 3, 4, 5};
  printf("E3 %d %d\n", (int)(&arr[4] - &arr[1]), (int)((char*)&arr[4] - (char*)&arr[1]));
  double dinc = 0.5; dinc++; printf("E4 %.17g\n", dinc);
  float finc = 16777216.0f; finc++; printf("E5 %.17g\n", (double)finc);
  signed char sinc = 127; sinc++; printf("E6 %d\n", sinc);
  short sdec = -32768; sdec--; printf("E7 %d\n", sdec);
  int* p = arr; int v1 = *p++; int v2 = *p; printf("E8 %d %d\n", v1, v2);
  ++*p; printf("E9 %d\n", arr[1]);
  int v3 = (*p)++; printf("E10 %d %d\n", v3, arr[1]);
  int* p2 = &arr[4]; int v4 = *--p2; printf("E11 %d\n", v4);
  int cnt = 5; int post = cnt++; int pre = ++cnt; printf("E12 %d %d %d\n", post, pre, cnt);
  int cnt2 = 5; int& rr = ++cnt2; rr = 50; printf("E13 %d\n", cnt2);
  unsigned long long uwrap = 0; uwrap--; printf("E14 %llu\n", uwrap);
  char cinc = 127; cinc++; printf("E15 %d\n", cinc);

  int m8 = -8;
  printf("F1 %d\n", m8 >> 1);
  printf("F2 %u\n", (unsigned)m8 >> 1);
  int one = 1;
  printf("F3 %d\n", one << 31);
  printf("F4 %u\n", 1u << 31);
  printf("F5 %lld\n", 1ll << 40);
  unsigned char u255 = 255;
  printf("F6 %d\n", u255 << 1);
  short sm1 = -1;
  printf("F7 %d\n", sm1 >> 20);
  unsigned short usm = 65535;
  printf("F8 %d\n", usm >> 20);
  long long three = 3;
  printf("F9 %d %d\n", one << three, (int)sizeof(one << three));
  printf("F10 %d %d\n", 5 >> 1u, (int)sizeof(1u << 1ll));
  int mone = -1;
  printf("F11 %d %d\n", mone >> 31, mone >> 0);
  long long llm = -1;
  unsigned long long ullm = (unsigned long long)-1;
  printf("F12 %lld %llu\n", llm >> 63, ullm >> 63);
  unsigned char sh8 = 8;
  printf("F13 %lld\n", 1ll << sh8);
  unsigned uc31 = 31;
  printf("F14 %d\n", -1 << uc31);
  printf("F15 %lld\n", (long long)one << 32);
  printf("F16 %u\n", 0xF0000000u >> 28);
  printf("F17 %d\n", (signed char)-128 >> 1);
  printf("F18 %d\n", (unsigned char)128 << 24 >> 24);

  bool t = true, f = false;
  printf("G1 %.17g\n", t ? 1 : 2.5);
  printf("G2 %u\n", t ? -1 : 1u);
  printf("G3 %d\n", f ? (unsigned char)1 : (signed char)-1);
  printf("G4 %d\n", (int)sizeof(t ? (char)1 : (short)1));
  printf("G5 %d %d\n", t ? 'a' : 0, (int)sizeof(t ? 'a' : 0));
  int ga = 1, gb = 2;
  (t ? ga : gb) = 10;
  (f ? ga : gb) = 20;
  printf("G6 %d %d\n", ga, gb);
  long long gl = t ? 1 : 0x100000000ll;
  printf("G7 %lld\n", gl);
  printf("G8 %d\n", (t ? -1 : 0u) > 0);
  printf("G9 %.17g\n", f ? 1.0f : 0.1);
  printf("G10 %d\n", (int)sizeof(t ? 1.0f : 1));
  printf("G11 %lld\n", f ? 1ll : -1);
  printf("G12 %llu\n", f ? 1ull : -1);
  printf("G13 %d\n", t ? 1 : f ? 2 : 3);
  printf("G14 %d\n", f ? 1 : f ? 2 : 3);
  int gc = 0;
  t ? gc = 5 : gc = 6;
  printf("G15 %d\n", gc);
  f ? gc = 5 : gc = 6;
  printf("G16 %d\n", gc);
  int& gr = t ? ga : gb;
  gr = 99;
  printf("G17 %d\n", ga);
  printf("G18 %d\n", (t ? ga : gb)++);
  printf("G19 %d\n", ga);
  unsigned short gus = 65535;
  printf("G20 %d\n", (t ? gus : (unsigned short)0) + 1);
  char gch = 'x';
  printf("G21 %d\n", (int)sizeof(t ? gch : gch));

  printf("H1 %d\n", -1 < 0u);
  printf("H2 %d\n", (long long)-1 < 0u);
  printf("H3 %d\n", -1 < 0ull);
  char c200 = (char)200;
  printf("H4 %d\n", c200 < 0);
  printf("H5 %d\n", 0.1f == 0.1);
  int i17 = 16777217;
  printf("H6 %d\n", i17 == 16777217.0f);
  long long l53 = 9007199254740993;
  printf("H7 %d\n", l53 == 9007199254740992.0);
  double zero = 0.0;
  double nan = zero / zero;
  printf("H8 %d %d %d %d %d\n", nan == nan, nan != nan, nan < 1, !(nan >= 1), nan > nan);
  printf("H9 %d\n", -zero == zero);
  unsigned char u8max = 255;
  printf("H11 %d\n", u8max == -1);
  printf("H12 %d\n", (unsigned)255 == (unsigned char)-1);
  printf("H13 %d\n", nan ? 1 : 0);
  printf("H14 %d\n", !nan);
  printf("H15 %d\n", (bool)nan);
  printf("H16 %d %d\n", nan <= nan, nan >= nan);
  float fnan = (float)nan;
  printf("H17 %d %d\n", fnan == fnan, fnan != fnan);
  printf("H18 %d\n", 1.0 / zero > 1e308);
  printf("H19 %d\n", -1.0 / zero < -1e308);
  unsigned long long u64max = (unsigned long long)-1;
  printf("H20 %d\n", u64max == (double)u64max);
  printf("H21 %d\n", (float)16777217 == (double)16777216);

  int a = 6, b = 3, c = 2;
  printf("L1 %d\n", a & b == 3);
  printf("L2 %d\n", a << b + c);
  printf("L3 %d %d\n", -a % b, -7 % 3);
  printf("L4 %d\n", !a == 0);
  printf("L5 %d\n", a ? b : c ? 9 : 10);
  printf("L6 %d\n", a - b - c);
  printf("L7 %d\n", a / b * c);
  printf("L9 %d\n", a | b ^ c & 1);
  printf("L10 %d\n", a < b == c < b);
  printf("L12 %d\n", ~a + 1);
  printf("L14 %d\n", (a, b));
  printf("L15 %d\n", a > b ? a : b + 100);
  printf("L16 %d\n", a && b || 0 && c);
  printf("L17 %d\n", (int)(sizeof a + 1));
  printf("L18 %d\n", -a * -b);
  printf("L20 %d\n", a >> 1 << 1);
  printf("L21 %d\n", (unsigned)a >> 1 > 2);
  printf("L22 %d\n", a & 1 ? 10 : 20);
  printf("L23 %d\n", (a == b) != c);
  printf("L24 %d\n", a - -b);
  printf("L25 %d\n", a+++b);
  printf("L26 %d %d\n", a, b);
  printf("L27 %d\n", a-- - --b);
  printf("L28 %d %d\n", a, b);
  printf("L29 %d\n", !!a + !b);
  printf("L30 %d\n", a % b * c % 5);
  printf("L31 %d\n", c = a > b);
  printf("L32 %d\n", a = b = c);
  printf("L33 %d %d %d\n", a, b, c);
  a = 6; b = 3;
  a += b *= 2;
  printf("L34 %d %d\n", a, b);
  printf("L35 %d\n", a ^ b | c);
  printf("L36 %d\n", ~0u >> 1 == 0x7FFFFFFF);
  printf("L37 %d\n", 1 + 2 * 3 << 1);
  printf("L38 %d\n", 10 - 2 - 3 * 2 % 4);
  printf("L39 %d\n", -2 * -3 / 4);
  printf("L40 %d\n", 2 + 3 > 4 && 1 | 2 == 2);
  printf("L41 %d\n", bump() + bump() * 10);
  printf("L42 %d\n", (bump(), bump()));
  int la = 1;
  int lb = la++ + 1;
  printf("L43 %d %d\n", la, lb);
  int lc = 0;
  lc || bump();
  [[maybe_unused]] bool unused = lc && bump();
  printf("L44 %d\n", g);
  return 0;
}
