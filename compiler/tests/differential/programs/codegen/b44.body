// More structured binding captures: in a template, a generic lambda, a range-for's bindings, a
// reference member, a class-type binding copied into the closure and destroyed with it.
struct P
{
  int a;
  int b;
};

int live = 0;
struct Tracked
{
  int id;
  Tracked(int i) : id(i) { ++live; }
  Tracked(const Tracked& o) : id(o.id) { ++live; }
  ~Tracked() { --live; }
};
struct Holder
{
  Tracked t;
  int n;
};

struct Ref
{
  int& r;
  int v;
};

template<class T>
int fromTemplate(T value)
{
  auto [first, second] = value;
  auto f = [first, &second](int k) { return first * k + second; };
  second = 100;
  return f(2);
}

int main()
{
  printf("%d\n", fromTemplate(P{3, 4}));
  auto [x, y] = P{5, 6};
  auto generic = [x, &y](auto k) { return x * k + y; };
  y = 7;
  printf("%d %d\n", generic(2), (int)generic(3.0));
  P items[3] = {{1, 2}, {3, 4}, {5, 6}};
  int sum = 0;
  for (auto& [a, b] : items)
  {
    auto add = [a, &b, &sum] { b += 10; sum += a + b; };
    add();
  }
  printf("%d %d %d %d\n", sum, items[0].b, items[1].b, items[2].b);
  int target = 1;
  auto [r, v] = Ref{target, 2};
  auto fr = [r, &v] { return r * 10 + v; };
  target = 9;
  v = 3;
  printf("%d\n", fr());
  {
    auto [t, n] = Holder{Tracked(4), 5};
    printf("live %d\n", live);
    {
      auto keep = [t, n] { return t.id * 10 + n; };
      printf("live %d %d\n", live, keep());
      auto copy = keep;
      printf("live %d %d\n", live, copy());
    }
    printf("live %d\n", live);
  }
  printf("live %d\n", live);
  auto all = [=] { return x + y; };
  auto allRef = [&] { return x * y; };
  y = 8;
  printf("%d %d\n", all(), allRef());
  return 0;
}
