// Lambdas capturing structured bindings (C++20): each binding on its own, by copy its value, by
// reference its place, whatever the other bindings of its object are captured as.
struct P
{
  int a;
  int b;
};

int copies = 0;
struct Noisy
{
  int id;
  Noisy(int i) : id(i) {}
  Noisy(const Noisy& o) : id(o.id) { ++copies; }
};
struct WithNoisy
{
  Noisy n;
  int k;
};

struct Bits
{
  unsigned a : 3;
  unsigned b : 5;
};

int main()
{
  auto [x, y] = P{3, 4};
  auto f = [x, &y] { return x * 10 + y; };
  y = 9;
  printf("%d\n", f());
  auto g = [=, &y] { return x * 100 + y; };
  y = 5;
  printf("%d\n", g());
  auto h = [&, x] { return x * 1000 + y; };
  y = 6;
  printf("%d\n", h());
  auto [n, k] = WithNoisy{Noisy(7), 8};
  copies = 0;
  auto onlyK = [k] { return k; };
  printf("%d %d\n", onlyK(), copies);
  auto both = [n, k] { return n.id * 10 + k; };
  printf("%d %d\n", both(), copies);
  int arr[2] = {1, 2};
  auto [a0, a1] = arr;
  auto fa = [a0, &a1] { return a0 * 10 + a1; };
  a1 = 7;
  printf("%d\n", fa());
  P p{1, 2};
  auto& [rx, ry] = p;
  auto fr = [rx, &ry] { return rx * 10 + ry; };
  p.a = 50;
  p.b = 60;
  printf("%d\n", fr());
  auto outer = [&] { return [x] { return x; }() + y; };
  printf("%d\n", outer());
  auto m = [x]() mutable { x += 1; return x; };
  int m1 = m();
  int m2 = m();
  printf("%d %d %d\n", m1, m2, x);
  auto [ba, bb] = Bits{5, 17};
  auto fb = [ba, bb] { return ba * 100 + bb; };
  printf("%d\n", (int)fb());
  return 0;
}
