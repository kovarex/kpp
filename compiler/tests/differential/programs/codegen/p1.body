// integer promotions, usual arithmetic conversions, conversions, literal types
int main()
{
  unsigned char uc = 200;
  signed char sc = -56;
  char c = -1;
  unsigned short us = 65535;
  short s = -32768;
  printf("A1 %d\n", uc + uc);
  printf("A2 %d\n", uc == sc);
  printf("A3 %d\n", ~uc);
  printf("A4 %d\n", -uc);
  printf("A5 %d\n", us + 1);
  printf("A6 %d\n", us * 2);
  printf("A7 %d\n", (unsigned short)(us + 1));
  printf("A8 %d\n", s - 1);
  printf("A9 %d %d\n", c + 0, (unsigned char)c);
  printf("A10 %d\n", uc << 24);
  printf("A11 %d %d %d %d %d\n", (int)sizeof(uc + uc), (int)sizeof(+uc), (int)sizeof(c), (int)sizeof(uc + 1L), (int)sizeof(us + 1u));
  printf("A12 %d\n", ~(unsigned short)1);
  printf("A13 %d\n", (unsigned char)~uc);
  printf("A14 %d\n", sc * sc);
  printf("A15 %d\n", (signed char)(sc * 3));
  printf("A16 %d\n", uc > sc);
  printf("A17 %d\n", -us);
  printf("A18 %u\n", -(unsigned)us);

  int m1 = -1;
  unsigned u1 = 1;
  printf("B1 %d\n", m1 < u1);
  printf("B2 %d\n", m1 == 0xFFFFFFFF);
  printf("B3 %u\n", 0xFFFFFFFF + 1);
  printf("B4 %d %d %d %d\n", (int)sizeof(0xFFFFFFFF), (int)sizeof(4294967296), (int)sizeof(2147483648), (int)sizeof(0x80000000));
  printf("B5 %lld\n", -2147483648);
  printf("B6 %u\n", 0x80000000 + 0);
  printf("B7 %d\n", us + m1);
  printf("B8 %lld\n", u1 + (long long)-2);
  printf("B9 %llu\n", 1ull + -2ll);
  printf("B10 %u\n", 1u + -2L);
  printf("B11 %u\n", -7 / 2u);
  printf("B12 %u\n", -7 % 2u);
  printf("B13 %d %d %d %d\n", -7 / 2, -7 % 2, 7 / -2, 7 % -2);
  printf("B14 %d\n", (unsigned char)200 / (signed char)-2);
  printf("B15 %llu\n", 10ull / -1);
  printf("B16 %lld\n", -7ll % 2u);
  printf("B17 %d %d %d\n", (unsigned short)65535 < -1, (unsigned)0 > -1, (unsigned long long)0 < -1);
  printf("B18 %d\n", (int)sizeof(1u + 1L));
  printf("B19 %llu\n", (unsigned long long)(1u + -2L));
  printf("B20 %lld\n", 3000000000u * 2ll);
  printf("B21 %u\n", 3000000000u * 2);

  int i32 = -1;
  long long ll = i32;
  unsigned long long ull = i32;
  printf("C1 %lld %llu\n", ll, ull);
  unsigned u4 = 4000000000u;
  unsigned long long ull2 = u4;
  long long ll2 = u4;
  printf("C2 %llu %lld\n", ull2, ll2);
  long long wide = 0x1234567890;
  int narrow = (int)wide;
  printf("C4 %d\n", narrow);
  signed char sc2 = (signed char)200;
  unsigned char uc2 = (unsigned char)-1;
  short s2 = (short)40000;
  printf("C5 %d %d %d\n", sc2, uc2, s2);
  int b256 = 256;
  double half = 0.5;
  double negzero = -0.0;
  long long high = 0x100000000ll;
  bool b1 = b256;
  bool b2 = half;
  bool b3 = negzero;
  bool b5 = high;
  bool b6 = (bool)high;
  bool b7 = !!high;
  printf("C6 %d %d %d %d %d %d\n", b1, b2, b3, b5, b6, b7);
  double d399 = 3.99, dn399 = -3.99;
  int fromd = (int)d399;
  int fromneg = (int)dn399;
  printf("C7 %d %d\n", fromd, fromneg);
  double d39e9 = 3.9e9;
  unsigned ud = (unsigned)d39e9;
  printf("C8 %u\n", ud);
  double d18e19 = 1.8e19;
  unsigned long long ulld = (unsigned long long)d18e19;
  printf("C9 %llu\n", ulld);
  unsigned long long umax = 18446744073709551615ull;
  double dull = (double)umax;
  printf("C10 %.17g\n", dull);
  double du = u4;
  printf("C11 %.17g\n", du);
  int i16777217 = 16777217;
  float f = (float)i16777217;
  printf("C12 %.17g\n", (double)f);
  double point1 = 0.1;
  float f2 = (float)point1;
  double d2 = f2;
  printf("C13 %.17g\n", d2);
  long long big = 9007199254740993;
  double dbig = (double)big;
  printf("C14 %.17g\n", dbig);
  double d2559 = 255.9;
  unsigned char ucd = (unsigned char)d2559;
  printf("C15 %d\n", ucd);
  char cc = 'a' + 1;
  printf("C16 %d\n", cc);
  float fa = 16777216.0f;
  printf("C17 %.17g\n", (double)(fa + 1.0f));
  float fb = 0.1f;
  printf("C18 %.17g\n", (double)(fb * 3));
  printf("C19 %.17g %.17g\n", 7 / 2.0, 7 / 2 * 1.0);
  printf("C20 %.17g\n", (double)(1 << 31));
  float fc = 0.1f;
  double viaFloat = fc + 0.2;
  printf("C21 %.17g\n", viaFloat);
  float fd = 1e30f;
  printf("C22 %.17g\n", (double)(fd * fd));
  double dm = -1.5;
  unsigned long long fromNegative = (unsigned long long)(long long)dm;
  printf("C23 %llu\n", fromNegative);
  int intMin = -2147483647 - 1;
  double dIntMin = intMin;
  printf("C24 %.17g\n", dIntMin);
  unsigned long long u63 = 9223372036854775808ull;
  double d63 = (double)u63;
  printf("C25 %.17g\n", d63);
  unsigned long long u63b = (unsigned long long)d63;
  printf("C26 %llu\n", u63b);
  float f63 = (float)u63;
  printf("C27 %.17g\n", (double)f63);
  unsigned long long odd = 18446744073709550591ull;
  printf("C28 %.17g\n", (double)odd);
  float fodd = (float)odd;
  printf("C29 %.17g\n", (double)fodd);
  unsigned u31 = 2147483649u;
  float fu31 = (float)u31;
  printf("C30 %.17g\n", (double)fu31);

  printf("K1 %d %d\n", (int)sizeof(2147483647), (int)sizeof(2147483648));
  printf("K2 %d %d %d\n", (int)sizeof(0x7FFFFFFF), (int)sizeof(0x80000000), (int)sizeof(0x100000000));
  printf("K3 %d %u %d\n", 0x80000000 > 0, -0x80000000, -0x80000000 > 0);
  printf("K4 %d %d\n", -2147483648 > 0, (int)sizeof(-2147483648));
  printf("K5 %d\n", -1 == 0xFFFFFFFFFFFFFFFF);
  printf("K7 %d\n", 1'000'000);
  printf("K8 %d %d %.17g\n", 0b1010, 017, 0x1p3);
  printf("K9 %.17g %.17g\n", 1e3, (double)1.5f);
  printf("K11 %d\n", 07 + 010);
  printf("K12 %d %d %d %d %d\n", (int)sizeof(1u), (int)sizeof(1ul), (int)sizeof(1ll), (int)sizeof(1.0f), (int)sizeof(1.0));
  printf("K13 %d %d\n", (int)sizeof(0xFFFFFFFFu), (int)sizeof(0x7FFFFFFFFFFFFFFF));
  printf("K14 %u\n", 0xFFFFFFFFu + 1);
  printf("K15 %lld\n", 0x7FFFFFFFFFFFFFFF);
  printf("K16 %d %d %d\n", 'a', '\xff', '\377');
  printf("K17 %d %d\n", (int)sizeof('a'), '\0' + 1);
  printf("K18 %d\n", (int)sizeof(0x80000000 + 1));
  printf("K19 %u\n", 0x80000000 << 1);
  printf("K20 %llu\n", 0xFFFFFFFF + 1ull);
  printf("K21 %lld\n", 0xFFFFFFFF + 1ll);
  printf("K22 %d\n", 0xFFFF + 1);
  printf("K23 %.17g %.17g\n", 0.1f + 0.0, (double)1e-45f);
  return 0;
}
