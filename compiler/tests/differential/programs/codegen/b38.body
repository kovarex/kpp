// battery 38: the same functions evaluated at compile time (constexpr variables) and at run time
// (through a volatile input), which must agree with each other and with clang: integer wrap of
// unsigned arithmetic, signed division and remainder, shifts, conversions between widths and to
// and from floating values, char arithmetic, bit-field-free struct work, loops, recursion,
// arrays and ternaries.
constexpr unsigned mix(unsigned x)
{
  for (int i = 0; i < 5; ++i)
    x = x * 2654435761u + (x >> 13) ^ (x << 7);
  return x;
}
constexpr long long divs(long long a, long long b) { return a / b * 1000 + a % b; }
constexpr int narrow(long long v) { return (int)(signed char)v + (int)(unsigned short)v; }
constexpr double toDouble(long long v) { return (double)v / 3.0; }
constexpr long long fromDouble(double d) { return (long long)(d * 1000.0); }
constexpr int fib(int n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }
struct Point
{
  int x, y;
};
constexpr Point reflect(Point p, int axis) { return axis ? Point{-p.x, p.y} : Point{p.x, -p.y}; }
constexpr int sumArray()
{
  int values[6] = {3, -1, 4, -1, 5, -9};
  int s = 0;
  for (int v : values)
    s = s * 3 + v;
  return s;
}
constexpr int chars(char c) { return (c + 200) % 256 + (unsigned char)(c * 3); }

int main()
{
  volatile int seed = 1;
  constexpr unsigned cm = mix(12345);
  unsigned rm = mix(12345 * seed);
  constexpr long long cd1 = divs(-7, 2), cd2 = divs(7, -3), cd3 = divs(-922337203685477LL, 10);
  long long rd1 = divs(-7 * seed, 2), rd2 = divs(7, -3 * seed), rd3 = divs(-922337203685477LL * seed, 10);
  printf("mix %u %u\n", cm, rm);
  printf("divs %lld %lld %lld | %lld %lld %lld\n", cd1, cd2, cd3, rd1, rd2, rd3);
  constexpr int cn = narrow(0x12345FFLL);
  int rn = narrow(0x12345FFLL * seed);
  constexpr double cdbl = toDouble(10);
  double rdbl = toDouble(10 * seed);
  constexpr long long cfd = fromDouble(-2.71828);
  long long rfd = fromDouble(-2.71828 * seed);
  printf("narrow %d %d dbl %.17g %.17g fd %lld %lld\n", cn, rn, cdbl, rdbl, cfd, rfd);
  constexpr int cf = fib(20);
  int rf = fib(20 * seed);
  constexpr Point cp = reflect(Point{3, 4}, 1);
  Point rp = reflect(Point{3, 4}, seed);
  constexpr int cs = sumArray();
  int rs = sumArray() * seed;
  constexpr int cc = chars('z');
  int rc = chars((char)('z' * seed));
  printf("fib %d %d point %d %d %d %d sum %d %d chars %d %d\n", cf, rf, cp.x, cp.y, rp.x, rp.y, cs, rs, cc, rc);
  return 0;
}
