// Multiple inheritance: virtual calls through each base, overrides of the second base's functions,
// calls from a base's member function, deletion through the second base, cross casts, and arrays.
int destroyed = 0;
class A
{
public:
  int a = 1;
  virtual ~A() { destroyed += 1; }
  virtual int fa() { return 10 + a; }
  int callFa() { return fa(); }
};
class B
{
public:
  int b = 2;
  virtual ~B() { destroyed += 100; }
  virtual int fb() { return 20 + b; }
  virtual int both() { return 200; }
  int callFb() { return fb() + both(); }
};
class C : public A, public B
{
public:
  int c = 3;
  ~C() override { destroyed += 10000; }
  int fa() override { return 30 + a + c; }
  int fb() override { return 40 + b + c; }
  int both() override { return 300 + c; }
};
class D : public C
{
public:
  int d = 4;
  int fb() override { return 50 + d; }
};

int viaB(B& r) { return r.fb() * 1000 + r.both(); }
int viaA(A* p) { return p->fa(); }

int main()
{
  C c;
  D d;
  printf("%d %d %d %d\n", viaA(&c), viaB(c), viaA(&d), viaB(d));
  printf("%d %d %d %d\n", c.callFa(), c.callFb(), d.callFa(), d.callFb());
  B* pb = &d;
  A* pa = &d;
  printf("%d %d\n", pb->fb(), pa->fa());
  A* cross = dynamic_cast<A*>(pb);
  B* back = dynamic_cast<B*>(pa);
  printf("%d %d %d\n", cross == pa ? 1 : 0, back == pb ? 1 : 0, (int)((char*)pb - (char*)pa));
  destroyed = 0;
  B* heap = new D();
  printf("%d\n", heap->fb());
  delete heap;
  printf("destroyed %d\n", destroyed);
  destroyed = 0;
  A* heapA = new C();
  delete heapA;
  printf("destroyed %d\n", destroyed);
  destroyed = 0;
  {
    C array[2];
    B* inArray = &array[1];
    printf("%d\n", inArray->both());
  }
  printf("destroyed %d\n", destroyed);
  return 0;
}
