// references, const and ref-qualified overloads, auto, decltype, structured bindings, value categories
struct T { int id; T(int i = 0) : id(i) {} T(const T& o) : id(o.id + 1000) {} T(T&& o) : id(o.id + 2000) { o.id = -1; } };
const char* who(int&) { return "int&"; }
const char* who(const int&) { return "const int&"; }
const char* who(int&&) { return "int&&"; }
const char* who(const int&&) { return "const int&&"; }
const char* cv(int*) { return "int*"; }
const char* cv(const int*) { return "const int*"; }
struct R { int v = 1; const char* f() & { return "&"; } const char* f() const& { return "const&"; } const char* f() && { return "&&"; } const char* f() const&& { return "const&&"; } const char* g() { return "plain"; } const char* g() const { return "const"; } int& ref() & { return v; } int ref() && { return v * 2; } };
R makeR() { return R(); }
const R makeC() { return R(); }
int& refTo(int& x) { return x; }
const int& pick(const int& a, const int& b) { return a < b ? a : b; }
int&& rv(int& x) { return static_cast<int&&>(x); }
struct M { int a = 1; mutable int b = 2; int* p; int& r; const int c = 3; void set() const { b = 5; *p = 6; r = 7; } };
struct PairT { int a; double b; };
struct Tup { int x; int y; int z; };
PairT makeP() { return PairT{ 1, 2.5 }; }
template<class T> struct IsRef { static constexpr bool v = false; }; template<class T> struct IsRef<T&> { static constexpr bool v = true; };
template<class T> const char* cat(T&&) { return IsRef<T>::v ? "lvalue" : "rvalue"; }
template<class T> struct Name { static const char* n() { return "other"; } };
template<> struct Name<int> { static const char* n() { return "int"; } };
template<> struct Name<int&> { static const char* n() { return "int&"; } };
template<> struct Name<int&&> { static const char* n() { return "int&&"; } };
template<> struct Name<const int> { static const char* n() { return "const int"; } };
template<> struct Name<const int&> { static const char* n() { return "const int&"; } };
template<> struct Name<int*> { static const char* n() { return "int*"; } };
template<> struct Name<const int*> { static const char* n() { return "const int*"; } };
template<> struct Name<int[3]> { static const char* n() { return "int[3]"; } };
template<> struct Name<double> { static const char* n() { return "double"; } };
decltype(auto) passRef(int& x) { return x; }
decltype(auto) passParen(int& x) { return (x); }
auto passVal(int& x) { return x; }
auto& passAmp(int& x) { return x; }
int gv = 5;
decltype(auto) global() { return (gv); }
int main()
{
  int i = 1; const int c = 2; int& r = i; const int& cr = i; int&& rr = 3;
  printf("%s %s %s %s %s %s %s\n", who(i), who(c), who(r), who(cr), who(rr), who(4), who(static_cast<int&&>(i)));
  printf("%s %s\n", who(static_cast<const int&&>(i)), who(i + 1));
  printf("%s %s\n", cv(&i), cv(&c));
  R a; const R b; printf("%s %s %s %s %s\n", a.f(), b.f(), makeR().f(), makeC().f(), static_cast<R&&>(a).f());
  printf("%s %s\n", a.g(), b.g());
  a.ref() = 4; printf("%d %d\n", a.v, makeR().ref());
  refTo(i) = 8; printf("%d\n", i);
  const int& lit = 5; const double& conv = i; i = 9; printf("%d %.1f\n", lit, conv);
  const long long& widen = c; printf("%lld\n", widen);
  int x1 = 1, x2 = 2; int m = pick(x1, x2); printf("%d\n", m);
  int& ra = x1; int* pr = &ra; *pr = 7; printf("%d\n", x1);
  int*& rp = pr; rp = &x2; printf("%d\n", *pr);
  int arr[3] = { 1, 2, 3 }; int (&ar)[3] = arr; ar[1] = 9; printf("%d %d\n", arr[1], (int)sizeof(ar));
  int k = 1, l = 2; M mm{ 1, 2, &k, l }; mm.set(); printf("%d %d %d\n", mm.b, k, l);
  auto v1 = c; v1 = 3; const auto v2 = i; auto& v3 = c; auto&& v4 = i; auto&& v5 = 3; auto* v6 = &i; const auto* v7 = &i; auto v8 = cr; auto v9 = arr; auto& v10 = arr;
  printf("%s %s %s %s %s %s %s %s %s %s\n", Name<decltype(v1)>::n(), Name<decltype(v2)>::n(), Name<decltype(v3)>::n(), Name<decltype(v4)>::n(), Name<decltype(v5)>::n(), Name<decltype(v6)>::n(), Name<decltype(v7)>::n(), Name<decltype(v8)>::n(), Name<decltype(v9)>::n(), (int)sizeof(v10) == 12 ? "int(&)[3]" : "other");
  printf("%s %s %s %s %s %s %s %s\n", Name<decltype(i)>::n(), Name<decltype((i))>::n(), Name<decltype(r)>::n(), Name<decltype(rr)>::n(), Name<decltype(c)>::n(), Name<decltype(i + 1)>::n(), Name<decltype(static_cast<int&&>(i))>::n(), Name<decltype(1.5)>::n());
  printf("%s %s %s %s\n", Name<decltype(passRef(i))>::n(), Name<decltype(passParen(i))>::n(), Name<decltype(passVal(i))>::n(), Name<decltype(passAmp(i))>::n());
  global() = 6; printf("%d\n", gv);
  printf("%s %s %s\n", Name<decltype(arr[0])>::n(), Name<decltype(*&i)>::n(), Name<decltype(i++)>::n());
  PairT p = makeP(); auto [pa, pb] = p; pa = 9; printf("%d %d %.1f\n", p.a, pa, pb);
  auto& [qa, qb] = p; qa = 8; printf("%d\n", p.a);
  const auto& [ra2, rb2] = makeP(); printf("%d %.1f\n", ra2, rb2);
  auto&& [sa, sb] = p; sb = 1.5; printf("%.1f\n", p.b);
  int tri[3] = { 1, 2, 3 }; auto [t0, t1, t2] = tri; auto& [u0, u1, u2] = tri; u1 = 7; printf("%d %d\n", t1, tri[1]);
  Tup tp{ 1, 2, 3 }; auto [ta, tb, tc] = tp; printf("%d\n", ta + tb + tc);
  Tup tv[2] = { { 1, 2, 3 }, { 4, 5, 6 } }; int tot = 0; for (auto& [e0, e1, e2] : tv) { e1 = 0; tot += e0 + e2; } printf("%d %d\n", tot, tv[1].y);
  T t1a(1); T t2a = t1a; T t3 = static_cast<T&&>(t1a); printf("%d %d %d\n", t1a.id, t2a.id, t3.id);
  T arrT[2] = { T(1), T(2) }; T& first = arrT[0]; T cp = first; printf("%d\n", cp.id);
  const T ct(5); T fromConst = static_cast<const T&&>(ct); printf("%d\n", fromConst.id);
  printf("%s %s\n", cat(i), cat(1));
  bool bb = true; bool& rb = bb; rb = false; printf("%d\n", bb);
  float f = 1.5f; const double& fd = f; f = 2.5f; printf("%.1f\n", fd);
  char ch = 'a'; const int& ci = ch; ch = 'b'; printf("%c\n", ci);
  unsigned u = 4000000000u; const int& si = u; printf("%d\n", si);
  return 0;
}
