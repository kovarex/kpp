// arrays, pointers, sizeof, string literals, characters, aggregates with arrays
struct P { int x; int y; };
struct Q { char c; P p[2]; short s; };
struct Str { char a[4]; char b[3]; };
int sum(int a[], int n) { int t = 0; for (int i = 0; i < n; i++) t += a[i]; return t; }
int sum2(int (*a)[3], int n) { int t = 0; for (int i = 0; i < n; i++) t += a[i][1]; return t; }
int sum3(int (&a)[4]) { return a[0] + a[3] + (int)sizeof(a); }
int size1(int a[10]) { return (int)sizeof(a); }
int size2(const char* s) { return (int)sizeof(s); }
int* ptr(int* p, int k) { return p + k; }
int (*rowOf(int (*m)[3], int i))[3] { return m + i; }
const char* names[] = { "zero", "one", "two" };
const char* const fixedNames[2] = { "a", "b" };
char grid[2][4] = { "abc", "de" };
int table[][3] = { { 1, 2, 3 }, { 4 }, { 5, 6 } };
int sparse[6] = { 1, 2 };
char raw[] = "hi\0there";
char sized[10] = "abc";
unsigned char ub[] = { 200, 100 };
wchar_t wide[] = L"wide";
char16_t c16[] = u"sixteen";
char32_t c32[] = U"thirtytwo";
const char* cat = "abc" "def" "\x41" "\101";
const char* raws = R"(a"b\n)";
const char* rawd = R"x(a)b)x";
int main()
{
  int a[4] = { 1, 2, 3, 4 }; int m[2][3] = { { 1, 2, 3 }, { 4, 5, 6 } };
  printf("%d %d %d %d\n", sum(a, 4), sum2(m, 2), sum3(a), size1(a));
  printf("%d %d %d %d %d %d\n", (int)sizeof(a), (int)sizeof(a[0]), (int)sizeof(m), (int)sizeof(m[0]), (int)sizeof(*m), (int)sizeof(&a));
  printf("%d %d %d %d %d\n", (int)(&a[3] - &a[0]), (int)(&a[0] - &a[3]), *(a + 2), a[2], *ptr(a, 3));
  printf("%d %d %d %d\n", (*(m + 1))[2], *(*(m + 1) + 1), m[1][-1], (*rowOf(m, 1))[0]);
  int* p = a; p += 2; p++; printf("%d ", *p); p--; printf("%d ", *p--); printf("%d ", *p); printf("%d\n", *++p);
  int (*pa)[4] = &a; printf("%d %d\n", (*pa)[1], (int)sizeof(*pa));
  printf("%d %d\n", (int)((char*)(pa + 1) - (char*)pa), (int)((char*)(&a + 1) - (char*)&a));
  printf("%d %d %d\n", p == &a[2], p < &a[3], &a[3] > p);
  void* vp = a; int* back = (int*)vp; printf("%d\n", back[1]);
  const int* cp = a; int* const pc = a; *pc = 10; printf("%d %d\n", *cp, a[0]);
  int* pp[2] = { &a[1], &a[2] }; int** ppp = pp; printf("%d %d %d\n", *pp[1], **ppp, *ppp[1]);
  printf("%s %s %d %d\n", names[1], fixedNames[1], (int)(sizeof(names) / sizeof(names[0])), (int)sizeof(fixedNames));
  printf("%s %s %c %d %d\n", grid[0], grid[1], grid[1][1], (int)grid[1][3], (int)sizeof(grid));
  printf("%d %d %d %d %d %d\n", table[1][0], table[1][2], table[2][1], (int)(sizeof(table) / sizeof(table[0])), sparse[1], sparse[5]);
  printf("%d %d %d %s\n", (int)sizeof(raw), (int)raw[2], (int)raw[3], raw + 3);
  printf("%d %d %d %d\n", (int)sizeof(sized), (int)sized[3], (int)sized[9], (int)sizeof(ub));
  printf("%d %d %d %d %d\n", (int)sizeof(wide), (int)wide[1], (int)sizeof(c16), (int)c16[1], (int)c32[2]);
  printf("%s %s %s %d %d\n", cat, raws, rawd, (int)sizeof("abc" "def"), (int)sizeof(R"(x)"));
  printf("%d %d %d %d %d %d\n", 'a', '\n', '\0', '\x7f', '\177', '\\');
  printf("%d %d %d %d\n", '\xff', (unsigned char)'\xff', (int)sizeof('a'), (int)sizeof(L'a'));
  printf("%d %d %d %d\n", "abc"[1], *"xyz", (&"abc"[1])[1], (int)sizeof("") );
  Q q = { 'x', { { 1, 2 }, { 3, 4 } }, 5 }; Q r = { 'y', 1, 2, 3, 4, 6 }; printf("%d %d %d %d\n", q.p[1].x, r.p[1].y, r.s, (int)sizeof(Q));
  Str s = { "abc", "de" }; printf("%s %s %d\n", s.a, s.b, (int)sizeof(s));
  Str s2 = { { 'a' }, "x" }; printf("%d %d\n", (int)s2.a[1], (int)s2.b[1]);
  P ps[3] = { { 1, 2 }, { 3 } }; printf("%d %d %d\n", ps[1].x, ps[1].y, ps[2].y);
  P ps2[] = { 1, 2, 3, 4, 5 }; printf("%d %d\n", (int)(sizeof(ps2) / sizeof(P)), ps2[2].y);
  int z[3] = {}; int y[3] = { 0 }; int w[2][2] = {}; printf("%d %d %d\n", z[2], y[2], w[1][1]);
  int v[3]{ 1, 2, 3 }; int* nw = new int[3]{ 1, 2 }; printf("%d %d\n", v[2], nw[2]); delete[] nw;
  int* nz = new int[4](); printf("%d\n", nz[3]); delete[] nz;
  int (*nm)[3] = new int[2][3]; nm[1][2] = 8; printf("%d\n", nm[1][2]); delete[] nm;
  P* np = new P{ 1, 2 }; printf("%d\n", np->y); delete np;
  auto ar = a; auto& rr = a; decltype(a) cp2 = { 9 }; printf("%d %d %d\n", (int)sizeof(ar), (int)sizeof(rr), (int)sizeof(cp2));
  char buf[8]; buf[0] = 'a'; buf[1] = 0; const char* lit = "abc"; const char* same = lit; printf("%d\n", same == lit);
  bool bb[3] = { true }; printf("%d %d %d\n", bb[0], bb[1], (int)sizeof(bb));
  long long ll[2] = { 1, -1 }; unsigned short us[2] = { 65535, 1 }; float fl[2] = { 1.5f }; double dl[2] = { 2.5 }; printf("%lld %d %.1f %.1f\n", ll[1], us[0], fl[1], dl[0]);
  int i = 2; int arr2[3] = { i, i * 2, i * 3 }; printf("%d\n", arr2[2]);
  int n = 0; int seq[3] = { n++, n++, n++ }; printf("%d %d %d\n", seq[0], seq[1], seq[2]);
  return 0;
}
