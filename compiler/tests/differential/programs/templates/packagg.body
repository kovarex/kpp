struct Bits { unsigned a : 3; unsigned b : 5; int c; };
struct Q { int v; Q() : v(42) {} };
struct Left { int x; int y; int z = 7; Q q; };
struct Base { int b; };
struct Der : Base { int d; int e = 9; };
struct RefHolder { int& r; int v; };
struct Gap { int a : 3; int : 2; int b : 3; int c; };
template<class T, class... A> T make(A... v) { return T{v...}; }
template<class T, class... A> T makeRef(A&&... v) { return T{static_cast<A&&>(v)...}; }
int main()
{
  Bits s1 = make<Bits>(1u, 2u);
  printf("%u %u %d\n", s1.a, s1.b, s1.c);
  Bits s2 = make<Bits>(1u, 2u, 3);
  printf("%u %u %d\n", s2.a, s2.b, s2.c);
  Bits s3 = make<Bits>(9u, 33u, -4);
  printf("%u %u %d\n", s3.a, s3.b, s3.c);
  Left l = make<Left>(1, 2);
  printf("%d %d %d %d\n", l.x, l.y, l.z, l.q.v);
  Der d = make<Der>(Base{5}, 6);
  printf("%d %d %d\n", d.b, d.d, d.e);
  int i = 11;
  RefHolder h = makeRef<RefHolder>(i, 3);
  i = 12;
  printf("%d %d\n", h.r, h.v);
  Gap g1 = make<Gap>(1, 2, 3);
  printf("%d %d %d\n", g1.a, g1.b, g1.c);
  Gap g2{1, 2, 3};
  printf("%d %d %d\n", g2.a, g2.b, g2.c);
  return 0;
}
