// A destructor's exception specification: implicit, written without one, what the operator says
template <typename T> T&& dv() noexcept;
struct Plain { ~Plain() {} };
struct Throwing { ~Throwing() noexcept(false) {} };
struct ThrowingMember { Throwing t; };
struct ThrowingMemberWritten { Throwing t; ~ThrowingMemberWritten() {} };
struct ThrowingBase : Throwing { };
struct ThrowingBaseWritten : Throwing { ~ThrowingBaseWritten() {} };
struct ArrayOf { Throwing t[2]; };
struct Pointer { Throwing* t; Throwing& r; };
struct Declared { Throwing t; ~Declared() noexcept; };
Declared::~Declared() noexcept {}
struct Yes { ~Yes() noexcept(true) {} };
class Virtual { public: virtual ~Virtual() {} };
class VirtualFalse { public: virtual ~VirtualFalse() noexcept(false) {} };
class FromVirtualFalse : public VirtualFalse { };
struct DefaultedM { Throwing t; ~DefaultedM() = default; };
template <typename T> struct Holder { T t; };
template <typename T> struct HolderWritten { T t; ~HolderWritten() {} };
template <bool B> struct Cond { ~Cond() noexcept(B) {} };
union U { Throwing t; int i; U() {} ~U() {} };
struct AnonymousUnion { union { Throwing t; int i; }; AnonymousUnion() {} ~AnonymousUnion() {} };
struct Static { static Throwing t; };
int main()
{
  printf("%d\n", noexcept(dv<Plain&>().~Plain()));
  printf("%d\n", noexcept(dv<Throwing&>().~Throwing()));
  printf("%d\n", noexcept(dv<ThrowingMember&>().~ThrowingMember()));
  printf("%d\n", noexcept(dv<ThrowingMemberWritten&>().~ThrowingMemberWritten()));
  printf("%d\n", noexcept(dv<ThrowingBase&>().~ThrowingBase()));
  printf("%d\n", noexcept(dv<ThrowingBaseWritten&>().~ThrowingBaseWritten()));
  printf("%d\n", noexcept(dv<ArrayOf&>().~ArrayOf()));
  printf("%d\n", noexcept(dv<Pointer&>().~Pointer()));
  printf("%d\n", noexcept(dv<Declared&>().~Declared()));
  printf("%d\n", noexcept(dv<Yes&>().~Yes()));
  printf("%d\n", noexcept(dv<Virtual&>().~Virtual()));
  printf("%d\n", noexcept(dv<VirtualFalse&>().~VirtualFalse()));
  printf("%d\n", noexcept(dv<FromVirtualFalse&>().~FromVirtualFalse()));
  printf("%d\n", noexcept(dv<DefaultedM&>().~DefaultedM()));
  printf("%d\n", noexcept(dv<Holder<Throwing>&>().~Holder<Throwing>()));
  printf("%d\n", noexcept(dv<Holder<int>&>().~Holder<int>()));
  printf("%d\n", noexcept(dv<HolderWritten<Throwing>&>().~HolderWritten<Throwing>()));
  printf("%d\n", noexcept(dv<HolderWritten<int>&>().~HolderWritten<int>()));
  printf("%d\n", noexcept(dv<Cond<true>&>().~Cond<true>()));
  printf("%d\n", noexcept(dv<Cond<false>&>().~Cond<false>()));
  printf("%d\n", noexcept(dv<U&>().~U()));
  printf("%d\n", noexcept(dv<AnonymousUnion&>().~AnonymousUnion()));
  printf("%d\n", noexcept(dv<Static&>().~Static()));
  return 0;
}
