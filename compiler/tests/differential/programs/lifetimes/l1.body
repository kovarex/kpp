// Lambdas: captures by copy and reference, init-captures, mutable, this and *this, generic lambdas,
// lambdas in templates, recursion through a parameter, immediately invoked, stateless to pointer.
struct Counter
{
  int n = 10;
  int bump()
  {
    auto byThis = [this] { return ++n; };
    auto self = [self = *this]() mutable { return ++self.n; };
    int a = byThis();
    int b = self();
    return a * 100 + b + n;
  }
};
template<typename T>
auto scaler(T factor)
{
  return [factor](auto x) { return x * factor; };
}
template<typename... Ts>
int sumCaptured(Ts... xs)
{
  auto f = [xs...]() { return (xs + ... + 0); };
  return f();
}
template<typename... Ts>
int sumByRef(Ts&... xs)
{
  auto f = [&xs...]() { ((xs += 1), ...); return (xs + ... + 0); };
  return f();
}
template<typename F>
int applyTwice(F f, int v) { return f(f(v)); }
template<typename T>
struct Box
{
  T value;
  template<typename F>
  auto map(F f) const { return Box<decltype(f(value))>{f(value)}; }
};
int (*toPointer)(int) = [](int x) { return x + 1; };
int main()
{
  int a = 1, b = 2;
  auto copy = [a, &b] { b += a; return a + b; };
  a = 100;
  int r1 = copy();
  printf("capture %d %d %d\n", r1, a, b);
  auto all = [=] { return a + b; };
  auto allRef = [&] { a += 1; return a + b; };
  b = 50;
  printf("defaults %d %d %d\n", all(), allRef(), a);
  int counter = 0;
  auto inc = [counter]() mutable { return ++counter; };
  inc();
  inc();
  printf("mutable %d %d\n", inc(), counter);
  auto init = [x = 5, y = a * 2]() { return x + y; };
  int moved = 7;
  auto byMove = [m = moved + 1] { return m; };
  printf("init %d %d\n", init(), byMove());
  Counter c;
  printf("this %d\n", c.bump());
  auto twice = scaler(2);
  auto half = scaler(0.5);
  printf("generic %d %.2f %.2f\n", twice(21), twice(1.25), half(9));
  printf("packs %d %d\n", sumCaptured(1, 2, 3, 4), [](int p, int q) { return sumByRef(p, q); }(10, 20));
  printf("applyTwice %d\n", applyTwice([](int v) { return v * 3; }, 2));
  auto fib = [](auto self, int n) -> int { return n < 2 ? n : self(self, n - 1) + self(self, n - 2); };
  printf("recursive %d\n", fib(fib, 15));
  printf("iife %d\n", [](int k) { return k * k; }(9));
  printf("pointer %d\n", toPointer(41));
  Box<int> bx{4};
  auto mapped = bx.map([](int v) { return v * 1.5; }).map([](double d) { return (long long)(d * 1000); });
  printf("map %lld\n", mapped.value);
  int total = 0;
  int values[4] = {1, 2, 3, 4};
  auto accumulate = [&total](int v) { total += v; };
  for (int v : values)
    accumulate(v);
  printf("loop %d\n", total);
  auto makeAdder = [](int base) { return [base](int x) { return base + x; }; };
  auto add5 = makeAdder(5);
  printf("nested %d\n", add5(10));
  int shared = 0;
  auto writer = [&shared](int v) { shared = v; };
  auto reader = [&shared] { return shared; };
  writer(33);
  printf("shared %d\n", reader());
  auto counterCopy = inc;
  printf("copied state %d %d\n", counterCopy(), inc());
  constexpr auto square = [](int v) { return v * v; };
  static_assert(square(5) == 25, "constexpr lambda");
  int arr[square(3)];
  printf("constexpr %d\n", (int)(sizeof(arr) / sizeof(int)));
  auto withDefault = [](int v, int w = 4) { return v * w; };
  printf("default arg %d %d\n", withDefault(2), withDefault(2, 5));
  return 0;
}
