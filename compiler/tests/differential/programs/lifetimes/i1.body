// Integer conversions: promotions, usual arithmetic conversions, truncation, sign and zero extension.
template<typename T>
void show(const char* what, T v)
{
  printf("%s %lld\n", what, (long long)v);
}
void showu(const char* what, unsigned long long v)
{
  printf("%s %llu\n", what, v);
}
int main()
{
  // promotions of small types
  signed char sc = -5;
  unsigned char uc = 250;
  short s = -300;
  unsigned short us = 65000;
  show("sc+uc", sc + uc);
  show("uc*uc", uc * uc);
  show("us*us", us * us);
  show("s*s", s * s);
  show("~uc", ~uc);
  show("-uc", -uc);
  show("uc<<4", uc << 4);
  show("sizeof(uc+uc)", sizeof(uc + uc));
  show("sizeof(sc*1L)", sizeof(sc * 1L));
  // signed / unsigned mixing
  int neg = -1;
  unsigned int one = 1;
  show("neg<one", neg < one);
  show("neg<(int)one", neg < (int)one);
  showu("neg+one", neg + one);
  showu("neg*one", (unsigned long long)(neg * one));
  long long ll = -1;
  show("ll<one", ll < one);
  unsigned long long ull = 1;
  show("ll<ull", ll < ull);
  show("neg<ull", neg < ull);
  showu("neg/one", neg / one);
  showu("neg%7u", neg % 7u);
  show("-7/2", -7 / 2);
  show("-7%2", -7 % 2);
  show("7/-2", 7 / -2);
  show("7%-2", 7 % -2);
  // truncation and sign extension
  int big = 70000;
  show("(short)big", (short)big);
  show("(unsigned short)big", (unsigned short)big);
  show("(signed char)200", (signed char)200);
  show("(char)-1 as int", (int)(char)-1);
  show("(unsigned char)-1", (unsigned char)-1);
  long long huge = 0x123456789abcdefLL;
  show("(int)huge", (int)huge);
  show("(unsigned)huge", (unsigned)huge);
  show("(short)huge", (short)huge);
  showu("(unsigned long long)-2", (unsigned long long)-2);
  showu("(unsigned long long)(int)-2", (unsigned long long)(int)-2);
  showu("(unsigned long long)(unsigned)-2", (unsigned long long)(unsigned)-2);
  int8_t i8 = -128;
  show("-i8", -i8);
  show("(int8_t)-i8", (int8_t)-i8);
  uint8_t u8 = 255;
  u8 += 3;
  show("u8+=3", u8);
  int8_t w8 = 120;
  w8 += 10;
  show("w8+=10", w8);
  uint16_t u16 = 1;
  u16 -= 2;
  show("u16-=2", u16);
  unsigned u = 0;
  --u;
  showu("--u", u);
  u = 3000000000u;
  show("(int)u", (int)u);
  show("u>>1", u >> 1);
  show("(int)u>>1", (int)u >> 1);
  // shifts
  show("1<<31 as unsigned", (unsigned)(1u << 31));
  show("-16>>2", -16 >> 2);
  showu("~0ull>>3", ~0ull >> 3);
  show("(-1LL)<<8", (long long)((unsigned long long)-1LL << 8));
  int shift = 33;
  showu("1ull<<shift", 1ull << shift);
  // conditional operator types
  show("true?-1:1u", true ? -1 : 1u);
  show("sizeof(true?1:1LL)", sizeof(true ? 1 : 1LL));
  show("false?uc:sc", false ? uc : sc);
  // floating to integer and back
  double d = -3.99;
  show("(int)d", (int)d);
  show("(int)3.99", (int)3.99);
  show("(unsigned char)200.7", (unsigned char)200.7);
  float f = 16777217;
  show("(int)(float)16777217", (int)f);
  double dd = 9007199254740993LL;
  show("(long long)(double)2^53+1", (long long)dd);
  show("(long long)1e18", (long long)1e18);
  show("(int)-0.5", (int)-0.5);
  unsigned long long bigu = 18446744073709551615ull;
  printf("(double)bigu %.1f\n", (double)bigu);
  printf("(float)bigu %.1f\n", (double)(float)bigu);
  printf("(double)-1ll %.1f\n", (double)-1ll);
  printf("(double)(unsigned)-1 %.1f\n", (double)(unsigned)-1);
  printf("1/3 %.17g\n", 1.0 / 3);
  printf("(float)0.1 %.17g\n", (double)0.1f);
  // bool
  show("(bool)256", (bool)256);
  show("(bool)0.1", (bool)0.1);
  show("true+true", true + true);
  bool b = 7;
  show("b", b);
  // char arithmetic
  char c = 'a';
  c += 1;
  show("c", c);
  show("'z'-'a'", 'z' - 'a');
  show("sizeof('a')", sizeof('a'));
  // compound assignment with wider right operand
  short acc = 10;
  acc *= 1000000;
  show("acc*=1e6", acc);
  unsigned char uacc = 10;
  uacc -= 20;
  show("uacc-=20", uacc);
  int ia = 10;
  ia /= 4.0;
  show("ia/=4.0", ia);
  ia = 7;
  ia *= 1.5;
  show("ia*=1.5", ia);
  long long lb = 5;
  lb <<= 40;
  show("lb<<=40", lb);
  // enums
  enum Small : unsigned char { A = 200, B = 255 };
  Small e = B;
  show("e+1", e + 1);
  show("sizeof(e+1)", sizeof(e + 1));
  enum class Wide : long long { Big = 1LL << 40 };
  show("(int)Wide::Big", (int)Wide::Big);
  show("(long long)Wide::Big", (long long)Wide::Big);
  // unsigned wraparound in loops and expressions
  unsigned total = 0;
  for (unsigned i = 5; i < 100; i -= 2)
    total += i;
  showu("total", total);
  uint32_t m = 0xffffffffu;
  showu("m*m", m * m);
  showu("(uint64_t)m*m", (uint64_t)m * m);
  uint16_t a16 = 60000, b16 = 60000;
  show("a16*b16 as int", a16 * b16 > 0 ? 1 : 0);
  showu("(uint32_t)(a16*b16)", (uint32_t)(a16 * b16));
  return 0;
}
