// The standard library's names the programs use bare, as they were before the library moved into
// std (design.md 16: no using-directive of std). Prepended to the kpp side of every program. A class
// template is an alias template of its parameters and a class an alias: `using std::Vector;` and
// `using std::String;` are not enough yet for `Vector<int>` and `String(p)` (README.md).
using String = std::String;
using StringView = std::StringView;
using WString = std::WString;
using InFileStream = std::InFileStream;
using OutFileStream = std::OutFileStream;
using OutOfRange = std::OutOfRange;
using InvalidArgument = std::InvalidArgument;
using OverflowError = std::OverflowError;
using DefaultRandomEngine = std::DefaultRandomEngine;
using CivilTime = std::CivilTime;
using Thread = std::Thread;
using ExceptionPtr = std::ExceptionPtr;
using Mutex = std::Mutex;
using BadOptionalAccess = std::BadOptionalAccess;
using ErrorCode = std::ErrorCode;
using SystemError = std::SystemError;
using SystemClock = std::SystemClock;
using Seconds = std::Seconds;
using Milliseconds = std::Milliseconds;
using Microseconds = std::Microseconds;
using Nanoseconds = std::Nanoseconds;
using Minutes = std::Minutes;
using Hours = std::Hours;
template <typename T> using Vector = std::Vector<T>;
template <typename T> using Function = std::Function<T>;
template <typename T> using Deque = std::Deque<T>;
template <typename T> using Optional = std::Optional<T>;
template <typename T> using List = std::List<T>;
template <typename T> using ForwardList = std::ForwardList<T>;
template <typename T> using Atomic = std::Atomic<T>;
template <typename A, typename B> using Pair = std::Pair<A, B>;
template <typename... T> using Tuple = std::Tuple<T...>;
template <typename T> using UniquePtr = std::UniquePtr<T>;
template <typename T> using SharedPtr = std::SharedPtr<T>;
template <typename T> using WeakPtr = std::WeakPtr<T>;
template <typename T> using Hash = std::Hash<T>;
template <typename T = void> using Less = std::Less<T>;
template <typename T = void> using Greater = std::Greater<T>;
template <typename K, typename V, typename C = std::Less<K>> using Map = std::Map<K, V, C>;
template <typename K, typename V, typename C = std::Less<K>> using MultiMap = std::MultiMap<K, V, C>;
template <typename T, typename C = std::Less<T>> using Set = std::Set<T, C>;
template <typename T, typename C = std::Less<T>> using MultiSet = std::MultiSet<T, C>;
template <typename K, typename V, typename H = std::Hash<K>, typename E = std::EqualTo<K>> using HashMap = std::HashMap<K, V, H, E>;
template <typename T, typename H = std::Hash<T>, typename E = std::EqualTo<T>> using HashSet = std::HashSet<T, H, E>;
template <typename T, typename C = std::Deque<T>> using Stack = std::Stack<T, C>;
template <typename T, typename C = std::Deque<T>> using Queue = std::Queue<T, C>;
template <typename T, typename C = std::Vector<T>, typename L = std::Less<T>> using PriorityQueue = std::PriorityQueue<T, C, L>;
template <typename T, std::ContainerSize N> using Array = std::Array<T, N>;
template <typename T, std::ContainerSize E = std::dynamicExtent> using Span = std::Span<T, E>;
template <std::ContainerSize N> using Bitset = std::Bitset<N>;
template <i64 N, i64 D = 1> using Ratio = std::Ratio<N, D>;
template <typename R, typename P = std::Ratio<1>> using Duration = std::Duration<R, P>;
template <typename D> using HoursMinutesSeconds = std::HoursMinutesSeconds<D>;
template <typename C, typename D = typename C::duration> using TimePoint = std::TimePoint<C, D>;
template <typename R1, typename R2> using RatioAdd = std::RatioAdd<R1, R2>;
template <typename R1, typename R2> using RatioSubtract = std::RatioSubtract<R1, R2>;
template <typename R1, typename R2> using RatioMultiply = std::RatioMultiply<R1, R2>;
template <typename I> using Subrange = std::Subrange<I>;
template <typename T> using EnableSharedFromThis = std::EnableSharedFromThis<T>;
template <typename M> using LockGuard = std::LockGuard<M>;
template <typename T> using UniformIntDistribution = std::UniformIntDistribution<T>;
