// Inactive code for tests\lsp.ps1 (docs/editors.md, "Inactive code"): what the checked configuration does not build.
when (config::debug) int created = 0;
if constexpr (config::debug)
{
  int pick() { return 1; }
}
else
{
  int pick() { return 2; }
}

struct Counter
{
  int value = 0;
  when (config::debug) int calls = 0;

  void add()
  {
    if constexpr (config::debug)
    {
      ++this.calls;
      ++created;
    }
    else
      this.value += pick();
    when (!config::debug) int skipped = 0;
    ++this.value;
  }
};

int main()
{
  Counter c;
  c.add();
  if constexpr (config::debug)
    std::println("debug ", pick());
  else
    std::println("release ", pick());
  return 0;
}

// In a for constexpr, a branch is inactive only when no element takes it.
int sizes()
{
  int total = 0;
  for constexpr (typename T : types<char, int, double>)
  {
    when (sizeof(T) == 1) int one = 1;
    when (sizeof(T) > 100) int huge = 100;
    if constexpr (sizeof(T) == 1)
      total += one;
    else if constexpr (sizeof(T) == 4)
      total += 4;
    else
      total += 8;
    if constexpr (sizeof(T) > 100)
      total += huge;
    if constexpr (sizeof(T) <= 4)
    {
      if constexpr (sizeof(T) == 1)
        total += 10;
      else
        total += 40;
    }
  }
  return total;
}

// The same where each element has its own copy of the body (a local class).
int boxes()
{
  int total = 0;
  for constexpr (typename T : types<char, int>)
  {
    struct Box { T value; };
    Box box{};
    if constexpr (sizeof(T) == 1)
      total += int(sizeof(box));
    else
      total += 2 * int(sizeof(box));
    if constexpr (sizeof(T) > 100)
      total += 100;
  }
  return total;
}

// A switch over a typed union's alternatives, as the game's InputAction load: both branches are taken.
union enum class Action : u8
{
  { {int, Move}, {void, Stop} }

  void load(int index, int value)
  {
    switch (Action::Tag(index))
    {
      for constexpr (auto a : alternatives(Action))
        case a.tag:
          if constexpr (std::isSame<a.type, void>)
            this[a.tag] = void();
          else
            this[a.tag] = value;
    }
  }
};
