// The language server's test program (tests/lsp.ps1): two files, names used across them.
struct Shape
{
  int width = 0;
  int height = 0;
  int area() const { return this.width * this.height; }
};

int totalArea(const std::Vector<Shape>& shapes)
{
  int sum = 0;
  for (const Shape& s : shapes)
    sum += s.area();
  return sum;
}

namespace units { int scale = 2; }
int scaled(int x) { return x * units::scale; }
