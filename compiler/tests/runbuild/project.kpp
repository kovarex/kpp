// GlobalScope::runBuild (kpp --run-build): a projectlib-shaped Project, describe() building a String from Vector<String>s.
enum class Configuration { debug, release };
struct Project
{
  Configuration configuration = Configuration::debug;
  std::Vector<std::String> roots;
  std::Vector<std::String> includes;
  void root(std::StringView r) { roots.push_back(std::String(r)); }
  void include(std::StringView first, std::StringView second) { std::String s = std::String(first); s << second; includes.push_back(std::move(s)); }
};
std::String describe(const Project& project)
{
  std::String text = "configuration ";
  text << std::StringView(project.configuration == Configuration::debug ? "debug" : "release");
  text << "\n";
  for (const std::String& r : project.roots)
  {
    text << "root ";
    text << r;
    text << "\n";
  }
  for (const std::String& i : project.includes)
  {
    text << "cinclude ";
    text << i;
    text << "\n";
  }
  return text;
}
