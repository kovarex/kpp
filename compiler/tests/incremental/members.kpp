// Members whose signature edits reach their callers in edgecalls.kpp only through a class: a member a
// using-declaration brings into a derived class, and a base's member called through a derived class
// (and through a template instantiated with it). A friend defined in its class, which a call finds by
// ADL and is read by name: Weighed's, added by an edit after argument-dependent lookup found the class
// had none (the resolver keeps that answer: the edit must take it back).
struct UsingBase
{
  int f([[maybe_unused]] int v) { return 1; }
};
struct UsingDerived : UsingBase
{
  using UsingBase::f;
  int f([[maybe_unused]] double v) { return 2; }
};

struct EdgeBase
{
  int m([[maybe_unused]] int v) { return 1; }
};
struct EdgeDerived : EdgeBase
{
};

struct Weighed
{
  int v = 3;
};
int weigh(const Weighed& w, int extra) { return w.v + extra; }
int weighed() { Weighed w; return weigh(w, 1); }
