// The program tests\incremental.ps1 edits between builds: a function body, a signature, a class's
// layout, a constexpr function's body (run at compile time in main.kpp), and a file added and removed.
struct Shape
{
  int width = 2;
  int height = 3;
  int area() const { return width * height; }
};

int scale(int v) { return v * 10; }

int combine(int a, int b) { return a + b; }

constexpr int limit() { int r = 5; return r; }

int measure() { return 1; }

int unitWidth() { return 1; }

// Two classes with a member of one name: an edit of Gauge's is no change for what reads Meter's
// (readTwice<Meter>), as lookups in a class are recorded with the class.
struct Gauge { int reading() const { return 3; } };
struct Meter { int reading() const { return 4; } };
template<typename T>
int readTwice(const T& t) { int r = t.reading(); return r + r; }

// A member template defined out of line and called with explicit arguments: codegen makes its
// instance (scaled<int>). An edit of base() drops that instance, and codegen makes it anew.
struct Panel
{
  int base() const { return 2; }
  template<typename T> T scaled() const;
  int show() const { return this->scaled<int>(); }
};
template<typename T> T Panel::scaled() const { T r = T(base() * 3); return r; }

template<typename T>
T twice(T v) { T r = v + v; return r; }

// An instance that reads `scale`: the overload added and removed check it again.
template<typename T>
int viaScale(T v) { int r = scale(v); return r; }

template<typename T>
struct Box
{
  T v;
  T tripled() const { T r = v * 3; return r; }
};
