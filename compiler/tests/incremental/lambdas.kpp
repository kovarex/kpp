// Lambdas, which the code names by position (the parser numbers them in the file's order, and a
// local type's name carries its token): an edit before one moves it, a lambda added before it
// renumbers it, and the server must name it as a build from scratch does.
int firstHelper() { int r = 2; return r; }

// A generic lambda's call operator that reads `scale`: checked again when the overload is added.
int viaLambda()
{
  auto scaled = [](auto v) { int r = scale(v); return r; };
  return scaled(4.5);
}

// A global whose initializer holds lambdas: a lambda added before them in this file renumbers them,
// and the instances made from them (Function<int(int)>'s call of each) must take the new names.
int stepOf(int v) { return v + 1; }
Function<int(int)> stepFunctions[2] = { [](int v) { return stepOf(v); }, [](int v) { return stepOf(v) * 2; } };
int viaSteps() { return stepFunctions[0](3) + stepFunctions[1](3); }
