// What must not be renamed by an edit above it in its file: its name in the code carries a number, not a place
// (tests\incremental.ps1 adds a line and a statement above all of these, and every one stays kept).
int positionHelper() { return 1; }

// A local class and enumeration, a static local, a lambda.
int withLocals()
{
  struct Local { int v = 2; int get() const { return v + positionHelper(); } };
  enum Mode { First, Second };
  static int calls = 0;
  calls = calls + 1;
  Local l;
  auto add = [](int a, int b) { return a + b; };
  return add(l.get(), int(Second)) + calls;
}

// A template's static local, try and static braced list: its instances hold those names too.
template<typename T>
int templateStatics(T v)
{
  static T last = v;
  static std::InitializerList<int> numbers = {1, 2, 3};
  try
  {
    if (v < T(0))
      throw 1;
    last = v;
  }
  catch (int)
  {
    return -1;
  }
  return int(last) + int(numbers.size());
}

// A polymorphic class written in a function template, made for a lambda (thread F's link failure, 2026-11-10): an edit of a
// function the lambda's writer reads emits the writer again, which must keep what was made for its closure (the class's
// vtable is kept, and asks for its virtual function only once).
class Helper
{
public:
  virtual ~Helper() {}
  virtual int run() = 0;
};

template<class F>
Helper* makeHelper(F&& f)
{
  class Inner : public Helper
  {
  public:
    Inner(F&& g) : g(std::move(g)) {}
    virtual int run() override { return g(); }
    F g;
  };
  return new Inner(std::move(f));
}

int helperBase() { return 7; }

int viaHelper()
{
  Helper* h = makeHelper([]() { return helperBase(); });
  int r = h->run();
  delete h;
  return r;
}

// A class with a defaulted comparison and a constructor written outside it: the defaulted operator's walk reads the class's name,
// which is the constructor's, so an edit of the constructor's body reaches a declaration without a body (until 2026-11-10 codegen
// in full: "the walk of X::operator== read an edited function").
class Spot
{
public:
  Spot(int x, int y);
  bool operator==(const Spot&) const = default;
  int x = 0;
  int y = 0;
};

// (not trivial before the edit nor after it: a call of a constructor made trivial is inlined by a build from scratch, and its
// callers name the class, not the constructor, so the server does not emit them again: the same program, not the same IR)
Spot::Spot(int x, int y) : x(x), y(y) { if (x < 0) return; }

int spotsEqual() { return Spot(1, 2) == Spot(1, 2) ? 1 : 0; }

int positionsTotal = withLocals() + templateStatics(2) + templateStatics(2.5) + viaHelper() + spotsEqual();

// A union enum's generated tag() has no `{` to pair: the file stays incremental (2026-11-10).
struct Walking { int steps; };
struct Waiting { int ticks; };
union enum Activity : uint8_t
{
  { {Walking, Walk}, {Waiting, Wait} }
};
