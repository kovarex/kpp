extern "C" int printf(const char* format, ...);

int main()
{
  Shape s;
  constexpr int n = limit();
  static_assert(limit() < 10, "the checker runs limit's body in main's walk");
  printf("%d %d %d %d %d %d %d %d\n", s.area(), scale(4), scale(4.5), combine(1, 2), int(sizeof(Shape)), twice(5), Box<int>{2}.tripled(), n);
  return 0;
}
