extern "C" int printf(const char* format, ...);

// A data member declared with a function's return type: a return type edit changes this layout.
struct Holder
{
  decltype(measure()) sum = 1;
  int after = 2;
};

// A return type the body gives, reading `combine`: the signature edit leaves it int, so the edit
// stays incremental (its type is compared after its walk).
auto sumOf() { return combine(2, 3); }

// A static_assert at namespace scope reads unitWidth: its walk is a unit of its own, so a return
// type edit of unitWidth checks it again (and it fails).
static_assert(sizeof(unitWidth()) == 4, "unitWidth returns an int");
static_assert(isTriviallyCopyable<Plain>, "Plain is trivially copyable");

int main()
{
  Shape s;
  constexpr int n = limit();
  static_assert(limit() < 10, "the checker runs limit's body in main's walk");
  printf("%d %d %d %d %d %d %d %d %d %d %d %d %d %d\n", s.area(), scale(4), scale(4.5), int(combine(1, 2)), int(sizeof(Shape)), twice(5), Box<int>{2}.tripled(), n,
         int(sizeof(Holder)), viaScale(4.5), Gauge{}.reading(), readTwice(Meter{}), Panel{}.show(), viaLambda());
  printf("%d %d %d\n", frameSize(), taggedSize(), localSizes()); // (holders.kpp: Shape by value, never named there)
  return 0;
}
