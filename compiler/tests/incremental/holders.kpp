// Classes holding Shape by value, read by functions that never name Shape: a layout edit of Shape
// changes their sizes and their members' offsets (rebuildLLVM's changed layouts, transitively).
struct Frame
{
  Shape inner;
  int border = 1;
};

template<typename T>
struct Tagged
{
  T first;
  int tag = 7;
};

int frameSize() { Frame f; return int(sizeof(Frame)) + f.border; }

int taggedSize() { Tagged<Shape> t; return t.tag + int(sizeof(Tagged<Shape>)); }
