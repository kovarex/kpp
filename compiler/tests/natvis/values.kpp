// The natvis kpp links into the PDB of a build with debug information (tests\natvis.ps1,
// docs/debugging.md, "Values in Visual Studio"): a value of each library type it has a rule for, and
// a typed union; containers with more than one block or node.
struct Point
{
  int x = 0;
  int y = 0;
};

union enum Property : uint8_t
{
  { {int, Integer}, {double, Real}, {String, Text} }
};

int main()
{
  Vector<int> numbers;
  numbers.push_back(2);
  numbers.push_back(3);
  String small = "kpp";
  String large = "a string longer than thirty characters, on the heap";
  StringView view = large;
  HashMap<String, int> ages;
  ages["ada"] = 36;
  ages["alan"] = 41;
  HashSet<int> seen;
  seen.insert(7);
  Optional<int> some = 5;
  Optional<int> none;
  Point^ point = makeUnique<Point>(); // (UniquePtr<Point>, named Point^ in the PDB)
  point->x = 4;
  Property count;
  count[Property::Integer] = 12;
  Property name;
  name[Property::Text] = String("gear");
  Deque<int> queue;
  for (int i = 0; i < 20; ++i)
    queue.push_back(i);
  for (int i = 1; i <= 20; ++i)
    queue.push_front(-i);
  List<String> words;
  words.push_back("cog");
  words.push_front("belt");
  ForwardList<int> stack;
  stack.push_front(8);
  stack.push_front(9);
  Map<String, int> heights;
  heights["inserter"] = 3;
  heights["chest"] = 1;
  heights["assembler"] = 2;
  HashMap<int, Vector<int>> groups; // (an entry type ending in >>)
  groups[1].push_back(5);
  Set<int> ids;
  ids.insert(30);
  ids.insert(10);
  ids.insert(20);
  SharedPtr<Point> shared = makeShared<Point>();
  shared->y = 6;
  SharedPtr<Point> again = shared;
  WeakPtr<Point> weak = shared;
  println(numbers.size(), " ", small, " ", view.size(), " ", ages.size(), " ", seen.size(), " ", *some, " ", none.has_value(), " ", point->x, " ",
          count[Property::Integer], " ", name[Property::Text], " ", queue.size(), " ", queue[0], " ", words.size(), " ", stack.front(), " ",
          heights.size(), " ", groups.size(), " ", ids.size(), " ", again.use_count(), " ", weak.expired(), " ", shared->y);
  return 0;
}
