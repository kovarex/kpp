// The natvis kpp links into the PDB of a build with debug information (tests\natvis.ps1,
// docs/debugging.md, "Values in Visual Studio"): a value of each library type it has a rule for, and
// a typed union; containers with more than one block or node. And debugValue() (docs/debugging.md,
// "debugValue"): a fixed-point number shown as its value, a rule per instance; a class shown as its
// String member; one with an `if` and another type's debugValue; one shown as a Span's elements; one
// through its own conversion, a constexpr local in it; text views, a std::String built with +.
struct Point
{
  int x = 0;
  int y = 0;
};

template<i32 Bits>
class Fixed
{
public:
  static constexpr i32 ValuesPerOne = 1 << Bits;
  f64 debugValue() const { return f64(this.value) * (1.0 / This::ValuesPerOne); }
  i32 value = 0;
};

struct Item
{
  std::String debugValue() const { return this.name; }
  std::String name;
  Fixed<8> speed;
  Fixed<12> weight;
};

struct Load
{
  f64 debugValue() const
  {
    if (this.empty)
      return 0;
    return this.weight.debugValue() * 2;
  }
  bool empty = false;
  Fixed<12> weight;
};

struct Angle
{
  constexpr f64 toTurns() const { constexpr f64 PerStep = 1.0 / 4294967296.0; return f64(this.value) * PerStep; }
  f64 debugValue() const { return this.toTurns(); }
  u32 value = 0;
};

struct Force
{
  std::String debugValue() const
  {
    if (this.index == 1)
      return "player";
    return "{index=" + std::toString(this.index) + "}";
  }
  u8 index = 0;
};

struct Stack
{
  std::String debugValue() const { return std::toString(this.count) + " x " + this.name + " (" + std::toString(this.weight) + ")"; }
  std::String name;
  i32 count = 0;
  f64 weight = 0;
};

struct Buffer
{
  std::Span<i32> debugValue() const { return std::Span<i32>(this.data, this.size); }
  i32* data = nullptr;
  usize size = 0;
};

union enum Property : uint8_t
{
  { {int, Integer}, {double, Real}, {std::String, Text} }
};

int main()
{
  Item item;
  item.name = "gear";
  item.speed.value = 384;
  item.weight.value = 8192;
  Load load;
  load.weight.value = 2048;
  i32 held[3] = {4, 5, 6};
  Angle angle;
  angle.value = 1073741824;
  Force force;
  force.index = 7;
  Stack stack;
  stack.name = "gear";
  stack.count = 3;
  stack.weight = 1.5;
  Buffer buffer;
  buffer.data = held;
  buffer.size = 3;
  std::Vector<int> numbers;
  numbers.push_back(2);
  numbers.push_back(3);
  std::String small = "kpp";
  std::String large = "a string longer than thirty characters, on the heap";
  std::StringView view = large;
  std::HashMap<std::String, int> ages;
  ages["ada"] = 36;
  ages["alan"] = 41;
  std::HashSet<int> seen;
  seen.insert(7);
  std::Optional<int> some = 5;
  std::Optional<int> none;
  Point^ point = std::makeUnique<Point>(); // (UniquePtr<Point>, named Point^ in the PDB)
  point->x = 4;
  Property count;
  count[Property::Integer] = 12;
  Property name;
  name[Property::Text] = std::String("gear");
  std::Deque<int> queue;
  for (int i = 0; i < 20; ++i)
    queue.push_back(i);
  for (int i = 1; i <= 20; ++i)
    queue.push_front(-i);
  std::List<std::String> words;
  words.push_back("cog");
  words.push_front("belt");
  std::ForwardList<int> stack;
  stack.push_front(8);
  stack.push_front(9);
  std::Map<std::String, int> heights;
  heights["inserter"] = 3;
  heights["chest"] = 1;
  heights["assembler"] = 2;
  std::HashMap<int, std::Vector<int>> groups; // (an entry type ending in >>)
  groups[1].push_back(5);
  std::Set<int> ids;
  ids.insert(30);
  ids.insert(10);
  ids.insert(20);
  std::SharedPtr<Point> shared = std::makeShared<Point>();
  shared->y = 6;
  std::SharedPtr<Point> again = shared;
  std::WeakPtr<Point> weak = shared;
  std::println(numbers.size(), " ", small, " ", view.size(), " ", ages.size(), " ", seen.size(), " ", *some, " ", none.has_value(), " ", point->x, " ",
          count[Property::Integer], " ", name[Property::Text], " ", queue.size(), " ", queue[0], " ", words.size(), " ", stack.front(), " ",
          heights.size(), " ", groups.size(), " ", ids.size(), " ", again.use_count(), " ", weak.expired(), " ", shared->y);
  return 0;
}
