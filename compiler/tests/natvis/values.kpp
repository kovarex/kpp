// The natvis kppc links into the PDB of a build with debug information (tests\natvis.ps1,
// docs/debugging.md, "Values in Visual Studio"): a value of each library type it has a rule for, and
// a typed union.
struct Point
{
  int x = 0;
  int y = 0;
};

union enum Property : uint8_t
{
  { {int, Integer}, {double, Real}, {String, Text} }
};

int main()
{
  Vector<int> numbers;
  numbers.push_back(2);
  numbers.push_back(3);
  String small = "kpp";
  String large = "a string longer than thirty characters, on the heap";
  StringView view = large;
  HashMap<String, int> ages;
  ages["ada"] = 36;
  ages["alan"] = 41;
  HashSet<int> seen;
  seen.insert(7);
  Optional<int> some = 5;
  Optional<int> none;
  UniquePtr<Point> point = makeUnique<Point>();
  point->x = 4;
  Property count;
  count[Property::Integer] = 12;
  Property name;
  name[Property::Text] = String("gear");
  println(numbers.size(), " ", small, " ", view.size(), " ", ages.size(), " ", seen.size(), " ", *some, " ", none.has_value(), " ", point->x, " ",
          count[Property::Integer], " ", name[Property::Text]);
  return 0;
}
