// format: braces end-of-line with indent 4 and case-indent no (a K&R style); one-liners stay
namespace game
{
  enum class Mode
  {
    Off,
    On
  };

  enum class Small { A, B };

  struct Counter
  {
    i32 value = 0;
    i32 get() const { return this.value; }

    void add(i32 by)
    {
      this.value += by;
    }
  };

  void run(Counter& c, Mode mode) // runs it
  {
    if (mode == Mode::On)
    {
      c.add(1);
    }
    else if (c.get() > 3)
    {
      c.add(2);
    }
    else
    {
      c.add(3);
    }
    for (i32 i = 0; i < 3; ++i)
    {
      c.add(i);
    }
    while (c.get() < 10)
    {
      c.add(1);
    }
    do
    {
      c.add(-1);
    } while (c.get() > 5);
    switch (c.get())
    {
      case 1:
      {
        c.add(1);
        break;
      }
      default:
        break;
    }
    {
      i32 scoped = c.get();
      c.add(scoped);
    }
    try
    {
      c.add(0);
    }
    catch (const Error& e)
    {
      c.add(1);
    }
    auto twice = [&](i32 x)
    {
      return x * 2;
    };
    auto once = [](i32 x) { return x; };
    if (c.get() == 0) { c.add(1); }
  }
}

suite counting
{
  test adding
  {
    game::Counter c;
    c.add(2);
    check(c.get() == 2);
  }
}

i32 classify(i32 kind, i32 other)
{
  switch (kind)
  {
    case 0:
      fallthrough;
    case 1: return 1;
    case 2:
    {
      i32 doubled = kind * 2;
      return doubled;
    }
    case 3:
      switch (other)
      {
        case 0:
          return 30;
        default:
          return 31;
      }
    default:
      break;
  }
  return 0;
}
