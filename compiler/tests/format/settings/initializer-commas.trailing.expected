// format: initializer-commas (leading, trailing): initializer lists and base clauses one item to a line, an empty line and a comment among them
class Inserter
  : public Entity,
    public Targeter
{
public:
  Inserter(i32 a, f64 b, const String& name)
    : Entity(a),
      Targeter(b),
      name(name)

    // the arm starts folded
    , arm(0, 0),
      speed(b * 2)
  {}

  Inserter(i32 a) : Entity(a), Targeter(0), name("small") {}

private:
  String name;
  Arm arm;
  f64 speed = 0;
};

enum class Mode : u8 { Off, On };
