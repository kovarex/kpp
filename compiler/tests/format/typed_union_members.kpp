// A typed union (`union enum`) in kpp's style: its alternatives' block on lines of its own, its data members and
// functions after it, as a kpp enum's values and members; kpp format leaves it as it is (tests\format.ps1).
struct Pos
{
  int x = 0;
  int y = 0;
};

union enum Action : u8
{
  { {Nothing, void}, {Move, Pos}, {Say, std::String} }
  u32 tick = 0;
  u16 player = 0;

  bool moves() const { return this == Action::Tag::Move; }
};

union enum Input : u8
{
  {
    {Nothing, void},
    {Count, int},
    {Name, std::String}
  }
  u32 tick = 0;
};

union enum Small
{
  { {A, int}, {B, void} }
};

int main()
{
  Action action;
  action[Action::Tag::Move] = Pos{1, 2};
  return action.moves() ? 0 : 1;
}
