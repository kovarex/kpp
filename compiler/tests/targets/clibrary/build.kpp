// targets.ps1's project of a C library with a C and a C++ file and a define per platform
// (CLibrary's define(..., Platform::X)), and an include directory of the C import per platform
// (Executable's cInclude(..., Platform::X)), built for Windows, Linux and FreeBSD: `42 PLATFORM 10`.
void build(Project& project)
{
  CLibrary& numbers = project.cLibrary("numbers");
  numbers.source("c");
  numbers.source("cpp");
  numbers.include("c");
  numbers.define("SCALE=3");
  numbers.define("PLATFORM_ID=1", Platform::Windows);
  numbers.define("PLATFORM_ID=2", Platform::Linux);
  numbers.define("PLATFORM_ID=3", Platform::FreeBSD);
  // numbers.c includes numbers.h first, from beside it (the include directory's file): it compiles with
  // the header precompiled; sum.cpp includes <numeric> first, and compiles as it is.
  numbers.precompiledHeader("numbers.h");
  // Linux's own library, with a directory of the target's sysroot (`=`) as its include directory.
  CLibrary& kernel = project.cLibrary("kernel");
  kernel.source("kernel", Platform::Linux);
  kernel.include("=/usr/include/linux", Platform::Linux);
  // Windows' own library, its headers spelled <Windows.h> and <WinSock2.h> (a Linux host's case).
  CLibrary& windows = project.cLibrary("windows");
  windows.source("windows", Platform::Windows);
  windows.resource("windows/app.rc", Platform::Windows);
  Executable& app = project.executable("app", {"src"});
  app.link("numbers");
  app.link("kernel");
  app.link("windows");
  app.cInclude("c");
  // Each has an included_for.h, which main.kpp imports: its own platform's alone is on the path.
  app.cInclude("include-windows", Platform::Windows);
  app.cInclude("include-linux", Platform::Linux);
  app.cInclude("include-freebsd", Platform::FreeBSD);
}
