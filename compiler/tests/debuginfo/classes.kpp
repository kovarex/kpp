// --debug-info's classes defined on every emitter at once (homeDebugClasses' levels, 2026-11-07):
// determinism.ps1 builds this with --debug-info at 8 modules, at -j 1 (one emitter defines every class)
// and at -j 32 (each level's classes on every emitter at once), and compares every module's text by the
// hash kpp keeps beside its object. 96 classes, more than homeDebugClasses leaves to one thread (64):
// each with data members, an array, a member function and a pointer to the next; every fourth derived
// from a polymorphic base. main's locals name every one, so the first level has them all.
// (Written by a script: Part<i> for i in 0..95.)
class Base
{
public:
  virtual ~Base() {}
  virtual i32 weight() const { return 1; }
  i32 tag = 7;
};

class Part0 : public Base
{
public:
  i32 weight() const override { return this->id + this->pair[1]; }
  i32 id = 0;
  double scale = 0.5;
  i32 pair[2] = {0, 1};
  Part1* next = nullptr;
};

