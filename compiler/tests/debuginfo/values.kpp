// --debug-info's variables and types (docs/debugging.md, "Variables and types"): debuginfo.ps1 builds
// this at one module and at 64, runs it, and checks what the PDB says of inspect's parameters, locals
// and block, of its lambda's captures, of these classes (their members' access, a static member), this
// enum and this typed union (its tag and its alternatives' storage), of the library's Vector<int32>,
// and of the globals (a static member's storage is one) against values.expected.
namespace game
{
  enum class Mode : unsigned char { Off, On, Broken = 7 };
  // (an unsigned enumerator whose value is negative as an int64: LLVM rejects it printed signed)
  enum class Mask : uint64_t { None = 0, All = ~0ull };

  int counter = 5;

  struct Point
  {
    int x;
    int y;
  };

  class Shape
  {
  public:
    virtual ~Shape() {}
    virtual int area() const { return 0; }
    static int made;
    int id = 1;
  };
  int Shape::made = 2;

  class Square : public Shape
  {
  public:
    int area() const override { return this->side * this->side; }
    int side = 3;
    Shape* next = nullptr;

  private:
    int secret = 4;
  };
}

struct Flags
{
  bool on : 1;
  unsigned level : 3;
  union
  {
    int whole;
    float part;
  };
};

union enum Value : uint8_t
{
  { {int, Integer}, {double, Real} }
};

int inspect(const game::Point& point, int scale, game::Mode mode)
{
  int sum = point.x * scale;
  game::Mask mask = game::Mask::All;
  auto scaled = [sum, &mask](int k) { return sum * k + (mask == game::Mask::All ? 0 : 1); };
  sum = scaled(1) + game::counter - game::Shape::made;
  Vector<int> values;
  values.push_back(sum);
  {
    double half = sum / 2.0;
    Flags flags{};
    flags.level = 2;
    game::Square square;
    Value value;
    value[Value::Real] = half;
    sum += (int)half + (int)flags.level + square.area() + (int)mode + (value == Value::Real ? 1 : 0) + (mask == game::Mask::All ? 0 : 1);
  }
  return sum + (int)values.size();
}

int main()
{
  game::Point point{3, 4};
  println(inspect(point, 2, game::Mode::On));
  return 0;
}
