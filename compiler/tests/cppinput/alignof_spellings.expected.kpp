// cppinput: MSVC's `__alignof` and GCC's `__alignof__` convert to alignof (Unreal's MinimalWindowsApi checks its
// mirrors of Windows types with `__alignof`), where they were undeclared names

struct Mirror
{
  u64 Internal;
  void* Pointer;
};

struct alignas(16) Wide
{
  char Bytes[3];
};

static_assert(alignof(Mirror) == alignof(u64), "Alignment of Mirror");
static_assert(alignof(Wide) == 16, "Alignment of Wide");

i32 main() { return alignof(Mirror) == 8 && alignof(Wide) == 16 ? 0 : 1; }
