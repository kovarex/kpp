// The driver: config:: constants: their values and declarations. Part of main.cpp, included in its
// namespace there (a file of its own since 2026-11-05, moved without a change).
  // A --config value: true/false, an integer, or a word (an enumerator such as Windows, or a string).
  ConfigValue parseConfigValue(const std::string& text)
  {
    ConfigValue v;
    v.text = text;
    if (text == "true" || text == "false")
    {
      v.number = text == "true";
      return v;
    }
    char* end = nullptr;
    long long n = strtoll(text.c_str(), &end, 0);
    if (end && *end == 0 && !text.empty())
    {
      v.number = n;
      return v;
    }
    v.isNumber = false;
    return v;
  }

  // A string as a kpp literal's text: its quotes and backslashes escaped.
  std::string escapedString(const std::string& text)
  {
    std::string out;
    for (char c : text)
    {
      if (c == '"' || c == '\\')
        out += '\\';
      out += c;
    }
    return out;
  }

  // The `config` namespace as kpp source, one constant per --config value; one declared in source
  // (declared) has its declared type.
  std::string configSource(const ConfigValues& values, const std::map<std::string, ConfigDeclared>& declared)
  {
    // config::platform's enumeration and its short names, from target.hpp's one table: build.kpp's
    // Project.kpp names a platform's system libraries by config::platformName.
    std::string s = "// Build configuration, generated by kppc from --config name=value and --release.\nenum class Platform {";
    for (const PlatformName& p : platformNames)
      s += std::string(&p == platformNames ? " " : ", ") + p.enumerator;
    s += " };\nnamespace config\n{\n  const char* platformName(Platform platform)\n  {\n";
    for (const PlatformName& p : platformNames)
      s += std::string("    if (platform == Platform::") + p.enumerator + ")\n      return \"" + p.name + "\";\n";
    s += "    return \"\";\n  }\n";
    // A library's constant, LIB::NAME (docs/build.md, "kpp libraries": its options), is NAME in the
    // namespace config::LIB; the map's order keeps one library's together.
    std::string open;
    for (const auto& [qualified, value] : values)
    {
      size_t colons = qualified.rfind("::");
      std::string scope = colons == std::string::npos ? "" : qualified.substr(0, colons);
      std::string name = colons == std::string::npos ? qualified : qualified.substr(colons + 2);
      if (scope != open)
      {
        if (!open.empty())
          s += "  }\n";
        if (!scope.empty())
          s += "  namespace " + scope + "\n  {\n";
        open = scope;
      }
      std::string indent = scope.empty() ? "  " : "    ";
      auto source = declared.find(qualified);
      if (source != declared.end())
      {
        const ConfigDeclaration& d = source->second.declaration;
        if (d.kind == "string")
          s += indent + "const StringView " + name + " = \"" + escapedString(value.text) + "\";\n";
        else if (d.kind == "enum")
          s += indent + "const " + d.type + " " + name + " = " + d.type + "::" + value.text + ";\n";
        else
          s += indent + "const " + d.type + " " + name + " = " + value.text + ";\n";
      }
      else if (name == "platform" && scope.empty())
        s += indent + "const Platform platform = Platform::" + value.text + ";\n";
      else if (!value.isNumber)
        s += indent + "const char* " + name + " = \"" + value.text + "\";\n";
      else if (value.text == "true" || value.text == "false")
        s += indent + "const bool " + name + " = " + value.text + ";\n";
      else
        s += indent + "const int " + name + " = " + std::to_string(value.number) + ";\n";
    }
    if (!open.empty())
      s += "  }\n";
    return s + "}\n";
  }

  // The config:: constants the program's .kpp files declare (config.cpp; design.md, "config:: defaults
  // in source"): config::NAME, a library's config::LIB::NAME. Each takes its --config value, which must
  // fit its type, else its default; one with no default that nothing sets is an error, and so are two
  // declarations of one name that differ and one of a name kppc sets itself. False, the errors
  // printed, when there is one.
  bool configDeclarations(const std::vector<SourceFile>& files, size_t count, const std::vector<int>& fileLibrary, Options& options,
                          std::map<std::string, ConfigDeclared>& declared)
  {
    std::vector<std::vector<ConfigDeclaration>> found(count);
    std::vector<std::vector<ConfigError>> errors(count);
    parallelFor(count, options.threads, [&](size_t i)
    {
      if (files[i].path.extension() == ".kpp")
        findConfigDeclarations(files[i].text, found[i], errors[i]);
    });
    bool ok = true;
    auto report = [&](const std::string& path, uint32_t line, uint32_t column, const std::string& message)
    {
      fprintf(stderr, "%s: error: %s\n", sourceLocation(path, line, column).c_str(), message.c_str());
      ok = false;
    };
    for (size_t i = 0; i < count; ++i)
    {
      for (const ConfigError& e : errors[i])
        report(files[i].path.string(), e.line, e.column, e.message);
      for (ConfigDeclaration& d : found[i])
      {
        std::string path = files[i].path.string();
        if (i < fileLibrary.size() && fileLibrary[i] >= 0 && !options.libraryRoots[size_t(fileLibrary[i])].name.empty())
          d.name = options.libraryRoots[size_t(fileLibrary[i])].name + "::" + d.name;
        else if (d.name == "debug" || d.name == "platform" || d.name == "platformName" || d.name == "mingw" || d.name == "tests")
        {
          report(path, d.line, d.column, "config::" + d.name + " is kppc's own (--release, --target, --tests): it is not declared in source");
          continue;
        }
        auto [at, added] = declared.insert({d.name, {d, path}});
        const ConfigDeclaration& first = at->second.declaration;
        if (!added && (first.type != d.type || first.value != d.value || first.required != d.required))
          report(path, d.line, d.column,
                 "config::" + d.name + " is declared again, differently: config " + d.type + " " + d.name + (d.required ? "" : " = " + d.value) +
                     " here, config " + first.type + " " + d.name + (first.required ? "" : " = " + first.value) + " at " +
                     sourceLocation(at->second.path, first.line, first.column));
      }
    }
    for (auto& [name, source] : declared)
    {
      const ConfigDeclaration& d = source.declaration;
      auto set = options.configValues.find(name);
      if (set == options.configValues.end())
      {
        if (d.required)
          report(source.path, d.line, d.column,
                 "config::" + name + " (config " + d.type + ") has no default, and nothing sets it: --config " + name + "=VALUE, or kpp's build.kpp");
        else
          options.configValues[name] = parseConfigValue(d.value);
        set = options.configValues.find(name);
        if (set == options.configValues.end())
          continue;
      }
      ConfigValue& v = set->second;
      bool isBool = v.text == "true" || v.text == "false";
      bool fits = d.kind == "bool" ? isBool : d.kind == "int" ? v.isNumber && !isBool : d.kind == "enum" ? !v.isNumber : true;
      if (fits && d.kind == "int")
      {
        // Within its type's range: the declaration's own check (config.cpp) on the value given.
        std::vector<ConfigDeclaration> checked;
        std::vector<ConfigError> wrong;
        std::string probe = "config " + d.type + " x = " + std::to_string(v.number) + ";\n";
        findConfigDeclarations(probe, checked, wrong);
        fits = wrong.empty() && checked.size() == 1;
        if (fits)
          v.text = std::to_string(v.number);
      }
      if (d.kind == "string")
        v.isNumber = false; // compared by its spelling, as a word is
      if (!fits)
        report(source.path, d.line, d.column,
               "--config " + name + "=" + v.text + ": config::" + name + " has the type " + d.type +
                   (d.kind == "bool" ? " (true or false)" : d.kind == "enum" ? " (one of its enumerators, by name)" : ""));
    }
    return ok;
  }

