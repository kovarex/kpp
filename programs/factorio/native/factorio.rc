// The game's resources, as fastbuild/win/icon.rc and Factorio.manifest give them: the manifest (its
// supportedOS entries, without which Windows runs the game as Windows 8, and per-monitor DPI
// awareness) and the icons. fbuild.bff embeds the manifest with link /MANIFEST:EMBED, which needs
// mt.exe; as a resource it needs nothing more. build.cmd compiles this into build/factorio.res, which
// link-settings.cmd links.
1 24 "C:/Factorio/fastbuild/win/Factorio.manifest"
101 ICON "C:/Factorio/data/core/graphics/factorio.ico"
102 ICON "C:/Factorio/data/core/graphics/factorio.ico"
103 PNG "C:/Factorio/data/core/graphics/factorio-icon.png"
