// fontstash and stb_truetype, converted to kpp from Factorio's libraries/fontstash by kpp's
// programs/factorio/convert.cmd (C's rules, kpp --c-sources), which copies this file beside it. A
// scoped library (design.md 16): the game writes its names fontstash::fonsCreateInternal; its C
// functions keep their C names. Rooted at its own directory, whose C headers the game's --ext .kpp
// leaves out.
void build(Project& project)
{
  Library& fontstash = project.library("fontstash");
  fontstash.version = "1.0.0"; // (fontstash.h names none; its stb_truetype.h is v1.22)
  fontstash.root(".");
}
