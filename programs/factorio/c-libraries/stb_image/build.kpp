// stb_image and stb_image_write, converted to kpp from Factorio's libraries/stb_image by kpp's
// programs/factorio/convert.cmd (C's rules, kppc --c-sources), which copies this file beside it. A
// scoped library (design.md 16): the game writes its names stb_image::stbi_load_from_memory; its C
// functions keep their C names. Rooted at its own directory, whose C headers the game's --ext .kpp
// leaves out.
void build(Project& project)
{
  Library& stbImage = project.library("stb_image");
  stbImage.version = "2.22.0"; // (stb_image.hpp's v2.22; stb_image_write.h is v1.09)
  stbImage.root(".");
}
