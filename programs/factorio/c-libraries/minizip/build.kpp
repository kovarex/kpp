// minizip, converted to kpp from Factorio's libraries/minizip by kpp's programs/factorio/convert.cmd
// (C's rules, kppc --c-sources), which copies this file beside it. A scoped library (design.md 16):
// the game writes its names minizip::unzOpen2_64, minizip::UNZ_OK; it uses zlib, its sibling, whose
// names it writes zlib::deflate. Rooted at its own directory, whose C headers the game's `--ext .kpp`
// leaves out.
void build(Project& project)
{
  Library& minizip = project.library("minizip");
  minizip.version = "1.2.0"; // (unzip.h's "Version 1.2.0, September 16th, 2017")
  minizip.root(".");
  minizip.use("zlib", local("../zlib"));
}
