// trio, converted to kpp from Factorio's libraries/trio by kpp's programs/factorio/convert.cmd (C's
// rules, kppc --c-sources), which copies this file beside it. A scoped library (design.md 16): its
// users write its names trio::trio_snprintf; its C functions keep their C names. Rooted at its own
// directory, whose C headers the game's --ext .kpp leaves out.
void build(Project& project)
{
  Library& trio = project.library("trio");
  trio.version = "1.0.0"; // (trio's headers name none)
  trio.root(".");
}
