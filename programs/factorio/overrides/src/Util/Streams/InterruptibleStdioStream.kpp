// Hand-written part of Util/Streams/InterruptibleStdioStream: on Windows, read() took a line with
// std::getline(std::cin, result). kpp has no iostreams (docs/design.md 4), so the line is read
// with the C library's fgets on stdin, piece by piece up to its line break, which is left out as
// getline leaves it; at the end of the input a partial line still counts, an empty one does not.
// Interrupting is as before: unblock() puts an Enter key press into the console's input, which
// ends the line being read (docs/path-to-factorio.md, "Standard input").
bool InterruptibleStdioStream::read(String& result)
{
  this->unblockFlag = false;
  if (!GetStdHandle(STD_INPUT_HANDLE))
  {
    // Factorio server could run in background (without console), don't abort.
    Logging::log("InterruptibleStdioStream.cpp", 68, LogLevel::Notice, "GetStdHandle failed.");
    return false;
  }
  result.clear();
  char buffer[512];
  for (;;)
  {
    if (!fgets(buffer, sizeof(buffer), (FILE*)stdin))
      return !result.empty() && !this->unblockFlag;
    int length = (int)strlen(buffer);
    if (length > 0 && buffer[length - 1] == '\n')
    {
      result.append(buffer, length - 1);
      return !this->unblockFlag;
    }
    result.append(buffer, length);
  }
}
