// eh.h's set_terminate, which install() and setThreadExceptionHandlers() call: kpp's own terminate
// handler (the stdlib's setTerminate), which an exception nobody catches calls, on Windows too since
// thread I's 2b996495, so that the game's TerminateHandler writes its crash report for kpp's
// exceptions. (Until then it was the UCRT's, which only what runs on the C runtime reaches.)
// _set_new_handler is the UCRT's: new.h is a C++ header, which the import does not take, and
// ucrtbase exports it under its C name; kpp's new does not call it (docs/path-to-factorio.md,
// "Structured exception handling").
typedef void (*terminate_handler)();
typedef int (*_PNH)(size_t);
terminate_handler set_terminate(terminate_handler handler) { return setTerminate(handler); }
extern "C" _PNH _set_new_handler(_PNH handler);
