// Hand-written replacements for parts of StringUtil: the UTF-8 and wide conversions are the
// stdlib's platform layer's (UTF-16 on Windows, UTF-32 elsewhere) instead of codecvt, and the trim
// functions index the string instead of using reverse iterators. Every definition here replaces the
// converted one of the same name.

// Global aliases for UTF8 constants that were C macros (used without namespace prefix).
const char* UTF8_BOM = "\xEF\xBB\xBF";
const int UTF8_BOM_LENGTH = 3;
const char* UTF8_BULLET = "\xE2\x80\xA2";

void wstringConvert() = delete; // codecvt is gone: widen and narrow below do the work

namespace StringUtil
{
  WString widen(const char* str, int length) { return platform::widenUtf8(str, length); }

  WString widen(const String& str) { return widen(str.c_str(), str.size()); }
  WString widen(StringView str) { return widen(str.data(), str.size()); }
  WString widen(const WString& str) { return str; }
  WString widen(const char* str) { return widen(str, (int)strlen(str)); }

  String narrow(const wchar_t* str, int length) { return platform::narrowWide(str, length); }

  String narrow(const WString& str) { return narrow(str.c_str(), str.size()); }
  String narrow(wchar_t str) { return narrow(&str, 1); }

  String narrow(const wchar_t* str)
  {
    int length = 0;
    while (str[length] != 0)
      ++length;
    return narrow(str, length);
  }

  String narrow(const char* str) { return str; }

  void trim_right(String& s)
  {
    int end = s.size();
    while (end > 0 && !StringUtil::isNotSpace(s[end - 1]))
      --end;
    s.erase(end);
  }

  void trimNewlines(String& s)
  {
    int end = s.size();
    while (end > 0 && !StringUtil::isNotNewline(s[end - 1]))
      --end;
    s.erase(end);
  }

  void trimBeginingAndEndingNewlines(String& s)
  {
    trimNewlines(s);
    int begin = 0;
    while (begin < s.size() && !StringUtil::isNotNewline(s[begin]))
      ++begin;
    s.erase(0, begin);
  }
}
