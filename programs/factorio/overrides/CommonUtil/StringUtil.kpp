// Hand-written replacements for parts of StringUtil: the UTF-8 and wide conversions are the
// stdlib's platform layer's (UTF-16 on Windows, UTF-32 elsewhere) instead of codecvt, and the trim
// functions index the string instead of using reverse iterators. Every definition here replaces the
// converted one of the same name.

// Global aliases for UTF8 constants that were C macros (used without namespace prefix).
const char* UTF8_BOM = "\xEF\xBB\xBF";
const int UTF8_BOM_LENGTH = 3;
const char* UTF8_BULLET = "\xE2\x80\xA2";

void wstringConvert() = delete; // codecvt is gone: widen and narrow below do the work

namespace StringUtil
{
  std::WString widen(const char* str, int length) { return std::platform::widenUtf8(str, length); }

  std::WString widen(const std::String& str) { return widen(str.c_str(), str.size()); }
  std::WString widen(std::StringView str) { return widen(str.data(), str.size()); }
  std::WString widen(const std::WString& str) { return str; }
  std::WString widen(const char* str) { return widen(str, (int)strlen(str)); }

  std::String narrow(const wchar_t* str, int length) { return std::platform::narrowWide(str, length); }

  std::String narrow(const std::WString& str) { return narrow(str.c_str(), str.size()); }
  std::String narrow(wchar_t str) { return narrow(&str, 1); }

  std::String narrow(const wchar_t* str)
  {
    int length = 0;
    while (str[length] != 0)
      ++length;
    return narrow(str, length);
  }

  std::String narrow(const char* str) { return str; }

  void trim_right(std::String& s)
  {
    int end = s.size();
    while (end > 0 && !StringUtil::isNotSpace(s[end - 1]))
      --end;
    s.erase(end);
  }

  void trimNewlines(std::String& s)
  {
    int end = s.size();
    while (end > 0 && !StringUtil::isNotNewline(s[end - 1]))
      --end;
    s.erase(end);
  }

  void trimBeginingAndEndingNewlines(std::String& s)
  {
    trimNewlines(s);
    int begin = 0;
    while (begin < s.size() && !StringUtil::isNotNewline(s[begin]))
      ++begin;
    s.erase(0, begin);
  }
}
