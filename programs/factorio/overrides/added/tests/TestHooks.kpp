// The hooks of kpp's test runner (design.md 8.7): what tests/Main.cpp, tests/TestRunner.cpp and
// UnitTest++'s Test::Run did around the tests. The runner handles its own options and passes the others
// here: the game's.

void testsSetup(const std::Vector<std::String>& arguments)
{
  std::Vector<char*> argv;
  std::String program = "factorio-test";
  argv.push_back(program.data());
  std::Vector<std::String> copies = arguments;
  // --jobs: each process writes to a directory of its own under --write-data (a log, saves, a lock the
  // game takes), and without that option the processes would share the config's.
  if (i32 worker = testWorker())
  {
    usize at = 0;
    while (at < copies.size() && copies[at] != "--write-data")
      ++at;
    if (at + 1 >= copies.size())
    {
      std::print("factorio-test: --jobs needs --write-data\n");
      ::exit(2);
    }
    copies[at + 1] = toString(copies[at + 1], "/worker-", worker);
    Filesystem::create_directories(Filesystem::Path(copies[at + 1]));
  }
  for (std::String& argument : copies)
    argv.push_back(argument.data());
  if (i32 result = fmain(i32(argv.size()), argv.data()))
    ::exit(result);
}

// The name UnitTest++ gave a test, Suite/Test: the CRC files' key, which a C++ build's run shares. A
// generated test is Suite/Generator_name, and two tests' names are no identifiers (docs/test-suites.md).
private std::String testNameAsUnitTest()
{
  std::String name = std::String(currentTestName());
  usize dot = name.find('.');
  if (dot == std::String::npos)
    return name;
  name[dot] = '/';
  usize generated = name.find('.', dot + 1);
  if (generated != std::String::npos)
    name[generated] = '_';
  if (name == "DragBuilding/UndergroundPipe2x2SmartFixing")
    return "DragBuilding/2x2UndergroundPipeSmartFixing";
  if (name == "ZipPackage/ZipFile4GBWriteRead")
    return "ZipPackage/4GBZipFileWriteRead";
  return name;
}

void testBeforeEach()
{
  crcDumper.open(testNameAsUnitTest());
}

// A desync in a latency test: the test runs again to write the desync report (Test::HandleDesync),
// and its failure comes from that run.
test private void reportDesync(const std::Function<void()>& run, std::StringView what)
{
  if (TestGlobals::desyncReportGenerationRun)
    throw std::RuntimeError("TestGlobals::desyncReportGeneration was true when it should not have been");
  if (!TestGlobals::desyncReportGenerationEnabled)
    fail("Unhandled exception while running test (desync report generation disabled): ", what);
  if (TestGlobals::heavyMode)
    fail("Unhandled exception while running test (desync report generation run disabled in heavy mode): ", what);
  TestGlobals::desyncReportGenerationRun = true;
  std::String fullName = testNameAsUnitTest();
  StringUtil::replace_all(fullName, '/', '-');
  TestGlobals::desyncedTestName = fullName;
  std::String failure;
  try
  {
    run();
    failure = "Desync did not occur during desync detection run.";
  }
  catch (const LatencyTestDesyncErrorHandled& handled)
  {
    TestGlobals::desyncedTestName = "";
    failure = toString("Desync while running test: ", std::StringView(handled.what()));
  }
  catch (const TestEnded&)
  {
    TestGlobals::desyncReportGenerationRun = false;
    throw;
  }
  catch (const std::Exception& e)
  {
    failure = toString("Unhandled exception while running desync detection run.: ", std::StringView(e.what()));
  }
  TestGlobals::desyncReportGenerationRun = false;
  fail(failure);
}

test void testRun(std::Function<void()> run)
{
  try
  {
    run();
  }
  catch (const LatencyTestDesyncError& e)
  {
    reportDesync(run, std::StringView(e.what()));
  }
  catch (const LatencyTestDesyncErrorHandled& e)
  {
    fail("Desync while running test: ", std::StringView(e.what()));
  }
}

test void testAfterEach()
{
  TestRunner::postTestValidation(nullptr);
  if (global && global->appManager && !GlobalContext::headlessMode)
    global->appManager->eraseIf([](AppManagerState* state)
    {
      return !dynamic_cast<InMainMenu*>(state) && !dynamic_cast<InTests*>(state);
    });
}

void testsTeardown()
{
  if (writeCrc)
    crcDumper.writeData(TestGlobals::crcFilePath);
  delete currentRun;
  if constexpr (!config::finalRelease)
    if (Entity::count != 0)
    {
      std::print("leaked ", usize(Entity::count.load()), " entities\n");
      ::abort();
    }
}
