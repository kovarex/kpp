// The hooks of kpp's test runner (design.md 8.7): what tests/Main.cpp, tests/TestRunner.cpp and
// UnitTest++'s Test::Run did around the tests. The runner handles its own options and passes the others
// here: the game's.

void testsSetup(const std::Vector<std::String>& arguments)
{
  std::Vector<char*> argv;
  std::String program = "factorio-test";
  argv.push_back(program.data());
  std::Vector<std::String> copies = arguments;
  // --jobs: each process writes to a directory of its own under --write-data (a log, saves, a lock the
  // game takes), and without that option the processes would share the config's.
  if (i32 worker = testWorker())
  {
    usize at = 0;
    while (at < copies.size() && copies[at] != "--write-data")
      ++at;
    if (at + 1 >= copies.size())
    {
      std::print("factorio-test: --jobs needs --write-data\n");
      ::exit(2);
    }
    copies[at + 1] = std::toString(copies[at + 1], "/worker-", worker);
    Filesystem::create_directories(Filesystem::Path(copies[at + 1]));
  }
  for (std::String& argument : copies)
    argv.push_back(argument.data());
  if (i32 result = fmain(i32(argv.size()), argv.data()))
    ::exit(result);
  // (an earlier run's workers' CRC files, had it ended before merging them: not this run's)
  if (writeCrc && testWorker() == 0)
    for (const Filesystem::Path& part : workerCrcFiles())
      Filesystem::remove(part);
}

// After the runner's own --help: the game's options, as its option parser says them (fmain prints
// them for --help and returns before running anything).
void testsHelp()
{
  std::String program = "factorio-test";
  std::String help = "--help";
  char* argv[] = {program.data(), help.data()};
  if (i32 result = fmain(2, argv))
    ::exit(result);
}

// The name UnitTest++ gave a test, Suite/Test: the CRC files' key, which a C++ build's run shares. A
// generated test is Suite/Generator_name, and two tests' names are no identifiers (docs/test-suites.md).
private std::String testNameAsUnitTest()
{
  std::String name = std::String(currentTestName());
  usize dot = name.find('.');
  if (dot == std::String::npos)
    return name;
  name[dot] = '/';
  usize generated = name.find('.', dot + 1);
  if (generated != std::String::npos)
    name[generated] = '_';
  if (name == "DragBuilding/UndergroundPipe2x2SmartFixing")
    return "DragBuilding/2x2UndergroundPipeSmartFixing";
  if (name == "ZipPackage/ZipFile4GBWriteRead")
    return "ZipPackage/4GBZipFileWriteRead";
  return name;
}

void testBeforeEach()
{
  crcDumper.open(testNameAsUnitTest());
}

// A desync in a latency test: the test runs again to write the desync report (Test::HandleDesync),
// and its failure comes from that run.
test private void reportDesync(const std::Function<void()>& run, std::StringView what)
{
  if (TestGlobals::desyncReportGenerationRun)
    throw std::RuntimeError("TestGlobals::desyncReportGeneration was true when it should not have been");
  if (!TestGlobals::desyncReportGenerationEnabled)
    fail("Unhandled exception while running test (desync report generation disabled): ", what);
  if (TestGlobals::heavyMode)
    fail("Unhandled exception while running test (desync report generation run disabled in heavy mode): ", what);
  TestGlobals::desyncReportGenerationRun = true;
  std::String fullName = testNameAsUnitTest();
  StringUtil::replace_all(fullName, '/', '-');
  TestGlobals::desyncedTestName = fullName;
  std::String failure;
  try
  {
    run();
    failure = "Desync did not occur during desync detection run.";
  }
  catch (const LatencyTestDesyncErrorHandled& handled)
  {
    TestGlobals::desyncedTestName = "";
    failure = std::toString("Desync while running test: ", std::StringView(handled.what()));
  }
  catch (const TestEnded&)
  {
    TestGlobals::desyncReportGenerationRun = false;
    throw;
  }
  catch (const std::Exception& e)
  {
    failure = std::toString("Unhandled exception while running desync detection run.: ", std::StringView(e.what()));
  }
  TestGlobals::desyncReportGenerationRun = false;
  fail(failure);
}

test void testRun(std::Function<void()> run)
{
  try
  {
    run();
  }
  catch (const LatencyTestDesyncError& e)
  {
    reportDesync(run, std::StringView(e.what()));
  }
  catch (const LatencyTestDesyncErrorHandled& e)
  {
    fail("Desync while running test: ", std::StringView(e.what()));
  }
}

test void testAfterEach()
{
  TestRunner::postTestValidation();
  if (global && global->appManager && !GlobalContext::headlessMode)
    global->appManager->eraseIf([](AppManagerState* state)
    {
      return !dynamic_cast<InMainMenu*>(state) && !dynamic_cast<InTests*>(state);
    });
}

// --crc-mode write's file (--crc-file, else crc-values.dat in the working folder), and a --jobs worker's own
// beside it: each process writes the CRCs of the tests it ran, and the first process, which ends after
// its workers, merges theirs into the file, as Factorio's --fork merged each task's (ForkLogic.cpp). They
// all wrote the one file, and the first process, which ran no test, left it empty with exit code 0.
private Filesystem::Path crcFile()
{
  if (!TestGlobals::crcFilePath.empty())
    return TestGlobals::crcFilePath;
  return Filesystem::Path(TestGlobals::workingFolderPath) / CrcDumper::crcFileName;
}

private Filesystem::Path workerCrcFile(i32 worker) { return Filesystem::Path(std::toString(crcFile().string(), ".worker-", worker)); }

// The workers' files beside the CRC file, which the first process merges (an earlier run's too: none
// is left, as each is removed once merged).
private std::Vector<Filesystem::Path> workerCrcFiles()
{
  std::Vector<Filesystem::Path> files;
  Filesystem::Path file = crcFile();
  Filesystem::Path directory = file.has_parent_path() ? file.parent_path() : Filesystem::Path(".");
  std::String prefix = std::toString(file.filename().string(), ".worker-");
  FileUtil::forEachFile(directory, [&](const Filesystem::directory_entry& entry)
  {
    Filesystem::Path path(entry.path());
    if (path.filename().string().rfind(prefix, 0) == 0)
      files.push_back(path);
  });
  return files;
}

private void writeCrcFile()
{
  if (i32 worker = testWorker())
  {
    crcDumper.writeData(workerCrcFile(worker));
    return;
  }
  crcDumper.writeData(crcFile());
  std::Vector<Filesystem::Path> parts = workerCrcFiles();
  if (parts.empty())
    return;
  std::Map<std::String, std::String> all;
  {
    Deserialiser input(FileUtil::openForRead(crcFile()));
    input >> all;
  }
  for (const Filesystem::Path& part : parts)
  {
    std::Map<std::String, std::String> tests;
    {
      Deserialiser input(FileUtil::openForRead(part));
      input >> tests;
    }
    for (auto& [name, crc] : tests)
      all[name] = std::move(crc);
    Filesystem::remove(part);
  }
  Serialiser(FileUtil::openForWrite(crcFile())) << all;
}

void testsTeardown()
{
  if (writeCrc)
    writeCrcFile();
  delete currentRun;
  if constexpr (!config::finalRelease)
    if (Entity::count != 0)
    {
      std::print("leaked ", usize(Entity::count.load()), " entities\n");
      // (AddressSanitizer reports the leaks itself in a sanitized build, as Factorio's __SANITIZE_ADDRESS__)
      if constexpr (!config::sanitizeAddress)
        ::abort();
    }
}
