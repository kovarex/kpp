struct ImDrawList
{
  ImVector<ImDrawCmd> CmdBuffer;
  ImVector<ImDrawIdx> IdxBuffer;
  ImVector<ImDrawVert> VtxBuffer;
  ImDrawListFlags Flags;
  const ImDrawListSharedData* _Data;
  const char* _OwnerName;
  unsigned int _VtxCurrentIdx;
  ImDrawVert* _VtxWritePtr;
  ImDrawIdx* _IdxWritePtr;
  ImVector<ImVec4> _ClipRectStack;
  ImVector<ImTextureID> _TextureIdStack;
  ImVector<ImVec2> _Path;
  int _ChannelsCurrent;
  int _ChannelsCount;
  ImVector<ImDrawChannel> _Channels;
  implicit ImDrawList(const ImDrawListSharedData* shared_data) { kppImDrawList_construct(this, shared_data); }
  ~ImDrawList() { kppImDrawList_destruct(this); }
  void PushClipRect(ImVec2 clip_rect_min, ImVec2 clip_rect_max, bool intersect_with_current_clip_rect = false) { kppImDrawList_PushClipRect(this, &clip_rect_min, &clip_rect_max, intersect_with_current_clip_rect); }
  void PushClipRectFullScreen() { kppImDrawList_PushClipRectFullScreen(this); }
  void PopClipRect() { kppImDrawList_PopClipRect(this); }
  void PushTextureID(const ImTextureID& texture_id) { kppImDrawList_PushTextureID(this, &texture_id); }
  void PopTextureID() { kppImDrawList_PopTextureID(this); }
  ImVec2 GetClipRectMin() const { ImVec2 result; kppImDrawList_GetClipRectMin(&result, this); return result; }
  ImVec2 GetClipRectMax() const { ImVec2 result; kppImDrawList_GetClipRectMax(&result, this); return result; }
  void AddLine(const ImVec2& a, const ImVec2& b, ImU32 col, float thickness = 1.0f) { kppImDrawList_AddLine(this, &a, &b, col, thickness); }
  void AddRect(const ImVec2& a, const ImVec2& b, ImU32 col, float rounding = 0.0f, int rounding_corners_flags = ImDrawCornerFlags_All, float thickness = 1.0f) { kppImDrawList_AddRect(this, &a, &b, col, rounding, rounding_corners_flags, thickness); }
  void AddRectFilled(const ImVec2& a, const ImVec2& b, ImU32 col, float rounding = 0.0f, int rounding_corners_flags = ImDrawCornerFlags_All) { kppImDrawList_AddRectFilled(this, &a, &b, col, rounding, rounding_corners_flags); }
  void AddRectFilledMultiColor(const ImVec2& a, const ImVec2& b, ImU32 col_upr_left, ImU32 col_upr_right, ImU32 col_bot_right, ImU32 col_bot_left) { kppImDrawList_AddRectFilledMultiColor(this, &a, &b, col_upr_left, col_upr_right, col_bot_right, col_bot_left); }
  void AddQuad(const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& d, ImU32 col, float thickness = 1.0f) { kppImDrawList_AddQuad(this, &a, &b, &c, &d, col, thickness); }
  void AddQuadFilled(const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& d, ImU32 col) { kppImDrawList_AddQuadFilled(this, &a, &b, &c, &d, col); }
  void AddTriangle(const ImVec2& a, const ImVec2& b, const ImVec2& c, ImU32 col, float thickness = 1.0f) { kppImDrawList_AddTriangle(this, &a, &b, &c, col, thickness); }
  void AddTriangleFilled(const ImVec2& a, const ImVec2& b, const ImVec2& c, ImU32 col) { kppImDrawList_AddTriangleFilled(this, &a, &b, &c, col); }
  void AddCircle(const ImVec2& centre, float radius, ImU32 col, int num_segments = 12, float thickness = 1.0f) { kppImDrawList_AddCircle(this, &centre, radius, col, num_segments, thickness); }
  void AddCircleFilled(const ImVec2& centre, float radius, ImU32 col, int num_segments = 12) { kppImDrawList_AddCircleFilled(this, &centre, radius, col, num_segments); }
  void AddText(const ImVec2& pos, ImU32 col, const char* text_begin, const char* text_end = nullptr) { kppImDrawList_AddText(this, &pos, col, text_begin, text_end); }
  void AddText(const ImFont* font, float font_size, const ImVec2& pos, ImU32 col, const char* text_begin, const char* text_end = nullptr, float wrap_width = 0.0f, const ImVec4* cpu_fine_clip_rect = nullptr) { kppImDrawList_AddText2(this, font, font_size, &pos, col, text_begin, text_end, wrap_width, cpu_fine_clip_rect); }
  void AddImage(ImTextureID user_texture_id, const ImVec2& a, const ImVec2& b, const ImVec2& uv_a = ImVec2(0,0), const ImVec2& uv_b = ImVec2(1,1), ImU32 col = 0xFFFFFFFF) { kppImDrawList_AddImage(this, user_texture_id, &a, &b, &uv_a, &uv_b, col); }
  void AddImageQuad(ImTextureID user_texture_id, const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& d, const ImVec2& uv_a = ImVec2(0,0), const ImVec2& uv_b = ImVec2(1,0), const ImVec2& uv_c = ImVec2(1,1), const ImVec2& uv_d = ImVec2(0,1), ImU32 col = 0xFFFFFFFF) { kppImDrawList_AddImageQuad(this, user_texture_id, &a, &b, &c, &d, &uv_a, &uv_b, &uv_c, &uv_d, col); }
  void AddImageRounded(ImTextureID user_texture_id, const ImVec2& a, const ImVec2& b, const ImVec2& uv_a, const ImVec2& uv_b, ImU32 col, float rounding, int rounding_corners = ImDrawCornerFlags_All) { kppImDrawList_AddImageRounded(this, user_texture_id, &a, &b, &uv_a, &uv_b, col, rounding, rounding_corners); }
  void AddPolyline(const ImVec2* points, const int num_points, ImU32 col, bool closed, float thickness) { kppImDrawList_AddPolyline(this, points, num_points, col, closed, thickness); }
  void AddConvexPolyFilled(const ImVec2* points, const int num_points, ImU32 col) { kppImDrawList_AddConvexPolyFilled(this, points, num_points, col); }
  void AddBezierCurve(const ImVec2& pos0, const ImVec2& cp0, const ImVec2& cp1, const ImVec2& pos1, ImU32 col, float thickness, int num_segments = 0) { kppImDrawList_AddBezierCurve(this, &pos0, &cp0, &cp1, &pos1, col, thickness, num_segments); }
  void PathClear() { kppImDrawList_PathClear(this); }
  void PathLineTo(const ImVec2& pos) { kppImDrawList_PathLineTo(this, &pos); }
  void PathLineToMergeDuplicate(const ImVec2& pos) { kppImDrawList_PathLineToMergeDuplicate(this, &pos); }
  void PathFillConvex(ImU32 col) { kppImDrawList_PathFillConvex(this, col); }
  void PathStroke(ImU32 col, bool closed, float thickness = 1.0f) { kppImDrawList_PathStroke(this, col, closed, thickness); }
  void PathArcTo(const ImVec2& centre, float radius, float a_min, float a_max, int num_segments = 10) { kppImDrawList_PathArcTo(this, &centre, radius, a_min, a_max, num_segments); }
  void PathArcToFast(const ImVec2& centre, float radius, int a_min_of_12, int a_max_of_12) { kppImDrawList_PathArcToFast(this, &centre, radius, a_min_of_12, a_max_of_12); }
  void PathBezierCurveTo(const ImVec2& p1, const ImVec2& p2, const ImVec2& p3, int num_segments = 0) { kppImDrawList_PathBezierCurveTo(this, &p1, &p2, &p3, num_segments); }
  void PathRect(const ImVec2& rect_min, const ImVec2& rect_max, float rounding = 0.0f, int rounding_corners_flags = ImDrawCornerFlags_All) { kppImDrawList_PathRect(this, &rect_min, &rect_max, rounding, rounding_corners_flags); }
  void ChannelsSplit(int channels_count) { kppImDrawList_ChannelsSplit(this, channels_count); }
  void ChannelsMerge() { kppImDrawList_ChannelsMerge(this); }
  void ChannelsSetCurrent(int channel_index) { kppImDrawList_ChannelsSetCurrent(this, channel_index); }
  void AddCallback(ImDrawCallback callback, void* callback_data) { kppImDrawList_AddCallback(this, callback, callback_data); }
  void AddDrawCmd() { kppImDrawList_AddDrawCmd(this); }
  void Clear() { kppImDrawList_Clear(this); }
  void ClearFreeMemory() { kppImDrawList_ClearFreeMemory(this); }
  void PrimReserve(int idx_count, int vtx_count) { kppImDrawList_PrimReserve(this, idx_count, vtx_count); }
  void PrimRect(const ImVec2& a, const ImVec2& b, ImU32 col) { kppImDrawList_PrimRect(this, &a, &b, col); }
  void PrimRectUV(const ImVec2& a, const ImVec2& b, const ImVec2& uv_a, const ImVec2& uv_b, ImU32 col) { kppImDrawList_PrimRectUV(this, &a, &b, &uv_a, &uv_b, col); }
  void PrimQuadUV(const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& d, const ImVec2& uv_a, const ImVec2& uv_b, const ImVec2& uv_c, const ImVec2& uv_d, ImU32 col) { kppImDrawList_PrimQuadUV(this, &a, &b, &c, &d, &uv_a, &uv_b, &uv_c, &uv_d, col); }
  void PrimWriteVtx(const ImVec2& pos, const ImVec2& uv, ImU32 col) { kppImDrawList_PrimWriteVtx(this, &pos, &uv, col); }
  void PrimWriteIdx(ImDrawIdx idx) { kppImDrawList_PrimWriteIdx(this, idx); }
  void PrimVtx(const ImVec2& pos, const ImVec2& uv, ImU32 col) { kppImDrawList_PrimVtx(this, &pos, &uv, col); }
  void UpdateClipRect() { kppImDrawList_UpdateClipRect(this); }
  void UpdateTextureID() { kppImDrawList_UpdateTextureID(this); }
};

