struct ImFontAtlas
{
  struct GlyphRangesBuilder
  {
    ImVector<unsigned char> UsedChars;
    GlyphRangesBuilder() { kppImFontAtlas_GlyphRangesBuilder_construct(this); }
    bool GetBit(int n) { return kppImFontAtlas_GlyphRangesBuilder_GetBit(this, n); }
    void SetBit(int n) { kppImFontAtlas_GlyphRangesBuilder_SetBit(this, n); }
    void AddChar(ImWchar c) { kppImFontAtlas_GlyphRangesBuilder_AddChar(this, c); }
    void AddText(const char* text, const char* text_end = nullptr) { kppImFontAtlas_GlyphRangesBuilder_AddText(this, text, text_end); }
    void AddRanges(const ImWchar* ranges) { kppImFontAtlas_GlyphRangesBuilder_AddRanges(this, ranges); }
    void BuildRanges(ImVector<ImWchar>* out_ranges) { kppImFontAtlas_GlyphRangesBuilder_BuildRanges(this, out_ranges); }
  };
  struct CustomRect
  {
    unsigned int ID;
    unsigned short Width;
    unsigned short Height;
    unsigned short X;
    unsigned short Y;
    float GlyphAdvanceX;
    ImVec2 GlyphOffset;
    ImFont* Font;
    CustomRect() { kppImFontAtlas_CustomRect_construct(this); }
    bool IsPacked() const { return kppImFontAtlas_CustomRect_IsPacked(this); }
  };
  ImTextureID TexID;
  int TexDesiredWidth;
  int TexGlyphPadding;
  unsigned char* TexPixelsAlpha8;
  unsigned int* TexPixelsRGBA32;
  int TexWidth;
  int TexHeight;
  ImVec2 TexUvWhitePixel;
  ImVector<ImFont* > Fonts;
  ImVector<CustomRect> CustomRects;
  ImVector<ImFontConfig> ConfigData;
  int CustomRectIds[1];
  ImFontAtlas() { kppImFontAtlas_construct(this); }
  ~ImFontAtlas() { kppImFontAtlas_destruct(this); }
  ImFont* AddFont(const ImFontConfig* font_cfg) { return kppImFontAtlas_AddFont(this, font_cfg); }
  ImFont* AddFontDefault(const ImFontConfig* font_cfg = nullptr) { return kppImFontAtlas_AddFontDefault(this, font_cfg); }
  ImFont* AddFontFromFileTTF(const char* filename, float size_pixels, const ImFontConfig* font_cfg = nullptr, const ImWchar* glyph_ranges = nullptr) { return kppImFontAtlas_AddFontFromFileTTF(this, filename, size_pixels, font_cfg, glyph_ranges); }
  ImFont* AddFontFromMemoryTTF(void* font_data, int font_size, float size_pixels, const ImFontConfig* font_cfg = nullptr, const ImWchar* glyph_ranges = nullptr) { return kppImFontAtlas_AddFontFromMemoryTTF(this, font_data, font_size, size_pixels, font_cfg, glyph_ranges); }
  ImFont* AddFontFromMemoryCompressedTTF(const void* compressed_font_data, int compressed_font_size, float size_pixels, const ImFontConfig* font_cfg = nullptr, const ImWchar* glyph_ranges = nullptr) { return kppImFontAtlas_AddFontFromMemoryCompressedTTF(this, compressed_font_data, compressed_font_size, size_pixels, font_cfg, glyph_ranges); }
  ImFont* AddFontFromMemoryCompressedBase85TTF(const char* compressed_font_data_base85, float size_pixels, const ImFontConfig* font_cfg = nullptr, const ImWchar* glyph_ranges = nullptr) { return kppImFontAtlas_AddFontFromMemoryCompressedBase85TTF(this, compressed_font_data_base85, size_pixels, font_cfg, glyph_ranges); }
  void ClearTexData() { kppImFontAtlas_ClearTexData(this); }
  void ClearInputData() { kppImFontAtlas_ClearInputData(this); }
  void ClearFonts() { kppImFontAtlas_ClearFonts(this); }
  void Clear() { kppImFontAtlas_Clear(this); }
  bool Build() { return kppImFontAtlas_Build(this); }
  void GetTexDataAsAlpha8(unsigned char** out_pixels, int* out_width, int* out_height, int* out_bytes_per_pixel = nullptr) { kppImFontAtlas_GetTexDataAsAlpha8(this, out_pixels, out_width, out_height, out_bytes_per_pixel); }
  void GetTexDataAsRGBA32(unsigned char** out_pixels, int* out_width, int* out_height, int* out_bytes_per_pixel = nullptr) { kppImFontAtlas_GetTexDataAsRGBA32(this, out_pixels, out_width, out_height, out_bytes_per_pixel); }
  void SetTexID(ImTextureID id) { kppImFontAtlas_SetTexID(this, id); }
  const ImWchar* GetGlyphRangesDefault() { return kppImFontAtlas_GetGlyphRangesDefault(this); }
  const ImWchar* GetGlyphRangesKorean() { return kppImFontAtlas_GetGlyphRangesKorean(this); }
  const ImWchar* GetGlyphRangesJapanese() { return kppImFontAtlas_GetGlyphRangesJapanese(this); }
  const ImWchar* GetGlyphRangesChinese() { return kppImFontAtlas_GetGlyphRangesChinese(this); }
  const ImWchar* GetGlyphRangesCyrillic() { return kppImFontAtlas_GetGlyphRangesCyrillic(this); }
  const ImWchar* GetGlyphRangesThai() { return kppImFontAtlas_GetGlyphRangesThai(this); }
  int AddCustomRectRegular(unsigned int id, int width, int height) { return kppImFontAtlas_AddCustomRectRegular(this, id, width, height); }
  int AddCustomRectFontGlyph(ImFont* font, ImWchar id, int width, int height, float advance_x, const ImVec2& offset = ImVec2(0,0)) { return kppImFontAtlas_AddCustomRectFontGlyph(this, font, id, width, height, advance_x, &offset); }
  void CalcCustomRectUV(const CustomRect* rect, ImVec2* out_uv_min, ImVec2* out_uv_max) { kppImFontAtlas_CalcCustomRectUV(this, rect, out_uv_min, out_uv_max); }
  const CustomRect* GetCustomRectByIndex(int index) const { return kppImFontAtlas_GetCustomRectByIndex(this, index); }
};

struct ImFont
{
  using Glyph = ImFontGlyph;
  float FontSize;
  float Scale;
  ImVec2 DisplayOffset;
  ImVector<ImFontGlyph> Glyphs;
  ImVector<float> IndexAdvanceX;
  ImVector<unsigned short> IndexLookup;
  const ImFontGlyph* FallbackGlyph;
  float FallbackAdvanceX;
  ImWchar FallbackChar;
  short ConfigDataCount;
  ImFontConfig* ConfigData;
  ImFontAtlas* ContainerAtlas;
  float Ascent;
  float Descent;
  int MetricsTotalSurface;
  ImFont() { kppImFont_construct(this); }
  ~ImFont() { kppImFont_destruct(this); }
  void ClearOutputData() { kppImFont_ClearOutputData(this); }
  void BuildLookupTable() { kppImFont_BuildLookupTable(this); }
  const ImFontGlyph* FindGlyph(ImWchar c) const { return kppImFont_FindGlyph(this, c); }
  void SetFallbackChar(ImWchar c) { kppImFont_SetFallbackChar(this, c); }
  float GetCharAdvance(ImWchar c) const { return kppImFont_GetCharAdvance(this, c); }
  bool IsLoaded() const { return kppImFont_IsLoaded(this); }
  const char* GetDebugName() const { return kppImFont_GetDebugName(this); }
  ImVec2 CalcTextSizeA(float size, float max_width, float wrap_width, const char* text_begin, const char* text_end = nullptr, const char** remaining = nullptr) const { ImVec2 result; kppImFont_CalcTextSizeA(&result, this, size, max_width, wrap_width, text_begin, text_end, remaining); return result; }
  const char* CalcWordWrapPositionA(float scale, const char* text, const char* text_end, float wrap_width) const { return kppImFont_CalcWordWrapPositionA(this, scale, text, text_end, wrap_width); }
  void RenderChar(ImDrawList* draw_list, float size, ImVec2 pos, ImU32 col, unsigned short c) const { kppImFont_RenderChar(this, draw_list, size, &pos, col, c); }
  void RenderText(ImDrawList* draw_list, float size, ImVec2 pos, ImU32 col, const ImVec4& clip_rect, const char* text_begin, const char* text_end, float wrap_width = 0.0f, bool cpu_fine_clip = false) const { kppImFont_RenderText(this, draw_list, size, &pos, col, &clip_rect, text_begin, text_end, wrap_width, cpu_fine_clip); }
  void GrowIndex(int new_size) { kppImFont_GrowIndex(this, new_size); }
  void AddGlyph(ImWchar c, float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1, float advance_x) { kppImFont_AddGlyph(this, c, x0, y0, x1, y1, u0, v0, u1, v1, advance_x); }
  void AddRemapChar(ImWchar dst, ImWchar src, bool overwrite_dst = true) { kppImFont_AddRemapChar(this, dst, src, overwrite_dst); }
};

static_assert(sizeof(ImVec2) == 8);
static_assert(sizeof(ImVec4) == 16);
static_assert(sizeof(ImColor) == 16);
static_assert(sizeof(ImVector<int>) == 16);
static_assert(sizeof(ImGuiStyle) == 836);
static_assert(sizeof(ImGuiIO) == 5144);
static_assert(sizeof(ImGuiTextEditCallbackData) == 56);
static_assert(sizeof(ImGuiSizeConstraintCallbackData) == 32);
static_assert(sizeof(ImGuiPayload) == 40);
static_assert(sizeof(ImGuiListClipper) == 24);
static_assert(sizeof(ImDrawCmd) == 48);
static_assert(sizeof(ImDrawVert) == 20);
static_assert(sizeof(ImDrawChannel) == 32);
static_assert(sizeof(ImDrawList) == 168);
static_assert(sizeof(ImDrawData) == 32);
static_assert(sizeof(ImFontConfig) == 120);
static_assert(sizeof(ImFontGlyph) == 40);
static_assert(sizeof(ImFontAtlas) == 104);
static_assert(sizeof(ImFontAtlas::GlyphRangesBuilder) == 16);
static_assert(sizeof(ImFontAtlas::CustomRect) == 32);
static_assert(sizeof(ImFont) == 112);

