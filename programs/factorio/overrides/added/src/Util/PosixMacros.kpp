requires config::platform == Platform::Linux;
// glibc's function-like macros the game's Linux code calls, written as kpp functions (kovarex, 2026-11-05:
// option B; design.md 5: the C import takes no function-like macro): sys/wait.h's status macros
// (ChildProcessAgent.cpp) and arpa/nameser.h's accessors of a parsed DNS message (SocketAddress.cpp's
// SRV lookup), each what the macro expands to.

// sys/wait.h (bits/waitstatus.h)
i32 WEXITSTATUS(i32 status) { return (status & 0xff00) >> 8; }
i32 WTERMSIG(i32 status) { return status & 0x7f; }
bool WIFEXITED(i32 status) { return WTERMSIG(status) == 0; }
bool WIFSIGNALED(i32 status) { return i8(((status & 0x7f) + 1)) >> 1 > 0; }

// arpa/nameser.h
const u_char* ns_msg_base(const ns_msg& handle) { return handle._msg; }
const u_char* ns_msg_end(const ns_msg& handle) { return handle._eom; }
u16 ns_msg_count(const ns_msg& handle, ns_sect section) { return handle._counts[section]; }
ns_type ns_rr_type(const ns_rr& rr) { return ns_type(rr.type); }
const u_char* ns_rr_rdata(const ns_rr& rr) { return rr.rdata; }
