// UnitTest++'s CHECK_INTERNAL (CheckMacros.h) as one function. The macro wrote its try and three
// catches out at each of the tests' checks (about 50,000); the conversion writes each check as a call
// of checkInternal instead (convert.cpp's replacedMacroBodies), with the condition and the check's id
// in lambdas called where the macro evaluates them: the condition inside the try, the id only when
// the check fails. A check whose id is nullptr calls the overload without one.

// The macro's BREAK_UNDER_DEBUGGER: MSVC's IsDebuggerPresent and DebugBreak on Windows (windows.h,
// imported by CheckInternalWindows.kpp), nothing elsewhere, as CheckMacros.h has it (the tests'
// TestTCPSocket override calls it too).
bool breakUnderDebugger()
{
  if constexpr (config::platform == Platform::Windows)
    return IsDebuggerPresent() && (DebugBreak(), true);
  return false;
}

// The id's text, as the macro's `UNIT_TEST_ID_OUT_stream << (id)`.
private void checkIdText(UnitTest::MemoryOutStream& stream, const UnitTest::CheckId* id)
{
  if (id)
    id->write(id->id, stream);
  else
    stream << (nullptr);
}

private void checkWith(const UnitTest::CheckCondition& condition, char const* filename, i32 line, const UnitTest::CheckId* id)
{
  try
  {
    UnitTest::MemoryOutStream CHECK_INTERNAL_stream;
    if (!condition.evaluate(condition.condition, CHECK_INTERNAL_stream))
    {
      breakUnderDebugger();
      UnitTest::MemoryOutStream UNIT_TEST_ID_OUT_stream;
      checkIdText(UNIT_TEST_ID_OUT_stream, id);
      UnitTest::CurrentTest::onTestFailure(filename, line, UNIT_TEST_ID_OUT_stream.GetText(), CHECK_INTERNAL_stream.GetText());
    }
  }
  catch (UnitTest::TerminateTestException const&)
  {
    throw;
  }
  catch (const std::Exception& e)
  {
    breakUnderDebugger();
    MemoryOutStream UNIT_TEST_MEMORY_OUT_stream;
    UNIT_TEST_MEMORY_OUT_stream << "Unhandled exception in check macro: " << e.what();
    MemoryOutStream UNIT_TEST_ID_OUT_stream;
    checkIdText(UNIT_TEST_ID_OUT_stream, id);
    UnitTest::CurrentTest::onTestFailure(filename, line, UNIT_TEST_ID_OUT_stream.GetText(), UNIT_TEST_MEMORY_OUT_stream.GetText());
  }
  catch (...)
  {
    breakUnderDebugger();
    MemoryOutStream UNIT_TEST_ID_OUT_stream;
    checkIdText(UNIT_TEST_ID_OUT_stream, id);
    UnitTest::CurrentTest::onTestFailure(filename, line, UNIT_TEST_ID_OUT_stream.GetText(), "Unhandled exception in check macro");
  }
}

namespace UnitTest
{
  // A check's condition: a lambda taking the check's stream, referred to for the time of the call.
  struct CheckCondition
  {
    const void* condition;
    bool (*evaluate)(const void*, MemoryOutStream&);

    template<typename F>
    implicit CheckCondition(const F& f) : condition(&f), evaluate(&CheckCondition::evaluateAs<F>) {}

    template<typename F>
    static bool evaluateAs(const void* f, MemoryOutStream& stream)
    {
      return (*static_cast<const F*>(f))(stream);
    }
  };

  // A check's id: a lambda writing it to a stream.
  struct CheckId
  {
    const void* id;
    void (*write)(const void*, MemoryOutStream&);

    template<typename F>
    implicit CheckId(const F& f) : id(&f), write(&CheckId::writeAs<F>) {}

    template<typename F>
    static void writeAs(const void* f, MemoryOutStream& stream)
    {
      (*static_cast<const F*>(f))(stream);
    }
  };

  void checkInternal(const CheckCondition& condition, char const* filename, i32 line)
  {
    checkWith(condition, filename, line, nullptr);
  }

  void checkInternal(const CheckCondition& condition, char const* filename, i32 line, const CheckId& id)
  {
    checkWith(condition, filename, line, &id);
  }
}
