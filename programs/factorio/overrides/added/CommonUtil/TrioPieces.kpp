// The game's floating text as its C++ build writes it: CommonUtil's ssprintf formats with trio
// (StringUtil.cpp's trio_vsnprintf), whose %f, %g and %e round as trio does, not as the C runtime
// (`%f` of 1.4140625 is "1.414063", a tie away from zero; `%.16f` of a double can differ in its last
// digit from the exact rounding). The stdlib's fixed, significant and scientific are the exact text
// (docs/stdlib/text.md); the printf rewrite (design.md 14) writes these pieces instead for the
// floating conversions of ssprintf and of the functions that format through it, so that the game's
// text, which its saves and checksums hold, stays the C++ build's. trio is a scoped library (kpp's
// design.md 16): its names are trio::trio_snprintf.

struct TrioFloating
{
  double value;
  int precision;
  char conversion; // 'f', 'g' or 'e'

  void appendTo(String& out) const
  {
    char format[5] = {'%', '.', '*', this->conversion, 0};
    char buffer[512];
    int written = trio::trio_snprintf(buffer, sizeof(buffer), format, this->precision, this->value);
    if (written < 0)
      return;
    if (size_t(written) < sizeof(buffer))
    {
      out.append(buffer, size_t(written));
      return;
    }
    // (%f of a large value: its digits, all of them)
    String longer(size_t(written) + 1, '\0');
    trio::trio_snprintf(longer.data(), longer.size(), format, this->precision, this->value);
    out.append(longer.data(), size_t(written));
  }
};

// %.Nf, %.Ng and %.Ne as trio writes them.
TrioFloating trioFixed(double value, int precision) { return TrioFloating{value, precision, 'f'}; }
TrioFloating trioSignificant(double value, int precision) { return TrioFloating{value, precision, 'g'}; }
TrioFloating trioScientific(double value, int precision) { return TrioFloating{value, precision, 'e'}; }
