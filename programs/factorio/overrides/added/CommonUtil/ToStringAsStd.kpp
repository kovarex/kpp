// std::to_string's text, for the converted calls whose argument's type the conversion does not know
// or is one kpp's toString writes otherwise (convert.cpp's stdToString). C++'s overloads take an
// integer, which a bool, a char and an unscoped enumeration are promoted to (true is "1"), or a
// floating value, written as C's %f, six decimals ("0.100000"); kpp's toString writes a bool as
// true, a char as the character, an enumeration as its enumerator's name and a floating value as
// its shortest text.
template<typename T>
std::String toStringAsStd(T value)
{
  if constexpr (std::isFloatingPoint<T>)
    return std::toString(std::fixed(value, 6));
  else if constexpr (std::isEnum<T>)
    return toStringAsStd(static_cast<std::UnderlyingType<T>>(value));
  else if constexpr (std::isSame<T, bool> || std::isSame<T, char>)
    return std::toString(i32(value));
  else
    return std::toString(value);
}
