// The C++ test listens on the fixed port 12345, and TCPSocket::bind sets SO_REUSEADDR, with which
// Windows lets a second process bind that port too: two runs of the tests at once (two worktrees)
// connect into each other's listeners and hang or crash. Each run here listens on a port of its own,
// one the system hands out (bound to port 0 and read back); the tests check what the C++ ones do.

namespace SuiteTCPSocket
{
  // A port no socket has bound: the one the system gives a socket bound to port 0. Winsock is started
  // here as well, as SocketCppCompatibility's starter may be built after this file's globals.
  // The probe is closed before the tests bind the port (TCPSocket::bind makes a socket of its own),
  // so until then another process could take it: one binding that port by number, as the system
  // gives the next bind to port 0 the following free port, not the one just released.
  uint16_t freePort()
  {
    WSADATA wsaData;
    if (WSAStartup(0x0202, &wsaData) != 0)
      throw SocketError("WSAStartup failed");
    SOCKET probe = ::socket(AF_INET, SOCK_STREAM, 0);
    if (probe == (SOCKET)(~0)) // INVALID_SOCKET
      throw SocketError("Creating socket failed: " + lastSocketErrorString());
    sockaddr_in address = {};
    address.sin_family = AF_INET;
    int length = sizeof address;
    if (::bind(probe, (sockaddr*)&address, length) == SOCKET_ERROR || getsockname(probe, (sockaddr*)&address, &length) == SOCKET_ERROR)
      throw SocketError("Can't find a free port: " + lastSocketErrorString());
    ::closesocket(probe);
    WSACleanup();
    return ntohs(address.sin_port);
  }

  uint16_t testPort = freePort();
  String ipv4ListenOnAddressText = "0.0.0.0:" + toString(testPort);
  String ipv4AddressText = "127.0.0.1:" + toString(testPort);
  String ipv6ListenOnAddressText = "[::]:" + toString(testPort);
  String ipv6AddressText = "[::1]:" + toString(testPort);
  const char* ipv4ListenOnAddress = ipv4ListenOnAddressText.c_str();
  const char* ipv4Address = ipv4AddressText.c_str();
  const char* ipv6ListenOnAddress = ipv6ListenOnAddressText.c_str();
  const char* ipv6Address = ipv6AddressText.c_str();

  // The failure at the C++ test's line, as CHECK reports it.
  void failAt(int line, const char* failure)
  {
    UnitTest::MemoryOutStream id;
    id << (nullptr);
    UnitTest::CurrentTest::onTestFailure("TestTCPSocket.cpp", line, id.GetText(), failure);
  }

  // CHECK(condition) at the C++ test's line, as UnitTest++ expands it.
  template<typename F> void checkAt(int line, const char* text, F condition)
  {
    try
    {
      UnitTest::MemoryOutStream stream;
      if (!UnitTest::CheckBoolean(text, !!condition(), stream))
      {
        (IsDebuggerPresent() && (DebugBreak(), true));
        failAt(line, stream.GetText());
      }
    }
    catch (UnitTest::TerminateTestException const&)
    {
      throw;
    }
    catch (const Exception& e)
    {
      (IsDebuggerPresent() && (DebugBreak(), true));
      UnitTest::MemoryOutStream stream;
      stream << "Unhandled exception in check macro: " << e.what();
      failAt(line, stream.GetText());
    }
    catch (...)
    {
      (IsDebuggerPresent() && (DebugBreak(), true));
      failAt(line, "Unhandled exception in check macro");
    }
  }

  void abortAccept()
  {
    TCPSocket socket;
    socket.bind(SocketAddress(ipv4ListenOnAddress, SocketType::Socket));
    socket.listen();

    Atomic<bool> finished;
    finished = false;

    Thread t([&]
    {
      TCPSocket accepted;
      checkAt(160, "!socket.accept(accepted)", [&] { return !socket.accept(accepted); });
      finished = true;
    });

    thisThread::sleep_for(Milliseconds(500));

    checkAt(167, "!finished", [&] { return !finished; });

    socket.unblock();
    t.join();

    checkAt(172, "finished", [&] { return bool(finished); });

    socket.close();
  }
}
