// The Lua internals the game reaches into, as converted code reaches them: through
// native/include/kpp_lua_internals.h, which imports the game's lobject.h, lstate.h and ltable.h as C.
// First the layout, which must be the C++ build's (lua_internals_smoke.cpp, whose output is
// lua_internals_smoke.expected), Udata's `class LuaBindableObject*` read as a struct pointer
// included; then a real Lua state's table and userdata read through index2addr and the fields that
// the game's macros (hvalue, ttisnil, nvalue, gkey, gval, uvalue, ...) expand to, and luaH_getint,
// which has C++ linkage in lua.lib (native/header_only.c gives it its C name).
extern "C" import "stdio.h";
extern "C" import "lua.h";
extern "C" import "lauxlib.h";
extern "C" import "lualib.h";
extern "C" import "kpp_lua_internals.h";

// The game's class, which Udata points to (here only its address matters).
class LuaBindableObject
{
public:
  int id = 0;
};
LuaBindableObject bindable;

int offset(const void* object, const void* member) { return (int)((const char*)member - (const char*)object); }

int main()
{
  TValue value;
  Udata userdata;
  Table table;
  Node node;
  lua_State state;
  printf("TValue %d tt_ %d\n", (int)sizeof(TValue), offset(&value, &value.tt_));
  printf("Udata %d metatable %d env %d factorioBindableObject %d len %d\n", (int)sizeof(Udata), offset(&userdata, &userdata.uv.metatable),
         offset(&userdata, &userdata.uv.env), offset(&userdata, &userdata.uv.factorioBindableObject), offset(&userdata, &userdata.uv.len));
  printf("Table %d array %d node %d sizearray %d firstadded %d lastadded %d\n", (int)sizeof(Table), offset(&table, &table.array),
         offset(&table, &table.node), offset(&table, &table.sizearray), offset(&table, &table.firstadded), offset(&table, &table.lastadded));
  printf("Node %d i_key %d next %d prev %d\n", (int)sizeof(Node), offset(&node, &node.i_key), offset(&node, &node.next), offset(&node, &node.prev));
  printf("lua_State %d top %d l_G %d\n", (int)sizeof(lua_State), offset(&state, &state.top), offset(&state, &state.l_G));

  // A table with an array part and two keys, read through index2addr and the accessors' fields.
  lua_State* L = luaL_newstate();
  lua_createtable(L, 4, 0);
  for (int i = 1; i <= 4; ++i)
  {
    lua_pushnumber(L, (double)(i * 10));
    lua_rawseti(L, -2, i);
  }
  lua_pushstring(L, "x");
  lua_pushnumber(L, 7.0);
  lua_rawset(L, -3);
  lua_pushstring(L, "y");
  lua_pushnumber(L, 8.0);
  lua_rawset(L, -3);
  Table* t = &index2addr(L, -1)->value_.gc->h; // hvalue
  double sum = 0;
  for (int i = 0; i < t->sizearray; ++i)
    if (t->array[i].tt_ != LUA_TNIL) // !ttisnil
      sum += t->array[i].value_.n; // nvalue
  printf("sizearray %d sum %g istable %d\n", t->sizearray, sum, (int)(index2addr(L, -1)->tt_ == (LUA_TTABLE | BIT_ISCOLLECTABLE)));
  for (Node* n = t->firstadded; n; n = n->next)
    printf("%s=%g ", (const char*)(&n->i_key.tvk.value_.gc->ts + 1), n->i_val.value_.n); // getstr(rawtsvalue(gkey(n))), nvalue(gval(n))
  printf("\n");
  printf("luaH_getint 2: %g\n", luaH_getint(L, t, 2)->value_.n);

  // A full userdata and the game's pointer to its bound object (uvalue).
  lua_newuserdata(L, 0);
  index2addr(L, -1)->value_.gc->u.uv.factorioBindableObject = &bindable;
  Udata* raw = &index2addr(L, -1)->value_.gc->u;
  printf("userdata bound %d payload after header %d\n", (int)(raw->uv.factorioBindableObject == &bindable),
         offset(raw, lua_touserdata(L, -1)));
  lua_close(L);
  return 0;
}
