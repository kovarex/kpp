// Stand-in for CommonUtil's SystemClipboard in the smoke tests: the real one talks to SDL, which
// the tests do not link; this one is a clipboard private to the process.
namespace SystemClipboard
{
  std::String contents;

  void copy(const std::String& input) { contents = input; }

  std::String paste(bool filterNewlines)
  {
    std::String result;
    for (int i = 0; i < contents.size(); ++i)
    {
      char c = contents[i];
      if (c == '\t')
        result << "    ";
      else if (c == '\n' && filterNewlines)
        result << ' ';
      else if (c != '\r')
        result << c;
    }
    return result;
  }
}
