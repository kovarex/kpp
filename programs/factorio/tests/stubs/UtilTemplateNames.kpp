// Stand-ins for what the Util subset's templates name without depending on their parameters, for
// the Util smoke test: such a name nothing declares is an error at the template's definition,
// whether or not the template is used (C++ [temp.res]), and the game's RuntimeError.kpp and
// Prefetch.kpp pull in far more than the test needs (SmallBitset throws RuntimeError,
// RadixSort prefetches).
class RuntimeError : public std::RuntimeError
{
public:
  RuntimeError(const char* message) : std::RuntimeError(std::String(message)) {}
};

void inline prefetch(const void* p) {}

// The game's classes the Util subset's templates name in their signatures (Optional's loading and
// saving constructors and members, ScopedEntityStorage's element): declared only, as nothing the test
// instantiates uses them (kpp checks that a type name a template names is declared, fb6568df8).
class Deserialiser;
class MapDeserialiser;
class Serialiser;
class MapSerialiser;
class PropertyTree;
class Entity;
