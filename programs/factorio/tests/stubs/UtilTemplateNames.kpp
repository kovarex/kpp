// Stand-ins for what the Util subset's templates name without depending on their parameters, for
// the Util smoke test: such a name nothing declares is an error at the template's definition,
// whether or not the template is used (C++ [temp.res]), and the game's RuntimeError.kpp and
// Prefetch.kpp pull in far more than the test needs (SmallBitset throws GameRuntimeError,
// RadixSort prefetches).
class GameRuntimeError : public ::RuntimeError
{
public:
  explicit GameRuntimeError(const char* message) : ::RuntimeError(String(message)) {}
};

void inline prefetch(const void* p) {}
