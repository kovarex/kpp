// A smoke test of the converted CommonUtil: compiled together with programs/factorio/kpp by
// convert.cmd and run; the output is compared with smoke.expected. It exercises what the
// converter and the hand-written overrides produced, end to end through kpp.
extern "C" int printf(const char* format, ...);

int main()
{
  // StringUtil: trimming, case, search, splitting, formatting
  std::String s = "  hello world  ";
  StringUtil::trim(s);
  printf("[%s]\n", s.c_str());
  std::String lines = "\n\nabc\n\n";
  StringUtil::trimBeginingAndEndingNewlines(lines);
  printf("[%s]\n", lines.c_str());
  printf("%s %s\n", StringUtil::toUpperCopy(std::String("abc")).c_str(), StringUtil::toLowerCopy(std::StringView("DeF")).c_str());
  printf("%d %d %d\n", StringUtil::startsWith(std::StringView("prefix_rest"), std::StringView("prefix")) ? 1 : 0,
         StringUtil::endsWith(std::StringView("prefix_rest"), std::StringView("rest")) ? 1 : 0,
         StringUtil::contains(std::StringView("prefix_rest"), std::StringView("fix_")) ? 1 : 0);
  std::Vector<std::String> parts = StringUtil::splitBySingleDelimiter(std::String(","), std::StringView("a,bc,,def"));
  printf("%zu:", parts.size());
  for (int i = 0; i < parts.size(); ++i)
    printf(" [%s]", parts[i].c_str());
  printf("\n");
  std::Pair<std::StringView, std::StringView> first = StringUtil::splitFirst(std::StringView("="), std::StringView("key=value=more"));
  printf("[%s] [%s]\n", std::toString(first.first).c_str(), std::toString(first.second).c_str());
  printf("%s\n", ssprintf("%d-%s-%.2f", 42, "x", 3.14159).c_str());
  printf("%s\n", StringUtil::hexDump(std::String("AB"), std::String(" ")).c_str());
  std::String replaced = "one two two";
  StringUtil::replace_all(replaced, std::StringView("two"), std::StringView("2"));
  printf("%s\n", replaced.c_str());

  // Numbers
  printf("%d %d\n", StringUtil::strtoint<int>(std::String("123"), true), StringUtil::strtoint<int>(std::String("-7"), true));
  printf("%.2f\n", StringUtil::strtodouble(std::String("2.5"), true));
  printf("%s %s\n", StringUtil::boolToString(true).c_str(), StringUtil::numberToString(1.5).c_str());
  try
  {
    StringUtil::strtoint<int>(std::String("12x"), true);
    printf("no throw\n");
  }
  catch (const std::Exception& e)
  {
    printf("caught: %s\n", e.what());
  }

  // UTF-8 <-> UTF-16 through the Windows API (the hand-written override)
  std::WString wide = StringUtil::widen(std::String("h\xC3\xA9llo"));
  printf("%zu %d\n", wide.size(), (int)wide[1]);
  std::String narrow = StringUtil::narrow(wide);
  printf("%s %zu\n", narrow.c_str(), narrow.size());

  // Math: the fast approximations and fdlibm's pow, through bitCast instead of unions
  printf("%.3f %.3f %.3f\n", Math::log2(8.0f), Math::exp2f(3.0f), Math::powPrecise(2.0, 0.5));
  printf("%.3f %.3f %d\n", Math::atan2(1.0, 1.0), Math::log2Precise(1024.0), Math::powi(2, 10));
  printf("%d %d\n", Math::isNaN(0.0 / 0.0) ? 1 : 0, Math::isNaN(1.0) ? 1 : 0);

  // LowercaseString and the timer
  LowercaseString lower("HeLLo");
  printf("%s %s\n", lower.c_str(), lower.getLowercase().c_str());
  TimeUtil::CpuTimer timer;
  double seconds = timer.getSecondsPassed();
  printf("%s\n", seconds >= 0.0 && seconds < 1.0 ? "timer ok" : "timer bad");
  return 0;
}
