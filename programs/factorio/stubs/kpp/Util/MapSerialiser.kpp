// Stub for MapSerialiser (from Map/MapSerialiser.hpp, outside the subset).
// Inherits Serialiser's template operator<< so save(MapSerialiser&) calls compile.
class MapSerialiser : public Serialiser
{
public:
  template<class T>
  MapSerialiser& operator<<(const T& value)
  {
    SerialiserHelper<MapSerialiser>::save(*this, value);
    return *this;
  }

  virtual MapSerialiser* asMapSerialiser() override { return this; }
};
