// Stub for MapDeserialiser (from Map/MapDeserialiser.hpp, outside the subset).
// Inherits Deserialiser's template operator>> so load(MapDeserialiser&) calls compile.
class MapDeserialiser : public Deserialiser
{
public:
  template<class T>
  MapDeserialiser& operator>>(T& value)
  {
    DeserialiserHelper<MapDeserialiser>::load(*this, value);
    return *this;
  }
};
