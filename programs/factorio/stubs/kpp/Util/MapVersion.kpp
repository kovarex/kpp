// Stub for MapVersion (from Map/MapVersion.hpp, outside the subset).
// Provides the 4-uint16 constructor and comparison operators used in version checks.

class MapVersion
{
public:
  uint64_t version;

  MapVersion() : version(0) {}
  explicit MapVersion(Deserialiser& input);
  MapVersion(const PropertyTree& input, const String& key);
  MapVersion(uint16_t main, uint16_t major, uint16_t minor, uint16_t dev)
    : version(uint64_t(dev) | (uint64_t(minor) << 16) | (uint64_t(major) << 32) | (uint64_t(main) << 48))
  {}

  bool operator==(const MapVersion& other) const { return this->version == other.version; }
  bool operator!=(const MapVersion& other) const { return this->version != other.version; }
  bool operator<(const MapVersion& other) const { return this->version < other.version; }
  bool operator<=(const MapVersion& other) const { return this->version <= other.version; }
  bool operator>(const MapVersion& other) const { return this->version > other.version; }
  bool operator>=(const MapVersion& other) const { return this->version >= other.version; }
  operator bool() const { return this->version != 0; }

  String str() const;
};
