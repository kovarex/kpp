// SHA-1 (FIPS 180-4), which mysql_native_password's scramble needs. Not for anything new: SHA-1 is
// broken for collisions (the scramble does not rely on that).

// The 20 bytes of SHA-1 of data.
String mariaDbSha1(StringView data)
{
  u32 h[5] = {0x67452301u, 0xefcdab89u, 0x98badcfeu, 0x10325476u, 0xc3d2e1f0u};
  String message(data);
  u64 bits = (u64)data.size() * 8;
  message << char(0x80);
  while (message.size() % 64 != 56)
    message << char(0);
  for (i32 i = 7; i >= 0; --i)
    message << char((bits >> (8 * i)) & 255);
  u32 w[80];
  for (ContainerSize block = 0; block < message.size(); block += 64)
  {
    for (i32 i = 0; i < 16; ++i)
      w[i] = ((u32)(u8)message[block + 4 * i] << 24) | ((u32)(u8)message[block + 4 * i + 1] << 16) |
             ((u32)(u8)message[block + 4 * i + 2] << 8) | (u32)(u8)message[block + 4 * i + 3];
    for (i32 i = 16; i < 80; ++i)
    {
      u32 x = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16];
      w[i] = (x << 1) | (x >> 31);
    }
    u32 a = h[0];
    u32 b = h[1];
    u32 c = h[2];
    u32 d = h[3];
    u32 e = h[4];
    for (i32 i = 0; i < 80; ++i)
    {
      u32 f = 0;
      u32 k = 0;
      if (i < 20)
      {
        f = (b & c) | (~b & d);
        k = 0x5a827999u;
      }
      else if (i < 40)
      {
        f = b ^ c ^ d;
        k = 0x6ed9eba1u;
      }
      else if (i < 60)
      {
        f = (b & c) | (b & d) | (c & d);
        k = 0x8f1bbcdcu;
      }
      else
      {
        f = b ^ c ^ d;
        k = 0xca62c1d6u;
      }
      u32 t = ((a << 5) | (a >> 27)) + f + e + k + w[i];
      e = d;
      d = c;
      c = (b << 30) | (b >> 2);
      b = a;
      a = t;
    }
    h[0] += a;
    h[1] += b;
    h[2] += c;
    h[3] += d;
    h[4] += e;
  }
  String out;
  for (i32 i = 0; i < 5; ++i)
    for (i32 j = 3; j >= 0; --j)
      out << char((h[i] >> (8 * j)) & 255);
  return out;
}
