// Reads a packet's fields; reading past its end throws.
struct MariaDbReader
{
  MariaDbReader(std::StringView data, std::ContainerSize position) : data(data), position(position) {}

  void need(std::ContainerSize n)
  {
    if (this.position + n > this.data.size())
      throw MariaDbError("a packet from the server is shorter than its fields", 0, std::String());
  }

  u8 peek()
  {
    this.need(1);
    return (u8)this.data[this.position];
  }

  void skip(std::ContainerSize n)
  {
    this.need(n);
    this.position += n;
  }

  u8 uint8()
  {
    u8 value = this.peek();
    this.position += 1;
    return value;
  }

  u16 uint16()
  {
    this.need(2);
    u16 value = (u16)((u8)this.data[this.position] | ((u8)this.data[this.position + 1] << 8));
    this.position += 2;
    return value;
  }

  u64 fixed(i32 bytes)
  {
    this.need((std::ContainerSize)bytes);
    u64 value = 0;
    for (i32 i = 0; i < bytes; ++i)
      value |= (u64)(u8)this.data[this.position + (std::ContainerSize)i] << (8 * i);
    this.position += (std::ContainerSize)bytes;
    return value;
  }

  u64 lengthEncoded()
  {
    u8 first = this.uint8();
    if (first < 251)
      return first;
    if (first == 0xfc)
      return this.fixed(2);
    if (first == 0xfd)
      return this.fixed(3);
    if (first == 0xfe)
      return this.fixed(8);
    throw MariaDbError(std::toString("a length-encoded integer cannot start with ", (i32)first), 0, std::String());
  }

  std::String bytes(std::ContainerSize n)
  {
    this.need(n);
    std::String out(this.data.substr(this.position, n));
    this.position += n;
    return out;
  }

  std::String lengthEncodedString() { return this.bytes((std::ContainerSize)this.lengthEncoded()); }
  void skipLengthEncodedString() { this.skip((std::ContainerSize)this.lengthEncoded()); }

  std::String nulTerminated()
  {
    std::ContainerSize end = this.data.find('\0', this.position);
    if (end == std::StringView::npos)
      throw MariaDbError("a packet from the server lacks a terminating zero", 0, std::String());
    std::String out(this.data.substr(this.position, end - this.position));
    this.position = end + 1;
    return out;
  }

  std::String rest()
  {
    std::String out(this.data.substr(this.position));
    this.position = this.data.size();
    return out;
  }

  std::StringView data;
  std::ContainerSize position = 0;
};
