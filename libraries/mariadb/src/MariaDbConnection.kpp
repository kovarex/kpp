// One connection. It closes (COM_QUIT) when destroyed; it moves but does not copy.
struct MariaDbConnection
{
  MariaDbConnection() {}
  MariaDbConnection(const MariaDbConnection&) = delete;
  MariaDbConnection& operator=(const MariaDbConnection&) = delete;
  MariaDbConnection(MariaDbConnection&& other) = default;
  ~MariaDbConnection() { this.close(); }

  static MariaDbConnection connect(const MariaDbOptions& options)
  {
    MariaDbConnection connection;
    connection.stream = net::TcpStream::connect(options.host, options.port);
    if (options.timeoutMilliseconds > 0)
      connection.stream.setTimeout(options.timeoutMilliseconds);
    connection.handshake(options);
    return connection;
  }

  // Runs one statement, given as pieces (`db.query("SELECT name FROM user WHERE id=", id)`), a
  // CALL's results read and dropped but the last; throws MariaDbError with the server's message and
  // the statement.
  MariaDbResult query(Text sql)
  {
    if (!this.stream.isOpen())
      throw MariaDbError("the connection is closed", 0, String());
    this.sequence = 0;
    String packet;
    packet << char(0x03); // COM_QUERY
    sql.appendTo(packet);
    this.writePacket(packet);
    StringView statement = StringView(packet).substr(1);
    MariaDbResult result;
    for (;;)
    {
      bool more = this.readResult(result, statement);
      if (!more)
        return result;
    }
  }

  // The first row's value of the first column, for "SELECT COUNT(*)..." and the like; no row throws.
  Optional<String> scalar(Text sql)
  {
    String statement = toString(sql);
    MariaDbResult result = this.query(statement);
    if (result.rows.empty() || result.columns.empty())
      throw MariaDbError(toString("no value from: ", statement), 0, String());
    return result.rows[0][0];
  }

  void begin() { this.query("START TRANSACTION"); }
  void commit() { this.query("COMMIT"); }
  void rollback() { this.query("ROLLBACK"); }

  void close()
  {
    if (!this.stream.isOpen())
      return;
    try
    {
      this.sequence = 0;
      String quit;
      quit << char(0x01); // COM_QUIT
      this.writePacket(quit);
    }
    catch (const net::NetError& e)
    {
      // The server may have gone already; closing goes on.
    }
    this.stream.close();
  }

  // Reads one result into result; true when the server says another follows (a CALL's).
  bool readResult(MariaDbResult& result, StringView sql)
  {
    String packet = this.readPacket();
    u8 first = (u8)packet[0];
    if (first == 0xff)
      this.fail(packet, sql);
    if (first == 0x00)
    {
      MariaDbReader reader(packet, 1);
      result.affectedRows = reader.lengthEncoded();
      result.insertId = reader.lengthEncoded();
      u16 status = reader.uint16();
      return (status & 0x0008) != 0; // SERVER_MORE_RESULTS_EXIST
    }
    if (first == 0xfb)
      throw MariaDbError("LOAD DATA LOCAL INFILE is not supported", 0, String());
    MariaDbReader countReader(packet, 0);
    u64 columnCount = countReader.lengthEncoded();
    result.columns.clear();
    result.rows.clear();
    for (u64 i = 0; i < columnCount; ++i)
    {
      String definition = this.readPacket();
      MariaDbReader reader(definition, 0);
      reader.skipLengthEncodedString(); // catalog
      reader.skipLengthEncodedString(); // schema
      reader.skipLengthEncodedString(); // table alias
      reader.skipLengthEncodedString(); // table
      result.columns.push_back(reader.lengthEncodedString()); // the name or alias
    }
    this.readEnd(sql); // the EOF after the definitions
    for (;;)
    {
      String row = this.readPacket();
      u8 head = (u8)row[0];
      if (head == 0xfe && row.size() < 9)
      {
        MariaDbReader reader(row, 1);
        reader.uint16(); // warnings
        u16 status = reader.uint16();
        return (status & 0x0008) != 0;
      }
      if (head == 0xff)
        this.fail(row, sql);
      MariaDbReader reader(row, 0);
      Vector<Optional<String>> values;
      for (u64 i = 0; i < columnCount; ++i)
      {
        if (reader.peek() == 0xfb)
        {
          reader.skip(1);
          values.push_back(Optional<String>());
        }
        else
          values.push_back(Optional<String>(reader.lengthEncodedString()));
      }
      result.rows.push_back(move(values));
    }
  }

  void readEnd(StringView sql)
  {
    String packet = this.readPacket();
    if ((u8)packet[0] == 0xff)
      this.fail(packet, sql);
    if ((u8)packet[0] != 0xfe)
      throw MariaDbError("the server sent no EOF after the column definitions", 0, String());
  }

  [[noreturn]] void fail(const String& packet, StringView sql)
  {
    MariaDbReader reader(packet, 1);
    i32 code = reader.uint16();
    String state;
    if (reader.peek() == '#')
    {
      reader.skip(1);
      state = reader.bytes(5);
    }
    String message = reader.rest();
    if (sql.empty())
      throw MariaDbError(toString("MariaDB error ", code, " (", state, "): ", message), code, state);
    throw MariaDbError(toString("MariaDB error ", code, " (", state, "): ", message, "; the statement: ", sql), code, state);
  }

  void handshake(const MariaDbOptions& options)
  {
    String greeting = this.readPacket();
    if ((u8)greeting[0] == 0xff)
      this.fail(greeting, "");
    MariaDbReader reader(greeting, 0);
    i32 protocol = reader.uint8();
    if (protocol != 10)
      throw MariaDbError(toString("the server speaks protocol ", protocol, ", not 10"), 0, String());
    this.serverVersion = reader.nulTerminated();
    reader.skip(4); // connection id
    String scramble = reader.bytes(8);
    reader.skip(1);
    u32 capabilities = reader.uint16();
    reader.skip(1); // character set
    reader.skip(2); // status
    capabilities |= (u32)reader.uint16() << 16;
    i32 scrambleLength = reader.uint8();
    reader.skip(10);
    String plugin = "mysql_native_password";
    if (capabilities & 0x00008000u) // CLIENT_SECURE_CONNECTION: the scramble's second part
    {
      i32 rest = scrambleLength - 8 > 13 ? scrambleLength - 8 : 13;
      String second = reader.bytes(rest);
      // It ends with a zero byte that is not part of the scramble.
      scramble << StringView(second.data(), (ContainerSize)(rest - 1));
    }
    if (capabilities & 0x00080000u) // CLIENT_PLUGIN_AUTH
      plugin = reader.nulTerminated();
    this.serverCapabilities = capabilities;
    const u32 required = 0x00000200u | 0x00008000u | 0x00080000u; // PROTOCOL_41, SECURE_CONNECTION, PLUGIN_AUTH
    if ((capabilities & required) != required)
      throw MariaDbError(toString("the server ", this.serverVersion, " lacks the 4.1 protocol with authentication plugins"), 0, String());

    u32 client = 0x00000001u    // LONG_PASSWORD
                      | 0x00000004u  // LONG_FLAG
                      | 0x00000200u  // PROTOCOL_41
                      | 0x00002000u  // TRANSACTIONS
                      | 0x00008000u  // SECURE_CONNECTION
                      | 0x00020000u  // MULTI_RESULTS: a CALL's results
                      | 0x00080000u  // PLUGIN_AUTH
                      | 0x00200000u; // PLUGIN_AUTH_LENENC_CLIENT_DATA
    if (!options.database.empty())
      client |= 0x00000008u; // CONNECT_WITH_DB
    client &= capabilities | 0x00000001u;
    String response;
    mariaDbAppendUint32(response, client);
    mariaDbAppendUint32(response, 16 * 1024 * 1024); // the largest packet
    response << char(224); // utf8mb4_unicode_ci
    for (i32 i = 0; i < 23; ++i)
      response << char(0);
    response << options.user;
    response << char(0);
    String auth = mariaDbAuthenticate(plugin, options.password, scramble);
    mariaDbAppendLengthEncoded(response, auth.size());
    response << auth;
    if (!options.database.empty())
    {
      response << options.database;
      response << char(0);
    }
    response << plugin;
    response << char(0);
    this.writePacket(response);

    for (;;)
    {
      String reply = this.readPacket();
      u8 head = (u8)reply[0];
      if (head == 0x00)
        return;
      if (head == 0xff)
        this.fail(reply, "");
      if (head == 0xfe) // the server asks for another plugin
      {
        MariaDbReader switchReader(reply, 1);
        String other = switchReader.nulTerminated();
        String data = switchReader.rest();
        if (!data.empty() && data[data.size() - 1] == 0)
          data = String(StringView(data.data(), data.size() - 1));
        this.writePacket(mariaDbAuthenticate(other, options.password, data));
        continue;
      }
      throw MariaDbError(toString("an authentication step this client does not know (packet ", (i32)head, ")"), 0, String());
    }
  }

  void writePacket(StringView payload)
  {
    // Payloads of 2^24 - 1 bytes and more go in parts, the last one shorter.
    ContainerSize offset = 0;
    for (;;)
    {
      ContainerSize part = payload.size() - offset;
      if (part > 0xffffff)
        part = 0xffffff;
      String packet;
      packet << char(part & 255);
      packet << char((part >> 8) & 255);
      packet << char((part >> 16) & 255);
      packet << char(this.sequence++);
      packet << payload.substr(offset, part);
      this.stream.write(packet);
      offset += part;
      if (part < 0xffffff)
        return;
    }
  }

  String readPacket()
  {
    String payload;
    for (;;)
    {
      String header = this.take(4);
      ContainerSize length = ContainerSize((u8)header[0]) | (ContainerSize((u8)header[1]) << 8) |
                             (ContainerSize((u8)header[2]) << 16);
      this.sequence = (u8)((u8)header[3] + 1);
      payload << (this.take(length));
      if (length < 0xffffff)
        break;
    }
    if (payload.empty())
      throw MariaDbError("the server sent an empty packet", 0, String());
    return payload;
  }

  // The next n bytes from the connection, read 64 KB at a time.
  String take(ContainerSize n)
  {
    while (this.buffer.size() - this.bufferStart < n)
    {
      if (this.bufferStart > 0)
      {
        this.buffer = String(StringView(this.buffer).substr(this.bufferStart));
        this.bufferStart = 0;
      }
      char chunk[65536];
      i64 got = this.stream.read(chunk, 65536);
      if (got == 0)
        throw MariaDbError("the server closed the connection", 0, String());
      this.buffer << StringView(chunk, (ContainerSize)got);
    }
    String out(StringView(this.buffer).substr(this.bufferStart, n));
    this.bufferStart += n;
    return out;
  }

  net::TcpStream stream;
  String buffer;               // bytes read and not used yet, from bufferStart
  ContainerSize bufferStart = 0;
  u8 sequence = 0;
  u32 serverCapabilities = 0;
  String serverVersion;
};
