// The result of a query: the rows of a SELECT (every value as the server's text, NULL as an empty
// Optional, which is what PHP's mysqli gives), or the counts of a statement that has no rows.
struct MariaDbResult
{
  std::ContainerSize size() const { return this.rows.size(); }
  bool empty() const { return this.rows.empty(); }

  // The index of the column named name; a name the result does not have throws.
  std::ContainerSize column(std::StringView name) const
  {
    for (std::ContainerSize i = 0; i < this.columns.size(); ++i)
      if (this.columns[i] == name)
        return i;
    throw MariaDbError(std::toString("the result has no column ", name), 0, std::String());
  }

  // Row row's value of column name (empty for NULL).
  const std::Optional<std::String>& at(std::ContainerSize row, std::StringView name) const { return this.rows[row][this.column(name)]; }

  // Row row's value of column name; NULL throws.
  const std::String& text(std::ContainerSize row, std::StringView name) const
  {
    const std::Optional<std::String>& value = this.at(row, name);
    if (!value.has_value())
      throw MariaDbError(std::toString("the column ", name, " is NULL"), 0, std::String());
    return *value;
  }

  std::Vector<std::String> columns;
  std::Vector<std::Vector<std::Optional<std::String>>> rows;
  u64 affectedRows = 0;
  u64 insertId = 0;
};
