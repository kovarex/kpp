// A MariaDB (and MySQL) client: the client/server protocol's text queries over TCP (libraries/net),
// with mysql_native_password. README.md has the API; the protocol is MariaDB's documentation's
// "Client/Server Protocol" (handshake, COM_QUERY, result sets, OK and ERR packets).

// The client's answer to the server's scramble for an authentication plugin.
String mariaDbAuthenticate(StringView plugin, StringView password, StringView scramble)
{
  if (plugin == "mysql_native_password")
    return mariaDbNativePassword(password, scramble);
  throw MariaDbError(toString("the authentication plugin ", plugin, " is not supported (only mysql_native_password)"), 0, String());
}

// mysql_native_password: SHA1(password) XOR SHA1(scramble + SHA1(SHA1(password))); nothing for no password.
String mariaDbNativePassword(StringView password, StringView scramble)
{
  if (password.empty())
    return String();
  String stage1 = mariaDbSha1(password);
  String stage2 = mariaDbSha1(stage1);
  String salted(scramble);
  salted << stage2;
  String mix = mariaDbSha1(salted);
  String out;
  for (i32 i = 0; i < 20; ++i)
    out << char(stage1[i] ^ mix[i]);
  return out;
}

// text in single quotes, escaped as the server reads it unless NO_BACKSLASH_ESCAPES is on (which is
// what PHP's real_escape_string does): \0, \n, \r, \\, ', " and Ctrl-Z get a backslash.
String mariaDbQuote(StringView text)
{
  String out = "'";
  for (ContainerSize i = 0; i < text.size(); ++i)
  {
    char c = text[i];
    switch (c)
    {
    case 0: out << "\\0"; break;
    case '\n': out << "\\n"; break;
    case '\r': out << "\\r"; break;
    case '\\': out << "\\\\"; break;
    case '\'': out << "\\'"; break;
    case '"': out << "\\\""; break;
    case 26: out << "\\Z"; break;
    default: out << c;
    }
  }
  out << '\'';
  return out;
}

// mariaDbQuote, or NULL for an empty Optional.
String mariaDbQuoteOrNull(const Optional<String>& value)
{
  if (!value.has_value())
    return "NULL";
  return mariaDbQuote(StringView(*value));
}

void mariaDbAppendUint32(String& out, u32 value)
{
  for (i32 i = 0; i < 4; ++i)
    out << char((value >> (8 * i)) & 255);
}

void mariaDbAppendLengthEncoded(String& out, u64 value)
{
  if (value < 251)
    out << char(value);
  else if (value < 65536)
  {
    out << char(0xfc);
    out << char(value & 255);
    out << char(value >> 8);
  }
  else if (value < 16777216)
  {
    out << char(0xfd);
    for (i32 i = 0; i < 3; ++i)
      out << char((value >> (8 * i)) & 255);
  }
  else
  {
    out << char(0xfe);
    for (i32 i = 0; i < 8; ++i)
      out << char((value >> (8 * i)) & 255);
  }
}

