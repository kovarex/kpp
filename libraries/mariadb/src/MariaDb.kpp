// A MariaDB (and MySQL) client: the client/server protocol's text queries over TCP (libraries/net),
// with mysql_native_password. README.md has the API; the protocol is MariaDB's documentation's
// "Client/Server Protocol" (handshake, COM_QUERY, result sets, OK and ERR packets).

// What the server refused (code and SQLSTATE are the server's), or a connection that failed.
class MariaDbError : public RuntimeError
{
public:
  i32 code = 0;          // the server's error number, 0 when the server did not send one
  String sqlState;       // "42S02"...; empty when the server did not send one
  MariaDbError() {}
  MariaDbError(const String& message, i32 code, const String& sqlState) : RuntimeError(message), code(code), sqlState(sqlState) {}
};

struct MariaDbOptions
{
  String host = "127.0.0.1";
  i32 port = 3306;
  String user;
  String password;
  String database;           // empty: none
  i32 timeoutMilliseconds = 30000; // for connecting's reads and every query's; 0 waits forever
};

// The result of a query: the rows of a SELECT (every value as the server's text, NULL as an empty
// Optional, which is what PHP's mysqli gives), or the counts of a statement that has no rows.
struct MariaDbResult
{
  Vector<String> columns;
  Vector<Vector<Optional<String>>> rows;
  u64 affectedRows = 0;
  u64 insertId = 0;

  ContainerSize size() const { return this->rows.size(); }
  bool empty() const { return this->rows.empty(); }

  // The index of the column named name; a name the result does not have throws.
  ContainerSize column(StringView name) const
  {
    for (ContainerSize i = 0; i < this->columns.size(); ++i)
      if (this->columns[i] == name)
        return i;
    throw MariaDbError(format("the result has no column {}", name), 0, String());
  }

  // Row row's value of column name (empty for NULL).
  const Optional<String>& at(ContainerSize row, StringView name) const { return this->rows[row][this->column(name)]; }

  // Row row's value of column name; NULL throws.
  const String& text(ContainerSize row, StringView name) const
  {
    const Optional<String>& value = this->at(row, name);
    if (!value.has_value())
      throw MariaDbError(format("the column {} is NULL", name), 0, String());
    return *value;
  }
};

// One connection. It closes (COM_QUIT) when destroyed; it moves but does not copy.
struct MariaDbConnection
{
  net::TcpStream stream;
  String buffer;               // bytes read and not used yet, from bufferStart
  ContainerSize bufferStart = 0;
  u8 sequence = 0;
  u32 serverCapabilities = 0;
  String serverVersion;

  MariaDbConnection() {}
  MariaDbConnection(const MariaDbConnection&) = delete;
  MariaDbConnection& operator=(const MariaDbConnection&) = delete;
  MariaDbConnection(MariaDbConnection&& other) = default;
  ~MariaDbConnection() { this->close(); }

  static MariaDbConnection connect(const MariaDbOptions& options)
  {
    MariaDbConnection connection;
    connection.stream = net::TcpStream::connect(options.host, options.port);
    if (options.timeoutMilliseconds > 0)
      connection.stream.setTimeout(options.timeoutMilliseconds);
    connection.handshake(options);
    return connection;
  }

  // Runs one statement (a CALL's results are read and dropped but the last); throws MariaDbError
  // with the server's message and the statement.
  MariaDbResult query(StringView sql)
  {
    if (!this->stream.isOpen())
      throw MariaDbError("the connection is closed", 0, String());
    this->sequence = 0;
    String packet;
    packet.append(char(0x03)); // COM_QUERY
    packet.append(sql);
    this->writePacket(packet);
    MariaDbResult result;
    for (;;)
    {
      bool more = this->readResult(result, sql);
      if (!more)
        return result;
    }
  }

  // The first row's value of the first column, for "SELECT COUNT(*)..." and the like; no row throws.
  Optional<String> scalar(StringView sql)
  {
    MariaDbResult result = this->query(sql);
    if (result.rows.empty() || result.columns.empty())
      throw MariaDbError(format("no value from: {}", sql), 0, String());
    return result.rows[0][0];
  }

  void begin() { this->query("START TRANSACTION"); }
  void commit() { this->query("COMMIT"); }
  void rollback() { this->query("ROLLBACK"); }

  void close()
  {
    if (!this->stream.isOpen())
      return;
    try
    {
      this->sequence = 0;
      String quit;
      quit.append(char(0x01)); // COM_QUIT
      this->writePacket(quit);
    }
    catch (const net::NetError& e)
    {
      // The server may have gone already; closing goes on.
    }
    this->stream.close();
  }

  // Reads one result into result; true when the server says another follows (a CALL's).
  bool readResult(MariaDbResult& result, StringView sql)
  {
    String packet = this->readPacket();
    u8 first = (u8)packet[0];
    if (first == 0xff)
      this->fail(packet, sql);
    if (first == 0x00)
    {
      MariaDbReader reader(packet, 1);
      result.affectedRows = reader.lengthEncoded();
      result.insertId = reader.lengthEncoded();
      u16 status = reader.uint16();
      return (status & 0x0008) != 0; // SERVER_MORE_RESULTS_EXIST
    }
    if (first == 0xfb)
      throw MariaDbError("LOAD DATA LOCAL INFILE is not supported", 0, String());
    MariaDbReader countReader(packet, 0);
    u64 columnCount = countReader.lengthEncoded();
    result.columns.clear();
    result.rows.clear();
    for (u64 i = 0; i < columnCount; ++i)
    {
      String definition = this->readPacket();
      MariaDbReader reader(definition, 0);
      reader.skipLengthEncodedString(); // catalog
      reader.skipLengthEncodedString(); // schema
      reader.skipLengthEncodedString(); // table alias
      reader.skipLengthEncodedString(); // table
      result.columns.push_back(reader.lengthEncodedString()); // the name or alias
    }
    this->readEnd(sql); // the EOF after the definitions
    for (;;)
    {
      String row = this->readPacket();
      u8 head = (u8)row[0];
      if (head == 0xfe && row.size() < 9)
      {
        MariaDbReader reader(row, 1);
        reader.uint16(); // warnings
        u16 status = reader.uint16();
        return (status & 0x0008) != 0;
      }
      if (head == 0xff)
        this->fail(row, sql);
      MariaDbReader reader(row, 0);
      Vector<Optional<String>> values;
      for (u64 i = 0; i < columnCount; ++i)
      {
        if (reader.peek() == 0xfb)
        {
          reader.skip(1);
          values.push_back(Optional<String>());
        }
        else
          values.push_back(Optional<String>(reader.lengthEncodedString()));
      }
      result.rows.push_back(move(values));
    }
  }

  void readEnd(StringView sql)
  {
    String packet = this->readPacket();
    if ((u8)packet[0] == 0xff)
      this->fail(packet, sql);
    if ((u8)packet[0] != 0xfe)
      throw MariaDbError("the server sent no EOF after the column definitions", 0, String());
  }

  [[noreturn]] void fail(const String& packet, StringView sql)
  {
    MariaDbReader reader(packet, 1);
    i32 code = reader.uint16();
    String state;
    if (reader.peek() == '#')
    {
      reader.skip(1);
      state = reader.bytes(5);
    }
    String message = reader.rest();
    if (sql.empty())
      throw MariaDbError(format("MariaDB error {} ({}): {}", code, state, message), code, state);
    throw MariaDbError(format("MariaDB error {} ({}): {}; the statement: {}", code, state, message, sql), code, state);
  }

  void handshake(const MariaDbOptions& options)
  {
    String greeting = this->readPacket();
    if ((u8)greeting[0] == 0xff)
      this->fail(greeting, "");
    MariaDbReader reader(greeting, 0);
    i32 protocol = reader.uint8();
    if (protocol != 10)
      throw MariaDbError(format("the server speaks protocol {}, not 10", protocol), 0, String());
    this->serverVersion = reader.nulTerminated();
    reader.skip(4); // connection id
    String scramble = reader.bytes(8);
    reader.skip(1);
    u32 capabilities = reader.uint16();
    reader.skip(1); // character set
    reader.skip(2); // status
    capabilities |= (u32)reader.uint16() << 16;
    i32 scrambleLength = reader.uint8();
    reader.skip(10);
    String plugin = "mysql_native_password";
    if (capabilities & 0x00008000u) // CLIENT_SECURE_CONNECTION: the scramble's second part
    {
      i32 rest = scrambleLength - 8 > 13 ? scrambleLength - 8 : 13;
      String second = reader.bytes(rest);
      // It ends with a zero byte that is not part of the scramble.
      scramble.append(StringView(second.data(), (ContainerSize)(rest - 1)));
    }
    if (capabilities & 0x00080000u) // CLIENT_PLUGIN_AUTH
      plugin = reader.nulTerminated();
    this->serverCapabilities = capabilities;
    const u32 required = 0x00000200u | 0x00008000u | 0x00080000u; // PROTOCOL_41, SECURE_CONNECTION, PLUGIN_AUTH
    if ((capabilities & required) != required)
      throw MariaDbError(format("the server {} lacks the 4.1 protocol with authentication plugins", this->serverVersion), 0, String());

    u32 client = 0x00000001u    // LONG_PASSWORD
                      | 0x00000004u  // LONG_FLAG
                      | 0x00000200u  // PROTOCOL_41
                      | 0x00002000u  // TRANSACTIONS
                      | 0x00008000u  // SECURE_CONNECTION
                      | 0x00020000u  // MULTI_RESULTS: a CALL's results
                      | 0x00080000u  // PLUGIN_AUTH
                      | 0x00200000u; // PLUGIN_AUTH_LENENC_CLIENT_DATA
    if (!options.database.empty())
      client |= 0x00000008u; // CONNECT_WITH_DB
    client &= capabilities | 0x00000001u;
    String response;
    mariaDbAppendUint32(response, client);
    mariaDbAppendUint32(response, 16 * 1024 * 1024); // the largest packet
    response.append(char(224)); // utf8mb4_unicode_ci
    for (i32 i = 0; i < 23; ++i)
      response.append(char(0));
    response.append(options.user);
    response.append(char(0));
    String auth = mariaDbAuthenticate(plugin, options.password, scramble);
    mariaDbAppendLengthEncoded(response, auth.size());
    response.append(auth);
    if (!options.database.empty())
    {
      response.append(options.database);
      response.append(char(0));
    }
    response.append(plugin);
    response.append(char(0));
    this->writePacket(response);

    for (;;)
    {
      String reply = this->readPacket();
      u8 head = (u8)reply[0];
      if (head == 0x00)
        return;
      if (head == 0xff)
        this->fail(reply, "");
      if (head == 0xfe) // the server asks for another plugin
      {
        MariaDbReader switchReader(reply, 1);
        String other = switchReader.nulTerminated();
        String data = switchReader.rest();
        if (!data.empty() && data[data.size() - 1] == 0)
          data = String(StringView(data.data(), data.size() - 1));
        this->writePacket(mariaDbAuthenticate(other, options.password, data));
        continue;
      }
      throw MariaDbError(format("an authentication step this client does not know (packet {})", (i32)head), 0, String());
    }
  }

  void writePacket(StringView payload)
  {
    // Payloads of 2^24 - 1 bytes and more go in parts, the last one shorter.
    ContainerSize offset = 0;
    for (;;)
    {
      ContainerSize part = payload.size() - offset;
      if (part > 0xffffff)
        part = 0xffffff;
      String packet;
      packet.append(char(part & 255));
      packet.append(char((part >> 8) & 255));
      packet.append(char((part >> 16) & 255));
      packet.append(char(this->sequence++));
      packet.append(payload.substr(offset, part));
      this->stream.write(packet);
      offset += part;
      if (part < 0xffffff)
        return;
    }
  }

  String readPacket()
  {
    String payload;
    for (;;)
    {
      String header = this->take(4);
      ContainerSize length = ContainerSize((u8)header[0]) | (ContainerSize((u8)header[1]) << 8) |
                             (ContainerSize((u8)header[2]) << 16);
      this->sequence = (u8)((u8)header[3] + 1);
      payload.append(this->take(length));
      if (length < 0xffffff)
        break;
    }
    if (payload.empty())
      throw MariaDbError("the server sent an empty packet", 0, String());
    return payload;
  }

  // The next n bytes from the connection, read 64 KB at a time.
  String take(ContainerSize n)
  {
    while (this->buffer.size() - this->bufferStart < n)
    {
      if (this->bufferStart > 0)
      {
        this->buffer = String(StringView(this->buffer).substr(this->bufferStart));
        this->bufferStart = 0;
      }
      char chunk[65536];
      i64 got = this->stream.read(chunk, 65536);
      if (got == 0)
        throw MariaDbError("the server closed the connection", 0, String());
      this->buffer.append(StringView(chunk, (ContainerSize)got));
    }
    String out(StringView(this->buffer).substr(this->bufferStart, n));
    this->bufferStart += n;
    return out;
  }
};

// The client's answer to the server's scramble for an authentication plugin.
String mariaDbAuthenticate(StringView plugin, StringView password, StringView scramble)
{
  if (plugin == "mysql_native_password")
    return mariaDbNativePassword(password, scramble);
  throw MariaDbError(format("the authentication plugin {} is not supported (only mysql_native_password)", plugin), 0, String());
}

// mysql_native_password: SHA1(password) XOR SHA1(scramble + SHA1(SHA1(password))); nothing for no password.
String mariaDbNativePassword(StringView password, StringView scramble)
{
  if (password.empty())
    return String();
  String stage1 = mariaDbSha1(password);
  String stage2 = mariaDbSha1(stage1);
  String salted(scramble);
  salted.append(stage2);
  String mix = mariaDbSha1(salted);
  String out;
  for (i32 i = 0; i < 20; ++i)
    out.append(char(stage1[i] ^ mix[i]));
  return out;
}

// text in single quotes, escaped as the server reads it unless NO_BACKSLASH_ESCAPES is on (which is
// what PHP's real_escape_string does): \0, \n, \r, \\, ', " and Ctrl-Z get a backslash.
String mariaDbQuote(StringView text)
{
  String out = "'";
  for (ContainerSize i = 0; i < text.size(); ++i)
  {
    char c = text[i];
    switch (c)
    {
    case 0: out.append("\\0"); break;
    case '\n': out.append("\\n"); break;
    case '\r': out.append("\\r"); break;
    case '\\': out.append("\\\\"); break;
    case '\'': out.append("\\'"); break;
    case '"': out.append("\\\""); break;
    case 26: out.append("\\Z"); break;
    default: out.append(c);
    }
  }
  out.append('\'');
  return out;
}

// mariaDbQuote, or NULL for an empty Optional.
String mariaDbQuoteOrNull(const Optional<String>& value)
{
  if (!value.has_value())
    return "NULL";
  return mariaDbQuote(StringView(*value));
}

void mariaDbAppendUint32(String& out, u32 value)
{
  for (i32 i = 0; i < 4; ++i)
    out.append(char((value >> (8 * i)) & 255));
}

void mariaDbAppendLengthEncoded(String& out, u64 value)
{
  if (value < 251)
    out.append(char(value));
  else if (value < 65536)
  {
    out.append(char(0xfc));
    out.append(char(value & 255));
    out.append(char(value >> 8));
  }
  else if (value < 16777216)
  {
    out.append(char(0xfd));
    for (i32 i = 0; i < 3; ++i)
      out.append(char((value >> (8 * i)) & 255));
  }
  else
  {
    out.append(char(0xfe));
    for (i32 i = 0; i < 8; ++i)
      out.append(char((value >> (8 * i)) & 255));
  }
}

// Reads a packet's fields; reading past its end throws.
struct MariaDbReader
{
  StringView data;
  ContainerSize position = 0;

  MariaDbReader(StringView data, ContainerSize position) : data(data), position(position) {}

  void need(ContainerSize n)
  {
    if (this->position + n > this->data.size())
      throw MariaDbError("a packet from the server is shorter than its fields", 0, String());
  }
  u8 peek()
  {
    this->need(1);
    return (u8)this->data[this->position];
  }
  void skip(ContainerSize n)
  {
    this->need(n);
    this->position += n;
  }
  u8 uint8()
  {
    u8 value = this->peek();
    this->position += 1;
    return value;
  }
  u16 uint16()
  {
    this->need(2);
    u16 value = (u16)((u8)this->data[this->position] | ((u8)this->data[this->position + 1] << 8));
    this->position += 2;
    return value;
  }
  u64 fixed(i32 bytes)
  {
    this->need((ContainerSize)bytes);
    u64 value = 0;
    for (i32 i = 0; i < bytes; ++i)
      value |= (u64)(u8)this->data[this->position + (ContainerSize)i] << (8 * i);
    this->position += (ContainerSize)bytes;
    return value;
  }
  u64 lengthEncoded()
  {
    u8 first = this->uint8();
    if (first < 251)
      return first;
    if (first == 0xfc)
      return this->fixed(2);
    if (first == 0xfd)
      return this->fixed(3);
    if (first == 0xfe)
      return this->fixed(8);
    throw MariaDbError(format("a length-encoded integer cannot start with {}", (i32)first), 0, String());
  }
  String bytes(ContainerSize n)
  {
    this->need(n);
    String out(this->data.substr(this->position, n));
    this->position += n;
    return out;
  }
  String lengthEncodedString() { return this->bytes((ContainerSize)this->lengthEncoded()); }
  void skipLengthEncodedString() { this->skip((ContainerSize)this->lengthEncoded()); }
  String nulTerminated()
  {
    ContainerSize end = this->data.find('\0', this->position);
    if (end == StringView::npos)
      throw MariaDbError("a packet from the server lacks a terminating zero", 0, String());
    String out(this->data.substr(this->position, end - this->position));
    this->position = end + 1;
    return out;
  }
  String rest()
  {
    String out(this->data.substr(this->position));
    this->position = this->data.size();
    return out;
  }
};
