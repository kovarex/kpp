// Inlines (CommonMark 6, as commonmark.js's inlines.js parses them): code spans, emphasis by the
// delimiter run algorithm, links and images with the bracket stack, autolinks, raw HTML, entities,
// escapes and line breaks.

bool markdownContains(const char* set, char c)
{
  for (i32 i = 0; set[i]; ++i)
    if (set[i] == c)
      return true;
  return false;
}

// A link label compared as CommonMark says: without its brackets, whitespace runs as one space,
// case folded.
String markdownNormalizeLabel(StringView label)
{
  StringView inner = markdownTrim(label.substr(1, label.size() - 2));
  String out;
  bool space = false;
  for (i32 i = 0; i < inner.size();)
  {
    i32 length = 1;
    i32 c = markdownDecode(inner, i, &length);
    if (c == ' ' || c == '\t' || c == '\n' || c == '\r')
    {
      space = true;
      i += length;
      continue;
    }
    if (space)
      out << ' ';
    space = false;
    markdownAppendFolded(out, c);
    i += length;
  }
  return out;
}

// Backslash escapes and entities replaced by what they stand for.
String markdownUnescape(StringView text)
{
  String out;
  for (i32 i = 0; i < text.size();)
  {
    if (text[i] == '\\' && i + 1 < text.size() && markdownIsAsciiPunctuation((u8)text[i + 1]))
    {
      out << text[i + 1];
      i += 2;
      continue;
    }
    if (text[i] == '&')
    {
      i32 length = markdownEntity(text, i, out);
      if (length > 0)
      {
        i += length;
        continue;
      }
    }
    out << text[i];
    ++i;
  }
  return out;
}

// A URL with what may not stand in one percent-encoded: everything but letters, digits,
// ;/?:@&=+$,-_.!~*'()# and a valid %XX (commonmark.js's mdurl.encode).
String markdownNormalizeUri(StringView uri)
{
  const char* hex = "0123456789ABCDEF";
  String out;
  for (i32 i = 0; i < uri.size(); ++i)
  {
    u8 c = (u8)uri[i];
    if (c == '%' && i + 2 < uri.size() && markdownIsHex((u8)uri[i + 1]) && markdownIsHex((u8)uri[i + 2]))
    {
      out << uri.substr(i, 3);
      i += 2;
      continue;
    }
    if (markdownIsAlphanumeric(c) || markdownContains(";/?:@&=+$,-_.!~*'()#", char(c)))
      out << char(c);
    else
    {
      out << '%';
      out << hex[c >> 4];
      out << hex[c & 15];
    }
  }
  return out;
}

bool markdownIsHex(i32 c) { return markdownIsDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }

// An entity or numeric character reference at text[at]: appends what it stands for and returns its
// length, or returns 0.
i32 markdownEntity(StringView text, i32 at, String& out)
{
  if (at >= text.size() || text[at] != '&')
    return 0;
  i32 k = at + 1;
  if (k < text.size() && text[k] == '#')
  {
    ++k;
    bool hex = k < text.size() && (text[k] == 'x' || text[k] == 'X');
    if (hex)
      ++k;
    i32 start = k;
    i64 code = 0;
    while (k < text.size() && (hex ? markdownIsHex((u8)text[k]) : markdownIsDigit((u8)text[k])) && k - start < (hex ? 6 : 7))
    {
      i32 d = (u8)text[k];
      code = code * (hex ? 16 : 10) + (markdownIsDigit(d) ? d - '0' : markdownLower(d) - 'a' + 10);
      ++k;
    }
    if (k == start || k >= text.size() || text[k] != ';')
      return 0;
    if (code == 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF))
      code = 0xFFFD;
    markdownAppendUtf8(out, i32(code));
    return k + 1 - at;
  }
  i32 start = k;
  while (k < text.size() && markdownIsAlphanumeric((u8)text[k]) && k - start < 32)
    ++k;
  if (k == start || k >= text.size() || text[k] != ';')
    return 0;
  const char* value = markdownNamedEntity(text.substr(start, k - start));
  if (!value)
    return 0;
  out << StringView(value);
  return k + 1 - at;
}
