// The document tree: blocks (paragraphs, lists...) and inlines (text, emphasis, links...) are nodes
// of one kind, linked as commonmark.js links them, so that emphasis can move a run of siblings into
// a new node.

struct MarkdownNode
{
 // a table row's

  void appendChild(MarkdownNode* child)
  {
    child->unlink();
    child->parent = &this;
    if (this.lastChild)
    {
      this.lastChild->next = child;
      child->previous = this.lastChild;
      this.lastChild = child;
    }
    else
    {
      this.firstChild = child;
      this.lastChild = child;
    }
  }

  void insertAfter(MarkdownNode* sibling)
  {
    sibling->unlink();
    sibling->next = this.next;
    if (sibling->next)
      sibling->next->previous = sibling;
    sibling->previous = &this;
    this.next = sibling;
    sibling->parent = this.parent;
    if (!sibling->next && sibling->parent)
      sibling->parent->lastChild = sibling;
  }

  void unlink()
  {
    if (this.previous)
      this.previous->next = this.next;
    else if (this.parent)
      this.parent->firstChild = this.next;
    if (this.next)
      this.next->previous = this.previous;
    else if (this.parent)
      this.parent->lastChild = this.previous;
    this.parent = nullptr;
    this.next = nullptr;
    this.previous = nullptr;
  }

  MarkdownType type = MarkdownType::document;
  MarkdownNode* parent = nullptr;
  MarkdownNode* firstChild = nullptr;
  MarkdownNode* lastChild = nullptr;
  MarkdownNode* previous = nullptr;
  MarkdownNode* next = nullptr;

  std::String literal; // text, code, an HTML block or inline, a code block's text
  std::String content; // a paragraph's or heading's lines, before inlines are parsed
  std::String destination;
  std::String title;
  std::String info; // a fenced code block's info string

  bool open = true;
  i32 startLine = 0;
  i32 endLine = 0;
  i32 level = 0; // a heading's

  // A list's and an item's marker.
  bool ordered = false;
  bool tight = true;
  char bulletChar = 0;
  char delimiter = 0;
  i32 start = 0;
  i32 markerOffset = 0;
  i32 padding = 0;

  // A code block's fence.
  bool fenced = false;
  char fenceChar = 0;
  i32 fenceLength = 0;
  i32 fenceOffset = 0;

  i32 htmlBlockType = 0;
  i32 alignment = 0; // a table cell's: 0 none, 1 left, 2 center, 3 right
  bool header = false;
};

// --- characters ---

bool markdownIsSpaceOrTab(i32 c) { return c == ' ' || c == '\t'; }

bool markdownIsAsciiPunctuation(i32 c)
{
  return (c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126);
}

bool markdownIsDigit(i32 c) { return c >= '0' && c <= '9'; }
bool markdownIsLetter(i32 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
bool markdownIsAlphanumeric(i32 c) { return markdownIsLetter(c) || markdownIsDigit(c); }
i32 markdownLower(i32 c) { return c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c; }

// The code point at text[at] (UTF-8), its length in *length; a byte that starts no sequence is
// itself.
i32 markdownDecode(std::StringView text, i32 at, i32* length)
{
  u8 c = (u8)text[at];
  i32 n = c < 0x80 ? 1 : c >= 0xF0 ? 4 : c >= 0xE0 ? 3 : c >= 0xC0 ? 2 : 1;
  if (at + n > text.size())
    n = 1;
  i32 code = n == 1 ? c : n == 2 ? (c & 0x1F) : n == 3 ? (c & 0x0F) : (c & 0x07);
  for (i32 i = 1; i < n; ++i)
    code = (code << 6) | ((u8)text[at + i] & 0x3F);
  *length = n;
  return code;
}

// The code point that ends before text[at].
i32 markdownDecodeBefore(std::StringView text, i32 at)
{
  i32 start = at - 1;
  while (start > 0 && at - start < 4 && ((u8)text[start] & 0xC0) == 0x80)
    --start;
  i32 length = 0;
  return markdownDecode(text, start, &length);
}

// Unicode whitespace (CommonMark 2.1: Zs, tab, line feed, form feed, carriage return).
bool markdownIsUnicodeWhitespace(i32 c)
{
  return c == ' ' || c == '\t' || c == '\n' || c == '\f' || c == '\r' || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) ||
         c == 0x202F || c == 0x205F || c == 0x3000;
}

// Unicode punctuation (CommonMark 2.1: the P and S categories): MarkdownUnicode.kpp's table.
bool markdownIsUnicodePunctuation(i32 c) { return c < 0x80 ? markdownIsAsciiPunctuation(c) : markdownIsNonAsciiPunctuation(c); }

void markdownAppendUtf8(std::String& out, i32 code)
{
  if (code < 0x80)
    out << char(code);
  else if (code < 0x800)
  {
    out << char(0xC0 | (code >> 6));
    out << char(0x80 | (code & 0x3F));
  }
  else if (code < 0x10000)
  {
    out << char(0xE0 | (code >> 12));
    out << char(0x80 | ((code >> 6) & 0x3F));
    out << char(0x80 | (code & 0x3F));
  }
  else
  {
    out << char(0xF0 | (code >> 18));
    out << char(0x80 | ((code >> 12) & 0x3F));
    out << char(0x80 | ((code >> 6) & 0x3F));
    out << char(0x80 | (code & 0x3F));
  }
}
