// markdownToHtml, and the HTML it writes: the same as the CommonMark spec's examples (and
// commonmark.js's renderer), byte for byte.

// The HTML of a CommonMark document.
std::String markdownToHtml(std::StringView text, const MarkdownOptions& options = MarkdownOptions())
{
  MarkdownNodes nodes;
  MarkdownBlockParser blocks(&nodes, options);
  blocks.parse(text);
  markdownParseInlines(&nodes, &blocks, blocks.document);
  MarkdownRenderer renderer;
  renderer.options = options;
  renderer.render(blocks.document);
  return renderer.out;
}

void markdownParseInlines(MarkdownNodes* nodes, MarkdownBlockParser* blocks, MarkdownNode* block)
{
  for (MarkdownNode* child = block->firstChild; child; child = child->next)
  {
    if (child->type == MarkdownType::paragraph || child->type == MarkdownType::heading || child->type == MarkdownType::tableCell)
    {
      MarkdownInlineParser parser(nodes, blocks);
      parser.parse(child);
    }
    else
      markdownParseInlines(nodes, blocks, child);
  }
}

// The text of inlines without their markup: a heading's for its id, an image's alt text.
void markdownPlainText(std::String& out, MarkdownNode* node)
{
  for (MarkdownNode* child = node->firstChild; child; child = child->next)
  {
    if (child->type == MarkdownType::text || child->type == MarkdownType::code || child->type == MarkdownType::htmlInline)
      out << (child->literal);
    else if (child->type == MarkdownType::softBreak || child->type == MarkdownType::lineBreak)
      out << '\n';
    else
      markdownPlainText(out, child);
  }
}

