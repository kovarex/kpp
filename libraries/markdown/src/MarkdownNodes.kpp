// Owns the nodes of one document.
struct MarkdownNodes
{
  MarkdownNode* make(MarkdownType type)
  {
    MarkdownNode& node = this->nodes.emplace_back();
    node.type = type;
    return &node;
  }
  MarkdownNode* text(StringView literal)
  {
    MarkdownNode* node = this->make(MarkdownType::text);
    node->literal = String(literal);
    return node;
  }

  Deque<MarkdownNode> nodes;
};
