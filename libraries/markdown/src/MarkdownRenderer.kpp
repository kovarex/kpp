struct MarkdownRenderer
{
  void literal(StringView text)
  {
    this->out << text;
    this->lastWasNewline = text.size() == 1 && text[0] == '\n';
  }

  void escaped(StringView text)
  {
    String e;
    for (char c : text)
    {
      if (c == '&')
        e << "&amp;";
      else if (c == '<')
        e << "&lt;";
      else if (c == '>')
        e << "&gt;";
      else if (c == '"')
        e << "&quot;";
      else
        e << c;
    }
    this->literal(e);
  }

  void newline()
  {
    if (!this->lastWasNewline)
      this->literal("\n");
  }

  String destination(MarkdownNode* node) const
  {
    return this->options.rewriteLink ? this->options.rewriteLink(node->destination) : node->destination;
  }

  void children(MarkdownNode* node)
  {
    for (MarkdownNode* child = node->firstChild; child; child = child->next)
      this->render(child);
  }

  // GitHub's heading id: lowercase, letters, digits, '-' and '_' kept, spaces as '-', the rest
  // dropped; a repeated id gets -1, -2...
  String headingId(MarkdownNode* heading)
  {
    String text;
    markdownPlainText(text, heading);
    String id;
    for (i32 i = 0; i < text.size();)
    {
      i32 length = 1;
      i32 c = markdownDecode(text, i, &length);
      if (c == ' ')
        id << '-';
      else if (markdownIsAlphanumeric(c) || c == '-' || c == '_')
        id << char(markdownLower(c));
      else if (c >= 0x80 && !markdownIsUnicodePunctuation(c) && !markdownIsUnicodeWhitespace(c))
        markdownAppendFolded(id, c);
      i += length;
    }
    String unique = id;
    for (i32 n = 1;; ++n)
    {
      bool used = false;
      for (const String& existing : this->ids)
        if (existing == unique)
          used = true;
      if (!used)
        break;
      unique = id + "-" + toString(n);
    }
    this->ids.push_back(unique);
    return unique;
  }

  void render(MarkdownNode* node)
  {
    switch (node->type)
    {
      case MarkdownType::document: this->children(node);
      case MarkdownType::paragraph:
      {
        MarkdownNode* grandparent = node->parent ? node->parent->parent : nullptr;
        if (grandparent && grandparent->type == MarkdownType::list && grandparent->tight)
        {
          this->children(node);
          break;
        }
        this->newline();
        this->literal("<p>");
        this->children(node);
        this->literal("</p>");
        this->newline();
      }
      case MarkdownType::heading:
      {
        String tag = "h" + toString(node->level);
        this->newline();
        if (this->options.headingIds)
        {
          this->literal("<" + tag + " id=\"");
          this->escaped(this->headingId(node));
          this->literal("\">");
        }
        else
          this->literal("<" + tag + ">");
        this->children(node);
        this->literal("</" + tag + ">");
        this->newline();
      }
      case MarkdownType::thematicBreak:
        this->newline();
        this->literal("<hr />");
        this->newline();
      case MarkdownType::blockQuote:
        this->newline();
        this->literal("<blockquote>");
        this->newline();
        this->children(node);
        this->newline();
        this->literal("</blockquote>");
        this->newline();
      case MarkdownType::list:
      {
        const char* tag = node->ordered ? "ol" : "ul";
        this->newline();
        if (node->ordered && node->start != 1)
          this->literal(toString("<ol start=\"", node->start, "\">"));
        else
          this->literal(toString("<", StringView(tag), ">"));
        this->newline();
        this->children(node);
        this->newline();
        this->literal(toString("</", StringView(tag), ">"));
        this->newline();
      }
      case MarkdownType::item:
        this->literal("<li>");
        this->children(node);
        this->literal("</li>");
        this->newline();
      case MarkdownType::codeBlock:
      {
        this->newline();
        i32 end = 0;
        while (end < node->info.size() && !markdownIsUnicodeWhitespace((u8)node->info[end]))
          ++end;
        if (end > 0)
        {
          this->literal("<pre><code class=\"language-");
          this->escaped(StringView(node->info).substr(0, end));
          this->literal("\">");
        }
        else
          this->literal("<pre><code>");
        this->escaped(node->literal);
        this->literal("</code></pre>");
        this->newline();
      }
      case MarkdownType::htmlBlock:
        this->newline();
        this->literal(node->literal);
        this->newline();
      case MarkdownType::table:
      {
        this->newline();
        this->literal("<table>");
        this->newline();
        bool body = false;
        for (MarkdownNode* row = node->firstChild; row; row = row->next)
        {
          if (row->header)
            this->literal("<thead>");
          else if (!body)
          {
            this->literal("<tbody>");
            body = true;
          }
          this->newline();
          this->literal("<tr>");
          this->newline();
          for (MarkdownNode* cell = row->firstChild; cell; cell = cell->next)
          {
            const char* tag = row->header ? "th" : "td";
            const char* align[] = {"", " align=\"left\"", " align=\"center\"", " align=\"right\""};
            this->literal(toString("<", StringView(tag), StringView(align[cell->alignment]), ">"));
            this->children(cell);
            this->literal(toString("</", StringView(tag), ">"));
            this->newline();
          }
          this->literal("</tr>");
          this->newline();
          if (row->header)
          {
            this->literal("</thead>");
            this->newline();
          }
        }
        if (body)
        {
          this->literal("</tbody>");
          this->newline();
        }
        this->literal("</table>");
        this->newline();
      }
      case MarkdownType::text: this->escaped(node->literal);
      case MarkdownType::softBreak: this->literal("\n");
      case MarkdownType::lineBreak:
        this->literal("<br />");
        this->newline();
      case MarkdownType::code:
        this->literal("<code>");
        this->escaped(node->literal);
        this->literal("</code>");
      case MarkdownType::emphasis:
        this->literal("<em>");
        this->children(node);
        this->literal("</em>");
      case MarkdownType::strong:
        this->literal("<strong>");
        this->children(node);
        this->literal("</strong>");
      case MarkdownType::link:
        this->literal("<a href=\"");
        this->escaped(this->destination(node));
        if (node->title.size() > 0)
        {
          this->literal("\" title=\"");
          this->escaped(node->title);
        }
        this->literal("\">");
        this->children(node);
        this->literal("</a>");
      case MarkdownType::image:
      {
        this->literal("<img src=\"");
        this->escaped(this->destination(node));
        this->literal("\" alt=\"");
        String alt;
        markdownPlainText(alt, node);
        this->escaped(alt);
        if (node->title.size() > 0)
        {
          this->literal("\" title=\"");
          this->escaped(node->title);
        }
        this->literal("\" />");
      }
      case MarkdownType::htmlInline: this->literal(node->literal);
      default:
    }
  }

  String out;
  MarkdownOptions options;
  bool lastWasNewline = true; // the last thing written was exactly "\n", or nothing
  Vector<String> ids;
};
