// The CommonMark spec's examples and the GFM spec's table examples (CommonMarkSpec.kpp, generated by
// generate_spec.py): markdownToHtml writes each one's HTML exactly. run.cmd copies this file next to
// the generated one and runs both.

test commonMarkSpecExamples
{
  int failed = 0;
  for (const CommonMarkExample& e : commonMarkExamples)
  {
    String html = markdownToHtml(e.markdown);
    if (html != e.html)
    {
      ++failed;
      println("example {} ({}): differs\n--- markdown\n{}--- expected\n{}--- got\n{}---", e.number, e.section, e.markdown, e.html, html);
    }
  }
  check(failed == 0);
}

test gfmSpecTableExamples
{
  MarkdownOptions options;
  options.tables = true;
  int failed = 0;
  for (const CommonMarkExample& e : gfmTableExamples)
  {
    String html = markdownToHtml(e.markdown, options);
    if (html != e.html)
    {
      ++failed;
      println("table example {}: differs\n--- markdown\n{}--- expected\n{}--- got\n{}---", e.number, e.markdown, e.html, html);
    }
  }
  check(failed == 0);
}

test theCommonMarkExamplesPassWithTablesOn
{
  MarkdownOptions options;
  options.tables = true;
  int differ = 0;
  for (const CommonMarkExample& e : commonMarkExamples)
    if (markdownToHtml(e.markdown, options) != e.html)
    {
      ++differ;
      println("with tables, example {} ({}) differs", e.number, e.section);
    }
  check(differ == 0);
}
