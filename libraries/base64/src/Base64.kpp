// Base64 and base64url (RFC 4648 sections 4 and 5). Decoding is strict: README.md lists what it
// rejects.

// Base64 with '+' and '/', padded with '='.
String base64Encode(StringView data) { return base64EncodeWith(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", true); }

// base64url: '-' and '_' instead of '+' and '/', unpadded unless pad (JWT and URLs leave it out).
String base64UrlEncode(StringView data, bool pad = false)
{
  return base64EncodeWith(data, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", pad);
}

// The bytes of padded base64 text; anything else throws Base64Error.
String base64Decode(StringView text) { return base64DecodeWith(text, false); }

// The bytes of base64url text, padded or not.
String base64UrlDecode(StringView text) { return base64DecodeWith(text, true); }

// As base64Decode and base64UrlDecode, but false instead of a throw.
bool tryBase64Decode(StringView text, String& out)
{
  try
  {
    out = base64Decode(text);
    return true;
  }
  catch (const Base64Error&)
  {
    return false;
  }
}
bool tryBase64UrlDecode(StringView text, String& out)
{
  try
  {
    out = base64UrlDecode(text);
    return true;
  }
  catch (const Base64Error&)
  {
    return false;
  }
}

String base64EncodeWith(StringView data, const char* alphabet, bool pad)
{
  String out;
  i32 i = 0;
  for (; i + 3 <= data.size(); i += 3)
  {
    u32 bits = (u32(u8(data[i])) << 16) | (u32(u8(data[i + 1])) << 8) | u32(u8(data[i + 2]));
    out << alphabet[(bits >> 18) & 63];
    out << alphabet[(bits >> 12) & 63];
    out << alphabet[(bits >> 6) & 63];
    out << alphabet[bits & 63];
  }
  i32 rest = data.size() - i;
  if (rest > 0)
  {
    u32 bits = u32(u8(data[i])) << 16;
    if (rest == 2)
      bits |= u32(u8(data[i + 1])) << 8;
    out << alphabet[(bits >> 18) & 63];
    out << alphabet[(bits >> 12) & 63];
    if (rest == 2)
      out << alphabet[(bits >> 6) & 63];
    if (pad)
      out << (rest == 1 ? StringView("==") : StringView("="));
  }
  return out;
}

// The 6 bits a character stands for, or -1.
i32 base64Value(char c, bool url)
{
  if (c >= 'A' && c <= 'Z')
    return c - 'A';
  if (c >= 'a' && c <= 'z')
    return c - 'a' + 26;
  if (c >= '0' && c <= '9')
    return c - '0' + 52;
  if (c == (url ? '-' : '+'))
    return 62;
  if (c == (url ? '_' : '/'))
    return 63;
  return -1;
}

void base64Fail(i32 offset, const char* what) { throw Base64Error(toString(offset, ": ", StringView(what)), offset); }

String base64DecodeWith(StringView text, bool url)
{
  // The characters before the padding, which is '=' or "==" at the end.
  i32 length = text.size();
  i32 padding = 0;
  while (padding < 2 && length > 0 && text[length - 1] == '=')
  {
    --length;
    ++padding;
  }
  for (i32 i = 0; i < length; ++i)
    if (base64Value(text[i], url) < 0)
      base64Fail(i, text[i] == '=' ? "'=' before the end" : url ? "a character that is not base64url" : "a character that is not base64");
  if (padding > 0 || !url)
    if ((length + padding) % 4 != 0)
      base64Fail(text.size(), url && padding > 0 ? "padded base64url whose length is not a multiple of 4"
                                                 : "base64 whose length is not a multiple of 4 (missing or extra '=')");
  if (length % 4 == 1)
    base64Fail(length, "a single base64 character left over at the end");
  if (padding > 0 && padding != 4 - length % 4)
    base64Fail(length, "the wrong number of '=' for the length");
  String out;
  u32 bits = 0;
  i32 count = 0;
  for (i32 i = 0; i < length; ++i)
  {
    bits = (bits << 6) | u32(base64Value(text[i], url));
    if (++count == 4)
    {
      out << char(bits >> 16);
      out << char(bits >> 8);
      out << char(bits);
      bits = 0;
      count = 0;
    }
  }
  // 2 characters are 1 byte and 4 spare bits, 3 are 2 bytes and 2 spare bits; set spare bits
  // would mean a second text for the same bytes.
  if (count == 2)
  {
    if ((bits & 15) != 0)
      base64Fail(length - 1, "the last character has bits set that no byte uses");
    out << char(bits >> 4);
  }
  else if (count == 3)
  {
    if ((bits & 3) != 0)
      base64Fail(length - 1, "the last character has bits set that no byte uses");
    out << char(bits >> 10);
    out << char(bits >> 2);
  }
  return out;
}
