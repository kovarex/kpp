// The parts a template is read into (HtmlTemplate).

struct HtmlTemplatePart
{
  i32 start;  // in the template's text; a hole's name for a hole
  i32 length;
  HtmlHole kind;
  i32 attributeStart = 0; // a flag's attribute name, without its '?'
  i32 attributeLength = 0;
};

constexpr i32 htmlTemplateMaxParts = 256;
constexpr i32 htmlTemplateMaxDepth = 64;
