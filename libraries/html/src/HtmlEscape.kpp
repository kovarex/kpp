// Escaping text for HTML.

// The text with & < > " ' as character references: safe in an element's text and in a quoted
// attribute value.
String htmlEscape(StringView text)
{
  String out;
  htmlAppendEscaped(out, text);
  return out;
}

// An ASCII letter in lower case; any other character as it is.
constexpr char htmlLower(char c) { return c >= 'A' && c <= 'Z' ? char(c - 'A' + 'a') : c; }

void htmlAppendEscaped(String& out, StringView text)
{
  for (int i = 0; i < text.size(); ++i)
  {
    char c = text[i];
    if (c == '&')
      out.append("&amp;");
    else if (c == '<')
      out.append("&lt;");
    else if (c == '>')
      out.append("&gt;");
    else if (c == '"')
      out.append("&quot;");
    else if (c == '\'')
      out.append("&#39;");
    else
      out.append(c);
  }
}
