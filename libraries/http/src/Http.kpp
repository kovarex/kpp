// HTTP requests and responses for web programs: the request as CGI (HttpCgi.kpp) or the built-in
// server (HttpServer.kpp) gives it, cookies, urlencoded and multipart forms, and the response with
// its status, headers, cookies and body. README.md has the API.

std::StringView httpStatusText(i32 status)
{
  switch (status)
  {
  case 200: return "OK";
  case 201: return "Created";
  case 204: return "No Content";
  case 301: return "Moved Permanently";
  case 302: return "Found";
  case 303: return "See Other";
  case 304: return "Not Modified";
  case 307: return "Temporary Redirect";
  case 308: return "Permanent Redirect";
  case 400: return "Bad Request";
  case 401: return "Unauthorized";
  case 403: return "Forbidden";
  case 404: return "Not Found";
  case 405: return "Method Not Allowed";
  case 411: return "Length Required";
  case 413: return "Content Too Large";
  case 415: return "Unsupported Media Type";
  case 431: return "Request Header Fields Too Large";
  case 500: return "Internal Server Error";
  case 501: return "Not Implemented";
  case 503: return "Service Unavailable";
  }
  return "Unknown";
}

std::String httpLower(std::StringView text)
{
  std::String out(text);
  for (std::ContainerSize i = 0; i < out.size(); ++i)
    if (out[i] >= 'A' && out[i] <= 'Z')
      out[i] = char(out[i] - 'A' + 'a');
  return out;
}

std::StringView httpTrim(std::StringView text)
{
  std::ContainerSize start = 0;
  std::ContainerSize end = text.size();
  while (start < end && (text[start] == ' ' || text[start] == '\t'))
    ++start;
  while (end > start && (text[end - 1] == ' ' || text[end - 1] == '\t'))
    --end;
  return text.substr(start, end - start);
}

// A header a response may carry: a token for a name, no line break or zero byte in the value
// (which would let the value write headers of its own).
void httpCheckHeader(std::StringView name, std::StringView value)
{
  if (name.empty())
    throw HttpError("a header with no name", 500);
  for (std::ContainerSize i = 0; i < name.size(); ++i)
    if (!httpIsToken(name[i]))
      throw HttpError(std::toString("the header name \"", name, "\" has a character a header name cannot have"), 500);
  for (std::ContainerSize i = 0; i < value.size(); ++i)
    if (value[i] == '\r' || value[i] == '\n' || value[i] == 0)
      throw HttpError(std::toString("the value of the header ", name, " has a line break or a zero byte"), 500);
}

bool httpIsToken(char c)
{
  if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
    return true;
  for (const char* p = "!#$%&'*+-.^_`|~"; *p != 0; ++p)
    if (*p == c)
      return true;
  return false;
}

// RFC 6265: a token for a name; a value of printable ASCII without space, '"', ',', ';' or '\'.
void httpCheckCookie(std::StringView name, std::StringView value)
{
  if (name.empty())
    throw HttpError("a cookie with no name", 500);
  for (std::ContainerSize i = 0; i < name.size(); ++i)
    if (!httpIsToken(name[i]))
      throw HttpError(std::toString("the cookie name \"", name, "\" is not a token"), 500);
  for (std::ContainerSize i = 0; i < value.size(); ++i)
  {
    u8 c = (u8)value[i];
    if (c <= 0x20 || c >= 0x7f || c == '"' || c == ',' || c == ';' || c == '\\')
      throw HttpError(std::toString("the value of the cookie ", name, " has a character a cookie cannot have (encode it)"), 500);
  }
}

// "a=1; b=2": the cookies in order (names and values as sent); a piece without '=' is skipped.
std::Vector<HttpHeader> httpParseCookies(std::StringView header)
{
  std::Vector<HttpHeader> cookies;
  std::ContainerSize at = 0;
  while (at < header.size())
  {
    std::ContainerSize end = header.find(';', at);
    if (end == std::StringView::npos)
      end = header.size();
    std::StringView piece = httpTrim(header.substr(at, end - at));
    std::ContainerSize equals = piece.find('=');
    if (equals != std::StringView::npos && equals > 0)
    {
      HttpHeader c;
      c.name = std::String(httpTrim(piece.substr(0, equals)));
      std::StringView value = httpTrim(piece.substr(equals + 1));
      if (value.size() >= 2 && value[0] == '"' && value[value.size() - 1] == '"')
        value = value.substr(1, value.size() - 2);
      c.value = std::String(value);
      cookies.push_back(c);
    }
    at = end + 1;
  }
  return cookies;
}

// The boundary parameter of a multipart Content-Type, quoted or not; none throws.
std::String httpBoundary(std::StringView contentType)
{
  std::ContainerSize at = httpLower(contentType).find("boundary=");
  if (at == std::String::npos)
    throw HttpError("a multipart body without a boundary");
  std::StringView value = contentType.substr(at + 9);
  if (!value.empty() && value[0] == '"')
  {
    std::ContainerSize close = value.find('"', 1);
    if (close == std::StringView::npos)
      throw HttpError("a multipart boundary's quote is not closed");
    return std::String(value.substr(1, close - 1));
  }
  std::ContainerSize end = value.find(';');
  return std::String(httpTrim(end == std::StringView::npos ? value : value.substr(0, end)));
}

// The parts of a multipart/form-data body (RFC 7578); a body that does not follow it throws.
std::Vector<HttpPart> httpParseMultipart(std::StringView body, std::StringView boundary)
{
  if (boundary.empty() || boundary.size() > 70)
    throw HttpError("a multipart boundary is 1 to 70 characters");
  std::String delimiter = std::toString("--", boundary);
  std::Vector<HttpPart> parts;
  std::ContainerSize at = body.find(delimiter);
  if (at == std::StringView::npos)
    throw HttpError("a multipart body without its first boundary");
  at += delimiter.size();
  for (;;)
  {
    if (body.substr(at, 2) == "--")
      return parts; // the closing delimiter
    if (body.substr(at, 2) != "\r\n")
      throw HttpError("a multipart boundary not followed by CRLF");
    at += 2;
    std::ContainerSize headersEnd = body.find("\r\n\r\n", at);
    if (headersEnd == std::StringView::npos)
      throw HttpError("a multipart part whose headers do not end");
    HttpPart part;
    bool named = false;
    std::StringView headers = body.substr(at, headersEnd - at);
    std::ContainerSize line = 0;
    while (line <= headers.size())
    {
      std::ContainerSize lineEnd = headers.find("\r\n", line);
      if (lineEnd == std::StringView::npos)
        lineEnd = headers.size();
      std::StringView text = headers.substr(line, lineEnd - line);
      std::ContainerSize colon = text.find(':');
      if (colon != std::StringView::npos)
      {
        std::String name = httpLower(httpTrim(text.substr(0, colon)));
        std::StringView value = httpTrim(text.substr(colon + 1));
        if (name == "content-disposition")
        {
          std::Optional<std::String> fieldName = httpDispositionParameter(value, "name");
          if (fieldName.has_value())
          {
            part.name = *fieldName;
            named = true;
          }
          part.filename = httpDispositionParameter(value, "filename");
        }
        else if (name == "content-type")
          part.contentType = std::String(value);
      }
      line = lineEnd + 2;
    }
    if (!named)
      throw HttpError("a multipart part without a Content-Disposition name");
    std::ContainerSize dataStart = headersEnd + 4;
    std::String next = std::toString("\r\n", delimiter);
    std::ContainerSize dataEnd = body.find(next, dataStart);
    if (dataEnd == std::StringView::npos)
      throw HttpError("a multipart part that does not end in a boundary");
    part.data = std::String(body.substr(dataStart, dataEnd - dataStart));
    parts.push_back(part);
    at = dataEnd + next.size();
  }
}

// A parameter of a Content-Disposition value (`form-data; name="x"; filename="a.sgf"`), unquoted.
std::Optional<std::String> httpDispositionParameter(std::StringView value, std::StringView parameter)
{
  std::ContainerSize at = 0;
  while (at < value.size())
  {
    std::ContainerSize end = at;
    bool quoted = false;
    while (end < value.size() && (quoted || value[end] != ';'))
    {
      if (value[end] == '"')
        quoted = !quoted;
      else if (value[end] == '\\' && quoted)
        ++end;
      ++end;
    }
    std::StringView piece = httpTrim(value.substr(at, end - at));
    std::ContainerSize equals = piece.find('=');
    if (equals != std::StringView::npos && httpLower(httpTrim(piece.substr(0, equals))) == parameter)
    {
      std::StringView raw = httpTrim(piece.substr(equals + 1));
      if (raw.size() >= 2 && raw[0] == '"' && raw[raw.size() - 1] == '"')
      {
        std::String out;
        for (std::ContainerSize i = 1; i + 1 < raw.size(); ++i)
        {
          if (raw[i] == '\\' && i + 2 < raw.size())
            ++i;
          out << raw[i];
        }
        return std::Optional<std::String>(out);
      }
      return std::Optional<std::String>(std::String(raw));
    }
    at = end + 1;
  }
  return std::Optional<std::String>();
}

// The request target split: path (decoded; a malformed %XX throws HttpError) and query (as sent).
void httpSetTarget(HttpRequest& request, std::StringView target)
{
  request.target = std::String(target);
  std::ContainerSize question = target.find('?');
  std::StringView path = question == std::StringView::npos ? target : target.substr(0, question);
  request.query = question == std::StringView::npos ? std::String() : std::String(target.substr(question + 1));
  try
  {
    request.path = url::urlDecode(path);
    request.parameters = url::parseUrlQuery(request.query);
  }
  catch (const url::UrlError& e)
  {
    throw HttpError(std::toString("a malformed request target: ", std::StringView(e.what())));
  }
}
