// HTTP requests and responses for web programs: the request as CGI (HttpCgi.kpp) or the built-in
// server (HttpServer.kpp) gives it, cookies, urlencoded and multipart forms, and the response with
// its status, headers, cookies and body. README.md has the API.

StringView httpStatusText(i32 status)
{
  switch (status)
  {
  case 200: return "OK";
  case 201: return "Created";
  case 204: return "No Content";
  case 301: return "Moved Permanently";
  case 302: return "Found";
  case 303: return "See Other";
  case 304: return "Not Modified";
  case 307: return "Temporary Redirect";
  case 308: return "Permanent Redirect";
  case 400: return "Bad Request";
  case 401: return "Unauthorized";
  case 403: return "Forbidden";
  case 404: return "Not Found";
  case 405: return "Method Not Allowed";
  case 411: return "Length Required";
  case 413: return "Content Too Large";
  case 415: return "Unsupported Media Type";
  case 431: return "Request Header Fields Too Large";
  case 500: return "Internal Server Error";
  case 501: return "Not Implemented";
  case 503: return "Service Unavailable";
  }
  return "Unknown";
}

String httpLower(StringView text)
{
  String out(text);
  for (ContainerSize i = 0; i < out.size(); ++i)
    if (out[i] >= 'A' && out[i] <= 'Z')
      out[i] = char(out[i] - 'A' + 'a');
  return out;
}

StringView httpTrim(StringView text)
{
  ContainerSize start = 0;
  ContainerSize end = text.size();
  while (start < end && (text[start] == ' ' || text[start] == '\t'))
    ++start;
  while (end > start && (text[end - 1] == ' ' || text[end - 1] == '\t'))
    --end;
  return text.substr(start, end - start);
}

// A header a response may carry: a token for a name, no line break or zero byte in the value
// (which would let the value write headers of its own).
void httpCheckHeader(StringView name, StringView value)
{
  if (name.empty())
    throw HttpError("a header with no name", 500);
  for (ContainerSize i = 0; i < name.size(); ++i)
    if (!httpIsToken(name[i]))
      throw HttpError(format("the header name \"{}\" has a character a header name cannot have", name), 500);
  for (ContainerSize i = 0; i < value.size(); ++i)
    if (value[i] == '\r' || value[i] == '\n' || value[i] == 0)
      throw HttpError(format("the value of the header {} has a line break or a zero byte", name), 500);
}

bool httpIsToken(char c)
{
  if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
    return true;
  for (const char* p = "!#$%&'*+-.^_`|~"; *p != 0; ++p)
    if (*p == c)
      return true;
  return false;
}

// RFC 6265: a token for a name; a value of printable ASCII without space, '"', ',', ';' or '\'.
void httpCheckCookie(StringView name, StringView value)
{
  if (name.empty())
    throw HttpError("a cookie with no name", 500);
  for (ContainerSize i = 0; i < name.size(); ++i)
    if (!httpIsToken(name[i]))
      throw HttpError(format("the cookie name \"{}\" is not a token", name), 500);
  for (ContainerSize i = 0; i < value.size(); ++i)
  {
    u8 c = (u8)value[i];
    if (c <= 0x20 || c >= 0x7f || c == '"' || c == ',' || c == ';' || c == '\\')
      throw HttpError(format("the value of the cookie {} has a character a cookie cannot have (encode it)", name), 500);
  }
}

// "a=1; b=2": the cookies in order (names and values as sent); a piece without '=' is skipped.
Vector<HttpHeader> httpParseCookies(StringView header)
{
  Vector<HttpHeader> cookies;
  ContainerSize at = 0;
  while (at < header.size())
  {
    ContainerSize end = header.find(';', at);
    if (end == StringView::npos)
      end = header.size();
    StringView piece = httpTrim(header.substr(at, end - at));
    ContainerSize equals = piece.find('=');
    if (equals != StringView::npos && equals > 0)
    {
      HttpHeader c;
      c.name = String(httpTrim(piece.substr(0, equals)));
      StringView value = httpTrim(piece.substr(equals + 1));
      if (value.size() >= 2 && value[0] == '"' && value[value.size() - 1] == '"')
        value = value.substr(1, value.size() - 2);
      c.value = String(value);
      cookies.push_back(c);
    }
    at = end + 1;
  }
  return cookies;
}

// The boundary parameter of a multipart Content-Type, quoted or not; none throws.
String httpBoundary(StringView contentType)
{
  ContainerSize at = httpLower(contentType).find("boundary=");
  if (at == String::npos)
    throw HttpError("a multipart body without a boundary");
  StringView value = contentType.substr(at + 9);
  if (!value.empty() && value[0] == '"')
  {
    ContainerSize close = value.find('"', 1);
    if (close == StringView::npos)
      throw HttpError("a multipart boundary's quote is not closed");
    return String(value.substr(1, close - 1));
  }
  ContainerSize end = value.find(';');
  return String(httpTrim(end == StringView::npos ? value : value.substr(0, end)));
}

// The parts of a multipart/form-data body (RFC 7578); a body that does not follow it throws.
Vector<HttpPart> httpParseMultipart(StringView body, StringView boundary)
{
  if (boundary.empty() || boundary.size() > 70)
    throw HttpError("a multipart boundary is 1 to 70 characters");
  String delimiter = String("--") + String(boundary);
  Vector<HttpPart> parts;
  ContainerSize at = body.find(delimiter);
  if (at == StringView::npos)
    throw HttpError("a multipart body without its first boundary");
  at += delimiter.size();
  for (;;)
  {
    if (body.substr(at, 2) == "--")
      return parts; // the closing delimiter
    if (body.substr(at, 2) != "\r\n")
      throw HttpError("a multipart boundary not followed by CRLF");
    at += 2;
    ContainerSize headersEnd = body.find("\r\n\r\n", at);
    if (headersEnd == StringView::npos)
      throw HttpError("a multipart part whose headers do not end");
    HttpPart part;
    bool named = false;
    StringView headers = body.substr(at, headersEnd - at);
    ContainerSize line = 0;
    while (line <= headers.size())
    {
      ContainerSize lineEnd = headers.find("\r\n", line);
      if (lineEnd == StringView::npos)
        lineEnd = headers.size();
      StringView text = headers.substr(line, lineEnd - line);
      ContainerSize colon = text.find(':');
      if (colon != StringView::npos)
      {
        String name = httpLower(httpTrim(text.substr(0, colon)));
        StringView value = httpTrim(text.substr(colon + 1));
        if (name == "content-disposition")
        {
          Optional<String> fieldName = httpDispositionParameter(value, "name");
          if (fieldName.has_value())
          {
            part.name = *fieldName;
            named = true;
          }
          part.filename = httpDispositionParameter(value, "filename");
        }
        else if (name == "content-type")
          part.contentType = String(value);
      }
      line = lineEnd + 2;
    }
    if (!named)
      throw HttpError("a multipart part without a Content-Disposition name");
    ContainerSize dataStart = headersEnd + 4;
    String next = String("\r\n") + delimiter;
    ContainerSize dataEnd = body.find(next, dataStart);
    if (dataEnd == StringView::npos)
      throw HttpError("a multipart part that does not end in a boundary");
    part.data = String(body.substr(dataStart, dataEnd - dataStart));
    parts.push_back(part);
    at = dataEnd + next.size();
  }
}

// A parameter of a Content-Disposition value (`form-data; name="x"; filename="a.sgf"`), unquoted.
Optional<String> httpDispositionParameter(StringView value, StringView parameter)
{
  ContainerSize at = 0;
  while (at < value.size())
  {
    ContainerSize end = at;
    bool quoted = false;
    while (end < value.size() && (quoted || value[end] != ';'))
    {
      if (value[end] == '"')
        quoted = !quoted;
      else if (value[end] == '\\' && quoted)
        ++end;
      ++end;
    }
    StringView piece = httpTrim(value.substr(at, end - at));
    ContainerSize equals = piece.find('=');
    if (equals != StringView::npos && httpLower(httpTrim(piece.substr(0, equals))) == parameter)
    {
      StringView raw = httpTrim(piece.substr(equals + 1));
      if (raw.size() >= 2 && raw[0] == '"' && raw[raw.size() - 1] == '"')
      {
        String out;
        for (ContainerSize i = 1; i + 1 < raw.size(); ++i)
        {
          if (raw[i] == '\\' && i + 2 < raw.size())
            ++i;
          out << raw[i];
        }
        return Optional<String>(out);
      }
      return Optional<String>(String(raw));
    }
    at = end + 1;
  }
  return Optional<String>();
}

// The request target split: path (decoded; a malformed %XX throws HttpError) and query (as sent).
void httpSetTarget(HttpRequest& request, StringView target)
{
  request.target = String(target);
  ContainerSize question = target.find('?');
  StringView path = question == StringView::npos ? target : target.substr(0, question);
  request.query = question == StringView::npos ? String() : String(target.substr(question + 1));
  try
  {
    request.path = url::urlDecode(path);
    request.parameters = url::parseUrlQuery(request.query);
  }
  catch (const url::UrlError& e)
  {
    throw HttpError(format("a malformed request target: {}", StringView(e.what())));
  }
}
