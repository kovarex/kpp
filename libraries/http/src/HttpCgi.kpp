// CGI (RFC 3875): the web server runs the program once per request, with the request in the
// environment and the body on stdin; the response goes to stdout. Apache on NearlyFreeSpeech.NET
// runs any executable ending in .cgi this way.

// The C runtime's environment and its binary mode for stdin and stdout (CR LF stays CR LF).
extern "C" char*** __p__environ(); // Windows' UCRT: _environ is (*__p__environ())
extern "C" char** environ;         // POSIX
extern "C" int _setmode(int fd, int mode);

char** httpEnvironment()
{
  if constexpr (config::platform == Platform::Windows)
    return *__p__environ();
  else
    return environ;
}

// The request CGI gives this process: REQUEST_METHOD, REQUEST_URI (Apache's) or SCRIPT_NAME,
// PATH_INFO and QUERY_STRING, the HTTP_* variables as headers, CONTENT_TYPE and CONTENT_LENGTH,
// REMOTE_ADDR, and CONTENT_LENGTH bytes of stdin.
HttpRequest httpReadCgiRequest()
{
  HttpRequest request;
  for (char** variable = httpEnvironment(); *variable != nullptr; ++variable)
  {
    std::StringView entry(*variable);
    std::ContainerSize equals = entry.find('=');
    if (equals == std::StringView::npos)
      continue;
    std::StringView name = entry.substr(0, equals);
    std::StringView value = entry.substr(equals + 1);
    if (name.size() > 5 && name.substr(0, 5) == "HTTP_")
    {
      HttpHeader h;
      h.name = httpLower(name.substr(5));
      for (std::ContainerSize i = 0; i < h.name.size(); ++i)
        if (h.name[i] == '_')
          h.name[i] = '-';
      h.value = std::String(value);
      request.headers.push_back(h);
    }
    else if (name == "CONTENT_TYPE" || name == "CONTENT_LENGTH")
    {
      HttpHeader h;
      h.name = name == "CONTENT_TYPE" ? std::String("content-type") : std::String("content-length");
      h.value = std::String(value);
      request.headers.push_back(h);
    }
  }
  request.method = httpCgiVariable("REQUEST_METHOD");
  if (request.method.empty())
    throw HttpError("REQUEST_METHOD is not set: this program runs as CGI", 500);
  std::String target = httpCgiVariable("REQUEST_URI");
  if (target.empty())
  {
    target = httpCgiVariable("SCRIPT_NAME") + httpCgiVariable("PATH_INFO");
    std::String query = httpCgiVariable("QUERY_STRING");
    if (!query.empty())
      target = target + "?" + query;
  }
  httpSetTarget(request, target);
  request.remoteAddress = httpCgiVariable("REMOTE_ADDR");
  const std::String* length = request.header("content-length");
  if (length != nullptr && !length->empty())
  {
    i64 n = httpParseLength(*length);
    if constexpr (config::platform == Platform::Windows)
      _setmode(0, 0x8000); // _O_BINARY
    request.body.resize((std::ContainerSize)n);
    std::ContainerSize got = n == 0 ? 0 : fread(request.body.data(), 1, (usize)n, stdin);
    if ((i64)got != n)
      throw HttpError(std::toString("the body ended after ", (i64)got, " of its ", n, " bytes"));
  }
  return request;
}

std::String httpCgiVariable(const char* name)
{
  const char* value = std::getenv(name);
  return value == nullptr ? std::String() : std::String(std::StringView(value));
}

// A Content-Length: digits only.
i64 httpParseLength(std::StringView text)
{
  if (text.empty() || text.size() > 15)
    throw HttpError(std::toString("a Content-Length of \"", text, "\""));
  i64 n = 0;
  for (std::ContainerSize i = 0; i < text.size(); ++i)
  {
    if (text[i] < '0' || text[i] > '9')
      throw HttpError(std::toString("a Content-Length of \"", text, "\""));
    n = n * 10 + (text[i] - '0');
  }
  return n;
}

void httpWriteCgiResponse(const HttpResponse& response)
{
  if constexpr (config::platform == Platform::Windows)
    _setmode(1, 0x8000); // _O_BINARY
  std::String out = response.head(true);
  if (response.header("Content-Length") == nullptr)
    out << "Content-Length: " << (i64)response.body.size() << "\r\n";
  out << "\r\n";
  out << response.body;
  fwrite(out.data(), 1, out.size(), stdout);
  fflush(stdout);
}

// Answers the one request of this CGI process with handler. A request that cannot be read is a
// 4xx response; an exception from handler is a 500 with no detail for the browser and the message
// on stderr, which the web server writes to its error log. Returns main's exit code.
i32 httpCgi(const std::Function<void(const HttpRequest&, HttpResponse&)>& handler)
{
  HttpResponse response;
  try
  {
    HttpRequest request = httpReadCgiRequest();
    handler(request, response);
  }
  catch (const HttpError& e)
  {
    fprintf(stderr, "%s\n", e.what());
    response = httpErrorResponse(e.status);
  }
  catch (const std::Exception& e)
  {
    fprintf(stderr, "%s\n", e.what());
    response = httpErrorResponse(500);
  }
  httpWriteCgiResponse(response);
  return 0;
}

HttpResponse httpErrorResponse(i32 status)
{
  HttpResponse response;
  response.status = status;
  response.setHeader("Content-Type", "text/plain; charset=utf-8");
  response.body = std::toString(status, " ", httpStatusText(status), "\n");
  return response;
}
