struct HttpRequest
{
  // The first header of that name (any case), or nullptr.
  const std::String* header(std::StringView name) const
  {
    std::String lower = httpLower(name);
    for (const HttpHeader& h : this.headers)
      if (h.name == lower)
        return &h.value;
    return nullptr;
  }

  // The query's first parameter of that name, or nullptr.
  const std::String* parameter(std::StringView name) const { return url::findUrlQueryParameter(this.parameters, name); }

  // The value of the cookie of that name, or nullptr.
  std::Optional<std::String> cookie(std::StringView name) const
  {
    const std::String* header = this.header("cookie");
    if (header == nullptr)
      return std::Optional<std::String>();
    for (const HttpHeader& c : httpParseCookies(*header))
      if (c.name == name)
        return std::Optional<std::String>(c.value);
    return std::Optional<std::String>();
  }

  // The body's fields when it is application/x-www-form-urlencoded or multipart/form-data (files
  // left out: multipart() has them); another body throws HttpError (415).
  std::Vector<url::UrlQueryParameter> form() const
  {
    std::String type = this.contentType();
    if (type == "application/x-www-form-urlencoded")
      return url::parseUrlQuery(this.body);
    if (type == "multipart/form-data")
    {
      std::Vector<url::UrlQueryParameter> fields;
      for (const HttpPart& part : this.multipart())
        if (!part.filename.has_value())
        {
          url::UrlQueryParameter p;
          p.name = part.name;
          p.value = part.data;
          fields.push_back(p);
        }
      return fields;
    }
    if (this.body.empty())
      return std::Vector<url::UrlQueryParameter>();
    throw HttpError(std::toString("a form cannot be read from a body of type \"", type, "\""), 415);
  }

  // The parts of a multipart/form-data body; another type throws HttpError (415).
  std::Vector<HttpPart> multipart() const
  {
    const std::String* header = this.header("content-type");
    if (header == nullptr || this.contentType() != "multipart/form-data")
      throw HttpError("the body is not multipart/form-data", 415);
    return httpParseMultipart(this.body, httpBoundary(*header));
  }

  // The Content-Type's media type in lower case, without its parameters; empty without one.
  std::String contentType() const
  {
    const std::String* header = this.header("content-type");
    if (header == nullptr)
      return std::String();
    std::StringView type = *header;
    std::ContainerSize semicolon = type.find(';');
    if (semicolon != std::StringView::npos)
      type = type.substr(0, semicolon);
    return httpLower(httpTrim(type));
  }

  std::String method;                              // "GET", "POST"...
  std::String target;                              // as sent: "/player?id=5"
  std::String path;                                // decoded: "/player"
  std::String query;                               // as sent: "id=5"
  std::Vector<url::UrlQueryParameter> parameters;  // the query's, decoded
  std::Vector<HttpHeader> headers;                 // names in lower case
  std::String body;
  std::String remoteAddress;
};
