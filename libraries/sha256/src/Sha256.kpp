// SHA-256 (FIPS 180-4) and HMAC-SHA-256 (RFC 2104). README.md has the API and the test vectors.

// A SHA-256 digest: 32 bytes.
struct Sha256Digest
{
  uint8_t bytes[32];

  // Lowercase hex, 64 characters.
  String hex() const
  {
    const char* digits = "0123456789abcdef";
    String out;
    for (int i = 0; i < 32; ++i)
    {
      out.append(digits[this->bytes[i] >> 4]);
      out.append(digits[this->bytes[i] & 15]);
    }
    return out;
  }
  // The 32 bytes as a String.
  String data() const { return String((const char*)this->bytes, 32); }
  String str() const { return this->hex(); }

  // In constant time: how long it takes says nothing about where two digests differ.
  bool operator==(const Sha256Digest& other) const { return Sha256::constantTimeEqual(this->view(), other.view()); }
  bool operator!=(const Sha256Digest& other) const { return !(*this == other); }

  StringView view() const { return StringView((const char*)this->bytes, 32); }
};

// SHA-256 of data given in parts: update() any number of times, then finish() once.
struct Sha256
{
  uint32_t state[8];
  uint8_t block[64];
  int blockLength = 0;      // bytes in block
  uint64_t totalLength = 0; // bytes given
  bool finished = false;

  Sha256() { this->reset(); }

  // Starts again, as a new Sha256.
  void reset()
  {
    this->state[0] = 0x6a09e667u;
    this->state[1] = 0xbb67ae85u;
    this->state[2] = 0x3c6ef372u;
    this->state[3] = 0xa54ff53au;
    this->state[4] = 0x510e527fu;
    this->state[5] = 0x9b05688cu;
    this->state[6] = 0x1f83d9abu;
    this->state[7] = 0x5be0cd19u;
    this->blockLength = 0;
    this->totalLength = 0;
    this->finished = false;
  }

  void update(const void* data, int64_t length)
  {
    release_assert(!this->finished); // update() after finish(): reset() first
    const uint8_t* bytes = (const uint8_t*)data;
    this->totalLength += uint64_t(length);
    while (length > 0)
    {
      if (this->blockLength == 0 && length >= 64)
      {
        this->compress(bytes);
        bytes += 64;
        length -= 64;
        continue;
      }
      int take = 64 - this->blockLength;
      if (take > length)
        take = int(length);
      for (int i = 0; i < take; ++i)
        this->block[this->blockLength + i] = bytes[i];
      this->blockLength += take;
      bytes += take;
      length -= take;
      if (this->blockLength == 64)
      {
        this->compress(this->block);
        this->blockLength = 0;
      }
    }
  }
  void update(StringView data) { this->update(data.data(), data.size()); }

  // The digest of everything given; after it, only reset() is allowed.
  Sha256Digest finish()
  {
    release_assert(!this->finished); // finish() twice: reset() first
    uint64_t bits = this->totalLength * 8;
    uint8_t padding[72];
    int padLength = (this->blockLength < 56 ? 56 : 120) - this->blockLength;
    padding[0] = 0x80;
    for (int i = 1; i < padLength; ++i)
      padding[i] = 0;
    for (int i = 0; i < 8; ++i)
      padding[padLength + i] = uint8_t(bits >> (56 - 8 * i));
    uint64_t total = this->totalLength;
    this->update(padding, padLength + 8);
    this->totalLength = total;
    this->finished = true;
    Sha256Digest digest;
    for (int i = 0; i < 8; ++i)
    {
      digest.bytes[4 * i] = uint8_t(this->state[i] >> 24);
      digest.bytes[4 * i + 1] = uint8_t(this->state[i] >> 16);
      digest.bytes[4 * i + 2] = uint8_t(this->state[i] >> 8);
      digest.bytes[4 * i + 3] = uint8_t(this->state[i]);
    }
    return digest;
  }

  // Whether a and b are the same bytes, in a time that depends on their lengths only: for
  // comparing a MAC or a token with the expected one.
  static bool constantTimeEqual(StringView a, StringView b)
  {
    if (a.size() != b.size())
      return false;
    uint8_t difference = 0;
    for (int i = 0; i < a.size(); ++i)
      difference |= uint8_t(a[i] ^ b[i]);
    return difference == 0;
  }

  static uint32_t rotateRight(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }

  // FIPS 180-4 6.2.2 on one 64-byte block.
  void compress(const uint8_t* data)
  {
    static const uint32_t k[64] = {
      0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
      0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
      0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
      0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
      0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
      0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
      0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
      0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};
    uint32_t w[64];
    for (int i = 0; i < 16; ++i)
      w[i] = (uint32_t(data[4 * i]) << 24) | (uint32_t(data[4 * i + 1]) << 16) | (uint32_t(data[4 * i + 2]) << 8) | uint32_t(data[4 * i + 3]);
    for (int i = 16; i < 64; ++i)
    {
      uint32_t s0 = Sha256::rotateRight(w[i - 15], 7) ^ Sha256::rotateRight(w[i - 15], 18) ^ (w[i - 15] >> 3);
      uint32_t s1 = Sha256::rotateRight(w[i - 2], 17) ^ Sha256::rotateRight(w[i - 2], 19) ^ (w[i - 2] >> 10);
      w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    uint32_t a = this->state[0], b = this->state[1], c = this->state[2], d = this->state[3];
    uint32_t e = this->state[4], f = this->state[5], g = this->state[6], h = this->state[7];
    for (int i = 0; i < 64; ++i)
    {
      uint32_t s1 = Sha256::rotateRight(e, 6) ^ Sha256::rotateRight(e, 11) ^ Sha256::rotateRight(e, 25);
      uint32_t choose = (e & f) ^ (~e & g);
      uint32_t t1 = h + s1 + choose + k[i] + w[i];
      uint32_t s0 = Sha256::rotateRight(a, 2) ^ Sha256::rotateRight(a, 13) ^ Sha256::rotateRight(a, 22);
      uint32_t majority = (a & b) ^ (a & c) ^ (b & c);
      uint32_t t2 = s0 + majority;
      h = g;
      g = f;
      f = e;
      e = d + t1;
      d = c;
      c = b;
      b = a;
      a = t1 + t2;
    }
    this->state[0] += a;
    this->state[1] += b;
    this->state[2] += c;
    this->state[3] += d;
    this->state[4] += e;
    this->state[5] += f;
    this->state[6] += g;
    this->state[7] += h;
  }
};

// SHA-256 of the bytes.
Sha256Digest sha256(StringView data)
{
  Sha256 hash;
  hash.update(data);
  return hash.finish();
}

// HMAC-SHA-256 (RFC 2104) of the message under the key; a key longer than 64 bytes is hashed first.
Sha256Digest hmacSha256(StringView key, StringView message)
{
  uint8_t keyBlock[64];
  for (int i = 0; i < 64; ++i)
    keyBlock[i] = 0;
  if (key.size() > 64)
  {
    Sha256Digest hashed = sha256(key);
    for (int i = 0; i < 32; ++i)
      keyBlock[i] = hashed.bytes[i];
  }
  else
    for (int i = 0; i < key.size(); ++i)
      keyBlock[i] = uint8_t(key[i]);
  uint8_t pad[64];
  for (int i = 0; i < 64; ++i)
    pad[i] = keyBlock[i] ^ 0x36;
  Sha256 inner;
  inner.update(pad, 64);
  inner.update(message);
  Sha256Digest innerDigest = inner.finish();
  for (int i = 0; i < 64; ++i)
    pad[i] = keyBlock[i] ^ 0x5c;
  Sha256 outer;
  outer.update(pad, 64);
  outer.update(innerDigest.bytes, 32);
  return outer.finish();
}
