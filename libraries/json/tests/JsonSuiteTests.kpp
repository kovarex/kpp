// The JSONTestSuite parsing cases (JsonTestSuite.kpp, generated by generate_suite.py): y_ text
// parses and n_ text does not; i_ text gets the result README.md documents. Text that parses
// writes back to text that parses to the same value.
test JSONTestSuite
{
  for (const JsonSuiteCase& c : jsonSuiteCases)
  {
    JsonValue value;
    JsonParseError error;
    bool parsed = tryParseJson(StringView(c.text, c.length), value, &error);
    if (parsed != c.accept)
      println(StringView(c.name), ": ", parsed ? String("parsed, but should not") : toString("did not parse: ", error.message));
    check(parsed == c.accept);
    if (parsed)
    {
      String written = writeJson(value);
      JsonValue again;
      check(tryParseJson(written, again));
      check(again == value);
    }
  }
}
