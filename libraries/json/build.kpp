// json: JSON parsing and writing (README.md). `kpp --test` here runs its tests.
void build(Project& project)
{
  Library& json = project.library("json");
  json.version = "0.1.0";
  json.license = "Apache-2.0 WITH LLVM-exception";
  json.minimumKpp = "0.1.0";
  json.thisReference = true;
  json.root("src");
  json.test("tests");
}
