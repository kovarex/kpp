// Writing JSON text. A number is written so that parseJson reads back the same double
// (README.md, "Numbers"); NaN, infinity and strings that are not UTF-8 have no JSON form and
// throw JsonTypeError rather than write text that would read back as something else.

// Compact: no whitespace.
String writeJson(const JsonValue& value)
{
  String out;
  jsonWrite(out, value, -1, 0);
  return out;
}

// One member or element per line, indented by indent spaces per level.
String writeJsonPretty(const JsonValue& value, i32 indent = 2)
{
  String out;
  jsonWrite(out, value, indent, 0);
  return out;
}

// Appends the value; indent < 0 is compact.
void jsonWrite(String& out, const JsonValue& value, i32 indent, i32 level)
{
  switch (value.type)
  {
    case JsonType::null: out << "null"; return;
    case JsonType::boolean: out << (value.booleanValue ? StringView("true") : StringView("false")); return;
    case JsonType::integer: out << toString(value.integerValue); return;
    case JsonType::number: jsonWriteNumber(out, value.numberValue); return;
    case JsonType::string: jsonWriteString(out, value.stringValue); return;
    case JsonType::array:
    case JsonType::object:
    {
      bool object = value.type == JsonType::object;
      out << (object ? '{' : '[');
      for (i32 i = 0; i < value.items.size(); ++i)
      {
        if (i > 0)
          out << ',';
        jsonNewLine(out, indent, level + 1);
        if (object)
        {
          jsonWriteString(out, value.keys[i]);
          out << (indent < 0 ? StringView(":") : StringView(": "));
        }
        jsonWrite(out, value.items[i], indent, level + 1);
      }
      if (value.items.size() > 0)
        jsonNewLine(out, indent, level);
      out << (object ? '}' : ']');
      return;
    }
  }
}

void jsonNewLine(String& out, i32 indent, i32 level)
{
  if (indent < 0)
    return;
  out << '\n';
  for (i32 i = 0; i < indent * level; ++i)
    out << ' ';
}

// The shortest of %.15g, %.16g and %.17g that strtod reads back as the same double: 17
// significant digits always do, and a double that 15 digits can name gets its shortest form.
// Always has a '.' or an exponent, so it reads back as a number, not an integer.
void jsonWriteNumber(String& out, double value)
{
  if (!isfinite(value))
    throw JsonTypeError("JSON has no form for NaN or infinity");
  char buffer[40];
  i32 n = 0;
  for (i32 precision = 15; precision <= 17; ++precision)
  {
    n = snprintf(buffer, 40, "%.*g", precision, value);
    if (strtod(buffer, nullptr) == value)
      break;
  }
  bool hasPoint = false;
  for (i32 i = 0; i < n; ++i)
    if (buffer[i] == '.' || buffer[i] == 'e')
      hasPoint = true;
  out << StringView(buffer, n);
  if (!hasPoint)
    out << ".0";
}

void jsonWriteString(String& out, StringView text)
{
  if (!jsonIsUtf8(text))
    throw JsonTypeError("a JSON string must be UTF-8");
  out << '"';
  const char* hex = "0123456789abcdef";
  for (i32 i = 0; i < text.size(); ++i)
  {
    u8 c = (u8)text[i];
    if (c == '"')
      out << "\\\"";
    else if (c == '\\')
      out << "\\\\";
    else if (c == '\n')
      out << "\\n";
    else if (c == '\r')
      out << "\\r";
    else if (c == '\t')
      out << "\\t";
    else if (c == '\b')
      out << "\\b";
    else if (c == '\f')
      out << "\\f";
    else if (c < 0x20)
    {
      out << "\\u00";
      out << hex[c >> 4];
      out << hex[c & 15];
    }
    else
      out << char(c);
  }
  out << '"';
}
