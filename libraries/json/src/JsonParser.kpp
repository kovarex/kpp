struct JsonParser
{
  JsonParser(StringView text) : start(text.data()), at(text.data()), end(text.data() + text.size()) {}

  JsonValue parseDocument()
  {
    if (this->end - this->at >= 3 && (u8)this->at[0] == 0xEF && (u8)this->at[1] == 0xBB && (u8)this->at[2] == 0xBF)
      this->fail("a byte order mark before the JSON text (RFC 8259 8.1: not allowed)");
    this->skipWhitespace();
    JsonValue value;
    this->parseValue(value);
    this->skipWhitespace();
    if (this->at != this->end)
      this->fail("text after the JSON value");
    return value;
  }

  void fail(StringView what)
  {
    i32 line = 1;
    const char* lineStart = this->start;
    for (const char* c = this->start; c < this->at; ++c)
      if (*c == '\n')
      {
        ++line;
        lineStart = c + 1;
      }
    i32 column = i32(this->at - lineStart) + 1;
    throw JsonParseError(toString(line, ":", column, ": ", what), line, column);
  }

  void skipWhitespace()
  {
    while (this->at < this->end && (*this->at == ' ' || *this->at == '\t' || *this->at == '\n' || *this->at == '\r'))
      ++this->at;
  }

  bool literal(const char* word)
  {
    const char* c = this->at;
    for (const char* w = word; *w; ++w, ++c)
      if (c == this->end || *c != *w)
        return false;
    this->at = c;
    return true;
  }

  void parseValue(JsonValue& out)
  {
    if (this->at == this->end)
      this->fail("expected a value, found the end of the text");
    char c = *this->at;
    if (c == '{')
      this->parseObject(out);
    else if (c == '[')
      this->parseArray(out);
    else
      this->parseLeaf(out, c);
  }

  // Apart from parseValue, which every level of nesting has on the stack: this one's temporaries are
  // JsonValues, and a debug build gives each its place in the frame.
  void parseLeaf(JsonValue& out, char c)
  {
    if (c == '"')
    {
      out.type = JsonType::string;
      this->parseString(out.stringValue);
    }
    else if (c == '-' || (c >= '0' && c <= '9'))
      this->parseNumber(out);
    else if (this->literal("true"))
      out = JsonValue(true);
    else if (this->literal("false"))
      out = JsonValue(false);
    else if (this->literal("null"))
      out = JsonValue();
    else
      this->fail("expected a value");
  }

  void enter()
  {
    if (++this->depth > jsonMaxDepth)
      this->fail(toString("nesting deeper than ", jsonMaxDepth, " levels"));
  }

  void parseArray(JsonValue& out)
  {
    this->enter();
    out = JsonValue::array();
    ++this->at; // [
    this->skipWhitespace();
    if (this->at < this->end && *this->at == ']')
    {
      ++this->at;
      --this->depth;
      return;
    }
    while (true)
    {
      this->skipWhitespace();
      out.items.push_back(JsonValue());
      this->parseValue(out.items.back());
      this->skipWhitespace();
      if (this->at == this->end)
        this->fail("expected ',' or ']' in an array, found the end of the text");
      if (*this->at == ']')
        break;
      if (*this->at != ',')
        this->fail("expected ',' or ']' in an array");
      ++this->at;
    }
    ++this->at;
    --this->depth;
  }

  void parseObject(JsonValue& out)
  {
    this->enter();
    out = JsonValue::object();
    ++this->at; // {
    this->skipWhitespace();
    if (this->at < this->end && *this->at == '}')
    {
      ++this->at;
      --this->depth;
      return;
    }
    while (true)
    {
      this->skipWhitespace();
      if (this->at == this->end || *this->at != '"')
        this->fail("expected a string as an object's key");
      String key;
      this->parseString(key);
      this->skipWhitespace();
      if (this->at == this->end || *this->at != ':')
        this->fail("expected ':' after an object's key");
      ++this->at;
      this->skipWhitespace();
      JsonValue value;
      this->parseValue(value);
      // A repeated key: the last value wins, in the first one's place (README.md).
      out.set(key, value);
      this->skipWhitespace();
      if (this->at == this->end)
        this->fail("expected ',' or '}' in an object, found the end of the text");
      if (*this->at == '}')
        break;
      if (*this->at != ',')
        this->fail("expected ',' or '}' in an object");
      ++this->at;
    }
    ++this->at;
    --this->depth;
  }

  i32 hexDigit(char c)
  {
    if (c >= '0' && c <= '9')
      return c - '0';
    if (c >= 'a' && c <= 'f')
      return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
      return c - 'A' + 10;
    return -1;
  }

  // The four hex digits after "\u".
  i32 parseHex4()
  {
    if (this->end - this->at < 4)
      this->fail("expected four hex digits after \\u");
    i32 code = 0;
    for (i32 i = 0; i < 4; ++i)
    {
      i32 digit = this->hexDigit(this->at[i]);
      if (digit < 0)
      {
        this->at += i;
        this->fail("expected four hex digits after \\u");
      }
      code = code * 16 + digit;
    }
    this->at += 4;
    return code;
  }

  void parseString(String& out)
  {
    ++this->at; // "
    while (true)
    {
      if (this->at == this->end)
        this->fail("a string without its closing '\"'");
      u8 c = (u8)*this->at;
      if (c == '"')
      {
        ++this->at;
        return;
      }
      if (c < 0x20)
        this->fail("a control character in a string (it must be escaped)");
      if (c == '\\')
      {
        ++this->at;
        if (this->at == this->end)
          this->fail("a string without its closing '\"'");
        char e = *this->at;
        ++this->at;
        if (e == '"' || e == '\\' || e == '/')
          out << e;
        else if (e == 'b')
          out << '\b';
        else if (e == 'f')
          out << '\f';
        else if (e == 'n')
          out << '\n';
        else if (e == 'r')
          out << '\r';
        else if (e == 't')
          out << '\t';
        else if (e == 'u')
        {
          i32 code = this->parseHex4();
          if (code >= 0xDC00 && code <= 0xDFFF)
          {
            this->at -= 6;
            this->fail("\\u escape of a low surrogate without a high surrogate before it");
          }
          if (code >= 0xD800 && code <= 0xDBFF)
          {
            if (this->end - this->at < 2 || this->at[0] != '\\' || this->at[1] != 'u')
            {
              this->at -= 6;
              this->fail("\\u escape of a high surrogate without a low surrogate after it");
            }
            this->at += 2;
            i32 low = this->parseHex4();
            if (low < 0xDC00 || low > 0xDFFF)
            {
              this->at -= 6;
              this->fail("\\u escape of a high surrogate without a low surrogate after it");
            }
            code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00);
          }
          jsonAppendUtf8(out, code);
        }
        else
        {
          --this->at;
          this->fail("an unknown escape in a string");
        }
        continue;
      }
      if (c < 0x80)
      {
        out << char(c);
        ++this->at;
        continue;
      }
      i32 length = jsonUtf8SequenceLength(this->at, this->end);
      if (length == 0)
        this->fail("bytes that are not UTF-8 in a string");
      out << StringView(this->at, length);
      this->at += length;
    }
  }

  void parseNumber(JsonValue& out)
  {
    const char* first = this->at;
    bool negative = false;
    if (*this->at == '-')
    {
      negative = true;
      ++this->at;
    }
    if (this->at == this->end || *this->at < '0' || *this->at > '9')
      this->fail("expected a digit in a number");
    if (*this->at == '0')
    {
      ++this->at;
      if (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        this->fail("a number with a leading zero");
    }
    else
      while (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        ++this->at;
    bool integral = true;
    if (this->at < this->end && *this->at == '.')
    {
      integral = false;
      ++this->at;
      if (this->at == this->end || *this->at < '0' || *this->at > '9')
        this->fail("expected a digit after a number's '.'");
      while (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        ++this->at;
    }
    if (this->at < this->end && (*this->at == 'e' || *this->at == 'E'))
    {
      integral = false;
      ++this->at;
      if (this->at < this->end && (*this->at == '+' || *this->at == '-'))
        ++this->at;
      if (this->at == this->end || *this->at < '0' || *this->at > '9')
        this->fail("expected a digit in a number's exponent");
      while (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        ++this->at;
    }
    // An integer that fits in long long stays exact; "-0" is the number -0.0, which an integer
    // cannot hold.
    if (integral)
    {
      u64 magnitude = 0;
      bool fits = true;
      for (const char* d = first + (negative ? 1 : 0); d < this->at; ++d)
      {
        u64 digit = (u64)(*d - '0');
        if (magnitude > (18446744073709551615ull - digit) / 10)
        {
          fits = false;
          break;
        }
        magnitude = magnitude * 10 + digit;
      }
      if (fits && !(negative && magnitude == 0) && magnitude <= (negative ? 9223372036854775808ull : 9223372036854775807ull))
      {
        out.type = JsonType::integer;
        out.integerValue = negative ? (i64)(0ull - magnitude) : (i64)magnitude;
        return;
      }
    }
    String digits(first, this->at);
    double value = strtod(digits.c_str(), nullptr);
    if (!isfinite(value))
    {
      this->at = first;
      this->fail("a number too large for a double");
    }
    out.type = JsonType::number;
    out.numberValue = value;
  }

  const char* start;
  const char* at;
  const char* end;
  i32 depth = 0;
};
