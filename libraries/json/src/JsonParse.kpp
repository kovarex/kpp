// Parsing JSON text (RFC 8259) strictly: anything the RFC's grammar does not allow is a
// JsonParseError with its line and column, never a guess. libraries/json/README.md lists the
// choices where the RFC leaves one.

// The value the whole text holds: one value with only whitespace around it.
JsonValue parseJson(StringView text)
{
  JsonParser parser(text);
  return parser.parseDocument();
}

// As parseJson, but false instead of a throw; error (when given) gets the error.
bool tryParseJson(StringView text, JsonValue& out, JsonParseError* error = nullptr)
{
  try
  {
    out = parseJson(text);
    return true;
  }
  catch (const JsonParseError& e)
  {
    if (error)
      *error = e;
    return false;
  }
}

// Nesting deeper than this is an error rather than a stack overflow.
constexpr i32 jsonMaxDepth = 1000;

// The length of the UTF-8 sequence at text (2 to 4), or 0 when it is not one: a stray
// continuation byte, an overlong form, a surrogate, past U+10FFFF, or cut short.
i32 jsonUtf8SequenceLength(const char* text, const char* end)
{
  u8 c = (u8)text[0];
  i32 length = 0;
  i32 minimum = 0;
  i32 code = 0;
  if (c >= 0xC2 && c <= 0xDF)
  {
    length = 2;
    code = c & 0x1F;
    minimum = 0x80;
  }
  else if (c >= 0xE0 && c <= 0xEF)
  {
    length = 3;
    code = c & 0x0F;
    minimum = 0x800;
  }
  else if (c >= 0xF0 && c <= 0xF4)
  {
    length = 4;
    code = c & 0x07;
    minimum = 0x10000;
  }
  else
    return 0;
  if (end - text < length)
    return 0;
  for (i32 i = 1; i < length; ++i)
  {
    u8 next = (u8)text[i];
    if ((next & 0xC0) != 0x80)
      return 0;
    code = (code << 6) | (next & 0x3F);
  }
  if (code < minimum || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF))
    return 0;
  return length;
}

// Whether the bytes are UTF-8.
bool jsonIsUtf8(StringView text)
{
  const char* at = text.data();
  const char* end = at + text.size();
  while (at < end)
  {
    if ((u8)*at < 0x80)
    {
      ++at;
      continue;
    }
    i32 length = jsonUtf8SequenceLength(at, end);
    if (length == 0)
      return false;
    at += length;
  }
  return true;
}

// Appends the code point (at most U+10FFFF, not a surrogate) as UTF-8.
void jsonAppendUtf8(String& out, i32 code)
{
  if (code < 0x80)
    out << char(code);
  else if (code < 0x800)
  {
    out << char(0xC0 | (code >> 6));
    out << char(0x80 | (code & 0x3F));
  }
  else if (code < 0x10000)
  {
    out << char(0xE0 | (code >> 12));
    out << char(0x80 | ((code >> 6) & 0x3F));
    out << char(0x80 | (code & 0x3F));
  }
  else
  {
    out << char(0xF0 | (code >> 18));
    out << char(0x80 | ((code >> 12) & 0x3F));
    out << char(0x80 | ((code >> 6) & 0x3F));
    out << char(0x80 | (code & 0x3F));
  }
}
