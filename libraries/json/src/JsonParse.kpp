// Parsing JSON text (RFC 8259) strictly: anything the RFC's grammar does not allow is a
// JsonParseError with its line and column, never a guess. libraries/json/README.md lists the
// choices where the RFC leaves one.

// Text that is not JSON. The message starts with "line:column: ".
class JsonParseError : public RuntimeError
{
public:
  int line = 0;   // 1-based
  int column = 0; // 1-based, in bytes
  JsonParseError() {}
  JsonParseError(const String& message, int line, int column) : RuntimeError(message), line(line), column(column) {}
};

// The value the whole text holds: one value with only whitespace around it.
JsonValue parseJson(StringView text)
{
  JsonParser parser(text);
  return parser.parseDocument();
}

// As parseJson, but false instead of a throw; error (when given) gets the error.
bool tryParseJson(StringView text, JsonValue& out, JsonParseError* error = nullptr)
{
  try
  {
    out = parseJson(text);
    return true;
  }
  catch (const JsonParseError& e)
  {
    if (error)
      *error = e;
    return false;
  }
}

// Nesting deeper than this is an error rather than a stack overflow.
constexpr int jsonMaxDepth = 1000;

struct JsonParser
{
  const char* start;
  const char* at;
  const char* end;
  int depth = 0;

  JsonParser(StringView text) : start(text.data()), at(text.data()), end(text.data() + text.size()) {}

  JsonValue parseDocument()
  {
    if (this->end - this->at >= 3 && (unsigned char)this->at[0] == 0xEF && (unsigned char)this->at[1] == 0xBB && (unsigned char)this->at[2] == 0xBF)
      this->fail("a byte order mark before the JSON text (RFC 8259 8.1: not allowed)");
    this->skipWhitespace();
    JsonValue value;
    this->parseValue(value);
    this->skipWhitespace();
    if (this->at != this->end)
      this->fail("text after the JSON value");
    return value;
  }

  void fail(StringView what)
  {
    int line = 1;
    const char* lineStart = this->start;
    for (const char* c = this->start; c < this->at; ++c)
      if (*c == '\n')
      {
        ++line;
        lineStart = c + 1;
      }
    int column = int(this->at - lineStart) + 1;
    throw JsonParseError(format("{}:{}: {}", line, column, String(what)), line, column);
  }

  void skipWhitespace()
  {
    while (this->at < this->end && (*this->at == ' ' || *this->at == '\t' || *this->at == '\n' || *this->at == '\r'))
      ++this->at;
  }

  bool literal(const char* word)
  {
    const char* c = this->at;
    for (const char* w = word; *w; ++w, ++c)
      if (c == this->end || *c != *w)
        return false;
    this->at = c;
    return true;
  }

  void parseValue(JsonValue& out)
  {
    if (this->at == this->end)
      this->fail("expected a value, found the end of the text");
    char c = *this->at;
    if (c == '{')
      this->parseObject(out);
    else if (c == '[')
      this->parseArray(out);
    else if (c == '"')
    {
      out.type = JsonType::string;
      this->parseString(out.stringValue);
    }
    else if (c == '-' || (c >= '0' && c <= '9'))
      this->parseNumber(out);
    else if (this->literal("true"))
      out = JsonValue(true);
    else if (this->literal("false"))
      out = JsonValue(false);
    else if (this->literal("null"))
      out = JsonValue();
    else
      this->fail("expected a value");
  }

  void enter()
  {
    if (++this->depth > jsonMaxDepth)
      this->fail(format("nesting deeper than {} levels", jsonMaxDepth));
  }

  void parseArray(JsonValue& out)
  {
    this->enter();
    out = JsonValue::array();
    ++this->at; // [
    this->skipWhitespace();
    if (this->at < this->end && *this->at == ']')
    {
      ++this->at;
      --this->depth;
      return;
    }
    while (true)
    {
      this->skipWhitespace();
      out.items.push_back(JsonValue());
      this->parseValue(out.items.back());
      this->skipWhitespace();
      if (this->at == this->end)
        this->fail("expected ',' or ']' in an array, found the end of the text");
      if (*this->at == ']')
        break;
      if (*this->at != ',')
        this->fail("expected ',' or ']' in an array");
      ++this->at;
    }
    ++this->at;
    --this->depth;
  }

  void parseObject(JsonValue& out)
  {
    this->enter();
    out = JsonValue::object();
    ++this->at; // {
    this->skipWhitespace();
    if (this->at < this->end && *this->at == '}')
    {
      ++this->at;
      --this->depth;
      return;
    }
    while (true)
    {
      this->skipWhitespace();
      if (this->at == this->end || *this->at != '"')
        this->fail("expected a string as an object's key");
      String key;
      this->parseString(key);
      this->skipWhitespace();
      if (this->at == this->end || *this->at != ':')
        this->fail("expected ':' after an object's key");
      ++this->at;
      this->skipWhitespace();
      JsonValue value;
      this->parseValue(value);
      // A repeated key: the last value wins, in the first one's place (README.md).
      out.set(key, value);
      this->skipWhitespace();
      if (this->at == this->end)
        this->fail("expected ',' or '}' in an object, found the end of the text");
      if (*this->at == '}')
        break;
      if (*this->at != ',')
        this->fail("expected ',' or '}' in an object");
      ++this->at;
    }
    ++this->at;
    --this->depth;
  }

  int hexDigit(char c)
  {
    if (c >= '0' && c <= '9')
      return c - '0';
    if (c >= 'a' && c <= 'f')
      return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
      return c - 'A' + 10;
    return -1;
  }

  // The four hex digits after "\u".
  int parseHex4()
  {
    if (this->end - this->at < 4)
      this->fail("expected four hex digits after \\u");
    int code = 0;
    for (int i = 0; i < 4; ++i)
    {
      int digit = this->hexDigit(this->at[i]);
      if (digit < 0)
      {
        this->at += i;
        this->fail("expected four hex digits after \\u");
      }
      code = code * 16 + digit;
    }
    this->at += 4;
    return code;
  }

  void parseString(String& out)
  {
    ++this->at; // "
    while (true)
    {
      if (this->at == this->end)
        this->fail("a string without its closing '\"'");
      unsigned char c = (unsigned char)*this->at;
      if (c == '"')
      {
        ++this->at;
        return;
      }
      if (c < 0x20)
        this->fail("a control character in a string (it must be escaped)");
      if (c == '\\')
      {
        ++this->at;
        if (this->at == this->end)
          this->fail("a string without its closing '\"'");
        char e = *this->at;
        ++this->at;
        if (e == '"' || e == '\\' || e == '/')
          out.append(e);
        else if (e == 'b')
          out.append('\b');
        else if (e == 'f')
          out.append('\f');
        else if (e == 'n')
          out.append('\n');
        else if (e == 'r')
          out.append('\r');
        else if (e == 't')
          out.append('\t');
        else if (e == 'u')
        {
          int code = this->parseHex4();
          if (code >= 0xDC00 && code <= 0xDFFF)
          {
            this->at -= 6;
            this->fail("\\u escape of a low surrogate without a high surrogate before it");
          }
          if (code >= 0xD800 && code <= 0xDBFF)
          {
            if (this->end - this->at < 2 || this->at[0] != '\\' || this->at[1] != 'u')
            {
              this->at -= 6;
              this->fail("\\u escape of a high surrogate without a low surrogate after it");
            }
            this->at += 2;
            int low = this->parseHex4();
            if (low < 0xDC00 || low > 0xDFFF)
            {
              this->at -= 6;
              this->fail("\\u escape of a high surrogate without a low surrogate after it");
            }
            code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00);
          }
          jsonAppendUtf8(out, code);
        }
        else
        {
          --this->at;
          this->fail("an unknown escape in a string");
        }
        continue;
      }
      if (c < 0x80)
      {
        out.append(char(c));
        ++this->at;
        continue;
      }
      int length = jsonUtf8SequenceLength(this->at, this->end);
      if (length == 0)
        this->fail("bytes that are not UTF-8 in a string");
      out.append(this->at, length);
      this->at += length;
    }
  }

  void parseNumber(JsonValue& out)
  {
    const char* first = this->at;
    bool negative = false;
    if (*this->at == '-')
    {
      negative = true;
      ++this->at;
    }
    if (this->at == this->end || *this->at < '0' || *this->at > '9')
      this->fail("expected a digit in a number");
    if (*this->at == '0')
    {
      ++this->at;
      if (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        this->fail("a number with a leading zero");
    }
    else
      while (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        ++this->at;
    bool integral = true;
    if (this->at < this->end && *this->at == '.')
    {
      integral = false;
      ++this->at;
      if (this->at == this->end || *this->at < '0' || *this->at > '9')
        this->fail("expected a digit after a number's '.'");
      while (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        ++this->at;
    }
    if (this->at < this->end && (*this->at == 'e' || *this->at == 'E'))
    {
      integral = false;
      ++this->at;
      if (this->at < this->end && (*this->at == '+' || *this->at == '-'))
        ++this->at;
      if (this->at == this->end || *this->at < '0' || *this->at > '9')
        this->fail("expected a digit in a number's exponent");
      while (this->at < this->end && *this->at >= '0' && *this->at <= '9')
        ++this->at;
    }
    // An integer that fits in long long stays exact; "-0" is the number -0.0, which an integer
    // cannot hold.
    if (integral)
    {
      unsigned long long magnitude = 0;
      bool fits = true;
      for (const char* d = first + (negative ? 1 : 0); d < this->at; ++d)
      {
        unsigned long long digit = (unsigned long long)(*d - '0');
        if (magnitude > (18446744073709551615ull - digit) / 10)
        {
          fits = false;
          break;
        }
        magnitude = magnitude * 10 + digit;
      }
      if (fits && !(negative && magnitude == 0) && magnitude <= (negative ? 9223372036854775808ull : 9223372036854775807ull))
      {
        out.type = JsonType::integer;
        out.integerValue = negative ? (long long)(0ull - magnitude) : (long long)magnitude;
        return;
      }
    }
    String digits(first, this->at);
    double value = strtod(digits.c_str(), nullptr);
    if (!isfinite(value))
    {
      this->at = first;
      this->fail("a number too large for a double");
    }
    out.type = JsonType::number;
    out.numberValue = value;
  }
};

// The length of the UTF-8 sequence at text (2 to 4), or 0 when it is not one: a stray
// continuation byte, an overlong form, a surrogate, past U+10FFFF, or cut short.
int jsonUtf8SequenceLength(const char* text, const char* end)
{
  unsigned char c = (unsigned char)text[0];
  int length = 0;
  int minimum = 0;
  int code = 0;
  if (c >= 0xC2 && c <= 0xDF)
  {
    length = 2;
    code = c & 0x1F;
    minimum = 0x80;
  }
  else if (c >= 0xE0 && c <= 0xEF)
  {
    length = 3;
    code = c & 0x0F;
    minimum = 0x800;
  }
  else if (c >= 0xF0 && c <= 0xF4)
  {
    length = 4;
    code = c & 0x07;
    minimum = 0x10000;
  }
  else
    return 0;
  if (end - text < length)
    return 0;
  for (int i = 1; i < length; ++i)
  {
    unsigned char next = (unsigned char)text[i];
    if ((next & 0xC0) != 0x80)
      return 0;
    code = (code << 6) | (next & 0x3F);
  }
  if (code < minimum || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF))
    return 0;
  return length;
}

// Whether the bytes are UTF-8.
bool jsonIsUtf8(StringView text)
{
  const char* at = text.data();
  const char* end = at + text.size();
  while (at < end)
  {
    if ((unsigned char)*at < 0x80)
    {
      ++at;
      continue;
    }
    int length = jsonUtf8SequenceLength(at, end);
    if (length == 0)
      return false;
    at += length;
  }
  return true;
}

// Appends the code point (at most U+10FFFF, not a surrogate) as UTF-8.
void jsonAppendUtf8(String& out, int code)
{
  if (code < 0x80)
    out.append(char(code));
  else if (code < 0x800)
  {
    out.append(char(0xC0 | (code >> 6)));
    out.append(char(0x80 | (code & 0x3F)));
  }
  else if (code < 0x10000)
  {
    out.append(char(0xE0 | (code >> 12)));
    out.append(char(0x80 | ((code >> 6) & 0x3F)));
    out.append(char(0x80 | (code & 0x3F)));
  }
  else
  {
    out.append(char(0xF0 | (code >> 18)));
    out.append(char(0x80 | ((code >> 12) & 0x3F)));
    out.append(char(0x80 | ((code >> 6) & 0x3F)));
    out.append(char(0x80 | (code & 0x3F)));
  }
}
