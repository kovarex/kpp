// TCP connections and listeners over the platform's sockets (NetWindows.kpp, NetPosix.kpp).

// A socket call that failed: the message names the call, the host or port, and the system's error.
class NetError : public RuntimeError
{
public:
  NetError() {}
  NetError(const String& message) : RuntimeError(message) {}
};

// A port as sockaddr holds it: 2 bytes, big-endian.
i32 netPortOf(const void* port)
{
  const u8* bytes = (const u8*)port;
  return (bytes[0] << 8) | bytes[1];
}

// A TCP connection. It closes when destroyed; it moves but does not copy.
struct TcpStream
{
  i64 handle = -1;

  TcpStream() {}
  explicit TcpStream(i64 handle) : handle(handle) {}
  TcpStream(const TcpStream&) = delete;
  TcpStream& operator=(const TcpStream&) = delete;
  TcpStream(TcpStream&& other) : handle(other.handle) { other.handle = -1; }
  TcpStream& operator=(TcpStream&& other)
  {
    if (this != &other)
    {
      this->close();
      this->handle = other.handle;
      other.handle = -1;
    }
    return *this;
  }
  ~TcpStream() { this->close(); }

  // Connects to host (a name or an address) at port, trying each address the name has.
  static TcpStream connect(StringView host, i32 port) { return TcpStream(netConnect(host, port)); }

  bool isOpen() const { return this->handle != -1; }

  // Sends all the bytes, or throws.
  void write(StringView data)
  {
    this->checkOpen();
    i64 sent = 0;
    while (sent < (i64)data.size())
      sent += netSend(this->handle, data.data() + sent, (i64)data.size() - sent);
  }

  // Reads what has arrived, up to capacity bytes, waiting for at least one; 0 when the other side
  // has closed the connection.
  i64 read(char* buffer, i64 capacity)
  {
    this->checkOpen();
    return netReceive(this->handle, buffer, capacity);
  }

  // Reads exactly n bytes; the connection closing first throws.
  String readExactly(i64 n)
  {
    String out;
    char buffer[4096];
    while ((i64)out.size() < n)
    {
      i64 want = n - (i64)out.size();
      i64 got = this->read(buffer, want < 4096 ? want : 4096);
      if (got == 0)
        throw NetError(format("the connection closed after {} of {} bytes", (i64)out.size(), n));
      out.append(StringView(buffer, (ContainerSize)got));
    }
    return out;
  }

  // Reads until the other side closes the connection.
  String readAll()
  {
    String out;
    char buffer[4096];
    for (;;)
    {
      i64 got = this->read(buffer, 4096);
      if (got == 0)
        return out;
      out.append(StringView(buffer, (ContainerSize)got));
    }
  }

  // A read or a write that waits longer than this throws NetError; 0 waits forever (the default).
  void setTimeout(i32 milliseconds)
  {
    this->checkOpen();
    netSetTimeout(this->handle, milliseconds);
  }

  // Tells the other side nothing more will be written; reading goes on.
  void shutdownWrite()
  {
    this->checkOpen();
    netShutdownWrite(this->handle);
  }

  void close()
  {
    if (this->handle != -1)
      netClose(this->handle);
    this->handle = -1;
  }

  void checkOpen() const
  {
    if (this->handle == -1)
      throw NetError("the TcpStream is closed");
  }
};

// A listening TCP socket. It closes when destroyed; it moves but does not copy.
struct TcpListener
{
  i64 handle = -1;

  TcpListener() {}
  explicit TcpListener(i64 handle) : handle(handle) {}
  TcpListener(const TcpListener&) = delete;
  TcpListener& operator=(const TcpListener&) = delete;
  TcpListener(TcpListener&& other) : handle(other.handle) { other.handle = -1; }
  TcpListener& operator=(TcpListener&& other)
  {
    if (this != &other)
    {
      this->close();
      this->handle = other.handle;
      other.handle = -1;
    }
    return *this;
  }
  ~TcpListener() { this->close(); }

  void close()
  {
    if (this->handle != -1)
      netClose(this->handle);
    this->handle = -1;
  }

  // Listens on address ("127.0.0.1", "0.0.0.0", "::1"...) at port; port 0 picks a free one
  // (port() says which).
  static TcpListener listen(StringView address, i32 port) { return TcpListener(netListen(address, port)); }

  i32 port() const { return netLocalPort(this->handle); }

  // Waits for the next connection.
  TcpStream accept() { return TcpStream(netAccept(this->handle)); }
};
