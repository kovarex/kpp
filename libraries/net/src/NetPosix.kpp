requires config::platform == Platform::FreeBSD || config::platform == Platform::Linux;
// The sockets of FreeBSD and Linux: BSD sockets in the C library.
extern "C" import "sys/types.h";
extern "C" import "sys/socket.h";
extern "C" import "sys/time.h";
extern "C" import "netinet/in.h";
extern "C" import "netdb.h";
extern "C" import "unistd.h";
extern "C" import "string.h";
extern "C" import "errno.h";

// errno, a macro of a function the C library names its own way.
extern "C" i32* __error();
extern "C" i32* __errno_location();
i32 netErrno()
{
  if constexpr (config::platform == Platform::FreeBSD)
    return *__error();
  else
    return *__errno_location();
}

[[noreturn]] void netFail(StringView what)
{
  i32 code = netErrno();
  if (code == EAGAIN || code == EWOULDBLOCK)
    throw NetError(toString(what, ": timed out"));
  throw NetError(toString(what, ": ", StringView(strerror(code)), " (errno ", code, ")"));
}

addrinfo* netResolve(StringView host, i32 port, bool passive)
{
  addrinfo hints;
  memset(&hints, 0, sizeof(hints));
  hints.ai_family = AF_UNSPEC;
  hints.ai_socktype = SOCK_STREAM;
  hints.ai_protocol = IPPROTO_TCP;
  if (passive)
    hints.ai_flags = AI_PASSIVE | AI_NUMERICHOST;
  String name(host);
  String service = toString(port);
  addrinfo* found = nullptr;
  i32 result = getaddrinfo(name.c_str(), service.c_str(), &hints, &found);
  if (result != 0)
    throw NetError(toString("cannot resolve ", host, ": ", StringView(gai_strerror(result))));
  return found;
}

i64 netConnect(StringView host, i32 port)
{
  addrinfo* found = netResolve(host, port, false);
  i32 code = 0;
  for (addrinfo* a = found; a != nullptr; a = a->ai_next)
  {
    i32 s = socket(a->ai_family, a->ai_socktype, a->ai_protocol);
    if (s < 0)
    {
      code = netErrno();
      continue;
    }
    if (connect(s, a->ai_addr, a->ai_addrlen) == 0)
    {
      freeaddrinfo(found);
      return s;
    }
    code = netErrno();
    close(s);
  }
  freeaddrinfo(found);
  throw NetError(toString("cannot connect to ", host, " port ", port, ": ", StringView(strerror(code)), " (errno ", code, ")"));
}

i64 netListen(StringView address, i32 port)
{
  addrinfo* found = netResolve(address, port, true);
  i32 s = socket(found->ai_family, found->ai_socktype, found->ai_protocol);
  if (s < 0)
  {
    freeaddrinfo(found);
    netFail("socket");
  }
  // A restarted server can take its port back at once.
  i32 reuse = 1;
  setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
  if (bind(s, found->ai_addr, found->ai_addrlen) != 0 || listen(s, SOMAXCONN) != 0)
  {
    i32 code = netErrno();
    freeaddrinfo(found);
    close(s);
    throw NetError(toString("cannot listen on ", address, " port ", port, ": ", StringView(strerror(code)), " (errno ", code, ")"));
  }
  freeaddrinfo(found);
  return s;
}

i32 netLocalPort(i64 handle)
{
  sockaddr_storage address;
  socklen_t length = sizeof(address);
  if (getsockname((i32)handle, (sockaddr*)&address, &length) != 0)
    netFail("getsockname");
  if (address.ss_family == AF_INET6)
    return netPortOf(&((sockaddr_in6*)&address)->sin6_port);
  return netPortOf(&((sockaddr_in*)&address)->sin_port);
}

i64 netAccept(i64 handle)
{
  i32 s = accept((i32)handle, nullptr, nullptr);
  if (s < 0)
    netFail("accept");
  return s;
}

i64 netSend(i64 handle, const char* data, i64 length)
{
  // MSG_NOSIGNAL: a closed connection is an error here, not a SIGPIPE that ends the program.
  i64 sent = send((i32)handle, data, (usize)length, MSG_NOSIGNAL);
  if (sent < 0)
    netFail("send");
  return sent;
}

i64 netReceive(i64 handle, char* buffer, i64 capacity)
{
  i64 got = recv((i32)handle, buffer, (usize)capacity, 0);
  if (got < 0)
    netFail("recv");
  return got;
}

void netSetTimeout(i64 handle, i32 milliseconds)
{
  timeval value;
  value.tv_sec = milliseconds / 1000;
  value.tv_usec = (milliseconds % 1000) * 1000;
  if (setsockopt((i32)handle, SOL_SOCKET, SO_RCVTIMEO, &value, sizeof(value)) != 0 ||
      setsockopt((i32)handle, SOL_SOCKET, SO_SNDTIMEO, &value, sizeof(value)) != 0)
    netFail("setsockopt");
}

void netShutdownWrite(i64 handle)
{
  if (shutdown((i32)handle, SHUT_WR) != 0)
    netFail("shutdown");
}

void netClose(i64 handle) { close((i32)handle); }
