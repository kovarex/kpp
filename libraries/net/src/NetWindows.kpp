requires config::platform == Platform::Windows;
// The sockets of Windows: Winsock 2 (ws2_32, which every program links).
extern "C" import "winsock2.h";
extern "C" import "ws2tcpip.h";

// winsock2.h's INVALID_SOCKET, a cast the C import does not take as a constant.
const SOCKET netInvalidSocket = (SOCKET)~0ull;

void netStartup()
{
  // WSAStartup counts its calls, so a second one (another thread's) is harmless.
  static bool started = false;
  if (started)
    return;
  WSADATA data;
  i32 result = WSAStartup(0x0202, &data);
  if (result != 0)
    throw NetError(std::toString("WSAStartup failed: ", netSystemMessage(result)));
  started = true;
}

std::String netSystemMessage(i32 code)
{
  char buffer[512];
  DWORD length = FormatMessageA(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, nullptr, (DWORD)code, 0,
                                buffer, 512, nullptr);
  while (length > 0 && (buffer[length - 1] == '\n' || buffer[length - 1] == '\r' || buffer[length - 1] == ' ' || buffer[length - 1] == '.'))
    --length;
  if (length == 0)
    return std::toString("error ", code);
  return std::toString(std::StringView(buffer, (std::ContainerSize)length), " (error ", code, ")");
}

[[noreturn]] void netFail(std::StringView what)
{
  i32 code = WSAGetLastError();
  if (code == WSAETIMEDOUT)
    throw NetError(std::toString(what, ": timed out"));
  throw NetError(std::toString(what, ": ", netSystemMessage(code)));
}

// The addresses of host at port, for a stream socket; passive for a listener.
addrinfo* netResolve(std::StringView host, i32 port, bool passive)
{
  netStartup();
  addrinfo hints;
  memset(&hints, 0, sizeof(hints));
  hints.ai_family = AF_UNSPEC;
  hints.ai_socktype = SOCK_STREAM;
  hints.ai_protocol = IPPROTO_TCP;
  if (passive)
    hints.ai_flags = AI_PASSIVE | AI_NUMERICHOST;
  std::String name(host);
  std::String service = std::toString(port);
  addrinfo* found = nullptr;
  i32 result = getaddrinfo(name.c_str(), service.c_str(), &hints, &found);
  if (result != 0)
    throw NetError(std::toString("cannot resolve ", host, ": ", netSystemMessage(result)));
  return found;
}

i64 netConnect(std::StringView host, i32 port)
{
  addrinfo* found = netResolve(host, port, false);
  i32 code = 0;
  for (addrinfo* a = found; a != nullptr; a = a->ai_next)
  {
    SOCKET s = socket(a->ai_family, a->ai_socktype, a->ai_protocol);
    if (s == netInvalidSocket)
    {
      code = WSAGetLastError();
      continue;
    }
    if (connect(s, a->ai_addr, (i32)a->ai_addrlen) == 0)
    {
      freeaddrinfo(found);
      return (i64)s;
    }
    code = WSAGetLastError();
    closesocket(s);
  }
  freeaddrinfo(found);
  throw NetError(std::toString("cannot connect to ", host, " port ", port, ": ", netSystemMessage(code)));
}

i64 netListen(std::StringView address, i32 port)
{
  addrinfo* found = netResolve(address, port, true);
  SOCKET s = socket(found->ai_family, found->ai_socktype, found->ai_protocol);
  if (s == netInvalidSocket)
  {
    freeaddrinfo(found);
    netFail("socket");
  }
  // Only this program may bind the port (Windows lets another socket steal it otherwise).
  i32 exclusive = 1;
  setsockopt(s, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, (const char*)&exclusive, sizeof(exclusive));
  if (bind(s, found->ai_addr, (i32)found->ai_addrlen) != 0 || listen(s, SOMAXCONN) != 0)
  {
    i32 code = WSAGetLastError();
    freeaddrinfo(found);
    closesocket(s);
    throw NetError(std::toString("cannot listen on ", address, " port ", port, ": ", netSystemMessage(code)));
  }
  freeaddrinfo(found);
  return (i64)s;
}

i32 netLocalPort(i64 handle)
{
  sockaddr_storage address;
  i32 length = sizeof(address);
  if (getsockname((SOCKET)handle, (sockaddr*)&address, &length) != 0)
    netFail("getsockname");
  if (address.ss_family == AF_INET6)
    return netPortOf(&((sockaddr_in6*)&address)->sin6_port);
  return netPortOf(&((sockaddr_in*)&address)->sin_port);
}

i64 netAccept(i64 handle)
{
  SOCKET s = accept((SOCKET)handle, nullptr, nullptr);
  if (s == netInvalidSocket)
    netFail("accept");
  return (i64)s;
}

i64 netSend(i64 handle, const char* data, i64 length)
{
  i32 chunk = length > 1 << 30 ? 1 << 30 : (i32)length;
  i32 sent = send((SOCKET)handle, data, chunk, 0);
  if (sent < 0)
    netFail("send");
  return sent;
}

i64 netReceive(i64 handle, char* buffer, i64 capacity)
{
  i32 chunk = capacity > 1 << 30 ? 1 << 30 : (i32)capacity;
  i32 got = recv((SOCKET)handle, buffer, chunk, 0);
  if (got < 0)
    netFail("recv");
  return got;
}

void netSetTimeout(i64 handle, i32 milliseconds)
{
  DWORD value = (DWORD)milliseconds;
  if (setsockopt((SOCKET)handle, SOL_SOCKET, SO_RCVTIMEO, (const char*)&value, sizeof(value)) != 0 ||
      setsockopt((SOCKET)handle, SOL_SOCKET, SO_SNDTIMEO, (const char*)&value, sizeof(value)) != 0)
    netFail("setsockopt");
}

void netShutdownWrite(i64 handle)
{
  if (shutdown((SOCKET)handle, SD_SEND) != 0)
    netFail("shutdown");
}

void netClose(i64 handle) { closesocket((SOCKET)handle); }
