requires config::platform == Platform::Windows;
// The sockets of Windows: Winsock 2 (ws2_32, which every program links).
extern "C" import "winsock2.h";
extern "C" import "ws2tcpip.h";

// winsock2.h's INVALID_SOCKET, a cast the C import does not take as a constant.
const SOCKET netInvalidSocket = (SOCKET)~0ull;

void netStartup()
{
  // WSAStartup counts its calls, so a second one (another thread's) is harmless.
  static bool started = false;
  if (started)
    return;
  WSADATA data;
  int result = WSAStartup(0x0202, &data);
  if (result != 0)
    throw NetError(format("WSAStartup failed: {}", netSystemMessage(result)));
  started = true;
}

String netSystemMessage(int code)
{
  char buffer[512];
  DWORD length = FormatMessageA(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, nullptr, (DWORD)code, 0,
                                buffer, 512, nullptr);
  while (length > 0 && (buffer[length - 1] == '\n' || buffer[length - 1] == '\r' || buffer[length - 1] == ' ' || buffer[length - 1] == '.'))
    --length;
  if (length == 0)
    return format("error {}", code);
  return format("{} (error {})", StringView(buffer, (ContainerSize)length), code);
}

[[noreturn]] void netFail(StringView what)
{
  int code = WSAGetLastError();
  if (code == WSAETIMEDOUT)
    throw NetError(format("{}: timed out", what));
  throw NetError(format("{}: {}", what, netSystemMessage(code)));
}

// The addresses of host at port, for a stream socket; passive for a listener.
addrinfo* netResolve(StringView host, int port, bool passive)
{
  netStartup();
  addrinfo hints;
  memset(&hints, 0, sizeof(hints));
  hints.ai_family = AF_UNSPEC;
  hints.ai_socktype = SOCK_STREAM;
  hints.ai_protocol = IPPROTO_TCP;
  if (passive)
    hints.ai_flags = AI_PASSIVE | AI_NUMERICHOST;
  String name(host);
  String service = format("{}", port);
  addrinfo* found = nullptr;
  int result = getaddrinfo(name.c_str(), service.c_str(), &hints, &found);
  if (result != 0)
    throw NetError(format("cannot resolve {}: {}", host, netSystemMessage(result)));
  return found;
}

int64_t netConnect(StringView host, int port)
{
  addrinfo* found = netResolve(host, port, false);
  int code = 0;
  for (addrinfo* a = found; a != nullptr; a = a->ai_next)
  {
    SOCKET s = socket(a->ai_family, a->ai_socktype, a->ai_protocol);
    if (s == netInvalidSocket)
    {
      code = WSAGetLastError();
      continue;
    }
    if (connect(s, a->ai_addr, (int)a->ai_addrlen) == 0)
    {
      freeaddrinfo(found);
      return (int64_t)s;
    }
    code = WSAGetLastError();
    closesocket(s);
  }
  freeaddrinfo(found);
  throw NetError(format("cannot connect to {} port {}: {}", host, port, netSystemMessage(code)));
}

int64_t netListen(StringView address, int port)
{
  addrinfo* found = netResolve(address, port, true);
  SOCKET s = socket(found->ai_family, found->ai_socktype, found->ai_protocol);
  if (s == netInvalidSocket)
  {
    freeaddrinfo(found);
    netFail("socket");
  }
  // Only this program may bind the port (Windows lets another socket steal it otherwise).
  int exclusive = 1;
  setsockopt(s, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, (const char*)&exclusive, sizeof(exclusive));
  if (bind(s, found->ai_addr, (int)found->ai_addrlen) != 0 || listen(s, SOMAXCONN) != 0)
  {
    int code = WSAGetLastError();
    freeaddrinfo(found);
    closesocket(s);
    throw NetError(format("cannot listen on {} port {}: {}", address, port, netSystemMessage(code)));
  }
  freeaddrinfo(found);
  return (int64_t)s;
}

int netLocalPort(int64_t handle)
{
  sockaddr_storage address;
  int length = sizeof(address);
  if (getsockname((SOCKET)handle, (sockaddr*)&address, &length) != 0)
    netFail("getsockname");
  if (address.ss_family == AF_INET6)
    return netPortOf(&((sockaddr_in6*)&address)->sin6_port);
  return netPortOf(&((sockaddr_in*)&address)->sin_port);
}

int64_t netAccept(int64_t handle)
{
  SOCKET s = accept((SOCKET)handle, nullptr, nullptr);
  if (s == netInvalidSocket)
    netFail("accept");
  return (int64_t)s;
}

int64_t netSend(int64_t handle, const char* data, int64_t length)
{
  int chunk = length > 1 << 30 ? 1 << 30 : (int)length;
  int sent = send((SOCKET)handle, data, chunk, 0);
  if (sent < 0)
    netFail("send");
  return sent;
}

int64_t netReceive(int64_t handle, char* buffer, int64_t capacity)
{
  int chunk = capacity > 1 << 30 ? 1 << 30 : (int)capacity;
  int got = recv((SOCKET)handle, buffer, chunk, 0);
  if (got < 0)
    netFail("recv");
  return got;
}

void netSetTimeout(int64_t handle, int milliseconds)
{
  DWORD value = (DWORD)milliseconds;
  if (setsockopt((SOCKET)handle, SOL_SOCKET, SO_RCVTIMEO, (const char*)&value, sizeof(value)) != 0 ||
      setsockopt((SOCKET)handle, SOL_SOCKET, SO_SNDTIMEO, (const char*)&value, sizeof(value)) != 0)
    netFail("setsockopt");
}

void netShutdownWrite(int64_t handle)
{
  if (shutdown((SOCKET)handle, SD_SEND) != 0)
    netFail("shutdown");
}

void netClose(int64_t handle) { closesocket((SOCKET)handle); }
