// net: TCP connections and listeners (README.md). `kpp --test` here runs its tests.
void build(Project& project)
{
  Library& net = project.library("net");
  net.version = "0.1.0";
  net.license = "Apache-2.0 WITH LLVM-exception";
  net.minimumKpp = "0.1.0";
  net.thisReference = true;
  net.root("src");
  net.test("tests");
}
