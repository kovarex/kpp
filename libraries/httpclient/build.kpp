// httpclient: HTTP and HTTPS requests through the system's client (README.md). `kpp --test` here
// runs its tests.
void build(Project& project)
{
  Library& httpclient = project.library("httpclient");
  httpclient.version = "0.1.0";
  httpclient.license = "Apache-2.0 WITH LLVM-exception";
  httpclient.minimumKpp = "0.1.0";
  httpclient.root("src");
  httpclient.test("tests");
  // FreeBSD's client is HTTP/1.1 over net's sockets (its tests answer over the loopback with net too),
  // with TLS through the base system's OpenSSL.
  httpclient.use("net");
  httpclient.systemLibrary("ssl", Platform::FreeBSD);
  httpclient.systemLibrary("crypto", Platform::FreeBSD);
}
