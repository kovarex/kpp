// httpclient against a server on the loopback (a thread answers with canned responses and keeps
// what it was sent); over TLS against two servers of its own when HTTPCLIENT_TEST_TLS is set
// (tests/with-tls-servers.sh runs a command so: CI's way); and against real HTTPS sites when
// HTTPCLIENT_TEST_HTTPS is set (by hand only: sites outside the machine decide that one).

struct HttpClientTestServer
{
  net::TcpListener listener;
  std::Vector<std::String> requests; // each request as received: head and body
  std::Vector<std::String> answers;  // the response to each, in order
  std::String failure;

  void run()
  {
    try
    {
      for (const std::String& answer : this.answers)
      {
        net::TcpStream stream = this.listener.accept();
        stream.setTimeout(5000);
        std::String received;
        char buffer[4096];
        std::ContainerSize headEnd = std::String::npos;
        while (headEnd == std::String::npos)
        {
          i64 got = stream.read(buffer, 4096);
          if (got == 0)
            break;
          received << std::StringView(buffer, (std::ContainerSize)got);
          headEnd = received.find("\r\n\r\n");
        }
        std::ContainerSize length = 0;
        std::ContainerSize at = received.find("Content-Length: ");
        if (at != std::String::npos && at < headEnd)
          length = (std::ContainerSize)std::stoll(received.substr(at + 16, received.find("\r\n", at) - at - 16));
        while (received.size() < headEnd + 4 + length)
        {
          i64 got = stream.read(buffer, 4096);
          if (got == 0)
            break;
          received << std::StringView(buffer, (std::ContainerSize)got);
        }
        this.requests.push_back(received);
        stream.write(answer);
      }
    }
    catch (const std::Exception& e)
    {
      this.failure = std::String(std::StringView(e.what()));
    }
  }
};

void httpClientRunTestServer(HttpClientTestServer* server) { server->run(); }

test getPostHeadersARedirectStatuses
{
  HttpClientTestServer server;
  server.listener = net::TcpListener::listen("127.0.0.1", 0);
  std::String base = std::toString("http://127.0.0.1:", server.listener.port());
  server.answers.push_back("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nX-Test: one two\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello");
  server.answers.push_back("HTTP/1.1 201 Created\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
  server.answers.push_back(std::toString("HTTP/1.1 302 Found\r\nLocation: ", base, "/there\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"));
  server.answers.push_back("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nthere");
  server.answers.push_back("HTTP/1.1 404 Not Found\r\nContent-Length: 4\r\nConnection: close\r\n\r\nnone");
  std::Thread thread(httpClientRunTestServer, &server);

  HttpClientResponse got = fetch(base + "/path%20x?a=1&b=%C3%A9");
  check(got.status == 200 && got.body == "hello");
  check(*got.header("x-test") == "one two" && *got.header("Content-Type") == "text/plain");

  HttpClientResponse posted = postForm(base + "/form", "name=Nov%C3%A1k&x=1");
  check(posted.status == 201 && posted.body == "ok");

  HttpClientResponse redirected = fetch(base + "/here");
  check(redirected.status == 200 && redirected.body == "there");

  HttpClientResponse missing = fetch(base + "/missing");
  check(missing.status == 404 && missing.body == "none");
  thread.join();

  check(server.failure.empty());
  check(server.requests.size() == 5);
  check(server.requests[0].starts_with("GET /path%20x?a=1&b=%C3%A9 HTTP/1.1\r\n"));
  check(server.requests[1].starts_with("POST /form HTTP/1.1\r\n"));
  check(server.requests[1].find("Content-Type: application/x-www-form-urlencoded\r\n") != std::String::npos);
  check(server.requests[1].ends_with("\r\n\r\nname=Nov%C3%A1k&x=1"));
  check(server.requests[2].starts_with("GET /here HTTP/1.1\r\n"));
  check(server.requests[3].starts_with("GET /there HTTP/1.1\r\n"));
}

bool httpClientThrows(std::StringView url, std::StringView expected)
{
  try
  {
    HttpClientRequest request;
    request.url = std::String(url);
    request.timeoutMilliseconds = 2000;
    fetch(request);
  }
  catch (const HttpClientError& e)
  {
    return std::String(std::StringView(e.what())).find(expected) != std::String::npos;
  }
  return false;
}

test errors
{
  i32 port = 0;
  {
    net::TcpListener listener = net::TcpListener::listen("127.0.0.1", 0);
    port = listener.port();
  }
  check(httpClientThrows(std::toString("http://127.0.0.1:", port, "/"), "127.0.0.1"));
  check(httpClientThrows("ftp://example.test/", "not an http or https address"));
  check(httpClientThrows("http://user@example.test/", "user name"));
  check(httpClientThrows("http://example.test:99999/", "port"));
  HttpClientRequest bad;
  bad.url = "http://127.0.0.1/";
  bad.headers.push_back(HttpClientHeader{std::String("X"), std::String("a\r\nInjected: yes")});
  bool threw = false;
  try { fetch(bad); } catch (const HttpClientError& e) { threw = true; }
  check(threw);
  // A server that accepts and never answers: the timeout.
  net::TcpListener silent = net::TcpListener::listen("127.0.0.1", 0);
  check(httpClientThrows(std::toString("http://127.0.0.1:", silent.port(), "/"), "timed out"));
}

test httpsWhenAskedFor
{
  const char* asked = std::getenv("HTTPCLIENT_TEST_HTTPS");
  if (asked == nullptr)
  {
    std::println("skipped: HTTPCLIENT_TEST_HTTPS is not set (tests/HttpClientTests.kpp)");
    return;
  }
  HttpClientResponse egd = fetch("https://www.europeangodatabase.eu/EGD/EGD_2_0/downloads/tlist.html");
  check(egd.status == 200 && egd.body.size() > 1000);
  bool rejected = httpClientThrows("https://expired.badssl.com/", "expired.badssl.com");
  check(rejected);
}

// HTTPCLIENT_TEST_TLS="PORT PORT" (tests/with-tls-servers.sh runs a command with it): two HTTPS
// servers on the loopback, each with a certificate for the name localhost. The process trusts the
// first one's (SSL_CERT_FILE names it); nothing vouches for the second one's. Both answer
// GET /page with a thousand lines.
test tlsWhenAskedFor
{
  const char* asked = std::getenv("HTTPCLIENT_TEST_TLS");
  if (asked == nullptr)
  {
    std::println("skipped: HTTPCLIENT_TEST_TLS is not set (tests/with-tls-servers.sh sets it)");
    return;
  }
  std::StringView ports(asked);
  std::ContainerSize space = ports.find(' ');
  check(space != std::StringView::npos);
  if (space == std::StringView::npos)
    return;
  std::StringView trusted = ports.substr(0, space);
  std::StringView other = ports.substr(space + 1);
  std::String page;
  for (i32 line = 0; line < 1000; ++line)
    page << "kpp httpclient over TLS, one line of a thousand\n";
  HttpClientResponse got = fetch(std::toString("https://localhost:", trusted, "/page"));
  check(got.status == 200 && got.body == page);
  // The same server under a name its certificate does not carry.
  check(httpClientThrows(std::toString("https://127.0.0.1:", trusted, "/page"), "mismatch"));
  // A certificate that nothing vouches for.
  check(httpClientThrows(std::toString("https://localhost:", other, "/page"), "the certificate is not valid"));
}
