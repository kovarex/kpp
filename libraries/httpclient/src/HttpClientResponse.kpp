struct HttpClientResponse
{
  // The first header of that name (any case), or nullptr.
  const std::String* header(std::StringView name) const
  {
    for (const HttpClientHeader& h : this.headers)
      if (httpClientEqualIgnoringCase(h.name, name))
        return &h.value;
    return nullptr;
  }

  i32 status = 0;
  std::Vector<HttpClientHeader> headers; // names as the server sent them
  std::String body;
};
