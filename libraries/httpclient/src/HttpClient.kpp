// HTTP and HTTPS requests: through Windows' client, which brings TLS, certificates and proxies
// (HttpClientWindows.kpp: WinHTTP), and HTTP/1.1 with OpenSSL on FreeBSD (HttpClientPosix.kpp).
// README.md has the API.

bool httpClientEqualIgnoringCase(std::StringView a, std::StringView b)
{
  if (a.size() != b.size())
    return false;
  for (std::ContainerSize i = 0; i < a.size(); ++i)
  {
    char x = a[i] >= 'A' && a[i] <= 'Z' ? char(a[i] - 'A' + 'a') : a[i];
    char y = b[i] >= 'A' && b[i] <= 'Z' ? char(b[i] - 'A' + 'a') : b[i];
    if (x != y)
      return false;
  }
  return true;
}

// The request's response, whatever its status.
HttpClientResponse fetch(const HttpClientRequest& request)
{
  if (!(request.url.starts_with("http://") || request.url.starts_with("https://")))
    throw HttpClientError(std::toString("not an http or https address: ", request.url));
  for (const HttpClientHeader& h : request.headers)
    for (char c : h.name + h.value)
      if (c == '\r' || c == '\n' || c == 0)
        throw HttpClientError(std::toString("the header ", h.name, " has a line break or a zero byte"));
  return httpClientFetch(request);
}

// A GET of url.
HttpClientResponse fetch(std::StringView url)
{
  HttpClientRequest request;
  request.url = std::String(url);
  return fetch(request);
}

// A POST of an urlencoded form (name=value&..., as url::writeUrlQuery writes it).
HttpClientResponse postForm(std::StringView url, std::StringView form)
{
  HttpClientRequest request;
  request.method = "POST";
  request.url = std::String(url);
  request.headers.push_back(HttpClientHeader{std::String("Content-Type"), std::String("application/x-www-form-urlencoded")});
  request.body = std::String(form);
  return fetch(request);
}

// Parses "Name: value" lines (the status line and blank lines skipped).
std::Vector<HttpClientHeader> httpClientParseHeaders(std::StringView text)
{
  std::Vector<HttpClientHeader> headers;
  std::ContainerSize at = 0;
  while (at < text.size())
  {
    std::ContainerSize end = text.find('\n', at);
    if (end == std::StringView::npos)
      end = text.size();
    std::StringView line = text.substr(at, end - at);
    if (!line.empty() && line[line.size() - 1] == '\r')
      line = line.substr(0, line.size() - 1);
    std::ContainerSize colon = line.find(':');
    if (colon != std::StringView::npos && colon > 0 && !line.starts_with("HTTP/"))
    {
      std::StringView value = line.substr(colon + 1);
      while (!value.empty() && (value[0] == ' ' || value[0] == '\t'))
        value = value.substr(1);
      headers.push_back(HttpClientHeader{std::String(line.substr(0, colon)), std::String(value)});
    }
    at = end + 1;
  }
  return headers;
}

HttpClientTarget httpClientTarget(std::StringView url)
{
  HttpClientTarget target;
  target.secure = url.starts_with("https://");
  std::StringView rest = url.substr(target.secure ? 8 : 7);
  std::ContainerSize slash = rest.find('/');
  std::ContainerSize question = rest.find('?');
  std::ContainerSize end = slash < question ? slash : question;
  std::StringView authority = end == std::StringView::npos ? rest : rest.substr(0, end);
  target.path = end == std::StringView::npos ? std::String("/") : std::String(rest.substr(end));
  if (!target.path.starts_with("/"))
    target.path = std::toString("/", target.path);
  if (authority.find('@') != std::StringView::npos)
    throw HttpClientError(std::toString("an address with a user name: ", url));
  std::ContainerSize colon = authority.rfind(':');
  bool bracketed = authority.starts_with("[");
  if (colon != std::StringView::npos && (!bracketed || authority.find(']') < colon))
  {
    std::StringView port = authority.substr(colon + 1);
    i32 value = 0;
    for (char c : port)
    {
      if (c < '0' || c > '9' || value > 65535)
        throw HttpClientError(std::toString("the port of ", url, " is not a number"));
      value = value * 10 + (c - '0');
    }
    if (port.empty() || value == 0 || value > 65535)
      throw HttpClientError(std::toString("the port of ", url, " is not a port"));
    target.port = (u16)value;
    authority = authority.substr(0, colon);
  }
  else
    target.port = target.secure ? 443 : 80;
  if (bracketed)
    authority = authority.substr(1, authority.size() - 2);
  if (authority.empty())
    throw HttpClientError(std::toString("an address without a host: ", url));
  target.host = std::String(authority);
  return target;
}
