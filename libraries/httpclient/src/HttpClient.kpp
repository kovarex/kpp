// HTTP and HTTPS requests: through Windows' client, which brings TLS, certificates and proxies
// (HttpClientWindows.kpp: WinHTTP), and HTTP/1.1 with OpenSSL on FreeBSD (HttpClientPosix.kpp).
// README.md has the API.

bool httpClientEqualIgnoringCase(StringView a, StringView b)
{
  if (a.size() != b.size())
    return false;
  for (ContainerSize i = 0; i < a.size(); ++i)
  {
    char x = a[i] >= 'A' && a[i] <= 'Z' ? char(a[i] - 'A' + 'a') : a[i];
    char y = b[i] >= 'A' && b[i] <= 'Z' ? char(b[i] - 'A' + 'a') : b[i];
    if (x != y)
      return false;
  }
  return true;
}

// The request's response, whatever its status.
HttpClientResponse fetch(const HttpClientRequest& request)
{
  if (!(request.url.starts_with("http://") || request.url.starts_with("https://")))
    throw HttpClientError(format("not an http or https address: {}", request.url));
  for (const HttpClientHeader& h : request.headers)
    for (char c : h.name + h.value)
      if (c == '\r' || c == '\n' || c == 0)
        throw HttpClientError(format("the header {} has a line break or a zero byte", h.name));
  return httpClientFetch(request);
}

// A GET of url.
HttpClientResponse fetch(StringView url)
{
  HttpClientRequest request;
  request.url = String(url);
  return fetch(request);
}

// A POST of an urlencoded form (name=value&..., as url::writeUrlQuery writes it).
HttpClientResponse postForm(StringView url, StringView form)
{
  HttpClientRequest request;
  request.method = "POST";
  request.url = String(url);
  request.headers.push_back(HttpClientHeader{String("Content-Type"), String("application/x-www-form-urlencoded")});
  request.body = String(form);
  return fetch(request);
}

// Parses "Name: value" lines (the status line and blank lines skipped).
Vector<HttpClientHeader> httpClientParseHeaders(StringView text)
{
  Vector<HttpClientHeader> headers;
  ContainerSize at = 0;
  while (at < text.size())
  {
    ContainerSize end = text.find('\n', at);
    if (end == StringView::npos)
      end = text.size();
    StringView line = text.substr(at, end - at);
    if (!line.empty() && line[line.size() - 1] == '\r')
      line = line.substr(0, line.size() - 1);
    ContainerSize colon = line.find(':');
    if (colon != StringView::npos && colon > 0 && !line.starts_with("HTTP/"))
    {
      StringView value = line.substr(colon + 1);
      while (!value.empty() && (value[0] == ' ' || value[0] == '\t'))
        value = value.substr(1);
      headers.push_back(HttpClientHeader{String(line.substr(0, colon)), String(value)});
    }
    at = end + 1;
  }
  return headers;
}

HttpClientTarget httpClientTarget(StringView url)
{
  HttpClientTarget target;
  target.secure = url.starts_with("https://");
  StringView rest = url.substr(target.secure ? 8 : 7);
  ContainerSize slash = rest.find('/');
  ContainerSize question = rest.find('?');
  ContainerSize end = slash < question ? slash : question;
  StringView authority = end == StringView::npos ? rest : rest.substr(0, end);
  target.path = end == StringView::npos ? String("/") : String(rest.substr(end));
  if (!target.path.starts_with("/"))
    target.path = String("/") + target.path;
  if (authority.find('@') != StringView::npos)
    throw HttpClientError(format("an address with a user name: {}", url));
  ContainerSize colon = authority.rfind(':');
  bool bracketed = authority.starts_with("[");
  if (colon != StringView::npos && (!bracketed || authority.find(']') < colon))
  {
    StringView port = authority.substr(colon + 1);
    i32 value = 0;
    for (char c : port)
    {
      if (c < '0' || c > '9' || value > 65535)
        throw HttpClientError(format("the port of {} is not a number", url));
      value = value * 10 + (c - '0');
    }
    if (port.empty() || value == 0 || value > 65535)
      throw HttpClientError(format("the port of {} is not a port", url));
    target.port = (u16)value;
    authority = authority.substr(0, colon);
  }
  else
    target.port = target.secure ? 443 : 80;
  if (bracketed)
    authority = authority.substr(1, authority.size() - 2);
  if (authority.empty())
    throw HttpClientError(format("an address without a host: {}", url));
  target.host = String(authority);
  return target;
}
