requires config::platform == Platform::Windows;
// WinHTTP: Windows' HTTP client, with its TLS, certificate store and proxy settings. Its functions are
// looked up in winhttp.dll when first needed (a kpp library cannot add a link library yet).
extern "C" import "windows.h";

using HttpClientHandle = void*;
using WinHttpOpenFunction = HttpClientHandle (*)(const wchar_t*, u32, const wchar_t*, const wchar_t*, u32);
using WinHttpConnectFunction = HttpClientHandle (*)(HttpClientHandle, const wchar_t*, u16, u32);
using WinHttpOpenRequestFunction = HttpClientHandle (*)(HttpClientHandle, const wchar_t*, const wchar_t*, const wchar_t*,
                                                        const wchar_t*, const wchar_t**, u32);
using WinHttpSetTimeoutsFunction = i32 (*)(HttpClientHandle, i32, i32, i32, i32);
using WinHttpSetOptionFunction = i32 (*)(HttpClientHandle, u32, void*, u32);
using WinHttpSendRequestFunction = i32 (*)(HttpClientHandle, const wchar_t*, u32, void*, u32, u32,
                                           u64);
using WinHttpReceiveResponseFunction = i32 (*)(HttpClientHandle, void*);
using WinHttpQueryHeadersFunction = i32 (*)(HttpClientHandle, u32, const wchar_t*, void*, u32*, u32*);
using WinHttpReadDataFunction = i32 (*)(HttpClientHandle, void*, u32, u32*);
using WinHttpCloseHandleFunction = i32 (*)(HttpClientHandle);

void* httpClientFunction(HMODULE module, const char* name)
{
  void* function = (void*)GetProcAddress(module, name);
  if (function == nullptr)
    throw HttpClientError(std::toString("winhttp.dll has no ", std::StringView(name)));
  return function;
}

const WinHttp& winHttp()
{
  static WinHttp functions;
  if (functions.module != nullptr)
    return functions;
  HMODULE module = LoadLibraryW(L"winhttp.dll");
  if (module == nullptr)
    throw HttpClientError("winhttp.dll cannot be loaded");
  functions.open = (WinHttpOpenFunction)httpClientFunction(module, "WinHttpOpen");
  functions.connect = (WinHttpConnectFunction)httpClientFunction(module, "WinHttpConnect");
  functions.openRequest = (WinHttpOpenRequestFunction)httpClientFunction(module, "WinHttpOpenRequest");
  functions.setTimeouts = (WinHttpSetTimeoutsFunction)httpClientFunction(module, "WinHttpSetTimeouts");
  functions.setOption = (WinHttpSetOptionFunction)httpClientFunction(module, "WinHttpSetOption");
  functions.sendRequest = (WinHttpSendRequestFunction)httpClientFunction(module, "WinHttpSendRequest");
  functions.receiveResponse = (WinHttpReceiveResponseFunction)httpClientFunction(module, "WinHttpReceiveResponse");
  functions.queryHeaders = (WinHttpQueryHeadersFunction)httpClientFunction(module, "WinHttpQueryHeaders");
  functions.readData = (WinHttpReadDataFunction)httpClientFunction(module, "WinHttpReadData");
  functions.closeHandle = (WinHttpCloseHandleFunction)httpClientFunction(module, "WinHttpCloseHandle");
  functions.module = module;
  return functions;
}

std::WString httpClientWide(std::StringView text)
{
  if (text.empty())
    return std::WString();
  i32 count = MultiByteToWideChar(65001, 0, text.data(), (i32)text.size(), nullptr, 0);
  std::WString wide;
  wide.resize((std::ContainerSize)count);
  MultiByteToWideChar(65001, 0, text.data(), (i32)text.size(), wide.data(), count);
  return wide;
}

std::String httpClientNarrow(const wchar_t* text, i32 length)
{
  if (length == 0)
    return std::String();
  i32 count = WideCharToMultiByte(65001, 0, text, length, nullptr, 0, nullptr, nullptr);
  std::String narrow(count, '\0');
  WideCharToMultiByte(65001, 0, text, length, narrow.data(), count, nullptr, nullptr);
  return narrow;
}

// The last error's text: WinHTTP's own codes (12000 to 12199) are in winhttp.dll.
[[noreturn]] void httpClientFail(std::StringView what, std::StringView url)
{
  u32 code = GetLastError();
  char buffer[512];
  u32 flags = FORMAT_MESSAGE_IGNORE_INSERTS | (code >= 12000 && code < 12200 ? FORMAT_MESSAGE_FROM_HMODULE : FORMAT_MESSAGE_FROM_SYSTEM);
  u32 length = FormatMessageA(flags, code >= 12000 && code < 12200 ? (void*)winHttp().module : nullptr, code, 0, buffer, 512, nullptr);
  while (length > 0 && (buffer[length - 1] == '\n' || buffer[length - 1] == '\r' || buffer[length - 1] == ' ' || buffer[length - 1] == '.'))
    --length;
  if (code == 12002)
    throw HttpClientError(std::toString(what, " ", url, ": timed out"));
  throw HttpClientError(std::toString(what, " ", url, ": ", std::StringView(buffer, (std::ContainerSize)length), " (error ", (i64)code, ")"));
}

HttpClientResponse httpClientFetch(const HttpClientRequest& request)
{
  const WinHttp& w = winHttp();
  HttpClientTarget target = httpClientTarget(request.url);
  HttpClientHandles handles;
  // WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY (4): the system's proxy settings.
  handles.session = w.open(L"kpp-httpclient/0.1", 4, nullptr, nullptr, 0);
  if (handles.session == nullptr)
    httpClientFail("WinHttpOpen for", request.url);
  i32 timeout = request.timeoutMilliseconds;
  if (!w.setTimeouts(handles.session, timeout, timeout, timeout, timeout))
    httpClientFail("WinHttpSetTimeouts for", request.url);
  // WINHTTP_OPTION_REDIRECT_POLICY (88): never (0), or not from https to http (1).
  u32 policy = request.followRedirects ? 1 : 0;
  w.setOption(handles.session, 88, &policy, sizeof(policy));
  std::WString host = httpClientWide(target.host);
  handles.connection = w.connect(handles.session, host.c_str(), target.port, 0);
  if (handles.connection == nullptr)
    httpClientFail("WinHttpConnect to", request.url);
  std::WString method = httpClientWide(request.method);
  std::WString path = httpClientWide(target.path);
  // WINHTTP_FLAG_SECURE (0x00800000) for https; WINHTTP_FLAG_ESCAPE_DISABLE (0x40): the path as given.
  handles.request = w.openRequest(handles.connection, method.c_str(), path.c_str(), nullptr, nullptr, nullptr,
                                  (target.secure ? 0x00800000u : 0u) | 0x40u);
  if (handles.request == nullptr)
    httpClientFail("WinHttpOpenRequest for", request.url);
  std::String headerText;
  for (const HttpClientHeader& h : request.headers)
    headerText << h.name + ": " + h.value + "\r\n";
  std::WString headers = httpClientWide(headerText);
  if (!w.sendRequest(handles.request, headers.empty() ? nullptr : headers.c_str(), headers.empty() ? 0 : (u32)-1,
                     request.body.empty() ? nullptr : (void*)request.body.data(), (u32)request.body.size(),
                     (u32)request.body.size(), 0))
    httpClientFail("sending", request.url);
  if (!w.receiveResponse(handles.request, nullptr))
    httpClientFail("receiving", request.url);

  HttpClientResponse response;
  // WINHTTP_QUERY_STATUS_CODE (19) | WINHTTP_QUERY_FLAG_NUMBER (0x20000000).
  u32 status = 0;
  u32 size = sizeof(status);
  if (!w.queryHeaders(handles.request, 19 | 0x20000000u, nullptr, &status, &size, nullptr))
    httpClientFail("the status of", request.url);
  response.status = (i32)status;
  // WINHTTP_QUERY_RAW_HEADERS_CRLF (22): first its size, then the text.
  u32 bytes = 0;
  w.queryHeaders(handles.request, 22, nullptr, nullptr, &bytes, nullptr);
  if (bytes > 0)
  {
    std::WString raw;
    raw.resize((std::ContainerSize)(bytes / sizeof(wchar_t) + 1));
    if (!w.queryHeaders(handles.request, 22, nullptr, raw.data(), &bytes, nullptr))
      httpClientFail("the headers of", request.url);
    response.headers = httpClientParseHeaders(httpClientNarrow(raw.data(), (i32)(bytes / sizeof(wchar_t))));
  }
  char buffer[65536];
  for (;;)
  {
    u32 got = 0;
    if (!w.readData(handles.request, buffer, sizeof(buffer), &got))
      httpClientFail("reading", request.url);
    if (got == 0)
      break;
    response.body << std::StringView(buffer, (std::ContainerSize)got);
  }
  return response;
}
