requires config::platform == Platform::FreeBSD;
// FreeBSD: HTTP/1.1 over net's TCP, and TLS through the base system's OpenSSL 3 (libssl and
// libcrypto, which every program using the library links: build.kpp's systemLibrary) with the
// system's certificates (/etc/ssl) and the host name checked. fetch(3), the base system's client, cannot
// POST, send headers, give the response's headers or a response with an error status. No proxy.
// Each request has a connection of its own (Connection: close); the body comes by Content-Length,
// chunked, or until the server closes.

// OpenSSL's functions this needs (its headers' macros wrap SSL_ctrl, called here directly).
extern "C" const void* TLS_client_method();
extern "C" void* SSL_CTX_new(const void* method);
extern "C" i32 SSL_CTX_set_default_verify_paths(void* context);
extern "C" void SSL_CTX_set_verify(void* context, i32 mode, void* callback);
extern "C" void SSL_CTX_free(void* context);
extern "C" void* SSL_new(void* context);
extern "C" i32 SSL_set_fd(void* ssl, i32 fd);
extern "C" i32 SSL_ctrl(void* ssl, i32 command, i32 number, void* pointer);
extern "C" i32 SSL_set1_host(void* ssl, const char* host);
extern "C" i32 SSL_connect(void* ssl);
extern "C" i32 SSL_read(void* ssl, void* buffer, i32 capacity);
extern "C" i32 SSL_write(void* ssl, const void* buffer, i32 size);
extern "C" i32 SSL_get_error(const void* ssl, i32 result);
extern "C" i32 SSL_get_verify_result(const void* ssl);
extern "C" void SSL_free(void* ssl);
extern "C" const char* X509_verify_cert_error_string(i32 code);
extern "C" u32 ERR_get_error();
extern "C" void ERR_error_string_n(u32 code, char* buffer, usize size);

i64 httpClientNumber(std::StringView text, i32 base, std::StringView what, std::StringView url)
{
  if (text.empty())
    throw HttpClientError(std::toString("the response of ", url, " has no ", what));
  i64 value = 0;
  for (char c : text)
  {
    i32 digit = c >= '0' && c <= '9' ? c - '0' : base == 16 && c >= 'a' && c <= 'f' ? c - 'a' + 10
                : base == 16 && c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
    if (digit < 0 || value > (i64)1 << 48)
      throw HttpClientError(std::toString("the response of ", url, " has a ", what, " that is not a number: ", text));
    value = value * base + digit;
  }
  return value;
}

// One request on a connection of its own; its response, any status.
HttpClientResponse httpClientExchange(const HttpClientRequest& request, std::StringView method, std::StringView url, std::StringView body)
{
  HttpClientTarget target = httpClientTarget(url);
  HttpClientConnection connection;
  connection.url = std::String(url);
  connection.open(target, request.timeoutMilliseconds);

  std::String host = target.host.find(':') != std::String::npos ? std::toString("[", target.host, "]"): target.host;
  if (target.port != (target.secure ? 443 : 80))
    host = std::toString(host, ":", (i32)target.port);
  std::String head = std::toString(method, " ", target.path, " HTTP/1.1\r\nHost: ", host, "\r\nUser-Agent: kpp-httpclient/0.1\r\nConnection: close\r\n");
  for (const HttpClientHeader& h : request.headers)
    head << h.name + ": " + h.value + "\r\n";
  if (!body.empty() || method == "POST" || method == "PUT")
    head << "Content-Length: " << (i64)body.size() << "\r\n";
  head << "\r\n";
  connection.write(head + body);

  HttpClientReader reader;
  reader.connection = &connection;
  HttpClientResponse response;
  // An informational response (100 Continue) comes before the real one.
  do
  {
    std::String status = reader.line();
    if (!status.starts_with("HTTP/1.") || status.size() < 12 || status[8] != ' ')
      throw HttpClientError(std::toString("the response of ", url, " does not start with an HTTP status line: ", status.substr(0, 80)));
    response.status = (i32)httpClientNumber(std::StringView(status).substr(9, 3), 10, "status", url);
    std::String headers;
    for (std::String line = reader.line(); !line.empty(); line = reader.line())
      headers << line + "\n";
    response.headers = httpClientParseHeaders(headers);
  } while (response.status >= 100 && response.status < 200);

  const std::String* encoding = response.header("Transfer-Encoding");
  const std::String* length = response.header("Content-Length");
  if (method == "HEAD" || response.status == 204 || response.status == 304)
    return response;
  if (encoding != nullptr && httpClientEqualIgnoringCase(*encoding, "chunked"))
  {
    for (;;)
    {
      std::String size = reader.line();
      std::ContainerSize extension = size.find(';');
      if (extension != std::String::npos)
        size = size.substr(0, extension);
      while (!size.empty() && (size[size.size() - 1] == ' ' || size[size.size() - 1] == '\t'))
        size = size.substr(0, size.size() - 1);
      i64 n = httpClientNumber(size, 16, "chunk size", url);
      if (n == 0)
        break;
      response.body << reader.take((std::ContainerSize)n);
      if (!reader.line().empty())
        throw HttpClientError(std::toString("a chunk of the response of ", url, " is longer than its size"));
    }
    // (the trailer's fields, if any, are not read: the connection closes)
  }
  else if (encoding != nullptr && !httpClientEqualIgnoringCase(*encoding, "identity"))
    throw HttpClientError(std::toString("the response of ", url, " has the transfer encoding ", *encoding));
  else if (length != nullptr)
    response.body = reader.take((std::ContainerSize)httpClientNumber(*length, 10, "Content-Length", url));
  else
    response.body = reader.rest();
  return response;
}

// Location against the address it answered: absolute, scheme-relative, absolute path or relative.
std::String httpClientResolve(std::StringView base, std::StringView location)
{
  if (location.starts_with("http://") || location.starts_with("https://"))
    return std::String(location);
  bool secure = base.starts_with("https://");
  std::StringView scheme = secure ? "https:" : "http:";
  if (location.starts_with("//"))
    return std::String(scheme) + location;
  std::StringView rest = base.substr(scheme.size() + 2);
  std::ContainerSize pathStart = rest.find('/');
  std::ContainerSize question = rest.find('?');
  if (question < pathStart)
    pathStart = question;
  std::String origin = std::String(base.substr(0, scheme.size() + 2)) + (pathStart == std::StringView::npos ? rest : rest.substr(0, pathStart));
  if (location.starts_with("/"))
    return origin + location;
  std::StringView path = pathStart == std::StringView::npos ? std::StringView("/") : rest.substr(pathStart);
  std::ContainerSize query = path.find('?');
  if (query != std::StringView::npos)
    path = path.substr(0, query);
  if (location.starts_with("?"))
    return origin + path + location;
  return origin + path.substr(0, path.rfind('/') + 1) + location;
}

HttpClientResponse httpClientFetch(const HttpClientRequest& request)
{
  std::String url = request.url;
  std::String method = request.method;
  std::String body = request.body;
  // Redirects as WinHTTP follows them: at most 10, never from https to http; 303, and 301 or 302
  // after a POST, become a GET without the body.
  for (i32 redirects = 0;; ++redirects)
  {
    HttpClientResponse response = httpClientExchange(request, method, url, body);
    i32 s = response.status;
    const std::String* location = response.header("Location");
    if (!request.followRedirects || location == nullptr || !(s == 301 || s == 302 || s == 303 || s == 307 || s == 308))
      return response;
    std::String next = httpClientResolve(url, *location);
    if (url.starts_with("https://") && next.starts_with("http://"))
      return response;
    if (redirects == 10)
      throw HttpClientError(std::toString(request.url, " redirects more than 10 times"));
    if (s == 303 || ((s == 301 || s == 302) && method == "POST"))
    {
      method = "GET";
      body = std::String();
    }
    url = next;
  }
}
