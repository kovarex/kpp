requires config::platform == Platform::FreeBSD;

// The bytes a response arrives in, read from its connection as they are needed.
struct HttpClientReader
{
  // Reads more; false when the connection has closed.
  bool more()
  {
    if (this.closed)
      return false;
    char buffer[16384];
    *std::platform::errnoLocation() = 0;
    i64 got = this.connection->read(buffer, 16384);
    if (got == 0)
    {
      this.closed = true;
      return false;
    }
    this.data << std::StringView(buffer, (std::ContainerSize)got);
    return true;
  }

  // The text up to the next CRLF (or LF), which it passes.
  std::String line()
  {
    for (;;)
    {
      std::ContainerSize end = this.data.find('\n', this.at);
      if (end != std::String::npos)
      {
        std::ContainerSize stop = end > this.at && this.data[end - 1] == '\r' ? end - 1 : end;
        std::String text = this.data.substr(this.at, stop - this.at);
        this.at = end + 1;
        return text;
      }
      if (!this.more())
        throw HttpClientError(std::toString("the response of ", this.connection->url, " ends in the middle of a line"));
    }
  }

  // The next n bytes.
  std::String take(std::ContainerSize n)
  {
    while (this.data.size() - this.at < n)
      if (!this.more())
        throw HttpClientError(std::toString("the response of ", this.connection->url, " ends ", (i64)(n - (this.data.size() - this.at)), " bytes early"));
    std::String text = this.data.substr(this.at, n);
    this.at += n;
    return text;
  }

  // Everything until the server closes the connection.
  std::String rest()
  {
    while (this.more())
    {
    }
    std::String text = this.data.substr(this.at);
    this.at = this.data.size();
    return text;
  }

  HttpClientConnection* connection = nullptr;
  std::String data;
  std::ContainerSize at = 0;
  bool closed = false;
};
