# Copy to /srv/kppnet/.env (chmod 600) and fill in. Never commit the filled copy.
# The three Forgejo secrets: generate each on the server with
#   docker run --rm codeberg.org/forgejo/forgejo:15 forgejo generate secret SECRET_KEY
#   docker run --rm codeberg.org/forgejo/forgejo:15 forgejo generate secret INTERNAL_TOKEN
#   docker run --rm codeberg.org/forgejo/forgejo:15 forgejo generate secret JWT_SECRET
FORGEJO_SECRET_KEY=
FORGEJO_INTERNAL_TOKEN=
FORGEJO_JWT_SECRET=

# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# Outgoing mail for notifications and password-less sign-in mails. Leave ENABLED=false until an
# SMTP account exists.
FORGEJO_MAIL_ENABLED=false
FORGEJO_SMTP_HOST=
FORGEJO_SMTP_USER=
FORGEJO_SMTP_PASSWORD=
FORGEJO_MAIL_FROM=kpp.net <noreply@kpp.net>
