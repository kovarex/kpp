// Files and paths for kppsite. Paths inside the repository are relative, with '/', as git names
// them: docs/stdlib/time.md.

std::String siteReadFile(const std::String& path)
{
  FILE* file = fopen(path.c_str(), "rb");
  if (!file)
    throw SiteError(std::toString("cannot read ", path));
  std::String text;
  char buffer[65536];
  while (true)
  {
    usize n = fread(buffer, 1, 65536, file);
    if (n == 0)
      break;
    text << std::StringView(buffer, n);
  }
  fclose(file);
  return text;
}

// Writes the file, making its directories first.
void siteWriteFile(const std::String& path, std::StringView content)
{
  i32 slash = path.rfind('/');
  if (slash != std::String::npos && slash > 0)
    std::filesystem::create_directories(std::filesystem::path(std::String(std::StringView(path).substr(0, slash))));
  FILE* file = fopen(path.c_str(), "wb");
  if (!file)
    throw SiteError(std::toString("cannot write ", path));
  bool written = fwrite(content.data(), 1, content.size(), file) == usize(content.size());
  if (fclose(file) != 0 || !written)
    throw SiteError(std::toString("cannot write ", path));
}

bool siteIsFile(const std::String& path) { return std::filesystem::is_regular_file(std::filesystem::path(path)); }
bool siteIsDirectory(const std::String& path) { return std::filesystem::is_directory(std::filesystem::path(path)); }

// The .md files under the repository's directory, as repository paths, sorted.
void siteFindMarkdown(const std::String& repository, const std::String& directory, std::Vector<std::String>& out)
{
  std::Vector<std::String> names;
  for (const std::filesystem::directory_entry& entry : std::filesystem::directory_iterator(std::filesystem::path(repository + "/" + directory)))
    names.push_back(entry.path().filename().string());
  std::sort(names.begin(), names.end());
  for (const std::String& name : names)
  {
    std::String relative = directory + "/" + name;
    if (siteIsDirectory(repository + "/" + relative))
    {
      if (name != "build" && name[0] != '.')
        siteFindMarkdown(repository, relative, out);
    }
    else if (name.endsWith(".md"))
      out.push_back(relative);
  }
}

// The directory part of a repository path, with its '/': "docs/stdlib/" for docs/stdlib/time.md.
std::StringView siteDirectoryOf(std::StringView path)
{
  i32 slash = path.rfind('/');
  return slash == std::StringView::npos ? std::StringView() : path.substr(0, slash + 1);
}

// A relative link from the page at `from` to the file at `to`, both repository paths:
// docs/stdlib/time.md to docs/design.html is ../design.html.
std::String siteRelativeLink(std::StringView from, std::StringView to)
{
  std::StringView fromDirectory = siteDirectoryOf(from);
  i32 common = 0;
  for (i32 i = 0; i < fromDirectory.size() && i < to.size() && fromDirectory[i] == to[i]; ++i)
    if (fromDirectory[i] == '/')
      common = i + 1;
  std::String link;
  for (i32 i = common; i < fromDirectory.size(); ++i)
    if (fromDirectory[i] == '/')
      link << "../";
  link << to.substr(common);
  return link;
}

// The way from a page up to the site's root: "" for index.html, "../../" for docs/stdlib/time.html.
std::String siteRootOf(std::StringView page)
{
  std::String up;
  for (char c : page)
    if (c == '/')
      up << "../";
  return up;
}

// The page a Markdown file becomes: docs/design.md is docs/design.html.
std::String siteHtmlPath(std::StringView markdownPath) { return std::String(markdownPath.substr(0, markdownPath.size() - 3)) + ".html"; }
