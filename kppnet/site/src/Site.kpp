// kppsite: writes kpp.net's static pages (README.md). The documentation's Markdown becomes HTML
// pages with their links to other pages rewritten; the libraries get a list and a page each, from
// the repository's libraries/ and the registry's index; everything goes into one directory, which
// is uploaded as it is.

constexpr html::HtmlTemplate sitePage{R"(<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}}</title>
<link rel="stylesheet" href="{{root}}style.css">
</head>
<body>
<header><a class="home" href="{{root}}index.html">kpp</a> <nav><a href="{{root}}index.html#documentation">Documentation</a> <a href="{{root}}libraries/index.html">Libraries</a> <a href="{{source}}">Source</a></nav></header>
<main>
{{content}}
</main>
<footer>Generated by kppsite from {{commit}}.</footer>
</body>
</html>
)"};

constexpr html::HtmlTemplate siteDocumentItem{R"(<li><a href="{{link}}">{{title}}</a> <span class="path">{{path}}</span></li>
)"};

constexpr html::HtmlTemplate siteHome{R"(<h1>kpp</h1>
<p>A C++-like language and its compiler, designed for order-of-magnitude faster builds.</p>
<h2 id="documentation">Documentation</h2>
<ul class="documents">
{{documents}}</ul>
<h2>Libraries</h2>
<p><a href="libraries/index.html">The libraries</a>: the official ones, and those published to the registry.</p>
)"};

constexpr html::HtmlTemplate siteLibraryItem{R"(<tr><td><a href="{{link}}">{{name}}</a></td><td>{{version}}</td><td>{{summary}}</td></tr>
)"};

constexpr html::HtmlTemplate siteLibraryList{R"(<h1>Libraries</h1>
<p>Search: <input id="search" type="search" placeholder="name"></p>
<table class="libraries">
<thead><tr><th>Library</th><th>Latest release</th><th>What</th></tr></thead>
<tbody>
{{rows}}</tbody>
</table>
<script src="search.js"></script>
)"};

constexpr html::HtmlTemplate siteReleaseRow{R"(<tr><td>{{version}}</td><td>{{published}}</td><td>{{kpp}}</td><td><a href="{{archive}}">archive</a></td><td><code>{{tree}}</code></td><td>{{yanked}}</td></tr>
)"};

constexpr html::HtmlTemplate siteLibraryPage{R"(<p class="breadcrumb"><a href="index.html">Libraries</a></p>
<h1>{{name}}</h1>
<h2>Releases</h2>
{{releases}}
{{readme}}
)"};

constexpr html::HtmlTemplate siteReleaseTable{R"(<table class="releases">
<thead><tr><th>Version</th><th>Published</th><th>kpp</th><th>Files</th><th>Tree hash</th><th>Yanked</th></tr></thead>
<tbody>
{{rows}}</tbody>
</table>
)"};

constexpr html::HtmlTemplate siteNotPublished{R"(<p>Not published to the registry yet: it is in the kpp repository's <a href="{{link}}">libraries/{{name}}</a>.</p>
)"};

const char* siteStyle = R"(body { font-family: system-ui, sans-serif; max-width: 52em; margin: 0 auto; padding: 0 1em; line-height: 1.5; color: #1b1b1b; }
header { display: flex; gap: 1.5em; align-items: baseline; border-bottom: 1px solid #ddd; padding: 0.6em 0; }
header .home { font-weight: bold; font-size: 1.3em; text-decoration: none; }
header nav a { margin-right: 1em; }
footer { border-top: 1px solid #ddd; margin-top: 3em; padding: 0.6em 0; color: #666; font-size: 0.9em; }
a { color: #0b57d0; }
pre { background: #f5f5f5; padding: 0.8em; overflow-x: auto; }
code { font-family: ui-monospace, Consolas, monospace; font-size: 0.92em; }
table { border-collapse: collapse; margin: 1em 0; }
th, td { border: 1px solid #ddd; padding: 0.3em 0.6em; vertical-align: top; }
th { background: #f5f5f5; }
blockquote { border-left: 3px solid #ddd; margin-left: 0; padding-left: 1em; color: #444; }
.path { color: #777; font-size: 0.85em; }
)";

// Filters the library table as one types in the search box: no server needed.
const char* siteSearchScript = R"(document.getElementById("search").addEventListener("input", function (event) {
  var text = event.target.value.toLowerCase();
  document.querySelectorAll("table.libraries tbody tr").forEach(function (row) {
    row.style.display = row.textContent.toLowerCase().indexOf(text) >= 0 ? "" : "none";
  });
});
)";

// One run's state: the pages to write, the problems found.
struct Site
{
  Site(const SiteOptions& options) : options(options) {}

  std::String path(std::StringView repositoryPath) const { return this.options.repository + "/" + repositoryPath; }

  void write(std::StringView sitePath, std::StringView content)
  {
    siteWriteFile(this.options.out + "/" + sitePath, content);
    ++this.written;
  }

  void warn(std::StringView page, std::StringView what) { this.warnings.push_back(std::toString(std::String(page), ": ", std::String(what))); }

  bool isPage(std::StringView repositoryPath) const
  {
    for (const std::String& p : this.pages)
      if (std::StringView(p) == repositoryPath)
        return true;
    return false;
  }

  // A link in the Markdown file at page, as the page's HTML gets it: to another page's .html, to
  // the source of a file that is not a page, or unchanged (a URL, an anchor in this page).
  std::String rewriteLink(std::StringView page, const std::String& destination)
  {
    if (destination.empty())
      return destination;
    if (destination[0] == '#')
    {
      this.anchorLinks.push_back(SiteAnchorLink{std::String(page), siteHtmlPath(page), url::urlDecode(std::StringView(destination).substr(1))});
      return destination;
    }
    url::Url reference;
    try
    {
      reference = url::parseUrl(destination);
    }
    catch (const url::UrlError& e)
    {
      this.warn(page, std::toString("a link that is not a URL, kept as it is: ", destination, " (", e.message, ")"));
      return destination;
    }
    if (!reference.isRelative() || reference.hasAuthority || reference.path.empty())
      return destination;
    url::Url target = url::resolveUrl(url::parseUrl("file:///" + url::urlEncodePath(page)), reference);
    std::String file = url::urlDecode(std::StringView(target.path).substr(1));
    std::String fragment = reference.hasFragment ? "#" + reference.fragment : std::String();
    std::String trimmed = file.endsWith("/") ? std::String(std::StringView(file).substr(0, file.size() - 1)) : file;
    if (this.isPage(trimmed))
    {
      if (reference.hasFragment)
        this.anchorLinks.push_back(SiteAnchorLink{std::String(page), siteHtmlPath(trimmed), url::urlDecode(reference.fragment)});
      return url::urlEncodePath(siteRelativeLink(page, siteHtmlPath(trimmed))) + fragment;
    }
    if (siteIsFile(this.path(trimmed)))
      return this.options.sourceUrl + "/blob/master/" + url::urlEncodePath(trimmed) + fragment;
    if (trimmed.empty() || siteIsDirectory(this.path(trimmed)))
      return this.options.sourceUrl + "/tree/master/" + url::urlEncodePath(trimmed) + fragment;
    this.warn(page, std::toString("a link to ", file, ", which is not in the repository"));
    return destination;
  }

  std::String pageHtml(std::StringView sitePath, std::StringView title, const html::SafeHtml& content)
  {
    return sitePage
      .render({{"title", std::String(title) + " - kpp"},
               {"root", siteRootOf(sitePath)},
               {"source", this.options.sourceUrl},
               {"content", content},
               {"commit", this.options.commit.empty() ? std::String("the working tree") : this.options.commit}})
      .str();
  }

  html::SafeHtml renderMarkdown(std::StringView page, std::StringView text)
  {
    markdown::MarkdownOptions markdown;
    markdown.tables = true;
    markdown.headingIds = true;
    markdown.rewriteLink = [&this, page](const std::String& destination) -> std::String { return this.rewriteLink(page, destination); };
    return html::SafeHtml::trusted(markdown::markdownToHtml(text, markdown));
  }

  void run()
  {
    for (const std::String& root : this.options.pageRoots)
    {
      if (!siteIsDirectory(this.path(root)))
        throw SiteError(std::toString(root, " is not a directory of the repository ", this.options.repository));
      siteFindMarkdown(this.options.repository, root, this.pages);
    }
    html::SafeHtml documents;
    for (const std::String& page : this.pages)
    {
      std::String text = siteReadFile(this.path(page));
      std::String title = siteTitle(text, page);
      std::String html = siteHtmlPath(page);
      std::String pageHtml = this.pageHtml(html, title, this.renderMarkdown(page, text));
      this.write(html, pageHtml);
      this.htmlPaths.push_back(html);
      this.htmlTexts.push_back(pageHtml);
      if (page.startsWith("docs/"))
        documents << siteDocumentItem.render({{"link", url::urlEncodePath(html)}, {"title", title}, {"path", page}});
    }
    this.write("index.html", this.pageHtml("index.html", "kpp", siteHome.render({{"documents", documents}})));
    this.write("style.css", siteStyle);
    this.libraries();
    this.checkAnchors();
  }

  // Warns about every link to an anchor that its page has no id for.
  void checkAnchors()
  {
    for (const SiteAnchorLink& link : this.anchorLinks)
    {
      const std::String* html = nullptr;
      for (i32 i = 0; i < this.htmlPaths.size(); ++i)
        if (this.htmlPaths[i] == link.target)
          html = &this.htmlTexts[i];
      if (!html)
        continue;
      std::String id = " id=\"" + html::htmlEscape(link.anchor) + "\"";
      if (html->find(id) == std::String::npos)
        this.warn(link.page, std::toString("a link to #", link.anchor, " in ", link.target, ", which has no such heading"));
    }
  }

  // libraries/index.html, a page per library, and libraries/search.json: the repository's
  // libraries and the registry's, by name.
  void libraries()
  {
    std::Vector<std::String> names;
    if (siteIsDirectory(this.path("libraries")))
      for (const std::filesystem::directory_entry& entry : std::filesystem::directory_iterator(std::filesystem::path(this.path("libraries"))))
        if (entry.is_directory() && siteIsFile(this.path("libraries/" + entry.path().filename().string() + "/build.kpp")))
          names.push_back(entry.path().filename().string());
    std::Vector<json::JsonValue> index;
    if (!this.options.registry.empty())
    {
      std::String directory = this.options.registry + "/index";
      if (!siteIsDirectory(directory))
        throw SiteError(std::toString(directory, " is not a directory: --registry names a copy of the registry's store"));
      for (const std::filesystem::directory_entry& entry : std::filesystem::directory_iterator(std::filesystem::path(directory)))
      {
        std::String file = entry.path().filename().string();
        if (!file.endsWith(".json") || file == "config.json")
          continue;
        json::JsonValue library = json::parseJson(siteReadFile(directory + "/" + file));
        std::String name = library["name"].asString();
        if (std::StringView(file) != std::StringView(name + ".json"))
          throw SiteError(std::toString(directory, "/", file, " names the library ", name));
        index.push_back(library);
        bool known = false;
        for (const std::String& n : names)
          known = known || n == name;
        if (!known)
          names.push_back(name);
      }
    }
    std::sort(names.begin(), names.end());
    html::SafeHtml rows;
    json::JsonValue search = json::JsonValue::array();
    for (const std::String& name : names)
    {
      const json::JsonValue* entry = nullptr;
      for (const json::JsonValue& library : index)
        if (library["name"].asString() == name)
          entry = &library;
      std::String latest = entry ? siteLatestVersion(*entry) : std::String();
      std::String readme = this.path("libraries/" + name + "/README.md");
      std::String summary = siteIsFile(readme) ? siteSummary(siteReadFile(readme)) : std::String();
      std::String page = "libraries/" + name + ".html";
      rows << siteLibraryItem.render({{"link", url::urlEncode(name) + ".html"}, {"name", name}, {"version", latest.empty() ? std::String("not published") : latest}, {"summary", summary}});
      json::JsonValue item;
      item.set("name", name);
      item.set("version", latest);
      item.set("summary", summary);
      search.push(item);
      html::SafeHtml releases = entry ? this.releaseTable(*entry) : siteNotPublished.render({{"link", this.options.sourceUrl + "/tree/master/libraries/" + url::urlEncode(name)}, {"name", name}});
      html::SafeHtml readmeHtml = siteIsFile(readme) ? this.renderMarkdown("libraries/" + name + "/README.md", siteReadFile(readme)) : html::SafeHtml();
      this.write(page, this.pageHtml(page, name, siteLibraryPage.render({{"name", name}, {"releases", releases}, {"readme", readmeHtml}})));
    }
    this.write("libraries/index.html", this.pageHtml("libraries/index.html", "Libraries", siteLibraryList.render({{"rows", rows}})));
    this.write("libraries/search.json", json::writeJson(search));
    this.write("libraries/search.js", siteSearchScript);
  }

  html::SafeHtml releaseTable(const json::JsonValue& library)
  {
    html::SafeHtml rows;
    const json::JsonValue& releases = library["releases"];
    for (i32 i = releases.size() - 1; i >= 0; --i)
    {
      const json::JsonValue& r = releases[i];
      const json::JsonValue* yanked = r.find("yanked");
      rows << siteReleaseRow.render({{"version", r["version"].asString()},
                                     {"published", r["published"].asString()},
                                     {"kpp", r["kpp"].asString()},
                                     {"archive", this.options.registryUrl + r["archive"].asString()},
                                     {"tree", r["tree"].asString()},
                                     {"yanked", yanked && !yanked->isNull() ? yanked->asString() : std::String()}});
    }
    return siteReleaseTable.render({{"rows", rows}});
  }

  SiteOptions options;
  std::Vector<std::String> pages; // the .md files that become pages, repository paths
  std::Vector<std::String> warnings;
  std::Vector<SiteAnchorLink> anchorLinks;
  std::Vector<std::String> htmlPaths; // the pages written, and their HTML, for the anchor check
  std::Vector<std::String> htmlTexts;
  i32 written = 0;
};

// The newest release that is not yanked, or "".
std::String siteLatestVersion(const json::JsonValue& library)
{
  const json::JsonValue& releases = library["releases"];
  for (i32 i = releases.size() - 1; i >= 0; --i)
  {
    const json::JsonValue* yanked = releases[i].find("yanked");
    if (!yanked || yanked->isNull())
      return releases[i]["version"].asString();
  }
  return std::String();
}

// A page's title: its first "# " heading's text, or its path.
std::String siteTitle(std::StringView text, std::StringView path)
{
  i32 at = 0;
  while (at < text.size())
  {
    i32 end = at;
    while (end < text.size() && text[end] != '\n' && text[end] != '\r')
      ++end;
    std::StringView line = text.substr(at, end - at);
    if (line.startsWith("# "))
    {
      std::String title;
      for (char c : line.substr(2))
        if (c != '`' && c != '*')
          title << c;
      return title;
    }
    at = end + 1;
  }
  return std::String(path);
}

// A README's first paragraph after its title, as plain text: the library's summary.
std::String siteSummary(std::StringView text)
{
  std::String summary;
  i32 at = 0;
  bool started = false;
  while (at < text.size())
  {
    i32 end = at;
    while (end < text.size() && text[end] != '\n' && text[end] != '\r')
      ++end;
    std::StringView line = text.substr(at, end - at);
    at = end + 1;
    if (line.startsWith("#"))
      continue;
    if (line.empty() || line == std::StringView("\r"))
    {
      if (started)
        break;
      continue;
    }
    started = true;
    if (!summary.empty())
      summary << ' ';
    for (i32 i = 0; i < line.size(); ++i)
    {
      char c = line[i];
      if (c == '`' || c == '*' || c == '[')
        continue;
      if (c == ']' && i + 1 < line.size() && line[i + 1] == '(')
      {
        while (i < line.size() && line[i] != ')')
          ++i;
        continue;
      }
      summary << c;
    }
  }
  return summary;
}

i32 main(i32 argc, char** argv)
{
  SiteOptions options;
  for (i32 i = 1; i < argc; ++i)
  {
    std::String arg = argv[i];
    if (i + 1 < argc && arg == "--out")
      options.out = argv[++i];
    else if (i + 1 < argc && arg == "--repository")
      options.repository = argv[++i];
    else if (i + 1 < argc && arg == "--registry")
      options.registry = argv[++i];
    else if (i + 1 < argc && arg == "--pages")
      options.pageRoots.push_back(argv[++i]);
    else if (i + 1 < argc && arg == "--source-url")
      options.sourceUrl = argv[++i];
    else if (i + 1 < argc && arg == "--registry-url")
      options.registryUrl = argv[++i];
    else if (i + 1 < argc && arg == "--commit")
      options.commit = argv[++i];
    else
    {
      fprintf(stderr, "usage: kppsite --out DIR [--repository DIR] [--pages DIR]... [--registry DIR] [--commit TEXT]\n"
                      "  [--source-url URL] [--registry-url URL]   (README.md)\n");
      return 2;
    }
  }
  if (options.out.empty())
  {
    fprintf(stderr, "kppsite: --out DIR is required\n");
    return 2;
  }
  if (options.pageRoots.empty())
  {
    options.pageRoots.push_back("docs");
    options.pageRoots.push_back("libraries");
  }
  try
  {
    Site site(options);
    site.run();
    for (const std::String& w : site.warnings)
      fprintf(stderr, "kppsite: warning: %s\n", w.c_str());
    std::println("kppsite: ", site.written, " files in ", options.out, " (", site.pages.size(), " pages), ", site.warnings.size(), " warnings");
    return 0;
  }
  catch (const std::Exception& e)
  {
    fprintf(stderr, "kppsite: error: %s\n", e.what());
    return 1;
  }
}
