// kppsite: writes kpp.net's static pages (README.md). The documentation's Markdown becomes HTML
// pages with their links to other pages rewritten; the libraries get a list and a page each, from
// the repository's libraries/ and the registry's index; everything goes into one directory, which
// is uploaded as it is.

struct SiteOptions
{
  String repository = ".";                         // the kpp repository's root
  String out;                                      // where the site is written
  String registry;                                 // a copy of the registry's store (index/*.json); "": none
  Vector<String> pageRoots;                        // the directories whose .md files become pages
  String sourceUrl = "https://github.com/kovarex/kpp"; // where a link to a file that is not a page goes
  String registryUrl = "https://kpp.net/registry/";    // where the archives are
  String commit;                                   // the repository's commit, named in every page's footer
};

constexpr HtmlTemplate sitePage(R"(<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}}</title>
<link rel="stylesheet" href="{{root}}style.css">
</head>
<body>
<header><a class="home" href="{{root}}index.html">Kpp</a> <nav><a href="{{root}}index.html#documentation">Documentation</a> <a href="{{root}}libraries/index.html">Libraries</a> <a href="{{source}}">Source</a></nav></header>
<main>
{{content}}
</main>
<footer>Generated by kppsite from {{commit}}.</footer>
</body>
</html>
)");

constexpr HtmlTemplate siteDocumentItem(R"(<li><a href="{{link}}">{{title}}</a> <span class="path">{{path}}</span></li>
)");

constexpr HtmlTemplate siteHome(R"(<h1>Kpp</h1>
<p>A C++-like language and its compiler, designed for order-of-magnitude faster builds.</p>
<h2 id="documentation">Documentation</h2>
<ul class="documents">
{{documents}}</ul>
<h2>Libraries</h2>
<p><a href="libraries/index.html">The libraries</a>: the official ones, and those published to the registry.</p>
)");

constexpr HtmlTemplate siteLibraryItem(R"(<tr><td><a href="{{link}}">{{name}}</a></td><td>{{version}}</td><td>{{summary}}</td></tr>
)");

constexpr HtmlTemplate siteLibraryList(R"(<h1>Libraries</h1>
<p>Search: <input id="search" type="search" placeholder="name"></p>
<table class="libraries">
<thead><tr><th>Library</th><th>Latest release</th><th>What</th></tr></thead>
<tbody>
{{rows}}</tbody>
</table>
<script src="search.js"></script>
)");

constexpr HtmlTemplate siteReleaseRow(R"(<tr><td>{{version}}</td><td>{{published}}</td><td>{{kpp}}</td><td><a href="{{archive}}">archive</a></td><td><code>{{tree}}</code></td><td>{{yanked}}</td></tr>
)");

constexpr HtmlTemplate siteLibraryPage(R"(<p class="breadcrumb"><a href="index.html">Libraries</a></p>
<h1>{{name}}</h1>
<h2>Releases</h2>
{{releases}}
{{readme}}
)");

constexpr HtmlTemplate siteReleaseTable(R"(<table class="releases">
<thead><tr><th>Version</th><th>Published</th><th>Kpp</th><th>Files</th><th>Tree hash</th><th>Yanked</th></tr></thead>
<tbody>
{{rows}}</tbody>
</table>
)");

constexpr HtmlTemplate siteNotPublished(R"(<p>Not published to the registry yet: it is in the kpp repository's <a href="{{link}}">libraries/{{name}}</a>.</p>
)");

const char* siteStyle = R"(body { font-family: system-ui, sans-serif; max-width: 52em; margin: 0 auto; padding: 0 1em; line-height: 1.5; color: #1b1b1b; }
header { display: flex; gap: 1.5em; align-items: baseline; border-bottom: 1px solid #ddd; padding: 0.6em 0; }
header .home { font-weight: bold; font-size: 1.3em; text-decoration: none; }
header nav a { margin-right: 1em; }
footer { border-top: 1px solid #ddd; margin-top: 3em; padding: 0.6em 0; color: #666; font-size: 0.9em; }
a { color: #0b57d0; }
pre { background: #f5f5f5; padding: 0.8em; overflow-x: auto; }
code { font-family: ui-monospace, Consolas, monospace; font-size: 0.92em; }
table { border-collapse: collapse; margin: 1em 0; }
th, td { border: 1px solid #ddd; padding: 0.3em 0.6em; vertical-align: top; }
th { background: #f5f5f5; }
blockquote { border-left: 3px solid #ddd; margin-left: 0; padding-left: 1em; color: #444; }
.path { color: #777; font-size: 0.85em; }
)";

// Filters the library table as one types in the search box: no server needed.
const char* siteSearchScript = R"(document.getElementById("search").addEventListener("input", function (event) {
  var text = event.target.value.toLowerCase();
  document.querySelectorAll("table.libraries tbody tr").forEach(function (row) {
    row.style.display = row.textContent.toLowerCase().indexOf(text) >= 0 ? "" : "none";
  });
});
)";

// A link to an anchor in one of the site's pages, checked once every page is written.
struct SiteAnchorLink
{
  String page;   // the Markdown file the link is in
  String target; // the site path of the page it goes to
  String anchor; // decoded
};

// One run's state: the pages to write, the problems found.
struct Site
{
  SiteOptions options;
  Vector<String> pages; // the .md files that become pages, repository paths
  Vector<String> warnings;
  Vector<SiteAnchorLink> anchorLinks;
  Vector<String> htmlPaths; // the pages written, and their HTML, for the anchor check
  Vector<String> htmlTexts;
  int written = 0;

  explicit Site(const SiteOptions& options) : options(options) {}

  String path(StringView repositoryPath) const { return this->options.repository + "/" + repositoryPath; }

  void write(StringView sitePath, StringView content)
  {
    siteWriteFile(this->options.out + "/" + sitePath, content);
    ++this->written;
  }

  void warn(StringView page, StringView what) { this->warnings.push_back(format("{}: {}", String(page), String(what))); }

  bool isPage(StringView repositoryPath) const
  {
    for (const String& p : this->pages)
      if (StringView(p) == repositoryPath)
        return true;
    return false;
  }

  // A link in the Markdown file at page, as the page's HTML gets it: to another page's .html, to
  // the source of a file that is not a page, or unchanged (a URL, an anchor in this page).
  String rewriteLink(StringView page, const String& destination)
  {
    if (destination.empty())
      return destination;
    if (destination[0] == '#')
    {
      this->anchorLinks.push_back(SiteAnchorLink{String(page), siteHtmlPath(page), urlDecode(StringView(destination).substr(1))});
      return destination;
    }
    Url reference;
    try
    {
      reference = parseUrl(destination);
    }
    catch (const UrlError& e)
    {
      this->warn(page, format("a link that is not a URL, kept as it is: {} ({})", destination, e.message));
      return destination;
    }
    if (!reference.isRelative() || reference.hasAuthority || reference.path.empty())
      return destination;
    Url target = resolveUrl(parseUrl("file:///" + urlEncodePath(page)), reference);
    String file = urlDecode(StringView(target.path).substr(1));
    String fragment = reference.hasFragment ? "#" + reference.fragment : String();
    String trimmed = file.endsWith("/") ? String(StringView(file).substr(0, file.size() - 1)) : file;
    if (this->isPage(trimmed))
    {
      if (reference.hasFragment)
        this->anchorLinks.push_back(SiteAnchorLink{String(page), siteHtmlPath(trimmed), urlDecode(reference.fragment)});
      return urlEncodePath(siteRelativeLink(page, siteHtmlPath(trimmed))) + fragment;
    }
    if (siteIsFile(this->path(trimmed)))
      return this->options.sourceUrl + "/blob/master/" + urlEncodePath(trimmed) + fragment;
    if (trimmed.empty() || siteIsDirectory(this->path(trimmed)))
      return this->options.sourceUrl + "/tree/master/" + urlEncodePath(trimmed) + fragment;
    this->warn(page, format("a link to {}, which is not in the repository", file));
    return destination;
  }

  String pageHtml(StringView sitePath, StringView title, const SafeHtml& content)
  {
    return sitePage
      .render({{"title", String(title) + " - Kpp"},
               {"root", siteRootOf(sitePath)},
               {"source", this->options.sourceUrl},
               {"content", content},
               {"commit", this->options.commit.empty() ? String("the working tree") : this->options.commit}})
      .html;
  }

  SafeHtml renderMarkdown(StringView page, StringView text)
  {
    MarkdownOptions markdown;
    markdown.tables = true;
    markdown.headingIds = true;
    markdown.rewriteLink = [this, page](const String& destination) -> String { return this->rewriteLink(page, destination); };
    return SafeHtml::trusted(markdownToHtml(text, markdown));
  }

  void run()
  {
    for (const String& root : this->options.pageRoots)
    {
      if (!siteIsDirectory(this->path(root)))
        throw SiteError(format("{} is not a directory of the repository {}", root, this->options.repository));
      siteFindMarkdown(this->options.repository, root, this->pages);
    }
    SafeHtml documents;
    for (const String& page : this->pages)
    {
      String text = siteReadFile(this->path(page));
      String title = siteTitle(text, page);
      String html = siteHtmlPath(page);
      String pageHtml = this->pageHtml(html, title, this->renderMarkdown(page, text));
      this->write(html, pageHtml);
      this->htmlPaths.push_back(html);
      this->htmlTexts.push_back(pageHtml);
      if (page.startsWith("docs/"))
        documents.append(siteDocumentItem.render({{"link", urlEncodePath(html)}, {"title", title}, {"path", page}}));
    }
    this->write("index.html", this->pageHtml("index.html", "Kpp", siteHome.render({{"documents", documents}})));
    this->write("style.css", siteStyle);
    this->libraries();
    this->checkAnchors();
  }

  // Warns about every link to an anchor that its page has no id for.
  void checkAnchors()
  {
    for (const SiteAnchorLink& link : this->anchorLinks)
    {
      const String* html = nullptr;
      for (int i = 0; i < this->htmlPaths.size(); ++i)
        if (this->htmlPaths[i] == link.target)
          html = &this->htmlTexts[i];
      if (!html)
        continue;
      String id = " id=\"" + htmlEscape(link.anchor) + "\"";
      if (html->find(id) == String::npos)
        this->warn(link.page, format("a link to #{} in {}, which has no such heading", link.anchor, link.target));
    }
  }

  // libraries/index.html, a page per library, and libraries/search.json: the repository's
  // libraries and the registry's, by name.
  void libraries()
  {
    Vector<String> names;
    if (siteIsDirectory(this->path("libraries")))
      for (const filesystem::directory_entry& entry : filesystem::directory_iterator(filesystem::path(this->path("libraries"))))
        if (entry.is_directory() && siteIsFile(this->path("libraries/" + entry.path().filename().string() + "/build.kpp")))
          names.push_back(entry.path().filename().string());
    Vector<JsonValue> index;
    if (!this->options.registry.empty())
    {
      String directory = this->options.registry + "/index";
      if (!siteIsDirectory(directory))
        throw SiteError(format("{} is not a directory: --registry names a copy of the registry's store", directory));
      for (const filesystem::directory_entry& entry : filesystem::directory_iterator(filesystem::path(directory)))
      {
        String file = entry.path().filename().string();
        if (!file.endsWith(".json") || file == "config.json")
          continue;
        JsonValue library = parseJson(siteReadFile(directory + "/" + file));
        String name = library["name"].asString();
        if (StringView(file) != StringView(name + ".json"))
          throw SiteError(format("{}/{} names the library {}", directory, file, name));
        index.push_back(library);
        bool known = false;
        for (const String& n : names)
          known = known || n == name;
        if (!known)
          names.push_back(name);
      }
    }
    sort(names.begin(), names.end());
    SafeHtml rows;
    JsonValue search = JsonValue::array();
    for (const String& name : names)
    {
      const JsonValue* entry = nullptr;
      for (const JsonValue& library : index)
        if (library["name"].asString() == name)
          entry = &library;
      String latest = entry ? siteLatestVersion(*entry) : String();
      String readme = this->path("libraries/" + name + "/README.md");
      String summary = siteIsFile(readme) ? siteSummary(siteReadFile(readme)) : String();
      String page = "libraries/" + name + ".html";
      rows.append(siteLibraryItem.render({{"link", urlEncode(name) + ".html"}, {"name", name}, {"version", latest.empty() ? String("not published") : latest}, {"summary", summary}}));
      JsonValue item;
      item.set("name", name);
      item.set("version", latest);
      item.set("summary", summary);
      search.push(item);
      SafeHtml releases = entry ? this->releaseTable(*entry) : siteNotPublished.render({{"link", this->options.sourceUrl + "/tree/master/libraries/" + urlEncode(name)}, {"name", name}});
      SafeHtml readmeHtml = siteIsFile(readme) ? this->renderMarkdown("libraries/" + name + "/README.md", siteReadFile(readme)) : SafeHtml();
      this->write(page, this->pageHtml(page, name, siteLibraryPage.render({{"name", name}, {"releases", releases}, {"readme", readmeHtml}})));
    }
    this->write("libraries/index.html", this->pageHtml("libraries/index.html", "Libraries", siteLibraryList.render({{"rows", rows}})));
    this->write("libraries/search.json", writeJson(search));
    this->write("libraries/search.js", siteSearchScript);
  }

  SafeHtml releaseTable(const JsonValue& library)
  {
    SafeHtml rows;
    const JsonValue& releases = library["releases"];
    for (int i = releases.size() - 1; i >= 0; --i)
    {
      const JsonValue& r = releases[i];
      const JsonValue* yanked = r.find("yanked");
      rows.append(siteReleaseRow.render({{"version", r["version"].asString()},
                                          {"published", r["published"].asString()},
                                          {"kpp", r["kpp"].asString()},
                                          {"archive", this->options.registryUrl + r["archive"].asString()},
                                          {"tree", r["tree"].asString()},
                                          {"yanked", yanked && !yanked->isNull() ? yanked->asString() : String()}}));
    }
    return siteReleaseTable.render({{"rows", rows}});
  }
};

// The newest release that is not yanked, or "".
String siteLatestVersion(const JsonValue& library)
{
  const JsonValue& releases = library["releases"];
  for (int i = releases.size() - 1; i >= 0; --i)
  {
    const JsonValue* yanked = releases[i].find("yanked");
    if (!yanked || yanked->isNull())
      return releases[i]["version"].asString();
  }
  return String();
}

// A page's title: its first "# " heading's text, or its path.
String siteTitle(StringView text, StringView path)
{
  int at = 0;
  while (at < text.size())
  {
    int end = at;
    while (end < text.size() && text[end] != '\n' && text[end] != '\r')
      ++end;
    StringView line = text.substr(at, end - at);
    if (line.startsWith("# "))
    {
      String title;
      for (char c : line.substr(2))
        if (c != '`' && c != '*')
          title.append(c);
      return title;
    }
    at = end + 1;
  }
  return String(path);
}

// A README's first paragraph after its title, as plain text: the library's summary.
String siteSummary(StringView text)
{
  String summary;
  int at = 0;
  bool started = false;
  while (at < text.size())
  {
    int end = at;
    while (end < text.size() && text[end] != '\n' && text[end] != '\r')
      ++end;
    StringView line = text.substr(at, end - at);
    at = end + 1;
    if (line.startsWith("#"))
      continue;
    if (line.empty() || line == StringView("\r"))
    {
      if (started)
        break;
      continue;
    }
    started = true;
    if (!summary.empty())
      summary.append(' ');
    for (int i = 0; i < line.size(); ++i)
    {
      char c = line[i];
      if (c == '`' || c == '*' || c == '[')
        continue;
      if (c == ']' && i + 1 < line.size() && line[i + 1] == '(')
      {
        while (i < line.size() && line[i] != ')')
          ++i;
        continue;
      }
      summary.append(c);
    }
  }
  return summary;
}

int main(int argc, char** argv)
{
  SiteOptions options;
  for (int i = 1; i < argc; ++i)
  {
    String arg = argv[i];
    if (i + 1 < argc && arg == "--out")
      options.out = argv[++i];
    else if (i + 1 < argc && arg == "--repository")
      options.repository = argv[++i];
    else if (i + 1 < argc && arg == "--registry")
      options.registry = argv[++i];
    else if (i + 1 < argc && arg == "--pages")
      options.pageRoots.push_back(argv[++i]);
    else if (i + 1 < argc && arg == "--source-url")
      options.sourceUrl = argv[++i];
    else if (i + 1 < argc && arg == "--registry-url")
      options.registryUrl = argv[++i];
    else if (i + 1 < argc && arg == "--commit")
      options.commit = argv[++i];
    else
    {
      fprintf(stderr, "usage: kppsite --out DIR [--repository DIR] [--pages DIR]... [--registry DIR] [--commit TEXT]\n"
                      "  [--source-url URL] [--registry-url URL]   (README.md)\n");
      return 2;
    }
  }
  if (options.out.empty())
  {
    fprintf(stderr, "kppsite: --out DIR is required\n");
    return 2;
  }
  if (options.pageRoots.empty())
  {
    options.pageRoots.push_back("docs");
    options.pageRoots.push_back("libraries");
  }
  try
  {
    Site site(options);
    site.run();
    for (const String& w : site.warnings)
      fprintf(stderr, "kppsite: warning: %s\n", w.c_str());
    printf("kppsite: %d files in %s (%d pages), %d warnings\n", site.written, options.out.c_str(), site.pages.size(), site.warnings.size());
    return 0;
  }
  catch (const Exception& e)
  {
    fprintf(stderr, "kppsite: error: %s\n", e.what());
    return 1;
  }
}
