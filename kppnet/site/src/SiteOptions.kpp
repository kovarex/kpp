struct SiteOptions
{
  std::String repository = ".";                         // the kpp repository's root
  std::String out;                                      // where the site is written
  std::String registry;                                 // a copy of the registry's store (index/*.json); "": none
  std::Vector<std::String> pageRoots;                        // the directories whose .md files become pages
  std::String sourceUrl = "https://github.com/kovarex/kpp"; // where a link to a file that is not a page goes
  std::String registryUrl = "https://kpp.net/registry/";    // where the archives are
  std::String commit;                                   // the repository's commit, named in every page's footer
};
