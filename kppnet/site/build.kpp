// kppsite: kpp.net's static site generator (README.md). `kpp` here builds it, `kpp --test` runs its
// tests.
void build(Project& project)
{
  Executable& site = project.executable("kppsite", {"src"});
  site.argument("--this-reference"); // `this` is the object, written `this.x` and `&this` (kpp's design.md 23d)
  for (StringView name : {"json", "markdown", "html", "url"})
    site.use(name, local(String("../../libraries/") + name));
}
